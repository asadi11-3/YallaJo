<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Security.Contracts is the public API surface of the Security module.
    It contains ONLY integration event DTOs — no domain logic, no EF, no MediatR.
    Any module that needs to react to Security events references THIS project, not Security.Application.
  -->
  <ItemGroup>
    <ProjectReference Include="..\YallaJo.SharedKernel.Domain\YallaJo.SharedKernel.Domain.csproj" />
    <ProjectReference Include="..\YallaJo.SharedKernel.Application\YallaJo.SharedKernel.Application.csproj" />
  </ItemGroup>

</Project>
