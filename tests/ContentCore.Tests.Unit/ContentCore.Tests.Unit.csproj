<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <!--
      T5 (CONTENTCORE-STD-P1-002): SQLite in-memory is required to exercise the real
      EF Core HasQueryFilter on EntityTag / EntityCategory. EF InMemory silently ignores
      query filters and cannot validate this requirement.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.15" />
    <!--
      CONTENTCORE-FOLLOWUP-BACKFILL-001: EF InMemory provider used for the
      TranslationBackfillStore batching tests. SQLite cannot translate the
      SQL Server-specific column types in the production EF configurations
      (e.g. nvarchar(max)). InMemory ignores query filters but those aren't
      under test here — we only need projection + anti-join behaviour.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.15" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ContentCore.Domain\ContentCore.Domain.csproj" />
    <ProjectReference Include="..\..\ContentCore.Application\ContentCore.Application.csproj" />
    <ProjectReference Include="..\YallaJo.Tests.Shared\YallaJo.Tests.Shared.csproj" />
    <!--
      T5: ContentCore.Infrastructure is referenced so the test exercises the production
      ContentCoreDbContext (with all real EF configurations applied via
      ApplyConfigurationsFromAssembly). Duplicating EntityTagConfiguration in the test
      project would validate a copy, not the artifact that ships.
    -->
    <ProjectReference Include="..\..\ContentCore.Infrastructure\ContentCore.Infrastructure.csproj" />
  </ItemGroup>

</Project>
