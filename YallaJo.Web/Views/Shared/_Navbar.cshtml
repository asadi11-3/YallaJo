@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Infrastructure.Identity
@inject ICurrentUser CurrentUser

@* Rendered only for authenticated users so anonymous auth pages keep their clean look. *@
@if (CurrentUser.IsAuthenticated)
{
    var hasUsersRead           = CurrentUser.HasPermission(WebPermission.User.Read);
    var hasUsersCreate         = CurrentUser.HasPermission(WebPermission.User.Create);
    var hasRolesRead           = CurrentUser.HasPermission(WebPermission.Role.Read);
    var hasSystemRead          = CurrentUser.HasPermission(WebPermission.System.Read);
    var hasLanguageRead        = CurrentUser.HasPermission(WebPermission.Language.Read);
    var hasTagRead             = CurrentUser.HasPermission(WebPermission.Tag.Read);
    var hasSpecializationRead  = CurrentUser.HasPermission(WebPermission.Specialization.Read);
    var hasCategoryRead        = CurrentUser.HasPermission(WebPermission.Category.Read);
    var hasAttachmentRead      = CurrentUser.HasPermission(WebPermission.Attachment.Read);
    var hasTranslationRead     = CurrentUser.HasPermission(WebPermission.TranslationCache.Read);

    var hasSecurityMenu    = hasUsersRead  || hasRolesRead || hasSystemRead;
    var hasAccountsMenu    = hasUsersCreate;
    var hasContentCoreMenu = hasLanguageRead || hasTagRead || hasSpecializationRead
                             || hasCategoryRead || hasAttachmentRead || hasTranslationRead;

    @*
        ⚠ TEMPORARY — DEV/TEST QUICK NAV
        ──────────────────────────────────────────────────────────────────
        Phase 5E manual-testing helper. Renders a flat one-click strip
        above the main navbar with the most-used IAM admin pages so the
        full Phase 3 + 4 + 5 lifecycle flow can be smoke-tested without
        digging through dropdowns. **Remove before production rollout.**
        Each link is permission-gated using the same `<permission>`
        tag helpers the main dropdowns use, so no admin can see a link
        they cannot follow. Routes are existing pages only — nothing
        new is wired here.
    *@
    var hasAnyTestNavLink =
        CurrentUser.HasPermission(WebPermission.User.Read)
        || CurrentUser.HasPermission(WebPermission.Role.Read)
        || CurrentUser.HasPermission(WebPermission.System.Read)
        || CurrentUser.HasPermission(WebPermission.User.Create);

    @if (hasAnyTestNavLink)
    {
        <div class="bg-warning-subtle border-bottom small py-1" id="dev-test-nav"
             role="navigation" aria-label="Developer quick navigation">
            <div class="container-fluid d-flex flex-wrap gap-2 align-items-center">
                <span class="badge bg-warning text-dark" title="Temporary: remove before production">
                    DEV
                </span>
                <span class="text-muted">Quick nav:</span>

                <permission require="@WebPermission.User.Read">
                    <a class="btn btn-sm btn-link p-0"
                       asp-area="Admin" asp-controller="Users" asp-action="Index">Users list</a>
                </permission>

                <permission require="@WebPermission.Role.Read">
                    <a class="btn btn-sm btn-link p-0"
                       asp-area="Admin" asp-controller="Roles" asp-action="Index">Roles</a>
                </permission>

                <permission require="@WebPermission.System.Read">
                    <a class="btn btn-sm btn-link p-0"
                       asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">Audit timeline</a>
                </permission>

                <permission require="@WebPermission.User.Create">
                    <a class="btn btn-sm btn-link p-0"
                       asp-area="Admin" asp-controller="Invitations" asp-action="Index">Invite user</a>
                </permission>

                <permission require="@WebPermission.User.Create">
                    <a class="btn btn-sm btn-link p-0"
                       asp-area="Admin" asp-controller="Invitations" asp-action="Resend">Resend invite</a>
                </permission>

                <span class="text-muted ms-auto small">
                    Self-service:
                </span>
                <a class="btn btn-sm btn-link p-0"
                   asp-area="Auth" asp-controller="Sessions" asp-action="Index">Sessions</a>
                <a class="btn btn-sm btn-link p-0"
                   asp-area="Auth" asp-controller="Devices" asp-action="Index">Devices</a>
                <a class="btn btn-sm btn-link p-0 text-danger"
                   asp-area="Auth" asp-controller="Logout" asp-action="Index">Sign out</a>
            </div>
        </div>
    }

    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="Accounts" asp-controller="Profile" asp-action="Index">YallaJo</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#primaryNav" aria-controls="primaryNav"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="primaryNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    @* ── Security admin menu ─────────────────────────────────── *@
                    @if (hasSecurityMenu)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">Security</a>
                            <ul class="dropdown-menu">
                                <permission require="@WebPermission.User.Read">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Admin" asp-controller="Users" asp-action="Index">Users</a>
                                    </li>
                                </permission>
                                <permission require="@WebPermission.Role.Read">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Admin" asp-controller="Roles" asp-action="Index">Roles</a>
                                    </li>
                                </permission>
                                <permission require="@WebPermission.System.Read">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">Audit Timeline</a>
                                    </li>
                                </permission>
                            </ul>
                        </li>
                    }

                    @* ── Accounts admin menu ─────────────────────────────────── *@
                    @if (hasAccountsMenu)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">Accounts</a>
                            <ul class="dropdown-menu">
                                <permission require="@WebPermission.User.Create">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Admin" asp-controller="Invitations" asp-action="Index">Invite User</a>
                                    </li>
                                </permission>
                                <permission require="@WebPermission.User.Create">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Admin" asp-controller="Invitations" asp-action="Resend">Resend Invite</a>
                                    </li>
                                </permission>
                            </ul>
                        </li>
                    }

                    @* ── ContentCore admin menu ──────────────────────────────── *@
                    @if (hasContentCoreMenu)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">Content</a>
                            <ul class="dropdown-menu">
                                <permission require="@WebPermission.Language.Read">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Admin" asp-controller="Languages" asp-action="Index">Languages</a>
                                    </li>
                                </permission>
                                <permission require="@WebPermission.Tag.Read">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Admin" asp-controller="Tags" asp-action="Index">Tags</a>
                                    </li>
                                </permission>
                                <permission require="@WebPermission.Specialization.Read">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Admin" asp-controller="Specializations" asp-action="Index">Specializations</a>
                                    </li>
                                </permission>
                                <permission require="@WebPermission.Category.Read">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Admin" asp-controller="Categories" asp-action="Index">Categories</a>
                                    </li>
                                </permission>
                                <permission require="@WebPermission.Attachment.Read">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Admin" asp-controller="Attachments" asp-action="Index">Attachments</a>
                                    </li>
                                </permission>
                                <permission require="@WebPermission.TranslationCache.Read">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Admin" asp-controller="Translations" asp-action="Index">Translations</a>
                                    </li>
                                </permission>
                            </ul>
                        </li>
                    }
                </ul>

                @* ── Account self-service menu (always for authenticated) ─── *@
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">Account</a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item"
                                   asp-area="Accounts" asp-controller="Profile" asp-action="Index">My profile</a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   asp-area="Accounts" asp-controller="ChangePassword" asp-action="Index">Change password</a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   asp-area="Accounts" asp-controller="UpdatePhone" asp-action="Index">Update phone</a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item"
                                   asp-area="Auth" asp-controller="Sessions" asp-action="Index">Sessions</a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   asp-area="Auth" asp-controller="Devices" asp-action="Index">Devices</a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   asp-area="Auth" asp-controller="Logout" asp-action="Index">Sign out</a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
}
