@using YallaJo.Web.Infrastructure.Authorization
@model YallaJo.Web.Areas.Admin.Modules.Accounts.Features.Profiles.ViewModels.CreateProfileVm
@{
    ViewData["Title"] = "Create Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Create Profile</h2>
    <p class="text-muted">Link a Security user to a new Accounts profile.</p>

    @if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <permission require="@WebPermission.User.Create">
        <form asp-area="Admin" asp-controller="Profiles" asp-action="Create" method="post" class="col-md-6">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="UserId" class="form-label"></label>
                <input asp-for="UserId" class="form-control" placeholder="00000000-0000-0000-0000-000000000000" />
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>

            <div class="row g-2">
                <div class="col-md-6 mb-3">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="DisplayName" class="form-label"></label>
                <input asp-for="DisplayName" class="form-control" />
                <span asp-validation-for="DisplayName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AvatarUrl" class="form-label"></label>
                <input asp-for="AvatarUrl" class="form-control" type="url" />
                <span asp-validation-for="AvatarUrl" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Create profile</button>
        </form>
    </permission>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
