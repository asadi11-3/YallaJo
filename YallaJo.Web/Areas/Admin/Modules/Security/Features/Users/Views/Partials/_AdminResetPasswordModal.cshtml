@*
    Phase 5C — Admin reset-password modal.
    Triggered by `data-bs-toggle="modal" data-bs-target="#mdl-reset-pwd-{userId}"`.
    Posts to LifecycleController.ResetPassword with AdminResetPasswordVm.Reason.
*@
@model Guid
@{
    var userId = Model;
    var email = (ViewData["TargetEmail"] as string) ?? string.Empty;
    var modalId = $"mdl-reset-pwd-{userId}";
    var titleId = $"{modalId}-title";
    var bannerId = $"{modalId}-banner";
    var reasonId = $"{modalId}-reason";
}

<div class="modal fade admin-action-modal" id="@modalId" tabindex="-1"
     aria-labelledby="@titleId" aria-describedby="@bannerId" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-area="Admin" asp-controller="Lifecycle"
                  asp-action="ResetPassword" asp-route-userId="@userId" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-warning-subtle">
                    <h5 class="modal-title" id="@titleId">
                        <i class="bi bi-key-fill me-1"></i> Force password reset
                    </h5>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning small mb-3" id="@bannerId">
                        This will sign the user out of all sessions, invalidate the
                        current password, and email them a reset code. They cannot
                        log in until they complete the reset.
                    </div>
                    <p class="mb-2">
                        About to send a reset email to
                        @if (!string.IsNullOrWhiteSpace(email))
                        {
                            <strong>@email</strong>
                        }
                        else
                        {
                            <span>this user</span>
                        }.
                    </p>
                    <label class="form-label small text-muted mb-1" for="@reasonId">
                        Reason (optional, recorded in the audit timeline)
                    </label>
                    <textarea id="@reasonId" name="Reason" maxlength="500" rows="2"
                              class="form-control"
                              placeholder="e.g. suspected compromise"></textarea>
                    <div class="form-text">Up to 500 characters.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Send reset email</button>
                </div>
            </form>
        </div>
    </div>
</div>
