@*
    Phase 5C — Reassign admin lifecycle modal (DESTRUCTIVE — full credential
    teardown). Triggered by `data-bs-toggle="modal" data-bs-target="#mdl-reassign-{userId}"`.
    Posts to LifecycleController.Reassign with AdminReassignAccountVm
    (NewEmail / Reason / IUnderstand). The "I understand" checkbox is the
    server-side authoritative confirmation; the JS gate that disables the
    Submit button is cosmetic.
*@
@model Guid
@{
    var userId = Model;
    var email = (ViewData["TargetEmail"] as string) ?? string.Empty;
    var modalId = $"mdl-reassign-{userId}";
    var titleId = $"{modalId}-title";
    var bannerId = $"{modalId}-banner";
    var newEmailId = $"{modalId}-new-email";
    var reasonId = $"{modalId}-reason";
    var checkboxId = $"{modalId}-understand";
}

<div class="modal fade admin-action-modal" id="@modalId" tabindex="-1"
     aria-labelledby="@titleId" aria-describedby="@bannerId" aria-hidden="true"
     data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form asp-area="Admin" asp-controller="Lifecycle"
                  asp-action="Reassign" asp-route-userId="@userId"
                  method="post" id="reassign-form">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="@titleId">
                        <i class="bi bi-arrow-left-right me-1"></i>
                        Reassign account to a new owner
                    </h5>
                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger small mb-3" id="@bannerId">
                        This action will:
                        <ul class="mb-2 mt-1">
                            <li>Change the primary email to the new address (unverified)</li>
                            <li>Invalidate the current password</li>
                            <li>Revoke all sessions</li>
                            <li>Deactivate every external sign-in link (Google, Facebook, …)</li>
                            <li>Scrub the profile to placeholder values</li>
                            <li>Email an activation link to the new email</li>
                        </ul>
                        The old owner loses access immediately and cannot recover the account.
                    </div>

                    @if (!string.IsNullOrWhiteSpace(email))
                    {
                        <p class="mb-3 small text-muted">
                            Current owner: <strong>@email</strong>
                        </p>
                    }

                    <div class="mb-3">
                        <label class="form-label" for="@newEmailId">New email</label>
                        <input id="@newEmailId" name="NewEmail" type="email"
                               required maxlength="320"
                               class="form-control"
                               placeholder="newowner@example.com" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="@reasonId">
                            Reason (optional, recorded in the audit timeline)
                        </label>
                        <textarea id="@reasonId" name="Reason" maxlength="500" rows="2"
                                  class="form-control"
                                  placeholder="e.g. ownership transfer"></textarea>
                        <div class="form-text">Up to 500 characters.</div>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               id="@checkboxId" name="IUnderstand" value="true" />
                        <label class="form-check-label" for="@checkboxId">
                            I understand this will revoke the old owner's access and
                            transfer the account to the new email.
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger" disabled
                            data-reassign-submit>
                        Reassign
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
