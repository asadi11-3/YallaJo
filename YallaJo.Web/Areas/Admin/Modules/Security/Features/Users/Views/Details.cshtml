@using YallaJo.Web.Infrastructure.Authorization
@model YallaJo.Web.Areas.Admin.Modules.Security.Features.Users.ViewModels.UserDetailsVm
@{
    ViewData["Title"] = "User Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>User: @Model.Email</h2>
    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">← Back</a>

    @if (TempData["Success"] is string ok)  { <div class="alert alert-success">@ok</div> }
    @if (TempData["Error"]   is string err) { <div class="alert alert-danger">@err</div> }

    <dl class="row">
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                @(Model.IsActive ? "Active" : "Inactive")
            </span>
        </dd>
        <dt class="col-sm-3">Roles</dt>
        <dd class="col-sm-9">@string.Join(", ", Model.CurrentRoles)</dd>
    </dl>

    @* Activate / Deactivate *@
    <permission require="@WebPermission.User.UpdateAny">
        <div class="mb-4">
            @if (Model.IsActive)
            {
                <form asp-area="Admin" asp-controller="Users"
                      asp-action="Deactivate" asp-route-userId="@Model.UserId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning btn-sm"
                            onclick="return confirm('Deactivate this user?')">Deactivate</button>
                </form>
            }
            else
            {
                <form asp-area="Admin" asp-controller="Users"
                      asp-action="Activate" asp-route-userId="@Model.UserId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success btn-sm">Activate</button>
                </form>
            }
        </div>
    </permission>

    <hr />

    @* Assign Role *@
    <permission require="@WebPermission.UserRole.Create">
        <h5>Assign Role</h5>
        <form asp-area="Admin" asp-controller="Users"
              asp-action="AssignRole" asp-route-userId="@Model.UserId" method="post" class="row g-2 mb-3">
            @Html.AntiForgeryToken()
            <div class="col-auto">
                <select name="RoleId" id="RoleId" class="form-select"
                        asp-items="@(new SelectList(Model.AvailableRoles, "Id", "Name"))">
                    <option value="">-- select role --</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">Assign</button>
            </div>
        </form>
    </permission>

    @* Current roles + Remove *@
    @if (Model.CurrentRoles.Any())
    {
        <table class="table table-sm w-auto">
            <thead>
                <tr>
                    <th>Role</th>
                    <permission require="@WebPermission.UserRole.Delete"><th></th></permission>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model.AvailableRoles.Where(r => Model.CurrentRoles.Contains(r.Name)))
                {
                    <tr>
                        <td>@role.Name</td>
                        <permission require="@WebPermission.UserRole.Delete">
                            <td>
                                <form asp-area="Admin" asp-controller="Users"
                                      asp-action="RemoveRole"
                                      asp-route-userId="@Model.UserId"
                                      asp-route-roleId="@role.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm"
                                            onclick="return confirm('Remove role @role.Name?')">Remove</button>
                                </form>
                            </td>
                        </permission>
                    </tr>
                }
            </tbody>
        </table>
    }

    <hr />

    @* Add Claim *@
    <permission require="@WebPermission.User.UpdateAny">
        <h5>Add Claim</h5>
        <form asp-area="Admin" asp-controller="Users"
              asp-action="AddClaim" asp-route-userId="@Model.UserId" method="post" class="row g-2 mb-3">
            @Html.AntiForgeryToken()
            <div class="col-auto">
                <input name="ClaimType" id="ClaimType" class="form-control" placeholder="Type" />
            </div>
            <div class="col-auto">
                <input name="ClaimValue" id="ClaimValue" class="form-control" placeholder="Value" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">Add Claim</button>
            </div>
        </form>
    </permission>

    @* Existing claims + Remove *@
    @if (Model.Claims.Any())
    {
        <h5>Claims</h5>
        <table class="table table-sm w-auto">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Value</th>
                    <permission require="@WebPermission.User.UpdateAny"><th></th></permission>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Claims)
                {
                    <tr>
                        <td>@c.ClaimType</td>
                        <td>@c.ClaimValue</td>
                        <permission require="@WebPermission.User.UpdateAny">
                            <td>
                                <form asp-area="Admin" asp-controller="Users"
                                      asp-action="RemoveClaim"
                                      asp-route-userId="@Model.UserId"
                                      asp-route-claimId="@c.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm"
                                            onclick="return confirm('Remove this claim?')">Remove</button>
                                </form>
                            </td>
                        </permission>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
