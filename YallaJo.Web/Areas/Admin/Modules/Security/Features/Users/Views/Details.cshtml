@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Modules.Security.Features.Users.ViewModels
@model YallaJo.Web.Areas.Admin.Modules.Security.Features.Users.ViewModels.UserDetailsVm
@{
    ViewData["Title"] = "User Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>User: @Model.Email</h2>
    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">← Back</a>

    @*
        Phase 5E — TempData alerts upgraded to Bootstrap dismissible
        alerts with role="alert" for screen-reader announcement and
        admin convenience on long error messages.
    *@
    @if (TempData["Success"] is string ok)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @ok
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @err
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <dl class="row">
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            @*
                Phase 5E — delegate the binary status badge to the shared
                _LifecycleBadge partial introduced in Phase 5D so Users
                list + Details render lifecycle status from a single
                source. The optional LifecycleState parameter is left
                null until the backend UserDto exposes granular states.
            *@
            <partial name="Partials/_LifecycleBadge"
                     model="@(new LifecycleBadgeVm(Model.IsActive, null))" />
        </dd>
        <dt class="col-sm-3">Roles</dt>
        <dd class="col-sm-9">@string.Join(", ", Model.CurrentRoles)</dd>
    </dl>

    @*
        Phase 5E — legacy Activate/Deactivate UI removed. The backend
        controller actions on UsersController and the underlying API
        endpoints `/api/v1/security/users/{id}/activate|deactivate`
        remain callable for non-UI clients per the Phase 5E scope; the
        Razor view simply no longer surfaces them. All admin lifecycle
        flow now goes through the Phase 3B Suspend / Reactivate /
        Phase 3B Archive / Phase 3A Reset password / Phase 3C Reassign
        modals below.
    *@

    @*
        Phase 5C — admin lifecycle actions, now driven by Bootstrap 5 modals.
        Every trigger button uses `data-bs-toggle="modal"` and the matching
        modal posts to LifecycleController on submit. Backend, API endpoints,
        and controller routes are unchanged from Phase 5B; only the UX
        layer was upgraded from confirm() prompts.

        Buttons render for any admin with User.UpdateAny; the backend
        enforces hierarchy / self-management / lifecycle eligibility and
        surfaces 403/409 messages in TempData on redirect.
    *@
    <permission require="@WebPermission.User.UpdateAny">
        @{
            var modalViewData = new ViewDataDictionary(ViewData) { ["TargetEmail"] = Model.Email };
        }
        <div class="card mb-4">
            <div class="card-header bg-light">
                <strong>Admin actions</strong>
                <span class="text-muted small">— governed by lifecycle rules on the server</span>
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-warning btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#mdl-suspend-@Model.UserId">
                        Suspend
                    </button>

                    <button type="button" class="btn btn-success btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#mdl-reactivate-@Model.UserId">
                        Reactivate
                    </button>

                    <button type="button" class="btn btn-dark btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#mdl-archive-@Model.UserId">
                        Archive
                    </button>

                    <button type="button" class="btn btn-outline-warning btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#mdl-reset-pwd-@Model.UserId">
                        Reset password
                    </button>

                    <button type="button" class="btn btn-outline-danger btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#mdl-reassign-@Model.UserId">
                        Reassign
                    </button>
                </div>
            </div>
        </div>

        @* Modals (rendered once per page; opened via the buttons above). *@
        <partial name="Partials/_SuspendModal"            model="Model.UserId" view-data="modalViewData" />
        <partial name="Partials/_ReactivateModal"         model="Model.UserId" view-data="modalViewData" />
        <partial name="Partials/_ArchiveModal"            model="Model.UserId" view-data="modalViewData" />
        <partial name="Partials/_AdminResetPasswordModal" model="Model.UserId" view-data="modalViewData" />
        <partial name="Partials/_ReassignModal"           model="Model.UserId" view-data="modalViewData" />
    </permission>

    <hr />

    @* Assign Role *@
    <permission require="@WebPermission.UserRole.Create">
        <h5>Assign Role</h5>
        <form asp-area="Admin" asp-controller="Users"
              asp-action="AssignRole" asp-route-userId="@Model.UserId" method="post" class="row g-2 mb-3">
            @Html.AntiForgeryToken()
            <div class="col-auto">
                <select name="RoleId" id="RoleId" class="form-select"
                        asp-items="@(new SelectList(Model.AvailableRoles, "Id", "Name"))">
                    <option value="">-- select role --</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">Assign</button>
            </div>
        </form>
    </permission>

    @* Current roles + Remove *@
    @if (Model.CurrentRoles.Any())
    {
        <table class="table table-sm w-auto">
            <thead>
                <tr>
                    <th>Role</th>
                    <permission require="@WebPermission.UserRole.Delete"><th></th></permission>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model.AvailableRoles.Where(r => Model.CurrentRoles.Contains(r.Name)))
                {
                    <tr>
                        <td>@role.Name</td>
                        <permission require="@WebPermission.UserRole.Delete">
                            <td>
                                <form asp-area="Admin" asp-controller="Users"
                                      asp-action="RemoveRole"
                                      asp-route-userId="@Model.UserId"
                                      asp-route-roleId="@role.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm"
                                            onclick="return confirm('Remove role @role.Name?')">Remove</button>
                                </form>
                            </td>
                        </permission>
                    </tr>
                }
            </tbody>
        </table>
    }

    <hr />

    @* Add Claim *@
    <permission require="@WebPermission.User.UpdateAny">
        <h5>Add Claim</h5>
        <form asp-area="Admin" asp-controller="Users"
              asp-action="AddClaim" asp-route-userId="@Model.UserId" method="post" class="row g-2 mb-3">
            @Html.AntiForgeryToken()
            <div class="col-auto">
                <input name="ClaimType" id="ClaimType" class="form-control" placeholder="Type" />
            </div>
            <div class="col-auto">
                <input name="ClaimValue" id="ClaimValue" class="form-control" placeholder="Value" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">Add Claim</button>
            </div>
        </form>
    </permission>

    @* Existing claims + Remove *@
    @if (Model.Claims.Any())
    {
        <h5>Claims</h5>
        <table class="table table-sm w-auto">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Value</th>
                    <permission require="@WebPermission.User.UpdateAny"><th></th></permission>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Claims)
                {
                    <tr>
                        <td>@c.ClaimType</td>
                        <td>@c.ClaimValue</td>
                        <permission require="@WebPermission.User.UpdateAny">
                            <td>
                                <form asp-area="Admin" asp-controller="Users"
                                      asp-action="RemoveClaim"
                                      asp-route-userId="@Model.UserId"
                                      asp-route-claimId="@c.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm"
                                            onclick="return confirm('Remove this claim?')">Remove</button>
                                </form>
                            </td>
                        </permission>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @*
        Phase 5C — minimal modal helpers (no third-party deps; Bootstrap is
        already loaded by the layout). All three handlers degrade safely:
        the server-side validators on AdminArchiveVm.ConfirmText and
        AdminReassignAccountVm.IUnderstand reject submissions that bypass
        the JS gates.
    *@
    <script>
        (function () {
            // 1) Archive: enable Submit only when "ARCHIVE" is typed exactly.
            const archiveForm = document.getElementById('archive-form');
            if (archiveForm) {
                const input  = archiveForm.querySelector('input[name="ConfirmText"]');
                const submit = archiveForm.querySelector('[data-archive-submit]');
                const sync   = function () { submit.disabled = (input.value !== 'ARCHIVE'); };
                input.addEventListener('input', sync);
                sync();
            }

            // 2) Reassign: enable Submit only when "I understand" is ticked
            //    AND the new email field has a non-empty value.
            const reassignForm = document.getElementById('reassign-form');
            if (reassignForm) {
                const cb     = reassignForm.querySelector('input[name="IUnderstand"]');
                const email  = reassignForm.querySelector('input[name="NewEmail"]');
                const submit = reassignForm.querySelector('[data-reassign-submit]');
                const sync   = function () {
                    submit.disabled = !(cb.checked && email.value.trim().length > 0);
                };
                cb.addEventListener('change', sync);
                email.addEventListener('input', sync);
                sync();
            }

            // 3) Disable submit-on-click on every admin-action modal form to
            //    block double-fire while the redirect runs.
            document.querySelectorAll('.admin-action-modal form').forEach(function (form) {
                form.addEventListener('submit', function () {
                    const btn = form.querySelector('button[type="submit"]');
                    if (btn) { btn.disabled = true; }
                });
            });
        })();
    </script>
}
