@using YallaJo.Web.Infrastructure.Authorization
@model YallaJo.Web.Areas.Admin.Modules.Security.Features.Users.ViewModels.UserDetailsVm
@{
    ViewData["Title"] = "User Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>User: @Model.Email</h2>
    <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">← Back</a>

    @if (TempData["Success"] is string ok)  { <div class="alert alert-success">@ok</div> }
    @if (TempData["Error"]   is string err) { <div class="alert alert-danger">@err</div> }

    <dl class="row">
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                @(Model.IsActive ? "Active" : "Inactive")
            </span>
        </dd>
        <dt class="col-sm-3">Roles</dt>
        <dd class="col-sm-9">@string.Join(", ", Model.CurrentRoles)</dd>
    </dl>

    @* Activate / Deactivate (legacy — kept per Phase 5B scope) *@
    <permission require="@WebPermission.User.UpdateAny">
        <div class="mb-4">
            @if (Model.IsActive)
            {
                <form asp-area="Admin" asp-controller="Users"
                      asp-action="Deactivate" asp-route-userId="@Model.UserId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning btn-sm"
                            onclick="return confirm('Deactivate this user?')">Deactivate</button>
                </form>
            }
            else
            {
                <form asp-area="Admin" asp-controller="Users"
                      asp-action="Activate" asp-route-userId="@Model.UserId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success btn-sm">Activate</button>
                </form>
            }
        </div>
    </permission>

    @*
        Phase 5B — admin lifecycle actions. Inline confirm() dialogs;
        modals arrive in Phase 5C. Every action posts to LifecycleController
        and redirects back to this Details page. Buttons render for any
        admin with User.UpdateAny; the backend enforces hierarchy/
        self-management/lifecycle eligibility and surfaces 403/409 messages
        in TempData.
    *@
    <permission require="@WebPermission.User.UpdateAny">
        <div class="card mb-4">
            <div class="card-header bg-light">
                <strong>Admin actions</strong>
                <span class="text-muted small">— governed by lifecycle rules on the server</span>
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <form asp-area="Admin" asp-controller="Lifecycle"
                          asp-action="Suspend" asp-route-userId="@Model.UserId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning btn-sm"
                                onclick="return confirm('Suspend this user? They will be signed out of all sessions and cannot log in until reactivated.')">
                            Suspend
                        </button>
                    </form>

                    <form asp-area="Admin" asp-controller="Lifecycle"
                          asp-action="Reactivate" asp-route-userId="@Model.UserId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success btn-sm"
                                onclick="return confirm('Reactivate this user? They will be able to log in again with their existing credentials.')">
                            Reactivate
                        </button>
                    </form>

                    <form asp-area="Admin" asp-controller="Lifecycle"
                          asp-action="Archive" asp-route-userId="@Model.UserId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-dark btn-sm"
                                onclick="return confirm('Archive this user? This is irreversible. They will be signed out and cannot log in.')">
                            Archive
                        </button>
                    </form>
                </div>

                @* Reset password (with optional reason) *@
                <form asp-area="Admin" asp-controller="Lifecycle"
                      asp-action="ResetPassword" asp-route-userId="@Model.UserId" method="post"
                      class="row g-2 align-items-end mb-3"
                      onsubmit="return confirm('Force a password reset for this user? This will sign them out of all sessions and email a reset code.');">
                    @Html.AntiForgeryToken()
                    <div class="col-md-6">
                        <label class="form-label small text-muted mb-0" for="ResetPasswordReason">Reason (optional)</label>
                        <input id="ResetPasswordReason" name="Reason" maxlength="500"
                               class="form-control form-control-sm" placeholder="e.g. suspected compromise" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-outline-warning btn-sm">Reset password</button>
                    </div>
                </form>

                @* Reassign account (new email + optional reason) *@
                <form asp-area="Admin" asp-controller="Lifecycle"
                      asp-action="Reassign" asp-route-userId="@Model.UserId" method="post"
                      class="row g-2 align-items-end"
                      onsubmit="return confirm('Reassign this account to a new owner? This will invalidate the password, revoke all sessions, deactivate external sign-in links, scrub the profile, and email an activation link to the new email. The old owner loses access immediately.');">
                    @Html.AntiForgeryToken()
                    <div class="col-md-4">
                        <label class="form-label small text-muted mb-0" for="ReassignNewEmail">New email</label>
                        <input id="ReassignNewEmail" name="NewEmail" type="email" required maxlength="320"
                               class="form-control form-control-sm" placeholder="newowner@example.com" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted mb-0" for="ReassignReason">Reason (optional)</label>
                        <input id="ReassignReason" name="Reason" maxlength="500"
                               class="form-control form-control-sm" placeholder="e.g. ownership transfer" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Reassign</button>
                    </div>
                </form>
            </div>
        </div>
    </permission>

    <hr />

    @* Assign Role *@
    <permission require="@WebPermission.UserRole.Create">
        <h5>Assign Role</h5>
        <form asp-area="Admin" asp-controller="Users"
              asp-action="AssignRole" asp-route-userId="@Model.UserId" method="post" class="row g-2 mb-3">
            @Html.AntiForgeryToken()
            <div class="col-auto">
                <select name="RoleId" id="RoleId" class="form-select"
                        asp-items="@(new SelectList(Model.AvailableRoles, "Id", "Name"))">
                    <option value="">-- select role --</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">Assign</button>
            </div>
        </form>
    </permission>

    @* Current roles + Remove *@
    @if (Model.CurrentRoles.Any())
    {
        <table class="table table-sm w-auto">
            <thead>
                <tr>
                    <th>Role</th>
                    <permission require="@WebPermission.UserRole.Delete"><th></th></permission>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model.AvailableRoles.Where(r => Model.CurrentRoles.Contains(r.Name)))
                {
                    <tr>
                        <td>@role.Name</td>
                        <permission require="@WebPermission.UserRole.Delete">
                            <td>
                                <form asp-area="Admin" asp-controller="Users"
                                      asp-action="RemoveRole"
                                      asp-route-userId="@Model.UserId"
                                      asp-route-roleId="@role.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm"
                                            onclick="return confirm('Remove role @role.Name?')">Remove</button>
                                </form>
                            </td>
                        </permission>
                    </tr>
                }
            </tbody>
        </table>
    }

    <hr />

    @* Add Claim *@
    <permission require="@WebPermission.User.UpdateAny">
        <h5>Add Claim</h5>
        <form asp-area="Admin" asp-controller="Users"
              asp-action="AddClaim" asp-route-userId="@Model.UserId" method="post" class="row g-2 mb-3">
            @Html.AntiForgeryToken()
            <div class="col-auto">
                <input name="ClaimType" id="ClaimType" class="form-control" placeholder="Type" />
            </div>
            <div class="col-auto">
                <input name="ClaimValue" id="ClaimValue" class="form-control" placeholder="Value" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">Add Claim</button>
            </div>
        </form>
    </permission>

    @* Existing claims + Remove *@
    @if (Model.Claims.Any())
    {
        <h5>Claims</h5>
        <table class="table table-sm w-auto">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Value</th>
                    <permission require="@WebPermission.User.UpdateAny"><th></th></permission>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Claims)
                {
                    <tr>
                        <td>@c.ClaimType</td>
                        <td>@c.ClaimValue</td>
                        <permission require="@WebPermission.User.UpdateAny">
                            <td>
                                <form asp-area="Admin" asp-controller="Users"
                                      asp-action="RemoveClaim"
                                      asp-route-userId="@Model.UserId"
                                      asp-route-claimId="@c.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm"
                                            onclick="return confirm('Remove this claim?')">Remove</button>
                                </form>
                            </td>
                        </permission>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
