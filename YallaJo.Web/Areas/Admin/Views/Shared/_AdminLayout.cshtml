<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - YallaJo Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        :root { --sidebar-width: 250px; }
        body { overflow-x: hidden; }
        .sidebar {
            width: var(--sidebar-width);
            min-height: 100vh;
            background: #212529;
            position: fixed;
            top: 0; left: 0;
            z-index: 100;
            padding-top: 0;
            transition: margin-left 0.3s;
        }
        .sidebar .nav-link {
            color: #adb5bd;
            padding: 0.6rem 1.2rem;
            font-size: 0.9rem;
            border-radius: 0;
        }
        .sidebar .nav-link:hover,
        .sidebar .nav-link.active { color: #fff; background: rgba(255,255,255,0.08); }
        .sidebar .nav-link i { width: 1.5rem; text-align: center; margin-right: 0.5rem; }
        .sidebar-brand {
            padding: 1rem 1.2rem;
            font-size: 1.25rem;
            font-weight: 700;
            color: #fff;
            text-decoration: none;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            display: block;
        }
        .sidebar-heading {
            color: #6c757d;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            padding: 1.2rem 1.2rem 0.4rem;
        }
        .main-content { margin-left: var(--sidebar-width); min-height: 100vh; }
        .top-navbar {
            background: #fff;
            border-bottom: 1px solid #dee2e6;
            padding: 0.75rem 1.5rem;
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <nav class="sidebar">
        <a class="sidebar-brand" href="/admin">
            <i class="bi bi-globe-americas"></i> YallaJo
        </a>
        <ul class="nav flex-column">
            <li><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" href="/admin">
                <i class="bi bi-speedometer2"></i> Dashboard</a></li>

            <div class="sidebar-heading">Content</div>
            <li><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")" href="/admin/categories">
                <i class="bi bi-tags"></i> Categories</a></li>
            <li><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Languages" ? "active" : "")" href="/admin/languages">
                <i class="bi bi-translate"></i> Languages</a></li>
            <li><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Translations" ? "active" : "")" href="/admin/translations">
                <i class="bi bi-chat-square-text"></i> Translations</a></li>
            <li><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Attachments" ? "active" : "")" href="/admin/attachments">
                <i class="bi bi-paperclip"></i> Attachments</a></li>

            <div class="sidebar-heading">Security</div>
            <li><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")" href="/admin/users">
                <i class="bi bi-people"></i> Users</a></li>
            <li><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Roles" ? "active" : "")" href="/admin/roles">
                <i class="bi bi-shield-lock"></i> Roles</a></li>
            <li><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AuditLogs" ? "active" : "")" href="/admin/audit-logs">
                <i class="bi bi-journal-text"></i> Audit Logs</a></li>

            <div class="sidebar-heading">Account</div>
            <li><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Profile" ? "active" : "")" href="/admin/profile">
                <i class="bi bi-person-circle"></i> My Profile</a></li>
        </ul>
    </nav>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Navbar -->
        <div class="top-navbar d-flex justify-content-between align-items-center">
            <h5 class="mb-0">@ViewData["Title"]</h5>
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small">@User.Identity?.Name</span>
                <form method="post" asp-area="" asp-controller="Auth" asp-action="Logout" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </form>
            </div>
        </div>

        <!-- Page Content -->
        <div class="p-4">
            @if (TempData["Success"] is string successMsg)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMsg
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] is string errorMsg)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMsg
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
