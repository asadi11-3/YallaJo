@model YallaJo.Web.Areas.Admin.Models.AdminSectionPageViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="card border-0 shadow-sm overflow-hidden">
    <div class="card-body p-4 p-lg-5">
        <div class="d-flex flex-column flex-lg-row align-items-lg-start justify-content-between gap-4">
            <div>
                <span class="badge text-bg-@Model.AccentClass-subtle text-@Model.AccentClass-emphasis mb-3">@Model.Badge</span>
                <h1 class="h3 mb-3">@Model.Title</h1>
                <p class="text-muted mb-4">@Model.Description</p>
            </div>
            <div class="rounded-4 border bg-light px-4 py-3 text-center">
                <i class="@Model.IconClass fs-1 text-@Model.AccentClass"></i>
            </div>
        </div>

        <div class="row g-3 mt-1">
            @foreach (var highlight in Model.Highlights)
            {
                <div class="col-md-6">
                    <div class="border rounded-4 h-100 p-3 bg-white">
                        <div class="fw-semibold mb-2">Ready for implementation</div>
                        <div class="text-muted small">@highlight</div>
                    </div>
                </div>
            }
        </div>

        <div class="alert alert-light border mt-4 mb-0" role="alert">
            This route now resolves inside the admin area, so navigation no longer falls through to a missing page.
        </div>
    </div>
</div>
