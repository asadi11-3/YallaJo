@model YallaJo.Web.Areas.Auth.Features.Sessions.ViewModels.SessionsVm
@{
    ViewData["Title"] = "Active Sessions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Active Sessions</h2>

    @if (ViewBag.Error is not null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (!Model.Sessions.Any())
    {
        <p>No active sessions.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Device</th>
                    <th>IP Address</th>
                    <th>Started</th>
                    <th>Expires</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Sessions)
                {
                    <tr>
                        <td>
                            @(s.DeviceName)
                            @if (s.IsCurrent) { <span class="badge bg-success">Current</span> }
                        </td>
                        <td>@(s.IpAddress ?? "—")</td>
                        <td>@s.CreatedAt.ToString("g")</td>
                        <td>@s.ExpiresAt.ToString("g")</td>
                        <td>
                            @if (!s.IsCurrent)
                            {
                                <form asp-area="Auth" asp-controller="Sessions"
                                      asp-route-sessionId="@s.SessionId"
                                      asp-action="Revoke" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">Revoke</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="mt-3">
        <form asp-area="Auth" asp-controller="LogoutAll" asp-action="Index" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-warning">Sign Out All Devices</button>
        </form>
    </div>
</div>
