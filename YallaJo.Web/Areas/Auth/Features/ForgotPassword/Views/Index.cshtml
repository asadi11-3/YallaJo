@using YallaJo.Web.Infrastructure.Security.Recaptcha
@model YallaJo.Web.Areas.Auth.Features.ForgotPassword.ViewModels.ForgotPasswordVm
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-card">
    <h2>Forgot Password</h2>
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-area="Auth" asp-controller="ForgotPassword" asp-action="Index" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <partial name="_RecaptchaField" model="@RecaptchaActions.ForgotPassword" />

        <button type="submit" class="btn btn-primary w-100">Send Reset Code</button>
    </form>

    <div class="mt-3">
        <a asp-area="Auth" asp-controller="Login" asp-action="Index">Back to Sign In</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
