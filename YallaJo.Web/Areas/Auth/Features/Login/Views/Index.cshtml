@using YallaJo.Web.Infrastructure.Authentication.ExternalAuth
@inject IExternalProviderAvailability ProviderAvailability
@model YallaJo.Web.Areas.Auth.Features.Login.ViewModels.LoginVm
@{
    ViewData["Title"] = "Sign In";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var loginError = TempData["LoginError"] as string;
}

<div class="auth-card">
    <h2>Sign In</h2>
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    @if (!string.IsNullOrEmpty(loginError))
    {
        <div class="alert alert-warning">@loginError</div>
    }

    <form asp-area="Auth" asp-controller="Login" asp-action="Index" method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">Sign In</button>
    </form>

    @if (ProviderAvailability.IsGoogleAvailable || ProviderAvailability.IsFacebookAvailable)
    {
        <hr />
        <p class="text-center text-muted mb-2">or sign in with</p>

        @if (ProviderAvailability.IsGoogleAvailable)
        {
            <form asp-area="Auth" asp-controller="ExternalAuth" asp-action="Challenge" method="post" class="mb-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="provider" value="google" />
                <input type="hidden" name="mode" value="login" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button type="submit" class="btn btn-outline-dark w-100">Continue with Google</button>
            </form>
        }

        @if (ProviderAvailability.IsFacebookAvailable)
        {
            <form asp-area="Auth" asp-controller="ExternalAuth" asp-action="Challenge" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="provider" value="facebook" />
                <input type="hidden" name="mode" value="login" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button type="submit" class="btn btn-outline-primary w-100">Continue with Facebook</button>
            </form>
        }
    }

    <div class="mt-3 d-flex justify-content-between">
        <a asp-area="Auth" asp-controller="ForgotPassword" asp-action="Index">Forgot password?</a>
        <a asp-area="Auth" asp-controller="Register" asp-action="Index">Create account</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
