@{
    ViewData["Title"] = "Sign Out All Devices";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="auth-card">
    <h2>Sign Out All Devices</h2>
    <p>This will revoke all active sessions on every device.</p>
    <form asp-area="Auth" asp-controller="LogoutAll" asp-action="Index" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Sign Out Everywhere</button>
        <a asp-area="Auth" asp-controller="Sessions" asp-action="Index"
           class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>
