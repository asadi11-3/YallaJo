<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Controllers\**" />
    <Compile Remove="Models\**" />
    <Compile Remove="Shared\**" />
    <Content Remove="Controllers\**" />
    <Content Remove="Models\**" />
    <Content Remove="Shared\**" />
    <EmbeddedResource Remove="Controllers\**" />
    <EmbeddedResource Remove="Models\**" />
    <EmbeddedResource Remove="Shared\**" />
    <None Remove="Controllers\**" />
    <None Remove="Models\**" />
    <None Remove="Shared\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="14.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="9.0.15" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook" Version="9.0.0" />
    <!-- Standard resilience pipeline (retry + circuit breaker + timeouts) for the
         BFF → API typed client. 9.x line aligns with the net9.0 target framework. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.10.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 5A — internal helpers (e.g. AuditLogsApiClient.BuildUrl,
         JsonMetadataFormatter) need to be testable from
         tests/Web.Tests.Unit without forcing them onto the public API. -->
    <InternalsVisibleTo Include="Web.Tests.Unit" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Areas\Admin\Modules\Security\Features\AuditLogs\Requests\" />
    <Folder Include="Areas\Admin\Modules\Security\Features\AuditLogs\Validators\" />
    <Folder Include="Areas\Admin\Modules\Security\Features\Roles\Validators\" />
    <Folder Include="Areas\Admin\Modules\Security\Features\Users\Validators\" />
    <Folder Include="Areas\Auth\Features\Devices\" />

    <Folder Include="Areas\Auth\Features\ForgotPassword\Validators\" />
    <Folder Include="Areas\Auth\Features\ForgotPassword\Views\" />
    <Folder Include="Areas\Auth\Features\ForgotPassword\ViewModels\" />
    <Folder Include="Areas\Auth\Features\ForgotPassword\Responses\" />
    <Folder Include="Areas\Auth\Features\ForgotPassword\Requests\" />
    <Folder Include="Areas\Auth\Features\Login\Views\" />
    <Folder Include="Areas\Auth\Features\Logout\Responses\" />
    <Folder Include="Areas\Auth\Features\Sessions\Validators\" />
    <Folder Include="Areas\Auth\Features\ResetPassword\" />
    <Folder Include="Infrastructure\Api\Core\" />
    <Folder Include="Infrastructure\Api\Handlers\" />
    <Folder Include="Infrastructure\Authentication\Claims\" />
    <Folder Include="Infrastructure\Authentication\Cookie\" />
    <Folder Include="Infrastructure\Authentication\SignIn\" />
    <Folder Include="Infrastructure\Authentication\Tokens\" />
    <Folder Include="Infrastructure\Constants\" />
    <Folder Include="Infrastructure\DependencyInjection\" />
    <Folder Include="Infrastructure\Navigation\" />
    <Folder Include="Infrastructure\State\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="AsyncAwaitBestPractices" Version="9.0.0" />
  </ItemGroup>

</Project>
