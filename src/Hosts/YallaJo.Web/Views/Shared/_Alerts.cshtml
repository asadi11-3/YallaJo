@*
    Shared flash-message banners. Reads the TempData keys written by BaseController
    (SetSuccess => "Success", SetError => "Error"; "Warning"/"Info" supported too).
    Included once in _Layout.cshtml so feature views never repeat alert markup.
    Styled to match the Webestica "Booking" theme: soft/subtle backgrounds,
    rounded corners, leading bootstrap-icon, borderless with a subtle shadow.
*@
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> L
@{
    // (key, bootstrap variant, bootstrap-icon, aria role)
    var alerts = new[]
    {
        ("Success", "success", "bi-check-circle-fill", "status"),
        ("Error",   "danger",  "bi-exclamation-octagon-fill", "alert"),
        ("Warning", "warning", "bi-exclamation-triangle-fill", "alert"),
        ("Info",    "info",    "bi-info-circle-fill", "status"),
    };
}
@foreach (var (key, variant, icon, role) in alerts)
{
    if (TempData[key] is string message && !string.IsNullOrWhiteSpace(message))
    {
        <div class="alert alert-@variant alert-dismissible border-0 rounded-3 shadow-sm fade show d-flex align-items-center"
             role="@role">
            <i class="bi @icon fs-5 me-2 flex-shrink-0"></i>
            <span class="flex-grow-1">@message</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Search.Overlay.Close"]"></button>
        </div>
    }
}
