@model YallaJo.Web.Areas.Public.Models.Tours.TourDetailVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<YallaJo.Web.Resources.SharedResource> L

<div class="modal fade" id="joinRequestModal" tabindex="-1" aria-labelledby="joinRequestModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="joinRequestModalLabel">@L["Public.JoinModal.Title"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Public.Close"]"></button>
            </div>
            <form method="post" asp-area="Public" asp-controller="Tours" asp-action="RequestJoin" asp-route-slug="@Model.Slug">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p class="small text-muted">@L["Public.JoinModal.Intro"]</p>

                    <div class="mb-3">
                        <label class="form-label" for="join-booking-id">@L["Public.JoinModal.BookingIdLabel"]</label>
                        <input type="text" class="form-control" id="join-booking-id" name="tourBookingId" required dir="ltr" placeholder="@L["Public.JoinModal.BookingIdPlaceholder"]" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="join-slot">@L["Public.JoinModal.DateTimeLabel"]</label>
                        @if (Model.HasJoinSlots)
                        {
                            <select class="form-select" id="join-slot" name="availabilitySlotId" required>
                                @foreach (var slot in Model.JoinSlots)
                                {
                                    <option value="@slot.SlotId">@slot.Label</option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0">@L["Public.JoinModal.NoSlots"]</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="join-participants">@L["Public.Participants"]</label>
                        <input type="number" class="form-control" id="join-participants" name="participantCount" min="1" value="1" required />
                    </div>

                    <div class="mb-0">
                        <label class="form-label" for="join-message">@L["Public.JoinModal.MessageLabel"]</label>
                        <textarea class="form-control" id="join-message" name="message" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@L["Public.Cancel"]</button>
                    <button type="submit" class="btn btn-primary" @(Model.HasJoinSlots ? "" : "disabled")>@L["Public.JoinModal.Send"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
