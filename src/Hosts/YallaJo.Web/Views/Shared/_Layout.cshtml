@using System.Globalization
@using YallaJo.Web.Infrastructure.Identity
@inject ICurrentUser CurrentUser
@inject Microsoft.Extensions.Localization.IStringLocalizer<YallaJo.Web.Resources.SharedResource> L
@*
    Shared application layout — adapted from the Webestica "Booking" Bootstrap 5 theme (Hotel Home / index.html).

    Theme chrome (head assets, footer, mobile navbar, vendor scripts) is preserved verbatim in structure,
    with two deliberate changes for the ASP.NET Core MVC host:
      1. All static "assets/..." paths are rewritten to "~/assets/..." so the link/script tag helpers emit
         fingerprinted, immutable-cached URLs via MapStaticAssets()/.WithStaticAssets().
      2. The theme's demo dropdown links (static .html files) are rewired to real asp-area/asp-controller/asp-action
         routes and gated with <permission> tag helpers.

    The sticky top header lives in the _Navbar2.cshtml partial (single source of truth).

    NOTE: assets/css/style.css already bundles Bootstrap v5.3.0, so no separate Bootstrap CSS link is loaded.
*@
@{
    var seoCulture = CultureInfo.CurrentUICulture;
    var seoDir = seoCulture.TextInfo.IsRightToLeft ? "rtl" : "ltr";
}
<!DOCTYPE html>
<html lang="@seoCulture.TwoLetterISOLanguageName" dir="@seoDir">
<head>
    @* dark mode switch (must run before stylesheets paint to avoid a flash of the wrong theme) *@
    <script src="~/assets/js/theme-bootstrap.js" asp-append-version="true"></script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - YallaJo</title>

    @* SEO metadata — reusable; populated per page via ViewData.SetSeo(...) (see Infrastructure/Seo) or set directly. *@
    @if (ViewData["MetaDescription"] is string seoDescription && !string.IsNullOrWhiteSpace(seoDescription))
    {
        <meta name="description" content="@seoDescription" />
        <meta property="og:description" content="@seoDescription" />
    }
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:type" content="@(ViewData["OgType"] as string ?? "website")" />
    <meta property="og:site_name" content="YallaJo" />
    <meta property="og:locale" content="@seoCulture.Name.Replace('-', '_')" />
    @if (ViewData["Canonical"] is string seoCanonical && !string.IsNullOrWhiteSpace(seoCanonical))
    {
        <link rel="canonical" href="@seoCanonical" />
        <meta property="og:url" content="@seoCanonical" />
    }
    @if (ViewData["OgImage"] is string seoOgImage && !string.IsNullOrWhiteSpace(seoOgImage))
    {
        <meta property="og:image" content="@seoOgImage" />
        <meta name="twitter:card" content="summary_large_image" />
    }
    @if (ViewData["Robots"] is string seoRobots && !string.IsNullOrWhiteSpace(seoRobots))
    {
        <meta name="robots" content="@seoRobots" />
    }
    @if (ViewData["JsonLd"] is string seoJsonLd && !string.IsNullOrWhiteSpace(seoJsonLd))
    {
        @* // SANITIZED: JSON-LD is server-generated from typed builders, never user input. *@
        <script type="application/ld+json">@Html.Raw(seoJsonLd)</script>
    }

    @* Language toggle: persists culture via the .AspNetCore.Culture cookie + reload (CookieRequestCultureProvider). CSP-safe external script per A6/SEC1/J3. *@
    <script src="~/assets/js/language-toggle.js" asp-append-version="true" defer></script>

    @* favicon *@
    <link rel="shortcut icon" href="~/assets/images/favicon.ico" />

    @* Plugins CSS *@
    <link rel="stylesheet" type="text/css" href="~/assets/vendor/font-awesome/css/all.min.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/vendor/tiny-slider/tiny-slider.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/vendor/glightbox/css/glightbox.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/vendor/flatpickr/css/flatpickr.min.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/vendor/choices/css/choices.min.css" />

    @* Theme CSS (bundles Bootstrap v5.3.0) *@
    <link rel="stylesheet" type="text/css" href="~/assets/css/style.css" />

    @* Site CSS — self-hosted fonts (UI-PERF-V3/V4, no Google Fonts CDN per A5), shell styles, shared utilities *@
    <link rel="stylesheet" type="text/css" href="~/assets/css/site.css" asp-append-version="true" />

    @* RTL overrides — loaded only for right-to-left cultures (UI-UX-Design.md §2) *@
    @if (seoDir == "rtl")
    {
        <link rel="stylesheet" type="text/css" href="~/assets/css/rtl.css" asp-append-version="true" />
    }


    @* Per-view extra styles *@
    @await RenderSectionAsync("Styles", required: false)
    @* Import map for fingerprinted JS modules served via MapStaticAssets()/.WithStaticAssets(). *@
    <ImportMap />
</head>

<body class="has-navbar-mobile @ViewData["BodyClass"]">

    <partial name="_Navbar2" />

    @* **************** MAIN CONTENT START **************** *@
    <main>
        <partial name="_Alerts" />
        @RenderBody()
    </main>
    @* **************** MAIN CONTENT END **************** *@

    @* **************** Footer START **************** *@
    <footer class="bg-dark pt-5">
        <div class="container">
            @* Row START *@
            <div class="row g-4">
                @* Widget 1 START *@
                <div class="col-lg-3">
                    @* logo *@
                    <a class="navbar-brand" asp-area="Public" asp-controller="Home" asp-action="Index">
                        <img class="h-40px" src="~/assets/images/logo-light.svg" alt="YallaJo" />
                    </a>
                    <p class="my-3 text-body-secondary">@L["Footer.Tagline"]</p>
                </div>
                @* Widget 1 END *@

                @* Widget 2 START *@
                <div class="col-lg-8 ms-auto">
                    <div class="row g-4">
                        @* Explore *@
                        <div class="col-6 col-md-4">
                            <h5 class="text-white mb-2 mb-md-4">@L["Footer.Explore"]</h5>
                            <ul class="nav flex-column text-primary-hover">
                                <li class="nav-item"><a class="nav-link text-body-secondary" asp-area="Public" asp-controller="Tours" asp-action="Index">@L["Navbar.Tours"]</a></li>
                                <li class="nav-item"><a class="nav-link text-body-secondary" asp-area="Public" asp-controller="Places" asp-action="Index">@L["Navbar.Destinations"]</a></li>
                                <li class="nav-item"><a class="nav-link text-body-secondary" asp-area="Public" asp-controller="Packages" asp-action="Index">@L["Navbar.Packages"]</a></li>
                                <li class="nav-item"><a class="nav-link text-body-secondary" asp-area="Public" asp-controller="Guides" asp-action="Index">@L["Navbar.Guides"]</a></li>
                                <li class="nav-item"><a class="nav-link text-body-secondary" asp-area="Public" asp-controller="Directory" asp-action="Index">@L["Navbar.Directory"]</a></li>
                            </ul>
                        </div>

                        @* Company *@
                        <div class="col-6 col-md-4">
                            <h5 class="text-white mb-2 mb-md-4">@L["Footer.Company"]</h5>
                            <ul class="nav flex-column text-primary-hover">
                                <li class="nav-item"><a class="nav-link text-body-secondary" asp-area="Public" asp-controller="Blog" asp-action="Index">@L["Footer.Blog"]</a></li>
                                <li class="nav-item"><a class="nav-link text-body-secondary" asp-area="Public" asp-controller="Agencies" asp-action="Index">@L["Navbar.Agencies"]</a></li>
                                <li class="nav-item"><a class="nav-link text-body-secondary" asp-area="Public" asp-controller="Contact" asp-action="Index">@L["Navbar.Contact"]</a></li>
                            </ul>
                        </div>

                        @* Support *@
                        <div class="col-6 col-md-4">
                            <h5 class="text-white mb-2 mb-md-4">@L["Footer.Support"]</h5>
                            <ul class="nav flex-column text-primary-hover">
                                <li class="nav-item"><a class="nav-link text-body-secondary" asp-area="Public" asp-controller="Help" asp-action="Index">@L["Navbar.Help"]</a></li>
                                <li class="nav-item"><a class="nav-link text-body-secondary" asp-area="Public" asp-controller="Help" asp-action="Index">@L["Navbar.Faq"]</a></li>
                                @* TODO(backend): no Privacy/Terms pages exist yet; wire these once legal content pages ship. *@
                            </ul>
                        </div>
                    </div>
                </div>
                @* Widget 2 END *@
            </div>
            @* Row END *@

            @* Divider *@
            <hr class="mt-4 mb-3" />

            @* Bottom footer START *@
            <div class="d-md-flex justify-content-between align-items-center py-3 text-center text-md-start">
                <div class="text-body-secondary text-primary-hover">
                    &copy;@DateTime.Now.Year YallaJo. @L["Footer.Rights"]
                </div>
            </div>
            @* Bottom footer END *@
        </div>
    </footer>
    @* **************** Footer END **************** *@

    @* Back to top *@
    <div class="back-top"></div>

    @* **************** Navbar Mobile START **************** *@
    @* Public mobile bottom nav per UI-UX-D3: Browse / Search / Wishlist / Bookings / Profile.
       Search is a real link to /tours (PE1); search-overlay.js intercepts it to open the overlay. *@
    <div class="navbar navbar-mobile">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" asp-area="Public" asp-controller="Tours" asp-action="Index">
                    <i class="bi bi-compass fs-4"></i>
                    <span class="mb-0 nav-text">@L["MobileNav.Browse"]</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link js-search-toggle" asp-area="Public" asp-controller="Tours" asp-action="Index">
                    <i class="bi bi-search fs-4"></i>
                    <span class="mb-0 nav-text">@L["MobileNav.Search"]</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Accounts" asp-controller="Wishlist" asp-action="Index">
                    <i class="bi bi-heart fs-4"></i>
                    <span class="mb-0 nav-text">@L["MobileNav.Wishlist"]</span>
                </a>
            </li>
            <li class="nav-item">
                @if (CurrentUser.IsAuthenticated)
                {
                    <a class="nav-link" asp-area="Accounts" asp-controller="Bookings" asp-action="Index">
                        <i class="bi bi-bookmark-check fs-4"></i>
                        <span class="mb-0 nav-text">@L["MobileNav.Bookings"]</span>
                    </a>
                }
                else
                {
                    <a class="nav-link" asp-area="Auth" asp-controller="Auth" asp-action="SignIn">
                        <i class="bi bi-bookmark-check fs-4"></i>
                        <span class="mb-0 nav-text">@L["MobileNav.Bookings"]</span>
                    </a>
                }
            </li>
            <li class="nav-item">
                @if (CurrentUser.IsAuthenticated)
                {
                    <a class="nav-link" asp-area="Accounts" asp-controller="Profile" asp-action="Index">
                        <i class="bi bi-person-circle fs-4"></i>
                        <span class="mb-0 nav-text">@L["MobileNav.Profile"]</span>
                    </a>
                }
                else
                {
                    <a class="nav-link" asp-area="Auth" asp-controller="Auth" asp-action="SignIn">
                        <i class="bi bi-person-circle fs-4"></i>
                        <span class="mb-0 nav-text">@L["Navbar.SignIn"]</span>
                    </a>
                }
            </li>
        </ul>
    </div>
    @* **************** Navbar Mobile END **************** *@

    @* Bootstrap JS bundle (served locally; fingerprinted + immutable-cached via .WithStaticAssets()). *@
    <script src="~/assets/vendor/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @* Vendor plugins *@
    <script src="~/assets/vendor/tiny-slider/tiny-slider.js"></script>
    <script src="~/assets/vendor/glightbox/js/glightbox.js"></script>
    <script src="~/assets/vendor/flatpickr/js/flatpickr.min.js"></script>
    <script src="~/assets/vendor/choices/js/choices.min.js"></script>

    @* Theme functions *@
    <script src="~/assets/js/functions.js"></script>

    @* Antiforgery token consumed by api-client.js for all AJAX POSTs (rules UI-SEC SEC7).
       Rendered unconditionally so guest interactions (e.g. wishlist sign-in redirect per WL1) work too. *@
    @Html.AntiForgeryToken()

    @* Shared AJAX client + site-wide form UX (loading states, toasts, confirm modal). Rules UI-JS JS5, UI-UX-L2/F7/NF1. *@
    <script src="~/assets/js/api-client.js" asp-append-version="true"></script>
    <script src="~/assets/js/form-ux.js" asp-append-version="true"></script>

    @* Wishlist favorite toggle (delegated handler for .js-favorite buttons on cards; guests are sent to sign-in per WL1). *@
    <script src="~/assets/js/favorites.js" asp-append-version="true"></script>
    @* Navbar search overlay (UI-UX-S2); triggers degrade to plain /tours links without JS (PE1) *@
    <script src="~/assets/js/search-overlay.js" asp-append-version="true"></script>

    @* Per-view extra scripts *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
