@using System.Globalization
@using YallaJo.Web.Infrastructure.Identity
@inject ICurrentUser CurrentUser
@*
    Shared application layout — adapted from the Webestica "Booking" Bootstrap 5 theme (Hotel Home / index.html).

    Theme chrome (head assets, footer, mobile navbar, vendor scripts) is preserved verbatim in structure,
    with two deliberate changes for the ASP.NET Core MVC host:
      1. All static "assets/..." paths are rewritten to "~/assets/..." so the link/script tag helpers emit
         fingerprinted, immutable-cached URLs via MapStaticAssets()/.WithStaticAssets().
      2. The theme's demo dropdown links (static .html files) are rewired to real asp-area/asp-controller/asp-action
         routes and gated with <permission> tag helpers.

    The sticky top header lives in the _Navbar.cshtml partial (single source of truth).

    NOTE: assets/css/style.css already bundles Bootstrap v5.3.0, so no separate Bootstrap CSS link is loaded.
*@
@{
    var seoCulture = CultureInfo.CurrentUICulture;
    var seoDir = seoCulture.TextInfo.IsRightToLeft ? "rtl" : "ltr";
}
<!DOCTYPE html>
<html lang="@seoCulture.TwoLetterISOLanguageName" dir="@seoDir">
<head>
    @* dark mode switch (must run before stylesheets paint to avoid a flash of the wrong theme) *@
    <script src="~/assets/js/theme-bootstrap.js" asp-append-version="true"></script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - YallaJo</title>

    @* SEO metadata — reusable; populated per page via ViewData.SetSeo(...) (see Infrastructure/Seo) or set directly. *@
    @if (ViewData["MetaDescription"] is string seoDescription && !string.IsNullOrWhiteSpace(seoDescription))
    {
        <meta name="description" content="@seoDescription" />
        <meta property="og:description" content="@seoDescription" />
    }
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:type" content="@(ViewData["OgType"] as string ?? "website")" />
    <meta property="og:site_name" content="YallaJo" />
    <meta property="og:locale" content="@seoCulture.Name.Replace('-', '_')" />
    @if (ViewData["Canonical"] is string seoCanonical && !string.IsNullOrWhiteSpace(seoCanonical))
    {
        <link rel="canonical" href="@seoCanonical" />
        <meta property="og:url" content="@seoCanonical" />
    }
    @if (ViewData["OgImage"] is string seoOgImage && !string.IsNullOrWhiteSpace(seoOgImage))
    {
        <meta property="og:image" content="@seoOgImage" />
        <meta name="twitter:card" content="summary_large_image" />
    }
    @if (ViewData["Robots"] is string seoRobots && !string.IsNullOrWhiteSpace(seoRobots))
    {
        <meta name="robots" content="@seoRobots" />
    }
    @if (ViewData["JsonLd"] is string seoJsonLd && !string.IsNullOrWhiteSpace(seoJsonLd))
    {
        @* // SANITIZED: JSON-LD is server-generated from typed builders, never user input. *@
        <script type="application/ld+json">@Html.Raw(seoJsonLd)</script>
    }

    @* Language toggle: persists culture via the .AspNetCore.Culture cookie + reload (CookieRequestCultureProvider). CSP-safe external script per A6/SEC1/J3. *@
    <script src="~/assets/js/language-toggle.js" asp-append-version="true" defer></script>

    @* favicon *@
    <link rel="shortcut icon" href="~/assets/images/favicon.ico" />

    @* Google Fonts *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />

    @* Plugins CSS *@
    <link rel="stylesheet" type="text/css" href="~/assets/vendor/font-awesome/css/all.min.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/vendor/tiny-slider/tiny-slider.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/vendor/glightbox/css/glightbox.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/vendor/flatpickr/css/flatpickr.min.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/vendor/choices/css/choices.min.css" />

    @* Theme CSS (bundles Bootstrap v5.3.0) *@
    <link rel="stylesheet" type="text/css" href="~/assets/css/style.css" />

    @* RTL overrides — loaded only for right-to-left cultures (UI-UX-Design.md §2) *@
    @if (seoDir == "rtl")
    {
        <link rel="stylesheet" type="text/css" href="~/assets/css/rtl.css" asp-append-version="true" />
    }


    @* Per-view extra styles *@
    @await RenderSectionAsync("Styles", required: false)
    <style>
        .lang-toggle {
        display: inline-flex;
        align-items: center;
        gap: .15rem;
        background-color: var(--bs-light, #f5f5f5);
        border-radius: var(--bs-border-radius, .5rem); /* match the notification button corners */
        padding: .2rem;
        height: 40px; /* match the bell / avatar height */
        margin-inline-end: .5rem; /* keep clear of the notification button */
        }

        .lang-toggle-btn {
        border: 0;
        background: transparent;
        color: var(--bs-secondary-color, #6c757d);
        font-size: .8rem;
        font-weight: 600;
        line-height: 1;
        padding: .35rem .6rem;
        border-radius: calc(var(--bs-border-radius, .5rem) - .15rem); /* match inner corners */
        cursor: pointer;
        transition: background-color .2s ease, color .2s ease;
        }

        .lang-toggle-btn.active {
        background-color: var(--bs-dark, #14191e);
        color: #fff;
        }

        /* ===== RTL fixes for header dropdowns ===== */
        /* The profile menu is positioned statically (data-bs-display="static"),
        so its .dropdown-menu-end keeps right:0 even in RTL and opens off-screen.
        Re-anchor end-aligned menus to the start edge when the page is RTL. */
        [dir="rtl"] .navbar .dropdown-menu-end {
        right: auto !important;
        left: 0 !important;
        }

        /* Keep dropdown text/items reading from the right in RTL */
        [dir="rtl"] .navbar .dropdown-menu,
        [dir="rtl"] .navbar .dropdown-item,
        [dir="rtl"] .navbar .card-header,
        [dir="rtl"] .navbar .list-group-item {
        text-align: right;
        }

        /* Profile header (avatar + name) realignment in RTL */
        [dir="rtl"] .navbar .dropdown-menu .avatar.me-3 {
        margin-right: 0 !important;
        margin-left: 1rem !important;
        }

        /* Notification "dot" sits on the bell — move it to the opposite corner in RTL */
        [dir="rtl"] .notif-badge {
        right: auto;
        left: 0.5rem;
        }
    </style>
    @* Import map for fingerprinted JS modules served via MapStaticAssets()/.WithStaticAssets(). *@
    <ImportMap />
</head>

<body class="has-navbar-mobile">

    <partial name="_Navbar2" />

    @* **************** MAIN CONTENT START **************** *@
    <main>
        <partial name="_Alerts" />
        @RenderBody()
    </main>
    @* **************** MAIN CONTENT END **************** *@

    @* **************** Footer START **************** *@
    <footer class="bg-dark pt-5">
        <div class="container">
            @* Row START *@
            <div class="row g-4">
                @* Widget 1 START *@
                <div class="col-lg-3">
                    @* logo *@
                    <a class="navbar-brand" asp-area="Accounts" asp-controller="Profile" asp-action="Index">
                        <img class="h-40px" src="~/assets/images/logo-light.svg" alt="logo" />
                    </a>
                    <p class="my-3 text-body-secondary">YallaJo — your trusted booking platform.</p>
                </div>
                @* Widget 1 END *@

                @* Widget 2 START *@
                <div class="col-lg-8 ms-auto">
                    <div class="row g-4">
                        @* Link block *@
                        <div class="col-6 col-md-4">
                            <h5 class="text-white mb-2 mb-md-4">Company</h5>
                            <ul class="nav flex-column text-primary-hover">
                                <li class="nav-item"><a class="nav-link text-body-secondary" asp-area="Accounts" asp-controller="Profile" asp-action="Index">My Profile</a></li>
                                <li class="nav-item"><a class="nav-link text-body-secondary" asp-area="Auth" asp-controller="Sessions" asp-action="Index">Sessions</a></li>
                                <li class="nav-item"><a class="nav-link text-body-secondary" asp-area="Auth" asp-controller="Devices" asp-action="Index">Devices</a></li>
                            </ul>
                        </div>

                        @* Link block *@
                        <div class="col-6 col-md-4">
                            <h5 class="text-white mb-2 mb-md-4">Account</h5>
                            <ul class="nav flex-column text-primary-hover">
                                <li class="nav-item"><a class="nav-link text-body-secondary" asp-area="Accounts" asp-controller="ChangePassword" asp-action="Index">Change Password</a></li>
                                <li class="nav-item"><a class="nav-link text-body-secondary" asp-area="Accounts" asp-controller="UpdatePhone" asp-action="Index">Update Phone</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
                @* Widget 2 END *@
            </div>
            @* Row END *@

            @* Divider *@
            <hr class="mt-4 mb-3" />

            @* Bottom footer START *@
            <div class="d-md-flex justify-content-between align-items-center py-3 text-center text-md-start">
                <div class="text-body-secondary text-primary-hover">
                    Copyrights &copy;@DateTime.Now.Year YallaJo.
                </div>
            </div>
            @* Bottom footer END *@
        </div>
    </footer>
    @* **************** Footer END **************** *@

    @* Back to top *@
    <div class="back-top"></div>

    @* **************** Navbar Mobile START **************** *@
    @if (CurrentUser.IsAuthenticated)
    {
        <div class="navbar navbar-mobile">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" asp-area="Accounts" asp-controller="Profile" asp-action="Index">
                        <i class="bi bi-house-door fs-4"></i>
                        <span class="mb-0 nav-text">Home</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Auth" asp-controller="Sessions" asp-action="Index">
                        <i class="bi bi-laptop fs-4"></i>
                        <span class="mb-0 nav-text">Sessions</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Auth" asp-controller="Devices" asp-action="Index">
                        <i class="bi bi-phone fs-4"></i>
                        <span class="mb-0 nav-text">Devices</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Accounts" asp-controller="Profile" asp-action="Index">
                        <i class="bi bi-person-circle fs-4"></i>
                        <span class="mb-0 nav-text">Account</span>
                    </a>
                </li>
            </ul>
        </div>
    }
    @* **************** Navbar Mobile END **************** *@

    @* Bootstrap JS bundle (served locally; fingerprinted + immutable-cached via .WithStaticAssets()). *@
    <script src="~/assets/vendor/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @* Vendor plugins *@
    <script src="~/assets/vendor/tiny-slider/tiny-slider.js"></script>
    <script src="~/assets/vendor/glightbox/js/glightbox.js"></script>
    <script src="~/assets/vendor/flatpickr/js/flatpickr.min.js"></script>
    <script src="~/assets/vendor/choices/js/choices.min.js"></script>

    @* Theme functions *@
    <script src="~/assets/js/functions.js"></script>

    @* Wishlist favorite toggle (delegated handler for .js-favorite buttons on cards). *@
    @if (CurrentUser.IsAuthenticated)
    {
        @Html.AntiForgeryToken()
        <script src="~/assets/js/favorites.js" asp-append-version="true"></script>
    }

    @* Per-view extra scripts *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
