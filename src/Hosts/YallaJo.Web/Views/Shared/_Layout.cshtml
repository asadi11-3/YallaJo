<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - YallaJo</title>
    @* Bootstrap CSS: kept on CDN — no local copy ships in wwwroot/assets/vendor/bootstrap (only the JS bundle is local). *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    @* Bootstrap-icons: served locally so MapStaticAssets/.WithStaticAssets() applies SHA-256 fingerprinting + immutable, far-future caching (fonts resolve via the relative fonts/ path). The link tag helper rewrites href to the fingerprinted name automatically. *@
    <link rel="stylesheet" href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" />
    <style>
        body { background-color: #f8f9fa; }
        .auth-card { max-width: 420px; margin: 80px auto; }
    </style>
    @* Emits the import map for fingerprinted JS modules served via MapStaticAssets/.WithStaticAssets(). *@
    <ImportMap />
</head>
<body>
    <partial name="_Navbar" />
    <div class="container">
        <partial name="_Alerts" />
        @RenderBody()
    </div>
    @* Bootstrap JS bundle: served locally (fingerprinted + immutable-cached via .WithStaticAssets()). *@
    <script src="~/assets/vendor/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
