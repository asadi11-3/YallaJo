@model YallaJo.Web.Features.Notifications.NotificationBellVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<YallaJo.Web.Resources.SharedResource> L
@{
    string TimeAgo(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalMinutes < 1) return L["Public.TimeAgo.JustNow"].Value;
        if (span.TotalMinutes < 60) return L["Public.TimeAgo.MinutesShort", (int)span.TotalMinutes].Value;
        if (span.TotalHours < 24) return L["Public.TimeAgo.HoursShort", (int)span.TotalHours].Value;
        if (span.TotalDays < 7) return L["Public.TimeAgo.DaysShort", (int)span.TotalDays].Value;
        return utc.ToString("dd MMM yyyy");
    }
}

<li class="nav-item dropdown ms-0 ms-md-3">
    <!-- Notification button -->
    <a class="nav-notification btn btn-light p-0 mb-0" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" data-bs-auto-close="outside">
        <i class="bi bi-bell fa-fw"></i>
    </a>
    <!-- Notification dote -->
    @if (Model.HasUnread)
    {
        <span class="badge bg-danger rounded-circle notif-badge animation-blink">@(Model.UnreadCount > 99 ? "99+" : Model.UnreadCount.ToString())</span>
    }

    <!-- Notification dropdown menu START -->
    <div class="dropdown-menu dropdown-animation dropdown-menu-end dropdown-menu-size-md shadow-lg p-0">
        <div class="card bg-transparent">
            <!-- Card header -->
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center border-bottom">
                <h6 class="m-0">
                    @L["Public.Notifications"] @if (Model.HasUnread)
                    {
                        <span class="badge bg-danger bg-opacity-10 text-danger ms-2">@L["Public.CountNew", Model.UnreadCount]</span>
                    }
                </h6>

                @if (Model.HasUnread)
                {
                    <form asp-area="" asp-controller="Notifications" asp-action="MarkAllRead" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link btn-sm p-0 text-decoration-none">@L["Public.MarkAllRead"]</button>
                    </form>
                }
            </div>

            <!-- Card body START -->
            <div class="card-body p-0">
                <ul class="list-group list-group-flush list-unstyled p-2">
                    <!-- Notification item -->
                    @if (!Model.HasRecent)
                    {
                        <li class="text-center small text-muted py-3">@L["Public.NoNewNotifications"]</li>
                    }
                    else
                    {
                        @foreach (var n in Model.Recent)
                        {
                            <li class="list-group-item rounded mb-1 @(n.IsRead ? "" : "bg-primary bg-opacity-10")">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="me-2">
                                        <h6 class="mb-1 small @(n.IsRead ? "text-body" : "fw-bold")">@n.Title</h6>
                                        @if (!string.IsNullOrWhiteSpace(n.Body))
                                        {
                                            <p class="mb-1 small text-body-secondary">@n.Body</p>
                                        }
                                        <span class="small text-muted">@TimeAgo(n.CreatedAt)</span>
                                    </div>
                                    @if (!n.IsRead)
                                    {
                                        <form asp-area="" asp-controller="Notifications" asp-action="MarkRead" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@n.Id" />
                                            <button type="submit" class="btn btn-sm btn-link p-0 text-decoration-none" title="@L["Public.MarkAsRead"]"><i class="bi bi-check2"></i></button>
                                        </form>
                                    }
                                </div>
                            </li>
                        }
                    }

                    
                </ul>
            </div>
            <!-- Card body END -->
            <!-- Card footer -->
            <div class="card-footer bg-transparent text-center border-top">
                <a asp-area="Accounts" asp-controller="Notifications" asp-action="Index" class="btn btn-link btn-sm text-decoration-none">@L["Public.ViewAllNotifications"]</a>
            </div>
        </div>
    </div>
    <!-- Notification dropdown menu END -->
</li>
