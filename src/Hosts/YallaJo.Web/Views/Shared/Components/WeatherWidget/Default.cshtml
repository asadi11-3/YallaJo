@using Microsoft.Extensions.Localization
@model YallaJo.Web.Areas.Business.Models.Weather.WeatherWidgetVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@if (Model.Available)
{
    <div class="card border bg-info bg-opacity-10" role="region" aria-label="@Localizer["Business.Weather.RegionLabel"]">
        <div class="card-body d-flex align-items-center gap-3 py-3">
            <i class="bi bi-cloud-sun fs-2 text-info" aria-hidden="true"></i>
            <div class="flex-grow-1">
                <div class="d-flex align-items-baseline gap-2 flex-wrap">
                    @if (Model.Temperature is { } t)
                    {
                        <span class="h4 mb-0"><span dir="ltr">@t.ToString("0")°C</span></span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Condition))
                    {
                        <span class="text-body-secondary">@Model.Condition</span>
                    }
                </div>
                <div class="small text-body-secondary">
                    @if (Model.FeelsLike is { } f) { <span>@Localizer["Business.Weather.FeelsLike"] <span dir="ltr">@f.ToString("0")°C</span></span> }
                    @if (Model.Humidity is { } h) { <text> · @Localizer["Business.Weather.Humidity", h]</text> }
                    @if (Model.WindSpeed is { } w) { <text> · @Localizer["Business.Weather.Wind"] <span dir="ltr">@w.ToString("0") km/h</span></text> }
                </div>
                @if (Model.IsStale && !string.IsNullOrWhiteSpace(Model.StaleHumanLabel))
                {
                    <span class="badge text-bg-warning mt-1">
                        <i class="bi bi-clock-history me-1" aria-hidden="true"></i>@Model.StaleHumanLabel
                    </span>
                }
            </div>
        </div>
    </div>
}
