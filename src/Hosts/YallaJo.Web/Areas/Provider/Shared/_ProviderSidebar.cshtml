@using YallaJo.Web.Infrastructure.Authorization
@inject YallaJo.Web.Infrastructure.Identity.ICurrentUser CurrentUser
@model YallaJo.Web.Areas.Provider.Shared.ProviderSidebarVm
@{
    var active = ViewData["ProviderNav"] as string ?? "Dashboard";
    string Nav(string key) => active == key ? "nav-link active" : "nav-link";
    bool Has(string permission) => CurrentUser.HasPermission(permission);
}

<section class="pt-4">
    <div class="container">
        <div class="card rounded-3 border p-3 pb-2">
            <div class="d-sm-flex align-items-center">
                <div class="avatar avatar-xl flex-shrink-0">
                    <img class="avatar-img rounded-circle border border-white border-3"
                         src="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? Url.Content("~/assets/images/avatar/01.jpg") : Model.AvatarUrl)"
                         alt="avatar">
                </div>
                <div class="ms-sm-3 mt-2 mt-sm-0">
                    <h5 class="mb-0"><span class="fw-light">Hi,</span> @(string.IsNullOrWhiteSpace(Model.DisplayName) ? "Provider" : Model.DisplayName)</h5>
                    @if (!string.IsNullOrWhiteSpace(Model.Email))
                    {
                        <span class="small text-body-secondary">@Model.Email</span>
                    }
                </div>
                <a asp-area="Provider" asp-controller="Tour" asp-action="Create"
                   class="btn btn-sm btn-primary-soft ms-sm-auto mt-2 mt-sm-0">
                    <i class="bi bi-plus-lg me-2"></i>Add New Listing
                </a>
            </div>

            <button class="btn btn-primary w-100 d-block d-xl-none mt-3"
                    type="button" data-bs-toggle="offcanvas" data-bs-target="#providerDashboardMenu"
                    aria-controls="providerDashboardMenu">
                <i class="bi bi-list me-1"></i> Dashboard Menu
            </button>

            <div class="offcanvas-xl offcanvas-end mt-xl-3" tabindex="-1" id="providerDashboardMenu">
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title">Menu</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#providerDashboardMenu" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body p-3 p-xl-0">
                    <div class="navbar navbar-expand-xl w-100">
                        <ul class="navbar-nav nav nav-pills nav-pills-primary-soft flex-xl-row flex-column w-100">
                            <li class="nav-item">
                                <a class="@Nav("Dashboard")" asp-area="Provider" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-house-door fa-fw me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@Nav("Listings")" asp-area="Provider" asp-controller="Listings" asp-action="Index">
                                    <i class="bi bi-journals fa-fw me-1"></i>Listings
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@Nav("Bookings")" asp-area="Provider" asp-controller="Bookings" asp-action="Index">
                                    <i class="bi bi-bookmark-heart fa-fw me-1"></i>Bookings
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@Nav("Earnings")" asp-area="Provider" asp-controller="Earnings" asp-action="Index">
                                    <i class="bi bi-graph-up-arrow fa-fw me-1"></i>Earnings
                                </a>
                            </li>
                            @if (Has(WebPermission.Invoice.Read))
                            {
                                <li class="nav-item">
                                    <a class="@Nav("Invoices")" asp-area="Provider" asp-controller="Invoices" asp-action="Index">
                                        <i class="bi bi-receipt fa-fw me-1"></i>Invoices
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="@Nav("PaymentMethods")" asp-area="Provider" asp-controller="PaymentMethods" asp-action="Index">
                                    <i class="bi bi-credit-card-2-back fa-fw me-1"></i>Payment Methods
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@Nav("Reviews")" asp-area="Provider" asp-controller="Reviews" asp-action="Index">
                                    <i class="bi bi-star fa-fw me-1"></i>Reviews
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@Nav("Settings")" asp-area="Provider" asp-controller="Settings" asp-action="Index">
                                    <i class="bi bi-gear fa-fw me-1"></i>Settings
                                </a>
                            </li>
                            <li class="nav-item ms-xl-auto">
                                <form asp-area="Auth" asp-controller="Auth" asp-action="Logout" method="post" class="d-grid">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="nav-link text-start text-danger bg-danger-soft-hover border-0 bg-transparent w-100">
                                        <i class="fas fa-sign-out-alt fa-fw me-1"></i>Sign Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
