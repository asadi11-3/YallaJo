@using YallaJo.Web.Areas.Accounts.Models.Profile
@model YallaJo.Web.Areas.Provider.Models.Settings.ProviderSettingsVm
@{
    ViewData["Title"] = Localizer["Provider.Settings.Title"].Value;
    ViewData["ProviderNav"] = "Settings";
    var avatar = string.IsNullOrWhiteSpace(Model.AvatarUrl) ? Url.Content("~/assets/images/avatar/01.jpg") : Model.AvatarUrl;
}

@await Component.InvokeAsync("ProviderSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">

        <div class="d-flex align-items-center">
            <div class="avatar avatar-lg me-3">
                <img class="avatar-img rounded-circle border border-2 border-white" src="@avatar" width="64" height="64" alt="@Model.DisplayName">
            </div>
            <div>
                <h1 class="fs-4 mb-0"><i class="fa-solid fa-gear me-2" aria-hidden="true"></i>@Localizer["Provider.Settings.Heading"]</h1>
                <p class="mb-0 small text-secondary">
                    @Model.DisplayName
                    @if (!string.IsNullOrWhiteSpace(Model.Email))
                    {
                        <span>· <bdi dir="ltr">@Model.Email</bdi></span>
                    }
                </p>
            </div>
        </div>

        <div class="row g-4">
            @if (Model.Business is not null)
            {
                var biz = Model.Business;
                <div class="col-12">
                    <div class="card border shadow-sm">
                        <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                            <h2 class="card-header-title h5 mb-0"><i class="fa-solid fa-building me-2" aria-hidden="true"></i>@Localizer["Provider.Settings.BusinessHeading"]</h2>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary">@biz.ProviderType</span>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <span class="form-label small text-secondary mb-0 d-block">@Localizer["Provider.Settings.BusinessName"]</span>
                                    <p class="mb-0 fw-semibold">@biz.BusinessName</p>
                                </div>
                                <div class="col-md-6">
                                    <span class="form-label small text-secondary mb-0 d-block">@Localizer["Provider.Settings.ContactEmail"]</span>
                                    <p class="mb-0"><bdi dir="ltr">@biz.ContactEmail</bdi></p>
                                </div>
                                <div class="col-md-6">
                                    <span class="form-label small text-secondary mb-0 d-block">@Localizer["Provider.Settings.ContactPhone"]</span>
                                    <p class="mb-0"><bdi dir="ltr">@biz.ContactPhone</bdi></p>
                                </div>
                                <div class="col-md-6">
                                    <span class="form-label small text-secondary mb-0 d-block">@Localizer["Provider.Settings.Address"]</span>
                                    <p class="mb-0">@biz.Address</p>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(biz.Description))
                                {
                                    <div class="col-12">
                                        <span class="form-label small text-secondary mb-0 d-block">@Localizer["Provider.Settings.Description"]</span>
                                        <p class="mb-0">@biz.Description</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* Personal information *@
            <div class="col-12">
                <div class="card border shadow-sm">
                    <div class="card-header border-bottom">
                        <h2 class="card-header-title h5 mb-0"><i class="fa-solid fa-user me-2" aria-hidden="true"></i>@Localizer["Provider.Settings.PersonalHeading"]</h2>
                    </div>
                    <div class="card-body">
                        <form method="post" data-loading asp-area="Provider" asp-controller="Settings" asp-action="UpdateProfile" class="row g-3">
                            @Html.AntiForgeryToken()
                            <div class="col-md-6">
                                <label asp-for="Profile.FirstName" class="form-label"></label>
                                <input asp-for="Profile.FirstName" class="form-control">
                                <span asp-validation-for="Profile.FirstName" class="text-danger small" role="alert"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Profile.LastName" class="form-label"></label>
                                <input asp-for="Profile.LastName" class="form-control">
                                <span asp-validation-for="Profile.LastName" class="text-danger small" role="alert"></span>
                            </div>
                            <div class="col-md-6">
                                <label for="settings-email" class="form-label">@Localizer["Provider.Settings.Email"]</label>
                                <input id="settings-email" class="form-control" dir="ltr" value="@Model.Email" readonly disabled>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Profile.DateOfBirth" class="form-label"></label>
                                <input asp-for="Profile.DateOfBirth" type="date" dir="ltr" class="form-control">
                                <span asp-validation-for="Profile.DateOfBirth" class="text-danger small" role="alert"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Profile.Gender" class="form-label"></label>
                                <select asp-for="Profile.Gender" asp-items="Html.GetEnumSelectList<GenderOption>()" class="form-select">
                                    <option value="">@Localizer["Provider.Settings.PreferNotToSay"]</option>
                                </select>
                                <span asp-validation-for="Profile.Gender" class="text-danger small" role="alert"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Profile.Country" class="form-label"></label>
                                <input asp-for="Profile.Country" class="form-control">
                                <span asp-validation-for="Profile.Country" class="text-danger small" role="alert"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Profile.City" class="form-label"></label>
                                <input asp-for="Profile.City" class="form-control">
                                <span asp-validation-for="Profile.City" class="text-danger small" role="alert"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Profile.AddressLine" class="form-label"></label>
                                <input asp-for="Profile.AddressLine" class="form-control">
                                <span asp-validation-for="Profile.AddressLine" class="text-danger small" role="alert"></span>
                            </div>
                            <div class="col-12 text-end">
                                <button type="submit" class="btn btn-primary mb-0">@Localizer["Provider.Settings.SaveChanges"]</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            @* Phone number *@
            <div class="col-md-6">
                <div class="card border shadow-sm h-100">
                    <div class="card-header border-bottom">
                        <h2 class="card-header-title h5 mb-0"><i class="fa-solid fa-phone me-2" aria-hidden="true"></i>@Localizer["Provider.Settings.PhoneHeading"]</h2>
                    </div>
                    <div class="card-body">
                        <form method="post" data-loading asp-area="Provider" asp-controller="Settings" asp-action="UpdatePhone" class="vstack gap-3">
                            @Html.AntiForgeryToken()
                            <div>
                                <label asp-for="Phone.PhoneNumber" class="form-label"></label>
                                <input asp-for="Phone.PhoneNumber" type="tel" dir="ltr" class="form-control" placeholder="+962 7 9999 9999">
                                <span asp-validation-for="Phone.PhoneNumber" class="text-danger small" role="alert"></span>
                            </div>
                            <div class="text-end">
                                <button type="submit" class="btn btn-primary-soft mb-0">@Localizer["Provider.Settings.UpdatePhone"]</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            @* Change password *@
            <div class="col-md-6">
                <div class="card border shadow-sm h-100">
                    <div class="card-header border-bottom">
                        <h2 class="card-header-title h5 mb-0"><i class="fa-solid fa-shield-halved me-2" aria-hidden="true"></i>@Localizer["Provider.Settings.PasswordHeading"]</h2>
                    </div>
                    <div class="card-body">
                        <form method="post" data-loading asp-area="Provider" asp-controller="Settings" asp-action="ChangePassword" class="vstack gap-3">
                            @Html.AntiForgeryToken()
                            <div>
                                <label asp-for="Password.CurrentPassword" class="form-label"></label>
                                <input asp-for="Password.CurrentPassword" type="password" class="form-control" autocomplete="current-password">
                                <span asp-validation-for="Password.CurrentPassword" class="text-danger small" role="alert"></span>
                            </div>
                            <div>
                                <label asp-for="Password.NewPassword" class="form-label"></label>
                                <input asp-for="Password.NewPassword" type="password" class="form-control" autocomplete="new-password">
                                <span asp-validation-for="Password.NewPassword" class="text-danger small" role="alert"></span>
                            </div>
                            <div>
                                <label asp-for="Password.ConfirmNewPassword" class="form-label"></label>
                                <input asp-for="Password.ConfirmNewPassword" type="password" class="form-control" autocomplete="new-password">
                                <span asp-validation-for="Password.ConfirmNewPassword" class="text-danger small" role="alert"></span>
                            </div>
                            <div class="text-end">
                                <button type="submit" class="btn btn-primary-soft mb-0">@Localizer["Provider.Settings.ChangePassword"]</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
