@using YallaJo.Web.Areas.Provider.Shared
@model YallaJo.Web.Areas.Provider.Models.Listings.ListingsVm
@{
    ViewData["Title"] = "My Listings";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as ProviderSidebarVm ?? new ProviderSidebarVm();

    string Money(decimal amount, string? currency) =>
        string.IsNullOrWhiteSpace(currency) ? amount.ToString("N0") : $"{amount:N0} {currency}";

    string StatusBadge(string status) => status switch
    {
        "Approved" => "badge text-bg-success",
        "Pending" => "badge text-bg-warning",
        "Draft" => "badge text-bg-secondary",
        "Rejected" => "badge text-bg-danger",
        "Suspended" => "badge text-bg-danger",
        "Archived" => "badge text-bg-dark",
        _ => "badge text-bg-secondary"
    };
}

<partial name="_ProviderSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">

        <div class="d-sm-flex justify-content-between align-items-center">
            <h1 class="fs-4 mb-0"><i class="bi bi-journals me-2"></i>My Listings</h1>
                <a asp-area="Provider" asp-controller="Tour" asp-action="Create" class="btn btn-sm btn-primary mb-0">
                <i class="bi bi-plus-lg me-1"></i>Add New Listing
            </a>
        </div>

        @* Status filter tabs *@
        <ul class="nav nav-pills nav-pills-primary-soft flex-wrap gap-2">
            <li class="nav-item">
                <a class="nav-link @(string.IsNullOrEmpty(Model.StatusFilter) ? "active" : "")"
                   asp-action="Index">All</a>
            </li>
            @foreach (var status in YallaJo.Web.Areas.Provider.Models.Listings.ListingsVm.StatusOptions)
            {
                <li class="nav-item">
                    <a class="nav-link @(string.Equals(Model.StatusFilter, status, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                       asp-action="Index" asp-route-status="@status">@status</a>
                </li>
            }
        </ul>

        <div class="card border">
            <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-header-title mb-0">
                    @Model.Total Listing@(Model.Total == 1 ? "" : "s")
                </h5>
            </div>
            <div class="card-body">
                @if (!Model.HasResults)
                {
                    <div class="text-center py-5">
                        <img src="~/assets/images/element/17.svg" class="h-100px mb-3" alt="No listings" />
                        <h5>No listings@(string.IsNullOrEmpty(Model.StatusFilter) ? "" : $" with status \"{Model.StatusFilter}\"")</h5>
                        <p class="mb-3">Create your first tour listing to start receiving bookings.</p>
                        <a asp-controller="Tour" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add New Listing</a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Tour</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Price</th>
                                    <th scope="col">Rating</th>
                                    <th scope="col">Bookings</th>
                                    <th scope="col" class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div>
                                                    <h6 class="mb-0">@item.Name</h6>
                                                    <small class="text-body-secondary">Created @item.CreatedAt.ToString("d MMM yyyy")</small>
                                                    @if (item.IsFeatured)
                                                    {
                                                        <span class="badge text-bg-primary ms-1">Featured</span>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="@StatusBadge(item.Status)">@item.Status</span></td>
                                        <td>
                                            @if (item.HasDiscount)
                                            {
                                                <span class="text-success fw-semibold">@Money(item.EffectivePrice, item.Currency)</span>
                                                <del class="small text-body-secondary d-block">@Money(item.BasePrice, item.Currency)</del>
                                            }
                                            else
                                            {
                                                <span class="fw-semibold">@Money(item.BasePrice, item.Currency)</span>
                                            }
                                        </td>
                                        <td>
                                            <i class="bi bi-star-fill text-warning me-1"></i>@item.AverageRating.ToString("0.0")
                                            <small class="text-body-secondary">(@item.ReviewCount)</small>
                                        </td>
                                        <td>@item.BookingCount</td>
                                        <td class="text-end">
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-light btn-round" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="bi bi-three-dots-vertical"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li>
                                                        <a class="dropdown-item" asp-area="Public" asp-controller="Tours" asp-action="Detail" asp-route-slug="@item.Slug" target="_blank">
                                                            <i class="bi bi-eye fa-fw me-2"></i>View
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item" asp-area="Provider" asp-controller="Tour" asp-action="Manage" asp-route-id="@item.Id">
                                                            <i class="bi bi-pencil-square fa-fw me-2"></i>Manage
                                                        </a>
                                                    </li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li>
                                                        <form asp-area="Provider" asp-controller="Listings" asp-action="Delete"
                                                              asp-route-id="@item.Id" asp-route-status="@Model.StatusFilter" asp-route-page="@Model.Page"
                                                              method="post" onsubmit="return confirm('Delete this listing? This cannot be undone.');">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="dropdown-item text-danger">
                                                                <i class="bi bi-trash fa-fw me-2"></i>Delete
                                                            </button>
                                                        </form>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <p class="mb-0 small text-body-secondary">Page @Model.Page of @Model.TotalPages</p>
                    <ul class="pagination pagination-sm pagination-primary-soft mb-0">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-status="@Model.StatusFilter" asp-route-page="@(Model.Page - 1)">Prev</a>
                        </li>
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index" asp-route-status="@Model.StatusFilter" asp-route-page="@(Model.Page + 1)">Next</a>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </div>
</section>
