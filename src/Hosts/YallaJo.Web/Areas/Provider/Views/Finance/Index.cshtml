@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Provider.Shared
@using YallaJo.Web.Areas.Provider.Models.PaymentMethods
@model YallaJo.Web.Areas.Provider.Models.Finance.ProviderFinanceVm
@{
    ViewData["Title"] = "Finance";
    ViewData["ProviderNav"] = "Finance";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as ProviderSidebarVm ?? new ProviderSidebarVm();

    string Money(decimal a, string? c) => string.IsNullOrWhiteSpace(c) ? a.ToString("N3") : $"{a:N3} {c}";
    string PayoutBadge(string? s) => (s ?? "").ToLowerInvariant() switch
    {
        "completed" or "paid" => "text-bg-success",
        "pending" or "processing" or "scheduled" => "text-bg-warning",
        "failed" or "rejected" => "text-bg-danger",
        _ => "text-bg-secondary",
    };
    string InvoiceBadge(string? s) => (s ?? "").ToLowerInvariant() switch
    {
        "paid" or "issued" or "settled" => "text-bg-success",
        "pending" or "draft" => "text-bg-warning",
        "void" or "cancelled" or "refunded" => "text-bg-danger",
        _ => "text-bg-secondary",
    };
    string TypeLabel(ProviderPaymentMethodType t) => t switch
    {
        ProviderPaymentMethodType.BankAccount => "Bank account",
        ProviderPaymentMethodType.JoMoPay => "JoMoPay",
        ProviderPaymentMethodType.OrangeMoney => "Orange Money",
        ProviderPaymentMethodType.ZainCash => "ZainCash",
        _ => t.ToString(),
    };
}

<partial name="_ProviderSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">
        <h1 class="fs-4 mb-0"><i class="bi bi-cash-coin me-2"></i>Finance</h1>

        @* KPI summary (always visible, from the earnings read) *@
        <div class="row g-3">
            <div class="col-sm-4">
                <div class="card card-body border">
                    <div class="d-flex align-items-center">
                        <div class="icon-xl bg-success bg-opacity-10 rounded-3 text-success"><i class="bi bi-cash-stack fs-5" aria-hidden="true"></i></div>
                        <div class="ms-3">
                            <h2 class="h4 mb-0"><span dir="ltr">@Money(Model.Earnings.GrossTotal, Model.Earnings.Currency)</span></h2>
                            <span class="small text-body-secondary">Gross total</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card card-body border">
                    <div class="d-flex align-items-center">
                        <div class="icon-xl bg-info bg-opacity-10 rounded-3 text-info"><i class="bi bi-wallet2 fs-5" aria-hidden="true"></i></div>
                        <div class="ms-3">
                            <h2 class="h4 mb-0"><span dir="ltr">@Money(Model.Earnings.NetEstimateTotal, Model.Earnings.Currency)</span></h2>
                            <span class="small text-body-secondary">Net estimate</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card card-body border">
                    <div class="d-flex align-items-center">
                        <div class="icon-xl bg-warning bg-opacity-10 rounded-3 text-warning"><i class="bi bi-receipt fs-5" aria-hidden="true"></i></div>
                        <div class="ms-3">
                            <h2 class="h4 mb-0">@Model.Earnings.PaymentCount</h2>
                            <span class="small text-body-secondary">Paid bookings</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border">
            <div class="card-header border-bottom p-0">
                <ul class="nav nav-tabs nav-tabs-bottom-line px-3 pt-2" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="tab-payouts" data-bs-toggle="tab" data-bs-target="#pane-payouts" type="button" role="tab" aria-controls="pane-payouts" aria-selected="true">
                            <i class="bi bi-bank me-1" aria-hidden="true"></i>Payouts
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-invoices" data-bs-toggle="tab" data-bs-target="#pane-invoices" type="button" role="tab" aria-controls="pane-invoices" aria-selected="false">
                            <i class="bi bi-receipt me-1" aria-hidden="true"></i>Invoices
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-methods" data-bs-toggle="tab" data-bs-target="#pane-methods" type="button" role="tab" aria-controls="pane-methods" aria-selected="false">
                            <i class="bi bi-credit-card-2-back me-1" aria-hidden="true"></i>Methods
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content">
                    @* ── Payouts ─────────────────────────────────────────────── *@
                    <div class="tab-pane fade show active" id="pane-payouts" role="tabpanel" aria-labelledby="tab-payouts">
                        @if (!Model.Earnings.HasPayouts)
                        {
                            <div class="text-center text-body-secondary py-4">
                                <i class="bi bi-bank fs-1 d-block mb-2" aria-hidden="true"></i>
                                No payouts have been issued yet.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <caption class="visually-hidden">Payouts</caption>
                                    <thead class="table-light">
                                        <tr>
                                            <th scope="col">Period</th>
                                            <th scope="col" class="text-end">Gross</th>
                                            <th scope="col" class="text-end">Commission</th>
                                            <th scope="col" class="text-end">Net</th>
                                            <th scope="col" class="text-center">Items</th>
                                            <th scope="col">Status</th>
                                            <th scope="col">Created</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in Model.Earnings.Payouts)
                                        {
                                            <tr>
                                                <td><span dir="ltr">@p.BatchPeriodStart.ToString("d MMM") – @p.BatchPeriodEnd.ToString("d MMM yyyy")</span></td>
                                                <td class="text-end"><span dir="ltr">@Money(p.GrossAmount, p.Currency)</span></td>
                                                <td class="text-end text-danger"><span dir="ltr">@Money(p.CommissionAmount, p.Currency)</span></td>
                                                <td class="text-end text-success"><span dir="ltr">@Money(p.NetAmount, p.Currency)</span></td>
                                                <td class="text-center">@p.ItemCount</td>
                                                <td><span class="badge @PayoutBadge(p.Status)">@(p.Status ?? "—")</span></td>
                                                <td class="small text-body-secondary">@p.CreatedAt.ToString("d MMM yyyy")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (Model.Earnings.HasDisputes)
                        {
                            <h2 class="h6 mt-4 mb-2">Disputes</h2>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead class="table-light">
                                        <tr><th scope="col">Reason</th><th scope="col">Status</th><th scope="col">Created</th><th scope="col">Resolved</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var d in Model.Earnings.Disputes)
                                        {
                                            <tr>
                                                <td><bdi>@d.Reason</bdi></td>
                                                <td><span class="badge @PayoutBadge(d.Status)">@(d.Status ?? "—")</span></td>
                                                <td class="small">@d.CreatedAt.ToString("d MMM yyyy")</td>
                                                <td class="small">@(d.ResolvedAt?.ToString("d MMM yyyy") ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    @* ── Invoices ────────────────────────────────────────────── *@
                    <div class="tab-pane fade" id="pane-invoices" role="tabpanel" aria-labelledby="tab-invoices">
                        @if (!Model.Invoices.HasInvoices)
                        {
                            <div class="text-center text-body-secondary py-4">
                                <i class="bi bi-receipt fs-1 d-block mb-2" aria-hidden="true"></i>
                                No invoices yet. They appear here after your bookings are paid.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <caption class="visually-hidden">Invoices</caption>
                                    <thead class="table-light">
                                        <tr>
                                            <th scope="col">Invoice #</th>
                                            <th scope="col">Customer</th>
                                            <th scope="col">Issued</th>
                                            <th scope="col">Status</th>
                                            <th scope="col" class="text-end">Total</th>
                                            <th scope="col" class="text-end"><span class="visually-hidden">Download</span></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var inv in Model.Invoices.Invoices)
                                        {
                                            <tr>
                                                <td><code>@inv.InvoiceNumber</code><div class="small text-body-secondary">@inv.ItemCount item@(inv.ItemCount == 1 ? "" : "s")</div></td>
                                                <td><bdi>@inv.BuyerName</bdi></td>
                                                <td class="small">@inv.IssuedAt.ToString("d MMM yyyy")</td>
                                                <td><span class="badge @InvoiceBadge(inv.Status)">@inv.Status</span></td>
                                                <td class="text-end"><span dir="ltr">@inv.AmountTotal.ToString("0.##") @inv.Currency</span></td>
                                                <td class="text-end">
                                                    @if (inv.PdfAvailable)
                                                    {
                                                        <permission require="@WebPermission.Invoice.Download">
                                                            <a class="btn btn-sm btn-primary-soft" asp-area="Provider" asp-controller="Invoices"
                                                               asp-action="Download" asp-route-id="@inv.Id"><i class="bi bi-download me-1" aria-hidden="true"></i>PDF</a>
                                                        </permission>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-body-secondary small">—</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    @* ── Methods ─────────────────────────────────────────────── *@
                    <div class="tab-pane fade" id="pane-methods" role="tabpanel" aria-labelledby="tab-methods">
                        <permission require="@WebPermission.ProviderPaymentMethod.Create">
                            <form asp-area="Provider" asp-controller="PaymentMethods" asp-action="Create" method="post" class="row g-2 align-items-end mb-3">
                                @Html.AntiForgeryToken()
                                <div class="col-md-3">
                                    <label asp-for="Methods.Form.PaymentMethodType" class="form-label small mb-1"></label>
                                    <select asp-for="Methods.Form.PaymentMethodType" name="PaymentMethodType"
                                            asp-items="Html.GetEnumSelectList<ProviderPaymentMethodType>()" class="form-select form-select-sm"></select>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="Methods.Form.DisplayName" class="form-label small mb-1"></label>
                                    <input asp-for="Methods.Form.DisplayName" name="DisplayName" class="form-control form-control-sm" placeholder="e.g. Main bank account" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="Methods.Form.AccountIdentifier" class="form-label small mb-1"></label>
                                    <input asp-for="Methods.Form.AccountIdentifier" name="AccountIdentifier" class="form-control form-control-sm" dir="ltr" />
                                </div>
                                <div class="col-md-2">
                                    <label asp-for="Methods.Form.BankName" class="form-label small mb-1"></label>
                                    <input asp-for="Methods.Form.BankName" name="BankName" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-1 d-grid">
                                    <button type="submit" class="btn btn-sm btn-primary" aria-label="Add payment method"><i class="bi bi-plus-lg" aria-hidden="true"></i></button>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        <input asp-for="Methods.Form.IsDefault" name="IsDefault" value="true" class="form-check-input" />
                                        <label asp-for="Methods.Form.IsDefault" class="form-check-label small"></label>
                                    </div>
                                </div>
                            </form>
                        </permission>

                        @if (!Model.Methods.HasMethods)
                        {
                            <div class="text-center text-body-secondary py-4">
                                <i class="bi bi-credit-card-2-back fs-1 d-block mb-2" aria-hidden="true"></i>
                                No payout methods yet. Add one above to receive payouts.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <caption class="visually-hidden">Payout methods</caption>
                                    <thead class="table-light">
                                        <tr>
                                            <th scope="col">Name</th>
                                            <th scope="col">Type</th>
                                            <th scope="col">Account</th>
                                            <th scope="col">Status</th>
                                            <th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var m in Model.Methods.Methods)
                                        {
                                            <tr>
                                                <td class="fw-semibold"><bdi>@m.DisplayName</bdi>
                                                    @if (m.IsDefault) { <span class="badge text-bg-primary ms-1">Default</span> }
                                                    @if (!string.IsNullOrWhiteSpace(m.BankName)) { <div class="small text-body-secondary"><bdi>@m.BankName</bdi></div> }
                                                </td>
                                                <td>@TypeLabel(m.PaymentMethodType)</td>
                                                <td><span class="font-monospace small" dir="ltr">@m.AccountIdentifier</span></td>
                                                <td>
                                                    @if (m.IsVerified)
                                                    {
                                                        <span class="badge text-bg-success"><i class="bi bi-check-circle me-1" aria-hidden="true"></i>Verified</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge text-bg-secondary"><i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>Unverified</span>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <permission require="@WebPermission.ProviderPaymentMethod.Update">
                                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse"
                                                                data-bs-target="#fin-edit-@m.Id" aria-expanded="false" aria-controls="fin-edit-@m.Id"
                                                                aria-label="Edit @m.DisplayName"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                                    </permission>
                                                    <permission require="@WebPermission.ProviderPaymentMethod.Delete">
                                                        <form asp-area="Provider" asp-controller="PaymentMethods" asp-action="Delete" asp-route-id="@m.Id"
                                                              method="post" class="d-inline" onsubmit="return confirm('Delete this payment method?');">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-danger-soft" aria-label="Delete @m.DisplayName"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                                        </form>
                                                    </permission>
                                                </td>
                                            </tr>
                                            <permission require="@WebPermission.ProviderPaymentMethod.Update">
                                                <tr class="collapse" id="fin-edit-@m.Id">
                                                    <td colspan="5">
                                                        <form asp-area="Provider" asp-controller="PaymentMethods" asp-action="Edit" asp-route-id="@m.Id"
                                                              method="post" class="row g-2 align-items-end">
                                                            @Html.AntiForgeryToken()
                                                            <div class="col-md-3">
                                                                <label class="form-label small mb-1" for="fin-t-@m.Id">Type</label>
                                                                <select id="fin-t-@m.Id" name="PaymentMethodType" class="form-select form-select-sm">
                                                                    @foreach (ProviderPaymentMethodType t in Enum.GetValues<ProviderPaymentMethodType>())
                                                                    {
                                                                        <option value="@((int)t)" selected="@(m.PaymentMethodType == t)">@TypeLabel(t)</option>
                                                                    }
                                                                </select>
                                                            </div>
                                                            <div class="col-md-3">
                                                                <label class="form-label small mb-1" for="fin-n-@m.Id">Display name</label>
                                                                <input id="fin-n-@m.Id" name="DisplayName" value="@m.DisplayName" class="form-control form-control-sm" maxlength="100" required />
                                                            </div>
                                                            <div class="col-md-3">
                                                                <label class="form-label small mb-1" for="fin-a-@m.Id">Account</label>
                                                                <input id="fin-a-@m.Id" name="AccountIdentifier" value="@m.AccountIdentifier" class="form-control form-control-sm" dir="ltr" maxlength="100" required />
                                                            </div>
                                                            <div class="col-md-2">
                                                                <label class="form-label small mb-1" for="fin-b-@m.Id">Bank</label>
                                                                <input id="fin-b-@m.Id" name="BankName" value="@m.BankName" class="form-control form-control-sm" maxlength="100" />
                                                            </div>
                                                            <div class="col-md-1">
                                                                <div class="form-check">
                                                                    <input type="checkbox" name="IsDefault" value="true" class="form-check-input" id="fin-d-@m.Id" @(m.IsDefault ? "checked" : "") />
                                                                    <label class="form-check-label small" for="fin-d-@m.Id">Default</label>
                                                                </div>
                                                            </div>
                                                            <div class="col-12"><button type="submit" class="btn btn-sm btn-primary">Save changes</button></div>
                                                        </form>
                                                    </td>
                                                </tr>
                                            </permission>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
