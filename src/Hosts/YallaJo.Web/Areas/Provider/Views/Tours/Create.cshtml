@using YallaJo.Web.Areas.Provider.Models.Tours
@model ProviderTourFormVm
@{
    ViewData["Title"] = "Create listing";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Create listing</h2>
        <a asp-area="Provider" asp-controller="Tours" asp-action="Index" class="btn btn-sm btn-outline-secondary">← Back to listings</a>
    </div>

    <p class="text-muted">New listings are created as a <strong>Draft</strong>. You can edit and submit them for review afterwards.</p>

    <form asp-area="Provider" asp-controller="Tours" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <partial name="_Form" model="Model" />

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Create draft</button>
            <a asp-area="Provider" asp-controller="Tours" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
