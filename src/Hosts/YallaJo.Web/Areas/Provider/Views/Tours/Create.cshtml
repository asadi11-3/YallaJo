@using YallaJo.Web.Areas.Provider.Models.Tours
@using YallaJo.Web.Areas.Provider.Shared
@model ProviderTourFormVm
@{
    ViewData["Title"] = "Create listing";
    ViewData["ProviderNav"] = "Listings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_ProviderSidebar" model="@(new ProviderSidebarVm { DisplayName = User.Identity?.Name ?? "Provider" })" />

<section class="pt-0">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-9">
                <h1 class="fs-4 mb-1"><i class="bi bi-journals me-2"></i>Create listing</h1>
                <p class="small text-body-secondary">New listings start as a <strong>Draft</strong> — edit and submit them for review afterwards.</p>

                <div class="card border">
                    <div class="card-body">
                        <form asp-area="Provider" asp-controller="Tours" asp-action="Create" method="post">
                            @Html.AntiForgeryToken()
                            <partial name="_Form" model="Model" />
                            <div class="mt-4 d-flex gap-2">
                                <button type="submit" class="btn btn-primary">Create draft</button>
                                <a asp-area="Provider" asp-controller="Tours" asp-action="Index" class="btn btn-link">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
