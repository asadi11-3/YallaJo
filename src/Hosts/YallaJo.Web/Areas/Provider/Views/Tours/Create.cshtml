@using YallaJo.Web.Areas.Provider.Models.Tours
@model ProviderTourFormVm
@{
    ViewData["Title"] = Localizer["Provider.Tours.CreateTitle"].Value;
    ViewData["ProviderNav"] = "Listings";
}

@await Component.InvokeAsync("ProviderSidebar")

<section class="pt-0">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-9 vstack gap-3">
                <div>
                    <a asp-area="Provider" asp-controller="Tours" asp-action="Index" class="btn btn-sm btn-link px-0">
                        <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>@Localizer["Provider.Tours.BackToList"]
                    </a>
                    <h1 class="fs-4 mb-1"><i class="fa-solid fa-map me-2" aria-hidden="true"></i>@Localizer["Provider.Tours.CreateHeading"]</h1>
                    <p class="small text-body-secondary mb-0">@Localizer["Provider.Tours.CreateIntro"]</p>
                </div>

                <div class="card border shadow-sm">
                    <div class="card-body">
                        <form asp-area="Provider" asp-controller="Tours" asp-action="Create" method="post">
                            @Html.AntiForgeryToken()
                            <partial name="_Form" model="Model" />
                            <div class="mt-4 d-flex flex-wrap gap-2">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>@Localizer["Provider.Tours.CreateSubmit"]
                                </button>
                                <a asp-area="Provider" asp-controller="Tours" asp-action="Index" class="btn btn-outline-secondary">@Localizer["Provider.Tours.Cancel"]</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
