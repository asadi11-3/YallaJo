@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Provider.Models.Tours
@model ProviderTourFormVm
@{
    ViewData["Title"] = "Edit listing";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">Edit listing</h2>
            @if (!string.IsNullOrWhiteSpace(Model.StatusLabel))
            {
                <span class="text-muted">Status: <strong>@Model.StatusLabel</strong></span>
            }
        </div>
        <a asp-area="Provider" asp-controller="Tours" asp-action="Index" class="btn btn-sm btn-outline-secondary">← Back to listings</a>
    </div>

    <form asp-area="Provider" asp-controller="Tours" asp-action="Edit" asp-route-id="@Model.TourId" method="post">
        @Html.AntiForgeryToken()
        <partial name="_Form" model="Model" />

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-area="Provider" asp-controller="Tours" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>

    @if (Model.CanSubmit || Model.CanArchive)
    {
        <hr class="my-4" />
        <div class="d-flex gap-2">
            @if (Model.CanSubmit)
            {
                <permission require="@WebPermission.Tour.Submit">
                    <form asp-area="Provider" asp-controller="Tours" asp-action="Submit" asp-route-id="@Model.TourId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-primary">Submit for review</button>
                    </form>
                </permission>
            }
            @if (Model.CanArchive)
            {
                <permission require="@WebPermission.Tour.Archive">
                    <form asp-area="Provider" asp-controller="Tours" asp-action="Archive" asp-route-id="@Model.TourId" method="post" class="d-inline"
                          onsubmit="return confirm('Archive this listing?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger">Archive</button>
                    </form>
                </permission>
            }
        </div>
        <p class="text-muted small mt-2 mb-0">
            Submitting requires the listing to be complete (description ≥ 100 characters, meeting point, at least
            one image, pricing tier, and schedule). Image, pricing, and schedule management are coming in a later update.
        </p>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
