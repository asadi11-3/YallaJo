@using YallaJo.Web.Infrastructure.Maps
@model YallaJo.Web.Areas.Provider.Models.Tours.ProviderTourFormVm
@{
    string DiffLabel(string d) => Localizer["Provider.TourForm.Difficulty." + d];
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

@if (Model.IsEdit)
{
    <input type="hidden" asp-for="RowVersion" />
}

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Name" class="form-label">@Localizer["Provider.TourForm.Name"]</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small" role="alert"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Slug" class="form-label">@Localizer["Provider.TourForm.Slug"]</label>
        <input asp-for="Slug" class="form-control font-data" dir="ltr" placeholder="my-tour-slug" aria-describedby="tour-slug-help" />
        <span asp-validation-for="Slug" class="text-danger small" role="alert"></span>
        <div id="tour-slug-help" class="form-text">@Localizer["Provider.TourForm.SlugHelp"]</div>
    </div>

    <div class="col-md-4">
        <label asp-for="Difficulty" class="form-label">@Localizer["Provider.TourForm.Difficulty"]</label>
        <select asp-for="Difficulty" class="form-select">
            @foreach (var d in Model.DifficultyOptions)
            {
                <option value="@d">@DiffLabel(d)</option>
            }
        </select>
        <span asp-validation-for="Difficulty" class="text-danger small" role="alert"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DurationMinutes" class="form-label">@Localizer["Provider.TourForm.Duration"]</label>
        <input asp-for="DurationMinutes" type="number" min="1" dir="ltr" class="form-control" />
        <span asp-validation-for="DurationMinutes" class="text-danger small" role="alert"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="MaxGroupSize" class="form-label">@Localizer["Provider.TourForm.MaxGroup"]</label>
        <input asp-for="MaxGroupSize" type="number" min="1" dir="ltr" class="form-control" />
        <span asp-validation-for="MaxGroupSize" class="text-danger small" role="alert"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="BasePrice" class="form-label">@Localizer["Provider.TourForm.BasePrice"]</label>
        <input asp-for="BasePrice" type="number" step="0.001" min="0" dir="ltr" class="form-control" />
        <span asp-validation-for="BasePrice" class="text-danger small" role="alert"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Currency" class="form-label">@Localizer["Provider.TourForm.Currency"]</label>
        <input asp-for="Currency" class="form-control font-data" dir="ltr" maxlength="3" />
        <span asp-validation-for="Currency" class="text-danger small" role="alert"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="CancellationPolicyHours" class="form-label">@Localizer["Provider.TourForm.CancellationHours"]</label>
        <input asp-for="CancellationPolicyHours" type="number" min="0" dir="ltr" class="form-control" />
        <span asp-validation-for="CancellationPolicyHours" class="text-danger small" role="alert"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Latitude" class="form-label">@Localizer["Provider.TourForm.Latitude"]</label>
        <input asp-for="Latitude" type="number" step="any" dir="ltr" class="form-control font-data" />
        <span asp-validation-for="Latitude" class="text-danger small" role="alert"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Longitude" class="form-label">@Localizer["Provider.TourForm.Longitude"]</label>
        <input asp-for="Longitude" type="number" step="any" dir="ltr" class="form-control font-data" />
        <span asp-validation-for="Longitude" class="text-danger small" role="alert"></span>
    </div>

    <div class="col-12">
        @* V13 maps: click-to-set tour location picker (renders nothing when Mapbox is disabled). (0,0) = unset. *@
        @{
            var hasPin = Model.Latitude != 0 || Model.Longitude != 0;
        }
        <partial name="_Map" model='new MapVm { Mode = "picker", Latitude = hasPin ? Model.Latitude : (decimal?)null, Longitude = hasPin ? Model.Longitude : (decimal?)null, InputLatSelector = "#Latitude", InputLngSelector = "#Longitude", CssClass = "yj-map-short" }' />
    </div>

    <div class="col-md-6">
        <label asp-for="MeetingPointLatitude" class="form-label">@Localizer["Provider.TourForm.MeetingLat"]</label>
        <input asp-for="MeetingPointLatitude" type="number" step="any" dir="ltr" class="form-control font-data" />
        <span asp-validation-for="MeetingPointLatitude" class="text-danger small" role="alert"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="MeetingPointLongitude" class="form-label">@Localizer["Provider.TourForm.MeetingLng"]</label>
        <input asp-for="MeetingPointLongitude" type="number" step="any" dir="ltr" class="form-control font-data" aria-describedby="tour-meeting-help" />
        <span asp-validation-for="MeetingPointLongitude" class="text-danger small" role="alert"></span>
        <div id="tour-meeting-help" class="form-text">@Localizer["Provider.TourForm.MeetingHelp"]</div>
    </div>

    <div class="col-12">
        @* V13 maps: meeting-point picker writing into the nullable MeetingPoint inputs. *@
        @{
            var hasMeetingPin = Model.MeetingPointLatitude.HasValue && Model.MeetingPointLongitude.HasValue;
        }
        <partial name="_Map" model='new MapVm { Mode = "picker", Latitude = hasMeetingPin ? Model.MeetingPointLatitude : null, Longitude = hasMeetingPin ? Model.MeetingPointLongitude : null, InputLatSelector = "#MeetingPointLatitude", InputLngSelector = "#MeetingPointLongitude", CssClass = "yj-map-short" }' />
    </div>

    <div class="col-md-12">
        <label asp-for="PlaceId" class="form-label">@Localizer["Provider.TourForm.Place"]</label>
        @* [Backend] B2 + F10: provider-tour-form.js upgrades this to an async Choices.js combobox
           backed by data-yj-lookup-url; the SSR select itself is the no-JS path (PE1). *@
        <select asp-for="PlaceId" class="form-select" aria-describedby="tour-place-help"
                data-yj-place-combobox
                data-yj-lookup-url="@Url.Action("PlacesLookup", "Tours", new { area = "Provider" })"
                data-yj-search-placeholder="@Localizer["Provider.TourForm.PlaceSearchPlaceholder"]"
                data-yj-no-results="@Localizer["Provider.TourForm.NoPlaces"]">
            <option value="">@Localizer["Provider.TourForm.PlaceSelect"]</option>
            @foreach (var place in Model.PlaceOptions)
            {
                if (Model.PlaceId == place.Id)
                {
                    <option value="@place.Id" selected>@place.DisplayLabel</option>
                }
                else
                {
                    <option value="@place.Id">@place.DisplayLabel</option>
                }
            }
        </select>
        <span asp-validation-for="PlaceId" class="text-danger small" role="alert"></span>
        @if (!string.IsNullOrWhiteSpace(Model.PlaceOptionsLoadError))
        {
            <div id="tour-place-help" class="form-text text-danger">@Model.PlaceOptionsLoadError</div>
        }
        else if (Model.PlaceOptions.Count == 0)
        {
            <div id="tour-place-help" class="form-text">@Localizer["Provider.TourForm.NoPlaces"]</div>
        }
    </div>

    <div class="col-md-12">
        <label asp-for="ShortDescription" class="form-label">@Localizer["Provider.TourForm.ShortDescription"]</label>
        <input asp-for="ShortDescription" class="form-control" />
        <span asp-validation-for="ShortDescription" class="text-danger small" role="alert"></span>
    </div>

    <div class="col-md-12">
        <label asp-for="Description" class="form-label">@Localizer["Provider.TourForm.Description"]</label>
        <textarea asp-for="Description" class="form-control" rows="4" aria-describedby="tour-desc-help"></textarea>
        <span asp-validation-for="Description" class="text-danger small" role="alert"></span>
        <div id="tour-desc-help" class="form-text">@Localizer["Provider.TourForm.DescriptionHelp"]</div>
    </div>

    <div class="col-md-6">
        <div class="form-check">
            <input asp-for="IsChildFriendly" class="form-check-input" />
            <label asp-for="IsChildFriendly" class="form-check-label">@Localizer["Provider.TourForm.ChildFriendly"]</label>
        </div>
        <div class="form-check">
            <input asp-for="IsAccessible" class="form-check-input" />
            <label asp-for="IsAccessible" class="form-check-label">@Localizer["Provider.TourForm.Accessible"]</label>
        </div>
    </div>
</div>
