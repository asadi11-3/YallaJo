@model YallaJo.Web.Areas.Provider.Models.Tours.ProviderTourFormVm

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

@if (Model.IsEdit)
{
    <input type="hidden" asp-for="RowVersion" />
}

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Slug" class="form-label"></label>
        <input asp-for="Slug" class="form-control" placeholder="my-tour-slug" />
        <span asp-validation-for="Slug" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Difficulty" class="form-label"></label>
        <select asp-for="Difficulty" class="form-select">
            @foreach (var d in Model.DifficultyOptions)
            {
                <option value="@d">@d</option>
            }
        </select>
        <span asp-validation-for="Difficulty" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DurationMinutes" class="form-label"></label>
        <input asp-for="DurationMinutes" type="number" min="1" class="form-control" />
        <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="MaxGroupSize" class="form-label"></label>
        <input asp-for="MaxGroupSize" type="number" min="1" class="form-control" />
        <span asp-validation-for="MaxGroupSize" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="BasePrice" class="form-label"></label>
        <input asp-for="BasePrice" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="BasePrice" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Currency" class="form-label"></label>
        <input asp-for="Currency" class="form-control" maxlength="3" />
        <span asp-validation-for="Currency" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="CancellationPolicyHours" class="form-label"></label>
        <input asp-for="CancellationPolicyHours" type="number" min="0" class="form-control" />
        <span asp-validation-for="CancellationPolicyHours" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Latitude" class="form-label"></label>
        <input asp-for="Latitude" type="number" step="any" class="form-control" />
        <span asp-validation-for="Latitude" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Longitude" class="form-label"></label>
        <input asp-for="Longitude" type="number" step="any" class="form-control" />
        <span asp-validation-for="Longitude" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="MeetingPointLatitude" class="form-label"></label>
        <input asp-for="MeetingPointLatitude" type="number" step="any" class="form-control" />
        <span asp-validation-for="MeetingPointLatitude" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="MeetingPointLongitude" class="form-label"></label>
        <input asp-for="MeetingPointLongitude" type="number" step="any" class="form-control" />
        <span asp-validation-for="MeetingPointLongitude" class="text-danger small"></span>
        <div class="form-text">Set both meeting-point coordinates together. Required before a listing can be submitted.</div>
    </div>

    <div class="col-md-12">
        <label asp-for="PlaceId" class="form-label"></label>
        <input asp-for="PlaceId" class="form-control" placeholder="00000000-0000-0000-0000-000000000000" />
        <span asp-validation-for="PlaceId" class="text-danger small"></span>
    </div>

    <div class="col-md-12">
        <label asp-for="ShortDescription" class="form-label"></label>
        <input asp-for="ShortDescription" class="form-control" />
        <span asp-validation-for="ShortDescription" class="text-danger small"></span>
    </div>

    <div class="col-md-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
        <div class="form-text">A description of at least 100 characters is required before a listing can be submitted.</div>
    </div>

    <div class="col-md-6">
        <div class="form-check">
            <input asp-for="IsChildFriendly" class="form-check-input" />
            <label asp-for="IsChildFriendly" class="form-check-label"></label>
        </div>
        <div class="form-check">
            <input asp-for="IsAccessible" class="form-check-input" />
            <label asp-for="IsAccessible" class="form-check-label"></label>
        </div>
    </div>
</div>
