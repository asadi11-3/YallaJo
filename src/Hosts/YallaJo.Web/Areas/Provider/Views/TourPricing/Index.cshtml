@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Provider.Models.TourPricing
@using YallaJo.Web.Areas.Provider.Shared
@model TourPricingIndexVm
@{
    ViewData["Title"] = $"Pricing — {Model.TourName}";
    ViewData["ProviderNav"] = "Listings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_ProviderSidebar" model="@(new ProviderSidebarVm { DisplayName = User.Identity?.Name ?? "Provider" })" />

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-sm-flex justify-content-between align-items-center">
            <div>
                <h1 class="fs-4 mb-0"><i class="bi bi-tag me-2"></i>Pricing tiers</h1>
                <span class="small text-body-secondary"><bdi>@Model.TourName</bdi>@(string.IsNullOrWhiteSpace(Model.TourStatusLabel) ? "" : $" · {Model.TourStatusLabel}")</span>
            </div>
            <div class="mt-2 mt-sm-0 d-flex gap-2">
                <a asp-area="Provider" asp-controller="Tours" asp-action="Edit" asp-route-id="@Model.TourId"
                   class="btn btn-sm btn-secondary-soft"><i class="bi bi-arrow-left me-1"></i>Back to listing</a>
                <permission require="@WebPermission.TourPricingTier.Create">
                    <a asp-area="Provider" asp-controller="TourPricing" asp-action="Create" asp-route-id="@Model.TourId"
                       class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i>Add tier</a>
                </permission>
            </div>
        </div>

        <partial name="_TourWizardSteps" model="@(new YallaJo.Web.Areas.Provider.Models.Tours.TourWizardStepsVm { TourId = Model.TourId, CurrentStep = 2 })" />

        @if (!Model.HasActiveAdultTier)
        {
            <div class="alert alert-info mb-0" role="status">
                <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
                A listing needs at least one <strong>active Adult</strong> pricing tier before it can be submitted for review.
            </div>
        }

        @if (!Model.HasTiers)
        {
            <div class="card border">
                <div class="card-body text-center py-5">
                    <i class="bi bi-tag fs-1 text-body-secondary d-block mb-2" aria-hidden="true"></i>
                    <h2 class="h6 mb-1">No pricing tiers yet</h2>
                    <p class="text-body-secondary mb-3">Add an Adult tier to set the base price travelers pay.</p>
                    <permission require="@WebPermission.TourPricingTier.Create">
                        <a asp-area="Provider" asp-controller="TourPricing" asp-action="Create" asp-route-id="@Model.TourId"
                           class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add a pricing tier</a>
                    </permission>
                </div>
            </div>
        }
        else
        {
            <div class="card border">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <caption class="visually-hidden">Pricing tiers</caption>
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Name</th>
                                <th scope="col">Type</th>
                                <th scope="col" class="text-end">Price</th>
                                <th scope="col">Participants</th>
                                <th scope="col">Status</th>
                                <th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tier in Model.Tiers)
                            {
                                <tr>
                                    <td class="fw-semibold"><bdi>@tier.Name</bdi></td>
                                    <td>
                                        @tier.ParticipantTypeLabel
                                        @if (tier.IsAdult) { <span class="badge text-bg-light ms-1">Adult</span> }
                                    </td>
                                    <td class="text-end"><span dir="ltr">@tier.Price.ToString("0.##") @tier.Currency</span></td>
                                    <td>@tier.ParticipantsLabel</td>
                                    <td>
                                        @if (tier.IsActive)
                                        {
                                            <span class="badge text-bg-success"><i class="bi bi-check-circle me-1" aria-hidden="true"></i>Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary"><i class="bi bi-slash-circle me-1" aria-hidden="true"></i>Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex justify-content-end gap-1">
                                            <permission require="@WebPermission.TourPricingTier.Update">
                                                <a asp-area="Provider" asp-controller="TourPricing" asp-action="Edit"
                                                   asp-route-id="@Model.TourId" asp-route-tierId="@tier.Id"
                                                   class="btn btn-sm btn-outline-secondary" aria-label="Edit @tier.Name"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                            </permission>
                                            <permission require="@WebPermission.TourPricingTier.Delete">
                                                <form asp-area="Provider" asp-controller="TourPricing" asp-action="Delete"
                                                      asp-route-id="@Model.TourId" asp-route-tierId="@tier.Id"
                                                      method="post" class="d-inline"
                                                      onsubmit="return confirm('Delete the &quot;@tier.Name&quot; pricing tier?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-danger-soft" aria-label="Delete @tier.Name"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                                </form>
                                            </permission>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</section>
