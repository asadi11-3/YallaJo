@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Provider.Models.TourPricing
@model TourPricingFormVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer

<input type="hidden" asp-for="TourId" />
<input type="hidden" asp-for="TierId" />
<input type="hidden" asp-for="IsEdit" />

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="row g-3">
    <div class="col-md-7">
        <label asp-for="Name" class="form-label">@Localizer["Provider.TourPricing.Form.Name"]</label>
        <input asp-for="Name" class="form-control" autocomplete="off" placeholder="@Localizer["Provider.TourPricing.Form.NamePlaceholder"]" />
        <span asp-validation-for="Name" class="text-danger small" role="alert"></span>
    </div>

    <div class="col-md-5">
        <label asp-for="ParticipantType" class="form-label">@Localizer["Provider.TourPricing.Form.ParticipantType"]</label>
        <select asp-for="ParticipantType" class="form-select">
            @foreach (var pt in Model.ParticipantTypeOptions)
            {
                <option value="@pt">@Localizer["Provider.TourPricing.PType." + pt]</option>
            }
        </select>
        <span asp-validation-for="ParticipantType" class="text-danger small" role="alert"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Price" class="form-label">@Localizer["Provider.TourPricing.Form.Price"]</label>
        <input asp-for="Price" type="number" step="0.001" min="0" inputmode="decimal" class="form-control font-data" dir="ltr" />
        <span asp-validation-for="Price" class="text-danger small" role="alert"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Currency" class="form-label">@Localizer["Provider.TourPricing.Form.Currency"]</label>
        <input asp-for="Currency" class="form-control font-data" dir="ltr" maxlength="3" readonly aria-describedby="pricing-currency-help" />
        <div id="pricing-currency-help" class="form-text">@Localizer["Provider.TourPricing.Form.CurrencyHelp"]</div>
    </div>

    <div class="col-md-2">
        <label asp-for="MinParticipants" class="form-label">@Localizer["Provider.TourPricing.Form.MinParticipants"]</label>
        <input asp-for="MinParticipants" type="number" min="1" inputmode="numeric" class="form-control" dir="ltr" />
        <span asp-validation-for="MinParticipants" class="text-danger small" role="alert"></span>
    </div>

    <div class="col-md-2">
        <label asp-for="MaxParticipants" class="form-label">@Localizer["Provider.TourPricing.Form.MaxParticipants"]</label>
        <input asp-for="MaxParticipants" type="number" min="1" inputmode="numeric" class="form-control" dir="ltr" />
        <span asp-validation-for="MaxParticipants" class="text-danger small" role="alert"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label">@Localizer["Provider.TourPricing.Form.Description"]</label>
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Description" class="text-danger small" role="alert"></span>
    </div>

    @if (Model.IsEdit)
    {
        <div class="col-12">
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" aria-describedby="pricing-active-help" />
                <label asp-for="IsActive" class="form-check-label">@Localizer["Provider.TourPricing.Form.IsActive"]</label>
            </div>
            <div id="pricing-active-help" class="form-text">@Localizer["Provider.TourPricing.Form.IsActiveHelp"]</div>
        </div>
    }
</div>
