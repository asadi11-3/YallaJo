@using YallaJo.Web.Areas.Provider.Models.TourPricing
@using YallaJo.Web.Areas.Provider.Shared
@model TourPricingFormVm
@{
    ViewData["Title"] = "Add pricing tier";
    ViewData["ProviderNav"] = "Listings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_ProviderSidebar" model="@(new ProviderSidebarVm { DisplayName = User.Identity?.Name ?? "Provider" })" />

<section class="pt-0">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9 col-xl-8">
                <h1 class="fs-4 mb-1"><i class="bi bi-tag me-2"></i>Add pricing tier</h1>
                <p class="small text-body-secondary">
                    @if (!string.IsNullOrWhiteSpace(Model.TourName)) { <bdi>@Model.TourName</bdi><text> · </text> }
                    New tiers are created <strong>Active</strong>. An <strong>Adult</strong> tier is required to submit the listing.
                </p>

                <div class="card border">
                    <div class="card-body">
                        <form asp-area="Provider" asp-controller="TourPricing" asp-action="Create" asp-route-id="@Model.TourId" method="post">
                            @Html.AntiForgeryToken()
                            <partial name="_Form" model="Model" />
                            <div class="mt-4 d-flex gap-2">
                                <button type="submit" class="btn btn-primary">Create tier</button>
                                <a asp-area="Provider" asp-controller="TourPricing" asp-action="Index" asp-route-id="@Model.TourId"
                                   class="btn btn-link">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
