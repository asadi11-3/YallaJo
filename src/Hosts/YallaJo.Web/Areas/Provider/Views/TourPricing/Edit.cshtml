@using YallaJo.Web.Areas.Provider.Models.TourPricing
@model TourPricingFormVm
@{
    ViewData["Title"] = Localizer["Provider.TourPricing.EditTitle"].Value;
    ViewData["ProviderNav"] = "Listings";
}

@await Component.InvokeAsync("ProviderSidebar")

<section class="pt-0">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9 col-xl-8 vstack gap-4">

                <div>
                    <a asp-area="Provider" asp-controller="TourPricing" asp-action="Index" asp-route-id="@Model.TourId" class="btn btn-sm btn-link text-body-secondary p-0 mb-2">
                        <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>@Localizer["Provider.TourPricing.BackToList"]
                    </a>
                    <h1 class="fs-4 mb-1"><i class="fa-solid fa-tag me-2" aria-hidden="true"></i>@Localizer["Provider.TourPricing.EditHeading"]</h1>
                    @if (!string.IsNullOrWhiteSpace(Model.TourName))
                    {
                        <p class="text-body-secondary mb-0"><bdi dir="ltr">@Model.TourName</bdi></p>
                    }
                </div>

                <div class="card shadow">
                    <div class="card-body">
                        <form asp-area="Provider" asp-controller="TourPricing" asp-action="Edit" asp-route-id="@Model.TourId" asp-route-tierId="@Model.TierId" method="post">
                            @Html.AntiForgeryToken()
                            <partial name="_Form" model="Model" />
                            <div class="d-flex flex-wrap gap-2 mt-4">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>@Localizer["Provider.TourPricing.SaveChanges"]
                                </button>
                                <a asp-area="Provider" asp-controller="TourPricing" asp-action="Index" asp-route-id="@Model.TourId" class="btn btn-secondary">@Localizer["Provider.TourPricing.Cancel"]</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
