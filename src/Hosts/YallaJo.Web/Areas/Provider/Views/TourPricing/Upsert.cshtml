@using YallaJo.Web.Areas.Provider.Models.TourPricing
@model TourPricingFormVm
@{
    ViewData["Title"] = Localizer[Model.IsEdit ? "Provider.TourPricing.EditTitle" : "Provider.TourPricing.CreateTitle"].Value;
    ViewData["ProviderNav"] = "Listings";
}

@await Component.InvokeAsync("ProviderSidebar")

<section class="pt-0">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9 col-xl-8 vstack gap-4">

                <div>
                    <a asp-area="Provider" asp-controller="TourPricing" asp-action="Index" asp-route-id="@Model.TourId" class="btn btn-sm btn-link text-body-secondary p-0 mb-2">
                        <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>@Localizer["Provider.TourPricing.BackToList"]
                    </a>
                    <h1 class="fs-4 mb-1"><i class="fa-solid fa-tag me-2" aria-hidden="true"></i>@Localizer[Model.IsEdit ? "Provider.TourPricing.EditHeading" : "Provider.TourPricing.CreateHeading"]</h1>
                    @if (Model.IsEdit)
                    {
                        if (!string.IsNullOrWhiteSpace(Model.TourName))
                        {
                            <p class="text-body-secondary mb-0"><bdi dir="ltr">@Model.TourName</bdi></p>
                        }
                    }
                    else
                    {
                        <p class="text-body-secondary mb-0">@Localizer["Provider.TourPricing.CreateIntro"]</p>
                    }
                </div>

                <div class="card shadow">
                    <div class="card-body">
                        @if (Model.IsEdit)
                        {
                            <form asp-area="Provider" asp-controller="TourPricing" asp-action="Edit" asp-route-id="@Model.TourId" asp-route-tierId="@Model.TierId" method="post">
                                @Html.AntiForgeryToken()
                                <partial name="_Form" model="Model" />
                                <div class="d-flex flex-wrap gap-2 mt-4">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>@Localizer["Provider.TourPricing.SaveChanges"]
                                    </button>
                                    <a asp-area="Provider" asp-controller="TourPricing" asp-action="Index" asp-route-id="@Model.TourId" class="btn btn-secondary">@Localizer["Provider.TourPricing.Cancel"]</a>
                                </div>
                            </form>
                        }
                        else
                        {
                            <form asp-area="Provider" asp-controller="TourPricing" asp-action="Create" asp-route-id="@Model.TourId" method="post">
                                @Html.AntiForgeryToken()
                                <partial name="_Form" model="Model" />
                                <div class="d-flex flex-wrap gap-2 mt-4">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>@Localizer["Provider.TourPricing.CreateSubmit"]
                                    </button>
                                    <a asp-area="Provider" asp-controller="TourPricing" asp-action="Index" asp-route-id="@Model.TourId" class="btn btn-secondary">@Localizer["Provider.TourPricing.Cancel"]</a>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
