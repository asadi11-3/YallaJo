@using YallaJo.Web.Areas.Provider.Models.TourImages
@model TourImagesVm
@{
    ViewData["Title"] = Localizer["Provider.TourImages.Title"].Value;
    ViewData["ProviderNav"] = "Listings";
}

@await Component.InvokeAsync("ProviderSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-sm-flex justify-content-between align-items-center">
            <h1 class="fs-4 mb-0"><i class="fa-solid fa-images me-2" aria-hidden="true"></i>@Localizer["Provider.TourImages.Heading"]</h1>
            <a asp-area="Provider" asp-controller="Tours" asp-action="Edit" asp-route-id="@Model.TourId"
               class="btn btn-sm btn-secondary-soft mt-2 mt-sm-0">
                <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>@Localizer["Provider.TourImages.BackToListing"]
            </a>
        </div>

        <partial name="_TourWizardSteps" model="@(new YallaJo.Web.Areas.Provider.Models.Tours.TourWizardStepsVm { TourId = Model.TourId, CurrentStep = 4 })" />

        <permission require="@WebPermission.Attachment.Create">
            <section class="card border" aria-labelledby="upload-heading">
                <div class="card-header border-bottom">
                    <h2 id="upload-heading" class="card-header-title h5 mb-0">@Localizer["Provider.TourImages.UploadHeading"]</h2>
                </div>
                <div class="card-body">
                    @* Phase 5: provider-images.js adds client preview + size/type pre-check (server SEC4 stays authoritative). *@
                    <form asp-area="Provider" asp-controller="TourImages" asp-action="Upload"
                          asp-route-id="@Model.TourId" method="post" enctype="multipart/form-data"
                          class="row g-2 align-items-end" data-loading data-yj-image-upload
                          data-yj-ajax data-yj-swap-target="gallery"
                          data-success-message="@Localizer["Provider.Flash.ImageUploaded"]"
                          data-error-text="@Localizer["Provider.Flash.CouldNotUploadImage"]"
                          data-yj-too-large="@Localizer["Provider.TourImages.FileTooLarge"]"
                          data-yj-invalid-type="@Localizer["Provider.TourImages.InvalidType"]"
                          data-yj-preview-alt="@Localizer["Provider.TourImages.PreviewAlt"]">
                        @Html.AntiForgeryToken()
                        <div class="col-md-8">
                            <label for="File" class="form-label">@Localizer["Provider.TourImages.FileLabel"]</label>
                            <input id="File" name="File" type="file" class="form-control"
                                   accept="@TourImageUploadVm.AcceptAttribute" aria-describedby="image-help" />
                        </div>
                        <div class="col-md-4 d-grid">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-upload me-1" aria-hidden="true"></i>@Localizer["Provider.TourImages.Upload"]
                            </button>
                        </div>
                        <div class="col-12 d-none" data-yj-preview-wrap>
                            <img src="" alt="" width="160" height="120" class="object-cover rounded border" data-yj-preview />
                        </div>
                    </form>
                    <div id="image-help" class="form-text mt-2">@Localizer["Provider.TourImages.UploadHelp"]</div>
                </div>
            </section>
        </permission>

        @* Swappable AJAX region (PE1: full PRG without JS — provider-actions.js enhances). *@
        <partial name="_Gallery" model="Model" />
    </div>
</section>


@section Scripts {
    @* Phase 5: image preview + pre-checks (PE1: plain multipart post without JS). *@
    <script src="~/assets/js/provider-images.js" asp-append-version="true"></script>
    @* Progressive enhancement: AJAX upload/delete + gallery fragment swap (PE1: full PRG without JS). *@
    <script src="~/assets/js/provider-actions.js" asp-append-version="true"></script>
}
