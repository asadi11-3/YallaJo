@using YallaJo.Web.Areas.Provider.Models.TourImages
@model TourImagesVm
@*
    AJAX fragment contract (PE1): single-root swappable region for provider-actions.js.
    The upload + delete forms post with data-yj-ajax and the controller's WantsAjax()
    branch returns this partial; the client swaps the [data-yj-swap="gallery"] root.
    Without JS the same forms post normally (PRG) and the full Index re-renders.
*@
<section class="card shadow" aria-labelledby="images-heading" data-yj-swap="gallery">
    <div class="card-header border-bottom">
        <h2 id="images-heading" class="card-header-title h5 mb-0">@Localizer["Provider.TourImages.GalleryHeading"]</h2>
    </div>
    <div class="card-body">
        @if (!Model.HasImages)
        {
            <partial name="_ProviderEmptyState" view-data="@(new ViewDataDictionary(ViewData) { ["message"] = Localizer["Provider.TourImages.EmptyMsg"].Value })" />
        }
        else
        {
            <div class="row g-3">
                @foreach (var img in Model.Images)
                {
                    var imgName = string.IsNullOrEmpty(img.FileName) ? Localizer["Provider.TourImages.UnnamedImage"].Value : img.FileName;
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card border h-100">
                            <div class="ratio ratio-4x3">
                                <img src="@img.Url" width="400" height="300" class="card-img-top object-fit-cover"
                                     alt="@imgName" loading="lazy" />
                            </div>
                            <div class="card-body p-2">
                                <div class="small text-truncate" title="@imgName"><bdi dir="ltr">@imgName</bdi></div>
                                <div class="small text-body-secondary">
                                    <bdi dir="ltr">@Date(img.UploadedAt)</bdi>
                                    @if (!string.IsNullOrEmpty(img.FileSizeLabel))
                                    {
                                        <span> &middot; <bdi dir="ltr">@img.FileSizeLabel</bdi></span>
                                    }
                                </div>
                            </div>
                            <div class="card-footer p-2 d-flex justify-content-between align-items-center">
                                <a href="@img.Url" target="_blank" rel="noopener noreferrer"
                                   class="btn btn-sm btn-outline-secondary">
                                    <i class="fa-solid fa-up-right-from-square me-1" aria-hidden="true"></i>@Localizer["Provider.TourImages.Open"]
                                </a>
                                <permission require="@WebPermission.Attachment.Delete">
                                    <form asp-area="Provider" asp-controller="TourImages" asp-action="Delete"
                                          asp-route-id="@Model.TourId" asp-route-attachmentId="@img.Id" method="post"
                                          data-loading class="d-inline"
                                          data-yj-ajax data-yj-swap-target="gallery"
                                          data-success-message="@Localizer["Provider.Flash.ImageDeleted"]"
                                          data-error-text="@Localizer["Provider.Flash.CouldNotDeleteImage"]"
                                          data-confirm="@Localizer["Provider.TourImages.DeleteBody", imgName]"
                                          data-confirm-title="@Localizer["Provider.TourImages.DeleteTitle"]"
                                          data-confirm-action="@Localizer["Provider.TourImages.DeleteConfirm"]"
                                          data-confirm-cancel="@Localizer["Provider.TourImages.Cancel"]">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fa-solid fa-trash me-1" aria-hidden="true"></i>@Localizer["Provider.TourImages.Delete"]
                                        </button>
                                    </form>
                                </permission>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
