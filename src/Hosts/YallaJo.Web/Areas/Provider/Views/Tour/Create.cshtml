@model YallaJo.Web.Areas.Provider.Models.Tours.CreateTourVm
@using YallaJo.Web.Areas.Provider.Models.Tours
@using YallaJo.Web.Areas.Provider.Shared
@{
    ViewData["Title"] = "Create listing";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as ProviderSidebarVm ?? new ProviderSidebarVm();
}

<partial name="_ProviderSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container">
        <div class="row g-4">
            <div class="col-12">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h1 class="fs-4 mb-0"><i class="bi bi-plus-square me-2"></i>Create a new listing</h1>
                    <a asp-area="Provider" asp-controller="Listings" asp-action="Index" class="btn btn-sm btn-secondary-soft">
                        <i class="bi bi-arrow-left me-1"></i>Back to listings
                    </a>
                </div>

                <form method="post" asp-area="Provider" asp-controller="Tour" asp-action="Create" class="vstack gap-4">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none-empty"></div>

                    <div class="card border">
                        <div class="card-header border-bottom"><h5 class="card-header-title mb-0">Basic information</h5></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label asp-for="Name" class="form-label"></label>
                                    <input asp-for="Name" class="form-control" placeholder="Old City Walking Tour" />
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Slug" class="form-label"></label>
                                    <input asp-for="Slug" class="form-control" placeholder="old-city-walking-tour" />
                                    <span asp-validation-for="Slug" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Difficulty" class="form-label"></label>
                                    <select asp-for="Difficulty" class="form-select">
                                        @foreach (var d in CreateTourVm.DifficultyOptions)
                                        {
                                            <option value="@d">@d</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="DurationMinutes" class="form-label"></label>
                                    <input asp-for="DurationMinutes" type="number" class="form-control" />
                                    <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="MaxGroupSize" class="form-label"></label>
                                    <input asp-for="MaxGroupSize" type="number" class="form-control" />
                                    <span asp-validation-for="MaxGroupSize" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="ShortDescription" class="form-label"></label>
                                    <input asp-for="ShortDescription" class="form-control" />
                                    <span asp-validation-for="ShortDescription" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Description" class="form-label"></label>
                                    <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                                    <span asp-validation-for="Description" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card border">
                        <div class="card-header border-bottom"><h5 class="card-header-title mb-0">Pricing &amp; location</h5></div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label asp-for="BasePrice" class="form-label"></label>
                                    <input asp-for="BasePrice" type="number" step="0.01" class="form-control" />
                                    <span asp-validation-for="BasePrice" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Currency" class="form-label"></label>
                                    <input asp-for="Currency" class="form-control text-uppercase" maxlength="3" />
                                    <span asp-validation-for="Currency" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="MinAge" class="form-label"></label>
                                    <input asp-for="MinAge" type="number" class="form-control" />
                                    <span asp-validation-for="MinAge" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Latitude" class="form-label"></label>
                                    <input asp-for="Latitude" type="number" step="any" class="form-control" />
                                    <span asp-validation-for="Latitude" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Longitude" class="form-label"></label>
                                    <input asp-for="Longitude" type="number" step="any" class="form-control" />
                                    <span asp-validation-for="Longitude" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="CancellationPolicyHours" class="form-label"></label>
                                    <input asp-for="CancellationPolicyHours" type="number" class="form-control" />
                                    <span asp-validation-for="CancellationPolicyHours" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="row g-3 mt-1">
                                <div class="col-md-4 form-check ms-2">
                                    <input asp-for="IsChildFriendly" class="form-check-input" />
                                    <label asp-for="IsChildFriendly" class="form-check-label"></label>
                                </div>
                                <div class="col-md-4 form-check">
                                    <input asp-for="IsAccessible" class="form-check-input" />
                                    <label asp-for="IsAccessible" class="form-check-label"></label>
                                </div>
                                <div class="col-md-4 form-check">
                                    <input asp-for="IsInstantBooking" class="form-check-input" />
                                    <label asp-for="IsInstantBooking" class="form-check-label"></label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Create listing</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
