@using YallaJo.Web.Areas.Provider.Models.TourSchedules
@model TourScheduleFormVm
@{
    ViewData["Title"] = "Add schedule";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Add schedule</h2>
        <a asp-area="Provider" asp-controller="TourSchedules" asp-action="Index" asp-route-id="@Model.TourId"
           class="btn btn-sm btn-outline-secondary">← Back to schedules</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.TourName))
    {
        <p class="text-muted">Listing: <strong>@Model.TourName</strong></p>
    }
    <p class="text-muted">Schedules repeat <strong>weekly</strong> on the selected day. New schedules are <strong>Active</strong>.</p>

    <form asp-area="Provider" asp-controller="TourSchedules" asp-action="Create" asp-route-id="@Model.TourId" method="post">
        @Html.AntiForgeryToken()
        <partial name="_Form" model="Model" />

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Create schedule</button>
            <a asp-area="Provider" asp-controller="TourSchedules" asp-action="Index" asp-route-id="@Model.TourId"
               class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
