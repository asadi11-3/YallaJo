@using YallaJo.Web.Areas.Provider.Models.TourSchedules
@using YallaJo.Web.Areas.Provider.Shared
@model TourScheduleFormVm
@{
    ViewData["Title"] = "Edit schedule";
    ViewData["ProviderNav"] = "Listings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_ProviderSidebar" model="@(new ProviderSidebarVm { DisplayName = User.Identity?.Name ?? "Provider" })" />

<section class="pt-0">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9 col-xl-8">
                <h1 class="fs-4 mb-1"><i class="bi bi-calendar-event me-2"></i>Edit schedule</h1>
                @if (!string.IsNullOrWhiteSpace(Model.TourName))
                {
                    <p class="small text-body-secondary"><bdi>@Model.TourName</bdi></p>
                }

                <div class="card border">
                    <div class="card-body">
                        <form asp-area="Provider" asp-controller="TourSchedules" asp-action="Edit"
                              asp-route-id="@Model.TourId" asp-route-scheduleId="@Model.ScheduleId" method="post">
                            @Html.AntiForgeryToken()
                            <partial name="_Form" model="Model" />
                            <div class="mt-4 d-flex gap-2">
                                <button type="submit" class="btn btn-primary">Save changes</button>
                                <a asp-area="Provider" asp-controller="TourSchedules" asp-action="Index" asp-route-id="@Model.TourId"
                                   class="btn btn-link">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
