@using YallaJo.Web.Areas.Provider.Models.TourSchedules
@model TourScheduleFormVm
@{
    ViewData["Title"] = Localizer["Provider.TourSchedules.EditTitle"].Value;
    ViewData["ProviderNav"] = "Listings";
}

@await Component.InvokeAsync("ProviderSidebar")

<section class="pt-0">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9 col-xl-8 vstack gap-3">
                <a class="btn btn-sm btn-secondary-soft align-self-start" asp-area="Provider" asp-controller="TourSchedules" asp-action="Index" asp-route-id="@Model.TourId">
                    <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>@Localizer["Provider.TourSchedules.BackToList"]
                </a>
                <div>
                    <h1 class="fs-4 mb-1"><i class="fa-solid fa-calendar-days me-2" aria-hidden="true"></i>@Localizer["Provider.TourSchedules.EditHeading"]</h1>
                    @if (!string.IsNullOrWhiteSpace(Model.TourName))
                    {
                        <p class="text-body-secondary mb-0"><bdi dir="ltr">@Model.TourName</bdi></p>
                    }
                </div>

                <section class="card shadow">
                    <div class="card-body">
                        <form asp-area="Provider" asp-controller="TourSchedules" asp-action="Edit" asp-route-id="@Model.TourId" asp-route-scheduleId="@Model.ScheduleId" method="post">
                            @Html.AntiForgeryToken()
                            <partial name="_Form" model="Model" />
                            <div class="d-flex flex-wrap gap-2 mt-4">
                                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>@Localizer["Provider.TourSchedules.SaveChanges"]</button>
                                <a class="btn btn-link" asp-area="Provider" asp-controller="TourSchedules" asp-action="Index" asp-route-id="@Model.TourId">@Localizer["Provider.TourSchedules.Cancel"]</a>
                            </div>
                        </form>
                    </div>
                </section>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
