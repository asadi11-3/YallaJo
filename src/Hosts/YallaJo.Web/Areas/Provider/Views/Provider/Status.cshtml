@using YallaJo.Web.Areas.Provider.Models
@model ProviderStatusVm
@{
    ViewData["Title"] = Localizer["Provider.Onboarding.Title"].Value;

    var culture = CultureInfo.CurrentUICulture;
    string Date(DateTime dt) => dt.ToString("yyyy-MM-dd", culture);

    (string Color, string Icon) AppBadge(string s) => (s ?? "").ToLowerInvariant() switch
    {
        "approved" => ("success", "circle-check"),
        "rejected" => ("danger", "circle-xmark"),
        "suspended" => ("warning", "triangle-exclamation"),
        "moredocsneeded" => ("info", "file-circle-question"),
        "draft" => ("secondary", "pen-ruler"),
        "submitted" or "pending" => ("warning", "clock"),
        _ => ("secondary", "circle-info"),
    };
}

<section class="pt-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 vstack gap-3">
                <h1 class="fs-4 mb-0"><i class="fa-solid fa-clipboard-check me-2" aria-hidden="true"></i>@Localizer["Provider.Onboarding.Heading"]</h1>

                @if (!Model.HasApplication)
                {
                    <div class="card shadow-sm">
                        <div class="card-body text-center">
                            <p class="mb-3">@Localizer["Provider.Onboarding.NotAppliedMsg"]</p>
                            <div class="d-flex flex-wrap gap-2 justify-content-center">
                                <a asp-action="Apply" class="btn btn-primary"><i class="fa-solid fa-building-circle-arrow-right me-1" aria-hidden="true"></i>@Localizer["Provider.Onboarding.BecomeProvider"]</a>
                                <a asp-action="Apply" asp-route-type="IndependentGuide" class="btn btn-primary-soft"><i class="fa-solid fa-id-badge me-1" aria-hidden="true"></i>@Localizer["Provider.Onboarding.BecomeGuide"]</a>
                            </div>
                            <p class="form-text mt-2 mb-0">@Localizer["Provider.Onboarding.GuideNote"]</p>
                        </div>
                    </div>
                }
                else
                {
                    var badge = AppBadge(Model.Status);
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h2 class="h5 mb-1">@Model.BusinessName</h2>
                                    <span class="text-body-secondary">@Model.TypeLabel</span>
                                </div>
                                <span class="badge bg-@badge.Color bg-opacity-10 text-@badge.Color"><i class="fa-solid fa-@badge.Icon fa-fw" aria-hidden="true"></i> @Localizer["Provider.Status." + Model.Status]</span>
                            </div>

                            @if (string.Equals(Model.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="mb-3">
                                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-sm"><i class="fa-solid fa-gauge me-1" aria-hidden="true"></i>@Localizer["Provider.Onboarding.GoToDashboard"]</a>
                                </div>
                            }

                            <ul class="list-group list-group-flush small">
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span>@Localizer["Provider.Onboarding.Submitted"]</span>
                                    @if (Model.SubmittedAt.HasValue)
                                    {
                                        <strong><bdi dir="ltr" class="font-data">@Date(Model.SubmittedAt.Value)</bdi></strong>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">&mdash;</span>
                                    }
                                </li>
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span>@Localizer["Provider.Onboarding.Reviewed"]</span>
                                    @if (Model.ReviewedAt.HasValue)
                                    {
                                        <strong><bdi dir="ltr" class="font-data">@Date(Model.ReviewedAt.Value)</bdi></strong>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">&mdash;</span>
                                    }
                                </li>
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span>@Localizer["Provider.Onboarding.Reapplications"]</span><strong><bdi dir="ltr" class="font-data">@Model.ReapplicationCount</bdi></strong>
                                </li>
                            </ul>

                            @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
                            {
                                <div class="alert alert-danger mt-3 mb-0">@Localizer["Provider.Onboarding.RejectionReason", Model.RejectionReason]</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.SuspensionReason))
                            {
                                <div class="alert alert-warning mt-3 mb-0">@Localizer["Provider.Onboarding.SuspensionReason", Model.SuspensionReason]</div>
                            }
                            @if (Model.CoolingPeriodEndsAt.HasValue)
                            {
                                <div class="alert alert-info mt-3 mb-0">@Localizer["Provider.Onboarding.CoolingPeriod", Date(Model.CoolingPeriodEndsAt.Value)]</div>
                            }

                            @if (Model.CanReapply)
                            {
                                <permission require="@WebPermission.ProviderApplication.Update">
                                    <form asp-action="Reapply" method="post" class="mt-3">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-rotate-right me-1" aria-hidden="true"></i>@Localizer["Provider.Onboarding.Reapply"]</button>
                                        <div class="form-text">@Localizer["Provider.Onboarding.ReapplyNote", Model.ReapplyAttemptsRemaining, Model.ReapplyMaxAttempts]</div>
                                    </form>
                                </permission>
                            }
                            else if (Model.HasApplication && string.Equals(Model.Status, "Rejected", StringComparison.OrdinalIgnoreCase) && Model.ReapplyLimitReached)
                            {
                                <div class="alert alert-secondary mt-3 mb-0">@Localizer["Provider.Onboarding.ReapplyLimit", Model.ReapplyMaxAttempts]</div>
                            }
                        </div>
                    </div>

                    <div class="card shadow-sm">
                        <div class="card-header border-bottom"><h2 class="card-header-title h5 mb-0">@Localizer["Provider.Onboarding.DocumentsHeading"]</h2></div>
                        <div class="card-body">
                            @if (!Model.HasDocuments)
                            {
                                <p class="small text-body-secondary mb-0">@Localizer["Provider.Onboarding.NoDocuments"]</p>
                            }
                            else
                            {
                                <ul class="list-group list-group-flush small mb-0">
                                    @foreach (var doc in Model.Documents)
                                    {
                                        var replaceId = $"replace-{doc.DocumentId:N}";
                                        <li class="list-group-item px-0">
                                            <div class="d-flex justify-content-between align-items-center gap-2">
                                                <span>
                                                    <i class="fa-solid fa-file-lines me-1" aria-hidden="true"></i>
                                                    <strong>@doc.DocumentTypeLabel</strong> &mdash; <bdi dir="ltr">@doc.FileName</bdi>
                                                </span>
                                                <span class="text-body-secondary">
                                                    @if (doc.ExpiresAt.HasValue)
                                                    {
                                                        <text>@Localizer["Provider.Onboarding.ExpiresOn"] <bdi dir="ltr" class="font-data">@Date(doc.ExpiresAt.Value)</bdi></text>
                                                    }
                                                    @if (Model.CanUploadDocuments)
                                                    {
                                                        <permission require="@WebPermission.ProviderApplication.Update">
                                                            <button type="button" class="btn btn-link btn-sm p-0 ms-2" data-bs-toggle="collapse" data-bs-target="#@replaceId">@Localizer["Provider.Onboarding.Replace"]</button>
                                                        </permission>
                                                    }
                                                </span>
                                            </div>

                                            @if (Model.CanUploadDocuments)
                                            {
                                                <permission require="@WebPermission.ProviderApplication.Update">
                                                    <div class="collapse mt-2" id="@replaceId">
                                                        <form asp-action="ReplaceDocument" method="post" class="row g-2 align-items-end">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="DocumentId" value="@doc.DocumentId" />
                                                            <div class="col-md-4">
                                                                <label class="form-label" for="rfu-@doc.DocumentId">@Localizer["Provider.Onboarding.ReplaceFileUrl"]</label>
                                                                <input id="rfu-@doc.DocumentId" name="FileUrl" type="url" dir="ltr" class="form-control" value="@doc.FileUrl" />
                                                            </div>
                                                            <div class="col-md-3">
                                                                <label class="form-label" for="rfn-@doc.DocumentId">@Localizer["Provider.Onboarding.ReplaceFileName"]</label>
                                                                <input id="rfn-@doc.DocumentId" name="FileName" type="text" dir="ltr" class="form-control" value="@doc.FileName" />
                                                            </div>
                                                            <div class="col-md-2">
                                                                <label class="form-label" for="rfs-@doc.DocumentId">@Localizer["Provider.Onboarding.ReplaceSize"]</label>
                                                                <input id="rfs-@doc.DocumentId" name="FileSizeBytes" type="number" min="1" dir="ltr" class="form-control" />
                                                            </div>
                                                            <div class="col-md-2">
                                                                <label class="form-label" for="rfe-@doc.DocumentId">@Localizer["Provider.Onboarding.ReplaceExpiry"]</label>
                                                                <input id="rfe-@doc.DocumentId" name="ExpiresAt" type="date" dir="ltr" class="form-control" value="@(doc.ExpiresAt?.ToString("yyyy-MM-dd"))" />
                                                            </div>
                                                            <div class="col-md-1 d-grid">
                                                                <button type="submit" class="btn btn-outline-primary btn-sm">@Localizer["Provider.Onboarding.Save"]</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </permission>
                                            }
                                        </li>
                                    }
                                </ul>
                            }

                            @if (Model.CanUploadDocuments)
                            {
                                <permission require="@WebPermission.ProviderApplication.Create">
                                    <hr />
                                    <h3 class="h6 mb-2">@Localizer["Provider.Onboarding.UploadHeading"]</h3>
                                    <p class="small text-body-secondary mb-2">@Localizer["Provider.Onboarding.UploadHelp"]</p>
                                    <form asp-action="UploadDocument" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
                                        @Html.AntiForgeryToken()
                                        <div class="col-md-4">
                                            <label for="DocumentType" class="form-label">@Localizer["Provider.Onboarding.DocumentType"]</label>
                                            <select id="DocumentType" name="DocumentType" class="form-select">
                                                <option value="">@Localizer["Provider.Onboarding.ChooseType"]</option>
                                                @foreach (var opt in Model.UploadForm.DocumentTypeOptions)
                                                {
                                                    <option value="@opt.Value">@opt.Label</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label for="File" class="form-label">@Localizer["Provider.Onboarding.File"]</label>
                                            <input id="File" name="File" type="file" class="form-control" accept="@ProviderDocumentUploadVm.AcceptAttribute" />
                                        </div>
                                        <div class="col-md-2">
                                            <label for="ExpiresAt" class="form-label">@Localizer["Provider.Onboarding.ExpiresAt"]</label>
                                            <input id="ExpiresAt" name="ExpiresAt" type="date" dir="ltr" class="form-control" />
                                        </div>
                                        <div class="col-md-2 d-grid">
                                            <button type="submit" class="btn btn-outline-primary"><i class="fa-solid fa-upload me-1" aria-hidden="true"></i>@Localizer["Provider.Onboarding.Upload"]</button>
                                        </div>
                                    </form>
                                </permission>
                            }
                        </div>
                    </div>

                    @if (Model.CanSubmit)
                    {
                        <permission require="@WebPermission.ProviderApplication.Submit">
                            <form asp-action="Submit" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success"><i class="fa-solid fa-paper-plane me-1" aria-hidden="true"></i>@Localizer["Provider.Onboarding.SubmitForReview"]</button>
                            </form>
                        </permission>
                    }
                }
            </div>
        </div>
    </div>
</section>
