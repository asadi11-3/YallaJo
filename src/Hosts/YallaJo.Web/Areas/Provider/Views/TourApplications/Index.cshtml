@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Provider.Shared
@model YallaJo.Web.Areas.Provider.Models.TourApplications.TourApplicationsIndexVm
@{
    ViewData["Title"] = $"Guide applications — {Model.TourName}";
    ViewData["ProviderNav"] = "Listings";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as ProviderSidebarVm ?? new ProviderSidebarVm();
}

<partial name="_ProviderSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-sm-flex justify-content-between align-items-center">
            <div>
                <h1 class="fs-4 mb-0"><i class="bi bi-person-lines-fill me-2"></i>Guide Applications</h1>
                <span class="small text-body-secondary"><bdi>@Model.TourName</bdi> · @Model.TourStatusLabel · @Model.TotalCount total</span>
            </div>
            <div class="mt-2 mt-sm-0 d-flex gap-2">
                <a asp-area="Provider" asp-controller="Tours" asp-action="Edit" asp-route-id="@Model.TourId"
                   class="btn btn-sm btn-secondary-soft"><i class="bi bi-arrow-left me-1"></i>Back to listing</a>
                <permission require="@WebPermission.Tour.Update">
                    <form asp-area="Provider" asp-controller="TourApplications" asp-action="Open" asp-route-id="@Model.TourId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-success-soft"><i class="bi bi-unlock me-1"></i>Open applications</button>
                    </form>
                    <form asp-area="Provider" asp-controller="TourApplications" asp-action="Close" asp-route-id="@Model.TourId" method="post" class="d-inline"
                          onsubmit="return confirm('Close this tour for new guide applications?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-secondary-soft"><i class="bi bi-lock me-1"></i>Close applications</button>
                    </form>
                </permission>
            </div>
        </div>

        @if (!Model.HasApplications)
        {
            <div class="card border">
                <div class="card-body text-center py-5">
                    <h5 class="mb-1">No applications yet</h5>
                    <p class="text-body-secondary mb-0">Open the tour for applications so guides can apply to run it.</p>
                </div>
            </div>
        }
        else
        {
            <div class="vstack gap-3">
                @foreach (var a in Model.Applications)
                {
                    var (badgeCss, badgeIcon) = a.StatusBadge;
                    <div class="card border">
                        <div class="card-body">
                            <div class="d-sm-flex justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge @badgeCss"><i class="bi @badgeIcon me-1" aria-hidden="true"></i>@a.Status</span>
                                        @if (a.ResubmissionCount > 0)
                                        {
                                            <span class="small text-body-secondary">Resubmitted @a.ResubmissionCount×</span>
                                        }
                                        <span class="small text-body-secondary">@a.CreatedAt.ToString("d MMM yyyy")</span>
                                    </div>
                                    <div class="small">Guide: <span dir="ltr">@a.GuideUserId</span></div>
                                    @if (a.ProposedBasePrice is { } price)
                                    {
                                        <div class="small">Proposed base price: <bdi>@price.ToString("N3")</bdi></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(a.Message))
                                    {
                                        <p class="mb-1 mt-2"><span class="text-body-secondary">Message:</span> <bdi>@a.Message</bdi></p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(a.RelevantExperience))
                                    {
                                        <p class="mb-0 small"><span class="text-body-secondary">Experience:</span> <bdi>@a.RelevantExperience</bdi></p>
                                    }
                                    @if (a.IsRejected && !string.IsNullOrWhiteSpace(a.RejectionReason))
                                    {
                                        <p class="mb-0 small text-danger"><i class="bi bi-x-circle me-1" aria-hidden="true"></i><bdi>@a.RejectionReason</bdi></p>
                                    }
                                </div>
                                @if (a.IsPending)
                                {
                                    <div class="mt-3 mt-sm-0 text-sm-end vstack gap-2" style="min-width:14rem;">
                                        <permission require="@WebPermission.GuideApplication.Approve">
                                            <form asp-area="Provider" asp-controller="TourApplications" asp-action="Approve"
                                                  asp-route-id="@Model.TourId" asp-route-applicationId="@a.ApplicationId" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success w-100"><i class="bi bi-check-lg me-1"></i>Approve</button>
                                            </form>
                                        </permission>
                                        <permission require="@WebPermission.GuideApplication.Reject">
                                            <form asp-area="Provider" asp-controller="TourApplications" asp-action="Reject"
                                                  asp-route-id="@Model.TourId" asp-route-applicationId="@a.ApplicationId" method="post"
                                                  class="input-group input-group-sm"
                                                  onsubmit="return confirm('Reject this application?');">
                                                @Html.AntiForgeryToken()
                                                <input type="text" name="reason" class="form-control" placeholder="Reason" required
                                                       aria-label="Rejection reason" maxlength="500" />
                                                <button type="submit" class="btn btn-danger-soft">Reject</button>
                                            </form>
                                        </permission>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
