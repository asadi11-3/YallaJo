@model YallaJo.Web.Areas.Provider.Models.TourApplications.TourApplicationsIndexVm
@{
    ViewData["Title"] = Localizer["Provider.TourApplications.Title"].Value;
    ViewData["ProviderNav"] = "Listings";

    (string Color, string Icon) AppBadge(string s) => (s ?? "").ToLowerInvariant() switch
    {
        "approved" => ("success", "circle-check"),
        "rejected" => ("danger", "circle-xmark"),
        "pending" or "submitted" => ("warning", "clock"),
        _ => ("secondary", "circle-info"),
    };
    string StatusLabel(string s) => Localizer["Provider.Status." + s];
}

@await Component.InvokeAsync("ProviderSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-sm-flex justify-content-between align-items-center">
            <div>
                <h1 class="fs-4 mb-0"><i class="fa-solid fa-user-check me-2" aria-hidden="true"></i>@Localizer["Provider.TourApplications.Heading"]</h1>
                <span class="small text-body-secondary"><bdi dir="ltr">@Model.TourName</bdi> · @Model.TourStatusLabel · @Localizer["Provider.TourApplications.TotalCount", Count(Model.TotalCount)]</span>
            </div>
            <div class="mt-2 mt-sm-0 d-flex gap-2">
                <a asp-area="Provider" asp-controller="Tours" asp-action="Edit" asp-route-id="@Model.TourId"
                   class="btn btn-sm btn-secondary-soft"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>@Localizer["Provider.TourApplications.BackToListing"]</a>
                <permission require="@WebPermission.Tour.Update">
                    <form asp-area="Provider" asp-controller="TourApplications" asp-action="Open" asp-route-id="@Model.TourId" method="post" data-loading class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-success-soft"><i class="fa-solid fa-lock-open me-1" aria-hidden="true"></i>@Localizer["Provider.TourApplications.Open"]</button>
                    </form>
                    <button type="button" class="btn btn-sm btn-secondary-soft" data-bs-toggle="modal" data-bs-target="#close-apps-modal">
                        <i class="fa-solid fa-lock me-1" aria-hidden="true"></i>@Localizer["Provider.TourApplications.Close"]
                    </button>
                </permission>
            </div>
        </div>

        @if (!Model.HasApplications)
        {
            <div class="card border">
                <div class="card-body">
                    <partial name="_ProviderEmptyState" view-data="@(new ViewDataDictionary(ViewData) { ["title"] = Localizer["Provider.TourApplications.EmptyTitle"].Value, ["message"] = Localizer["Provider.TourApplications.EmptyMsg"].Value })" />
                </div>
            </div>
        }
        else
        {
            var rowIndex = 0;
            <div class="vstack gap-3">
                @foreach (var a in Model.Applications)
                {
                    rowIndex++;
                    var (badgeColor, badgeIcon) = AppBadge(a.Status);
                    <div class="card border">
                        <div class="card-body">
                            <div class="d-sm-flex justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                        <span class="badge bg-@badgeColor bg-opacity-10 text-@badgeColor"><i class="fa-solid fa-@badgeIcon fa-fw me-1" aria-hidden="true"></i>@StatusLabel(a.Status)</span>
                                        <span class="fw-semibold">@Localizer["Provider.TourApplications.ApplicationLabel", Count(rowIndex)]</span>
                                        @if (a.ResubmissionCount > 0)
                                        {
                                            <span class="small text-body-secondary">@Localizer["Provider.TourApplications.Resubmitted", Count(a.ResubmissionCount)]</span>
                                        }
                                        <span class="small text-body-secondary"><bdi dir="ltr">@Date(a.CreatedAt)</bdi></span>
                                    </div>
                                    @if (a.ProposedBasePrice.HasValue)
                                    {
                                        <div class="small">@Localizer["Provider.TourApplications.ProposedPrice"]: <bdi dir="ltr" class="font-data">@Money(a.ProposedBasePrice.Value)</bdi></div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(a.Message))
                                    {
                                        <p class="mb-1 mt-2"><span class="text-body-secondary">@Localizer["Provider.TourApplications.Message"]:</span> <bdi>@a.Message</bdi></p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(a.RelevantExperience))
                                    {
                                        <p class="mb-0 small"><span class="text-body-secondary">@Localizer["Provider.TourApplications.Experience"]:</span> <bdi>@a.RelevantExperience</bdi></p>
                                    }
                                    @if (a.IsRejected && !string.IsNullOrWhiteSpace(a.RejectionReason))
                                    {
                                        <p class="mb-0 small text-danger mt-2"><i class="fa-solid fa-circle-xmark me-1" aria-hidden="true"></i><bdi>@a.RejectionReason</bdi></p>
                                    }
                                </div>
                                @if (a.IsPending)
                                {
                                    <div class="mt-3 mt-sm-0 text-sm-end vstack gap-2 yj-min-w-14r">
                                        <permission require="@WebPermission.GuideApplication.Approve">
                                            <form asp-area="Provider" asp-controller="TourApplications" asp-action="Approve"
                                                  asp-route-id="@Model.TourId" asp-route-applicationId="@a.ApplicationId" method="post" data-loading
                                                  data-confirm="@Localizer["Provider.TourApplications.ApproveBody"]"
                                                  data-confirm-title="@Localizer["Provider.TourApplications.ApproveTitle"]"
                                                  data-confirm-action="@Localizer["Provider.TourApplications.Approve"]"
                                                  data-confirm-cancel="@Localizer["Provider.Common.Cancel"]">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success w-100"><i class="fa-solid fa-check me-1" aria-hidden="true"></i>@Localizer["Provider.TourApplications.Approve"]</button>
                                            </form>
                                        </permission>
                                        <permission require="@WebPermission.GuideApplication.Reject">
                                            <button type="button" class="btn btn-sm btn-danger-soft w-100" data-bs-toggle="modal" data-bs-target="#reject-app-@a.ApplicationId">
                                                <i class="fa-solid fa-xmark me-1" aria-hidden="true"></i>@Localizer["Provider.TourApplications.Reject"]
                                            </button>
                                        </permission>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@* Close-applications confirm modal (MOD3 static + MOD4 role=dialog) *@
<permission require="@WebPermission.Tour.Update">
    <div class="modal fade" id="close-apps-modal" tabindex="-1" aria-labelledby="close-apps-title" aria-describedby="close-apps-body"
         data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form asp-area="Provider" asp-controller="TourApplications" asp-action="Close" asp-route-id="@Model.TourId" method="post" data-loading
                  class="modal-content">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title h5" id="close-apps-title">@Localizer["Provider.TourApplications.CloseTitle"]</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Provider.TourApplications.Dismiss"]"></button>
                </div>
                <div class="modal-body" id="close-apps-body">
                    <p class="mb-0">@Localizer["Provider.TourApplications.CloseBody"]</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary-soft" data-bs-dismiss="modal">@Localizer["Provider.TourApplications.Cancel"]</button>
                    <button type="submit" class="btn btn-warning">@Localizer["Provider.TourApplications.CloseConfirm"]</button>
                </div>
            </form>
        </div>
    </div>
</permission>

@* Per-application reject reason modals (MOD3 static + MOD4 role=dialog) *@
<permission require="@WebPermission.GuideApplication.Reject">
    @foreach (var a in Model.Applications)
    {
        if (a.IsPending)
        {
            <div class="modal fade" id="reject-app-@a.ApplicationId" tabindex="-1" aria-labelledby="reject-title-@a.ApplicationId" aria-describedby="reject-body-@a.ApplicationId"
                 data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <form asp-area="Provider" asp-controller="TourApplications" asp-action="Reject"
                          asp-route-id="@Model.TourId" asp-route-applicationId="@a.ApplicationId" method="post" data-loading
                          class="modal-content">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h2 class="modal-title h5" id="reject-title-@a.ApplicationId">@Localizer["Provider.TourApplications.RejectTitle"]</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Provider.TourApplications.Dismiss"]"></button>
                        </div>
                        <div class="modal-body" id="reject-body-@a.ApplicationId">
                            <p>@Localizer["Provider.TourApplications.RejectBody"]</p>
                            <label class="form-label" for="reject-reason-@a.ApplicationId">@Localizer["Provider.TourApplications.ReasonLabel"]</label>
                            <textarea id="reject-reason-@a.ApplicationId" name="reason" class="form-control" rows="3" required maxlength="500"
                                      aria-describedby="reject-reason-help-@a.ApplicationId"></textarea>
                            <div class="form-text" id="reject-reason-help-@a.ApplicationId">@Localizer["Provider.TourApplications.ReasonHelp"]</div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary-soft" data-bs-dismiss="modal">@Localizer["Provider.TourApplications.Cancel"]</button>
                            <button type="submit" class="btn btn-danger">@Localizer["Provider.TourApplications.RejectConfirm"]</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    }
</permission>
