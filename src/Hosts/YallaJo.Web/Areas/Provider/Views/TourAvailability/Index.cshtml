@using YallaJo.Web.Areas.Provider.Models.TourAvailability
@model TourAvailabilityIndexVm
@{
    ViewData["Title"] = Localizer["Provider.TourAvailability.Title"].Value;
    ViewData["ProviderNav"] = "Listings";
}

@await Component.InvokeAsync("ProviderSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-sm-flex justify-content-between align-items-center">
            <div>
                <h1 class="fs-4 mb-0"><i class="fa-solid fa-calendar-week me-2" aria-hidden="true"></i>@Localizer["Provider.TourAvailability.Heading"]</h1>
                <span class="small text-body-secondary"><bdi dir="ltr">@Model.TourName</bdi>@(string.IsNullOrWhiteSpace(Model.TourStatusLabel) ? "" : $" · {Model.TourStatusLabel}")</span>
            </div>
            <div class="mt-2 mt-sm-0 d-flex gap-2">
                <a asp-area="Provider" asp-controller="Tours" asp-action="Edit" asp-route-id="@Model.TourId"
                   class="btn btn-sm btn-secondary-soft"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>@Localizer["Provider.TourAvailability.BackToListing"]</a>
                <permission require="@WebPermission.AvailabilitySlot.Create">
                    <a asp-area="Provider" asp-controller="TourAvailability" asp-action="Create" asp-route-id="@Model.TourId"
                       class="btn btn-sm btn-primary"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>@Localizer["Provider.TourAvailability.AddSlot"]</a>
                    <button type="button" class="btn btn-sm btn-primary-soft" data-bs-toggle="collapse" data-bs-target="#bulk-slots"
                            aria-expanded="false" aria-controls="bulk-slots"><i class="fa-solid fa-calendar-plus me-1" aria-hidden="true"></i>@Localizer["Provider.TourAvailability.BulkAdd"]</button>
                </permission>
            </div>
        </div>

        <div class="alert alert-info" role="status">
            <i class="fa-solid fa-circle-info me-1" aria-hidden="true"></i>@Localizer["Provider.TourAvailability.Intro"]
        </div>

        @* [Backend] B3 / CAL1: month grid lazily loaded per month by provider-availability.js
           via api.loadPartial. Hidden without JS — the slot table below is the no-JS path (PE1). *@
        <div class="card border d-none" data-yj-component="availability-calendar"
             data-yj-calendar-url="@Url.Action("Calendar", "TourAvailability", new { area = "Provider", id = Model.TourId })"
             data-error-text="@Localizer["Provider.Common.ResultsError"]"
             data-retry-text="@Localizer["Provider.Common.Retry"]">
            <div class="card-header border-bottom"><h2 class="card-header-title h5 mb-0">@Localizer["Provider.TourAvailability.CalendarHeading"]</h2></div>
            <div class="card-body" data-yj-calendar-host aria-live="polite" aria-busy="false"></div>
        </div>

        <permission require="@WebPermission.AvailabilitySlot.Create">
            <div class="collapse" id="bulk-slots">
                <div class="card border">
                    <div class="card-header border-bottom"><h2 class="card-header-title h5 mb-0">@Localizer["Provider.TourAvailability.BulkHeading"]</h2></div>
                    <div class="card-body">
                        <form asp-area="Provider" asp-controller="TourAvailability" asp-action="Bulk" asp-route-id="@Model.TourId" method="post" data-loading class="row g-3">
                            @Html.AntiForgeryToken()
                            <div class="col-md-3">
                                <label class="form-label" for="bulk-start">@Localizer["Provider.TourAvailability.StartDate"]</label>
                                <input id="bulk-start" name="StartDate" type="date" class="form-control" dir="ltr" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="bulk-end">@Localizer["Provider.TourAvailability.EndDate"]</label>
                                <input id="bulk-end" name="EndDate" type="date" class="form-control" dir="ltr" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="bulk-rec">@Localizer["Provider.TourAvailability.Recurrence"]</label>
                                <select id="bulk-rec" name="Recurrence" class="form-select">
                                    @foreach (var r in BulkAvailabilitySlotFormVm.RecurrenceOptions)
                                    {
                                        <option value="@r">@Localizer["Provider.TourAvailability.Recurrence." + r]</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="bulk-cap">@Localizer["Provider.TourAvailability.CapacityPerSlot"]</label>
                                <input id="bulk-cap" name="MaxCapacity" type="number" min="1" value="1" class="form-control" dir="ltr" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="bulk-stime">@Localizer["Provider.TourAvailability.StartTime"]</label>
                                <input id="bulk-stime" name="StartTime" type="time" class="form-control" dir="ltr" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="bulk-etime">@Localizer["Provider.TourAvailability.EndTime"]</label>
                                <input id="bulk-etime" name="EndTime" type="time" class="form-control" dir="ltr" required />
                            </div>
                            <div class="col-md-6">
                                <span class="form-label d-block" id="bulk-days-label">@Localizer["Provider.TourAvailability.DaysOfWeek"] <span class="text-body-secondary small">@Localizer["Provider.TourAvailability.DaysHint"]</span></span>
                                <div class="d-flex flex-wrap gap-2" role="group" aria-labelledby="bulk-days-label">
                                    @foreach (var (val, label) in BulkAvailabilitySlotFormVm.DayOptions)
                                    {
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="checkbox" name="DaysOfWeek" value="@val" id="day-@val" />
                                            <label class="form-check-label" for="day-@val">@Localizer["Provider.TourAvailability.Day." + val]</label>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input type="hidden" name="SkipExisting" value="false" />
                                    <input class="form-check-input" type="checkbox" name="SkipExisting" value="true" id="bulk-skip" checked />
                                    <label class="form-check-label" for="bulk-skip">@Localizer["Provider.TourAvailability.SkipExisting"]</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary">@Localizer["Provider.TourAvailability.Generate"]</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </permission>

        @if (!Model.HasSlots)
        {
            <div class="card border">
                <div class="card-body">
                    <partial name="_ProviderEmptyState" view-data="@(new ViewDataDictionary(ViewData) { { "title", Localizer["Provider.TourAvailability.EmptyTitle"].Value }, { "message", Localizer["Provider.TourAvailability.EmptyMsg"].Value }, { "ctaText", Localizer["Provider.TourAvailability.AddSlot"].Value }, { "ctaUrl", Url.Action("Create", "TourAvailability", new { area = "Provider", id = Model.TourId }) }, { "ctaPermission", WebPermission.AvailabilitySlot.Create } })" />
                </div>
            </div>
        }
        else
        {
            <div class="card border">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <caption class="visually-hidden">@Localizer["Provider.TourAvailability.TableCaption"]</caption>
                        <thead class="table-light">
                            <tr>
                                <th scope="col">@Localizer["Provider.TourAvailability.ColDate"]</th>
                                <th scope="col">@Localizer["Provider.TourAvailability.ColTime"]</th>
                                <th scope="col" class="text-end">@Localizer["Provider.TourAvailability.ColCapacity"]</th>
                                <th scope="col" class="text-end">@Localizer["Provider.TourAvailability.ColAvailable"]</th>
                                <th scope="col">@Localizer["Provider.TourAvailability.ColStatus"]</th>
                                <th scope="col" class="text-end"><span class="visually-hidden">@Localizer["Provider.TourAvailability.ColActions"]</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Slots)
                            {
                                <tr>
                                    <td class="fw-semibold"><bdi dir="ltr" class="font-data">@s.DateLabel</bdi></td>
                                    <td><bdi dir="ltr" class="font-data">@s.StartTime – @s.EndTime</bdi></td>
                                    <td class="text-end"><bdi dir="ltr" class="font-data">@Count(s.MaxCapacity)</bdi></td>
                                    <td class="text-end"><bdi dir="ltr" class="font-data">@Count(s.AvailableCount)</bdi></td>
                                    <td>
                                        @if (s.IsActive)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success"><i class="fa-solid fa-circle-check fa-fw me-1" aria-hidden="true"></i>@Localizer["Provider.TourAvailability.Active"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary"><i class="fa-solid fa-circle-minus fa-fw me-1" aria-hidden="true"></i>@Localizer["Provider.TourAvailability.Inactive"]</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex justify-content-end gap-1">
                                            <permission require="@WebPermission.AvailabilitySlot.Update">
                                                <a asp-area="Provider" asp-controller="TourAvailability" asp-action="Edit"
                                                   asp-route-id="@Model.TourId" asp-route-slotId="@s.Id"
                                                   class="btn btn-sm btn-outline-secondary" aria-label="@Localizer["Provider.TourAvailability.EditSlot"]"><i class="fa-solid fa-pen" aria-hidden="true"></i></a>
                                            </permission>
                                            <permission require="@WebPermission.AvailabilitySlot.Delete">
                                                @{
                                                    var deleteBody = Localizer["Provider.TourAvailability.DeleteBody", s.DateLabel].Value
                                                        + (s.HasHeldSeats ? " " + Localizer["Provider.TourAvailability.DeleteHeldWarning"].Value : "");
                                                }
                                                <form asp-area="Provider" asp-controller="TourAvailability" asp-action="Delete" asp-route-id="@Model.TourId" asp-route-slotId="@s.Id" method="post" data-loading class="d-inline"
                                                      data-confirm="@deleteBody"
                                                      data-confirm-title="@Localizer["Provider.TourAvailability.DeleteTitle"]"
                                                      data-confirm-action="@Localizer["Provider.TourAvailability.DeleteConfirm"]"
                                                      data-confirm-cancel="@Localizer["Provider.TourAvailability.Cancel"]">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-danger-soft" aria-label="@Localizer["Provider.TourAvailability.RemoveSlot"]"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                                                </form>
                                            </permission>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script src="~/assets/js/provider-availability.js" asp-append-version="true"></script>
}

