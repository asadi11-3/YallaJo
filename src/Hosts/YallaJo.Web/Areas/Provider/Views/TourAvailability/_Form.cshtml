@using YallaJo.Web.Areas.Provider.Models.TourAvailability
@model AvailabilitySlotFormVm

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<input type="hidden" asp-for="TourId" />
<input type="hidden" asp-for="SlotId" />
<input type="hidden" asp-for="IsEdit" />
<input type="hidden" asp-for="RowVersion" />

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="Date" class="form-label">@Localizer["Provider.TourAvailability.Date"]</label>
        <input asp-for="Date" type="date" class="form-control" dir="ltr" readonly="@Model.IsEdit" />
        <span asp-validation-for="Date" class="text-danger small" role="alert"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="StartTime" class="form-label">@Localizer["Provider.TourAvailability.StartTime"]</label>
        <input asp-for="StartTime" type="time" class="form-control" dir="ltr" readonly="@Model.IsEdit" />
        <span asp-validation-for="StartTime" class="text-danger small" role="alert"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="EndTime" class="form-label">@Localizer["Provider.TourAvailability.EndTime"]</label>
        <input asp-for="EndTime" type="time" class="form-control" dir="ltr" readonly="@Model.IsEdit" />
        <span asp-validation-for="EndTime" class="text-danger small" role="alert"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="MaxCapacity" class="form-label">@Localizer["Provider.TourAvailability.Capacity"]</label>
        <input asp-for="MaxCapacity" type="number" min="1" max="1000" class="form-control" dir="ltr" aria-describedby="capacity-help" />
        <span asp-validation-for="MaxCapacity" class="text-danger small" role="alert"></span>
    </div>
</div>

@if (Model.IsEdit)
{
    <p id="capacity-help" class="text-body-secondary small mt-3 mb-0">@Localizer["Provider.TourAvailability.EditNote"]</p>
}
