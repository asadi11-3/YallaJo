@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Provider.Models.TourAvailability
@using YallaJo.Web.Areas.Provider.Shared
@model AvailabilitySlotFormVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Provider.TourAvailability.EditTitle"].Value;
    ViewData["ProviderNav"] = "Listings";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as ProviderSidebarVm ?? new ProviderSidebarVm { DisplayName = User.Identity?.Name ?? "Provider" };
}

<partial name="_ProviderSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9 col-xl-8">
                <h1 class="fs-4 mb-1"><i class="fa-solid fa-calendar-week me-2" aria-hidden="true"></i>@Localizer["Provider.TourAvailability.EditHeading"]</h1>
                @if (!string.IsNullOrWhiteSpace(Model.TourName))
                {
                    <p class="small text-body-secondary"><bdi dir="ltr">@Model.TourName</bdi></p>
                }

                <div class="card border">
                    <div class="card-body">
                        <form asp-area="Provider" asp-controller="TourAvailability" asp-action="Edit"
                              asp-route-id="@Model.TourId" asp-route-slotId="@Model.SlotId" method="post">
                            @Html.AntiForgeryToken()
                            <partial name="_Form" model="Model" />
                            <div class="mt-4 d-flex gap-2">
                                <button type="submit" class="btn btn-primary">@Localizer["Provider.TourAvailability.EditSubmit"]</button>
                                <a asp-area="Provider" asp-controller="TourAvailability" asp-action="Index" asp-route-id="@Model.TourId"
                                   class="btn btn-link">@Localizer["Provider.TourAvailability.Cancel"]</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
