@using YallaJo.Web.Areas.Provider.Models.Bookings
@model ProviderBookingDetailsVm
@{
    ViewData["Title"] = Localizer["Provider.ProviderBookings.DetailsTitle"].Value;
    ViewData["ProviderNav"] = "Bookings";

    var culture = CultureInfo.CurrentUICulture;
    string Money(decimal a, string? c = null) => a.ToString("N3", culture) + " " + (string.IsNullOrWhiteSpace(c) ? Model.Currency : c);
    string Count(int n) => n.ToString("N0", culture);
    string DateTimeF(DateTime dt) => dt.ToString("yyyy-MM-dd HH:mm", culture);

    (string Color, string Icon) StatusBadge(string s) => (s ?? "").ToLowerInvariant() switch
    {
        "confirmed" => ("success", "circle-check"),
        "completed" => ("primary", "flag-checkered"),
        "awaitingpayment" => ("warning", "hourglass-half"),
        "pendingconfirmation" => ("warning", "clock"),
        "cancelled" => ("secondary", "ban"),
        "rejected" => ("danger", "circle-xmark"),
        _ => ("secondary", "circle-info"),
    };
    var badge = StatusBadge(Model.Status);
}

@await Component.InvokeAsync("ProviderSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-sm-flex justify-content-between align-items-center">
            <div>
                <h1 class="fs-4 mb-1">@Localizer["Provider.ProviderBookings.BookingHeading"] <bdi dir="ltr" class="font-data">@Model.Reference</bdi></h1>
                <span class="badge bg-@badge.Color bg-opacity-10 text-@badge.Color"><i class="fa-solid fa-@badge.Icon fa-fw" aria-hidden="true"></i> @Localizer["Provider.Status." + Model.Status]</span>
            </div>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary mt-2 mt-sm-0"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>@Localizer["Provider.ProviderBookings.Back"]</a>
        </div>

        <div class="row g-4">
            <div class="col-lg-8 vstack gap-4">
                <div class="card shadow-sm">
                    <div class="card-header border-bottom"><h2 class="card-header-title h5 mb-0">@Localizer["Provider.ProviderBookings.OverviewHeading"]</h2></div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">@Localizer["Provider.ProviderBookings.Tour"]</dt>
                            <dd class="col-sm-8 fw-semibold">@Model.TourName</dd>

                            <dt class="col-sm-4">@Localizer["Provider.ProviderBookings.Traveler"]</dt>
                            <dd class="col-sm-8"><bdi dir="ltr">@Model.TravelerHandle</bdi></dd>

                            <dt class="col-sm-4">@Localizer["Provider.ProviderBookings.Guests"]</dt>
                            <dd class="col-sm-8"><bdi dir="ltr" class="font-data">@Count(Model.ParticipantCount)</bdi></dd>

                            <dt class="col-sm-4">@Localizer["Provider.ProviderBookings.Instant"]</dt>
                            <dd class="col-sm-8">@(Model.IsInstantBooking ? Localizer["Provider.ProviderBookings.Yes"] : Localizer["Provider.ProviderBookings.No"])</dd>

                            <dt class="col-sm-4">@Localizer["Provider.ProviderBookings.Created"]</dt>
                            <dd class="col-sm-8"><bdi dir="ltr" class="font-data">@DateTimeF(Model.CreatedAt)</bdi></dd>

                            <dt class="col-sm-4">@Localizer["Provider.ProviderBookings.SpecialRequests"]</dt>
                            <dd class="col-sm-8">
                                @if (string.IsNullOrWhiteSpace(Model.SpecialRequests))
                                {
                                    <span class="text-secondary">&mdash;</span>
                                }
                                else
                                {
                                    <span>@Model.SpecialRequests</span>
                                }
                            </dd>
                        </dl>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-header border-bottom"><h2 class="card-header-title h5 mb-0">@Localizer["Provider.ProviderBookings.PricingHeading"]</h2></div>
                    <div class="card-body">
                        @if (Model.LineItems.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-3">
                                    <thead>
                                        <tr>
                                            <th scope="col">@Localizer["Provider.ProviderBookings.ColTier"]</th>
                                            <th scope="col" class="text-end">@Localizer["Provider.ProviderBookings.ColQty"]</th>
                                            <th scope="col" class="text-end">@Localizer["Provider.ProviderBookings.ColUnit"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var li in Model.LineItems)
                                        {
                                            <tr>
                                                <td>@li.TierType</td>
                                                <td class="text-end"><bdi dir="ltr" class="font-data">@Count(li.Count)</bdi></td>
                                                <td class="text-end"><bdi dir="ltr" class="font-data">@Money(li.UnitPrice, li.Currency)</bdi></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        <div class="d-flex justify-content-between"><span>@Localizer["Provider.ProviderBookings.Subtotal"]</span><bdi dir="ltr" class="font-data">@Money(Model.Subtotal)</bdi></div>
                        @if (Model.DiscountAmount > 0)
                        {
                            <div class="d-flex justify-content-between text-success"><span>@Localizer["Provider.ProviderBookings.Discount"]</span><bdi dir="ltr" class="font-data">-@Money(Model.DiscountAmount)</bdi></div>
                        }
                        <hr class="my-2" />
                        <div class="d-flex justify-content-between fw-bold"><span>@Localizer["Provider.ProviderBookings.Total"]</span><bdi dir="ltr" class="font-data">@Money(Model.TotalAmount)</bdi></div>

                        @if (Model.IsCancelled)
                        {
                            <div class="alert alert-secondary mt-3 mb-0">
                                <strong>@Localizer["Provider.ProviderBookings.CancelledLabel"]</strong>
                                @if (!string.IsNullOrWhiteSpace(Model.CancellationReason))
                                {
                                    <span class="d-block">@Localizer["Provider.ProviderBookings.CancelReasonLabel", Model.CancellationReason]</span>
                                }
                                @if (Model.RefundAmount.HasValue)
                                {
                                    <span class="d-block">@Localizer["Provider.ProviderBookings.RefundLabel"] <bdi dir="ltr" class="font-data">@Money(Model.RefundAmount.Value)</bdi></span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-header border-bottom"><h2 class="card-header-title h5 mb-0">@Localizer["Provider.ProviderBookings.ActionsHeading"]</h2></div>
                    <div class="card-body d-grid gap-3">
                        @if (!Model.HasAnyAction)
                        {
                            <p class="text-secondary mb-0">@Localizer["Provider.ProviderBookings.NoAction", Localizer["Provider.Status." + Model.Status].Value]</p>
                        }

                        @if (Model.CanConfirm)
                        {
                            <permission require="@WebPermission.TourBooking.Confirm">
                                <form asp-action="Confirm" asp-route-id="@Model.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-success w-100"><i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>@Localizer["Provider.ProviderBookings.Confirm"]</button>
                                </form>
                            </permission>
                        }

                        @if (Model.CanComplete)
                        {
                            <permission require="@WebPermission.TourBooking.Complete">
                                <button type="button" class="btn btn-primary w-100" data-bs-toggle="modal" data-bs-target="#completeModal"><i class="fa-solid fa-flag-checkered me-1" aria-hidden="true"></i>@Localizer["Provider.ProviderBookings.Complete"]</button>
                                <small class="text-secondary d-block">@Localizer["Provider.ProviderBookings.CompleteNote"]</small>
                            </permission>
                        }

                        @if (Model.CanReject)
                        {
                            <permission require="@WebPermission.TourBooking.Reject">
                                <button type="button" class="btn btn-outline-danger w-100" data-bs-toggle="modal" data-bs-target="#rejectModal"><i class="fa-solid fa-circle-xmark me-1" aria-hidden="true"></i>@Localizer["Provider.ProviderBookings.Reject"]</button>
                            </permission>
                        }

                        @if (Model.CanCancel)
                        {
                            <permission require="@WebPermission.TourBooking.Cancel">
                                <button type="button" class="btn btn-outline-danger w-100" data-bs-toggle="modal" data-bs-target="#cancelModal"><i class="fa-solid fa-ban me-1" aria-hidden="true"></i>@Localizer["Provider.ProviderBookings.Cancel"]</button>
                            </permission>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@if (Model.CanComplete)
{
    <permission require="@WebPermission.TourBooking.Complete">
        <div class="modal fade" id="completeModal" tabindex="-1" aria-labelledby="complete-title" aria-describedby="complete-body" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <form asp-action="Complete" asp-route-id="@Model.Id" method="post" class="modal-content">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="complete-title">@Localizer["Provider.ProviderBookings.CompleteTitle"]</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Provider.ProviderBookings.Dismiss"]"></button>
                    </div>
                    <div class="modal-body" id="complete-body">@Localizer["Provider.ProviderBookings.CompleteBody"]</div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Provider.ProviderBookings.Dismiss"]</button>
                        <button type="submit" class="btn btn-primary">@Localizer["Provider.ProviderBookings.CompleteConfirm"]</button>
                    </div>
                </form>
            </div>
        </div>
    </permission>
}

@if (Model.CanReject)
{
    <permission require="@WebPermission.TourBooking.Reject">
        <div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="reject-title" aria-describedby="reject-help" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <form asp-action="Reject" asp-route-id="@Model.Id" method="post" class="modal-content">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="reject-title">@Localizer["Provider.ProviderBookings.RejectTitle"]</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Provider.ProviderBookings.Dismiss"]"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label" for="reject-reason">@Localizer["Provider.ProviderBookings.RejectReasonLabel"]</label>
                        <textarea id="reject-reason" name="reason" class="form-control" rows="3" minlength="10" maxlength="500" required aria-describedby="reject-help"></textarea>
                        <small id="reject-help" class="form-text">@Localizer["Provider.ProviderBookings.RejectReasonHelp"]</small>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Provider.ProviderBookings.Dismiss"]</button>
                        <button type="submit" class="btn btn-danger">@Localizer["Provider.ProviderBookings.RejectConfirm"]</button>
                    </div>
                </form>
            </div>
        </div>
    </permission>
}

@if (Model.CanCancel)
{
    <permission require="@WebPermission.TourBooking.Cancel">
        <div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancel-title" aria-describedby="cancel-help" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="modal-content">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="cancel-title">@Localizer["Provider.ProviderBookings.CancelTitle"]</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Provider.ProviderBookings.Dismiss"]"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label" for="cancel-reason">@Localizer["Provider.ProviderBookings.CancelReasonLabel2"]</label>
                        <textarea id="cancel-reason" name="reason" class="form-control" rows="3" minlength="10" maxlength="500" required aria-describedby="cancel-help"></textarea>
                        <small id="cancel-help" class="form-text">@Localizer["Provider.ProviderBookings.CancelReasonHelp"]</small>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Provider.ProviderBookings.Dismiss"]</button>
                        <button type="submit" class="btn btn-danger">@Localizer["Provider.ProviderBookings.CancelConfirm"]</button>
                    </div>
                </form>
            </div>
        </div>
    </permission>
}
