@model YallaJo.Web.Areas.Provider.Models.TourWaypoints.TourWaypointFormVm

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Name" class="form-label">Stop name <span class="text-danger">*</span></label>
        <input asp-for="Name" class="form-control" autocomplete="off" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <div class="form-check">
            <input asp-for="IsMeetingPoint" class="form-check-input" />
            <label asp-for="IsMeetingPoint" class="form-check-label"></label>
        </div>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        <small class="form-text">Optional — what travellers do or see at this stop.</small>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Latitude" class="form-label">Latitude <span class="text-danger">*</span></label>
        <input asp-for="Latitude" class="form-control" type="number" step="any" dir="ltr" inputmode="decimal" />
        <span asp-validation-for="Latitude" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Longitude" class="form-label">Longitude <span class="text-danger">*</span></label>
        <input asp-for="Longitude" class="form-control" type="number" step="any" dir="ltr" inputmode="decimal" />
        <span asp-validation-for="Longitude" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="StopDurationMinutes" class="form-label"></label>
        <input asp-for="StopDurationMinutes" class="form-control" type="number" min="0" inputmode="numeric" />
        <span asp-validation-for="StopDurationMinutes" class="text-danger small"></span>
    </div>
</div>
