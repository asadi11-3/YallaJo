@model YallaJo.Web.Areas.Provider.Models.TourWaypoints.TourWaypointsIndexVm
@{
    ViewData["Title"] = Localizer["Provider.TourWaypoints.Title"].Value;
    ViewData["ProviderNav"] = "Listings";
    var ids = Model.Waypoints.Select(w => w.Id).ToList();
    var culture = CultureInfo.CurrentUICulture;
    string Coord(double lat, double lng) => lat.ToString("0.#####", culture) + ", " + lng.ToString("0.#####", culture);
    string StopTime(int? m) => m is > 0 ? Localizer["Provider.TourWaypoints.Minutes", m.Value.ToString("N0", culture)].Value : "—";
}

@await Component.InvokeAsync("ProviderSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-sm-flex justify-content-between align-items-center">
            <div>
                <h1 class="fs-4 mb-0"><i class="fa-solid fa-location-dot me-2" aria-hidden="true"></i>@Localizer["Provider.TourWaypoints.Heading"]</h1>
                <span class="small text-body-secondary"><bdi dir="ltr">@Model.TourName</bdi> · @Model.TourStatusLabel</span>
            </div>
            <div class="mt-2 mt-sm-0 d-flex gap-2">
                <a asp-area="Provider" asp-controller="Tours" asp-action="Edit" asp-route-id="@Model.TourId"
                   class="btn btn-sm btn-secondary-soft"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>@Localizer["Provider.TourWaypoints.BackToListing"]</a>
                <permission require="@WebPermission.TourWaypoint.Create">
                    <a asp-area="Provider" asp-controller="TourWaypoints" asp-action="Create" asp-route-id="@Model.TourId"
                       class="btn btn-sm btn-primary"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>@Localizer["Provider.TourWaypoints.AddWaypoint"]</a>
                </permission>
            </div>
        </div>

        @if (!Model.HasWaypoints)
        {
            <div class="card border">
                <div class="card-body">
                    <partial name="_ProviderEmptyState" view-data="@(new ViewDataDictionary(ViewData) { ["title"] = Localizer["Provider.TourWaypoints.EmptyTitle"].Value, ["message"] = Localizer["Provider.TourWaypoints.EmptyMsg"].Value, ["ctaText"] = Localizer["Provider.TourWaypoints.AddFirst"].Value, ["ctaUrl"] = Url.Action("Create", "TourWaypoints", new { area = "Provider", id = Model.TourId }), ["ctaClass"] = "btn btn-sm btn-primary", ["ctaPermission"] = WebPermission.TourWaypoint.Create })" />
                </div>
            </div>
        }
        else
        {
            <div class="card border shadow">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <caption class="visually-hidden">@Localizer["Provider.TourWaypoints.TableCaption"]</caption>
                        <thead class="table-light">
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">@Localizer["Provider.TourWaypoints.ColStop"]</th>
                                <th scope="col">@Localizer["Provider.TourWaypoints.ColCoordinates"]</th>
                                <th scope="col">@Localizer["Provider.TourWaypoints.ColStopTime"]</th>
                                <th scope="col" class="text-end">@Localizer["Provider.TourWaypoints.ColActions"]</th>
                            </tr>
                        </thead>
                        @* NF6: provider-waypoints.js enables drag-handle reorder (optimistic, rollback on failure).
                           The move up/down forms below remain the no-JS path (PE1). *@
                        <tbody data-yj-waypoints
                               data-yj-reorder-url="@Url.Action("Reorder", "TourWaypoints", new { area = "Provider", id = Model.TourId })"
                               data-yj-saved-text="@Localizer["Provider.TourWaypoints.ReorderSavedToast"]"
                               data-yj-failed-text="@Localizer["Provider.TourWaypoints.ReorderFailedToast"]">
                            @for (var i = 0; i < Model.Waypoints.Count; i++)
                            {
                                var w = Model.Waypoints[i];
                                <tr data-yj-waypoint-id="@w.Id">
                                    <td>
                                        <permission require="@WebPermission.TourWaypoint.Update">
                                            <button type="button" class="btn btn-sm btn-light d-none me-1" data-yj-drag-handle
                                                    aria-label="@Localizer["Provider.TourWaypoints.DragHandleAria", w.Name]">
                                                <i class="fa-solid fa-grip-vertical" aria-hidden="true"></i>
                                            </button>
                                        </permission>
                                        <bdi class="font-data">@((i + 1).ToString("N0", culture))</bdi>
                                    </td>
                                    <td>
                                        <span class="fw-semibold"><bdi dir="ltr">@w.Name</bdi></span>
                                        @if (w.IsMeetingPoint)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary ms-1"><i class="fa-solid fa-flag fa-fw" aria-hidden="true"></i> @Localizer["Provider.TourWaypoints.MeetingPoint"]</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(w.Description))
                                        {
                                            <div class="small text-body-secondary"><bdi dir="ltr">@w.Description</bdi></div>
                                        }
                                    </td>
                                    <td><bdi dir="ltr" class="font-data">@Coord(w.Latitude, w.Longitude)</bdi></td>
                                    <td><bdi dir="ltr">@StopTime(w.StopDurationMinutes)</bdi></td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1">
                                            <permission require="@WebPermission.TourWaypoint.Update">
                                                @if (i > 0)
                                                {
                                                    var up = ids.ToList();
                                                    (up[i - 1], up[i]) = (up[i], up[i - 1]);
                                                    <form asp-area="Provider" asp-controller="TourWaypoints" asp-action="Reorder" asp-route-id="@Model.TourId" method="post" data-loading class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        @foreach (var wid in up)
                                                        {
                                                            <input type="hidden" name="waypointIds" value="@wid" />
                                                        }
                                                        <button type="submit" class="btn btn-sm btn-light" aria-label="@Localizer["Provider.TourWaypoints.MoveUp", w.Name]"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></button>
                                                    </form>
                                                }
                                                @if (i < Model.Waypoints.Count - 1)
                                                {
                                                    var down = ids.ToList();
                                                    (down[i + 1], down[i]) = (down[i], down[i + 1]);
                                                    <form asp-area="Provider" asp-controller="TourWaypoints" asp-action="Reorder" asp-route-id="@Model.TourId" method="post" data-loading class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        @foreach (var wid in down)
                                                        {
                                                            <input type="hidden" name="waypointIds" value="@wid" />
                                                        }
                                                        <button type="submit" class="btn btn-sm btn-light" aria-label="@Localizer["Provider.TourWaypoints.MoveDown", w.Name]"><i class="fa-solid fa-arrow-down" aria-hidden="true"></i></button>
                                                    </form>
                                                }
                                                <a asp-area="Provider" asp-controller="TourWaypoints" asp-action="Edit" asp-route-id="@Model.TourId" asp-route-waypointId="@w.Id"
                                                   class="btn btn-sm btn-light" aria-label="@Localizer["Provider.TourWaypoints.Edit", w.Name]"><i class="fa-solid fa-pen" aria-hidden="true"></i></a>
                                            </permission>
                                            <permission require="@WebPermission.TourWaypoint.Delete">
                                                <form asp-area="Provider" asp-controller="TourWaypoints" asp-action="Delete" asp-route-id="@Model.TourId" asp-route-waypointId="@w.Id" method="post" data-loading class="d-inline"
                                                      data-confirm="@Localizer["Provider.TourWaypoints.DeleteBody", w.Name]"
                                                      data-confirm-title="@Localizer["Provider.TourWaypoints.DeleteTitle"]"
                                                      data-confirm-action="@Localizer["Provider.TourWaypoints.DeleteConfirm"]"
                                                      data-confirm-cancel="@Localizer["Provider.TourWaypoints.Cancel"]">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-danger-soft" aria-label="@Localizer["Provider.TourWaypoints.Delete", w.Name]"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                                                </form>
                                            </permission>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    @* NF6: drag-handle reorder, optimistic with rollback toast; up/down forms = no-JS path (PE1). *@
    <script src="~/assets/js/provider-waypoints.js" asp-append-version="true"></script>
}
