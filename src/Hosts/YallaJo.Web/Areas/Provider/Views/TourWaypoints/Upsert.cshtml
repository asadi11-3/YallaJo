@model YallaJo.Web.Areas.Provider.Models.TourWaypoints.TourWaypointFormVm
@{
    ViewData["Title"] = Localizer[Model.IsEdit ? "Provider.TourWaypoints.EditTitle" : "Provider.TourWaypoints.CreateTitle"].Value;
    ViewData["ProviderNav"] = "Listings";
}

@await Component.InvokeAsync("ProviderSidebar")

<section class="pt-0">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9 col-xl-8 vstack gap-3">
                <a asp-area="Provider" asp-controller="TourWaypoints" asp-action="Index" asp-route-id="@Model.TourId"
                   class="btn btn-sm btn-secondary-soft align-self-start"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>@Localizer["Provider.TourWaypoints.BackToWaypoints"]</a>
                <div>
                    <h1 class="fs-4 mb-1"><i class="fa-solid fa-location-dot me-2" aria-hidden="true"></i>@Localizer[Model.IsEdit ? "Provider.TourWaypoints.EditHeading" : "Provider.TourWaypoints.CreateHeading"]</h1>
                    <p class="small text-body-secondary mb-0"><bdi dir="ltr">@Model.TourName</bdi></p>
                </div>

                <div class="card border shadow">
                    <div class="card-body">
                        @if (Model.IsEdit)
                        {
                            <form asp-area="Provider" asp-controller="TourWaypoints" asp-action="Edit"
                                  asp-route-id="@Model.TourId" asp-route-waypointId="@Model.WaypointId" method="post" data-loading class="vstack gap-2">
                                @Html.AntiForgeryToken()
                                <partial name="_Form" model="Model" />
                                <div class="d-flex gap-2 mt-3">
                                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>@Localizer["Provider.TourWaypoints.SaveChanges"]</button>
                                    <a asp-area="Provider" asp-controller="TourWaypoints" asp-action="Index" asp-route-id="@Model.TourId"
                                       class="btn btn-secondary-soft">@Localizer["Provider.TourWaypoints.Cancel"]</a>
                                </div>
                            </form>
                        }
                        else
                        {
                            <form asp-area="Provider" asp-controller="TourWaypoints" asp-action="Create"
                                  asp-route-id="@Model.TourId" method="post" data-loading class="vstack gap-2">
                                @Html.AntiForgeryToken()
                                <partial name="_Form" model="Model" />
                                <div class="d-flex gap-2 mt-3">
                                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>@Localizer["Provider.TourWaypoints.AddWaypoint"]</button>
                                    <a asp-area="Provider" asp-controller="TourWaypoints" asp-action="Index" asp-route-id="@Model.TourId"
                                       class="btn btn-secondary-soft">@Localizer["Provider.TourWaypoints.Cancel"]</a>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/yj-map.js" asp-append-version="true"></script>
}
