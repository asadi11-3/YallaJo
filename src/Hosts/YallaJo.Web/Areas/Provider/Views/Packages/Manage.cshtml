@model YallaJo.Web.Areas.Provider.Models.Packages.PackageManageVm
@{
    ViewData["Title"] = Localizer["Provider.Packages.ManageTitle", Model.Name].Value;
    ViewData["ProviderNav"] = "Listings";

}

@await Component.InvokeAsync("ProviderSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-sm-flex justify-content-between align-items-start">
            <div>
                <h1 class="fs-4 mb-1"><i class="fa-solid fa-box me-2" aria-hidden="true"></i><bdi>@Model.Name</bdi></h1>
                <span class="small text-body-secondary">
                    <bdi dir="ltr" class="font-data">@Model.PriceLabel</bdi>
                    @if (Model.MaxParticipants.HasValue)
                    {
                        <text> · @Localizer["Provider.Packages.MaxParticipants", Model.MaxParticipants.Value]</text>
                    }
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success bg-opacity-10 text-success ms-1"><i class="fa-solid fa-circle-check fa-fw" aria-hidden="true"></i> @Localizer["Provider.Packages.Active"]</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary bg-opacity-10 text-secondary ms-1"><i class="fa-solid fa-circle-minus fa-fw" aria-hidden="true"></i> @Localizer["Provider.Packages.Inactive"]</span>
                    }
                </span>
            </div>
            <div class="mt-2 mt-sm-0 d-flex gap-2">
                <a asp-action="Index" class="btn btn-sm btn-secondary-soft"><i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>@Localizer["Provider.Packages.AllPackages"]</a>
                <permission require="@WebPermission.Package.Update">
                    <form asp-action="Submit" asp-route-id="@Model.Id" method="post" data-loading class="d-inline"
                          data-confirm="@Localizer["Provider.Packages.SubmitBody", Model.Name]"
                          data-confirm-title="@Localizer["Provider.Packages.SubmitTitle"]"
                          data-confirm-action="@Localizer["Provider.Packages.SubmitConfirm"]"
                          data-confirm-cancel="@Localizer["Provider.Packages.Cancel"]">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-primary"><i class="fa-solid fa-paper-plane me-1" aria-hidden="true"></i>@Localizer["Provider.Packages.SubmitReview"]</button>
                    </form>
                </permission>
                <permission require="@WebPermission.Package.Delete">
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-loading class="d-inline"
                          data-confirm="@Localizer["Provider.Packages.DeleteBody", Model.Name]"
                          data-confirm-title="@Localizer["Provider.Packages.DeleteTitle"]"
                          data-confirm-action="@Localizer["Provider.Packages.DeleteConfirm"]"
                          data-confirm-cancel="@Localizer["Provider.Packages.Cancel"]">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash-can me-1" aria-hidden="true"></i>@Localizer["Provider.Packages.Delete"]</button>
                    </form>
                </permission>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="mb-0"><bdi>@Model.Description</bdi></p>
        }

        <div class="card shadow-sm">
            <div class="card-header border-bottom"><h2 class="card-header-title h5 mb-0">@Localizer["Provider.Packages.Cover.Heading"]</h2></div>
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    <div class="col-sm-5 col-md-4">
                        @if (Model.HasCoverImage)
                        {
                            <img src="@Model.CoverImageUrl" alt="" loading="lazy" decoding="async"
                                 class="img-fluid rounded w-100" style="aspect-ratio: 16 / 10; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center rounded bg-body-secondary text-body-secondary w-100"
                                 style="aspect-ratio: 16 / 10;" aria-hidden="true">
                                <i class="bi bi-box-seam fs-1"></i>
                            </div>
                        }
                    </div>
                    <div class="col-sm-7 col-md-8">
                        <p class="small text-body-secondary">@Localizer["Provider.Packages.Cover.Help"]</p>
                        <permission require="@WebPermission.Package.Update">
                            <form asp-action="UploadCover" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" data-loading>
                                @Html.AntiForgeryToken()
                                <div class="input-group">
                                    <input type="file" name="File" class="form-control"
                                           accept="@YallaJo.Web.Areas.Provider.Models.Packages.UploadCoverFormVm.AcceptAttribute"
                                           aria-label="@Localizer["Provider.Packages.Cover.Upload"]" required />
                                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-upload me-1" aria-hidden="true"></i>@Localizer["Provider.Packages.Cover.Upload"]</button>
                                </div>
                            </form>
                            @if (Model.HasCoverImage)
                            {
                                <form asp-action="RemoveCover" asp-route-id="@Model.Id" method="post" data-loading class="mt-2">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash-can me-1" aria-hidden="true"></i>@Localizer["Provider.Packages.Cover.Remove"]</button>
                                </form>
                            }
                        </permission>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header border-bottom"><h2 class="card-header-title h5 mb-0">@Localizer["Provider.Packages.IncludedToursHeading"]</h2></div>
                    <div class="card-body">
                        @if (Model.IncludedTours.Count == 0)
                        {
                            <p class="text-body-secondary mb-0">@Localizer["Provider.Packages.NoTours"]</p>
                        }
                        else
                        {
                            <ul class="list-group list-group-borderless mb-0">
                                @foreach (var t in Model.IncludedTours)
                                {
                                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                        <span>
                                            <span class="fw-semibold"><bdi>@t.Name</bdi></span>
                                            <span class="d-block small text-body-secondary"><bdi dir="ltr" class="font-data">@t.Slug</bdi></span>
                                        </span>
                                        <span class="small text-body-secondary"><bdi dir="ltr" class="font-data">@Money(t.BasePrice, t.Currency)</bdi></span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header border-bottom"><h2 class="card-header-title h5 mb-0">@Localizer["Provider.Packages.InclusionsHeading"]</h2></div>
                    <partial name="_Inclusions" model="Model" />
                </div>
            </div>
        </div>

        <p class="small text-body-secondary mb-0">
            <i class="fa-solid fa-circle-info me-1" aria-hidden="true"></i>@Localizer["Provider.Packages.ManageNote"]
        </p>
    </div>
</section>

@section Scripts {
    <script src="~/assets/js/provider-actions.js" asp-append-version="true"></script>
}

