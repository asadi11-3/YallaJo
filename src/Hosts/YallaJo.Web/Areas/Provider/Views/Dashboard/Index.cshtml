@using YallaJo.Web.Areas.Provider.Models.Dashboard
@model ProviderDashboardVm
@{
    ViewData["Title"] = "Provider dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">@Model.BusinessName</h2>
            <span class="text-muted">@Model.ProviderTypeLabel</span>
        </div>
        <span class="badge @Model.StatusBadgeClass fs-6">@Model.StatusLabel</span>
    </div>

    @* Success/Error flash banners are rendered globally by the shared _Alerts partial. *@

    @if (Model.IsSuspended)
    {
        <div class="alert alert-warning">
            Your provider account is currently <strong>suspended</strong>. Operational actions are unavailable.
            Please contact support if you believe this is a mistake.
        </div>
    }

    <div class="row g-3">
        <div class="col-lg-7">
            @* ── Overview card ─────────────────────────────────────────────── *@
            <div class="card mb-3">
                <div class="card-header"><strong>Overview</strong></div>
                <div class="card-body">
                    <div class="row text-center g-2">
                        <div class="col-6 col-md-3">
                            <div class="border rounded p-2">
                                <div class="fs-4 fw-semibold">@Model.TotalDocuments</div>
                                <div class="small text-muted">Documents</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="border rounded p-2">
                                <div class="fs-4 fw-semibold @(Model.ExpiredDocuments > 0 ? "text-danger" : "")">@Model.ExpiredDocuments</div>
                                <div class="small text-muted">Expired</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="border rounded p-2">
                                <div class="fs-4 fw-semibold @(Model.ExpiringIn30DaysDocuments > 0 ? "text-warning" : "")">@Model.ExpiringIn30DaysDocuments</div>
                                <div class="small text-muted">Expiring &le; 30d</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="border rounded p-2">
                                <div class="fs-4 fw-semibold">@Model.PendingActionsCount</div>
                                <div class="small text-muted">Pending actions</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* ── Pending actions ──────────────────────────────────────────── *@
            <div class="card mb-3">
                <div class="card-header"><strong>Pending actions</strong></div>
                <div class="card-body">
                    @if (!Model.HasPendingActions)
                    {
                        <p class="small text-muted mb-0">You're all caught up — no actions need your attention.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush mb-0">
                            @foreach (var action in Model.PendingActions)
                            {
                                <li class="list-group-item px-0">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <span class="badge @action.BadgeClass me-1">@action.TypeLabel</span>
                                            <span>@action.Description</span>
                                        </div>
                                        @if (action.Deadline.HasValue)
                                        {
                                            <span class="text-muted small text-nowrap ms-2">due @action.Deadline.Value.ToString("yyyy-MM-dd")</span>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            @* ── Notifications preview ────────────────────────────────────── *@
            <div class="card mb-3">
                <div class="card-header"><strong>Recent notifications</strong></div>
                <div class="card-body">
                    @if (!Model.HasNotifications)
                    {
                        <p class="small text-muted mb-0">No recent notifications.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush mb-0">
                            @foreach (var n in Model.Notifications)
                            {
                                <li class="list-group-item px-0">
                                    <div class="d-flex justify-content-between">
                                        <strong class="@(n.IsRead ? "text-muted" : "")">@n.Title</strong>
                                        <span class="text-muted small text-nowrap ms-2">@n.OccurredAt.ToString("yyyy-MM-dd")</span>
                                    </div>
                                    <div class="small text-muted">@n.Description</div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            @* ── Quick links (real, existing pages only) ──────────────────── *@
            <div class="card mb-3">
                <div class="card-header"><strong>Quick links</strong></div>
                <div class="card-body d-grid gap-2">
                    <a asp-area="Provider" asp-controller="Provider" asp-action="Status"
                       class="btn btn-outline-secondary">Application &amp; documents</a>
                    <a asp-area="Provider" asp-controller="Settings" asp-action="Index"
                       class="btn btn-outline-secondary">Business settings</a>
                </div>
            </div>
        </div>
    </div>
</div>
