@model YallaJo.Web.Areas.Provider.Models.Dashboard.DashboardVm
@{
    ViewData["Title"] = Localizer["Provider.Dashboard.Title"].Value;
    ViewData["ProviderNav"] = "Dashboard";

    var culture = CultureInfo.CurrentUICulture;
    string StatusLabel(string? s) => Localizer["Provider.Status." + (string.IsNullOrWhiteSpace(s) ? "Draft" : s)];
}

@await Component.InvokeAsync("ProviderSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-sm-flex justify-content-between align-items-center">
            <h1 class="fs-4 mb-0"><i class="fa-solid fa-house me-2" aria-hidden="true"></i>@Localizer["Provider.Dashboard.Heading"]</h1>
            <a asp-area="Provider" asp-controller="Tours" asp-action="Create" class="btn btn-sm btn-primary mt-2 mt-sm-0">
                <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>@Localizer["Provider.Dashboard.AddListing"]
            </a>
        </div>

        @if (Model.Overview is not null)
        {
            var overview = Model.Overview;
            <div class="card border">
                <div class="card-body d-sm-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="h5 mb-1"><bdi>@overview.BusinessName</bdi></h2>
                        @if (overview.IsApproved)
                        {
                            <span class="badge bg-success bg-opacity-10 text-success"><i class="fa-solid fa-circle-check fa-fw" aria-hidden="true"></i> @Localizer["Provider.Dashboard.Approved"]</span>
                        }
                        else
                        {
                            <span class="badge bg-warning bg-opacity-10 text-warning"><i class="fa-solid fa-clock fa-fw" aria-hidden="true"></i> @Localizer["Provider.Dashboard.PendingReview"]</span>
                        }
                        @if (overview.ReviewDeadline is not null)
                        {
                            <span class="small text-body-secondary ms-2">
                                <i class="fa-solid fa-clock me-1" aria-hidden="true"></i>@Localizer["Provider.Dashboard.ReviewBy", Date(overview.ReviewDeadline.Value)]
                            </span>
                        }
                    </div>
                    <div class="mt-2 mt-sm-0 text-sm-end">
                        <span class="small text-body-secondary d-block">@Localizer["Provider.Dashboard.DocumentsCount", Count(overview.TotalDocuments)]</span>
                        @if (overview.HasDocumentAlerts)
                        {
                            <span class="badge bg-danger bg-opacity-10 text-danger">
                                <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>@Localizer["Provider.Dashboard.DocAlerts", Count(overview.ExpiredDocuments), Count(overview.ExpiringIn30DaysDocuments)]
                            </span>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="row g-4">
            <div class="col-sm-6 col-xl-3">
                <partial name="_KpiCard" view-data="@(new ViewDataDictionary(ViewData) { ["icon"] = "fa-solid fa-map", ["color"] = "success", ["value"] = Count(Model.TotalListings), ["label"] = Localizer["Provider.Dashboard.TotalListings"].Value, ["cardClass"] = "h-100" })" />
            </div>
            <div class="col-sm-6 col-xl-3">
                @* [Backend] B4 — prefer the richer provider summary when available (ERR3 soft-degrade to legacy value). *@
                <partial name="_KpiCard" view-data="@(new ViewDataDictionary(ViewData) { ["icon"] = "fa-solid fa-arrow-trend-up", ["color"] = "info", ["value"] = Money(Model.EarningsKpis?.NetEarnings ?? Model.NetEarnings, Model.EarningsKpis?.Currency ?? Model.EarningsCurrency), ["label"] = Localizer["Provider.Dashboard.NetEarnings"].Value, ["cardClass"] = "h-100" })" />
            </div>
            <div class="col-sm-6 col-xl-3">
                <partial name="_KpiCard" view-data="@(new ViewDataDictionary(ViewData) { ["icon"] = "fa-solid fa-bookmark", ["color"] = "warning", ["value"] = Count(Model.PaymentCount), ["label"] = Localizer["Provider.Dashboard.PaidBookings"].Value, ["cardClass"] = "h-100" })" />
            </div>
            <div class="col-sm-6 col-xl-3">
                <partial name="_KpiCard" view-data="@(new ViewDataDictionary(ViewData) { ["icon"] = "fa-solid fa-users", ["color"] = "primary", ["value"] = Count(Model.PendingJoinRequests), ["label"] = Localizer["Provider.Dashboard.PendingJoinRequests"].Value, ["cardClass"] = "h-100" })" />
            </div>
        </div>

        @* [Backend] B4 — richer earnings KPIs; section renders only when the summary loaded (ERR3). *@
        @if (Model.EarningsKpis is not null)
        {
            var kpis = Model.EarningsKpis;
            <div class="row g-4">
                <div class="col-sm-6 col-xl-3">
                    <partial name="_KpiCard" view-data="@(new ViewDataDictionary(ViewData) { ["icon"] = "fa-solid fa-calendar-day", ["color"] = "primary", ["value"] = Money(kpis.ThisMonth, kpis.Currency), ["label"] = Localizer["Provider.Dashboard.ThisMonth"].Value, ["cardClass"] = "h-100" })" />
                </div>
                <div class="col-sm-6 col-xl-3">
                    <partial name="_KpiCard" view-data="@(new ViewDataDictionary(ViewData) { ["icon"] = "fa-solid fa-hourglass-half", ["color"] = "warning", ["value"] = Money(kpis.PendingPayout, kpis.Currency), ["label"] = Localizer["Provider.Dashboard.PendingPayout"].Value, ["cardClass"] = "h-100" })" />
                </div>
                <div class="col-sm-6 col-xl-3">
                    <partial name="_KpiCard" view-data="@(new ViewDataDictionary(ViewData) { ["icon"] = "fa-solid fa-money-bill-wave", ["color"] = "success", ["value"] = Money(kpis.GrossTotal, kpis.Currency), ["label"] = Localizer["Provider.Dashboard.GrossTotal"].Value, ["cardClass"] = "h-100" })" />
                </div>
                <div class="col-sm-6 col-xl-3">
                    <partial name="_KpiCard" view-data="@(new ViewDataDictionary(ViewData) { ["icon"] = "fa-solid fa-percent", ["color"] = "secondary", ["value"] = Money(kpis.TotalCommission, kpis.Currency), ["label"] = Localizer["Provider.Dashboard.TotalCommission"].Value, ["cardClass"] = "h-100" })" />
                </div>
            </div>
        }

        @* [Backend] B5 — bookings-by-status donut (ApexCharts allowed on dashboards, X14). SSR list = no-JS path (PE1). *@
        @if (Model.BookingStats is not null && Model.BookingStats.Total > 0)
        {
            var stats = Model.BookingStats;
            <div class="card border">
                <div class="card-header border-bottom">
                    <h2 class="card-header-title h5 mb-0"><i class="fa-solid fa-chart-pie me-2" aria-hidden="true"></i>@Localizer["Provider.Dashboard.BookingsByStatus"]</h2>
                </div>
                <div class="card-body row g-4 align-items-center">
                    <div class="col-md-6">
                        <div data-yj-component="bookings-donut"
                             data-labels='["@Localizer["Provider.Status.Pending"]","@Localizer["Provider.Status.Confirmed"]","@Localizer["Provider.Status.Completed"]","@Localizer["Provider.Status.Cancelled"]","@Localizer["Provider.Status.Rejected"]"]'
                             data-values="[@stats.Pending,@stats.Confirmed,@stats.Completed,@stats.Cancelled,@stats.Rejected]"
                             aria-hidden="true"></div>
                    </div>
                    <div class="col-md-6">
                        <ul class="list-group list-group-borderless mb-0">
                            <li class="list-group-item px-0 d-flex justify-content-between"><span><i class="fa-solid fa-clock text-warning me-2" aria-hidden="true"></i>@Localizer["Provider.Status.Pending"]</span><bdi dir="ltr" class="font-data">@Count(stats.Pending)</bdi></li>
                            <li class="list-group-item px-0 d-flex justify-content-between"><span><i class="fa-solid fa-circle-check text-success me-2" aria-hidden="true"></i>@Localizer["Provider.Status.Confirmed"]</span><bdi dir="ltr" class="font-data">@Count(stats.Confirmed)</bdi></li>
                            <li class="list-group-item px-0 d-flex justify-content-between"><span><i class="fa-solid fa-flag-checkered text-primary me-2" aria-hidden="true"></i>@Localizer["Provider.Status.Completed"]</span><bdi dir="ltr" class="font-data">@Count(stats.Completed)</bdi></li>
                            <li class="list-group-item px-0 d-flex justify-content-between"><span><i class="fa-solid fa-ban text-secondary me-2" aria-hidden="true"></i>@Localizer["Provider.Status.Cancelled"]</span><bdi dir="ltr" class="font-data">@Count(stats.Cancelled)</bdi></li>
                            <li class="list-group-item px-0 d-flex justify-content-between"><span><i class="fa-solid fa-circle-xmark text-danger me-2" aria-hidden="true"></i>@Localizer["Provider.Status.Rejected"]</span><bdi dir="ltr" class="font-data">@Count(stats.Rejected)</bdi></li>
                            <li class="list-group-item px-0 d-flex justify-content-between fw-semibold"><span>@Localizer["Provider.Dashboard.TotalBookings"]</span><bdi dir="ltr" class="font-data">@Count(stats.Total)</bdi></li>
                        </ul>
                    </div>
                </div>
            </div>
        }

        @if (Model.HasActivity)
        {
            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="card border h-100">
                        <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                            <h2 class="card-header-title h5 mb-0">@Localizer["Provider.Dashboard.RecentListings"]</h2>
                            <a asp-area="Provider" asp-controller="Tours" asp-action="Index" class="btn btn-sm btn-primary-soft">@Localizer["Provider.Dashboard.ViewAll"]</a>
                        </div>
                        <div class="card-body">
                            @if (Model.RecentListings.Count == 0)
                            {
                                <p class="text-body-secondary small mb-0">@Localizer["Provider.Dashboard.NoListings"]</p>
                            }
                            else
                            {
                                <ul class="list-group list-group-borderless">
                                    @foreach (var listing in Model.RecentListings)
                                    {
                                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                            <div>
                                                <p class="fw-semibold mb-0"><bdi>@listing.Name</bdi></p>
                                                <span class="small text-body-secondary"><bdi dir="ltr">@Money(listing.BasePrice, listing.Currency)</bdi> · <bdi dir="ltr">@Date(listing.CreatedAt)</bdi></span>
                                            </div>
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary">@StatusLabel(listing.Status)</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card border h-100">
                        <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                            <h2 class="card-header-title h5 mb-0">@Localizer["Provider.Dashboard.RecentJoinRequests"]</h2>
                            <a asp-area="Provider" asp-controller="Bookings" asp-action="Index" class="btn btn-sm btn-primary-soft">@Localizer["Provider.Dashboard.ViewAll"]</a>
                        </div>
                        <div class="card-body">
                            @if (Model.RecentJoinRequests.Count == 0)
                            {
                                <p class="text-body-secondary small mb-0">@Localizer["Provider.Dashboard.NoJoinRequests"]</p>
                            }
                            else
                            {
                                <ul class="list-group list-group-borderless">
                                    @foreach (var jr in Model.RecentJoinRequests)
                                    {
                                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                            <div>
                                                <p class="fw-semibold mb-0">@Localizer["Provider.Dashboard.Participants", Count(jr.ParticipantCount)]</p>
                                                <span class="small text-body-secondary"><bdi dir="ltr">@Date(jr.CreatedAt)</bdi>@(string.IsNullOrWhiteSpace(jr.Message) ? "" : " · " + jr.Message)</span>
                                            </div>
                                            @if (jr.IsPending)
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning"><i class="fa-solid fa-clock fa-fw" aria-hidden="true"></i> @StatusLabel(jr.Status)</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary">@StatusLabel(jr.Status)</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card border">
                <div class="card-body">
                    <partial name="_ProviderEmptyState" view-data="@(new ViewDataDictionary(ViewData) { ["title"] = Localizer["Provider.Dashboard.EmptyTitle"].Value, ["message"] = Localizer["Provider.Dashboard.EmptyMsg"].Value, ["ctaText"] = Localizer["Provider.Dashboard.AddListing"].Value, ["ctaUrl"] = Url.Action("Create", "Tours", new { area = "Provider" }) })" />
                </div>
            </div>
        }

        @if (Model.PendingActions.Count > 0 || Model.Notifications.Count > 0)
        {
            <div class="row g-4">
                @if (Model.PendingActions.Count > 0)
                {
                    <div class="col-lg-6">
                        <div class="card border h-100">
                            <div class="card-header border-bottom">
                                <h2 class="card-header-title h5 mb-0"><i class="fa-solid fa-list-check me-2" aria-hidden="true"></i>@Localizer["Provider.Dashboard.PendingActions"]</h2>
                            </div>
                            <div class="card-body">
                                <ul class="list-group list-group-borderless">
                                    @foreach (var action in Model.PendingActions)
                                    {
                                        <li class="list-group-item px-0">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <p class="fw-semibold mb-0">@action.ActionType</p>
                                                    <span class="small text-body-secondary">@action.Description</span>
                                                </div>
                                                @if (action.Deadline is not null)
                                                {
                                                    <span class="badge bg-warning bg-opacity-10 text-warning ms-2"><bdi dir="ltr">@action.Deadline.Value.ToString("d MMM", culture)</bdi></span>
                                                }
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }
                @if (Model.Notifications.Count > 0)
                {
                    <div class="col-lg-6">
                        <div class="card border h-100">
                            <div class="card-header border-bottom">
                                <h2 class="card-header-title h5 mb-0"><i class="fa-solid fa-bell me-2" aria-hidden="true"></i>@Localizer["Provider.Dashboard.Notifications"]</h2>
                            </div>
                            <div class="card-body">
                                <ul class="list-group list-group-borderless">
                                    @foreach (var note in Model.Notifications)
                                    {
                                        <li class="list-group-item px-0 @(note.IsRead ? "text-body-secondary" : "")">
                                            <p class="mb-0 @(note.IsRead ? "fw-normal" : "fw-semibold")">@note.Title</p>
                                            <span class="small text-body-secondary">@note.Description · <bdi dir="ltr">@note.OccurredAt.ToString("d MMM yyyy HH:mm", culture)</bdi></span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@section Scripts {
    @* X14: ApexCharts is allowed on dashboards; vendored bundle only (no CDN). *@
    <script src="~/assets/vendor/apexcharts/js/apexcharts.min.js" asp-append-version="true"></script>
    <script src="~/assets/js/provider-dashboard.js" asp-append-version="true"></script>
}
