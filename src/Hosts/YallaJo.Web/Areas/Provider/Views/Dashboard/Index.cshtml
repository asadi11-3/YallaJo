@model YallaJo.Web.Areas.Provider.Models.Dashboard.DashboardVm
@{
    ViewData["Title"] = Localizer["Provider.Dashboard.Title"].Value;
    ViewData["ProviderNav"] = "Dashboard";

    var culture = CultureInfo.CurrentUICulture;
    string Money(decimal amount, string? currency) =>
        amount.ToString("N0", culture) + (string.IsNullOrWhiteSpace(currency) ? "" : " " + currency);
    string Count(int n) => n.ToString("N0", culture);
    string Date(DateTime dt) => dt.ToString("d MMM yyyy", culture);
    string StatusLabel(string? s) => Localizer["Provider.Status." + (string.IsNullOrWhiteSpace(s) ? "Draft" : s)];
}

@await Component.InvokeAsync("ProviderSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-sm-flex justify-content-between align-items-center">
            <h1 class="fs-4 mb-0"><i class="fa-solid fa-house me-2" aria-hidden="true"></i>@Localizer["Provider.Dashboard.Heading"]</h1>
            <a asp-area="Provider" asp-controller="Tours" asp-action="Create" class="btn btn-sm btn-primary mt-2 mt-sm-0">
                <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>@Localizer["Provider.Dashboard.AddListing"]
            </a>
        </div>

        @if (Model.Overview is not null)
        {
            var overview = Model.Overview;
            <div class="card border">
                <div class="card-body d-sm-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="h5 mb-1"><bdi>@overview.BusinessName</bdi></h2>
                        @if (overview.IsApproved)
                        {
                            <span class="badge bg-success bg-opacity-10 text-success"><i class="fa-solid fa-circle-check fa-fw" aria-hidden="true"></i> @Localizer["Provider.Dashboard.Approved"]</span>
                        }
                        else
                        {
                            <span class="badge bg-warning bg-opacity-10 text-warning"><i class="fa-solid fa-clock fa-fw" aria-hidden="true"></i> @Localizer["Provider.Dashboard.PendingReview"]</span>
                        }
                        @if (overview.ReviewDeadline is not null)
                        {
                            <span class="small text-body-secondary ms-2">
                                <i class="fa-solid fa-clock me-1" aria-hidden="true"></i>@Localizer["Provider.Dashboard.ReviewBy", Date(overview.ReviewDeadline.Value)]
                            </span>
                        }
                    </div>
                    <div class="mt-2 mt-sm-0 text-sm-end">
                        <span class="small text-body-secondary d-block">@Localizer["Provider.Dashboard.DocumentsCount", Count(overview.TotalDocuments)]</span>
                        @if (overview.HasDocumentAlerts)
                        {
                            <span class="badge bg-danger bg-opacity-10 text-danger">
                                <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>@Localizer["Provider.Dashboard.DocAlerts", Count(overview.ExpiredDocuments), Count(overview.ExpiringIn30DaysDocuments)]
                            </span>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="row g-4">
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <div class="d-flex align-items-center">
                        <div class="icon-xl bg-success bg-opacity-10 rounded-3 text-success">
                            <i class="fa-solid fa-map fs-5" aria-hidden="true"></i>
                        </div>
                        <div class="ms-3">
                            <p class="h4 font-data mb-0"><bdi dir="ltr">@Count(Model.TotalListings)</bdi></p>
                            <span class="small text-body-secondary">@Localizer["Provider.Dashboard.TotalListings"]</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <div class="d-flex align-items-center">
                        <div class="icon-xl bg-info bg-opacity-10 rounded-3 text-info">
                            <i class="fa-solid fa-arrow-trend-up fs-5" aria-hidden="true"></i>
                        </div>
                        <div class="ms-3">
                            <p class="h4 font-data mb-0"><bdi dir="ltr">@Money(Model.NetEarnings, Model.EarningsCurrency)</bdi></p>
                            <span class="small text-body-secondary">@Localizer["Provider.Dashboard.NetEarnings"]</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <div class="d-flex align-items-center">
                        <div class="icon-xl bg-warning bg-opacity-10 rounded-3 text-warning">
                            <i class="fa-solid fa-bookmark fs-5" aria-hidden="true"></i>
                        </div>
                        <div class="ms-3">
                            <p class="h4 font-data mb-0"><bdi dir="ltr">@Count(Model.PaymentCount)</bdi></p>
                            <span class="small text-body-secondary">@Localizer["Provider.Dashboard.PaidBookings"]</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <div class="d-flex align-items-center">
                        <div class="icon-xl bg-primary bg-opacity-10 rounded-3 text-primary">
                            <i class="fa-solid fa-users fs-5" aria-hidden="true"></i>
                        </div>
                        <div class="ms-3">
                            <p class="h4 font-data mb-0"><bdi dir="ltr">@Count(Model.PendingJoinRequests)</bdi></p>
                            <span class="small text-body-secondary">@Localizer["Provider.Dashboard.PendingJoinRequests"]</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.HasActivity)
        {
            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="card border h-100">
                        <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                            <h2 class="card-header-title h5 mb-0">@Localizer["Provider.Dashboard.RecentListings"]</h2>
                            <a asp-area="Provider" asp-controller="Tours" asp-action="Index" class="btn btn-sm btn-primary-soft">@Localizer["Provider.Dashboard.ViewAll"]</a>
                        </div>
                        <div class="card-body">
                            @if (Model.RecentListings.Count == 0)
                            {
                                <p class="text-body-secondary small mb-0">@Localizer["Provider.Dashboard.NoListings"]</p>
                            }
                            else
                            {
                                <ul class="list-group list-group-borderless">
                                    @foreach (var listing in Model.RecentListings)
                                    {
                                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                            <div>
                                                <p class="fw-semibold mb-0"><bdi>@listing.Name</bdi></p>
                                                <span class="small text-body-secondary"><bdi dir="ltr">@Money(listing.BasePrice, listing.Currency)</bdi> · <bdi dir="ltr">@Date(listing.CreatedAt)</bdi></span>
                                            </div>
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary">@StatusLabel(listing.Status)</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card border h-100">
                        <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                            <h2 class="card-header-title h5 mb-0">@Localizer["Provider.Dashboard.RecentJoinRequests"]</h2>
                            <a asp-area="Provider" asp-controller="Bookings" asp-action="Index" class="btn btn-sm btn-primary-soft">@Localizer["Provider.Dashboard.ViewAll"]</a>
                        </div>
                        <div class="card-body">
                            @if (Model.RecentJoinRequests.Count == 0)
                            {
                                <p class="text-body-secondary small mb-0">@Localizer["Provider.Dashboard.NoJoinRequests"]</p>
                            }
                            else
                            {
                                <ul class="list-group list-group-borderless">
                                    @foreach (var jr in Model.RecentJoinRequests)
                                    {
                                        <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                            <div>
                                                <p class="fw-semibold mb-0">@Localizer["Provider.Dashboard.Participants", Count(jr.ParticipantCount)]</p>
                                                <span class="small text-body-secondary"><bdi dir="ltr">@Date(jr.CreatedAt)</bdi>@(string.IsNullOrWhiteSpace(jr.Message) ? "" : " · " + jr.Message)</span>
                                            </div>
                                            @if (jr.IsPending)
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning"><i class="fa-solid fa-clock fa-fw" aria-hidden="true"></i> @StatusLabel(jr.Status)</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary">@StatusLabel(jr.Status)</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card border">
                <div class="card-body text-center py-5">
                    <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
                    <h2 class="h5">@Localizer["Provider.Dashboard.EmptyTitle"]</h2>
                    <p class="text-body-secondary mb-3">@Localizer["Provider.Dashboard.EmptyMsg"]</p>
                    <a asp-area="Provider" asp-controller="Tours" asp-action="Create" class="btn btn-primary">
                        <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>@Localizer["Provider.Dashboard.AddListing"]
                    </a>
                </div>
            </div>
        }

        @if (Model.PendingActions.Count > 0 || Model.Notifications.Count > 0)
        {
            <div class="row g-4">
                @if (Model.PendingActions.Count > 0)
                {
                    <div class="col-lg-6">
                        <div class="card border h-100">
                            <div class="card-header border-bottom">
                                <h2 class="card-header-title h5 mb-0"><i class="fa-solid fa-list-check me-2" aria-hidden="true"></i>@Localizer["Provider.Dashboard.PendingActions"]</h2>
                            </div>
                            <div class="card-body">
                                <ul class="list-group list-group-borderless">
                                    @foreach (var action in Model.PendingActions)
                                    {
                                        <li class="list-group-item px-0">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <p class="fw-semibold mb-0">@action.ActionType</p>
                                                    <span class="small text-body-secondary">@action.Description</span>
                                                </div>
                                                @if (action.Deadline is not null)
                                                {
                                                    <span class="badge bg-warning bg-opacity-10 text-warning ms-2"><bdi dir="ltr">@action.Deadline.Value.ToString("d MMM", culture)</bdi></span>
                                                }
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }
                @if (Model.Notifications.Count > 0)
                {
                    <div class="col-lg-6">
                        <div class="card border h-100">
                            <div class="card-header border-bottom">
                                <h2 class="card-header-title h5 mb-0"><i class="fa-solid fa-bell me-2" aria-hidden="true"></i>@Localizer["Provider.Dashboard.Notifications"]</h2>
                            </div>
                            <div class="card-body">
                                <ul class="list-group list-group-borderless">
                                    @foreach (var note in Model.Notifications)
                                    {
                                        <li class="list-group-item px-0 @(note.IsRead ? "text-body-secondary" : "")">
                                            <p class="mb-0 @(note.IsRead ? "fw-normal" : "fw-semibold")">@note.Title</p>
                                            <span class="small text-body-secondary">@note.Description · <bdi dir="ltr">@note.OccurredAt.ToString("d MMM yyyy HH:mm", culture)</bdi></span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
