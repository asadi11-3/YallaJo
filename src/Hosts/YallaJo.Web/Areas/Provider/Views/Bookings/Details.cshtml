@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Provider.Models.Bookings
@model ProviderBookingDetailsVm
@{
    ViewData["Title"] = "Booking details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string Money(decimal amount) => $"{amount.ToString("0.##")} {Model.Currency}";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">Booking <code>@Model.Reference</code></h2>
            <span class="badge @Model.StatusBadgeClass">@Model.Status</span>
        </div>
        <a asp-area="Provider" asp-controller="Bookings" asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to bookings</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border mb-3">
                <div class="card-header"><strong>Overview</strong></div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Tour</dt>
                        <dd class="col-sm-8">@Model.TourName</dd>

                        <dt class="col-sm-4">Traveler</dt>
                        <dd class="col-sm-8">@Model.TravelerHandle</dd>

                        <dt class="col-sm-4">Guests</dt>
                        <dd class="col-sm-8">@Model.ParticipantCount</dd>

                        <dt class="col-sm-4">Instant booking</dt>
                        <dd class="col-sm-8">@(Model.IsInstantBooking ? "Yes" : "No")</dd>

                        <dt class="col-sm-4">Created</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                        <dt class="col-sm-4">Special requests</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.SpecialRequests) ? "—" : Model.SpecialRequests)</dd>
                    </dl>
                </div>
            </div>

            <div class="card border">
                <div class="card-header"><strong>Pricing</strong></div>
                <div class="card-body">
                    @if (Model.LineItems.Count > 0)
                    {
                        <table class="table table-sm mb-3">
                            <thead><tr><th>Tier</th><th class="text-end">Qty</th><th class="text-end">Unit</th></tr></thead>
                            <tbody>
                                @foreach (var li in Model.LineItems)
                                {
                                    <tr>
                                        <td>@li.TierType</td>
                                        <td class="text-end">@li.Count</td>
                                        <td class="text-end">@li.UnitPrice.ToString("0.##") @li.Currency</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    <div class="d-flex justify-content-between"><span>Subtotal</span><span>@Money(Model.Subtotal)</span></div>
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between text-success"><span>Discount</span><span>-@Money(Model.DiscountAmount)</span></div>
                    }
                    <hr class="my-2" />
                    <div class="d-flex justify-content-between fw-bold"><span>Total</span><span>@Money(Model.TotalAmount)</span></div>

                    @if (Model.IsCancelled)
                    {
                        <div class="alert alert-secondary mt-3 mb-0">
                            <strong>Cancelled.</strong>
                            @if (!string.IsNullOrWhiteSpace(Model.CancellationReason)) { <span>Reason: @Model.CancellationReason</span> }
                            @if (Model.RefundAmount is { } r) { <span class="d-block">Refund: @Money(r)</span> }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border">
                <div class="card-header"><strong>Actions</strong></div>
                <div class="card-body d-grid gap-3">
                    @if (!Model.HasAnyAction)
                    {
                        <p class="text-muted mb-0">No actions are available for a booking in <strong>@Model.Status</strong> status.</p>
                    }

                    @if (Model.CanConfirm)
                    {
                        <permission require="@WebPermission.TourBooking.Confirm">
                            <form asp-area="Provider" asp-controller="Bookings" asp-action="Confirm" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success w-100">Confirm booking</button>
                            </form>
                        </permission>
                    }

                    @if (Model.CanCancel)
                    {
                        <permission require="@WebPermission.TourBooking.Cancel">
                            <form asp-area="Provider" asp-controller="Bookings" asp-action="Cancel" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <label class="form-label small mb-1">Cancellation reason</label>
                                <textarea name="Reason" class="form-control mb-2" rows="2" minlength="10" maxlength="500"
                                          placeholder="Reason (min 10 characters). Cancelling refunds the traveler in full." required></textarea>
                                <button type="submit" class="btn btn-outline-danger w-100">Cancel booking</button>
                            </form>
                        </permission>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
