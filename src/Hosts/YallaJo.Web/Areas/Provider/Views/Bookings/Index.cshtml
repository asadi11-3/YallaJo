@using YallaJo.Web.Areas.Provider.Models.Bookings
@model BookingsVm
@{
    ViewData["Title"] = Localizer["Provider.Bookings.Title"].Value;
    ViewData["ProviderNav"] = "Bookings";
}

@await Component.InvokeAsync("ProviderSidebar")

<section class="pt-0">
    <div class="container">
        @* Swappable AJAX region (PE1: full PRG without JS — provider-actions.js enhances) *@
        <partial name="_BookingsContent" model="Model" />
    </div>
</section>

@section Scripts {
    <script src="~/assets/js/provider-actions.js" asp-append-version="true"></script>
}
