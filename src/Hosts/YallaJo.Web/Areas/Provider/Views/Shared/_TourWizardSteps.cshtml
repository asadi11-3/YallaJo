@model YallaJo.Web.Areas.Provider.Models.Tours.TourWizardStepsVm
@{
    var steps = YallaJo.Web.Areas.Provider.Models.Tours.TourWizardStepsVm.Steps;
}

<nav aria-label="Listing setup progress" class="card border">
    <ol class="list-unstyled d-flex flex-wrap align-items-center gap-1 gap-md-2 mb-0 p-3">
        @foreach (var s in steps)
        {
            var state = s.Number < Model.CurrentStep ? "done"
                : s.Number == Model.CurrentStep ? "active" : "upcoming";
            var badgeCss = state switch
            {
                "done" => "text-bg-success",
                "active" => "text-bg-primary",
                _ => "text-bg-light border",
            };
            <li class="d-flex align-items-center" aria-current="@(state == "active" ? "step" : null)">
                <a class="text-decoration-none d-flex align-items-center"
                   asp-area="Provider" asp-controller="@s.Controller" asp-action="@s.Action" asp-route-id="@Model.TourId"
                   aria-label="Step @s.Number: @s.Label@(state == "done" ? " (done)" : "")">
                    <span class="badge rounded-pill @badgeCss me-1">
                        @if (state == "done")
                        {
                            <i class="bi bi-check-lg" aria-hidden="true"></i>
                        }
                        else
                        {
                            @s.Number
                        }
                    </span>
                    <span class="small @(state == "active" ? "fw-semibold" : "text-body-secondary")">
                        <i class="bi @s.Icon me-1" aria-hidden="true"></i>@s.Label
                    </span>
                </a>
                @if (s.Number < steps.Count)
                {
                    <i class="bi bi-chevron-right text-body-secondary mx-1 mx-md-2 d-none d-sm-inline" aria-hidden="true"></i>
                }
            </li>
        }
    </ol>
</nav>
