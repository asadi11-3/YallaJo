@using YallaJo.Web.Areas.Provider.Models
@model ProviderStatusVm
@{
    ViewData["Title"] = Localizer["Provider.Documents.Title"].Value;
    ViewData["ProviderNav"] = "Documents";
}

@await Component.InvokeAsync("ProviderSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">
        <h1 class="fs-4 mb-0"><i class="fa-solid fa-file-lines me-2" aria-hidden="true"></i>@Localizer["Provider.Documents.Heading"]</h1>

        @if (!Model.HasApplication)
        {
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <p class="mb-3">@Localizer["Provider.Onboarding.NotAppliedMsg"]</p>
                    <a asp-controller="Provider" asp-action="Apply" class="btn btn-primary"><i class="fa-solid fa-building-circle-arrow-right me-1" aria-hidden="true"></i>@Localizer["Provider.Onboarding.BecomeProvider"]</a>
                </div>
            </div>
        }
        else
        {
            <partial name="_DocumentsManager" model="Model" />
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/provider-actions.js" asp-append-version="true"></script>
}
