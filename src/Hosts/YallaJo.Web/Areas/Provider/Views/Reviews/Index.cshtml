@using YallaJo.Web.Areas.Provider.Models.Reviews
@model YallaJo.Web.Areas.Provider.Models.Reviews.ReviewsVm
@{
    ViewData["Title"] = Localizer["Provider.Reviews.Title"].Value;
    ViewData["ProviderNav"] = "Reviews";
}

@await Component.InvokeAsync("ProviderSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">
        <h1 class="fs-4 mb-0"><i class="fa-solid fa-star me-2" aria-hidden="true"></i>@Localizer["Provider.Reviews.Heading"]</h1>

        @if (!Model.HasTours)
        {
            <div class="card card-body border">
                <partial name="_ProviderEmptyState" view-data="@(new ViewDataDictionary(ViewData) { ["title"] = Localizer["Provider.Reviews.NoListingsTitle"].Value, ["message"] = Localizer["Provider.Reviews.NoListingsMsg"].Value, ["ctaText"] = Localizer["Provider.Reviews.AddListing"].Value, ["ctaUrl"] = Url.Action("Create", "Tours", new { area = "Provider" }) })" />
            </div>
        }
        else
        {
            <div class="card border">
                <div class="card-body">
                    <form method="get" asp-area="Provider" asp-controller="Reviews" asp-action="Index" class="row g-2 align-items-end">
                        <div class="col-sm-8 col-lg-6">
                            <label class="form-label small mb-1" for="review-tour">@Localizer["Provider.Reviews.ChooseListing"]</label>
                            <select id="review-tour" name="tourId" class="form-select">
                                @* [Backend] B6: options carry batch-fetched rating + count; degrades to plain names (ERR3). *@
                                @foreach (var t in Model.Tours)
                                {
                                    var suffix = t.ReviewCount is not null
                                        ? $" — {t.AverageRating:0.0} ★ ({t.ReviewCount})"
                                        : string.Empty;
                                    if (t.Id == Model.SelectedTourId)
                                    {
                                        <option value="@t.Id" selected>@t.Name@suffix</option>
                                    }
                                    else
                                    {
                                        <option value="@t.Id">@t.Name@suffix</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-filter me-1" aria-hidden="true"></i>@Localizer["Provider.Reviews.View"]</button>
                        </div>
                    </form>
                </div>
            </div>

            @* Swappable AJAX region (PE1): provider-actions.js replaces this fragment after reply/report writes. *@
            <partial name="_ReviewsResults" model="Model" />
        }
    </div>
</section>

@section Scripts {
    <script src="~/assets/js/provider-actions.js" asp-append-version="true"></script>
}
