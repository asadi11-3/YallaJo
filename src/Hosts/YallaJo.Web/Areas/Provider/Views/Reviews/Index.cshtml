@model YallaJo.Web.Areas.Provider.Models.Reviews.ReviewsVm
@using YallaJo.Web.Areas.Provider.Models.Reviews
@using YallaJo.Web.Areas.Provider.Shared
@{
    ViewData["Title"] = "Reviews";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as ProviderSidebarVm ?? new ProviderSidebarVm();

    string Stars(decimal rating)
    {
        var full = (int)Math.Round(rating, MidpointRounding.AwayFromZero);
        if (full < 0) full = 0;
        if (full > 5) full = 5;
        return string.Concat(Enumerable.Repeat("\u2605", full)) + string.Concat(Enumerable.Repeat("\u2606", 5 - full));
    }
}

<partial name="_ProviderSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <h1 class="fs-4 mb-0"><i class="bi bi-star me-2"></i>Reviews</h1>
        </div>

        @if (!Model.HasTours)
        {
            <div class="card card-body border text-center py-5">
                <img src="~/assets/images/element/17.svg" class="h-100px mx-auto mb-3" alt="" />
                <h5 class="mb-1">No listings yet</h5>
                <p class="text-muted mb-3">Publish a tour to start collecting reviews from your guests.</p>
                <div><a class="btn btn-primary" asp-area="Provider" asp-controller="Listings" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Add New Listing</a></div>
            </div>
        }
        else
        {
            <div class="card border">
                <div class="card-body">
                    <form method="get" asp-area="Provider" asp-controller="Reviews" asp-action="Index" class="row g-2 align-items-end">
                        <div class="col-sm-8 col-lg-6">
                            <label class="form-label small mb-1">Choose a listing</label>
                            <select name="tourId" class="form-select" onchange="this.form.submit()">
                                @foreach (var t in Model.Tours)
                                {
                                    if (t.Id == Model.SelectedTourId)
                                    {
                                        <option value="@t.Id" selected>@t.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@t.Id">@t.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-auto">
                            <noscript><button type="submit" class="btn btn-primary">View</button></noscript>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card border">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="display-6 fw-bold mb-0">@Model.AverageRating.ToString("0.0")</div>
                    <div>
                        <div class="text-warning fs-5">@Stars(Model.AverageRating)</div>
                        <span class="text-muted small">@Model.ReviewCount review@(Model.ReviewCount == 1 ? "" : "s") for <strong>@Model.SelectedTourName</strong></span>
                    </div>
                </div>
            </div>

            @if (!Model.HasReviews)
            {
                <div class="card card-body border text-center py-5">
                    <img src="~/assets/images/element/17.svg" class="h-100px mx-auto mb-3" alt="" />
                    <h6 class="mb-1">No reviews yet for this listing</h6>
                    <p class="text-muted mb-0">Reviews appear here once guests complete and rate their tour.</p>
                </div>
            }
            else
            {
                <div class="vstack gap-3">
                    @foreach (var r in Model.Reviews)
                    {
                        <div class="card border">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div>
                                        <span class="text-warning">@Stars(r.Rating)</span>
                                        @if (!string.IsNullOrWhiteSpace(r.Title))
                                        {
                                            <span class="fw-semibold ms-2">@r.Title</span>
                                        }
                                        @if (r.IsVerifiedBooking)
                                        {
                                            <span class="badge text-bg-success ms-2"><i class="bi bi-patch-check me-1"></i>Verified booking</span>
                                        }
                                    </div>
                                    <span class="text-muted small">@r.CreatedAt.ToString("d MMM yyyy")</span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(r.Content))
                                {
                                    <p class="mt-2 mb-2">@r.Content</p>
                                }

                                @if (r.HasReply)
                                {
                                    <div class="bg-light rounded p-3 mt-2">
                                        <div class="small fw-semibold mb-1"><i class="bi bi-reply-fill me-1"></i>Your reply</div>
                                        <div class="small mb-0">@r.ReplyContent</div>
                                    </div>
                                }

                                <div class="d-flex gap-3 mt-2">
                                    @if (!r.HasReply)
                                    {
                                        <a class="small text-primary" data-bs-toggle="collapse" href="#reply-@r.Id" role="button"><i class="bi bi-reply me-1"></i>Reply</a>
                                    }
                                    <a class="small text-danger" data-bs-toggle="collapse" href="#report-@r.Id" role="button"><i class="bi bi-flag me-1"></i>Report</a>
                                </div>

                                @if (!r.HasReply)
                                {
                                    <div class="collapse mt-3" id="reply-@r.Id">
                                        <form method="post" asp-area="Provider" asp-controller="Reviews" asp-action="Reply" asp-route-id="@r.Id" asp-route-tourId="@Model.SelectedTourId">
                                            @Html.AntiForgeryToken()
                                            <textarea name="content" class="form-control mb-2" rows="3" maxlength="2000" placeholder="Write a public reply to this review..." required></textarea>
                                            <button type="submit" class="btn btn-sm btn-primary">Post reply</button>
                                        </form>
                                    </div>
                                }

                                <div class="collapse mt-3" id="report-@r.Id">
                                    <form method="post" asp-area="Provider" asp-controller="Reviews" asp-action="Report" asp-route-id="@r.Id" asp-route-tourId="@Model.SelectedTourId">
                                        @Html.AntiForgeryToken()
                                        <div class="row g-2">
                                            <div class="col-sm-5">
                                                <select name="reason" class="form-select form-select-sm">
                                                    @foreach (var reason in ReviewsVm.ReportReasons)
                                                    {
                                                        <option value="@reason">@reason</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-sm-7">
                                                <input name="description" class="form-control form-control-sm" maxlength="500" placeholder="Add details (optional)" />
                                            </div>
                                        </div>
                                        <button type="submit" class="btn btn-sm btn-danger-soft mt-2">Submit report</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</section>
