@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Provider.Shared
@model YallaJo.Web.Areas.Provider.Models.TourGuides.TourGuidesIndexVm
@{
    ViewData["Title"] = $"Guides — {Model.TourName}";
    ViewData["ProviderNav"] = "Listings";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as ProviderSidebarVm ?? new ProviderSidebarVm();
}

<partial name="_ProviderSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-sm-flex justify-content-between align-items-center">
            <div>
                <h1 class="fs-4 mb-0"><i class="bi bi-person-badge me-2"></i>Assigned Guides</h1>
                <span class="small text-body-secondary"><bdi>@Model.TourName</bdi> · @Model.TourStatusLabel</span>
            </div>
            <a asp-area="Provider" asp-controller="Tours" asp-action="Edit" asp-route-id="@Model.TourId"
               class="btn btn-sm btn-secondary-soft mt-2 mt-sm-0"><i class="bi bi-arrow-left me-1"></i>Back to listing</a>
        </div>

        <permission require="@WebPermission.TourGuide.Update">
            <div class="card border">
                <div class="card-header border-bottom"><h2 class="h6 mb-0">Assign a guide</h2></div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <form asp-area="Provider" asp-controller="TourGuides" asp-action="Assign" asp-route-id="@Model.TourId"
                          method="post" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <div class="col-md-7">
                            <label asp-for="Assign.TourGuideUserId" class="form-label">Guide user ID <span class="text-danger">*</span></label>
                            <input asp-for="Assign.TourGuideUserId" class="form-control" dir="ltr" placeholder="00000000-0000-0000-0000-000000000000" />
                            <small class="form-text">Paste the guide's user ID. (A guide picker can replace this field later.)</small>
                            <span asp-validation-for="Assign.TourGuideUserId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check">
                                <input asp-for="Assign.IsPrimary" class="form-check-input" />
                                <label asp-for="Assign.IsPrimary" class="form-check-label"></label>
                            </div>
                        </div>
                        <div class="col-md-2 d-grid">
                            <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Assign</button>
                        </div>
                    </form>
                </div>
            </div>
        </permission>

        <div class="card border">
            <div class="card-header border-bottom"><h2 class="h6 mb-0">Current guides</h2></div>
            <div class="card-body">
                @if (!Model.HasGuides)
                {
                    <p class="text-body-secondary mb-0">No guides are assigned to this tour yet.</p>
                }
                else
                {
                    <ul class="list-group list-group-borderless">
                        @foreach (var g in Model.Guides)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    <img class="avatar avatar-sm rounded-circle me-2"
                                         src="@(string.IsNullOrWhiteSpace(g.AvatarUrl) ? Url.Content("~/assets/images/avatar/01.jpg") : g.AvatarUrl)" alt="" />
                                    <div>
                                        <span class="fw-semibold"><bdi>@g.DisplayName</bdi></span>
                                        @if (g.IsPrimary)
                                        {
                                            <span class="badge text-bg-success ms-1"><i class="bi bi-star-fill me-1" aria-hidden="true"></i>Primary</span>
                                        }
                                    </div>
                                </div>
                                <permission require="@WebPermission.TourGuide.Update">
                                    <form asp-area="Provider" asp-controller="TourGuides" asp-action="Remove"
                                          asp-route-id="@Model.TourId" asp-route-guideUserId="@g.TourGuideId" method="post"
                                          onsubmit="return confirm('Remove @g.DisplayName from this tour?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger-soft" aria-label="Remove @g.DisplayName">
                                            <i class="bi bi-person-dash me-1" aria-hidden="true"></i>Remove
                                        </button>
                                    </form>
                                </permission>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
