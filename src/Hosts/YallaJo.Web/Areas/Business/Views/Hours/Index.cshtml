@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Business.Shared
@using YallaJo.Web.Infrastructure.Authorization
@model YallaJo.Web.Areas.Business.Models.Hours.HoursVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Business.Hours.Title"].Value;
    ViewData["BusinessNav"] = "Hours";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as BusinessSidebarVm ?? new BusinessSidebarVm();

    string DayName(int dow)
    {
        var s = Localizer["Business.Days." + dow];
        return s.ResourceNotFound ? "" : s.Value;
    }
}

<partial name="_BusinessSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-8 col-xl-9">
                @if (ViewBag.Error is string err)
                {
                    <div class="alert alert-danger" role="alert">@err</div>
                }

                <nav class="mb-2" aria-label="@Localizer["Business.Hours.Breadcrumb"]">
                    <a asp-action="Manage" asp-controller="MyBusinesses" asp-route-id="@Model.BusinessId" class="small text-decoration-none">
                        <i class="fa-solid fa-arrow-left fa-fw me-1" aria-hidden="true"></i><bdi dir="ltr">@Model.BusinessName</bdi>
                    </a>
                </nav>
                <h1 class="fs-4 mb-3">
                    <i class="fa-solid fa-clock me-2" aria-hidden="true"></i>@Localizer["Business.Hours.Heading"]
                </h1>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <form asp-action="Save" asp-route-id="@Model.BusinessId" method="post">
                    @Html.AntiForgeryToken()
                    <div class="card shadow">
                        <div class="card-header border-bottom">
                            <h2 class="card-header-title h5 mb-0">@Localizer["Business.Hours.WeeklyHeading"]</h2>
                        </div>
                        <div class="card-body">
                            <p class="text-body-secondary small mb-3">@Localizer["Business.Hours.Intro"]</p>
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <caption class="visually-hidden">@Localizer["Business.Hours.TableCaption"]</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col">@Localizer["Business.Hours.ColDay"]</th>
                                            <th scope="col" class="text-center">@Localizer["Business.Hours.ColClosed"]</th>
                                            <th scope="col">@Localizer["Business.Hours.ColOpens"]</th>
                                            <th scope="col">@Localizer["Business.Hours.ColCloses"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < Model.Days.Count; i++)
                                        {
                                            var dow = Model.Days[i].DayOfWeek;
                                            var label = DayName(dow);
                                            if (string.IsNullOrEmpty(label))
                                            {
                                                label = Model.Days[i].DayName;
                                            }
                                            <tr>
                                                <th scope="row" class="fw-semibold">
                                                    @label
                                                    <input type="hidden" asp-for="Days[i].DayOfWeek" />
                                                    <input type="hidden" asp-for="Days[i].DayName" />
                                                </th>
                                                <td class="text-center">
                                                    <div class="form-check d-inline-block">
                                                        <input class="form-check-input" type="checkbox" asp-for="Days[i].IsClosed" aria-label="@Localizer["Business.Hours.ClosedAria", label]" />
                                                    </div>
                                                </td>
                                                <td>
                                                    <input class="form-control" type="time" dir="ltr" asp-for="Days[i].OpenTime" aria-label="@Localizer["Business.Hours.OpensAria", label]" />
                                                </td>
                                                <td>
                                                    <input class="form-control" type="time" dir="ltr" asp-for="Days[i].CloseTime" aria-label="@Localizer["Business.Hours.ClosesAria", label]" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <permission require="@WebPermission.BusinessHours.Update">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>@Localizer["Business.Hours.Save"]
                            </button>
                        </permission>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
