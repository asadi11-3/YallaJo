@model YallaJo.Web.Areas.Business.Models.Hours.HoursVm
@using YallaJo.Web.Areas.Business.Shared
@using YallaJo.Web.Infrastructure.Authorization
@{
    ViewData["Title"] = "Opening hours";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as BusinessSidebarVm ?? new BusinessSidebarVm();
}

<partial name="_BusinessSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-8 col-xl-9">
                @if (TempData["Success"] is string ok)
                {
                    <div class="alert alert-success">@ok</div>
                }
                @if (TempData["Error"] is string err)
                {
                    <div class="alert alert-danger">@err</div>
                }

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <a asp-action="Manage" asp-controller="MyBusinesses" asp-route-id="@Model.BusinessId" class="small text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i>@Model.BusinessName
                        </a>
                        <h1 class="h3 mb-0">Opening hours</h1>
                    </div>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <form asp-action="Save" asp-route-id="@Model.BusinessId" method="post">
                    @Html.AntiForgeryToken()
                    <div class="card border">
                        <div class="card-body">
                            <p class="text-body-secondary small mb-3">
                                Set your weekly opening hours. Mark a day as <strong>Closed</strong> to hide its times.
                            </p>
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Day</th>
                                            <th class="text-center" style="width:120px;">Closed</th>
                                            <th style="width:160px;">Opens</th>
                                            <th style="width:160px;">Closes</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < Model.Days.Count; i++)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="fw-semibold">@Model.Days[i].DayName</span>
                                                    <input type="hidden" asp-for="Days[i].DayOfWeek" />
                                                    <input type="hidden" asp-for="Days[i].DayName" />
                                                </td>
                                                <td class="text-center">
                                                    <div class="form-check d-inline-block">
                                                        <input class="form-check-input" type="checkbox" asp-for="Days[i].IsClosed" />
                                                    </div>
                                                </td>
                                                <td>
                                                    <input class="form-control" type="time" asp-for="Days[i].OpenTime" />
                                                </td>
                                                <td>
                                                    <input class="form-control" type="time" asp-for="Days[i].CloseTime" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <permission require="@WebPermission.BusinessHours.Update">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check2 me-1"></i>Save hours
                            </button>
                        </permission>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
