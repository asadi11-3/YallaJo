@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Business.Shared
@using YallaJo.Web.Areas.Business.Models.Staff
@model StaffVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Business.Staff.Title"].Value;
    ViewData["BusinessNav"] = "Staff";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as BusinessSidebarVm ?? new BusinessSidebarVm();
}

<section class="pt-0">
    <div class="container">
        <div class="row g-4">
            <partial name="_BusinessSidebar" model="sidebar" />

            <div class="col-lg-8 col-xl-9">
                @if (ViewBag.Error is string err && !string.IsNullOrEmpty(err))
                {
                    <div class="alert alert-danger" role="alert">@err</div>
                }

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <div>
                        <h1 class="fs-4 mb-1"><i class="fa-solid fa-users me-2" aria-hidden="true"></i>@Localizer["Business.Staff.Heading"]</h1>
                        <p class="small text-body-secondary mb-0"><bdi dir="ltr">@Model.BusinessName</bdi></p>
                    </div>
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-controller="MyBusinesses" asp-action="Manage" asp-route-id="@Model.BusinessId">
                        <i class="fa-solid fa-arrow-left fa-fw me-1" aria-hidden="true"></i>@Localizer["Business.Staff.BackToProfile"]
                    </a>
                </div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-4" data-yj-component="business-crud" data-crud-list="#staff-list">
                    <permission require="@WebPermission.BusinessStaff.Create">
                        <div class="col-lg-5">
                            <div class="card shadow h-100">
                                <div class="card-header border-bottom">
                                    <h2 class="card-header-title h5 mb-0">@Localizer["Business.Staff.AddHeading"]</h2>
                                </div>
                                <div class="card-body">
                                    <form asp-action="Add" asp-route-id="@Model.BusinessId" method="post" data-loading
                                          data-crud-success="@Localizer["Business.Staff.Added"]">
                                        @Html.AntiForgeryToken()
                                        <div class="mb-3">
                                            <label asp-for="Form.UserId" class="form-label">@Localizer["Business.Staff.UserId"]</label>
                                            <input asp-for="Form.UserId" class="form-control font-data" dir="ltr" autocomplete="off"
                                                   aria-describedby="staff-user-help" />
                                            <small id="staff-user-help" class="form-text">@Localizer["Business.Staff.UserIdHelp"]</small>
                                            <span asp-validation-for="Form.UserId" class="text-danger small" role="alert"></span>
                                        </div>
                                        <div class="mb-3">
                                            <label asp-for="Form.Role" class="form-label">@Localizer["Business.Staff.Role"]</label>
                                            <select asp-for="Form.Role" class="form-select">
                                                @foreach (var r in Enum.GetValues<BusinessStaffRole>())
                                                {
                                                    <option value="@r">@Localizer["Business.Staff.Role." + r]</option>
                                                }
                                            </select>
                                            <span asp-validation-for="Form.Role" class="text-danger small" role="alert"></span>
                                        </div>
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fa-solid fa-user-plus fa-fw me-1" aria-hidden="true"></i>@Localizer["Business.Staff.Add"]
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </permission>

                    <div class="col-lg-7">
                        <div id="staff-list">
                            <partial name="_StaffList" model="Model" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/business-crud.js" asp-append-version="true" defer></script>
}
