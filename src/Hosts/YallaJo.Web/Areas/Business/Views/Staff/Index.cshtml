@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Business.Shared
@using YallaJo.Web.Areas.Business.Models.Staff
@model StaffVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Business.Staff.Title"].Value;
    ViewData["BusinessNav"] = "Staff";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as BusinessSidebarVm ?? new BusinessSidebarVm();
    var culture = CultureInfo.CurrentUICulture;
    string Count(int n) => n.ToString("N0", culture);
}

<partial name="_BusinessSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-8 col-xl-9">
                @if (ViewBag.Error is string err && !string.IsNullOrEmpty(err))
                {
                    <div class="alert alert-danger" role="alert">@err</div>
                }

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <div>
                        <h1 class="fs-4 mb-1"><i class="fa-solid fa-users me-2" aria-hidden="true"></i>@Localizer["Business.Staff.Heading"]</h1>
                        <p class="small text-body-secondary mb-0"><bdi dir="ltr">@Model.BusinessName</bdi></p>
                    </div>
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-controller="MyBusinesses" asp-action="Manage" asp-route-id="@Model.BusinessId">
                        <i class="fa-solid fa-arrow-left fa-fw me-1" aria-hidden="true"></i>@Localizer["Business.Staff.BackToProfile"]
                    </a>
                </div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-4">
                    <permission require="@WebPermission.BusinessStaff.Create">
                        <div class="col-lg-5">
                            <div class="card shadow h-100">
                                <div class="card-header border-bottom">
                                    <h2 class="card-header-title h5 mb-0">@Localizer["Business.Staff.AddHeading"]</h2>
                                </div>
                                <div class="card-body">
                                    <form asp-action="Add" asp-route-id="@Model.BusinessId" method="post">
                                        @Html.AntiForgeryToken()
                                        <div class="mb-3">
                                            <label asp-for="Form.UserId" class="form-label">@Localizer["Business.Staff.UserId"]</label>
                                            <input asp-for="Form.UserId" class="form-control font-data" dir="ltr" autocomplete="off"
                                                   aria-describedby="staff-user-help" />
                                            <small id="staff-user-help" class="form-text">@Localizer["Business.Staff.UserIdHelp"]</small>
                                            <span asp-validation-for="Form.UserId" class="text-danger small" role="alert"></span>
                                        </div>
                                        <div class="mb-3">
                                            <label asp-for="Form.Role" class="form-label">@Localizer["Business.Staff.Role"]</label>
                                            <select asp-for="Form.Role" class="form-select">
                                                @foreach (var r in Enum.GetValues<BusinessStaffRole>())
                                                {
                                                    <option value="@r">@Localizer["Business.Staff.Role." + r]</option>
                                                }
                                            </select>
                                            <span asp-validation-for="Form.Role" class="text-danger small" role="alert"></span>
                                        </div>
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fa-solid fa-user-plus fa-fw me-1" aria-hidden="true"></i>@Localizer["Business.Staff.Add"]
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </permission>

                    <div class="col-lg-7">
                        <div class="card shadow h-100">
                            <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                                <h2 class="card-header-title h5 mb-0">@Localizer["Business.Staff.CurrentHeading"]</h2>
                                <span class="badge bg-primary bg-opacity-10 text-primary"><bdi class="font-data">@Count(Model.Staff.Count)</bdi></span>
                            </div>
                            <div class="card-body">
                                @if (!Model.HasStaff)
                                {
                                    <div class="text-center py-5">
                                        <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
                                        <p class="mb-0 text-body-secondary">@Localizer["Business.Staff.EmptyMsg"]</p>
                                    </div>
                                }
                                else
                                {
                                    var ordinal = 0;
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th scope="col">@Localizer["Business.Staff.ColMember"]</th>
                                                    <th scope="col">@Localizer["Business.Staff.ColRole"]</th>
                                                    <th scope="col" class="text-end">@Localizer["Business.Staff.ColActions"]</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var s in Model.Staff)
                                                {
                                                    ordinal++;
                                                    var memberLabel = Localizer["Business.Staff.StaffLabel", Count(ordinal)].Value;
                                                    <tr>
                                                        <td class="fw-semibold">@memberLabel</td>
                                                        <td><span class="badge bg-secondary bg-opacity-10 text-secondary">@Localizer["Business.Staff.Role." + s.Role]</span></td>
                                                        <td class="text-end">
                                                            <permission require="@WebPermission.BusinessStaff.Delete">
                                                                <button type="button" class="btn btn-sm btn-danger-soft"
                                                                        data-bs-toggle="modal" data-bs-target="#remove-staff-@s.Id"
                                                                        aria-label="@Localizer["Business.Staff.Remove"]">
                                                                    <i class="fa-solid fa-trash fa-fw" aria-hidden="true"></i>
                                                                </button>
                                                            </permission>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@if (Model.HasStaff)
{
    var modalOrdinal = 0;
    <permission require="@WebPermission.BusinessStaff.Delete">
        @foreach (var s in Model.Staff)
        {
            modalOrdinal++;
            var memberLabel = Localizer["Business.Staff.StaffLabel", Count(modalOrdinal)].Value;
            <div class="modal fade" id="remove-staff-@s.Id" tabindex="-1" aria-labelledby="remove-staff-title-@s.Id"
                 aria-describedby="remove-staff-body-@s.Id" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                <div class="modal-dialog modal-dialog-centered">
                    <form class="modal-content" role="dialog" aria-modal="true" aria-labelledby="remove-staff-title-@s.Id"
                          asp-action="Remove" asp-route-id="@Model.BusinessId" asp-route-staffId="@s.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h2 class="modal-title h5" id="remove-staff-title-@s.Id">@Localizer["Business.Staff.RemoveTitle"]</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Business.Staff.Close"]"></button>
                        </div>
                        <div class="modal-body" id="remove-staff-body-@s.Id">
                            @Localizer["Business.Staff.RemoveBody", memberLabel]
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Business.Staff.Cancel"]</button>
                            <button type="submit" class="btn btn-danger">
                                <i class="fa-solid fa-trash fa-fw me-1" aria-hidden="true"></i>@Localizer["Business.Staff.RemoveConfirm"]
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </permission>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
