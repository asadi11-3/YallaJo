@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Business.Shared
@using YallaJo.Web.Infrastructure.Authorization
@model YallaJo.Web.Areas.Business.Models.Amenities.AmenitiesVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Business.Amenities.Title"].Value;
    ViewData["BusinessNav"] = "Amenities";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as BusinessSidebarVm ?? new BusinessSidebarVm();
}

<section class="pt-0">
    <div class="container">
        <div class="row g-4">
            <partial name="_BusinessSidebar" model="sidebar" />

            <div class="col-lg-8 col-xl-9">
                @if (ViewBag.Error is string err)
                {
                    <div class="alert alert-danger" role="alert">@err</div>
                }

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h1 class="fs-4 mb-1">
                            <i class="fa-solid fa-star me-2" aria-hidden="true"></i>@Localizer["Business.Amenities.Heading"]
                        </h1>
                        <p class="text-body-secondary mb-0"><bdi dir="ltr">@Model.BusinessName</bdi></p>
                    </div>
                    <a class="btn btn-sm btn-outline-secondary" asp-area="Business" asp-controller="MyBusinesses" asp-action="Manage" asp-route-id="@Model.BusinessId">
                        <i class="fa-solid fa-arrow-left fa-fw me-1" aria-hidden="true"></i>@Localizer["Business.Amenities.BackToProfile"]
                    </a>
                </div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-4" data-yj-component="business-crud" data-crud-list="#amenities-list">
                    <permission require="@WebPermission.BusinessAmenity.Create">
                        <div class="col-lg-5">
                            <div class="card shadow h-100">
                                <div class="card-header border-bottom">
                                    <h2 class="card-header-title h5 mb-0">@Localizer["Business.Amenities.AddHeading"]</h2>
                                </div>
                                <div class="card-body">
                                    <form asp-action="Add" asp-route-id="@Model.BusinessId" method="post" data-loading
                                          data-crud-success="@Localizer["Business.Amenities.Added"]">
                                        @Html.AntiForgeryToken()
                                        <div class="mb-3">
                                            <label asp-for="Form.Name" class="form-label">@Localizer["Business.Amenities.Name"]</label>
                                            <input asp-for="Form.Name" class="form-control" />
                                            <span asp-validation-for="Form.Name" class="text-danger small" role="alert"></span>
                                        </div>
                                        <div class="mb-3">
                                            <label asp-for="Form.Icon" class="form-label">@Localizer["Business.Amenities.Icon"]</label>
                                            <input asp-for="Form.Icon" class="form-control" dir="ltr" placeholder="fa-wifi" aria-describedby="amenity-icon-help" />
                                            <div id="amenity-icon-help" class="form-text">@Localizer["Business.Amenities.IconHelp"]</div>
                                            <span asp-validation-for="Form.Icon" class="text-danger small" role="alert"></span>
                                        </div>
                                        <div class="mb-3">
                                            <label asp-for="Form.SortOrder" class="form-label">@Localizer["Business.Amenities.SortOrder"]</label>
                                            <input asp-for="Form.SortOrder" class="form-control" type="number" min="0" dir="ltr" />
                                            <span asp-validation-for="Form.SortOrder" class="text-danger small" role="alert"></span>
                                        </div>
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>@Localizer["Business.Amenities.Add"]
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </permission>

                    <div class="col-lg-7">
                        <div id="amenities-list">
                            <partial name="_AmenitiesList" model="Model" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/business-crud.js" asp-append-version="true" defer></script>
}
