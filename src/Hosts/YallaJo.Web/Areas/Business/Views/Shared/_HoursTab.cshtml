@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Business.Models.Hours
@using YallaJo.Web.Infrastructure.Authorization
@model HoursVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    string DayName(int dow)
    {
        var localized = Localizer["Business.Days." + dow];
        return localized.ResourceNotFound ? "" : localized.Value;
    }
}
<form asp-area="Business" asp-controller="Hours" asp-action="Save" asp-route-id="@Model.BusinessId" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="card shadow">
        <div class="card-header border-bottom">
            <h2 class="h5 mb-0">@Localizer["Business.Hours.WeeklyHeading"]</h2>
        </div>
        <div class="card-body">
            <p class="small text-body-secondary">@Localizer["Business.Hours.Intro"]</p>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <caption class="visually-hidden">@Localizer["Business.Hours.TableCaption"]</caption>
                    <thead>
                        <tr>
                            <th scope="col">@Localizer["Business.Hours.ColDay"]</th>
                            <th scope="col" class="text-center">@Localizer["Business.Hours.ColClosed"]</th>
                            <th scope="col">@Localizer["Business.Hours.ColOpens"]</th>
                            <th scope="col">@Localizer["Business.Hours.ColCloses"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Days.Count; i++)
                        {
                            var label = DayName(Model.Days[i].DayOfWeek);
                            if (string.IsNullOrEmpty(label)) { label = Model.Days[i].DayName; }
                            <tr>
                                <th scope="row" class="fw-semibold">
                                    @label
                                    <input type="hidden" asp-for="Days[i].DayOfWeek" />
                                    <input type="hidden" asp-for="Days[i].DayName" />
                                </th>
                                <td class="text-center">
                                    <div class="form-check d-inline-block">
                                        <input class="form-check-input" type="checkbox" asp-for="Days[i].IsClosed"
                                               aria-label="@Localizer["Business.Hours.ClosedAria", label]" />
                                    </div>
                                </td>
                                <td>
                                    <input class="form-control" type="time" dir="ltr" asp-for="Days[i].OpenTime"
                                           aria-label="@Localizer["Business.Hours.OpensAria", label]" />
                                </td>
                                <td>
                                    <input class="form-control" type="time" dir="ltr" asp-for="Days[i].CloseTime"
                                           aria-label="@Localizer["Business.Hours.ClosesAria", label]" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <permission require="@WebPermission.BusinessHours.Update">
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>
                        @Localizer["Business.Hours.Save"]
                    </button>
                </div>
            </permission>
        </div>
    </div>
</form>
