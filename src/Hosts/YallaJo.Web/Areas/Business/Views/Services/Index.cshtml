@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Business.Shared
@using YallaJo.Web.Areas.Business.Models.Services
@model ServicesVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Business.Services.Title"].Value;
    ViewData["BusinessNav"] = "Services";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as BusinessSidebarVm ?? new BusinessSidebarVm();
    var culture = CultureInfo.CurrentUICulture;
    string Money(decimal amount, string? currency) => amount.ToString("N3", culture) + " " + (string.IsNullOrWhiteSpace(currency) ? "JOD" : currency);
    string Count(int n) => n.ToString("N0", culture);
}

<partial name="_BusinessSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-8 col-xl-9">
                @if (ViewBag.Error is string err)
                {
                    <div class="alert alert-danger" role="alert">@err</div>
                }

                <div class="d-sm-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h1 class="fs-4 mb-1"><i class="fa-solid fa-list-check me-2" aria-hidden="true"></i>@Localizer["Business.Services.Heading"]</h1>
                        <p class="text-body-secondary mb-0"><bdi dir="ltr">@Model.BusinessName</bdi></p>
                    </div>
                    <a class="btn btn-sm btn-outline-secondary" asp-area="Business" asp-controller="MyBusinesses" asp-action="Manage" asp-route-id="@Model.BusinessId">
                        <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>@Localizer["Business.Services.BackToProfile"]
                    </a>
                </div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-4">
                    <permission require="@WebPermission.ServiceItem.Create">
                        <div class="col-lg-5">
                            <div class="card shadow">
                                <div class="card-header border-bottom">
                                    <h2 class="card-header-title h5 mb-0">@Localizer["Business.Services.AddHeading"]</h2>
                                </div>
                                <div class="card-body">
                                    <form asp-action="Add" asp-route-id="@Model.BusinessId" method="post">
                                        @Html.AntiForgeryToken()
                                        <div class="mb-3">
                                            <label asp-for="Form.Name" class="form-label">@Localizer["Business.Services.Name"]</label>
                                            <input asp-for="Form.Name" class="form-control" />
                                            <span asp-validation-for="Form.Name" class="text-danger small" role="alert"></span>
                                        </div>
                                        <div class="row g-2">
                                            <div class="col-7 mb-3">
                                                <label asp-for="Form.Price" class="form-label">@Localizer["Business.Services.Price"]</label>
                                                <input asp-for="Form.Price" type="number" step="0.001" min="0" dir="ltr" class="form-control font-data" />
                                                <span asp-validation-for="Form.Price" class="text-danger small" role="alert"></span>
                                            </div>
                                            <div class="col-5 mb-3">
                                                <label asp-for="Form.Currency" class="form-label">@Localizer["Business.Services.Currency"]</label>
                                                <input asp-for="Form.Currency" dir="ltr" maxlength="3" class="form-control font-data text-uppercase" />
                                                <span asp-validation-for="Form.Currency" class="text-danger small" role="alert"></span>
                                            </div>
                                        </div>
                                        <div class="row g-2">
                                            <div class="col-6 mb-3">
                                                <label asp-for="Form.DurationMinutes" class="form-label">@Localizer["Business.Services.Duration"]</label>
                                                <input asp-for="Form.DurationMinutes" type="number" min="0" dir="ltr" class="form-control" />
                                                <span asp-validation-for="Form.DurationMinutes" class="text-danger small" role="alert"></span>
                                            </div>
                                            <div class="col-6 mb-3">
                                                <label asp-for="Form.MaxCapacity" class="form-label">@Localizer["Business.Services.MaxCapacity"]</label>
                                                <input asp-for="Form.MaxCapacity" type="number" min="0" dir="ltr" class="form-control" />
                                                <span asp-validation-for="Form.MaxCapacity" class="text-danger small" role="alert"></span>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label asp-for="Form.Category" class="form-label">@Localizer["Business.Services.Category"]</label>
                                            <select asp-for="Form.Category" class="form-select">
                                                @foreach (var cat in Enum.GetValues<ServiceCategory>())
                                                {
                                                    <option value="@cat">@Localizer["Business.Services.Category." + cat]</option>
                                                }
                                            </select>
                                            <span asp-validation-for="Form.Category" class="text-danger small" role="alert"></span>
                                        </div>
                                        <div class="mb-3">
                                            <label asp-for="Form.Description" class="form-label">@Localizer["Business.Services.Description"]</label>
                                            <textarea asp-for="Form.Description" rows="2" class="form-control"></textarea>
                                            <span asp-validation-for="Form.Description" class="text-danger small" role="alert"></span>
                                        </div>
                                        <div class="mb-3">
                                            <label asp-for="Form.SortOrder" class="form-label">@Localizer["Business.Services.SortOrder"]</label>
                                            <input asp-for="Form.SortOrder" type="number" min="0" dir="ltr" class="form-control" />
                                            <span asp-validation-for="Form.SortOrder" class="text-danger small" role="alert"></span>
                                        </div>
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>@Localizer["Business.Services.Add"]
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </permission>

                    <div class="col-lg-7">
                        <div class="card shadow">
                            <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                                <h2 class="card-header-title h5 mb-0">@Localizer["Business.Services.CurrentHeading"]</h2>
                                <span class="badge bg-primary bg-opacity-10 text-primary"><bdi dir="ltr" class="font-data">@Count(Model.Services.Count)</bdi></span>
                            </div>
                            <div class="card-body">
                                @if (!Model.HasServices)
                                {
                                    <div class="text-center py-5">
                                        <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
                                        <p class="mb-0 text-body-secondary">@Localizer["Business.Services.EmptyMsg"]</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0">
                                            <caption class="visually-hidden">@Localizer["Business.Services.CurrentHeading"]</caption>
                                            <thead>
                                                <tr>
                                                    <th scope="col">@Localizer["Business.Services.ColService"]</th>
                                                    <th scope="col" class="text-end">@Localizer["Business.Services.ColPrice"]</th>
                                                    <th scope="col" class="text-end">@Localizer["Business.Services.ColDuration"]</th>
                                                    <th scope="col" class="text-end">@Localizer["Business.Services.ColActions"]</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var s in Model.Services)
                                                {
                                                    <tr>
                                                        <td class="fw-semibold">@s.Name</td>
                                                        <td class="text-end"><bdi dir="ltr" class="font-data">@Money(s.Price, s.Currency)</bdi></td>
                                                        <td class="text-end"><bdi dir="ltr">@Localizer["Business.Services.Minutes", Count(s.DurationMinutes)]</bdi></td>
                                                        <td class="text-end">
                                                            <permission require="@WebPermission.ServiceItem.Update">
                                                                <a asp-action="Edit" asp-route-id="@Model.BusinessId" asp-route-serviceId="@s.Id"
                                                                   class="btn btn-sm btn-outline-secondary" aria-label="@Localizer["Business.Services.Edit", s.Name]">
                                                                    <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                                                </a>
                                                            </permission>
                                                            <permission require="@WebPermission.ServiceItem.SoftDelete">
                                                                <button type="button" class="btn btn-sm btn-danger-soft" data-bs-toggle="modal" data-bs-target="#remove-service-@s.Id" aria-label="@Localizer["Business.Services.Remove", s.Name]">
                                                                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                                                </button>
                                                            </permission>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<permission require="@WebPermission.ServiceItem.SoftDelete">
    @foreach (var s in Model.Services)
    {
        <div class="modal fade" id="remove-service-@s.Id" tabindex="-1" aria-labelledby="remove-service-title-@s.Id" aria-describedby="remove-service-body-@s.Id" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <form class="modal-content" role="dialog" aria-modal="true" asp-action="Remove" asp-route-id="@Model.BusinessId" asp-route-serviceId="@s.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="remove-service-title-@s.Id">@Localizer["Business.Services.RemoveTitle"]</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Business.Services.Close"]"></button>
                    </div>
                    <div class="modal-body" id="remove-service-body-@s.Id">@Localizer["Business.Services.RemoveBody", s.Name]</div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Business.Services.Cancel"]</button>
                        <button type="submit" class="btn btn-danger">@Localizer["Business.Services.RemoveConfirm"]</button>
                    </div>
                </form>
            </div>
        </div>
    }
</permission>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
