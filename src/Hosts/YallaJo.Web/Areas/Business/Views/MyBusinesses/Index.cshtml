@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Business.Models.MyBusinesses
@using YallaJo.Web.Areas.Business.Shared
@using YallaJo.Web.Infrastructure.Authorization
@model MyBusinessesVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Business.MyBusinesses.Title"].Value;
    ViewData["BusinessNav"] = "MyBusinesses";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as BusinessSidebarVm ?? new BusinessSidebarVm();

    var culture = CultureInfo.CurrentUICulture;
    string Rating(decimal r) => r.ToString("0.0", culture);
    string Count(int n) => n.ToString("N0", culture);

    string TypeText(string t)
    {
        var v = Localizer["Business.Type." + t];
        return v.ResourceNotFound ? t : v.Value;
    }
}

<section class="pt-0">
    <div class="container">
        <div class="row g-4">
            <partial name="_BusinessSidebar" model="sidebar" />
            <div class="col-lg-8 col-xl-9 vstack gap-4">
        <div class="d-sm-flex justify-content-between align-items-start gap-3">
            <div>
                <h1 class="fs-4 mb-1"><i class="fa-solid fa-shop me-2" aria-hidden="true"></i>@Localizer["Business.MyBusinesses.Heading"]</h1>
                <p class="text-body-secondary mb-0">@Localizer["Business.MyBusinesses.Subtitle"]</p>
            </div>
            <permission require="@WebPermission.Business.Create">
                <a class="btn btn-primary flex-shrink-0" asp-area="Business" asp-controller="MyBusinesses" asp-action="Register">
                    <i class="fa-solid fa-circle-plus me-1" aria-hidden="true"></i>@Localizer["Business.MyBusinesses.Register"]
                </a>
            </permission>
        </div>

        @if (ViewBag.Error is string err) { <div class="alert alert-danger" role="alert">@err</div> }

        @if (!Model.HasBusinesses)
        {
            <div class="card card-body border text-center py-5">
                <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3 mx-auto" />
                <h2 class="h5 mb-1">@Localizer["Business.MyBusinesses.EmptyTitle"]</h2>
                <p class="text-body-secondary mb-3">@Localizer["Business.MyBusinesses.EmptyMsg"]</p>
                <permission require="@WebPermission.Business.Create">
                    <div>
                        <a class="btn btn-primary-soft" asp-area="Business" asp-controller="MyBusinesses" asp-action="Register">
                            <i class="fa-solid fa-circle-plus me-1" aria-hidden="true"></i>@Localizer["Business.MyBusinesses.Register"]
                        </a>
                    </div>
                </permission>
            </div>
        }
        else
        {
            <section class="card shadow" aria-labelledby="biz-list-heading">
                <div class="card-header border-bottom">
                    <h2 id="biz-list-heading" class="card-header-title h5 mb-0">@Localizer["Business.MyBusinesses.Directory"]</h2>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <caption class="visually-hidden">@Localizer["Business.MyBusinesses.TableCaption"]</caption>
                        <thead>
                            <tr>
                                <th scope="col">@Localizer["Business.MyBusinesses.ColBusiness"]</th>
                                <th scope="col">@Localizer["Business.MyBusinesses.ColType"]</th>
                                <th scope="col">@Localizer["Business.MyBusinesses.ColStatus"]</th>
                                <th scope="col">@Localizer["Business.MyBusinesses.ColLocation"]</th>
                                <th scope="col" class="text-end">@Localizer["Business.MyBusinesses.ColRating"]</th>
                                <th scope="col" class="text-end">@Localizer["Business.MyBusinesses.ColActions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.Businesses)
                            {
                                var location = string.Join(", ", new[] { b.City, b.Country }.Where(x => !string.IsNullOrWhiteSpace(x)));
                                <tr>
                                    <td>
                                        <span class="fw-semibold">@b.Name</span>
                                        @if (b.IsVerified)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary ms-1">
                                                <i class="fa-solid fa-circle-check fa-fw" aria-hidden="true"></i> @Localizer["Business.MyBusinesses.Verified"]
                                            </span>
                                        }
                                        <div class="small text-body-secondary"><bdi dir="ltr">@b.Slug</bdi></div>
                                    </td>
                                    <td>@TypeText(b.BusinessType)</td>
                                    <td>
                                        <partial name="_BusinessStatusBadge" model="@b.Status" />
                                    </td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(location))
                                        {
                                            <span class="text-body-secondary">&mdash;</span>
                                        }
                                        else
                                        {
                                            <span>@location</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <bdi dir="ltr" class="font-data">@Rating(b.AverageRating)</bdi>
                                        <span class="text-body-secondary small">(<bdi dir="ltr">@Count(b.ReviewCount)</bdi>)</span>
                                    </td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-primary-soft" asp-area="Business" asp-controller="MyBusinesses" asp-action="Manage" asp-route-id="@b.Id">
                                            <i class="fa-solid fa-pen-to-square me-1" aria-hidden="true"></i>@Localizer["Business.MyBusinesses.Manage"]
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
            </div>
        </div>
    </div>
</section>
