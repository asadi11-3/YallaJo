@using YallaJo.Web.Areas.Business.Models.MyBusinesses
@using YallaJo.Web.Areas.Business.Shared
@using YallaJo.Web.Infrastructure.Authorization
@model ManageBusinessVm
@{
    ViewData["Title"] = "Business profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as BusinessSidebarVm ?? new BusinessSidebarVm();
}

<partial name="_BusinessSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="row align-items-center">
            <div class="col">
                <a class="small text-body-secondary" asp-area="Business" asp-controller="MyBusinesses" asp-action="Index">
                    <i class="bi bi-arrow-left me-1"></i>All businesses
                </a>
                <h1 class="h3 mb-0 mt-1">@Model.Name</h1>
            </div>
            <div class="col-auto">
                <span class="badge bg-@MyBusinessesMapper.StatusColor(Model.Status)-soft text-@MyBusinessesMapper.StatusColor(Model.Status) fs-6">@Model.Status</span>
            </div>
        </div>

        @if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
        @if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }

        @if (Model.CanResubmit)
        {
            <div class="card border-danger">
                <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <h6 class="mb-1 text-danger"><i class="bi bi-exclamation-triangle me-1"></i>This business was rejected</h6>
                        @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
                        {
                            <p class="mb-0 text-body-secondary">Reason: @Model.RejectionReason</p>
                        }
                        <p class="mb-0 small text-body-secondary">Make any corrections below, then resubmit for review.</p>
                    </div>
                    <permission require="@WebPermission.Business.Submit">
                        <form asp-area="Business" asp-controller="MyBusinesses" asp-action="Resubmit" asp-route-id="@Model.Id" method="post"
                              onsubmit="return confirm('Resubmit this business for review?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger"><i class="bi bi-send me-1"></i>Resubmit for review</button>
                        </form>
                    </permission>
                </div>
            </div>
        }

        <div class="row g-4">
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <h6 class="text-body-secondary mb-1">Services</h6>
                    <h4 class="mb-0">@Model.ServiceItemCount</h4>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <h6 class="text-body-secondary mb-1">Staff</h6>
                    <h4 class="mb-0">@Model.StaffCount</h4>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <h6 class="text-body-secondary mb-1">Amenities</h6>
                    <h4 class="mb-0">@Model.AmenityCount</h4>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <h6 class="text-body-secondary mb-1">Verified</h6>
                    <h4 class="mb-0">@(Model.IsVerified ? "Yes" : "No")</h4>
                </div>
            </div>
        </div>

        <permission require="@WebPermission.Business.Update">
            <div class="card border">
                <div class="card-header border-bottom">
                    <h5 class="card-header-title mb-0">Business profile</h5>
                </div>
                <div class="card-body">
                    <form asp-area="Business" asp-controller="MyBusinesses" asp-action="Update" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Form.Id" />
                        <input type="hidden" asp-for="Form.PlaceId" />

                        <div class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="Form.Name" class="form-label"></label>
                                <input asp-for="Form.Name" class="form-control" />
                                <span asp-validation-for="Form.Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Type</label>
                                <input class="form-control" value="@Model.BusinessType" disabled />
                            </div>

                            <div class="col-12">
                                <label asp-for="Form.Description" class="form-label"></label>
                                <textarea asp-for="Form.Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Form.Description" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Form.Address" class="form-label"></label>
                                <input asp-for="Form.Address" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Form.City" class="form-label"></label>
                                <input asp-for="Form.City" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Form.Country" class="form-label"></label>
                                <input asp-for="Form.Country" class="form-control" />
                            </div>

                            <div class="col-md-3">
                                <label asp-for="Form.Latitude" class="form-label"></label>
                                <input asp-for="Form.Latitude" class="form-control" type="number" step="any" />
                                <span asp-validation-for="Form.Latitude" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Form.Longitude" class="form-label"></label>
                                <input asp-for="Form.Longitude" class="form-control" type="number" step="any" />
                                <span asp-validation-for="Form.Longitude" class="text-danger small"></span>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Form.Phone" class="form-label"></label>
                                <input asp-for="Form.Phone" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label asp-for="Form.Email" class="form-label"></label>
                                <input asp-for="Form.Email" class="form-control" />
                                <span asp-validation-for="Form.Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Form.Website" class="form-label"></label>
                                <input asp-for="Form.Website" class="form-control" />
                            </div>

                            <div class="col-12 d-flex flex-wrap gap-4">
                                <div class="form-check">
                                    <input asp-for="Form.IsHalal" class="form-check-input" />
                                    <label asp-for="Form.IsHalal" class="form-check-label"></label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="Form.HasVegetarianOptions" class="form-check-input" />
                                    <label asp-for="Form.HasVegetarianOptions" class="form-check-label"></label>
                                </div>
                                <div class="form-check">
                                    <input asp-for="Form.HasAlcoholFreeArea" class="form-check-input" />
                                    <label asp-for="Form.HasAlcoholFreeArea" class="form-check-label"></label>
                                </div>
                            </div>
                        </div>

                        <div class="mt-3">
                            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </permission>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
