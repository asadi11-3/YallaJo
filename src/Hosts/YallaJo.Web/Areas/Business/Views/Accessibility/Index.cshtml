@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Business.Shared
@using YallaJo.Web.Infrastructure.Authorization
@model YallaJo.Web.Areas.Business.Models.Accessibility.AccessibilityVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Business.Accessibility.Title"].Value;
    ViewData["BusinessNav"] = "Accessibility";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as BusinessSidebarVm ?? new BusinessSidebarVm();
}

<partial name="_BusinessSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-8 col-xl-9">
                @if (ViewBag.Error is string err)
                {
                    <div class="alert alert-danger" role="alert">@err</div>
                }

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h1 class="fs-4 mb-1">
                            <i class="fa-solid fa-universal-access me-2" aria-hidden="true"></i>@Localizer["Business.Accessibility.Heading"]
                        </h1>
                        <p class="text-body-secondary mb-0"><bdi dir="ltr">@Model.BusinessName</bdi></p>
                    </div>
                    <a class="btn btn-sm btn-outline-secondary" asp-area="Business" asp-controller="MyBusinesses" asp-action="Manage" asp-route-id="@Model.BusinessId">
                        <i class="fa-solid fa-arrow-left fa-fw me-1" aria-hidden="true"></i>@Localizer["Business.Accessibility.BackToProfile"]
                    </a>
                </div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="card shadow">
                    <div class="card-header border-bottom">
                        <h2 class="card-header-title h5 mb-0">@Localizer["Business.Accessibility.FeaturesHeading"]</h2>
                        <small class="text-body-secondary">@Localizer["Business.Accessibility.FeaturesHint"]</small>
                    </div>
                    <div class="card-body">
                        <form asp-area="Business" asp-controller="Accessibility" asp-action="Save" asp-route-id="@Model.BusinessId" method="post">
                            @Html.AntiForgeryToken()
                            <div class="vstack gap-3">
                                @for (var i = 0; i < Model.Features.Count; i++)
                                {
                                    var feature = Model.Features[i];
                                    <div class="border rounded-3 p-3">
                                        <input type="hidden" asp-for="Features[i].FeatureType" />
                                        <input type="hidden" asp-for="Features[i].FeatureLabel" />
                                        <div class="row g-3 align-items-start">
                                            <div class="col-md-4">
                                                <p class="fw-semibold mb-2">@feature.FeatureLabel</p>
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" asp-for="Features[i].IsAvailable" />
                                                    <label class="form-check-label" asp-for="Features[i].IsAvailable">@Localizer["Business.Accessibility.Available"]</label>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label" asp-for="Features[i].Name">@Localizer["Business.Accessibility.Name"]</label>
                                                <input class="form-control" asp-for="Features[i].Name" />
                                                <span class="text-danger small" asp-validation-for="Features[i].Name" role="alert"></span>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label" asp-for="Features[i].Description">@Localizer["Business.Accessibility.Description"]</label>
                                                <input class="form-control" asp-for="Features[i].Description" />
                                                <span class="text-danger small" asp-validation-for="Features[i].Description" role="alert"></span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <permission require="@WebPermission.AccessibilityFeature.Update">
                                <div class="mt-4">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>@Localizer["Business.Accessibility.Save"]
                                    </button>
                                </div>
                            </permission>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
