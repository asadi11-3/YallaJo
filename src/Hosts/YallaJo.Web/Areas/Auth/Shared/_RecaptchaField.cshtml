@using YallaJo.Web.Infrastructure.Security.Recaptcha
@inject IRecaptchaScriptService Recaptcha
@model string
@{
    // Model = reCAPTCHA v3 action name (e.g. "login", "register"). Centralizing
    // the hidden field + JS here means every auth form gets identical wiring
    // and cannot accidentally skip the token generation step. If reCAPTCHA is
    // not configured on this host (SiteKey empty), we still emit the hidden
    // input with a bypass placeholder so server-side validation (which sees
    // a short-lived dev secret in that environment) still succeeds.
    var action = string.IsNullOrWhiteSpace(Model) ? "generic" : Model;
    var fieldId = $"recaptchaToken_{action}";
}

<input type="hidden" name="RecaptchaToken" id="@fieldId" value="" data-recaptcha-action="@action" data-recaptcha-sitekey="@Recaptcha.SiteKey" />

@if (Recaptcha.IsEnabled)
{
    @* defer (A6): grecaptcha is only needed at submit time, long after parsing —
       no reason to block the parser mid-body. recaptcha-field.js degrades
       gracefully if it has not loaded yet. *@
    <script src="https://www.google.com/recaptcha/api.js?render=@Recaptcha.SiteKey" defer></script>
    @* CSP (SEC1): reCAPTCHA submit wiring externalized to recaptcha-field.js (reads
       data-recaptcha-sitekey + data-recaptcha-action off the hidden input) so no inline
       <script> is needed on the auth funnel. *@
    <script src="~/assets/js/recaptcha-field.js" asp-append-version="true" defer></script>
}
