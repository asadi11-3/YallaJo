@using YallaJo.Web.Infrastructure.Security.Recaptcha
@inject IRecaptchaScriptService Recaptcha
@model YallaJo.Web.Areas.Auth.Features.VerifyEmail.ViewModels.VerifyEmailVm
@{
    ViewData["Title"] = "Verify Email";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-card">
    <h2>Verify Your Email</h2>
    <p>Enter the 6-digit code sent to your inbox.</p>
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-area="Auth" asp-controller="VerifyEmail" asp-action="Index" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="OtpCode" class="form-label">Verification Code</label>
            <input asp-for="OtpCode" class="form-control" maxlength="6" autocomplete="one-time-code" />
            <span asp-validation-for="OtpCode" class="text-danger"></span>
        </div>

        <partial name="_RecaptchaField" model="@RecaptchaActions.VerifyEmail" />

        <button type="submit" class="btn btn-primary w-100">Verify</button>
    </form>

    <div class="mt-3">
        <button id="resendBtn" class="btn btn-link p-0">Resend code</button>
        <span id="resendMsg" class="text-muted d-none"></span>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var btn     = document.getElementById('resendBtn');
            var msg     = document.getElementById('resendMsg');
            var enabled = @Json.Serialize(Recaptcha.IsEnabled);
            var siteKey = @Json.Serialize(Recaptcha.SiteKey);

            async function getToken() {
                if (!enabled) return '';
                return await new Promise(function (resolve) {
                    grecaptcha.ready(function () {
                        grecaptcha.execute(siteKey, { action: '@RecaptchaActions.ResendOtp' })
                            .then(resolve)
                            .catch(function () { resolve(''); });
                    });
                });
            }

            btn.addEventListener('click', async function () {
                var email = document.getElementById('Email').value;
                var af    = document.querySelector('input[name="__RequestVerificationToken"]').value;
                btn.disabled = true;

                var recaptchaToken = await getToken();

                var res = await fetch('/auth/verifyemail/resendotp', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': af
                    },
                    body: JSON.stringify({ email: email, recaptchaToken: recaptchaToken })
                });
                var data = await res.json();
                msg.textContent = data.message || data.error || 'Error';
                msg.className = res.ok ? 'text-success' : 'text-danger';
                setTimeout(function () { btn.disabled = false; }, 60000);
            });
        })();
    </script>
}
