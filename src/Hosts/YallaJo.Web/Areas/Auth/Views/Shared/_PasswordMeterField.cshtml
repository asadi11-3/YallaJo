@*
    Shared password-strength meter (F3) — extracted from the duplicated markup in
    SignUp.cshtml / ResetPassword.cshtml. Renders the meter bar + optional hint only;
    the password <input asp-for="..."> stays in the owning view (tag-helper validation
    binding cannot cross a partial model boundary). The owning input must carry
    data-psw-meter="#<MeterId>" and the page must load password-meter.js.

    ViewData parameters:
      MeterId  — id of the progress bar (default "pswMeter")
      HintKey  — optional resx key for the helper text below the meter
      HintId   — id of the hint element (default "pswHint")
*@
@{
    var meterId = ViewData["MeterId"] as string ?? "pswMeter";
    var hintKey = ViewData["HintKey"] as string;
    var hintId = ViewData["HintId"] as string ?? "pswHint";
}
<div class="progress progress-thin mt-2">
    @* X6: inline width is a dynamic computed value updated by password-meter.js. *@
    <div id="@meterId" class="progress-bar" role="progressbar" style="width: 0%;"
         aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"
         data-strength-weak="@Localizer["Auth.Password.StrengthWeak"]"
         data-strength-fair="@Localizer["Auth.Password.StrengthFair"]"
         data-strength-strong="@Localizer["Auth.Password.StrengthStrong"]"></div>
</div>
@* A11Y4: screen-reader announcement of the current strength tier (updated by password-meter.js). *@
<span id="@(meterId)Live" class="visually-hidden" aria-live="polite"></span>
@if (!string.IsNullOrEmpty(hintKey))
{
    <small id="@hintId" class="form-text">@Localizer[hintKey]</small>
}
