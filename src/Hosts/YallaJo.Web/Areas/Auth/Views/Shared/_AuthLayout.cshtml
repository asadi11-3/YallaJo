@*
    Minimal chrome-less layout for the public authentication pages
    (SignIn / SignUp / ForgotPassword / ResetPassword / TwoFactor).

    Shares the same Webestica "Booking" theme assets, fonts, dark-mode switch and
    vendor/theme scripts as the shared _Layout.cshtml, but deliberately omits the
    site chrome (top navbar, footer, back-to-top, mobile navbar) so auth screens
    render as standalone, focused, full-height pages.
*@
@{
    var authCulture = System.Globalization.CultureInfo.CurrentUICulture;
    var authLang = authCulture.TwoLetterISOLanguageName;
    var authDir = authCulture.TextInfo.IsRightToLeft ? "rtl" : "ltr";
}
<!DOCTYPE html>
<html lang="@authLang" dir="@authDir">
<head>
    @* dark mode switch (must run before stylesheets paint to avoid a flash of the wrong theme) *@
    <script src="~/assets/js/theme-bootstrap.js" asp-append-version="true"></script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - YallaJo</title>

    @* favicon *@
    <link rel="shortcut icon" href="~/assets/images/favicon.ico" />

    @* Fonts: the external Google Fonts CDN has been removed (UI-UX-Design.md V3 — no
       third-party font CDN). Self-hosted brand fonts (DM Sans, Poppins, IBM Plex Sans
       Arabic) live under ~/fonts/ with @@font-face declarations in site.css
       (V3/V4/A5/X10), loaded below. Icon fonts (Font Awesome, Bootstrap Icons)
       remain self-hosted under ~/assets/vendor. *@

    @* Plugins CSS *@
    <link rel="stylesheet" type="text/css" href="~/assets/vendor/font-awesome/css/all.min.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" />

    @* Theme CSS (bundles Bootstrap v5.3.0) *@
    <link rel="stylesheet" type="text/css" href="~/assets/css/style.css" />

    @* Project-owned site-wide styles: self-hosted brand @@font-face (DM Sans, Poppins,
       IBM Plex Sans Arabic via html[lang="ar"]) + shared utilities (V3/V4/A5/X10). *@
    <link rel="stylesheet" type="text/css" href="~/assets/css/site.css" asp-append-version="true" />

    @* Project-owned Auth custom styles (loaded after the theme so it can override). *@
    <link rel="stylesheet" type="text/css" href="~/assets/css/auth.css" asp-append-version="true" />

    @* RTL overrides \u2014 loaded only when the active culture is right-to-left (Arabic). *@
    @if (authDir == "rtl")
    {
        <link rel="stylesheet" type="text/css" href="~/assets/css/rtl.css" asp-append-version="true" />
    }

    @* Per-view extra styles *@
    @await RenderSectionAsync("Styles", required: false)

    @* Import map for fingerprinted JS modules served via MapStaticAssets()/.WithStaticAssets(). *@
    <ImportMap />
</head>

<body>

    @* **************** MAIN CONTENT START **************** *@
    <main>
        <partial name="_Alerts" />
        @RenderBody()
    </main>
    @* **************** MAIN CONTENT END **************** *@

    @* Bootstrap JS bundle (served locally; fingerprinted + immutable-cached via .WithStaticAssets()). *@
    <script src="~/assets/vendor/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @* Shared AJAX client (window.YallaJo.api — antiforgery header, timeout, 401→sign-in; JS5/SEC7). *@
    <script src="~/assets/js/api-client.js" asp-append-version="true"></script>

    @* Shared form UX (data-loading spinner L2/F7, YallaJo.toast NF1, data-confirm modal F8). *@
    <script src="~/assets/js/form-ux.js" asp-append-version="true"></script>

    @* Theme functions (password eye-toggle, dark-mode switch wiring, etc.) *@
    <script src="~/assets/js/functions.js"></script>

    @* Per-view extra scripts *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
