@model YallaJo.Web.Areas.Auth.Models.VerifyEmail.VerifyEmailVm
@using YallaJo.Web.Infrastructure.Security.Recaptcha
@inject IRecaptchaScriptService Recaptcha
@{
    ViewData["Title"] = Localizer["Auth.TwoFactor.Title"].Value;
}

<section class="vh-xxl-100">
    <div class="container h-100 d-flex px-0 px-sm-4">
        <div class="row justify-content-center align-items-center m-auto">
            <div class="col-12">
                <div class="shadow bg-mode rounded-3 overflow-hidden">
                    <div class="row g-0 align-items-center">
                        <!-- Vector Image -->
                        <div class="col-lg-6 d-md-flex align-items-center order-2 order-lg-1">
                            <div class="p-3 p-lg-5">
                                <img src="~/assets/images/element/forgot-pass.svg" alt="" />
                            </div>
                            <!-- Divider -->
                            <div class="vr opacity-1 d-none d-lg-block"></div>
                        </div>

                        <!-- Information -->
                        <div class="col-lg-6 order-1">
                            <div class="p-4 p-sm-7">
                                <!-- Logo -->
                                <a asp-area="Auth" asp-controller="Auth" asp-action="SignIn">
                                    <img class="mb-4 h-50px" src="~/assets/images/logo-icon.svg" alt="logo" />
                                </a>
                                <!-- Title -->
                                <h1 class="mb-2 h3">@Localizer["Auth.TwoFactor.Heading"]</h1>
                                <p class="mb-sm-0">
                                    @Localizer["Auth.TwoFactor.SentTo"]
                                    @* Masked server-side (first letter + domain hint) — the full address
                                       never renders, reducing shoulder-surfing exposure on a shared screen. *@
                                    <b><bdi dir="ltr">@(string.IsNullOrEmpty(Model.MaskedEmail) ? Localizer["Auth.TwoFactor.YourEmail"].Value : Model.MaskedEmail)</bdi></b>
                                </p>

                                <div asp-validation-summary="All" class="text-danger mt-3 mb-0"></div>

                                <!-- Form START -->
                                <form asp-area="Auth" asp-controller="Auth" asp-action="TwoFactor" method="post" class="mt-sm-4 text-start">
                                    @Html.AntiForgeryToken()

                                    @* No hidden Email field: the pending identity lives in the encrypted
                                       pending-verification cookie and is re-resolved server-side on POST
                                       ([BindNever] on the VM ignores any posted value). *@

                                    <!-- Verification code -->
                                    <label asp-for="OtpCode" class="form-label mb-1">@Localizer["Auth.TwoFactor.Intro"]</label>
                                    <div class="mb-2">
                                        <input asp-for="OtpCode"
                                               class="form-control form-control-lg text-center otp-input"
                                               dir="ltr"
                                               maxlength="6"
                                               autocomplete="one-time-code"
                                               inputmode="numeric"
                                               placeholder="------"
                                               aria-describedby="otp-error"
                                               autofocus />
                                        <span asp-validation-for="OtpCode" id="otp-error" class="text-danger small" role="alert"></span>
                                    </div>

                                    <!-- Resend -->
                                    <div class="d-sm-flex justify-content-between align-items-center small mb-4">
                                        <span>@Localizer["Auth.TwoFactor.NoCode"]</span>
                                        <button type="button" id="resendBtn" class="btn btn-sm btn-link p-0 text-decoration-underline mb-0" data-resend-url="@Url.Action("ResendOtp", "Auth", new { area = "Auth" })">@Localizer["Auth.TwoFactor.Resend"]</button>
                                    </div>
                                    <div id="resendMsg" class="small mb-3"></div>

                                    <partial name="_RecaptchaField" model="@RecaptchaActions.VerifyEmail" />

                                    <!-- Button -->
                                    <div><button type="submit" class="btn btn-primary w-100 mb-0">@Localizer["Auth.TwoFactor.Submit"]</button></div>
                                </form>
                                <!-- Form END -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @* SANITIZED (SEC3): the value is System.Text.Json.JsonSerializer.Serialize output —
       the default encoder is HTML-safe (escapes <, >, & as \uXXXX), so a value containing
       "</script>" cannot terminate this non-executable application/json island. The
       payload is config-controlled (site key + constant action name), and Html.Raw only
       prevents Razor from double-encoding the already-safe JSON. *@
    <script type="application/json" id="auth-twofactor-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { recaptchaEnabled = Recaptcha.IsEnabled, recaptchaSiteKey = Recaptcha.SiteKey, resendAction = RecaptchaActions.ResendOtp }))</script>
    <script src="~/assets/js/auth-twofactor.js" asp-append-version="true"></script>
}
