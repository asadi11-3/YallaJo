@model YallaJo.Web.Areas.Auth.Models.Register.RegisterVm
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Infrastructure.Authentication.ExternalAuth
@using YallaJo.Web.Infrastructure.Security.Recaptcha
@inject IExternalProviderAvailability ProviderAvailability
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Auth.SignUp.Title"].Value;
    Layout = "~/Areas/Auth/Views/Shared/_AuthLayout.cshtml";
}

<section class="vh-xxl-100">
    <div class="container h-100 d-flex px-0 px-sm-4">
        <div class="row justify-content-center align-items-center m-auto">
            <div class="col-12">
                <div class="bg-mode shadow rounded-3 overflow-hidden">
                    <div class="row g-0">
                        <!-- Vector image -->
                        <div class="col-lg-6 d-md-flex align-items-center order-2 order-lg-1">
                            <div class="p-3 p-lg-5">
                                <img src="~/assets/images/element/signin.svg" alt="" />
                            </div>
                            <!-- Divider -->
                            <div class="vr opacity-1 d-none d-lg-block"></div>
                        </div>

                        <!-- Information -->
                        <div class="col-lg-6 order-1">
                            <div class="p-4 p-sm-6">
                                <!-- Logo -->
                                <a asp-area="Auth" asp-controller="Auth" asp-action="SignIn">
                                    <img class="h-50px mb-4" src="~/assets/images/logo-icon.svg" alt="logo" />
                                </a>
                                <!-- Title -->
                                <h1 class="mb-2 h3">@Localizer["Auth.SignUp.Heading"]</h1>
                                <p class="mb-0">
                                    @Localizer["Auth.SignUp.HaveAccount"]
                                    <a asp-area="Auth" asp-controller="Auth" asp-action="SignIn"> @Localizer["Auth.SignUp.SignInLink"]</a>
                                </p>

                                <div asp-validation-summary="All" class="text-danger mt-3 mb-0"></div>

                                <!-- Form START -->
                                <form asp-area="Auth" asp-controller="Auth" asp-action="SignUp" method="post" class="mt-4 text-start">
                                    @Html.AntiForgeryToken()

                                    <div class="row">
                                        <!-- First name -->
                                        <div class="mb-3 col-sm-6">
                                            <label asp-for="FirstName" class="form-label"></label>
                                            <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                                        </div>
                                        <!-- Last name -->
                                        <div class="mb-3 col-sm-6">
                                            <label asp-for="LastName" class="form-label"></label>
                                            <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                                            <span asp-validation-for="LastName" class="text-danger small"></span>
                                        </div>
                                    </div>

                                    <!-- Email -->
                                    <div class="mb-3">
                                        <label asp-for="Email" class="form-label"></label>
                                        <input asp-for="Email" class="form-control" type="email" dir="ltr" autocomplete="email" />
                                        <span asp-validation-for="Email" class="text-danger small"></span>
                                    </div>

                                    <!-- Password -->
                                    <div class="mb-3 position-relative">
                                        <label asp-for="Password" class="form-label"></label>
                                        <input asp-for="Password" class="form-control fakepassword" id="psw-input" type="password" autocomplete="new-password" />
                                        <span class="position-absolute top-50 end-0 translate-middle-y p-0 mt-3">
                                            <i class="fakepasswordicon fas fa-eye-slash cursor-pointer p-2"></i>
                                        </span>
                                        <span asp-validation-for="Password" class="text-danger small"></span>
                                        <!-- Password strength meter -->
                                        <div class="progress mt-2" style="height: 4px;">
                                            <div id="pswMeter" class="progress-bar" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                        <small id="pswHint" class="form-text">@Localizer["Auth.SignUp.PasswordHint"]</small>
                                    </div>

                                    <partial name="_RecaptchaField" model="@RecaptchaActions.Register" />

                                    <!-- Button -->
                                    <div>
                                        <button type="submit" class="btn btn-primary w-100 mb-0">@Localizer["Auth.SignUp.Submit"]</button>
                                    </div>
                                </form>
                                <!-- Form END -->

                                @if (ProviderAvailability.IsGoogleAvailable || ProviderAvailability.IsFacebookAvailable)
                                {
                                    <!-- Divider -->
                                    <div class="position-relative my-4">
                                        <hr />
                                        <p class="small position-absolute top-50 start-50 translate-middle bg-mode px-1 px-sm-2">@Localizer["Auth.SignUp.OrWith"]</p>
                                    </div>

                                    <!-- Google and Facebook -->
                                    <div class="vstack gap-3">
                                        @if (ProviderAvailability.IsGoogleAvailable)
                                        {
                                            <form asp-area="Auth" asp-controller="ExternalAuth" asp-action="Challenge" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="provider" value="google" />
                                                <input type="hidden" name="mode" value="login" />
                                                <button type="submit" class="btn btn-light w-100 mb-0">
                                                    <i class="fab fa-fw fa-google text-google-icon me-2" aria-hidden="true"></i>@Localizer["Auth.Social.GoogleSignup"]
                                                </button>
                                            </form>
                                        }
                                        @if (ProviderAvailability.IsFacebookAvailable)
                                        {
                                            <form asp-area="Auth" asp-controller="ExternalAuth" asp-action="Challenge" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="provider" value="facebook" />
                                                <input type="hidden" name="mode" value="login" />
                                                <button type="submit" class="btn btn-light w-100 mb-0">
                                                    <i class="fab fa-fw fa-facebook-f text-facebook me-2" aria-hidden="true"></i>@Localizer["Auth.Social.FacebookSignup"]
                                                </button>
                                            </form>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/auth-signup.js" asp-append-version="true"></script>
}
