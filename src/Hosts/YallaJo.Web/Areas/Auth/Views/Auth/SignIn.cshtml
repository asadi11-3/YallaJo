@model YallaJo.Web.Areas.Auth.Models.Login.LoginVm
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Infrastructure.Authentication.ExternalAuth
@using YallaJo.Web.Infrastructure.Security.Recaptcha
@inject IExternalProviderAvailability ProviderAvailability
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Auth.SignIn.Title"].Value;
    Layout = "~/Areas/Auth/Views/Shared/_AuthLayout.cshtml";
    var loginError = TempData["LoginError"] as string;

}

<section class="vh-xxl-100">
    <div class="container h-100 d-flex px-0 px-sm-4">
        <div class="row justify-content-center align-items-center m-auto">
            <div class="col-12">
                <div class="bg-mode shadow rounded-3 overflow-hidden">
                    <div class="row g-0">
                        <!-- Vector image -->
                        <div class="col-lg-6 d-flex align-items-center order-2 order-lg-1">
                            <div class="p-3 p-lg-5">
                                <img src="~/assets/images/element/signin.svg" alt="" aria-hidden="true">
                            </div>
                            <!-- Divider -->
                            <div class="vr opacity-1 d-none d-lg-block"></div>
                        </div>

                        <!-- Information -->
                        <div class="col-lg-6 order-1">
                            <div class="p-4 p-sm-7">
                                <!-- Logo -->
                                <a asp-area="Auth" asp-controller="Auth" asp-action="SignIn">
                                    <img class="h-50px mb-4" src="~/assets/images/logo-icon.svg" alt="logo">
                                </a>

                                <!-- Title -->
                                <h1 class="mb-2 h3">@Localizer["Auth.SignIn.Heading"]</h1>
                                <p class="mb-0">
                                    @Localizer["Auth.SignIn.NewHere"]
                                    <a asp-area="Auth" asp-controller="Auth" asp-action="SignUp">@Localizer["Auth.SignIn.CreateAccount"]</a>
                                </p>

                                @if (!string.IsNullOrEmpty(loginError))
                                {
                                    <div class="alert alert-warning mt-4 mb-0">@loginError</div>
                                }

                                <div asp-validation-summary="All" class="text-danger mt-4"></div>

                                <!-- Form START -->
                                <form asp-area="Auth" asp-controller="Auth" asp-action="SignIn" method="post" class="mt-4 text-start">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" asp-for="ReturnUrl" />

                                    <!-- Email -->
                                    <div class="mb-3">
                                        <label asp-for="Email" class="form-label">@Localizer["Auth.Field.Email"]</label>
                                        <input asp-for="Email" type="email" class="form-control" dir="ltr" autocomplete="username" />
                                        <span asp-validation-for="Email" class="text-danger"></span>
                                    </div>

                                    <!-- Password -->
                                    <div class="mb-3 position-relative">
                                        <label asp-for="Password" class="form-label">@Localizer["Auth.Field.Password"]</label>
                                        <input asp-for="Password" type="password" class="form-control fakepassword" id="psw-input" autocomplete="current-password" />
                                        <span class="position-absolute top-50 end-0 translate-middle-y p-0 mt-3 me-2">
                                            <i class="fakepasswordicon fas fa-eye-slash cursor-pointer p-2"></i>
                                        </span>
                                        <span asp-validation-for="Password" class="text-danger d-block"></span>
                                    </div>

                                    <!-- Remember me / forgot password -->
                                    <div class="mb-3 d-sm-flex justify-content-between">
                                        <div>
                                            <input type="checkbox" class="form-check-input" id="rememberCheck">
                                            <label class="form-check-label" for="rememberCheck">@Localizer["Auth.SignIn.RememberMe"]</label>
                                        </div>
                                        <a asp-area="Auth" asp-controller="Auth" asp-action="ForgotPassword">@Localizer["Auth.SignIn.ForgotPassword"]</a>
                                    </div>

                                    <partial name="_RecaptchaField" model="@RecaptchaActions.Login" />

                                    <!-- Button -->
                                    <div>
                                        <button type="submit" class="btn btn-primary w-100 mb-0">@Localizer["Auth.SignIn.Submit"]</button>
                                    </div>

                                    @if (ProviderAvailability.IsGoogleAvailable || ProviderAvailability.IsFacebookAvailable)
                                    {
                                        <!-- Divider -->
                                        <div class="position-relative my-4">
                                            <hr>
                                            <p class="small bg-mode position-absolute top-50 start-50 translate-middle px-2">@Localizer["Auth.SignIn.OrWith"]</p>
                                        </div>
                                    }
                                </form>
                                <!-- Form END -->

                                @if (ProviderAvailability.IsGoogleAvailable || ProviderAvailability.IsFacebookAvailable)
                                {
                                    <!-- Social buttons -->
                                    <div class="vstack gap-3">
                                        @if (ProviderAvailability.IsGoogleAvailable)
                                        {
                                            <form asp-area="Auth" asp-controller="ExternalAuth" asp-action="Challenge" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="provider" value="google" />
                                                <input type="hidden" name="mode" value="login" />
                                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                                <button type="submit" class="btn btn-light w-100 mb-0">
                                                    <i class="fab fa-fw fa-google text-google-icon me-2" aria-hidden="true"></i>@Localizer["Auth.Social.Google"]
                                                </button>
                                            </form>
                                        }

                                        @if (ProviderAvailability.IsFacebookAvailable)
                                        {
                                            <form asp-area="Auth" asp-controller="ExternalAuth" asp-action="Challenge" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="provider" value="facebook" />
                                                <input type="hidden" name="mode" value="login" />
                                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                                <button type="submit" class="btn btn-light w-100 mb-0">
                                                    <i class="fab fa-fw fa-facebook-f text-facebook me-2" aria-hidden="true"></i>@Localizer["Auth.Social.Facebook"]
                                                </button>
                                            </form>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
