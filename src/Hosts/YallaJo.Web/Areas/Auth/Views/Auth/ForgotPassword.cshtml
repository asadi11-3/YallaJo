@model YallaJo.Web.Areas.Auth.Models.ForgotPassword.ForgotPasswordVm
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Infrastructure.Security.Recaptcha
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Auth.Forgot.Title"].Value;
    Layout = "~/Areas/Auth/Views/Shared/_AuthLayout.cshtml";
}

<section class="vh-xxl-100">
    <div class="container h-100 d-flex px-0 px-sm-4">
        <div class="row justify-content-center align-items-center m-auto">
            <div class="col-12">
                <div class="bg-mode shadow rounded-3 overflow-hidden">
                    <div class="row g-0">
                        <!-- Vector Image -->
                        <div class="col-lg-6 d-md-flex align-items-center order-2 order-lg-1">
                            <div class="p-3 p-lg-5">
                                <img src="~/assets/images/element/forgot-pass.svg" alt="" />
                            </div>
                            <!-- Divider -->
                            <div class="vr opacity-1 d-none d-lg-block"></div>
                        </div>

                        <!-- Information -->
                        <div class="col-lg-6 order-1">
                            <div class="p-4 p-sm-7">
                                <!-- Logo -->
                                <a asp-area="Auth" asp-controller="Auth" asp-action="SignIn">
                                    <img class="mb-4 h-50px" src="~/assets/images/logo-icon.svg" alt="logo" />
                                </a>
                                <!-- Title -->
                                <h1 class="mb-2 h3">@Localizer["Auth.Forgot.Heading"]</h1>
                                <p class="mb-sm-0">@Localizer["Auth.Forgot.Intro"]</p>

                                <div asp-validation-summary="All" class="text-danger mt-3 mb-0"></div>

                                <!-- Form START -->
                                <form asp-area="Auth" asp-controller="Auth" asp-action="ForgotPassword" method="post" class="mt-sm-4 text-start">
                                    @Html.AntiForgeryToken()

                                    <!-- Email -->
                                    <div class="mb-3">
                                        <label asp-for="Email" class="form-label">@Localizer["Auth.Field.Email"]</label>
                                        <input asp-for="Email" type="email" class="form-control" dir="ltr" autocomplete="email" />
                                        <span asp-validation-for="Email" class="text-danger"></span>
                                    </div>

                                    <partial name="_RecaptchaField" model="@RecaptchaActions.ForgotPassword" />

                                    <!-- Button -->
                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-primary mb-0">@Localizer["Auth.Forgot.Submit"]</button>
                                    </div>

                                    <!-- Back to sign in -->
                                    <div class="mt-3 text-center">
                                        <p class="mb-0">@Localizer["Auth.Forgot.BackTo"] <a asp-area="Auth" asp-controller="Auth" asp-action="SignIn">@Localizer["Auth.Forgot.BackToSignIn"]</a></p>
                                    </div>
                                </form>
                                <!-- Form END -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
