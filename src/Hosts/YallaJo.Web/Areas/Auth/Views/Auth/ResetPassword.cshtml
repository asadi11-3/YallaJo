@model YallaJo.Web.Areas.Auth.Models.ResetPassword.ResetPasswordVm
@{
    ViewData["Title"] = Localizer["Auth.Reset.Title"].Value;
}

<section class="vh-xxl-100">
    <div class="container h-100 d-flex px-0 px-sm-4">
        <div class="row justify-content-center align-items-center m-auto">
            <div class="col-12">
                <div class="bg-mode shadow rounded-3 overflow-hidden">
                    <div class="row g-0">
                        <!-- Vector image -->
                        <div class="col-lg-6 d-md-flex align-items-center order-2 order-lg-1">
                            <div class="p-3 p-lg-5">
                                <img src="~/assets/images/element/forgot-pass.svg" alt="" />
                            </div>
                            <!-- Divider -->
                            <div class="vr opacity-1 d-none d-lg-block"></div>
                        </div>

                        <!-- Information -->
                        <div class="col-lg-6 order-1">
                            <div class="p-4 p-sm-6">
                                <!-- Logo -->
                                <a asp-area="Auth" asp-controller="Auth" asp-action="SignIn">
                                    <img class="h-50px mb-4" src="~/assets/images/logo-icon.svg" alt="logo" />
                                </a>
                                <!-- Title -->
                                <h1 class="mb-2 h3">@Localizer["Auth.Reset.Heading"]</h1>
                                <p class="mb-0">@Localizer["Auth.Reset.Intro"]</p>

                                <div asp-validation-summary="All" class="text-danger mt-3 mb-0"></div>

                                <!-- Form START -->
                                <form asp-area="Auth" asp-controller="Auth" asp-action="ResetPassword" method="post" class="mt-4 text-start">
                                    @Html.AntiForgeryToken()

                                    <!-- Email -->
                                    <div class="mb-3">
                                        <label asp-for="Email" class="form-label">@Localizer["Auth.Field.Email"]</label>
                                        <input asp-for="Email" class="form-control" type="email" dir="ltr" autocomplete="email" />
                                        <span asp-validation-for="Email" class="text-danger small"></span>
                                    </div>

                                    <!-- Reset code -->
                                    <div class="mb-3">
                                        <label asp-for="OtpCode" class="form-label">@Localizer["Auth.Reset.OtpLabel"]</label>
                                        <input asp-for="OtpCode" class="form-control form-control-lg text-center otp-input" dir="ltr" maxlength="6" autocomplete="one-time-code" inputmode="numeric" placeholder="------" />
                                        <span asp-validation-for="OtpCode" class="text-danger small"></span>
                                    </div>

                                    <!-- New password -->
                                    <div class="mb-3 position-relative">
                                        <label asp-for="NewPassword" class="form-label">@Localizer["Auth.Reset.NewPasswordLabel"]</label>
                                        <input asp-for="NewPassword" class="form-control fakepassword" id="psw-input" type="password" autocomplete="new-password" />
                                        <span class="position-absolute top-50 end-0 translate-middle-y p-0 mt-3">
                                            <i class="fakepasswordicon fas fa-eye-slash cursor-pointer p-2"></i>
                                        </span>
                                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                                        <!-- Password strength meter -->
                                        <div class="progress progress-thin mt-2">
                                            <div id="pswMeter" class="progress-bar" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                        <small id="pswHint" class="form-text">@Localizer["Auth.Reset.PasswordHint"]</small>
                                    </div>

                                    <!-- Confirm new password -->
                                    <div class="mb-3 position-relative">
                                        <label asp-for="ConfirmNewPassword" class="form-label">@Localizer["Auth.Reset.ConfirmLabel"]</label>
                                        <input asp-for="ConfirmNewPassword" class="form-control fakepassword" id="psw-confirm-input" type="password" autocomplete="new-password" />
                                        <span class="position-absolute top-50 end-0 translate-middle-y p-0 mt-3">
                                            <i class="fakepasswordicon fas fa-eye-slash cursor-pointer p-2"></i>
                                        </span>
                                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                                    </div>

                                    <!-- Button -->
                                    <div>
                                        <button type="submit" class="btn btn-primary w-100 mb-0">@Localizer["Auth.Reset.Submit"]</button>
                                    </div>

                                    <!-- Back to sign in -->
                                    <div class="mt-3 text-center">
                                        <p class="mb-0">@Localizer["Auth.Forgot.BackTo"] <a asp-area="Auth" asp-controller="Auth" asp-action="SignIn">@Localizer["Auth.Forgot.BackToSignIn"]</a></p>
                                    </div>
                                </form>
                                <!-- Form END -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/auth-resetpassword.js" asp-append-version="true"></script>
}
