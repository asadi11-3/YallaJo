@model YallaJo.Web.Areas.Auth.Models.AcceptInvite.AcceptInviteVm
@{
    ViewData["Title"] = "Accept Invite";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-card">
    <h2>Complete Your Invitation</h2>
    <p class="text-muted">Invited email: <strong>@Model.Email</strong></p>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-area="Auth" asp-controller="AcceptInvite" asp-action="Index" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">Activate Account</button>
    </form>

    <div class="mt-3">
        <a asp-area="Auth" asp-controller="Auth" asp-action="SignIn">Back to sign in</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
