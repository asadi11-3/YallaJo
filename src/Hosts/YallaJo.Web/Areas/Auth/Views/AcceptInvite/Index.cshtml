@model YallaJo.Web.Areas.Auth.Models.AcceptInvite.AcceptInviteVm
@{
    @* Part of the anonymous auth funnel — uses the chrome-less _AuthLayout via _ViewStart. *@
    ViewData["Title"] = Localizer["Auth.AcceptInvite.Title"].Value;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h1 class="h3 mb-1">@Localizer["Auth.AcceptInvite.Heading"]</h1>
                    <p class="text-secondary mb-4">
                        @Localizer["Auth.AcceptInvite.Intro"]
                        <bdi dir="ltr" class="fw-semibold">@Model.Email</bdi>
                    </p>

                    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>

                    <form asp-area="Auth" asp-controller="AcceptInvite" asp-action="Index" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="Token" />

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">@Localizer["Auth.Field.Password"]</label>
                            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" aria-describedby="invite-pwd-help" data-psw-meter="#pswMeter" />
                            <span asp-validation-for="Password" class="text-danger" role="alert"></span>
                            <!-- Password strength meter (shared partial, F3) -->
                            <partial name="_PasswordMeterField" view-data='new ViewDataDictionary(ViewData) { ["MeterId"] = "pswMeter" }' />
                            <small id="invite-pwd-help" class="form-text">@Localizer["Auth.AcceptInvite.PasswordHint"]</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">@Localizer["Auth.Field.ConfirmPassword"]</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger" role="alert"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">@Localizer["Auth.AcceptInvite.Submit"]</button>
                    </form>

                    <div class="mt-3 text-center">
                        <a asp-area="Auth" asp-controller="Auth" asp-action="SignIn">@Localizer["Auth.Forgot.BackToSignIn"]</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/password-meter.js" asp-append-version="true"></script>
}
