@using Microsoft.Extensions.Localization
@model YallaJo.Web.Areas.Auth.Models.AcceptInvite.ResendFromExpiredVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Auth.AcceptInvite.ExpiredTitle"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            <div class="card shadow">
                <div class="card-body p-4 text-center">
                    <i class="fa-solid fa-clock-rotate-left fa-2x text-warning mb-3" aria-hidden="true"></i>
                    <h1 class="h3 mb-2">@Localizer["Auth.AcceptInvite.ExpiredHeading"]</h1>
                    <p class="text-secondary mb-3">
                        @Localizer["Auth.AcceptInvite.ExpiredMessage"]
                        <bdi dir="ltr" class="fw-semibold">@Model.Email</bdi>
                    </p>
                    <div class="alert alert-warning" role="alert">
                        @Localizer["Auth.AcceptInvite.ExpiredHelp"]
                    </div>
                    <a asp-area="Auth" asp-controller="Auth" asp-action="SignIn" class="btn btn-outline-primary w-100">
                        @Localizer["Auth.Forgot.BackToSignIn"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
