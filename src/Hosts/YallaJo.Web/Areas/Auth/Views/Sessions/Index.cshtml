@model YallaJo.Web.Areas.Auth.Models.Sessions.SessionsVm
@{
    ViewData["Title"] = Localizer["Auth.Sessions.Title"].Value;
    @* Account-management page: opts back into the public site chrome (overrides the
       funnel _AuthLayout default set by the area _ViewStart). *@
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="d-sm-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-1">@Localizer["Auth.Sessions.Heading"]</h1>
                    <p class="mb-0 text-secondary">@Localizer["Auth.Sessions.Subtitle"]</p>
                </div>
                <div class="d-flex flex-wrap gap-2 mt-3 mt-sm-0">
                    @* Common case: keep this session, sign out everywhere else (AJAX partial swap
                       with PRG fallback — PE1). *@
                    <form asp-area="Auth" asp-controller="Sessions" asp-action="RevokeOthers" method="post"
                          data-sessions-ajax
                          data-confirm="@Localizer["Auth.Sessions.SignOutOthersConfirm"]"
                          data-confirm-title="@Localizer["Auth.Sessions.SignOutOthers"]"
                          data-confirm-action="@Localizer["Auth.Sessions.SignOutOthers"]"
                          data-confirm-cancel="@Localizer["Auth.Confirm.Cancel"]"
                          data-success-msg="@Localizer["Auth.Sessions.OthersRevokedToast"]"
                          data-error-msg="@Localizer["Auth.Sessions.ActionFailed"]">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-warning">
                            <i class="fa-solid fa-laptop fa-fw me-1" aria-hidden="true"></i>
                            @Localizer["Auth.Sessions.SignOutOthers"]
                        </button>
                    </form>
                    @* Destructive: ends every session including this one (full navigation —
                       signs the user out, so no AJAX). *@
                    <form asp-area="Auth" asp-controller="Auth" asp-action="LogoutAll" method="post"
                          data-confirm="@Localizer["Auth.Sessions.SignOutAllConfirm"]"
                          data-confirm-title="@Localizer["Auth.Sessions.SignOutAll"]"
                          data-confirm-action="@Localizer["Auth.Sessions.SignOutAll"]"
                          data-confirm-cancel="@Localizer["Auth.Confirm.Cancel"]">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning">
                            <i class="fa-solid fa-right-from-bracket fa-fw me-1" aria-hidden="true"></i>
                            @Localizer["Auth.Sessions.SignOutAll"]
                        </button>
                    </form>
                </div>
            </div>

            <div class="card shadow">
                <div class="card-header border-bottom">
                    <h2 class="card-header-title h5 mb-0">@Localizer["Auth.Sessions.ListHeading"]</h2>
                </div>
                <div class="card-body">
                    <div id="sessions-table-container" aria-live="polite">
                        <partial name="_SessionsTable" model="Model" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* F8/MOD3/MOD5 — the data-confirm attributes on the destructive forms above are
   handled by form-ux.js, which the public _Layout loads site-wide. The previous
   cross-area render of the Admin _ConfirmModal partial was removed: it registered
   a second capture-phase submit interceptor with a different re-entry flag
   (data-confirmed vs data-yj-confirmed), causing a double confirm modal. *@

@section Styles {
    <link rel="stylesheet" href="~/assets/css/auth.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/assets/js/auth-sessions.js" asp-append-version="true"></script>
}
