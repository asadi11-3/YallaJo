@model YallaJo.Web.Areas.Auth.Models.ExternalProviders.ExternalProvidersVm
@{
    ViewData["Title"] = "Linked Providers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Linked Providers</h2>

    <h4 class="mt-4">Link a New Provider</h4>
    <p class="text-muted">You will be redirected to the provider to sign in before the link is completed.</p>

    @if (!Model.IsGoogleAvailable && !Model.IsFacebookAvailable)
    {
        <div class="alert alert-warning">
            No external providers are configured on this server. Please contact your administrator.
        </div>
    }

    @if (Model.IsGoogleAvailable)
    {
        <form asp-area="Auth" asp-controller="ExternalAuth" asp-action="Challenge" method="post" style="display:inline-block;margin-right:8px">
            @Html.AntiForgeryToken()
            <input type="hidden" name="provider" value="google" />
            <input type="hidden" name="mode" value="link" />
            <button type="submit" class="btn btn-outline-dark">Link Google</button>
        </form>
    }

    @if (Model.IsFacebookAvailable)
    {
        <form asp-area="Auth" asp-controller="ExternalAuth" asp-action="Challenge" method="post" style="display:inline-block">
            @Html.AntiForgeryToken()
            <input type="hidden" name="provider" value="facebook" />
            <input type="hidden" name="mode" value="link" />
            <button type="submit" class="btn btn-outline-primary">Link Facebook</button>
        </form>
    }
</div>
