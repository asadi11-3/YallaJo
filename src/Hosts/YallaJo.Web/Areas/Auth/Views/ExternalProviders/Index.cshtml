@model YallaJo.Web.Areas.Auth.Models.ExternalProviders.ExternalProvidersVm
@{
    ViewData["Title"] = Localizer["Auth.External.Title"].Value;
    @* Account-management page: public site chrome (overrides the funnel default). *@
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <h1 class="h3 mb-1">@Localizer["Auth.External.Heading"]</h1>
            <p class="text-secondary mb-4">@Localizer["Auth.External.Intro"]</p>

            @* tabindex="-1": focus target after AJAX swaps so keyboard focus never drops to <body> (A11Y). *@
            <div id="providers-list-container" aria-live="polite" tabindex="-1">
                <partial name="_ProvidersList" model="Model" />
            </div>
        </div>
    </div>
</div>

@* F8/MOD3/MOD5 — the data-confirm attributes on the Unlink forms are handled by
   form-ux.js, which the public _Layout loads site-wide. The previous cross-area
   render of the Admin _ConfirmModal partial was removed: it registered a second
   capture-phase submit interceptor with a different re-entry flag, causing a
   double confirm modal. *@

@section Scripts {
    <script src="~/assets/js/auth-providers.js" asp-append-version="true"></script>
}
