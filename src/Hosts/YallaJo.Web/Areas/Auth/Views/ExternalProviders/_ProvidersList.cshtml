@using System.Globalization
@model YallaJo.Web.Areas.Auth.Models.ExternalProviders.ExternalProvidersVm
@{
    var culture = CultureInfo.CurrentUICulture;
    string DateOnly(DateTime d) => d.ToString("yyyy-MM-dd", culture);
    string ProviderDisplay(string p) => culture.TextInfo.ToTitleCase(p);
    string ProviderIcon(string p) => p.ToLowerInvariant() switch
    {
        "google"   => "fa-google",
        "facebook" => "fa-facebook-f",
        _          => "fa-circle-user",
    };
}
@* Swappable linked + available provider cards (PE1: returned as a PartialView for
   AJAX unlink refreshes via WantsAjax(); Index renders it inline for the no-JS path).
   Both cards live here because unlinking changes both lists. *@

@* ── Linked accounts ───────────────────────────────────────────── *@
<div class="card shadow mb-4">
    <div class="card-header border-bottom">
        <h2 class="card-header-title h5 mb-0">@Localizer["Auth.External.LinkedHeading"]</h2>
    </div>
    <div class="card-body">
        @if (Model.LinkedListUnavailable)
        {
            <div class="alert alert-warning mb-0" role="alert">
                @Localizer["Auth.External.ListUnavailable"]
            </div>
        }
        else if (!Model.LinkedProviders.Any())
        {
            <p class="text-secondary mb-0">@Localizer["Auth.External.NoneLinked"]</p>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var link in Model.LinkedProviders)
                {
                    <li class="list-group-item d-flex align-items-center justify-content-between gap-3 px-0">
                        <div class="d-flex align-items-center gap-3">
                            <i class="fab @ProviderIcon(link.Provider) fa-fw fs-5" aria-hidden="true"></i>
                            <div>
                                <div class="fw-semibold">@ProviderDisplay(link.Provider)</div>
                                <div class="small text-secondary">
                                    @if (!string.IsNullOrEmpty(link.MaskedEmail))
                                    {
                                        <bdi dir="ltr" class="font-data">@link.MaskedEmail</bdi>
                                        <span aria-hidden="true"> · </span>
                                    }
                                    @Localizer["Auth.External.LinkedAt"] <bdi dir="ltr" class="font-data">@DateOnly(link.LinkedAt)</bdi>
                                </div>
                            </div>
                        </div>
                        <form asp-area="Auth" asp-controller="ExternalProviders" asp-action="Unlink"
                              asp-route-providerId="@link.ProviderId" method="post"
                              data-providers-ajax
                              data-confirm="@Localizer["Auth.External.UnlinkConfirm", ProviderDisplay(link.Provider)]"
                              data-confirm-title="@Localizer["Auth.External.UnlinkTitle"]"
                              data-confirm-action="@Localizer["Auth.External.Unlink"]"
                              data-success-msg="@Localizer["Auth.Flash.ProviderUnlinked"]"
                              data-error-msg="@Localizer["Auth.External.ActionFailed"]">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="fa-solid fa-link-slash fa-fw me-1" aria-hidden="true"></i>
                                @Localizer["Auth.External.Unlink"]
                            </button>
                        </form>
                    </li>
                }
            </ul>
        }
    </div>
</div>

@* ── Available providers (not yet linked) ──────────────────────── *@
<div class="card shadow">
    <div class="card-header border-bottom">
        <h2 class="card-header-title h5 mb-0">@Localizer["Auth.External.AvailableHeading"]</h2>
    </div>
    <div class="card-body">
        @if (!Model.IsGoogleAvailable && !Model.IsFacebookAvailable)
        {
            <div class="alert alert-warning mb-0" role="alert">
                @Localizer["Auth.External.NoneAvailable"]
            </div>
        }
        else
        {
            <div class="d-grid gap-3">
                @if (Model.IsGoogleAvailable)
                {
                    @if (Model.IsLinked("google"))
                    {
                        <div class="d-flex align-items-center justify-content-between text-secondary">
                            <span><i class="fab fa-google fa-fw me-2" aria-hidden="true"></i>Google</span>
                            <span class="badge bg-success bg-opacity-10 text-success">
                                <i class="fa-solid fa-circle-check fa-fw" aria-hidden="true"></i>
                                @Localizer["Auth.External.AlreadyLinked"]
                            </span>
                        </div>
                    }
                    else
                    {
                        @* OAuth link flow is a full navigation by design (redirect to the
                           provider) — never AJAX. *@
                        <form asp-area="Auth" asp-controller="ExternalAuth" asp-action="Challenge" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="provider" value="google" />
                            <input type="hidden" name="mode" value="link" />
                            <button type="submit" class="btn btn-outline-dark w-100">
                                <i class="fab fa-google fa-fw me-2" aria-hidden="true"></i>
                                @Localizer["Auth.External.LinkGoogle"]
                            </button>
                        </form>
                    }
                }
                @if (Model.IsFacebookAvailable)
                {
                    @if (Model.IsLinked("facebook"))
                    {
                        <div class="d-flex align-items-center justify-content-between text-secondary">
                            <span><i class="fab fa-facebook-f fa-fw me-2" aria-hidden="true"></i>Facebook</span>
                            <span class="badge bg-success bg-opacity-10 text-success">
                                <i class="fa-solid fa-circle-check fa-fw" aria-hidden="true"></i>
                                @Localizer["Auth.External.AlreadyLinked"]
                            </span>
                        </div>
                    }
                    else
                    {
                        <form asp-area="Auth" asp-controller="ExternalAuth" asp-action="Challenge" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="provider" value="facebook" />
                            <input type="hidden" name="mode" value="link" />
                            <button type="submit" class="btn btn-outline-primary w-100">
                                <i class="fab fa-facebook-f fa-fw me-2" aria-hidden="true"></i>
                                @Localizer["Auth.External.LinkFacebook"]
                            </button>
                        </form>
                    }
                }
            </div>
        }
    </div>
</div>
