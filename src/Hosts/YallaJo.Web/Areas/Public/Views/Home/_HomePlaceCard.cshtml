@model YallaJo.Web.Areas.Public.Models.Home.HomePlaceCardVm
@{
    var isAuthed = ViewData["isAuthed"] as bool? ?? false;
}

<div class="col-sm-6 col-xl-3">
    <div class="card border h-100 card-hover-shadow">
        <div class="position-relative">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name"
                     style="height:200px;object-fit:cover;" />
            }
            else
            {
                <div class="bg-light d-flex align-items-center justify-content-center"
                     style="height:200px;">
                    <i class="bi bi-geo-alt fs-1 text-body-secondary"></i>
                </div>
            }

            <div class="position-absolute top-0 start-0 p-2 d-flex gap-1">
                @if (Model.IsFeatured)
                {
                    <span class="badge text-bg-dark">Featured</span>
                }
            </div>

            <div class="position-absolute top-0 end-0 p-2">
                @if (isAuthed)
                {
                    <button type="button"
                            class="btn btn-sm btn-light rounded-circle js-favorite"
                            data-entity-type="Place" data-entity-id="@Model.Id"
                            title="Save to wishlist">
                        <i class="bi bi-heart"></i>
                    </button>
                }
                else
                {
                    <button type="button"
                            class="btn btn-sm btn-light rounded-circle" disabled
                            data-bs-toggle="tooltip" title="Log in to save">
                        <i class="bi bi-heart"></i>
                    </button>
                }
            </div>
        </div>

        <div class="card-body d-flex flex-column">
            <h6 class="card-title mb-1">
                <a asp-area="Public" asp-controller="Places" asp-action="Details" asp-route-slug="@Model.Slug"
                   class="stretched-link text-reset">@Model.Name</a>
            </h6>

            @if (!string.IsNullOrWhiteSpace(Model.Location))
            {
                <div class="small text-body-secondary mb-2">
                    <i class="bi bi-geo-alt me-1"></i>@Model.Location
                </div>
            }

            <div class="small text-warning mt-auto">
                <span class="text-body">@Model.AverageRating.ToString("0.0")</span>
                <i class="bi bi-star-fill"></i>
                <span class="text-body-secondary">(@Model.ReviewCount)</span>
            </div>
        </div>
    </div>
</div>
