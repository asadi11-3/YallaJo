@model YallaJo.Web.Areas.Public.Models.Home.HomePlaceCardVm
@{
    var isAuthed = ViewData["isAuthed"] as bool? ?? false;
}

@* Circle "destination" tile for the Explore-Nearby rail on the home page.
   Image -> rounded-circle, name, location, rating, with auth-aware favorite. *@
<div class="col-6 col-md-4 col-xl-2">
    <div class="card border-0 bg-transparent text-center h-100">
        <div class="position-relative d-inline-block">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="rounded-circle"
                     style="width:140px;height:140px;object-fit:cover;" alt="@Model.Name" />
            }
            else
            {
                <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center"
                     style="width:140px;height:140px;">
                    <i class="bi bi-geo-alt fs-1 text-body-secondary"></i>
                </div>
            }

            @if (Model.IsFeatured)
            {
                <span class="badge text-bg-dark position-absolute top-0 start-0">Featured</span>
            }

            <div class="position-absolute bottom-0 end-0">
                @if (isAuthed)
                {
                    <button type="button"
                            class="btn btn-sm btn-light rounded-circle js-favorite shadow-sm"
                            data-entity-type="Place" data-entity-id="@Model.Id"
                            title="Save to wishlist" aria-label="Save @Model.Name to wishlist">
                        <i class="bi bi-heart"></i>
                    </button>
                }
                else
                {
                    <button type="button"
                            class="btn btn-sm btn-light rounded-circle shadow-sm" disabled
                            data-bs-toggle="tooltip" title="Log in to save"
                            aria-label="Log in to save @Model.Name">
                        <i class="bi bi-heart"></i>
                    </button>
                }
            </div>
        </div>

        <div class="card-body p-2 pt-3">
            <h6 class="card-title mb-1">
                <a asp-area="Public" asp-controller="Places" asp-action="Details" asp-route-slug="@Model.Slug"
                   class="stretched-link text-reset">@Model.Name</a>
            </h6>
            @if (!string.IsNullOrWhiteSpace(Model.Location))
            {
                <div class="small text-body-secondary mb-1">@Model.Location</div>
            }
            <div class="small text-warning">
                <span class="text-body">@Model.AverageRating.ToString("0.0")</span>
                <i class="bi bi-star-fill"></i>
                <span class="text-body-secondary">(@Model.ReviewCount)</span>
            </div>
        </div>
    </div>
</div>
