                    <div class="d-sm-flex align-items-center">
                        <ul class="avatar-group mb-0 mb-md-2 mb-xl-0">
                            <li class="avatar avatar-xs"><img class="avatar-img rounded-circle" src="~/assets/images/avatar/01.jpg" alt="avatar"></li>
                            <li class="avatar avatar-xs"><img class="avatar-img rounded-circle" src="~/assets/images/avatar/02.jpg" alt="avatar"></li>
                            <li class="avatar avatar-xs"><img class="avatar-img rounded-circle" src="~/assets/images/avatar/03.jpg" alt="avatar"></li>
                            <li class="avatar avatar-xs"><img class="avatar-img rounded-circle" src="~/assets/images/avatar/04.jpg" alt="avatar"></li>
                        </ul>
                        <div class="ms-sm-3 mt-3 mt-sm-0">
                            <h6 class="mb-0">Trusted by 1M+ travelers</h6>
                            <ul class="list-inline mb-0 small">
                                <li class="list-inline-item me-0"><i class="fa-solid fa-star text-warning"></i></li>
                                <li class="list-inline-item me-0"><i class="fa-solid fa-star text-warning"></i></li>
                                <li class="list-inline-item me-0"><i class="fa-solid fa-star text-warning"></i></li>
                                <li class="list-inline-item me-0"><i class="fa-solid fa-star text-warning"></i></li>
                                <li class="list-inline-item me-0"><i class="fa-solid fa-star-half-stroke text-warning"></i></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            @* Right column: stacked imagery *@
            <div class="col-lg-6 position-relative mt-7 mt-lg-0">
                @* Decorative SVG behind right images *@
                <figure class="position-absolute top-50 start-0 translate-middle-y ms-n5 ms-md-n7 d-none d-md-block z-index-n1">
                    <svg width="465.5px" height="384.4px" viewBox="0 0 465.5 384.4">
                        <path class="fill-mode" d="M58.6,326.5c-19.9-25.6-37-54.7-46.6-85.7C2.4,209.8-0.6,176-3.7,143.6c-2.3-23.5-2.7-48,4.8-70.5
                            C16.3,28,62.5-1.4,108.4-12.6c45.9-11.2,93.9-7.2,141.1-3.1c33.5,2.9,67.5,5.9,99.1,17.4c52,18.9,94.3,62,114.4,113.5
                            s17.9,111.1-2.4,162.6c-12.4,31.5-31.8,60.4-57.7,82c-39.7,33.1-93.1,46.6-144.7,46c-51.6-0.6-102-14.5-149.7-34.3"/>
                    </svg>
                </figure>

                <img src="~/assets/images/bg/06.jpg" class="rounded-3" alt="Tour landscape">

                @* Small 24/7 badge *@
                <div class="position-absolute top-0 end-0 mt-4 me-n4 d-none d-md-block">
                    <div class="bg-body shadow rounded-3 p-3 text-center">
                        <h6 class="mb-0">24/7</h6>
                        <small class="small">Support</small>
                    </div>
                </div>

                @* Stacked round images *@
                <div class="position-absolute bottom-0 start-0 ms-n4 mb-n4 d-none d-md-block">
                    <div class="position-relative">
                        <img src="~/assets/images/category/hotel/4by3/11.jpg" class="rounded-circle border border-3 border-white" style="width:90px;height:90px;object-fit:cover;" alt="Tour">
                        <img src="~/assets/images/category/hotel/4by3/12.jpg" class="rounded-circle border border-3 border-white position-absolute" style="width:90px;height:90px;object-fit:cover;top:50px;left:50px;" alt="Tour">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@*========================== Check Availability search bar ==========================*@
<section class="pt-4 pt-md-5">
    <div class="container">
        <div class="card shadow rounded-3 p-3 p-md-4">
            @* Submits to Tours/Index — placeId is honored as a filter today;
               from/to/participants travel in the URL as future-filter intent. *@
            <form method="get" asp-area="Public" asp-controller="Search" asp-action="Index" class="row g-3 align-items-end">
                @* Location pill *@
                <div class="col-md-4">
                    <label for="heroLocation" class="form-label fw-semibold small mb-1">
                        <i class="bi bi-geo-alt me-1"></i>Where to?
                    </label>
                    <select id="heroLocation" name="placeId" class="form-select" data-choices>
                        <option value="">Any destination</option>
                        @if (Model.PopularPlaces is { Count: > 0 })
                        {
                            @foreach (var place in Model.PopularPlaces)
                            {
                                <option value="@place.Id">@place.Name@(string.IsNullOrWhiteSpace(place.City) ? "" : ", " + place.City)</option>
                            }
                        }
                    </select>
                </div>

                @* Date pill — Flatpickr range *@
                <div class="col-md-4">
                    <label for="heroDate" class="form-label fw-semibold small mb-1">
                        <i class="bi bi-calendar me-1"></i>When?
                    </label>
                    <input id="heroDate" type="text" class="form-control" placeholder="Select dates" autocomplete="off" />
                    <input type="hidden" name="from" id="heroDateFrom" />
                    <input type="hidden" name="to" id="heroDateTo" />
                </div>

                @* Participants pill (Adults + Children counter) *@
                <div class="col-md-3">
                    <label class="form-label fw-semibold small mb-1">
                        <i class="bi bi-people me-1"></i>Who?
                    </label>
                    <div class="dropdown">
                        <button class="form-select text-start" type="button" id="heroParticipantsToggle" data-bs-toggle="dropdown" aria-expanded="false">
                            <span id="heroParticipantsLabel">1 traveler</span>
                        </button>
                        <div class="dropdown-menu p-3 min-w-240" aria-labelledby="heroParticipantsToggle">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <div class="fw-semibold">Adults</div>
                                    <small class="text-body-secondary">Age 13+</small>
                                </div>
                                <div class="btn-group" role="group" aria-label="Adults counter">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-counter="adults" data-action="dec" aria-label="Decrease adults">−</button>
                                    <span class="btn btn-sm btn-light disabled" data-counter-value="adults">1</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-counter="adults" data-action="inc" aria-label="Increase adults">+</button>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">Children</div>
                                    <small class="text-body-secondary">Age 0–12</small>
                                </div>
                                <div class="btn-group" role="group" aria-label="Children counter">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-counter="children" data-action="dec" aria-label="Decrease children">−</button>
                                    <span class="btn btn-sm btn-light disabled" data-counter-value="children">0</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-counter="children" data-action="inc" aria-label="Increase children">+</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <input type="hidden" name="participants" id="heroParticipants" value="1" />
                </div>

                @* Submit pill *@
                <div class="col-md-1 d-grid">
                    <button type="submit" class="btn btn-primary" aria-label="Search">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

@*========================== About / Features ==========================*@
<section class="pt-5 pt-md-7">
    <div class="container">
        <div class="row align-items-center g-4 g-md-5">
            @* Left: image with rating overlay *@
            <div class="col-lg-6 position-relative">
                <img src="~/assets/images/category/hotel/4by3/11.jpg" class="rounded-3" alt="About YallaJo">
                <div class="card shadow rounded-3 p-3 w-sm-50 position-md-absolute bottom-0 end-0 mb-md-n4 me-md-n4 mt-3 mt-md-0">
                    <div class="d-flex align-items-center">
                        <i class="fa-solid fa-star fa-2x text-warning"></i>
                        <div class="ms-2">
                            <h6 class="mb-0">4.9 / 5.0</h6>
                            <small class="small">From 12,500+ reviews</small>
                        </div>
                    </div>
                </div>
            </div>

            @* Right: heading + 4 tour-ified feature icons *@
            <div class="col-lg-6">
                <h2 class="mb-3">Why book with YallaJo</h2>
                <p class="mb-4">Every tour is hand-picked and run by vetted local guides. Pay securely, book instantly, and travel with peace of mind.</p>

                <div class="row g-4">
                    <div class="col-sm-6 d-flex">
                        <div class="icon-lg bg-light text-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 avatar-48">
                            <i class="bi bi-shield-check fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="mb-1">Vetted local guides</h6>
                            <p class="small mb-0">Every guide is interviewed and rated by real travelers.</p>
                        </div>
                    </div>
                    <div class="col-sm-6 d-flex">
                        <div class="icon-lg bg-light text-success rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 avatar-48">
                            <i class="bi bi-lightning-charge fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="mb-1">Instant booking</h6>
                            <p class="small mb-0">Confirm your spot in seconds — no waiting for replies.</p>
                        </div>
                    </div>
                    <div class="col-sm-6 d-flex">
                        <div class="icon-lg bg-light text-info rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 avatar-48">
                            <i class="bi bi-lock fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="mb-1">Secure payments</h6>
                            <p class="small mb-0">Bank-grade encryption and full refund protection.</p>
                        </div>
                    </div>
                    <div class="col-sm-6 d-flex">
                        <div class="icon-lg bg-light text-warning rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 avatar-48">
                            <i class="bi bi-headset fs-4"></i>
                        </div>
                        <div class="ms-3">
                            <h6 class="mb-1">24/7 traveler support</h6>
                            <p class="small mb-0">Real humans on call, day or night, wherever you are.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@*========================== Featured Tours ==========================*@
@if (Model.HasFeatured)
{
    <section class="pt-5 pt-md-7">
        <div class="container">
            <div class="row mb-4 align-items-end">
                <div class="col-md-8">
                    <h2 class="mb-1">@Localizer["Home.Featured.Title"]</h2>
                    <p class="mb-0 text-body-secondary">Handpicked tours our travelers love.</p>
                </div>
                <div class="col-md-4 text-md-end">
                    <a asp-area="Public" asp-controller="Tours" asp-action="Index" class="btn btn-link p-0">
                        See all tours <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
            <div class="row g-4">
                @foreach (var tour in Model.FeaturedTours)
                {
                    <partial name="_TourCard" model="tour" view-data="@(new ViewDataDictionary(ViewData) { { "isAuthed", isAuthed }, { "colClass", "col-sm-6 col-xl-3" } })" />
                }
            </div>
        </div>
    </section>
}

@*========================== Explore Nearby (Places) ==========================*@
@if (Model.HasPopularPlaces)
{
    <section class="pt-5 pt-md-7">
        <div class="container">
            <div class="row mb-4 align-items-end">
                <div class="col-md-8">
                    <h2 class="mb-1">@Localizer["Home.Places.Title"]</h2>
                    <p class="mb-0 text-body-secondary">Iconic destinations worth the trip.</p>
                </div>
                <div class="col-md-4 text-md-end">
                    <a asp-area="Public" asp-controller="Places" asp-action="Index" class="btn btn-link p-0">
                        Browse all places <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
            <div class="row g-4 justify-content-center">
                @foreach (var place in Model.PopularPlaces)
                {
                    <partial name="_PlaceCircleCard" model="place" view-data="@(new ViewDataDictionary(ViewData) { { "isAuthed", isAuthed } })" />
                }
            </div>
        </div>
    </section>
}

@*========================== Popular Tours ==========================*@
@if (Model.HasPopular)
{
    <section class="pt-5 pt-md-7">
        <div class="container">
            <div class="row mb-4 align-items-end">
                <div class="col-md-8">
                    <h2 class="mb-1">@Localizer["Home.Popular.Title"]</h2>
                    <p class="mb-0 text-body-secondary">Trending experiences this week.</p>
                </div>
                <div class="col-md-4 text-md-end">
                    <a asp-area="Public" asp-controller="Tours" asp-action="Index" class="btn btn-link p-0">
                        See all tours <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
            <div class="row g-4">
                @foreach (var tour in Model.PopularTours)
                {
                    <partial name="_TourCard" model="tour" view-data="@(new ViewDataDictionary(ViewData) { { "isAuthed", isAuthed }, { "colClass", "col-sm-6 col-xl-3" } })" />
                }
            </div>
        </div>
    </section>
}

@*========================== Popular Businesses ==========================*@
@if (Model.HasPopularBusinesses)
{
    <section class="pt-5 pt-md-7">
        <div class="container">
            <div class="row mb-4 align-items-end">
                <div class="col-md-8">
                    <h2 class="mb-1">@Localizer["Home.Businesses.Title"]</h2>
                    <p class="mb-0 text-body-secondary">Local operators worth knowing.</p>
                </div>
                <div class="col-md-4 text-md-end">
                    <a asp-area="Public" asp-controller="Directory" asp-action="Index" class="btn btn-link p-0">
                        See all businesses <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
            <div class="row g-4">
                @foreach (var business in Model.PopularBusinesses)
                {
                    <partial name="_BusinessCard" model="business" view-data="@(new ViewDataDictionary(ViewData) { { "isAuthed", isAuthed }, { "colClass", "col-sm-6 col-xl-3" } })" />
                }
            </div>
        </div>
    </section>
}

@*========================== Categories ==========================*@
@if (Model.HasCategories)
{
    <section class="pt-5 pt-md-7 pb-5 pb-md-7">
        <div class="container">
            <div class="row mb-4">
                <div class="col-12 text-center">
                    <h2 class="mb-1">@Localizer["Home.Categories.Title"]</h2>
                    <p class="mb-0 text-body-secondary">Browse by what you love to do.</p>
                </div>
            </div>
            <div class="row g-3">
                @foreach (var cat in Model.Categories)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <a asp-area="Public" asp-controller="Tours" asp-action="Index" asp-route-categoryId="@cat.Id"
                           class="card border h-100 text-center text-decoration-none p-3 card-hover-shadow">
                            <i class="bi @(string.IsNullOrWhiteSpace(cat.Icon) ? "bi-tag" : cat.Icon) fs-2 text-primary mb-2"></i>
                            <div class="fw-semibold">@cat.Name</div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

@*========================== Empty state ==========================*@
@if (!Model.HasFeatured && !Model.HasPopular && !Model.HasPopularPlaces && !Model.HasPopularBusinesses && !Model.HasCategories)
{
    <section class="py-7">
        <div class="container text-center">
            <i class="bi bi-search fs-1 text-body-secondary mb-3"></i>
            <h3>Nothing to show yet</h3>
            <p class="text-body-secondary">We're hand-picking tours and experiences for you. Check back soon.</p>
        </div>
    </section>
}

@section Scripts {
    <script src="~/assets/js/home-index.js" asp-append-version="true"></script>
}

