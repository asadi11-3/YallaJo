                        </span>
                    </span>
                </h1>
                <p class="mb-4">Explore handpicked tours, local guides, and unforgettable destinations — booked instantly with secure payments and 24/7 support.</p>

                <a asp-area="Public" asp-controller="Tours" asp-action="Index" class="btn btn-primary mb-0">Discover Now</a>
                @* GLightbox modal — uses theme convention. JS will lazy-init on `.glightbox`. *@
                <a class="btn btn-link text-body p-0 mb-0 ms-2 glightbox" href="https://www.youtube.com/embed/tXHviS-4ygo" data-glightbox>
                    <i class="fa-solid fa-circle-play me-2"></i>Watch our story
                </a>

                @* Client rating card *@
