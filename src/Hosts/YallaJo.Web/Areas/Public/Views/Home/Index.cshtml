@model YallaJo.Web.Areas.Public.Models.Home.HomeVm
@using System.Text.Json
@using YallaJo.Web.Infrastructure.Seo
@using YallaJo.Web.Infrastructure.Maps
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["BodyClass"] = "yj-home-page";
    var isAuthed = User.Identity?.IsAuthenticated == true;

    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    ViewData.SetSeo(new SeoModel
    {
        Title = Localizer["Public.Seo.HomeTitle"].Value,
        Description = Localizer["Public.Seo.HomeDescription"].Value,
        Canonical = $"{baseUrl}/",
        OgImage = $"{baseUrl}/assets/images/bg/06.jpg",
        OgType = "website",
    });

    // Destinations map markers — built from the SAME dynamic PopularPlaces data (no static pins).
    // (0,0) means the place has no geocoordinates yet, so it is excluded from the map only.
    string? destMarkersJson = null;
    if (Model.HasPopularPlaces)
    {
        var pins = Model.PopularPlaces
            .Where(p => p.Latitude != 0 || p.Longitude != 0)
            .Select(p => new Dictionary<string, object?>
            {
                ["lat"] = p.Latitude,
                ["lng"] = p.Longitude,
                ["label"] = p.Name,
                ["url"] = Url.Action("Details", "Places", new { area = "Public", slug = p.Slug }),
            })
            .ToList();
        if (pins.Count > 0)
        {
            destMarkersJson = JsonSerializer.Serialize(pins);
        }
    }
}

@Html.AntiForgeryToken()

@*========================== 1. Hero ==========================*@
<section id="hero" class="yj-section-anchor pt-4 pt-md-5 position-relative overflow-hidden">
    @* Decorative desert-gold compass ornament on the sand canvas *@
    <svg class="yj-ornament top-0 end-0 mt-5 me-5" width="90" height="90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
        <circle cx="12" cy="12" r="10" />
        <path d="M12 2v3M12 19v3M2 12h3M19 12h3M12 7l1.8 3.2L17 12l-3.2 1.8L12 17l-1.8-3.2L7 12l3.2-1.8z" />
    </svg>

    <div class="container position-relative">
        <div class="row align-items-center g-4 g-lg-5">
            @* Left column: eyebrow + heading + lead + CTAs + trust row *@
            <div class="col-lg-6">
                <span class="yj-hero-pill mb-3">
                    <span class="yj-hero-pill-dot" aria-hidden="true"></span>@Localizer["Home.Hero.Pill"]
                </span>
                <h1 class="yj-hero-title mt-2 mb-3">
                    @Localizer["Home.Hero.Title1"]<span class="yj-hero-em-burgundy">@Localizer["Home.Hero.TitleAccent"]</span>@Localizer["Home.Hero.Title2"]<span class="yj-hero-em-gold">@Localizer["Home.Hero.TitleAccent2"]</span>@Localizer["Home.Hero.Title3"]
                </h1>
                <p class="lead text-body-secondary mb-4">@Localizer["Home.Hero.Lead"]</p>

                <div class="d-flex flex-wrap align-items-center gap-3 mb-4 mb-md-5">
                    <a asp-area="Public" asp-controller="Tours" asp-action="Index" class="btn btn-primary rounded-pill px-4 mb-0">
                        @Localizer["Home.Hero.Cta"]<i class="bi bi-arrow-right ic-arrow ms-2" aria-hidden="true"></i>
                    </a>
                    @* 'Watch our story' routes to Stories (Blog) until a real brand video exists (Phase 11 honesty rule). *@
                    <a asp-area="Public" asp-controller="Blog" asp-action="Index" class="btn btn-outline-dark rounded-pill px-4 mb-0">
                        <i class="bi bi-play-circle me-2" aria-hidden="true"></i>@Localizer["Home.Hero.Watch"]
                    </a>
                </div>

                @* Trust/stats row — avatars + presentation marketing copy (resx, approved as static UI chrome). *@
                <div class="yj-hero-stats">
                    <div class="yj-hero-stat yj-hero-stat-rating">
                        <div class="yj-avatar-group" aria-hidden="true">
                            <img src="~/assets/images/avatar/01.jpg" alt="" loading="lazy" decoding="async">
                            <img src="~/assets/images/avatar/02.jpg" alt="" loading="lazy" decoding="async">
                            <img src="~/assets/images/avatar/03.jpg" alt="" loading="lazy" decoding="async">
                        </div>
                        <div>
                            <span class="yj-hero-stat-num"><i class="bi bi-star-fill" aria-hidden="true"></i> @Localizer["Home.Hero.StatRating"]</span>
                            <span class="yj-hero-stat-sub">@Localizer["Home.Hero.StatRatingSub"]</span>
                        </div>
                    </div>
                    <div class="yj-hero-stat">
                        <span class="yj-hero-stat-num">@Localizer["Home.Hero.StatTours"]</span>
                        <span class="yj-hero-stat-sub">@Localizer["Home.Hero.StatToursSub"]</span>
                    </div>
                    <div class="yj-hero-stat">
                        <span class="yj-hero-stat-num">@Localizer["Home.Hero.StatGuides"]</span>
                        <span class="yj-hero-stat-sub">@Localizer["Home.Hero.StatGuidesSub"]</span>
                    </div>
                </div>
            </div>

            @* Right column: rounded hero photo + floating badge + destination thumbs *@
            <div class="col-lg-6">
                <div class="yj-hero-media">
                    <img src="~/assets/images/jordan/petra-hero.jpg" class="yj-hero-img" alt="@Localizer["Home.Hero.ImageAlt"]" fetchpriority="high">

                    @* Floating card: secure booking assurance (top-end) — static presentation chrome. *@
                    <div class="yj-hero-float-card yj-hero-float-top">
                        <span class="yj-hero-float-icon"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
                        <div>
                            <span class="yj-hero-float-title">@Localizer["Home.Hero.SecureTitle"]</span>
                            <span class="yj-hero-float-sub">@Localizer["Home.Hero.SecureSub"]</span>
                        </div>
                    </div>

                    @* Floating card: featured tour rating (bottom-end) — static presentation chrome. *@
                    <div class="yj-hero-float-card yj-hero-float-bottom">
                        <span class="yj-hero-float-icon yj-hero-float-icon-gold"><i class="bi bi-star-fill" aria-hidden="true"></i></span>
                        <div>
                            <span class="yj-hero-float-title">@Localizer["Home.Hero.RatingTitle"]</span>
                            <span class="yj-hero-float-sub">@Localizer["Home.Hero.RatingMeta"]</span>
                        </div>
                    </div>

                    @* Large Wadi Rum inset card overlapping the bottom-start corner. *@
                    <div class="yj-hero-inset">
                        <img src="~/assets/images/jordan/wadi-rum.jpg" alt="@Localizer["Home.Hero.Thumb1"]" loading="lazy" decoding="async">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@*========================== 2 & 3. Search / booking bar ==========================*@
<section id="search" class="yj-section-anchor pt-4 pt-md-5">
    <div class="container">
        <partial name="_SearchBar" model="Model.PopularPlaces" />
    </div>
</section>

@*========================== 4. Trust indicators row ==========================*@
<section id="trust" class="yj-section-anchor pt-5 pt-md-6">
    <div class="container">
        <div class="yj-feature-strip p-4 p-md-5">
            <div class="row g-4">
                <div class="col-sm-6 col-xl-3 d-flex align-items-start gap-3">
                    <span class="yj-feature-icon yj-fi-red"><i class="bi bi-bookmark-star" aria-hidden="true"></i></span>
                    <div>
                        <h6 class="mb-1">@Localizer["Home.Strip.HandpickedTitle"]</h6>
                        <p class="small text-body-secondary mb-0">@Localizer["Home.Strip.HandpickedText"]</p>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3 d-flex align-items-start gap-3">
                    <span class="yj-feature-icon yj-fi-green"><i class="bi bi-shield-lock" aria-hidden="true"></i></span>
                    <div>
                        <h6 class="mb-1">@Localizer["Home.Strip.SecureTitle"]</h6>
                        <p class="small text-body-secondary mb-0">@Localizer["Home.Strip.SecureText"]</p>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3 d-flex align-items-start gap-3">
                    <span class="yj-feature-icon yj-fi-gold"><i class="bi bi-person-badge" aria-hidden="true"></i></span>
                    <div>
                        <h6 class="mb-1">@Localizer["Home.Strip.ExpertsTitle"]</h6>
                        <p class="small text-body-secondary mb-0">@Localizer["Home.Strip.ExpertsText"]</p>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3 d-flex align-items-start gap-3">
                    <span class="yj-feature-icon yj-fi-red"><i class="bi bi-headset" aria-hidden="true"></i></span>
                    <div>
                        <h6 class="mb-1">@Localizer["Home.Strip.SupportTitle"]</h6>
                        <p class="small text-body-secondary mb-0">@Localizer["Home.Strip.SupportText"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@*========================== 5. Featured tours ==========================*@
@if (Model.HasFeatured)
{
    var featured = Model.FeaturedTours.ToList();
    var featuredWide = featured.Take(2).ToList();   // editor-pick highlights
    var featuredRest = featured.Skip(2).ToList();   // standard grid
    <section id="featured" class="yj-section-anchor pt-5 pt-md-7">
        <div class="container">
            <partial name="_SectionHeader" view-data="@(new ViewDataDictionary(ViewData) {
                { "SectionEyebrow", Localizer["Home.Featured.Eyebrow"].Value },
                { "SectionTitle", Localizer["Home.Featured.Title"].Value },
                { "SectionDescription", Localizer["Home.Featured.Subtitle"].Value },
                { "SectionActionText", Localizer["Home.SeeAllTours"].Value },
                { "SectionActionUrl", Url.Action("Index", "Tours", new { area = "Public" }) }
            })" />

            @* Category chips (truthful: derived from dynamic Categories). Client-side filter is progressive-enhancement. *@
            @if (Model.HasCategories)
            {
                <div class="yj-chips mb-4" role="group" aria-label="@Localizer["Home.Categories.Title"]">
                    <button type="button" class="yj-chip active" data-chip-filter="all">@Localizer["Home.Featured.AllChip"]</button>
                    @foreach (var cat in Model.Categories)
                    {
                        <a class="yj-chip" asp-area="Public" asp-controller="Tours" asp-action="Index" asp-route-categoryId="@cat.Id">@cat.Name</a>
                    }
                </div>
            }

            @* Two wide editor-pick highlights *@
            <div class="row g-4 mb-4">
                @foreach (var tour in featuredWide)
                {
                    <partial name="_TourCard" model="tour" view-data="@(new ViewDataDictionary(ViewData) { { "isAuthed", isAuthed }, { "colClass", "col-12 col-lg-6" }, { "CardVariant", "featured" } })" />
                }
            </div>

            @* Standard 3-up grid for the remaining featured tours *@
            @if (featuredRest.Count > 0)
            {
                <div class="row g-4">
                    @foreach (var tour in featuredRest)
                    {
                        <partial name="_TourCard" model="tour" view-data="@(new ViewDataDictionary(ViewData) { { "isAuthed", isAuthed }, { "colClass", "col-sm-6 col-lg-4" } })" />
                    }
                </div>
            }
        </div>
    </section>
}

@*========================== 6. Top destinations (cards + map) ==========================*@
@if (Model.HasPopularPlaces)
{
    var places = Model.PopularPlaces.ToList();
    <section id="destinations" class="yj-section-anchor pt-5 pt-md-7">
        <div class="container">
            <partial name="_SectionHeader" view-data="@(new ViewDataDictionary(ViewData) {
                { "SectionEyebrow", Localizer["Home.Places.Eyebrow"].Value },
                { "SectionTitle", Localizer["Home.Places.TitleLead"].Value },
                { "SectionAccent", Localizer["Home.Places.TitleAccent"].Value },
                { "SectionAccentGold", true },
                { "SectionDescription", Localizer["Home.Places.Subtitle"].Value },
                { "SectionActionText", Localizer["Home.BrowseAllPlaces"].Value },
                { "SectionActionUrl", Url.Action("Index", "Places", new { area = "Public" }) }
            })" />

            <div class="yj-dest-layout">
                @* Cards column (first in DOM => shows first on mobile) *@
                <div class="yj-dest-cards">
                    <div class="row g-4">
                        @{ var rank = 0; }
                        @foreach (var place in places)
                        {
                            rank++;
                            var isTall = rank == 1;
                            <partial name="_DestinationCard" model="place" view-data="@(new ViewDataDictionary(ViewData) {
                                { "isAuthed", isAuthed },
                                { "rank", rank },
                                { "tall", isTall },
                                { "colClass", isTall ? "col-12 col-sm-6" : "col-12 col-sm-6 col-xl-4" }
                            })" />
                        }
                    </div>
                </div>

                @* Map panel (after cards in DOM => below on mobile, side-by-side on desktop via CSS) *@
                @if (destMarkersJson is not null)
                {
                    <aside class="yj-dest-map-panel" aria-label="@Localizer["Home.Destinations.MapTitle"]">
                        <h3 class="yj-dest-map-title">@Localizer["Home.Destinations.MapTitle"]</h3>
                        <partial name="_Map" model="@(new MapVm { Mode = "pins", MarkersJson = destMarkersJson, CssClass = "yj-map-tall" })" />
                    </aside>
                }
            </div>
        </div>
    </section>
}

@*========================== 7. Popular right now (distinct rail) ==========================*@
@if (Model.HasPopular)
{
    <section id="popular" class="yj-section-anchor pt-5 pt-md-7">
        <div class="container">
            <partial name="_SectionHeader" view-data="@(new ViewDataDictionary(ViewData) {
                { "SectionEyebrow", Localizer["Home.Popular.Eyebrow"].Value },
                { "SectionTitle", Localizer["Home.Popular.Title"].Value },
                { "SectionDescription", Localizer["Home.Popular.Subtitle"].Value },
                { "SectionActionText", Localizer["Home.SeeAllTours"].Value },
                { "SectionActionUrl", Url.Action("Index", "Tours", new { area = "Public" }) }
            })" />

            <div class="yj-rail" data-rail>
                <button type="button" class="yj-rail-nav yj-rail-prev" data-rail-prev aria-label="@Localizer["Home.Popular.Prev"]">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                </button>
                <div class="yj-rail-track" data-rail-track>
                    @foreach (var tour in Model.PopularTours)
                    {
                        <partial name="_TourCard" model="tour" view-data="@(new ViewDataDictionary(ViewData) { { "isAuthed", isAuthed }, { "CardVariant", "popularRail" } })" />
                    }
                </div>
                <button type="button" class="yj-rail-nav yj-rail-next" data-rail-next aria-label="@Localizer["Home.Popular.Next"]">
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </section>
}

@*========================== 8. Local businesses ==========================*@
@if (Model.HasPopularBusinesses)
{
    <section id="businesses" class="yj-section-anchor pt-5 pt-md-7">
        <div class="container">
            <partial name="_SectionHeader" view-data="@(new ViewDataDictionary(ViewData) {
                { "SectionEyebrow", Localizer["Home.Businesses.Eyebrow"].Value },
                { "SectionTitle", Localizer["Home.Businesses.Title"].Value },
                { "SectionDescription", Localizer["Home.Businesses.Subtitle"].Value },
                { "SectionActionText", Localizer["Home.SeeAllBusinesses"].Value },
                { "SectionActionUrl", Url.Action("Index", "Directory", new { area = "Public" }) }
            })" />
            <div class="row g-4">
                @foreach (var business in Model.PopularBusinesses)
                {
                    <partial name="_BusinessExploreCard" model="business" view-data="@(new ViewDataDictionary(ViewData) { { "isAuthed", isAuthed }, { "colClass", "col-12 col-md-6 col-lg-4" } })" />
                }
            </div>
        </div>
    </section>
}

@*========================== 9. Browse by category ==========================*@
@if (Model.HasCategories)
{
    <section id="categories" class="yj-section-anchor pt-5 pt-md-7">
        <div class="container">
            <partial name="_SectionHeader" view-data="@(new ViewDataDictionary(ViewData) {
                { "SectionEyebrow", Localizer["Home.Categories.Eyebrow"].Value },
                { "SectionTitle", Localizer["Home.Categories.Title"].Value },
                { "SectionDescription", Localizer["Home.Categories.Subtitle"].Value },
                { "SectionCenter", true }
            })" />
            <div class="row g-3 g-md-4">
                @foreach (var cat in Model.Categories)
                {
                    <partial name="_CategoryCard" model="cat" view-data="@(new ViewDataDictionary(ViewData) { { "colClass", "col-6 col-md-4 col-lg-3" } })" />
                }
            </div>
        </div>
    </section>
}

@*========================== 10. Newsletter banner (UI-only, non-submitting) ==========================*@
<partial name="_NewsletterBanner" />

@*========================== Empty state ==========================*@
@if (!Model.HasFeatured && !Model.HasPopular && !Model.HasPopularPlaces && !Model.HasPopularBusinesses && !Model.HasCategories)
{
    <section class="py-7">
        <div class="container text-center">
            <i class="bi bi-search fs-1 text-body-secondary mb-3"></i>
            <h3>@Localizer["Home.Empty.Title"]</h3>
            <p class="text-body-secondary">@Localizer["Home.Empty.Text"]</p>
        </div>
    </section>
}

@section Scripts {
    @* Destinations map (reuses existing Mapbox loader; renders only when markers exist & Mapbox enabled). *@
    @if (Model.HasPopularPlaces)
    {
        <script src="~/assets/js/yj-map.js" asp-append-version="true"></script>
    }
    <script src="~/assets/js/home-index.js" asp-append-version="true"></script>
}
