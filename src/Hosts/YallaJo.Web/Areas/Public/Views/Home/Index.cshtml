@model YallaJo.Web.Areas.Public.Models.Home.HomeVm
@using YallaJo.Web.Infrastructure.Seo
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isAuthed = User.Identity?.IsAuthenticated == true;

    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    ViewData.SetSeo(new SeoModel
    {
        Title = "Explore Tours & Experiences",
        Description = "Discover and book hand-picked tours, guided experiences, local businesses and unforgettable places across Jordan with YallaJo.",
        Canonical = $"{baseUrl}/",
        OgImage = $"{baseUrl}/assets/images/bg/02.jpg",
        OgType = "website",
    });

    string Money(decimal amount, string currency) =>
        string.IsNullOrWhiteSpace(currency) ? amount.ToString("N0") : $"{amount:N0} {currency}";
}

@Html.AntiForgeryToken()

@functions {
    private static string Stars(decimal rating)
    {
        var full = (int)Math.Floor(rating);
        var sb = new System.Text.StringBuilder();
        for (var i = 1; i <= 5; i++)
            sb.Append(i <= full ? "<i class=\"bi bi-star-fill\"></i>" : "<i class=\"bi bi-star\"></i>");
        return sb.ToString();
    }
}

@* ─────────────────────────── Hero banner ─────────────────────────── *@
<section class="pt-3 pt-md-4">
    <div class="container">
        <div class="rounded-3 p-4 p-sm-5 position-relative overflow-hidden"
             style="background-image:url('@Url.Content("~/assets/images/bg/02.jpg")');background-size:cover;background-position:center;">
            <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-50"></div>
            <div class="position-relative text-white" style="max-width:640px;">
                <h1 class="text-white display-6 fw-bold mb-2">@Localizer["Home.Hero.Title"]</h1>
                <p class="lead text-white opacity-75 mb-4">
                    @Localizer["Home.Hero.Lead"]
                </p>

                <form asp-area="Public" asp-controller="Tours" asp-action="Index" method="get"
                      class="bg-mode shadow rounded-3 p-3">
                    <div class="row g-2 align-items-center">
                        <div class="col-12 col-md">
                            <label class="visually-hidden" for="heroSearch">@Localizer["Home.Search.Label"]</label>
                            <input id="heroSearch" name="q" type="text" class="form-control border-0"
                                   placeholder="@Localizer["Home.Search.Placeholder"]" />
                        </div>
                        <div class="col-12 col-md-auto d-grid">
                            <button type="submit" class="btn btn-dark mb-0">
                                <i class="bi bi-search me-1"></i> @Localizer["Home.Search.Button"]
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@* ─────────────────────────── Featured tours ─────────────────────────── *@
@if (Model.HasFeatured)
{
    <section class="pt-5">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <h2 class="mb-0">@Localizer["Home.Featured.Title"]</h2>
                    <p class="mb-0 text-body-secondary">@Localizer["Home.Featured.Subtitle"]</p>
                </div>
                <a asp-area="Public" asp-controller="Tours" asp-action="Index"
                   class="btn btn-sm btn-primary-soft mb-0">@Localizer["Home.ViewAll"]</a>
            </div>

            <div class="row g-4">
                @foreach (var tour in Model.FeaturedTours)
                {
                    <partial name="_HomeTourCard" model="tour" view-data="@(new ViewDataDictionary(ViewData) { { "isAuthed", isAuthed } })" />
                }
            </div>
        </div>
    </section>
}

@* ─────────────────────────── Popular tours ─────────────────────────── *@
@if (Model.HasPopular)
{
    <section class="pt-5">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <h2 class="mb-0">@Localizer["Home.Popular.Title"]</h2>
                    <p class="mb-0 text-body-secondary">@Localizer["Home.Popular.Subtitle"]</p>
                </div>
            </div>

            <div class="row g-4">
                @foreach (var tour in Model.PopularTours)
                {
                    <partial name="_HomeTourCard" model="tour" view-data="@(new ViewDataDictionary(ViewData) { { "isAuthed", isAuthed } })" />
                }
            </div>
        </div>
    </section>
}

@* ─────────────────────────── Popular places ─────────────────────────── *@
@if (Model.HasPopularPlaces)
{
    <section class="pt-5">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <h2 class="mb-0">@Localizer["Home.Places.Title"]</h2>
                    <p class="mb-0 text-body-secondary">@Localizer["Home.Places.Subtitle"]</p>
                </div>
                <a asp-area="Public" asp-controller="Places" asp-action="Index"
                   class="btn btn-sm btn-primary-soft mb-0">@Localizer["Home.ViewAll"]</a>
            </div>

            <div class="row g-4">
                @foreach (var place in Model.PopularPlaces)
                {
                    <partial name="_HomePlaceCard" model="place" view-data="@(new ViewDataDictionary(ViewData) { { "isAuthed", isAuthed } })" />
                }
            </div>
        </div>
    </section>
}

@* ─────────────────────────── Popular businesses ─────────────────────────── *@
@if (Model.HasPopularBusinesses)
{
    <section class="pt-5">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <h2 class="mb-0">@Localizer["Home.Businesses.Title"]</h2>
                    <p class="mb-0 text-body-secondary">@Localizer["Home.Businesses.Subtitle"]</p>
                </div>
                <a asp-area="Public" asp-controller="Directory" asp-action="Index"
                   class="btn btn-sm btn-primary-soft mb-0">@Localizer["Home.ViewAll"]</a>
            </div>

            <div class="row g-4">
                @foreach (var business in Model.PopularBusinesses)
                {
                    <partial name="_HomeBusinessCard" model="business" view-data="@(new ViewDataDictionary(ViewData) { { "isAuthed", isAuthed } })" />
                }
            </div>
        </div>
    </section>
}

@* ─────────────────────────── Top categories ─────────────────────────── *@
@if (Model.HasCategories)
{
    <section class="pt-5 pb-5">
        <div class="container">
            <div class="mb-4">
                <h2 class="mb-0">@Localizer["Home.Categories.Title"]</h2>
                <p class="mb-0 text-body-secondary">@Localizer["Home.Categories.Subtitle"]</p>
            </div>

            <div class="row g-3 g-xl-4">
                @foreach (var cat in Model.Categories)
                {
                    <div class="col-6 col-md-4 col-xl-3">
                        <a asp-area="Public" asp-controller="Tours" asp-action="Index" asp-route-q="@cat.Name"
                           class="card card-body border h-100 text-center text-reset text-decoration-none card-hover-shadow">
                            <div class="mb-2">
                                @if (!string.IsNullOrWhiteSpace(cat.Icon))
                                {
                                    <i class="bi @cat.Icon fs-3 text-primary"></i>
                                }
                                else
                                {
                                    <i class="bi bi-compass fs-3 text-primary"></i>
                                }
                            </div>
                            <h6 class="mb-0">@cat.Name</h6>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (!Model.HasFeatured && !Model.HasPopular && !Model.HasPopularPlaces && !Model.HasPopularBusinesses && !Model.HasCategories)
{
    <section class="py-6">
        <div class="container text-center">
            <img src="~/assets/images/element/17.svg" alt="" class="h-150px mb-3" />
            <h4>@Localizer["Home.Empty.Title"]</h4>
            <p class="text-body-secondary mb-3">@Localizer["Home.Empty.Subtitle"]</p>
            <a asp-area="Public" asp-controller="Tours" asp-action="Index" class="btn btn-primary">@Localizer["Home.BrowseAllTours"]</a>
        </div>
    </section>
}

@section Scripts {
    @* Favorite (.js-favorite) clicks are handled by the shared, authenticated-only
       ~/assets/js/favorites.js delegated handler loaded in _Layout — no inline dup here.
       Only the guest "Log in to save" tooltips are initialized below. *@
    <script src="~/assets/js/home-index.js" asp-append-version="true"></script>
}
