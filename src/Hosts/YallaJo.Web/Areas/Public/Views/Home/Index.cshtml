@model YallaJo.Web.Areas.Public.Models.Home.HomeVm
@using YallaJo.Web.Infrastructure.Seo
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["BodyClass"] = "yj-home-page";
    var isAuthed = User.Identity?.IsAuthenticated == true;

    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    ViewData.SetSeo(new SeoModel
    {
        Title = Localizer["Public.Seo.HomeTitle"].Value,
        Description = Localizer["Public.Seo.HomeDescription"].Value,
        Canonical = $"{baseUrl}/",
        OgImage = $"{baseUrl}/assets/images/bg/06.jpg",
        OgType = "website",
    });
}

@Html.AntiForgeryToken()

@*========================== Hero ==========================*@
<section class="pt-4 pt-md-5 position-relative overflow-hidden">
    @* Decorative desert-gold compass ornament on the sand canvas *@
    <svg class="yj-ornament top-0 end-0 mt-5 me-5" width="90" height="90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
        <circle cx="12" cy="12" r="10" />
        <path d="M12 2v3M12 19v3M2 12h3M19 12h3M12 7l1.8 3.2L17 12l-3.2 1.8L12 17l-1.8-3.2L7 12l3.2-1.8z" />
    </svg>

    <div class="container position-relative">
        <div class="row align-items-center g-4 g-lg-5">
            @* Left column: eyebrow + heading + lead + CTAs + trust row *@
            <div class="col-lg-6">
                <span class="yj-eyebrow mb-2">@Localizer["Home.Hero.Eyebrow"]</span>
                <h1 class="yj-hero-title mt-2 mb-3">
                    @Localizer["Home.Hero.Title1"]
                    <span class="text-primary">@Localizer["Home.Hero.TitleAccent"]</span>
                    @Localizer["Home.Hero.Title2"]
                </h1>
                <p class="lead text-body-secondary mb-4">@Localizer["Home.Hero.Lead"]</p>

                <div class="d-flex flex-wrap align-items-center gap-3 mb-4 mb-md-5">
                    <a asp-area="Public" asp-controller="Tours" asp-action="Index" class="btn btn-primary rounded-pill px-4 mb-0">@Localizer["Home.Hero.Cta"]</a>
                    @* 'Watch our story' routes to Stories (Blog) until a real brand video exists (Phase 11 honesty rule). *@
                    <a asp-area="Public" asp-controller="Blog" asp-action="Index" class="btn btn-outline-dark rounded-pill px-4 mb-0">
                        <i class="bi bi-play-circle me-2" aria-hidden="true"></i>@Localizer["Home.Hero.Watch"]
                    </a>
                </div>

                @* Trust row — honest copy only (Phase 11: no fabricated stats). *@
                <div class="d-flex align-items-center gap-3">
                    <div class="yj-avatar-group" aria-hidden="true">
                        <img src="~/assets/images/avatar/01.jpg" alt="">
                        <img src="~/assets/images/avatar/02.jpg" alt="">
                        <img src="~/assets/images/avatar/03.jpg" alt="">
                    </div>
                    <div>
                        <h6 class="mb-0">@Localizer["Home.Trust.Title"]</h6>
                        <small class="text-body-secondary">@Localizer["Home.Trust.Text"]</small>
                    </div>
                </div>
            </div>

            @* Right column: rounded hero photo + floating badge + destination thumbs *@
            <div class="col-lg-6">
                <div class="yj-hero-media">
                    @* TODO(content): placeholder from theme assets — swap assets/images/jordan/*.jpg for licensed Jordan photography. *@
                    <img src="~/assets/images/jordan/petra-hero.jpg" class="yj-hero-img" alt="@Localizer["Home.Hero.ImageAlt"]" fetchpriority="high">

                    <div class="yj-float-badge">
                        <span class="yj-badge-icon"><i class="bi bi-headset" aria-hidden="true"></i></span>
                        <div>
                            <h6 class="mb-0 small">24/7</h6>
                            <small class="small text-body-secondary">@Localizer["Home.Hero.SupportBadge"]</small>
                        </div>
                    </div>

                    <div class="yj-hero-thumbs">
                        <div class="yj-hero-thumb">
                            <img src="~/assets/images/jordan/wadi-rum.jpg" alt="">
                            <span class="yj-thumb-label">@Localizer["Home.Hero.Thumb1"]</span>
                        </div>
                        <div class="yj-hero-thumb">
                            <img src="~/assets/images/jordan/dead-sea.jpg" alt="">
                            <span class="yj-thumb-label">@Localizer["Home.Hero.Thumb2"]</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@*========================== Check Availability search bar ==========================*@
<section class="pt-4 pt-md-5">
    <div class="container">
        <div class="card shadow rounded-3 p-3 p-md-4">
            @* Submits to Tours/Index — placeId is honored as a filter today;
               from/to/participants travel in the URL as future-filter intent. *@
            @* Phase 4.1: hero search targets /tours directly (Search page retired; /search 301s here). from/to/participants ride along as URL intent until backend supports availability-window filtering. *@
            <form method="get" asp-area="Public" asp-controller="Tours" asp-action="Index" class="row g-3 align-items-end">
                @* Location pill *@
                <div class="col-md-4">
                    <label for="heroLocation" class="form-label fw-semibold small mb-1">
                        <i class="bi bi-geo-alt me-1"></i>@Localizer["Home.Search.Where"]
                    </label>
                    <select id="heroLocation" name="placeId" class="form-select" data-choices>
                        <option value="">@Localizer["Home.Search.AnyDestination"]</option>
                        @if (Model.PopularPlaces is { Count: > 0 })
                        {
                            @foreach (var place in Model.PopularPlaces)
                            {
                                <option value="@place.Id">@place.Name@(string.IsNullOrWhiteSpace(place.City) ? "" : ", " + place.City)</option>
                            }
                        }
                    </select>
                </div>

                @* Date pill — Flatpickr range *@
                <div class="col-md-4">
                    <label for="heroDate" class="form-label fw-semibold small mb-1">
                        <i class="bi bi-calendar me-1"></i>@Localizer["Home.Search.When"]
                    </label>
                    <input id="heroDate" type="text" class="form-control" placeholder="@Localizer["Home.Search.SelectDates"]" autocomplete="off" />
                    <input type="hidden" name="from" id="heroDateFrom" />
                    <input type="hidden" name="to" id="heroDateTo" />
                </div>

                @* Participants pill (Adults + Children counter) *@
                <div class="col-md-3">
                    <label class="form-label fw-semibold small mb-1">
                        <i class="bi bi-people me-1"></i>@Localizer["Home.Search.Who"]
                    </label>
                    <div class="dropdown">
                        <button class="form-select text-start" type="button" id="heroParticipantsToggle" data-bs-toggle="dropdown" aria-expanded="false">
                            @* Phase 9: localized plural words consumed by home-index.js via data attrs *@
                            <span id="heroParticipantsLabel"
                                  data-word-adult="@Localizer["Home.Search.WordAdult"]"
                                  data-word-adults="@Localizer["Home.Search.WordAdults"]"
                                  data-word-child="@Localizer["Home.Search.WordChild"]"
                                  data-word-children="@Localizer["Home.Search.WordChildren"]">1 @Localizer["Home.Search.WordAdult"]</span>
                        </button>
                        <div class="dropdown-menu p-3 min-w-240" aria-labelledby="heroParticipantsToggle">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <div class="fw-semibold">@Localizer["Home.Search.Adults"]</div>
                                    <small class="text-body-secondary">@Localizer["Home.Search.AdultsAge"]</small>
                                </div>
                                <div class="btn-group" role="group" aria-label="@Localizer["Home.Search.AdultsCounter"]">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-counter="adults" data-action="dec" aria-label="@Localizer["Home.Search.DecreaseAdults"]">−</button>
                                    <span class="btn btn-sm btn-light disabled" data-counter-value="adults">1</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-counter="adults" data-action="inc" aria-label="@Localizer["Home.Search.IncreaseAdults"]">+</button>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@Localizer["Home.Search.Children"]</div>
                                    <small class="text-body-secondary">@Localizer["Home.Search.ChildrenAge"]</small>
                                </div>
                                <div class="btn-group" role="group" aria-label="@Localizer["Home.Search.ChildrenCounter"]">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-counter="children" data-action="dec" aria-label="@Localizer["Home.Search.DecreaseChildren"]">−</button>
                                    <span class="btn btn-sm btn-light disabled" data-counter-value="children">0</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-counter="children" data-action="inc" aria-label="@Localizer["Home.Search.IncreaseChildren"]">+</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <input type="hidden" name="participants" id="heroParticipants" value="1" />
                </div>

                @* Submit pill *@
                <div class="col-md-1 d-grid">
                    <button type="submit" class="btn btn-primary" aria-label="@Localizer["Navbar.Search"]">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

@*========================== Feature strip ==========================*@
<section class="pt-5 pt-md-6">
    <div class="container">
        <div class="yj-feature-strip p-4 p-md-5">
            <div class="row g-4">
                <div class="col-sm-6 col-xl-3 d-flex align-items-start gap-3">
                    <span class="yj-feature-icon yj-fi-red"><i class="bi bi-bookmark-star" aria-hidden="true"></i></span>
                    <div>
                        <h6 class="mb-1">@Localizer["Home.Strip.HandpickedTitle"]</h6>
                        <p class="small text-body-secondary mb-0">@Localizer["Home.Strip.HandpickedText"]</p>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3 d-flex align-items-start gap-3">
                    <span class="yj-feature-icon yj-fi-green"><i class="bi bi-shield-lock" aria-hidden="true"></i></span>
                    <div>
                        <h6 class="mb-1">@Localizer["Home.Strip.SecureTitle"]</h6>
                        <p class="small text-body-secondary mb-0">@Localizer["Home.Strip.SecureText"]</p>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3 d-flex align-items-start gap-3">
                    <span class="yj-feature-icon yj-fi-gold"><i class="bi bi-person-badge" aria-hidden="true"></i></span>
                    <div>
                        <h6 class="mb-1">@Localizer["Home.Strip.ExpertsTitle"]</h6>
                        <p class="small text-body-secondary mb-0">@Localizer["Home.Strip.ExpertsText"]</p>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3 d-flex align-items-start gap-3">
                    <span class="yj-feature-icon yj-fi-red"><i class="bi bi-headset" aria-hidden="true"></i></span>
                    <div>
                        <h6 class="mb-1">@Localizer["Home.Strip.SupportTitle"]</h6>
                        <p class="small text-body-secondary mb-0">@Localizer["Home.Strip.SupportText"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@*========================== Featured Tours ==========================*@
@if (Model.HasFeatured)
{
    <section class="pt-5 pt-md-7">
        <div class="container">
            <div class="row mb-4 align-items-end">
                <div class="col-md-8">
                    <span class="yj-eyebrow">@Localizer["Home.Featured.Eyebrow"]</span>
                    <h2 class="mb-1 mt-2">@Localizer["Home.Featured.Title"]</h2>
                    <p class="mb-0 text-body-secondary">@Localizer["Home.Featured.Subtitle"]</p>
                </div>
                <div class="col-md-4 text-md-end">
                    <a asp-area="Public" asp-controller="Tours" asp-action="Index" class="btn btn-link p-0">
                        @Localizer["Home.SeeAllTours"] <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
            <div class="row g-4">
                @foreach (var tour in Model.FeaturedTours)
                {
                    <partial name="_TourCard" model="tour" view-data="@(new ViewDataDictionary(ViewData) { { "isAuthed", isAuthed }, { "colClass", "col-sm-6 col-xl-3" } })" />
                }
            </div>
        </div>
    </section>
}

@*========================== Explore Nearby (Places) ==========================*@
@if (Model.HasPopularPlaces)
{
    <section class="pt-5 pt-md-7">
        <div class="container">
            <div class="row mb-4 align-items-end">
                <div class="col-md-8">
                    <span class="yj-eyebrow">@Localizer["Home.Places.Eyebrow"]</span>
                    <h2 class="mb-1 mt-2">
                        @Localizer["Home.Places.TitleLead"]
                        <span class="d-md-block text-warning">@Localizer["Home.Places.TitleAccent"]</span>
                    </h2>
                    <p class="mb-0 text-body-secondary">@Localizer["Home.Places.Subtitle"]</p>
                </div>
                <div class="col-md-4 text-md-end">
                    <a asp-area="Public" asp-controller="Places" asp-action="Index" class="btn btn-link p-0">
                        @Localizer["Home.BrowseAllPlaces"] <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
            <div class="row g-4 justify-content-center">
                @foreach (var place in Model.PopularPlaces)
                {
                    <partial name="_PlaceCircleCard" model="place" view-data="@(new ViewDataDictionary(ViewData) { { "isAuthed", isAuthed } })" />
                }
            </div>
        </div>
    </section>
}

@*========================== Popular Tours ==========================*@
@if (Model.HasPopular)
{
    <section class="pt-5 pt-md-7">
        <div class="container">
            <div class="row mb-4 align-items-end">
                <div class="col-md-8">
                    <span class="yj-eyebrow">@Localizer["Home.Popular.Eyebrow"]</span>
                    <h2 class="mb-1 mt-2">@Localizer["Home.Popular.Title"]</h2>
                    <p class="mb-0 text-body-secondary">@Localizer["Home.Popular.Subtitle"]</p>
                </div>
                <div class="col-md-4 text-md-end">
                    <a asp-area="Public" asp-controller="Tours" asp-action="Index" class="btn btn-link p-0">
                        @Localizer["Home.SeeAllTours"] <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
            <div class="row g-4">
                @foreach (var tour in Model.PopularTours)
                {
                    <partial name="_TourCard" model="tour" view-data="@(new ViewDataDictionary(ViewData) { { "isAuthed", isAuthed }, { "colClass", "col-sm-6 col-xl-3" } })" />
                }
            </div>
        </div>
    </section>
}

@*========================== Popular Businesses ==========================*@
@if (Model.HasPopularBusinesses)
{
    <section class="pt-5 pt-md-7">
        <div class="container">
            <div class="row mb-4 align-items-end">
                <div class="col-md-8">
                    <span class="yj-eyebrow">@Localizer["Home.Businesses.Eyebrow"]</span>
                    <h2 class="mb-1 mt-2">@Localizer["Home.Businesses.Title"]</h2>
                    <p class="mb-0 text-body-secondary">@Localizer["Home.Businesses.Subtitle"]</p>
                </div>
                <div class="col-md-4 text-md-end">
                    <a asp-area="Public" asp-controller="Directory" asp-action="Index" class="btn btn-link p-0">
                        @Localizer["Home.SeeAllBusinesses"] <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
            <div class="row g-4">
                @foreach (var business in Model.PopularBusinesses)
                {
                    <partial name="_BusinessCard" model="business" view-data="@(new ViewDataDictionary(ViewData) { { "isAuthed", isAuthed }, { "colClass", "col-sm-6 col-xl-3" } })" />
                }
            </div>
        </div>
    </section>
}

@*========================== Categories ==========================*@
@if (Model.HasCategories)
{
    <section class="pt-5 pt-md-7 pb-5 pb-md-7">
        <div class="container">
            <div class="row mb-4">
                <div class="col-12 text-center">
                    <span class="yj-eyebrow justify-content-center">@Localizer["Home.Categories.Eyebrow"]</span>
                    <h2 class="mb-1 mt-2">@Localizer["Home.Categories.Title"]</h2>
                    <p class="mb-0 text-body-secondary">@Localizer["Home.Categories.Subtitle"]</p>
                </div>
            </div>
            <div class="row g-3">
                @foreach (var cat in Model.Categories)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <a asp-area="Public" asp-controller="Tours" asp-action="Index" asp-route-categoryId="@cat.Id"
                           class="card border h-100 text-center text-decoration-none p-3 card-hover-shadow">
                            <i class="bi @(string.IsNullOrWhiteSpace(cat.Icon) ? "bi-tag" : cat.Icon) fs-2 text-primary mb-2"></i>
                            <div class="fw-semibold">@cat.Name</div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

@*========================== Empty state ==========================*@
@if (!Model.HasFeatured && !Model.HasPopular && !Model.HasPopularPlaces && !Model.HasPopularBusinesses && !Model.HasCategories)
{
    <section class="py-7">
        <div class="container text-center">
            <i class="bi bi-search fs-1 text-body-secondary mb-3"></i>
            <h3>@Localizer["Home.Empty.Title"]</h3>
            <p class="text-body-secondary">@Localizer["Home.Empty.Text"]</p>
        </div>
    </section>
}

@section Scripts {
    <script src="~/assets/js/home-index.js" asp-append-version="true"></script>
}
