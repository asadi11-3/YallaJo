@model YallaJo.Web.Areas.Public.Models.Help.HelpDetailVm
@{
    ViewData["Title"] = Model.Question;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="pt-3 pt-lg-5">
    <div class="container">
        <nav class="mb-3" aria-label="breadcrumb">
            <ol class="breadcrumb breadcrumb-dots mb-0">
                <li class="breadcrumb-item"><a asp-area="Public" asp-controller="Help" asp-action="Index">Help center</a></li>
                <li class="breadcrumb-item active" aria-current="page">Article</li>
            </ol>
        </nav>

        <div class="row g-4 g-lg-5">
            <div class="col-lg-8 mx-auto">
                <div class="card shadow">
                    <div class="card-header border-bottom">
                        <h1 class="card-header-title h3 mb-0">@Model.Question</h1>
                    </div>
                    <div class="card-body">
                        <div class="preserve-whitespace">@Model.Answer</div>
                    </div>
                    <div class="card-footer border-top d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <span class="small text-muted mb-0">Didn't find what you were looking for?</span>
                        <a class="btn btn-sm btn-primary mb-0"
                           asp-area="Public" asp-controller="Contact" asp-action="Index">
                            Contact support
                        </a>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a class="btn btn-link" asp-area="Public" asp-controller="Help" asp-action="Index">
                        <i class="bi bi-arrow-left me-1"></i>Back to help center
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
