@model YallaJo.Web.Areas.Public.Models.AccessibilityReviews.AccessibilityReviewListVm
@using YallaJo.Web.Areas.Public.Models.AccessibilityReviews
@using YallaJo.Web.Infrastructure.Authentication.Claims
@{
    var isAuthed = User.Identity?.IsAuthenticated == true;
    var currentUserId = Guid.TryParse(User.FindFirst(AppClaimTypes.UserId)?.Value, out var uid) ? uid : Guid.Empty;
    @* Phase 5: forms target the unified ReviewsController (reviews/{targetType}/{targetId}/accessibility...). *@
    var targetToken = Model.TargetType switch
    {
        "Business" => "business",
        "Tour" => "tour",
        "TourGuide" => "guide",
        _ => "place"
    };
    var returnUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
    var featureKinds = AccessibilityReviewMapper.FeatureKinds;

    string Stars(decimal rating)
    {
        var full = (int)System.Math.Round(rating, System.MidpointRounding.AwayFromZero);
        var sb = new System.Text.StringBuilder();
        for (var i = 1; i <= 5; i++)
        {
            sb.Append(i <= full
                ? "<i class=\"bi bi-star-fill text-warning\" aria-hidden=\"true\"></i>"
                : "<i class=\"bi bi-star text-warning\" aria-hidden=\"true\"></i>");
        }
        return sb.ToString();
    }
}

<section class="pb-5" id="accessibility-reviews">
    <div class="container">
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
            <h2 class="h4 mb-0"><i class="bi bi-universal-access me-2" aria-hidden="true"></i>Accessibility reviews</h2>
            <span class="text-secondary">@Model.TotalCount review@(Model.TotalCount == 1 ? "" : "s")</span>
        </div>

        @if (Model.HasResults)
        {
            <div class="vstack gap-3">
                @foreach (var review in Model.Items)
                {
                    var ownReview = isAuthed && currentUserId != Guid.Empty && review.UserId == currentUserId;
                    <div class="card border">
                        <div class="card-body">
                            <div class="d-flex flex-wrap align-items-center justify-content-between mb-1">
                                <div>
                                    @Html.Raw(Stars(review.Rating))
                                    @if (!string.IsNullOrWhiteSpace(review.Title))
                                    {
                                        <span class="fw-semibold ms-2">@review.Title</span>
                                    }
                                </div>
                                <div class="text-secondary small">
                                    <span class="me-2">@review.AuthorHandle</span>
                                    <span><i class="bi bi-calendar3 me-1" aria-hidden="true"></i>@review.CreatedAt.ToString("d MMM yyyy")</span>
                                </div>
                            </div>

                            @if (review.FeatureTypes.Count > 0)
                            {
                                <div class="mb-2">
                                    @foreach (var f in review.FeatureTypes)
                                    {
                                        <span class="badge text-bg-light border me-1">@f</span>
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(review.Content))
                            {
                                <p class="mb-1 preserve-whitespace">@review.Content</p>
                            }
                            @if (review.VisitDate is { } vd)
                            {
                                <span class="text-secondary small"><i class="bi bi-geo-alt me-1" aria-hidden="true"></i>Visited @vd.ToString("MMM yyyy")</span>
                            }

                            @if (ownReview && review.IsWithinEditWindow)
                            {
                                <div class="mt-3">
                                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#edit-ar-@review.Id" aria-expanded="false">Edit your review</button>
                                    <div class="collapse mt-3" id="edit-ar-@review.Id">
                                        <form method="post" asp-area="Public" asp-controller="Reviews" asp-action="EditAccessibilityReview" asp-route-targetType="@targetToken" asp-route-targetId="@Model.TargetId" asp-route-reviewId="@review.Id" class="border rounded p-3" data-loading>
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <div class="mb-2">
                                                <label class="form-label small" for="editArRating-@review.Id">Rating</label>
                                                <select id="editArRating-@review.Id" name="AccessibilityReview.Rating" class="form-select form-select-sm">
                                                    @for (var i = 5; i >= 1; i--)
                                                    {
                                                        <option value="@i" selected="@(review.Rating == i)">@i</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label small" for="editArTitle-@review.Id">Title</label>
                                                <input id="editArTitle-@review.Id" name="AccessibilityReview.Title" value="@review.Title" maxlength="200" class="form-control form-control-sm" />
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label small" for="editArContent-@review.Id">Review</label>
                                                <textarea id="editArContent-@review.Id" name="AccessibilityReview.Content" minlength="10" maxlength="5000" rows="3" required class="form-control form-control-sm">@review.Content</textarea>
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label small d-block">Accessibility features</label>
                                                @foreach (var kind in featureKinds)
                                                {
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input" type="checkbox" name="AccessibilityReview.FeatureTypes" value="@kind"
                                                               id="editArFeat-@review.Id-@kind" checked="@(review.FeatureTypes.Contains(kind))" />
                                                        <label class="form-check-label small" for="editArFeat-@review.Id-@kind">@kind</label>
                                                    </div>
                                                }
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label small" for="editArVisit-@review.Id">Visit date</label>
                                                <input id="editArVisit-@review.Id" type="date" name="AccessibilityReview.VisitDate" value="@review.VisitDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                                            </div>
                                            <button type="submit" class="btn btn-sm btn-primary">Save changes</button>
                                        </form>
                                    </div>
                                </div>
                            }
                            @if (ownReview)
                            {
                                <form method="post" asp-area="Public" asp-controller="Reviews" asp-action="DeleteAccessibilityReview" asp-route-targetType="@targetToken" asp-route-targetId="@Model.TargetId" asp-route-reviewId="@review.Id" class="mt-2"
                                      onsubmit="return confirm('Delete your accessibility review? This cannot be undone.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete your review</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-secondary">No accessibility reviews yet. Share your accessibility experience to help others.</p>
        }

        @if (isAuthed)
        {
            <div class="card border mt-3">
                <div class="card-body">
                    <h3 class="h6">Write an accessibility review</h3>
                    <form method="post" asp-area="Public" asp-controller="Reviews" asp-action="CreateAccessibilityReview" asp-route-targetType="@targetToken" asp-route-targetId="@Model.TargetId" data-loading>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <div class="row g-2">
                            <div class="col-sm-3">
                                <label class="form-label small" for="arRating">Rating</label>
                                <select id="arRating" name="AccessibilityReview.Rating" class="form-select form-select-sm">
                                    @for (var i = 5; i >= 1; i--)
                                    {
                                        <option value="@i">@i</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-9">
                                <label class="form-label small" for="arTitle">Title</label>
                                <input id="arTitle" name="AccessibilityReview.Title" maxlength="200" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="mt-2">
                            <label class="form-label small" for="arContent">Your accessibility experience</label>
                            <textarea id="arContent" name="AccessibilityReview.Content" minlength="10" maxlength="5000" rows="3" required class="form-control form-control-sm"
                                      placeholder="Describe accessibility (entrances, restrooms, signage, staff assistance, etc.)"></textarea>
                        </div>
                        <div class="mt-2">
                            <label class="form-label small d-block">Accessibility features <span class="text-secondary">(select at least one)</span></label>
                            @foreach (var kind in featureKinds)
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" name="AccessibilityReview.FeatureTypes" value="@kind" id="arFeat-@kind" />
                                    <label class="form-check-label small" for="arFeat-@kind">@kind</label>
                                </div>
                            }
                        </div>
                        <div class="mt-2 max-w-220">
                            <label class="form-label small" for="arVisit">Visit date</label>
                            <input id="arVisit" type="date" name="AccessibilityReview.VisitDate" class="form-control form-control-sm" />
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary mt-3">
                            <i class="bi bi-send me-1" aria-hidden="true"></i>Submit accessibility review
                        </button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="mt-3">
                <a class="btn btn-outline-primary btn-sm" asp-area="Auth" asp-controller="Auth" asp-action="SignIn" asp-route-returnUrl="@returnUrl">
                    <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>Sign in to write an accessibility review
                </a>
            </div>
        }
    </div>
</section>
