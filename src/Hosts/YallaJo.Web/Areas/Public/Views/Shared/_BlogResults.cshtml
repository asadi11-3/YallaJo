@model YallaJo.Web.Areas.Public.Models.Blog.BlogsGridVm
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@*
    Phase 7: results fragment for the blog listing.
    Rendered inside Blog/Index.cshtml on full page loads and returned
    standalone for AJAX requests (WantsAjax); swapped client-side by listing.js.
*@
@if (Model.HasResults)
{
    <div class="row g-3 g-md-4">
        @foreach (var post in Model.Posts)
        {
            <div class="col-sm-6 col-xl-4">
                <article class="card border h-100 card-hover-shadow position-relative">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-journal-text fs-4 text-primary me-2" aria-hidden="true"></i>
                            @if (post.IsFeatured)
                            {
                                <span class="badge text-bg-warning">@Localizer["Public.Featured"]</span>
                            }
                        </div>
                        <h2 class="h5">
                            <a class="stretched-link text-reset" asp-area="Public" asp-controller="Blog" asp-action="Post" asp-route-slug="@post.Slug">@post.Title</a>
                        </h2>
                        @if (!string.IsNullOrWhiteSpace(post.Summary))
                        {
                            <p class="text-secondary small text-truncate-3">@post.Summary</p>
                        }
                        <div class="d-flex align-items-center text-secondary small mt-2">
                            @if (post.PublishedAt is { } published)
                            {
                                <span><i class="bi bi-calendar3 me-1" aria-hidden="true"></i>@published.ToString("d MMM yyyy")</span>
                            }
                            @if (post.ReadTimeMinutes is > 0)
                            {
                                <span class="ms-3"><i class="bi bi-clock me-1" aria-hidden="true"></i>@Localizer["Public.ReadTime", post.ReadTimeMinutes]</span>
                            }
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>

    @if (Model.HasPreviousPage || Model.HasNextPage)
    {
        <nav aria-label="@Localizer["Public.Blog.pagination"]" class="mt-4">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-area="Public" asp-controller="Blog" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)">@Localizer["Public.Previous"]</a>
                </li>
                <li class="page-item active"><span class="page-link">@Model.PageNumber</span></li>
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-area="Public" asp-controller="Blog" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)">@Localizer["Public.Next"]</a>
                </li>
            </ul>
        </nav>
    }
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-journal-text display-4 text-secondary" aria-hidden="true"></i>
        <h2 class="h5 mt-3">@Localizer["Public.No.articles.yet"]</h2>
        <p class="text-secondary">@Localizer["Public.Check.back.soon.for.travel.stories.and.guides"]</p>
        <a class="btn btn-primary" asp-area="Public" asp-controller="Tours" asp-action="Index">@Localizer["Public.Browse.all.tours"]</a>
    </div>
}
