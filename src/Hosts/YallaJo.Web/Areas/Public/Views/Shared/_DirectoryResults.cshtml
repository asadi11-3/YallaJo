@model YallaJo.Web.Areas.Public.Models.Directory.DirectoryVm
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@*
    Phase 7: results fragment for the business directory listing.
    Rendered inside Directory/Index.cshtml on full page loads and returned
    standalone for AJAX requests (WantsAjax); swapped client-side by listing.js.
*@
@{
    var isAuthed = User.Identity?.IsAuthenticated == true;
    var firstResult = Model.TotalCount == 0 ? 0 : ((Model.PageNumber - 1) * Model.PageSize) + 1;
    var lastResult = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount);
}
<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <h5 class="mb-2 mb-sm-0">
        @if (Model.HasResults)
        {
            <text>@Localizer["Public.ShowingPlaces", firstResult, lastResult, Model.TotalCount]</text>
        }
        else
        {
            <text>@Localizer["Public.No.places.found"]</text>
        }
    </h5>
</div>

@if (!Model.HasResults)
{
    <div class="text-center py-5">
        <img src="@Url.Content("~/assets/images/element/17.svg")" class="h-100px mb-3" alt="@Localizer["Public.No.results"]" />
        <h5 class="mb-1">@Localizer["Public.Nothing.matched.your.search"]</h5>
        <p class="mb-0">@Localizer["Public.Try.a.different.category.city.or.search.term"]</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var biz in Model.Businesses)
        {
            @* Shared card partial (Phase 3.3 consistency: card-hover-shadow + col-md-6 col-xl-4 grid) *@
            <partial name="_BusinessCard"
                     model="biz"
                     view-data='@(new ViewDataDictionary(ViewData) { { "isAuthed", isAuthed }, { "colClass", "col-md-6 col-xl-4" } })' />
        }
    </div>

    @* Pagination (shared partial preserves query string, swaps page) *@
    <partial name="_Pagination"
             model='new YallaJo.Web.Areas.Public.Models.Shared.PaginationVm { PageNumber = Model.PageNumber, TotalPages = Model.TotalPages, AriaLabel = Localizer["Public.Directory.pages"] }' />
}
