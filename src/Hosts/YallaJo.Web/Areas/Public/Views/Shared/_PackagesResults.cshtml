@model YallaJo.Web.Areas.Public.Models.Packages.PackagesGridVm
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@*
    Phase 7: results fragment for the packages listing.
    Rendered inside Packages/Index.cshtml on full page loads and returned
    standalone for AJAX requests (WantsAjax); swapped client-side by listing.js.
*@
@{
    string Money(decimal amount, string currency) =>
        string.IsNullOrWhiteSpace(currency) ? amount.ToString("N0") : $"{amount:N0} {currency}";
}
@if (Model.HasResults)
{
    <div class="row g-3 g-md-4">
        @foreach (var package in Model.Packages)
        {
            <div class="col-sm-6 col-xl-4">
                <div class="card border h-100 card-hover-shadow">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge text-bg-primary">@Localizer["Public.Tours.Count", package.IncludedTourCount]</span>
                            <span class="h6 mb-0 text-primary">@Money(package.PriceAmount, package.Currency)</span>
                        </div>
                        <h2 class="h5 card-title mb-2">
                            <a class="stretched-link text-reset" asp-area="Public" asp-controller="Packages" asp-action="Detail" asp-route-id="@package.Id">@package.Name</a>
                        </h2>
                        @if (!string.IsNullOrWhiteSpace(package.Description))
                        {
                            <p class="text-body-secondary small mb-3 text-truncate-3">@package.Description</p>
                        }
                        @if (package.HasValidity)
                        {
                            <p class="small text-body-secondary mb-3">
                                <i class="bi bi-calendar-event me-1" aria-hidden="true"></i>
                                @if (package.ValidFrom is not null && package.ValidTo is not null)
                                {
                                    @($"{package.ValidFrom:d MMM yyyy} – {package.ValidTo:d MMM yyyy}")
                                }
                                else if (package.ValidFrom is not null)
                                {
                                    @Localizer["Public.ValidFrom", $"{package.ValidFrom:d MMM yyyy}"]
                                }
                                else
                                {
                                    @Localizer["Public.ValidUntil", $"{package.ValidTo:d MMM yyyy}"]
                                }
                            </p>
                        }
                        @* Phase 8.3: visible CTA in addition to the stretched-link title. *@
                        <div class="mt-auto">
                            <a class="btn btn-sm btn-primary position-relative z-index-2" asp-area="Public" asp-controller="Packages" asp-action="Detail" asp-route-id="@package.Id" aria-label="@Localizer["Public.ViewPackage"] – @package.Name">@Localizer["Public.ViewPackage"]</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.HasPreviousPage || Model.HasNextPage)
    {
        <nav class="mt-4" aria-label="@Localizer["Public.Packages.pages"]">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-area="Public" asp-controller="Packages" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)" tabindex="@(Model.HasPreviousPage ? "0" : "-1")">@Localizer["Public.Previous"]</a>
                </li>
                <li class="page-item active" aria-current="page"><span class="page-link">@Model.PageNumber</span></li>
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-area="Public" asp-controller="Packages" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)" tabindex="@(Model.HasNextPage ? "0" : "-1")">@Localizer["Public.Next"]</a>
                </li>
            </ul>
        </nav>
    }
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-box-seam display-4 text-body-secondary" aria-hidden="true"></i>
        <h2 class="h4 mt-3">@Localizer["Public.No.packages.available.yet"]</h2>
        <p class="text-body-secondary">@Localizer["Public.Check.back.soon.for.curated.tour.bundles"]</p>
        <a class="btn btn-primary" asp-area="Public" asp-controller="Tours" asp-action="Index">@Localizer["Public.Browse.all.tours"]</a>
    </div>
}
