@model YallaJo.Web.Areas.Public.Models.Packages.PackagesGridVm
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@*
    Results fragment for the packages listing.
    Rendered inside Packages/Index.cshtml on full page loads and returned
    standalone for AJAX requests (WantsAjax); swapped client-side by listing.js.
    The wrapping #listingResults container lives in Index.cshtml and is preserved.
*@
@{
    var viewMode = (Context.Request.Query["viewMode"].ToString() == "list") ? "list" : "card";
    var isList = viewMode == "list";

    // Echoed filter/sort state so pagination keeps the active query (AJAX-safe).
    var routeValues = new Dictionary<string, string?>();
    if (!string.IsNullOrWhiteSpace(Model.Sort)) { routeValues["sort"] = Model.Sort; }
    if (Model.MinPrice is { } min) { routeValues["minPrice"] = min.ToString(System.Globalization.CultureInfo.InvariantCulture); }
    if (Model.MaxPrice is { } max) { routeValues["maxPrice"] = max.ToString(System.Globalization.CultureInfo.InvariantCulture); }
    if (isList) { routeValues["viewMode"] = "list"; }
}
@if (Model.HasResults)
{
    <div class="yj-pkg-results-head">
        <p class="yj-pkg-results-count mb-0">@Localizer["Public.Packages.Found", Model.TotalCount]</p>
    </div>

    <div class="yj-pkg-grid @(isList ? "yj-pkg-grid--list" : "yj-pkg-grid--card")">
        @foreach (var package in Model.Packages)
        {
            <partial name="_PackageCard" model="package" view-data="@(new ViewDataDictionary(ViewData) { ["viewMode"] = viewMode })" />
        }
    </div>

    @if (Model.HasPreviousPage || Model.HasNextPage)
    {
        <nav class="yj-pkg-pagination" aria-label="@Localizer["Public.Packages.pages"]">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-area="Public" asp-controller="Packages" asp-action="Index"
                       asp-route-page="@(Model.PageNumber - 1)" asp-all-route-data="routeValues"
                       tabindex="@(Model.HasPreviousPage ? "0" : "-1")">@Localizer["Public.Previous"]</a>
                </li>
                <li class="page-item active" aria-current="page"><span class="page-link">@Model.PageNumber</span></li>
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-area="Public" asp-controller="Packages" asp-action="Index"
                       asp-route-page="@(Model.PageNumber + 1)" asp-all-route-data="routeValues"
                       tabindex="@(Model.HasNextPage ? "0" : "-1")">@Localizer["Public.Next"]</a>
                </li>
            </ul>
        </nav>
    }
}
else
{
    <div class="yj-pkg-empty text-center py-5">
        <i class="bi bi-box-seam display-4 text-body-secondary" aria-hidden="true"></i>
        <h2 class="h4 mt-3">@Localizer["Public.No.packages.available.yet"]</h2>
        <p class="text-body-secondary">@Localizer["Public.Check.back.soon.for.curated.tour.bundles"]</p>
        <a class="btn btn-primary" asp-area="Public" asp-controller="Tours" asp-action="Index">@Localizer["Public.Browse.all.tours"]</a>
    </div>
}
