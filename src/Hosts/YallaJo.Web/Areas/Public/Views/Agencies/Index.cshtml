@model YallaJo.Web.Areas.Public.Models.Agencies.AgenciesGridVm
@using YallaJo.Web.Infrastructure.Seo
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    ViewData.SetSeo(new SeoModel
    {
        Title = Localizer["Public.Seo.AgenciesTitle"].Value,
        Description = Localizer["Public.Seo.AgenciesDescription"].Value,
        Canonical = $"{baseUrl}/agency",
        OgType = "website",
    });
}

<section class="pt-4 pb-2">
    <div class="container">
        <nav aria-label="@Localizer["Public.breadcrumb"]">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-area="Public" asp-controller="Home" asp-action="Index">@Localizer["Public.Home"]</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Localizer["Public.Agencies"]</li>
            </ol>
        </nav>
        <h1 class="fs-2 mb-1">@Localizer["Public.Travel.agencies"]</h1>
        <p class="text-secondary mb-0">@Localizer["Public.Verified.agencies.offering.guided.tours.and.travel.services"]</p>
    </div>
</section>

<section class="pb-5">
    <div class="container">
        @* Phase 7: results fragment is swapped in place by listing.js (UI-UX-S1); plain GET navigation without JS (PE1). *@
        <div id="listingResults" data-yj-component="listing" aria-live="polite" aria-busy="false"
             data-error-text="@Localizer["Public.Results.Error"]" data-retry-text="@Localizer["Public.Retry"]" data-loading-text="@Localizer["Public.Loading"]">
            <partial name="_AgenciesResults" model="Model" />
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/assets/js/listing.js" asp-append-version="true"></script>
}
