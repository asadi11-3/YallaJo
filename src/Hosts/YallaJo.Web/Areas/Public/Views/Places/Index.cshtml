@model YallaJo.Web.Areas.Public.Models.Places.PlacesGridVm
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Public.Explore.Places"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- ======================= Page banner START -->
<section class="pt-3">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center">
                <h1 class="h2 mb-2">@Localizer["Public.Explore.Places"]</h1>
                <p class="mb-0">@Localizer["Public.Discover.destinations.and.points.of.interest"]</p>
            </div>
        </div>
    </div>
</section>
<!-- ======================= Page banner END -->

<!-- ======================= Places grid START -->
<section class="pt-4">
    <div class="container">

        <!-- Filter bar START (real GET form per UI-UX-PE1; listing.js enhances it via data-yj-listing) -->
        <form method="get" asp-area="Public" asp-controller="Places" asp-action="Index" class="card bg-light p-3 mb-4" data-yj-listing>
            <div class="row g-3 align-items-end">
                @* Phase 8.4: datalist suggestions sourced from the current page's places.
                   TODO(backend): no city/country lookup endpoint exists; once one does, replace
                   these datalists with a proper autocomplete fed by that endpoint. *@
                <div class="col-sm-6 col-lg-3">
                    <label for="city" class="form-label small mb-1">@Localizer["Public.City"]</label>
                    <input type="text" id="city" name="city" value="@Model.Filters.City" class="form-control" placeholder="@Localizer["Public.e.g.Petra"]" list="cityOptions" autocomplete="off" />
                    <datalist id="cityOptions">
                        @foreach (var c in Model.Places.Select(p => p.City).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(c => c, StringComparer.OrdinalIgnoreCase))
                        {
                            <option value="@c"></option>
                        }
                    </datalist>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label for="country" class="form-label small mb-1">@Localizer["Public.Country"]</label>
                    <input type="text" id="country" name="country" value="@Model.Filters.Country" class="form-control" placeholder="@Localizer["Public.e.g.Jordan"]" list="countryOptions" autocomplete="off" />
                    <datalist id="countryOptions">
                        @foreach (var c in Model.Places.Select(p => p.Country).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(c => c, StringComparer.OrdinalIgnoreCase))
                        {
                            <option value="@c"></option>
                        }
                    </datalist>
                </div>
                <div class="col-sm-6 col-lg-2">
                    <label for="ratingMin" class="form-label small mb-1">@Localizer["Public.Minimum.rating"]</label>
                    <select id="ratingMin" name="ratingMin" class="form-select">
                        <option value="" selected="@(Model.Filters.RatingMin is null or 0)">@Localizer["Public.Any"]</option>
                        @for (var r = 1; r <= 4; r++)
                        {
                            <option value="@r" selected="@(Model.Filters.RatingMin == r)">@r+</option>
                        }
                    </select>
                </div>
                <div class="col-sm-6 col-lg-2">
                    @* Phase 8.4: mb-2 aligns the checkbox with the inputs' baseline (row is align-items-end); old mt-4 hack removed. *@
                    <div class="form-check mb-2">
                        <input type="checkbox" id="hasActiveTours" name="hasActiveTours" value="true" class="form-check-input" checked="@Model.Filters.HasActiveTours" />
                        <label for="hasActiveTours" class="form-check-label small">@Localizer["Public.Has.active.tours"]</label>
                    </div>
                </div>
                <div class="col-lg-2 d-grid d-sm-flex gap-2">
                    <button type="submit" class="btn btn-primary mb-0"><i class="bi bi-funnel me-1"></i>@Localizer["Public.Filter"]</button>
                    <a asp-area="Public" asp-controller="Places" asp-action="Index" class="btn btn-outline-secondary mb-0">@Localizer["Public.Reset"]</a>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-12">
                    <span class="form-text">@Localizer["Public.Enter.the.full.city.or.country.name.exact.match"]</span>
                </div>
            </div>
        </form>
        <!-- Filter bar END -->

        @* Phase 7: results fragment is shared with the AJAX partial response (WantsAjax) and swapped in place by listing.js. *@
        <div id="listingResults" data-yj-component="listing" aria-live="polite" aria-busy="false"
             data-error-text="@Localizer["Public.Results.Error"]" data-retry-text="@Localizer["Public.Retry"]" data-loading-text="@Localizer["Public.Loading"]">
            <partial name="_PlacesResults" model="Model" />
        </div>
    </div>
</section>
<!-- ======================= Places grid END -->

@section Scripts {
    <script src="~/assets/js/listing.js" asp-append-version="true"></script>
}
