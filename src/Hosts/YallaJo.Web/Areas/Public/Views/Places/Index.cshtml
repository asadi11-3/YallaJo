@model YallaJo.Web.Areas.Public.Models.Places.PlacesGridVm
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Public.Explore.Places"];
    Layout = "~/Views/Shared/_Layout.cshtml";

    var rangeStart = Model.TotalCount == 0 ? 0 : ((Model.PageNumber - 1) * Model.PageSize) + 1;
    var rangeEnd = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount);
}

<!-- ======================= Page banner START -->
<section class="pt-3">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center">
                <h1 class="h2 mb-2">@Localizer["Public.Explore.Places"]</h1>
                <p class="mb-0">@Localizer["Public.Discover.destinations.and.points.of.interest"]</p>
            </div>
        </div>
    </div>
</section>
<!-- ======================= Page banner END -->

<!-- ======================= Places grid START -->
<section class="pt-4">
    <div class="container">

        <!-- Filter bar START -->
        <form method="get" asp-area="Public" asp-controller="Places" asp-action="Index" class="card bg-light p-3 mb-4">
            <div class="row g-3 align-items-end">
                <div class="col-sm-6 col-lg-3">
                    <label for="city" class="form-label small mb-1">@Localizer["Public.City"]</label>
                    <input type="text" id="city" name="city" value="@Model.Filters.City" class="form-control" placeholder="@Localizer["Public.e.g.Petra"]" />
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label for="country" class="form-label small mb-1">@Localizer["Public.Country"]</label>
                    <input type="text" id="country" name="country" value="@Model.Filters.Country" class="form-control" placeholder="@Localizer["Public.e.g.Jordan"]" />
                </div>
                <div class="col-sm-6 col-lg-2">
                    <label for="ratingMin" class="form-label small mb-1">@Localizer["Public.Minimum.rating"]</label>
                    <select id="ratingMin" name="ratingMin" class="form-select">
                        <option value="" selected="@(Model.Filters.RatingMin is null or 0)">@Localizer["Public.Any"]</option>
                        @for (var r = 1; r <= 4; r++)
                        {
                            <option value="@r" selected="@(Model.Filters.RatingMin == r)">@r+</option>
                        }
                    </select>
                </div>
                <div class="col-sm-6 col-lg-2">
                    <div class="form-check mt-4">
                        <input type="checkbox" id="hasActiveTours" name="hasActiveTours" value="true" class="form-check-input" checked="@Model.Filters.HasActiveTours" />
                        <label for="hasActiveTours" class="form-check-label small">@Localizer["Public.Has.active.tours"]</label>
                    </div>
                </div>
                <div class="col-lg-2 d-grid d-sm-flex gap-2">
                    <button type="submit" class="btn btn-primary mb-0"><i class="bi bi-funnel me-1"></i>@Localizer["Public.Filter"]</button>
                    <a asp-area="Public" asp-controller="Places" asp-action="Index" class="btn btn-outline-secondary mb-0">@Localizer["Public.Reset"]</a>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-12">
                    <span class="form-text">@Localizer["Public.Enter.the.full.city.or.country.name.exact.match"]</span>
                </div>
            </div>
        </form>
        <!-- Filter bar END -->

        <div class="row mb-4">
            <div class="col-12">
                <h5 class="mb-0">
                    Showing @rangeStart-@rangeEnd of @Model.TotalCount place@(Model.TotalCount == 1 ? "" : "s")
                </h5>
            </div>
        </div>

        @if (!Model.HasResults)
        {
            <!-- Empty state (filter-aware) -->
            <div class="row">
                <div class="col-12 text-center py-5">
                    <img src="~/assets/images/element/17.svg" class="h-100px mb-3" alt="@Localizer["Public.No.places"]">
                    @if (Model.Filters.HasAnyFilter)
                    {
                        <h5 class="mb-1">@Localizer["Public.No.places.match.your.filters"]</h5>
                        <p class="mb-2">@Localizer["Public.Try.removing.or.changing.a.filter"]</p>
                        <a asp-area="Public" asp-controller="Places" asp-action="Index" class="btn btn-sm btn-outline-secondary">@Localizer["Public.Reset.filters"]</a>
                    }
                    else
                    {
                        <h5 class="mb-1">@Localizer["Public.No.places.found"]</h5>
                        <p class="mb-0">@Localizer["Public.Check.back.soon"]</p>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var place in Model.Places)
                {
                    <!-- Card item START -->
                    <div class="col-md-6 col-xl-4">
                        <div class="card card-hover-shadow pb-0 h-100">
                            <!-- Image + overlay -->
                            <div class="position-relative">
                                <img src="@place.ImageUrl" class="card-img-top" alt="@place.Name" style="height:220px;object-fit:cover;">
                                <div class="card-img-overlay d-flex flex-column p-3 z-index-1">
                                    <div>
                                        @if (place.IsFeatured)
                                        {
                                            <span class="badge text-bg-dark">@Localizer["Public.Featured"]</span>
                                        }
                                        @if (place.IsVerified)
                                        {
                                            <span class="badge text-bg-success"><i class="bi bi-patch-check-fill me-1"></i>@Localizer["Public.Verified"]</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Card body -->
                            <div class="card-body px-3">
                                <h5 class="card-title mb-1">
                                    <a asp-area="Public" asp-controller="Places" asp-action="Details" asp-route-slug="@place.Slug" class="stretched-link">@place.Name</a>
                                </h5>
                                <ul class="nav nav-divider mb-0 small">
                                    @if (!string.IsNullOrWhiteSpace(place.PlaceType))
                                    {
                                        <li class="nav-item"><span class="badge text-bg-light">@place.PlaceType</span></li>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(place.LocationLabel))
                                    {
                                        <li class="nav-item"><i class="bi bi-geo-alt me-1"></i>@place.LocationLabel</li>
                                    }
                                </ul>
                                <ul class="nav nav-divider mb-0 small mt-1">
                                    <li class="nav-item">
                                        <i class="bi bi-star-fill text-warning me-1"></i>@place.AverageRating.ToString("0.0")
                                        <span class="text-body">(@place.ReviewCount)</span>
                                    </li>
                                </ul>
                            </div>

                            <!-- Card footer -->
                            <div class="card-footer pt-0">
                                <a asp-area="Public" asp-controller="Places" asp-action="Details" asp-route-slug="@place.Slug" class="btn btn-sm btn-primary mb-0">@Localizer["Public.View.Details"]</a>
                            </div>
                        </div>
                    </div>
                    <!-- Card item END -->
                }
            </div>

            <!-- Pagination (shared partial preserves query string, swaps page) -->
            <partial name="_Pagination"
                     model='new YallaJo.Web.Areas.Public.Models.Shared.PaginationVm { PageNumber = Model.PageNumber, TotalPages = Model.TotalPages, AriaLabel = Localizer["Public.Places.pagination"] }' />
        }
    </div>
</section>
<!-- ======================= Places grid END -->
