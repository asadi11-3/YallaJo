@model YallaJo.Web.Areas.Public.Models.Places.PlaceDetailVm
@using YallaJo.Web.Infrastructure.Seo
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isAuthed = User.Identity?.IsAuthenticated == true;
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    ViewData.SetSeo(new SeoModel
    {
        Title = Model.Seo?.MetaTitle ?? Model.MetaTitle ?? Model.Name,
        Description = Model.Seo?.MetaDescription,
        Canonical = Model.Seo?.Canonical ?? $"{baseUrl}/places/{Model.Slug}",
        OgImage = Model.Seo?.OgImage ?? Model.HeroImageUrl,
        OgType = "website"
    });
}
@Html.AntiForgeryToken()

<!-- ======================= Place detail banner START -->
<section class="pt-4">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <nav aria-label="@Localizer["Public.breadcrumb"]" class="mb-2">
                    <ol class="breadcrumb breadcrumb-dots mb-0">
                        <li class="breadcrumb-item"><a asp-area="Public" asp-controller="Places" asp-action="Index">@Localizer["Public.Places"]</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
                    </ol>
                </nav>

                <div class="d-sm-flex justify-content-sm-between align-items-start">
                    <div>
                        <h1 class="fs-2 mb-2">@Model.Name</h1>
                        <ul class="nav nav-divider align-items-center small mb-0">
                            @if (!string.IsNullOrWhiteSpace(Model.PlaceType))
                            {
                                <li class="nav-item"><span class="badge text-bg-light">@Model.PlaceType</span></li>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.LocationLabel))
                            {
                                <li class="nav-item"><i class="bi bi-geo-alt me-1"></i>@Model.LocationLabel</li>
                            }
                            <li class="nav-item">
                                <i class="bi bi-star-fill text-warning me-1"></i>@Model.AverageRating.ToString("0.0")
                                <span class="text-body">(@Localizer["Public.Reviews.Count", Model.ReviewCount])</span>
                            </li>
                        </ul>
                    </div>
                    <div class="mt-3 mt-sm-0 text-sm-end">
                        <div class="mb-2">
                            @if (Model.IsFeatured)
                            {
                                <span class="badge text-bg-dark">@Localizer["Public.Featured"]</span>
                            }
                            @if (Model.IsVerified)
                            {
                                <span class="badge text-bg-success"><i class="bi bi-patch-check-fill me-1"></i>@Localizer["Public.Verified"]</span>
                            }
                        </div>
                        @if (isAuthed)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger js-favorite" data-entity-type="Place" data-entity-id="@Model.PlaceId" aria-label="@Localizer["Public.Save.to.favourites"]">
                                <i class="bi bi-heart"></i>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger" disabled data-bs-toggle="tooltip" title="@Localizer["Public.Log.in.to.save"]" aria-label="@Localizer["Public.Log.in.to.save"]">
                                <i class="bi bi-heart"></i>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- ======================= Place detail banner END -->

<!-- ======================= Place detail body START -->
<section class="pt-4 pb-5">
    <div class="container">
        <div class="row g-4">
            <!-- Main column -->
            <div class="col-lg-8">
                <div class="card shadow mb-4">
                    <img src="@Model.HeroImageUrl" class="card-img-top hero-img-h360 object-cover" alt="@Model.Name">
                </div>

                @if (Model.GalleryImageUrls.Count > 0)
                {
                    <div class="row g-2 mb-4">
                        @foreach (var img in Model.GalleryImageUrls)
                        {
                            <div class="col-4 col-md-3">
                                <img src="@img" class="img-fluid rounded w-100 thumb-h90 object-cover" alt="@Model.Name">
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="card shadow">
                        <div class="card-header border-bottom"><h5 class="mb-0">@Localizer["Public.About"]</h5></div>
                        <div class="card-body">
                            <p class="mb-0">@Model.Description</p>
                        </div>
                    </div>
                }
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <div class="card shadow mb-4">
                    <div class="card-header border-bottom"><h5 class="mb-0">@Localizer["Public.Location"]</h5></div>
                    <div class="card-body">
                        <ul class="list-group list-group-borderless">
                            @if (!string.IsNullOrWhiteSpace(Model.Address))
                            {
                                <li class="list-group-item d-flex">
                                    <i class="bi bi-pin-map-fill text-primary me-2"></i>
                                    <span>@Model.Address</span>
                                </li>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.LocationLabel))
                            {
                                <li class="list-group-item d-flex">
                                    <i class="bi bi-geo-alt text-primary me-2"></i>
                                    <span>@Model.LocationLabel@(string.IsNullOrWhiteSpace(Model.PostalCode) ? "" : $" {Model.PostalCode}")</span>
                                </li>
                            }
                            <li class="list-group-item d-flex">
                                <i class="bi bi-compass text-primary me-2"></i>
                                <span class="text-body">@Model.Latitude.ToString("0.0000"), @Model.Longitude.ToString("0.0000")</span>
                            </li>
                        </ul>
                    </div>
                </div>

                @if (Model.Weather is { } weather)
                {
                    <div class="card shadow mb-4">
                        <div class="card-header border-bottom"><h5 class="mb-0"><i class="bi bi-cloud-sun me-1" aria-hidden="true"></i>@Localizer["Public.Weather"]</h5></div>
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                @if (weather.HasTemperature)
                                {
                                    <span class="h3 mb-0">@weather.Temperature.GetValueOrDefault().ToString("0")&deg;C</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(weather.Condition))
                                {
                                    <div class="text-body">@weather.Condition</div>
                                }
                                @if (weather.IsStale && !string.IsNullOrWhiteSpace(weather.StaleHumanLabel))
                                {
                                    <small class="text-secondary d-block mt-1">@weather.StaleHumanLabel</small>
                                }
                            </div>
                            <ul class="list-unstyled small text-body mb-0 text-end">
                                @if (weather.FeelsLike.HasValue)
                                {
                                    <li>Feels like @weather.FeelsLike.Value.ToString("0")&deg;C</li>
                                }
                                @if (weather.Humidity.HasValue)
                                {
                                    <li><i class="bi bi-droplet me-1" aria-hidden="true"></i>@weather.Humidity.Value%</li>
                                }
                                @if (weather.WindSpeed.HasValue)
                                {
                                    <li><i class="bi bi-wind me-1" aria-hidden="true"></i>@weather.WindSpeed.Value.ToString("0.#") km/h</li>
                                }
                            </ul>
                        </div>
                    </div>
                }

                @if (Model.HasContact)
                {
                    <div class="card shadow mb-4">
                        <div class="card-header border-bottom"><h5 class="mb-0">@Localizer["Public.Contact"]</h5></div>
                        <div class="card-body">
                            <ul class="list-group list-group-borderless">
                                @if (!string.IsNullOrWhiteSpace(Model.Phone))
                                {
                                    <li class="list-group-item d-flex">
                                        <i class="bi bi-telephone text-primary me-2"></i>
                                        <span>@Model.Phone</span>
                                    </li>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Email))
                                {
                                    <li class="list-group-item d-flex">
                                        <i class="bi bi-envelope text-primary me-2"></i>
                                        <span>@Model.Email</span>
                                    </li>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Website))
                                {
                                    <li class="list-group-item d-flex">
                                        <i class="bi bi-globe text-primary me-2"></i>
                                        <a href="@Model.Website" target="_blank" rel="noopener noreferrer">@Model.Website</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }

                @if (Model.HasDetailedAccessibility || Model.HasAccessibility)
                {
                    <div class="card shadow">
                        <div class="card-header border-bottom"><h5 class="mb-0">@Localizer["Public.Accessibility"]</h5></div>
                        <div class="card-body">
                            @if (Model.HasDetailedAccessibility)
                            {
                                <ul class="list-group list-group-borderless mb-0">
                                    @foreach (var feature in Model.AccessibilityFeatures)
                                    {
                                        <li class="list-group-item">
                                            <i class="bi @(feature.IsAvailable ? "bi-check-circle-fill text-success" : "bi-x-circle text-muted") me-2"></i>@feature.Name
                                            @if (!string.IsNullOrWhiteSpace(feature.Description))
                                            {
                                                <small class="d-block text-body ms-4">@feature.Description</small>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <ul class="list-group list-group-borderless mb-0">
                                    @if (Model.IsWheelchairAccessible)
                                    {
                                        <li class="list-group-item"><i class="bi bi-check-circle-fill text-success me-2"></i>@Localizer["Public.Wheelchair.accessible"]</li>
                                    }
                                    @if (Model.HasAudioGuide)
                                    {
                                        <li class="list-group-item"><i class="bi bi-check-circle-fill text-success me-2"></i>@Localizer["Public.Audio.guide"]</li>
                                    }
                                    @if (Model.HasBrailleSignage)
                                    {
                                        <li class="list-group-item"><i class="bi bi-check-circle-fill text-success me-2"></i>@Localizer["Public.Braille.signage"]</li>
                                    }
                                </ul>
                            }
                            @if (Model.AccessibilityCatalog.Count > 0)
                            {
                                <div class="mt-3 small text-body">
                                    Catalog: @string.Join(", ", Model.AccessibilityCatalog.Select(c => c.DisplayName))
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
<!-- ======================= Place detail body END -->

@if (Model.Seo?.HasFaqs == true)
{
    <!-- ======================= FAQ START -->
    <section class="pb-5">
        <div class="container">
            <h4 class="mb-3">@Localizer["Public.Frequently.asked.questions"]</h4>
            <div class="accordion accordion-flush" id="placeFaq">
                @for (var i = 0; i < Model.Seo.Faqs.Count; i++)
                {
                    var faq = Model.Seo.Faqs[i];
                    var headingId = $"placeFaqHeading{i}";
                    var collapseId = $"placeFaqCollapse{i}";
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="@headingId">
                            <button class="accordion-button @(i == 0 ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="@collapseId">
                                @faq.Question
                            </button>
                        </h2>
                        <div id="@collapseId" class="accordion-collapse collapse @(i == 0 ? "show" : "")" aria-labelledby="@headingId" data-bs-parent="#placeFaq">
                            <div class="accordion-body">@faq.Answer</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
    <!-- ======================= FAQ END -->
}

<!-- ======================= Related tours START -->
<section class="pb-5">
    <div class="container">
        <div class="d-sm-flex justify-content-sm-between align-items-center mb-3">
            <h4 class="mb-0">Tours in @Model.Name</h4>
            @if (Model.HasRelatedTours)
            {
                <a asp-area="Public" asp-controller="Tours" asp-action="Index" asp-route-placeId="@Model.PlaceId" class="btn btn-sm btn-outline-primary mb-0">
                    View all tours in this place
                </a>
            }
        </div>

        @if (!Model.HasRelatedTours)
        {
            <p class="text-body mb-0">@Localizer["Public.No.tours.are.currently.available.for.this.place"]</p>
        }
        else
        {
            <div class="row g-4">
                @foreach (var tour in Model.RelatedTours)
                {
                    <div class="col-md-6 col-xl-3">
                        <div class="card card-hover-shadow pb-0 h-100">
                            <div class="position-relative">
                                <img src="@tour.ImageUrl" class="card-img-top card-img-h180 object-cover" alt="@tour.Name">
                                @if (tour.IsFeatured)
                                {
                                    <div class="card-img-overlay d-flex flex-column p-3 z-index-1">
                                        <div><span class="badge text-bg-dark">@Localizer["Public.Featured"]</span></div>
                                    </div>
                                }
                            </div>
                            <div class="card-body px-3">
                                <h6 class="card-title mb-1">
                                    <a asp-area="Public" asp-controller="Tours" asp-action="Detail" asp-route-slug="@tour.Slug" class="stretched-link">@tour.Name</a>
                                </h6>
                                <ul class="nav nav-divider mb-0 small">
                                    <li class="nav-item">
                                        <i class="bi bi-star-fill text-warning me-1"></i>@tour.AverageRating.ToString("0.0")
                                        <span class="text-body">(@tour.ReviewCount)</span>
                                    </li>
                                </ul>
                            </div>
                            <div class="card-footer pt-0">
                                <span class="fw-normal text-success">@(tour.Currency is { Length: > 0 } ? $"{tour.EffectivePrice:N0} {tour.Currency}" : tour.EffectivePrice.ToString("N0"))</span>
                                <small>@Localizer["Public.per.person"]</small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
<!-- ======================= Related tours END -->

@if (Model.HasBusinesses)
{
    <section class="pb-5">
        <div class="container">
            <h4 class="mb-3">Businesses at @Model.Name</h4>
            <div class="row g-4">
                @foreach (var business in Model.Businesses)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="card card-hover-shadow h-100">
                            <img src="@business.ImageUrl" class="card-img-top card-img-h170 object-cover" alt="@business.Name">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="h6 mb-0"><a asp-area="Public" asp-controller="Directory" asp-action="Detail" asp-route-id="@business.Id" class="stretched-link">@business.Name</a></h5>
                                    @if (business.IsVerified)
                                    {
                                        <span class="badge text-bg-success">@Localizer["Public.Verified"]</span>
                                    }
                                </div>
                                <p class="small text-body mb-2">@business.BusinessType</p>
                                <span class="small"><i class="bi bi-star-fill text-warning me-1"></i>@business.AverageRating.ToString("0.0") (@business.ReviewCount)</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (Model.HasRecommendations)
{
    <section class="pb-5">
        <div class="container">
            <h4 class="mb-3">@Localizer["Public.Recommended.for.this.place"]</h4>
            <div class="row g-4">
                @foreach (var rec in Model.Recommendations.Concat(Model.SimilarRecommendations).Take(8))
                {
                    <div class="col-md-6 col-xl-3">
                        <div class="card border h-100">
                            <div class="card-body">
                                @if (!string.IsNullOrWhiteSpace(rec.BadgeText))
                                {
                                    <span class="badge text-bg-primary mb-2">@rec.BadgeText</span>
                                }
                                else if (rec.IsBoosted)
                                {
                                    <span class="badge text-bg-warning mb-2">@Localizer["Public.Sponsored"]</span>
                                }
                                <h5 class="h6">@rec.Name</h5>
                                <div class="small text-body mb-2"><i class="bi bi-star-fill text-warning me-1"></i>@rec.AverageRating.ToString("0.0")</div>
                                @if (rec.BasePrice.HasValue)
                                {
                                    <div class="small text-success">@(string.IsNullOrWhiteSpace(rec.Currency) ? rec.BasePrice.Value.ToString("N0") : $"{rec.BasePrice.Value:N0} {rec.Currency}")</div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (ViewData["AccessibilityReviews"] is YallaJo.Web.Areas.Public.Models.AccessibilityReviews.AccessibilityReviewListVm accessibilityReviews)
{
    <partial name="~/Areas/Public/Views/Shared/_AccessibilityReviews.cshtml" model="accessibilityReviews" />
}

@if (ViewData["Reviews"] is YallaJo.Web.Areas.Public.Models.Reviews.ReviewListVm reviews)
{
    <partial name="~/Areas/Public/Views/Shared/_Reviews.cshtml" model="reviews" />
    @if (User.Identity?.IsAuthenticated == true)
    {
        <section class="pb-5">
            <div class="container">
                <div class="row g-4">
                    <div class="col-lg-7">
                        <form method="post" asp-area="Public" asp-controller="Reviews" asp-action="CreateReview" asp-route-targetType="place" asp-route-targetId="@Model.PlaceId" class="card border p-3 h-100" data-loading>
                            @Html.AntiForgeryToken()
                            <h3 class="h6 mb-3">@Localizer["Public.Write.a.review"]</h3>
                            <input type="hidden" name="Review.TargetId" value="@Model.PlaceId" />
                                <input type="hidden" name="returnUrl" value="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" />
                            <div class="mb-2">
                                <label class="form-label small" for="placeReviewRating">@Localizer["Public.Rating"]</label>
                                <select id="placeReviewRating" name="Review.Rating" class="form-select form-select-sm">
                                    <option value="5">@Localizer["Public.5.Excellent"]</option>
                                    <option value="4">@Localizer["Public.4.Very.good"]</option>
                                    <option value="3">@Localizer["Public.3.Average"]</option>
                                    <option value="2">@Localizer["Public.2.Poor"]</option>
                                    <option value="1">@Localizer["Public.1.Terrible"]</option>
                                </select>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small" for="placeReviewTitle">@Localizer["Public.Title.optional"]</label>
                                <input id="placeReviewTitle" name="Review.Title" maxlength="150" class="form-control form-control-sm" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small" for="placeReviewContent">@Localizer["Public.Your.review"]</label>
                                <textarea id="placeReviewContent" name="Review.Content" minlength="20" maxlength="2000" rows="4" required class="form-control form-control-sm"></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small" for="placeReviewVisit">@Localizer["Public.Visit.date.optional"]</label>
                                <input id="placeReviewVisit" type="date" name="Review.VisitDate" class="form-control form-control-sm" />
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">@Localizer["Public.Submit.review"]</button>
                        </form>
                    </div>
                    <div class="col-lg-5">
                        <form method="post" asp-area="Public" asp-controller="Reviews" asp-action="ReportEntity" asp-route-targetType="place" asp-route-targetId="@Model.PlaceId" class="card border p-3 h-100" data-loading>
                            @Html.AntiForgeryToken()
                            <h3 class="h6 mb-3">@Localizer["Public.Report.this.place"]</h3>
                            <input type="hidden" name="Report.EntityId" value="@Model.PlaceId" />
                                <input type="hidden" name="returnUrl" value="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" />
                            <div class="mb-2">
                                <label class="form-label small" for="placeReportReason">@Localizer["Public.Reason"]</label>
                                <select id="placeReportReason" name="Report.Reason" class="form-select form-select-sm">
                                    <option value="Inappropriate">@Localizer["Public.Inappropriate.content"]</option>
                                    <option value="Misleading">@Localizer["Public.Misleading.information"]</option>
                                    <option value="Spam">@Localizer["Public.Spam"]</option>
                                    <option value="Harassment">@Localizer["Public.Harassment"]</option>
                                    <option value="FakeReview">@Localizer["Public.Fake.review"]</option>
                                    <option value="Other">@Localizer["Public.Other"]</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small" for="placeReportDesc">@Localizer["Public.Details"]</label>
                                <textarea id="placeReportDesc" name="Report.Description" minlength="5" maxlength="1000" rows="3" required class="form-control form-control-sm"></textarea>
                            </div>
                            <button type="submit" class="btn btn-outline-secondary btn-sm">@Localizer["Public.Submit.report"]</button>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    }
}

@section Scripts {
    <script src="~/assets/js/places-details.js" asp-append-version="true"></script>
}
