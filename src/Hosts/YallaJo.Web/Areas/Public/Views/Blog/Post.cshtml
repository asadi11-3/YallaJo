@model YallaJo.Web.Areas.Public.Models.Blog.BlogPostVm
@using YallaJo.Web.Infrastructure.Seo
@using YallaJo.Web.Infrastructure.Authentication.Claims
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isAuthed = User.Identity?.IsAuthenticated == true;
    var currentUserId = Guid.TryParse(User.FindFirst(AppClaimTypes.UserId)?.Value, out var uid) ? uid : Guid.Empty;
    var returnUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    ViewData.SetSeo(new SeoModel
    {
        Title = Model.Seo?.MetaTitle ?? Model.Title,
        Description = Model.Seo?.MetaDescription ?? Model.Summary,
        Canonical = Model.Seo?.Canonical ?? $"{baseUrl}/blog/{Model.Slug}",
        OgImage = Model.Seo?.OgImage,
        OgType = "article",
    });
}
@Html.AntiForgeryToken()

<article>
    <section class="pt-4">
        <div class="container">
            <nav aria-label="@Localizer["Public.breadcrumb"]">
                <ol class="breadcrumb mb-3">
                    <li class="breadcrumb-item"><a asp-area="Public" asp-controller="Home" asp-action="Index">@Localizer["Public.Home"]</a></li>
                    <li class="breadcrumb-item"><a asp-area="Public" asp-controller="Blog" asp-action="Index">@Localizer["Public.Blog"]</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
                </ol>
            </nav>
            <div class="row justify-content-center">
                <div class="col-lg-9 col-xl-8">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="text-secondary small mb-2">
                            @if (Model.PublishedAt is { } published)
                            {
                                <span><i class="bi bi-calendar3 me-1" aria-hidden="true"></i>@published.ToString("d MMM yyyy")</span>
                            }
                            @if (Model.HasReadTime)
                            {
                                <span class="ms-3"><i class="bi bi-clock me-1" aria-hidden="true"></i>@Localizer["Public.ReadTime", Model.ReadTimeMinutes]</span>
                            }
                            <span class="ms-3"><i class="bi bi-eye me-1" aria-hidden="true"></i>@Localizer["Public.Views.Count", Model.ViewCount]</span>
                        </div>
                        @if (isAuthed)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger js-favorite" data-entity-type="Blog" data-entity-id="@Model.Id" aria-label="@Localizer["Public.Save.article"]">
                                <i class="bi bi-heart" aria-hidden="true"></i>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger" disabled data-bs-toggle="tooltip" title="@Localizer["Public.Log.in.to.save"]" aria-label="@Localizer["Public.Log.in.to.save"]">
                                <i class="bi bi-heart" aria-hidden="true"></i>
                            </button>
                        }
                    </div>
                    <h1 class="mb-0">@Model.Title</h1>
                </div>
            </div>
        </div>
    </section>

    <section class="pt-3 pb-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-9 col-xl-8">
                    <div class="blog-content">
                        @* SANITIZED: BlogDetailDto.Content is sanitized on the creator-side write (plan §7.2 SEC3) *@
                        @Html.Raw(Model.Content)
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="pb-5" id="comments" aria-labelledby="comments-title">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-9 col-xl-8">
                    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
                        <h2 id="comments-title" class="h4 mb-0">@Localizer["Public.Comments"]</h2>
                        <span class="text-secondary small">@Localizer["Public.Comments.Count", Model.Comments.TotalCount]</span>
                    </div>

                    @if (isAuthed)
                    {
                        <form method="post" asp-area="Public" asp-controller="Blog" asp-action="CreateComment" asp-route-id="@Model.Id" class="card border mb-4">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Slug" value="@Model.Slug" />
                            <div class="card-body">
                                <label class="form-label" for="newComment">@Localizer["Public.Post.a.comment"]</label>
                                <textarea id="newComment" name="Content" rows="4" minlength="2" maxlength="2000" required class="form-control" placeholder="@Localizer["Public.Share.your.thoughts.about.this.article"]"></textarea>
                                <button type="submit" class="btn btn-primary mt-3"><i class="bi bi-chat-left-text me-1" aria-hidden="true"></i>@Localizer["Public.Post.comment"]</button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="card border mb-4">
                            <div class="card-body d-sm-flex align-items-center justify-content-between gap-3">
                                <p class="mb-3 mb-sm-0 text-secondary">@Localizer["Public.Sign.in.to.comment.reply.and.like.comments"]</p>
                                <a class="btn btn-outline-primary" asp-area="Auth" asp-controller="Auth" asp-action="SignIn" asp-route-returnUrl="@returnUrl">
                                    <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Sign in to comment
                                </a>
                            </div>
                        </div>
                    }

                    @if (Model.Comments.HasResults)
                    {
                        <div class="vstack gap-3">
                            @foreach (var comment in Model.Comments.Items)
                            {
                                var ownComment = isAuthed && currentUserId != Guid.Empty && comment.UserId == currentUserId;
                                <article class="card border" id="comment-@comment.Id">
                                    <div class="card-body">
                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                                            <div class="fw-semibold">@Localizer["Public.Community.member"]</div>
                                            <div class="text-secondary small">
                                                <i class="bi bi-calendar3 me-1" aria-hidden="true"></i>@comment.CreatedAt.ToString("d MMM yyyy")
                                                @if (comment.UpdatedAt is { } updated)
                                                {
                                                    <span class="ms-2">@Localizer["Public.EditedDate", updated.ToString("d MMM yyyy")]</span>
                                                }
                                            </div>
                                        </div>
                                        <p class="mb-2" style="white-space:pre-line;">@(comment.IsContentRedacted ? "[deleted]" : comment.Content)</p>
                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                            <span class="text-secondary small"><i class="bi bi-hand-thumbs-up me-1" aria-hidden="true"></i>@Localizer["Public.Likes.Count", comment.LikeCount]</span>
                                            @if (isAuthed && !comment.IsContentRedacted)
                                            {
                                                <form method="post" asp-area="Public" asp-controller="Blog" asp-action="ReactComment" asp-route-commentId="@comment.Id" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="slug" value="@Model.Slug" />
                                                    <button type="submit" class="btn btn-sm btn-light"><i class="bi bi-hand-thumbs-up me-1" aria-hidden="true"></i>@Localizer["Public.Like"]</button>
                                                </form>
                                                <form method="post" asp-area="Public" asp-controller="Blog" asp-action="UnreactComment" asp-route-commentId="@comment.Id" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="slug" value="@Model.Slug" />
                                                    <button type="submit" class="btn btn-sm btn-outline-light text-secondary">@Localizer["Public.Unlike"]</button>
                                                </form>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#reply-comment-@comment.Id" aria-expanded="false">@Localizer["Public.Reply"]</button>
                                            }
                                        </div>

                                        @if (isAuthed && !comment.IsContentRedacted)
                                        {
                                            <div class="collapse mt-3" id="reply-comment-@comment.Id">
                                                <form method="post" asp-area="Public" asp-controller="Blog" asp-action="CreateComment" asp-route-id="@Model.Id" class="border rounded p-3">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="Slug" value="@Model.Slug" />
                                                    <input type="hidden" name="ParentCommentId" value="@comment.Id" />
                                                    <label class="form-label small" for="replyContent-@comment.Id">@Localizer["Public.Reply"]</label>
                                                    <textarea id="replyContent-@comment.Id" name="Content" rows="2" minlength="2" maxlength="2000" required class="form-control form-control-sm" placeholder="@Localizer["Public.Write.a.reply"]"></textarea>
                                                    <button type="submit" class="btn btn-sm btn-primary mt-2">@Localizer["Public.Post.reply"]</button>
                                                </form>
                                            </div>
                                        }

                                        @if (ownComment && comment.IsWithinEditWindow)
                                        {
                                            <div class="mt-3">
                                                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#edit-comment-@comment.Id" aria-expanded="false">@Localizer["Public.Edit.your.comment"]</button>
                                                <div class="collapse mt-3" id="edit-comment-@comment.Id">
                                                    <form method="post" asp-area="Public" asp-controller="Blog" asp-action="EditComment" asp-route-commentId="@comment.Id" class="border rounded p-3">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="postId" value="@Model.Id" />
                                                        <input type="hidden" name="Slug" value="@Model.Slug" />
                                                        <input type="hidden" name="RowVersion" value="@comment.RowVersion" />
                                                        <label class="form-label small" for="editCommentContent-@comment.Id">@Localizer["Public.Comment"]</label>
                                                        <textarea id="editCommentContent-@comment.Id" name="Content" rows="3" minlength="2" maxlength="2000" required class="form-control form-control-sm">@comment.Content</textarea>
                                                        <button type="submit" class="btn btn-sm btn-primary mt-2">@Localizer["Public.Save.changes"]</button>
                                                    </form>
                                                </div>
                                            </div>
                                        }
                                        @if (ownComment)
                                        {
                                            <form method="post" asp-area="Public" asp-controller="Blog" asp-action="DeleteComment" asp-route-commentId="@comment.Id" class="mt-2">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="postId" value="@Model.Id" />
                                                <input type="hidden" name="slug" value="@Model.Slug" />
                                                <input type="hidden" name="rowVersion" value="@comment.RowVersion" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Public.Delete.your.comment"]</button>
                                            </form>
                                        }

                                        @if (comment.HasReplies)
                                        {
                                            <div class="vstack gap-2 mt-3 ps-3 border-start">
                                                @foreach (var reply in comment.Replies)
                                                {
                                                    var ownReply = isAuthed && currentUserId != Guid.Empty && reply.UserId == currentUserId;
                                                    <article class="border rounded p-3" id="comment-@reply.Id">
                                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                                                            <div class="fw-semibold small">@Localizer["Public.Community.member"]</div>
                                                            <div class="text-secondary small">@reply.CreatedAt.ToString("d MMM yyyy")</div>
                                                        </div>
                                                        <p class="mb-2" style="white-space:pre-line;">@(reply.IsContentRedacted ? "[deleted]" : reply.Content)</p>
                                                        <div class="d-flex flex-wrap align-items-center gap-2">
                                                            <span class="text-secondary small"><i class="bi bi-hand-thumbs-up me-1" aria-hidden="true"></i>@Localizer["Public.Likes.Count", reply.LikeCount]</span>
                                                            @if (isAuthed && !reply.IsContentRedacted)
                                                            {
                                                                <form method="post" asp-area="Public" asp-controller="Blog" asp-action="ReactComment" asp-route-commentId="@reply.Id" class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="slug" value="@Model.Slug" />
                                                                    <button type="submit" class="btn btn-sm btn-light">@Localizer["Public.Like"]</button>
                                                                </form>
                                                                <form method="post" asp-area="Public" asp-controller="Blog" asp-action="UnreactComment" asp-route-commentId="@reply.Id" class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="slug" value="@Model.Slug" />
                                                                    <button type="submit" class="btn btn-sm btn-outline-light text-secondary">@Localizer["Public.Unlike"]</button>
                                                                </form>
                                                            }
                                                        </div>
                                                        @if (ownReply && reply.IsWithinEditWindow)
                                                        {
                                                            <div class="mt-2">
                                                                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="collapse" data-bs-target="#edit-comment-@reply.Id" aria-expanded="false">@Localizer["Public.Edit.your.reply"]</button>
                                                                <div class="collapse mt-2" id="edit-comment-@reply.Id">
                                                                    <form method="post" asp-area="Public" asp-controller="Blog" asp-action="EditComment" asp-route-commentId="@reply.Id" class="border rounded p-3">
                                                                        @Html.AntiForgeryToken()
                                                                        <input type="hidden" name="postId" value="@Model.Id" />
                                                                        <input type="hidden" name="Slug" value="@Model.Slug" />
                                                                        <input type="hidden" name="RowVersion" value="@reply.RowVersion" />
                                                                        <label class="form-label small" for="editCommentContent-@reply.Id">@Localizer["Public.Reply"]</label>
                                                                        <textarea id="editCommentContent-@reply.Id" name="Content" rows="3" minlength="2" maxlength="2000" required class="form-control form-control-sm">@reply.Content</textarea>
                                                                        <button type="submit" class="btn btn-sm btn-primary mt-2">@Localizer["Public.Save.changes"]</button>
                                                                    </form>
                                                                </div>
                                                            </div>
                                                        }
                                                        @if (ownReply)
                                                        {
                                                            <form method="post" asp-area="Public" asp-controller="Blog" asp-action="DeleteComment" asp-route-commentId="@reply.Id" class="mt-2">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="postId" value="@Model.Id" />
                                                                <input type="hidden" name="slug" value="@Model.Slug" />
                                                                <input type="hidden" name="rowVersion" value="@reply.RowVersion" />
                                                                <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Public.Delete.your.reply"]</button>
                                                            </form>
                                                        }
                                                    </article>
                                                }
                                            </div>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-secondary">@Localizer["Public.No.comments.yet.Be.the.first.to.start.the.conversation"]</p>
                    }
                </div>
            </div>
        </div>
    </section>
</article>

@section Scripts {
    <script>
        // Tooltip init; favourites handled by shared authed-only favorites.js in _Layout.
        (function () {
            document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) { new bootstrap.Tooltip(el); });
            // View beacon (BFF fire-and-forget; API debounces per viewer).
            try {
                if (navigator.sendBeacon) {
                    navigator.sendBeacon('/blog/@Model.Id/view');
                } else {
                    fetch('/blog/@Model.Id/view', { method: 'POST', keepalive: true, credentials: 'same-origin' }).catch(function () { });
                }
            } catch (e) { }
        })();
    </script>
}
