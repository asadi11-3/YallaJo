@model YallaJo.Web.Areas.Public.Models.Blog.BlogsGridVm
@using YallaJo.Web.Infrastructure.Seo
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    ViewData.SetSeo(new SeoModel
    {
        Title = Localizer["Public.Seo.BlogTitle"].Value,
        Description = Localizer["Public.Seo.BlogDescription"].Value,
        Canonical = $"{baseUrl}/blog",
        OgType = "website",
    });
}

<section class="pt-4 pb-2">
    <div class="container">
        <nav aria-label="@Localizer["Public.breadcrumb"]">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a asp-area="Public" asp-controller="Home" asp-action="Index">@Localizer["Public.Home"]</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Localizer["Public.Blog"]</li>
            </ol>
        </nav>
        <h1 class="fs-2 mb-0">@Localizer["Public.Travel.blog"]</h1>
        <p class="text-secondary">@Localizer["Public.Stories.tips.and.guides.from.local.creators"]</p>
    </div>
</section>

<section class="pb-5">
    <div class="container">
        @* Phase 7: results live in a swappable fragment; listing.js paginates via AJAX (UI-UX-S1, PE1 fallback = native links). *@
        <div id="listingResults" data-yj-component="listing" aria-live="polite" aria-busy="false"
             data-error-text="@Localizer["Public.Results.Error"]" data-retry-text="@Localizer["Public.Retry"]" data-loading-text="@Localizer["Public.Loading"]">
            <partial name="_BlogResults" model="Model" />
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/assets/js/listing.js" asp-append-version="true"></script>
}
