@model YallaJo.Web.Areas.Public.Models.Contact.ContactFormVm
@{
    ViewData["Title"] = "Contact Us";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isAuthed = User.Identity?.IsAuthenticated == true;
    var returnUrl = Url.Action("Index", "Contact", new { area = "Public" });
}

<section class="pt-4 pt-md-5">
    <div class="container">
        <div class="row">
            <div class="col-xl-8 mx-auto text-center">
                <h1 class="mb-3">Let's connect</h1>
                <p class="mb-0 lead">Have a question about a tour, a booking, or your account? Send us a message and our support team will get back to you.</p>
            </div>
        </div>
    </div>
</section>

<section class="pt-3 pt-md-4">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-6 col-xl-4">
                <div class="card card-body shadow text-center align-items-center h-100">
                    <div class="icon-lg bg-info bg-opacity-10 text-info rounded-circle mb-3">
                        <i class="bi bi-headset fs-4"></i>
                    </div>
                    <h5 class="mb-2">Call us</h5>
                    <p class="mb-2 small">Mon to Fri, 9:00 - 18:00</p>
                    <a href="tel:+1234567890" class="btn btn-link p-0 mb-0">+1 234 567 890</a>
                </div>
            </div>
            <div class="col-md-6 col-xl-4">
                <div class="card card-body shadow text-center align-items-center h-100">
                    <div class="icon-lg bg-danger bg-opacity-10 text-danger rounded-circle mb-3">
                        <i class="bi bi-inboxes-fill fs-4"></i>
                    </div>
                    <h5 class="mb-2">Email us</h5>
                    <p class="mb-2 small">We reply within 24 hours</p>
                    <a href="mailto:support@yallajo.com" class="btn btn-link p-0 mb-0">support@yallajo.com</a>
                </div>
            </div>
            <div class="col-md-12 col-xl-4">
                <div class="card card-body shadow text-center align-items-center h-100">
                    <div class="icon-lg bg-warning bg-opacity-10 text-warning rounded-circle mb-3">
                        <i class="bi bi-globe2 fs-4"></i>
                    </div>
                    <h5 class="mb-2">Social media</h5>
                    <p class="mb-2 small">Follow us for updates</p>
                    <ul class="list-inline mb-0">
                        <li class="list-inline-item"><a class="btn btn-sm btn-light px-2" href="#"><i class="bi bi-facebook"></i></a></li>
                        <li class="list-inline-item"><a class="btn btn-sm btn-light px-2" href="#"><i class="bi bi-instagram"></i></a></li>
                        <li class="list-inline-item"><a class="btn btn-sm btn-light px-2" href="#"><i class="bi bi-twitter-x"></i></a></li>
                        <li class="list-inline-item"><a class="btn btn-sm btn-light px-2" href="#"><i class="bi bi-linkedin"></i></a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="pt-3 pt-md-5">
    <div class="container">
        <div class="row g-4 g-lg-5 align-items-center">
            <div class="col-lg-6 text-center">
                <img src="~/assets/images/element/contact.svg" alt="Contact" class="img-fluid" style="max-height:380px;" />
            </div>
            <div class="col-lg-6">
                <div class="card bg-light p-4 p-sm-5">
                    <h3 class="mb-1">Send us a message</h3>
                    <p class="mb-4 small text-body-secondary">Fill in the form below and we'll open a support ticket for you.</p>

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <form method="post" asp-area="Public" asp-controller="Contact" asp-action="Submit" class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" autocomplete="name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Category" class="form-label"></label>
                            <select asp-for="Category" class="form-select">
                                <option value="">Select a topic</option>
                                <option value="AccountHelp">Account help</option>
                                <option value="BookingIssue">Booking issue</option>
                                <option value="PaymentProblem">Payment problem</option>
                                <option value="BugReport">Report a bug</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Subject" class="form-label"></label>
                            <input asp-for="Subject" class="form-control" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Message" class="form-label"></label>
                            <textarea asp-for="Message" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Message" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            @if (isAuthed)
                            {
                                <button type="submit" class="btn btn-dark mb-0">Send Message</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-dark mb-0 disabled" disabled data-bs-toggle="tooltip" title="Sign in to contact support">Send Message</button>
                                <p class="small mt-2 mb-0">
                                    <a asp-area="Auth" asp-controller="Auth" asp-action="SignIn" asp-route-returnUrl="@returnUrl">Sign in</a>
                                    to contact our support team.
                                </p>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        [...document.querySelectorAll('[data-bs-toggle="tooltip"]')].forEach(el => new bootstrap.Tooltip(el));
    </script>
}
