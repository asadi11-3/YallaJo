@model YallaJo.Web.Areas.Public.Models.Contact.ContactFormVm
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Public.Contact.Us"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isAuthed = User.Identity?.IsAuthenticated == true;
    var returnUrl = Url.Action("Index", "Contact", new { area = "Public" });
}

<section class="pt-4 pt-md-5">
    <div class="container">
        <div class="row g-4 g-lg-5">
            <div class="col-lg-5">
                <h1 class="mb-3">@Localizer["Public.Get.in.touch"]</h1>
                <p class="mb-4">@Localizer["Public.Questions.about.a.tour.your.booking.or.your.account.We.re.here.to.help"]</p>

                <div class="vstack gap-3">
                    <div class="d-flex align-items-center">
                        <div class="icon-md bg-info bg-opacity-10 text-info rounded-circle flex-shrink-0 me-3">
                            <i class="bi bi-headset"></i>
                        </div>
                        <div>
                            <h6 class="mb-0">@Localizer["Public.Call.us"]</h6>
                            <a href="tel:+1234567890" class="text-reset small">+1 234 567 890</a>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <div class="icon-md bg-danger bg-opacity-10 text-danger rounded-circle flex-shrink-0 me-3">
                            <i class="bi bi-inboxes-fill"></i>
                        </div>
                        <div>
                            <h6 class="mb-0">@Localizer["Public.Email.us"]</h6>
                            <a href="mailto:support@yallajo.com" class="text-reset small">support@yallajo.com</a>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <div class="icon-md bg-warning bg-opacity-10 text-warning rounded-circle flex-shrink-0 me-3">
                            <i class="bi bi-globe2"></i>
                        </div>
                        <div>
                            <h6 class="mb-0">@Localizer["Public.Follow.us"]</h6>
                            <ul class="list-inline mb-0">
                                <li class="list-inline-item"><a class="text-reset" href="#"><i class="bi bi-facebook"></i></a></li>
                                <li class="list-inline-item"><a class="text-reset" href="#"><i class="bi bi-instagram"></i></a></li>
                                <li class="list-inline-item"><a class="text-reset" href="#"><i class="bi bi-twitter-x"></i></a></li>
                                <li class="list-inline-item"><a class="text-reset" href="#"><i class="bi bi-linkedin"></i></a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card bg-light p-4 p-sm-5">
                    <h3 class="mb-1">@Localizer["Public.Send.us.a.message"]</h3>
                    <p class="mb-4 small text-body-secondary">@Localizer["Public.Fill.in.the.form.below.and.we.ll.open.a.support.ticket.for.you"]</p>

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <form method="post" asp-area="Public" asp-controller="Contact" asp-action="Submit" class="row g-3">
                        @Html.AntiForgeryToken()
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" autocomplete="name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Category" class="form-label"></label>
                            <select asp-for="Category" class="form-select">
                                <option value="">@Localizer["Public.Select.a.topic"]</option>
                                <option value="AccountHelp">@Localizer["Public.Account.help"]</option>
                                <option value="BookingIssue">@Localizer["Public.Booking.issue"]</option>
                                <option value="PaymentProblem">@Localizer["Public.Payment.problem"]</option>
                                <option value="BugReport">@Localizer["Public.Report.a.bug"]</option>
                                <option value="Other">@Localizer["Public.Other"]</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Subject" class="form-label"></label>
                            <input asp-for="Subject" class="form-control" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Message" class="form-label"></label>
                            <textarea asp-for="Message" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Message" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            @if (isAuthed)
                            {
                                <button type="submit" class="btn btn-dark mb-0">@Localizer["Public.Send.Message"]</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-dark mb-0 disabled" disabled data-bs-toggle="tooltip" title="@Localizer["Public.Sign.in.to.contact.support"]">@Localizer["Public.Send.Message"]</button>
                                <p class="small mt-2 mb-0">
                                    <a asp-area="Auth" asp-controller="Auth" asp-action="SignIn" asp-route-returnUrl="@returnUrl">@Localizer["Public.Sign.in"]</a>
                                    to contact our support team.
                                </p>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/contact-index2.js" asp-append-version="true"></script>
}
