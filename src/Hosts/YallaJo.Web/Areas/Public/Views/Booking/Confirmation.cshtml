@model YallaJo.Web.Areas.Public.Models.Booking.BookingConfirmVm
@{
    ViewData["Title"] = "Booking confirmation";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string Money(decimal amount, string? currency) =>
        string.IsNullOrWhiteSpace(currency) ? amount.ToString("N0") : $"{amount:N0} {currency}";
}

<section class="pt-3 pt-lg-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9 col-xl-8">

                <div class="text-center mb-4">
                    @if (Model.IsCancelled)
                    {
                        <div class="icon-lg rounded-circle bg-danger bg-opacity-10 text-danger d-inline-flex align-items-center justify-content-center mb-3" style="width:64px;height:64px;">
                            <i class="bi bi-x-lg fs-3"></i>
                        </div>
                        <h1 class="h3 mb-1">Booking cancelled</h1>
                    }
                    else
                    {
                        <div class="icon-lg rounded-circle bg-success bg-opacity-10 text-success d-inline-flex align-items-center justify-content-center mb-3" style="width:64px;height:64px;">
                            <i class="bi bi-check-lg fs-3"></i>
                        </div>
                        <h1 class="h3 mb-1">Booking confirmed</h1>
                    }
                    <p class="text-secondary mb-0">Reference <span class="fw-semibold">@Model.Reference</span></p>
                </div>

                <div class="card border mb-4">
                    <div class="card-body">
                        <div class="row g-3 align-items-center mb-3">
                            <div class="col-sm-3">
                                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                                {
                                    <img src="@Model.ImageUrl" class="rounded w-100" style="height:90px;object-fit:cover;" alt="@Model.TourName" />
                                }
                                else
                                {
                                    <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height:90px;">
                                        <i class="bi bi-image fs-3 text-secondary"></i>
                                    </div>
                                }
                            </div>
                            <div class="col-sm-9">
                                <h5 class="mb-1">@Model.TourName</h5>
                                <ul class="nav nav-divider small mb-0">
                                    <li class="nav-item">@Model.ParticipantCount traveler(s)</li>
                                    <li class="nav-item">Booked @Model.CreatedAt.ToString("dd MMM yyyy")</li>
                                    <li class="nav-item">
                                        <span class="badge text-bg-light text-uppercase">@Model.Status</span>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.SpecialRequests))
                        {
                            <p class="small mb-3"><span class="fw-semibold">Special requests:</span> @Model.SpecialRequests</p>
                        }

                        <h6 class="border-bottom pb-2 mb-3">Price summary</h6>
                        @if (Model.LineItems.Any())
                        {
                            <ul class="list-group list-group-borderless small mb-2">
                                @foreach (var line in Model.LineItems)
                                {
                                    <li class="list-group-item d-flex justify-content-between px-0 py-1">
                                        <span>@line.TierType &times; @line.Count</span>
                                        <span>@Money(line.UnitPrice * line.Count, Model.Currency)</span>
                                    </li>
                                }
                            </ul>
                        }
                        <ul class="list-group list-group-borderless mb-0">
                            <li class="list-group-item d-flex justify-content-between px-0 py-1">
                                <span>Subtotal</span><span>@Money(Model.Subtotal, Model.Currency)</span>
                            </li>
                            @if (Model.DiscountAmount > 0)
                            {
                                <li class="list-group-item d-flex justify-content-between px-0 py-1 text-success">
                                    <span>Discount</span><span>-@Money(Model.DiscountAmount, Model.Currency)</span>
                                </li>
                            }
                            @if (Model.LoyaltyAmount > 0)
                            {
                                <li class="list-group-item d-flex justify-content-between px-0 py-1 text-success">
                                    <span>Loyalty</span><span>-@Money(Model.LoyaltyAmount, Model.Currency)</span>
                                </li>
                            }
                            <li class="list-group-item d-flex justify-content-between px-0 pt-2 border-top fw-bold">
                                <span>Total</span><span>@Money(Model.TotalAmount, Model.Currency)</span>
                            </li>
                        </ul>
                    </div>
                </div>

                @if (Model.IsCancelled)
                {
                    <div class="alert alert-warning">
                        This booking was cancelled@(Model.CancelledAt is { } c ? $" on {c:dd MMM yyyy}" : "").
                        @if (Model.RefundAmount is > 0)
                        {
                            <text> A refund of @Money(Model.RefundAmount.Value, Model.Currency) was issued.</text>
                        }
                    </div>
                }
                else if (Model.AwaitingPayment)
                {
                    <div class="alert alert-info d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <span><i class="bi bi-hourglass-split me-2"></i>Your booking is awaiting payment@(Model.PaymentExpiresAt is { } p ? $" (expires {p:dd MMM yyyy HH:mm})" : "").</span>
                        <a class="btn btn-sm btn-primary mb-0" asp-area="Accounts" asp-controller="Bookings" asp-action="Index">Complete payment</a>
                    </div>
                }

                <div class="d-flex flex-wrap gap-2 justify-content-center">
                    <button type="button" class="btn btn-outline-primary mb-0" onclick="window.print()"><i class="bi bi-download me-2"></i>Download PDF</button>
                    <a class="btn btn-primary mb-0" asp-area="Accounts" asp-controller="Bookings" asp-action="Index">My bookings</a>
                    <a class="btn btn-light mb-0" asp-area="Public" asp-controller="Tours" asp-action="Index">Explore more tours</a>
                </div>

            </div>
        </div>
    </div>
</section>
