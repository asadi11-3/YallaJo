@model YallaJo.Web.Areas.Public.Models.Tours.TourDetailVm
@using YallaJo.Web.Infrastructure.Seo
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    // API origin the public tour-slots SignalR hub (/hubs/tour) lives on (UI-PERF S2).
    var apiBaseUrl = (Configuration["ApiBaseUrl"] ?? string.Empty).TrimEnd('/');
    var heroImage = Model.ImageUrls.Count > 0 ? Model.ImageUrls[0] : null;
    var seoDescription = Model.Seo?.MetaDescription ?? Model.ShortDescription ?? Model.Description;
    var jsonLd = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "TouristAttraction",
        ["name"] = Model.Name,
        ["description"] = seoDescription,
        ["image"] = heroImage,
        ["offers"] = new Dictionary<string, object?>
        {
            ["@type"] = "Offer",
            ["price"] = Model.EffectivePrice,
            ["priceCurrency"] = Model.Currency
        }
    };
    if (Model.ReviewCount > 0)
    {
        jsonLd["aggregateRating"] = new Dictionary<string, object?>
        {
            ["@type"] = "AggregateRating",
            ["ratingValue"] = Model.AverageRating,
            ["reviewCount"] = Model.ReviewCount
        };
    }
    // SANITIZED: JSON-LD serialized via System.Text.Json (output is JSON-safe; _Layout renders it as application/ld+json)
    ViewData.SetSeo(new SeoModel
    {
        Title = Model.Seo?.MetaTitle ?? Model.Name,
        Description = seoDescription,
        Canonical = Model.Seo?.Canonical ?? $"{baseUrl}/tours/{Model.Slug}",
        OgImage = Model.Seo?.OgImage ?? heroImage,
        OgType = "website",
        JsonLd = System.Text.Json.JsonSerializer.Serialize(jsonLd)
    });
    Layout = "~/Views/Shared/_Layout.cshtml";

    var isAuthed = User.Identity?.IsAuthenticated == true;

    string Currency(decimal amount, string currency) =>
        string.IsNullOrWhiteSpace(currency) ? amount.ToString("N0") : $"{amount:N0} {currency}";

    var showItinerary = Model.Waypoints.Count > 0;
    var showPricing = Model.PricingTiers.Count > 0 || Model.Schedules.Count > 0;
}

@Html.AntiForgeryToken()

<!-- ======================= Tour detail banner START -->
<section class="pt-4">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <nav aria-label="@Localizer["Public.breadcrumb"]" class="mb-2">
                    <ol class="breadcrumb breadcrumb-dots mb-0">
                        <li class="breadcrumb-item"><a asp-area="Public" asp-controller="Tours" asp-action="Index">@Localizer["Public.Tours"]</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
                    </ol>
                </nav>

                <div class="d-sm-flex justify-content-sm-between align-items-start">
                    <div>
                        <h1 class="fs-2 mb-2">@Model.Name</h1>
                        <ul class="nav nav-divider align-items-center small mb-0">
                            @if (!string.IsNullOrWhiteSpace(Model.PlaceDisplay))
                            {
                                <li class="nav-item"><i class="bi bi-geo-alt me-1"></i>@Model.PlaceDisplay</li>
                            }
                            <li class="nav-item"><i class="bi bi-clock-history me-1"></i>@Model.DurationLabel</li>
                            @if (!string.IsNullOrWhiteSpace(Model.Difficulty))
                            {
                                <li class="nav-item"><span class="badge text-bg-light">@Model.Difficulty</span></li>
                            }
                            @if (Model.MaxGroupSize is > 0)
                            {
                                <li class="nav-item"><i class="bi bi-people me-1"></i>@Localizer["Public.UpToPeople", Model.MaxGroupSize]</li>
                            }
                            <li class="nav-item">
                                <i class="bi bi-star-fill text-warning me-1"></i>@Model.AverageRating.ToString("0.0")
                                <span class="text-body">(@Localizer["Public.Reviews.Count", Model.ReviewCount])</span>
                            </li>
                        </ul>
                    </div>

                    <div class="mt-3 mt-sm-0">
                        @if (isAuthed)
                        {
                            <button type="button" class="btn btn-sm btn-light js-favorite"
                                    data-entity-type="Tour" data-entity-id="@Model.Id"
                                    title="@Localizer["Public.Save.to.wishlist"]">
                                <i class="bi bi-heart me-1"></i>Save
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-light" disabled
                                    data-bs-toggle="tooltip" title="@Localizer["Public.Log.in.to.save"]">
                                <i class="bi bi-heart me-1"></i>Save
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- ======================= Tour detail banner END -->

<!-- ======================= Gallery START -->
<section class="pt-3">
    <div class="container">
        <div class="row g-2">
            @if (Model.ImageUrls.Count > 0)
            {
                <div class="col-lg-8">
                    <a href="@Model.ImageUrls[0]" class="glightbox" data-gallery="tour-gallery">
                        <img src="@Model.ImageUrls[0]" class="rounded-3 w-100 hero-img-h420 object-cover" alt="@Model.Name">
                    </a>
                </div>
                <div class="col-lg-4">
                    <div class="row g-2">
                        @foreach (var img in Model.ImageUrls.Skip(1).Take(4))
                        {
                            <div class="col-6">
                                <a href="@img" class="glightbox" data-gallery="tour-gallery">
                                    <img src="@img" class="rounded-3 w-100 thumb-h204 object-cover" alt="@Model.Name">
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="col-12">
                    <div class="rounded-3 bg-light d-flex align-items-center justify-content-center hero-img-h420">
                        <i class="bi bi-image text-secondary display-3"></i>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- ======================= Gallery END -->

<!-- ======================= Detail body START -->
<section class="pt-4">
    <div class="container">
        <div class="row g-4 g-xl-5">

            <!-- Main column -->
            <div class="col-xl-8">

                <!-- Pills tabs -->
                <ul class="nav nav-pills nav-pills-bg-soft nav-responsive justify-content-center mb-4" id="tour-pills-tab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="pills-overview-tab" data-bs-toggle="pill"
                                data-bs-target="#pane-overview" type="button" role="tab" aria-selected="true">@Localizer["Public.Overview"]</button>
                    </li>
                    @if (showItinerary)
                    {
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="pills-itinerary-tab" data-bs-toggle="pill"
                                    data-bs-target="#pane-itinerary" type="button" role="tab">@Localizer["Public.Itinerary"]</button>
                        </li>
                    }
                    @if (showPricing)
                    {
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="pills-pricing-tab" data-bs-toggle="pill"
                                    data-bs-target="#pane-pricing" type="button" role="tab">@Localizer["Public.Pricing.amp.Schedule"]</button>
                        </li>
                    }
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="pills-reviews-tab" data-bs-toggle="pill"
                                data-bs-target="#pane-reviews" type="button" role="tab">@Localizer["Public.Reviews"]</button>
                    </li>
                </ul>

                <div class="tab-content">

                    <!-- Overview -->
                    <div class="tab-pane fade show active" id="pane-overview" role="tabpanel">
                        <div class="card border">
                            <div class="card-header border-bottom">
                                <h4 class="card-header-title">@Localizer["Public.Tour.overview"]</h4>
                            </div>
                            <div class="card-body">
                                @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
                                {
                                    <p class="lead">@Model.ShortDescription</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Description))
                                {
                                    <p class="preserve-whitespace">@Model.Description</p>
                                }
                                else if (string.IsNullOrWhiteSpace(Model.ShortDescription))
                                {
                                    <p class="text-body mb-0">@Localizer["Public.No.description.has.been.provided.for.this.tour.yet"]</p>
                                }

                                <h6 class="mt-4 mb-2">@Localizer["Public.Tour.information"]</h6>
                                <ul class="list-group list-group-borderless mb-0">
                                    <li class="list-group-item d-flex justify-content-between px-0">
                                        <span class="h6 fw-light mb-0"><i class="bi bi-clock-history me-2"></i>@Localizer["Public.Duration"]</span>
                                        <span>@Model.DurationLabel</span>
                                    </li>
                                    @if (!string.IsNullOrWhiteSpace(Model.Difficulty))
                                    {
                                        <li class="list-group-item d-flex justify-content-between px-0">
                                            <span class="h6 fw-light mb-0"><i class="bi bi-graph-up-arrow me-2"></i>@Localizer["Public.Difficulty"]</span>
                                            <span>@Model.Difficulty</span>
                                        </li>
                                    }
                                    @if (Model.MaxGroupSize is > 0)
                                    {
                                        <li class="list-group-item d-flex justify-content-between px-0">
                                            <span class="h6 fw-light mb-0"><i class="bi bi-people me-2"></i>@Localizer["Public.Group.size"]</span>
                                            <span>@Localizer["Public.UpToPeople", Model.MaxGroupSize]</span>
                                        </li>
                                    }
                                    @if (Model.MinAge is > 0)
                                    {
                                        <li class="list-group-item d-flex justify-content-between px-0">
                                            <span class="h6 fw-light mb-0"><i class="bi bi-person-badge me-2"></i>@Localizer["Public.Minimum.age"]</span>
                                            <span>@Localizer["Public.Years", Model.MinAge]</span>
                                        </li>
                                    }
                                    @if (Model.IsChildFriendly)
                                    {
                                        <li class="list-group-item d-flex justify-content-between px-0">
                                            <span class="h6 fw-light mb-0"><i class="bi bi-emoji-smile me-2"></i>@Localizer["Public.Child.friendly"]</span>
                                            <span class="text-success">@Localizer["Public.Yes"]</span>
                                        </li>
                                    }
                                    @if (Model.IsAccessible)
                                    {
                                        <li class="list-group-item d-flex justify-content-between px-0">
                                            <span class="h6 fw-light mb-0"><i class="bi bi-universal-access me-2"></i>@Localizer["Public.Wheelchair.accessible"]</span>
                                            <span class="text-success">@Localizer["Public.Yes"]</span>
                                        </li>
                                    }
                                    @if (Model.IsInstantBooking)
                                    {
                                        <li class="list-group-item d-flex justify-content-between px-0">
                                            <span class="h6 fw-light mb-0"><i class="bi bi-lightning-charge me-2"></i>@Localizer["Public.Instant.booking"]</span>
                                            <span class="text-success">@Localizer["Public.Available"]</span>
                                        </li>
                                    }
                                    @if (Model.CancellationPolicyHours is > 0)
                                    {
                                        <li class="list-group-item d-flex justify-content-between px-0">
                                            <span class="h6 fw-light mb-0"><i class="bi bi-arrow-counterclockwise me-2"></i>@Localizer["Public.Free.cancellation"]</span>
                                            <span>@Localizer["Public.CancellationBefore", Model.CancellationPolicyHours]</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Itinerary -->
                    @if (showItinerary)
                    {
                        <div class="tab-pane fade" id="pane-itinerary" role="tabpanel">
                            <div class="card border">
                                <div class="card-header border-bottom">
                                    <h4 class="card-header-title">@Localizer["Public.Itinerary"]</h4>
                                </div>
                                <div class="card-body">
                                    <div class="accordion accordion-icon accordion-bg-light" id="itineraryAccordion">
                                        @{ var wi = 0; }
                                        @foreach (var wp in Model.Waypoints)
                                        {
                                            wi++;
                                            var collapseId = $"itinerary-collapse-{wi}";
                                            var headingId = $"itinerary-heading-{wi}";
                                            <div class="accordion-item mb-3">
                                                <h6 class="accordion-header" id="@headingId">
                                                    <button class="accordion-button @(wi == 1 ? "" : "collapsed") rounded"
                                                            type="button" data-bs-toggle="collapse"
                                                            data-bs-target="#@collapseId" aria-expanded="@(wi == 1 ? "true" : "false")"
                                                            aria-controls="@collapseId">
                                                        <span class="me-2">@wi.</span>@wp.Name
                                                        @if (!string.IsNullOrWhiteSpace(wp.WaypointType))
                                                        {
                                                            <span class="badge text-bg-light ms-2">@wp.WaypointType</span>
                                                        }
                                                    </button>
                                                </h6>
                                                <div id="@collapseId" class="accordion-collapse collapse @(wi == 1 ? "show" : "")"
                                                     aria-labelledby="@headingId" data-bs-parent="#itineraryAccordion">
                                                    <div class="accordion-body">
                                                        @if (wp.DurationMinutes is > 0)
                                                        {
                                                            <p class="small mb-2"><i class="bi bi-clock me-1"></i>@Localizer["Public.MinutesShort", wp.DurationMinutes]</p>
                                                        }
                                                        <p class="mb-0">@(string.IsNullOrWhiteSpace(wp.Description) ? "—" : wp.Description)</p>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Pricing & schedule -->
                    @if (showPricing)
                    {
                        <div class="tab-pane fade" id="pane-pricing" role="tabpanel">
                            <div class="card border">
                                <div class="card-header border-bottom">
                                    <h4 class="card-header-title">@Localizer["Public.Pricing.amp.schedule"]</h4>
                                </div>
                                <div class="card-body">
                                    @if (Model.PricingTiers.Count > 0)
                                    {
                                        <h6 class="mb-3">@Localizer["Public.Pricing.options"]</h6>
                                        <div class="table-responsive">
                                            <table class="table table-borderless align-middle mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th scope="col">@Localizer["Public.Option"]</th>
                                                        <th scope="col">@Localizer["Public.Participants"]</th>
                                                        <th scope="col" class="text-end">@Localizer["Public.Price"]</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var t in Model.PricingTiers)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <span class="fw-bold">@t.Name</span>
                                                                @if (!string.IsNullOrWhiteSpace(t.ParticipantType))
                                                                {
                                                                    <span class="badge text-bg-light ms-1">@t.ParticipantType</span>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(t.Description))
                                                                {
                                                                    <div class="small text-body">@t.Description</div>
                                                                }
                                                            </td>
                                                            <td>
                                                                @if (t.MinParticipants is { } mn && t.MaxParticipants is { } mx)
                                                                {
                                                                    <text>@mn–@mx</text>
                                                                }
                                                                else if (t.MinParticipants is { } mn2)
                                                                {
                                                                    <text>@mn2+</text>
                                                                }
                                                                else
                                                                {
                                                                    <text>—</text>
                                                                }
                                                            </td>
                                                            <td class="text-end fw-bold text-success">@Currency(t.Price, t.Currency)</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }

                                    @if (Model.Schedules.Count > 0)
                                    {
                                        <h6 class="mb-3 @(Model.PricingTiers.Count > 0 ? "mt-4" : "")">@Localizer["Public.Weekly.schedule"]</h6>
                                        <ul class="list-group list-group-borderless mb-0">
                                            @foreach (var s in Model.Schedules)
                                            {
                                                <li class="list-group-item d-flex justify-content-between px-0">
                                                    <span class="h6 fw-light mb-0"><i class="bi bi-calendar-week me-2"></i>@s.DayOfWeek</span>
                                                    <span>
                                                        @if (!string.IsNullOrWhiteSpace(s.StartTime))
                                                        {
                                                            <text>@s.StartTime@(string.IsNullOrWhiteSpace(s.EndTime) ? "" : " – " + s.EndTime)</text>
                                                        }
                                                        else
                                                        {
                                                            <text>@Localizer["Public.Flexible"]</text>
                                                        }
                                                    </span>
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Reviews -->
                    <div class="tab-pane fade" id="pane-reviews" role="tabpanel">
                        <div class="card border">
                            <div class="card-header border-bottom d-sm-flex justify-content-between align-items-center">
                                <h4 class="card-header-title mb-0">@Localizer["Public.Guest.reviews"]</h4>
                                <div class="mt-2 mt-sm-0">
                                    <span class="h5 mb-0"><i class="bi bi-star-fill text-warning me-1"></i>@Model.AverageRating.ToString("0.0")</span>
                                    <span class="small text-body">(@Localizer["Public.Reviews.Count", Model.ReviewCount])</span>
                                </div>
                            </div>
                            <div class="card-body">
                                @if (Model.Reviews.Count == 0)
                                {
                                    <p class="text-body mb-0">@Localizer["Public.No.reviews.yet.Be.the.first.to.share.your.experience"]</p>
                                }
                                else
                                {
                                    foreach (var r in Model.Reviews)
                                    {
                                        <div class="border-bottom pb-3 mb-3">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <div>
                                                    @for (var i = 1; i <= 5; i++)
                                                    {
                                                        <i class="bi @(i <= r.Rating ? "bi-star-fill" : "bi-star") text-warning small"></i>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(r.Title))
                                                    {
                                                        <span class="fw-bold ms-2">@r.Title</span>
                                                    }
                                                </div>
                                                <small class="text-body">@r.CreatedAt.ToString("d MMM yyyy")</small>
                                            </div>
                                            @if (r.IsVerifiedBooking)
                                            {
                                                <span class="badge text-bg-success bg-opacity-10 text-success small mb-2"><i class="bi bi-patch-check me-1"></i>@Localizer["Public.Verified.booking"]</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(r.Content))
                                            {
                                                <p class="mb-1">@r.Content</p>
                                            }
                                            @if (r.HelpfulVoteCount > 0)
                                            {
                                                <small class="text-body"><i class="bi bi-hand-thumbs-up me-1"></i>@Localizer["Public.HelpfulCount", r.HelpfulVoteCount]</small>
                                            }
                                        </div>
                                    }
                                }

                                @if (Model.Guides.Count > 0)
                                {
                                    <h6 class="mt-2 mb-3">@Localizer["Public.Your.guides"]</h6>
                                    <div class="row g-3">
                                        @foreach (var g in Model.Guides)
                                        {
                                            <div class="col-sm-6">
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrWhiteSpace(g.AvatarUrl))
                                                    {
                                                        <img src="@g.AvatarUrl" class="avatar avatar-md rounded-circle me-2 avatar-48 object-cover" alt="@g.DisplayName">
                                                    }
                                                    else
                                                    {
                                                        <span class="avatar avatar-md me-2 d-inline-flex align-items-center justify-content-center bg-light rounded-circle avatar-48">
                                                            <i class="bi bi-person text-secondary"></i>
                                                        </span>
                                                    }
                                                    <div>
                                                        <h6 class="mb-0">@g.DisplayName</h6>
                                                        @if (g.IsPrimary)
                                                        {
                                                            <small class="text-primary">@Localizer["Public.Lead.guide"]</small>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Sidebar -->
            <aside class="col-xl-4">
                <div class="row g-4">
                    <!-- Book now -->
                    <div class="col-12">
                        <div class="card card-body border">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div class="hstack gap-2 align-items-end">
                                    <h3 class="mb-0 text-success">@Currency(Model.EffectivePrice, Model.Currency)</h3>
                                    <small class="mb-1">@Localizer["Public.person"]</small>
                                </div>
                                @if (Model.HasDiscount)
                                {
                                    <span class="badge text-bg-danger">@Localizer["Public.PercentOff", Model.DiscountPercent]</span>
                                }
                            </div>
                            @if (Model.HasDiscount)
                            {
                                <p class="small mb-2"><span class="text-decoration-line-through">@Currency(Model.BasePrice, Model.Currency)</span></p>
                            }
                            <div class="d-flex align-items-center mb-3 small">
                                <i class="bi bi-star-fill text-warning me-1"></i>@Model.AverageRating.ToString("0.0")
                                <span class="text-body ms-1">(@Model.ReviewCount)</span>
                            </div>

                            <div class="d-grid gap-2">
                                <a asp-area="Public" asp-controller="Booking" asp-action="Book"
                                   asp-route-tourId="@Model.Id" class="btn btn-primary mb-0">@Localizer["Public.Book.Now"]</a>
                                @if (isAuthed)
                                {
                                    <button type="button" class="btn btn-outline-primary mb-0 js-favorite"
                                            data-entity-type="Tour" data-entity-id="@Model.Id">
                                        <i class="bi bi-heart me-1"></i>Save to wishlist
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-primary mb-0" disabled
                                            data-bs-toggle="tooltip" title="@Localizer["Public.Log.in.to.save"]">
                                        <i class="bi bi-heart me-1"></i>Save to wishlist
                                    </button>
                                }
                            </div>

                            @if (Model.HasJoinSlots)
                            {
                                <hr class="my-3">
                                @* Live availability (UI-UX-CAL3 / RT1): seats remaining update over SignalR
                                   on the tour:{tourId} group. data-hub-url points at the API origin; the
                                   client (tour-slots.js) joins JoinTour(tourId) and patches [data-remaining]. *@
                                <div class="tour-slots"
                                     data-yj-component="tour-slots"
                                     data-tour-id="@Model.Id"
                                     data-hub-url="@apiBaseUrl"
                                     data-full-label="@Localizer["Public.Slot.Full"]"
                                     data-offline-label="@Localizer["Public.Live.availability.paused"]"
                                     data-reconnect-label="@Localizer["Public.Reconnect"]"
                                     aria-live="polite">
                                    <h6 class="small fw-bold mb-2">
                                        <i class="bi bi-broadcast me-1" aria-hidden="true"></i>@Localizer["Public.Live.availability"]
                                    </h6>
                                    <ul class="list-unstyled mb-0 small">
                                        @foreach (var slot in Model.JoinSlots)
                                        {
                                            <li class="d-flex justify-content-between align-items-center py-1 tour-slots__row"
                                                data-slot-id="@slot.SlotId">
                                                <span class="text-body"><bdi>@slot.Label</bdi></span>
                                                <span class="badge bg-success-subtle text-success-emphasis"
                                                      data-remaining>&mdash;</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }

                            <hr class="my-3">
                            <p class="small text-body mb-2">@Localizer["Public.Joining.a.friend.s.group.booking"]</p>
                            @if (isAuthed)
                            {
                                <button type="button" class="btn btn-outline-primary w-100" data-bs-toggle="modal" data-bs-target="#joinRequestModal">
                                    <i class="bi bi-people me-2"></i>Request to join a group
                                </button>
                            }
                            else
                            {
                                <a class="btn btn-outline-primary w-100"
                                   asp-area="Auth" asp-controller="Auth" asp-action="SignIn"
                                   asp-route-returnUrl="@Url.Action("Detail", "Tours", new { area = "Public", slug = Model.Slug })">
                                    <i class="bi bi-people me-2"></i>Sign in to request to join
                                </a>
                            }
                        </div>
                    </div>

                    <!-- Need help -->
                    <div class="col-12">
                        <div class="card card-body bg-light border">
                            <h5 class="mb-3">@Localizer["Public.Need.help"]</h5>
                            <ul class="list-group list-group-borderless mb-0">
                                <li class="list-group-item bg-transparent px-0 py-1"><i class="bi bi-headset me-2"></i>@Localizer["Public.Our.travel.experts.are.here.for.you"]</li>
                                <li class="list-group-item bg-transparent px-0 py-1"><i class="bi bi-clock me-2"></i>@Localizer["Public.Sat.Thu.9.00.18.00"]</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </aside>

        </div>
    </div>
</section>
<!-- ======================= Detail body END -->

@if (Model.Seo?.HasFaqs == true)
{
    <section class="pb-5">
        <div class="container">
            <h4 class="mb-3">@Localizer["Public.Frequently.asked.questions"]</h4>
            <div class="accordion accordion-flush" id="tourFaq">
                @for (var i = 0; i < Model.Seo.Faqs.Count; i++)
                {
                    var faq = Model.Seo.Faqs[i];
                    var headingId = $"tourFaqHeading{i}";
                    var collapseId = $"tourFaqCollapse{i}";
                    var expanded = i == 0;
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="@headingId">
                            <button class="accordion-button @(expanded ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(expanded ? "true" : "false")" aria-controls="@collapseId">@faq.Question</button>
                        </h2>
                        <div id="@collapseId" class="accordion-collapse collapse @(expanded ? "show" : "")" data-bs-parent="#tourFaq">
                            <div class="accordion-body">@faq.Answer</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (ViewData["AccessibilityReviews"] is YallaJo.Web.Areas.Public.Models.AccessibilityReviews.AccessibilityReviewListVm accessibilityReviews)
{
    <partial name="~/Areas/Public/Views/Shared/_AccessibilityReviews.cshtml" model="accessibilityReviews" />
}

@if (ViewData["Reviews"] is YallaJo.Web.Areas.Public.Models.Reviews.ReviewListVm reviews)
{
    <partial name="~/Areas/Public/Views/Shared/_Reviews.cshtml" model="reviews" />
    @if (User.Identity?.IsAuthenticated == true)
    {
        <section class="pb-5">
            <div class="container">
                <div class="row g-4">
                    <div class="col-lg-7">
                        <form method="post" asp-area="Public" asp-controller="Tours" asp-action="CreateReview" asp-route-slug="@Model.Slug" class="card border p-3" data-loading>
                            @Html.AntiForgeryToken()
                            <h3 class="h6 mb-3">@Localizer["Public.Write.a.review"]</h3>
                            <input type="hidden" name="Review.TargetId" value="@Model.Id" />
                            <div class="mb-2">
                                <label class="form-label" for="tourReviewRating">@Localizer["Public.Rating"]</label>
                                <select id="tourReviewRating" name="Review.Rating" class="form-select">
                                    <option value="5">@Localizer["Public.5.Excellent"]</option>
                                    <option value="4">@Localizer["Public.4.Very.good"]</option>
                                    <option value="3">@Localizer["Public.3.Average"]</option>
                                    <option value="2">@Localizer["Public.2.Poor"]</option>
                                    <option value="1">@Localizer["Public.1.Terrible"]</option>
                                </select>
                            </div>
                            <div class="mb-2">
                                <label class="form-label" for="tourReviewTitle">@Localizer["Public.Title"]</label>
                                <input id="tourReviewTitle" name="Review.Title" maxlength="150" class="form-control" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label" for="tourReviewContent">@Localizer["Public.Your.review"]</label>
                                <textarea id="tourReviewContent" name="Review.Content" rows="4" minlength="20" maxlength="2000" required class="form-control"></textarea>
                                <div class="form-text">@Localizer["Public.Between.20.and.2000.characters"]</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="tourReviewVisitDate">@Localizer["Public.Visit.date.optional"]</label>
                                <input id="tourReviewVisitDate" type="date" name="Review.VisitDate" class="form-control" />
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">@Localizer["Public.Submit.review"]</button>
                        </form>
                    </div>
                    <div class="col-lg-5">
                        <form method="post" asp-area="Public" asp-controller="Tours" asp-action="Report" asp-route-slug="@Model.Slug" class="card border p-3" data-loading>
                            @Html.AntiForgeryToken()
                            <h3 class="h6 mb-3">@Localizer["Public.Report.this.tour"]</h3>
                            <input type="hidden" name="Report.EntityId" value="@Model.Id" />
                            <div class="mb-2">
                                <label class="form-label" for="tourReportReason">@Localizer["Public.Reason"]</label>
                                <select id="tourReportReason" name="Report.Reason" class="form-select">
                                    <option value="Inappropriate">@Localizer["Public.Inappropriate"]</option>
                                    <option value="Misleading">@Localizer["Public.Misleading"]</option>
                                    <option value="Spam">@Localizer["Public.Spam"]</option>
                                    <option value="Harassment">@Localizer["Public.Harassment"]</option>
                                    <option value="FakeReview">@Localizer["Public.Fake.review"]</option>
                                    <option value="Other">@Localizer["Public.Other"]</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="tourReportDescription">@Localizer["Public.Details"]</label>
                                <textarea id="tourReportDescription" name="Report.Description" rows="3" minlength="5" maxlength="1000" required class="form-control"></textarea>
                            </div>
                            <button type="submit" class="btn btn-outline-secondary btn-sm">@Localizer["Public.Submit.report"]</button>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    }
}

@if (isAuthed)
{
    <partial name="_JoinRequestModal" model="Model" />
}

@section Scripts {
    <script src="~/assets/js/tours-detail.js" asp-append-version="true"></script>
    @if (Model.HasJoinSlots && !string.IsNullOrEmpty(apiBaseUrl))
    {
        @* UI-PERF S2: the ONE public-page SignalR hub. Self-hosted client (CSP-friendly: external
           scripts from 'self'; the negotiate/ws connection needs connect-src to allowlist @apiBaseUrl + wss:). *@
        <script src="~/assets/js/lib/signalr/signalr.min.js" asp-append-version="true"></script>
        <script src="~/assets/js/tour-slots.js" asp-append-version="true" defer></script>
    }
}
