@model YallaJo.Web.Areas.Public.Models.Tours.TourGridVm
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Public.Explore.Tours"];
    Layout = "~/Views/Shared/_Layout.cshtml";

    var rangeStart = Model.TotalCount == 0 ? 0 : ((Model.PageNumber - 1) * Model.PageSize) + 1;
    var rangeEnd = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount);
}

<!-- ======================= Page banner START -->
<section class="pt-3">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center">
                <h1 class="h2 mb-2">@Localizer["Public.Explore.Tours"]</h1>
                <p class="mb-0">@Localizer["Public.Discover.handpicked.experiences.and.book.your.next.adventure"]</p>
            </div>
        </div>
    </div>
</section>
<!-- ======================= Page banner END -->

<!-- ======================= Tour grid START -->
<section class="pt-4">
    <div class="container">

        @if (Model.HasPlaceFilter)
        {
            <!-- Active place filter badge (CP-3c) -->
            <div class="row mb-3">
                <div class="col-12">
                    <span class="badge text-bg-primary fs-6 me-2">
                        <i class="bi bi-geo-alt me-1"></i>@Model.PlaceFilterLabel
                    </span>
                    <a asp-area="Public" asp-controller="Tours" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-x-lg me-1"></i>@Localizer["Public.Clear.place.filter"]
                    </a>
                </div>
            </div>
        }

        <!-- Filter bar START -->
        <div class="row g-3 align-items-center justify-content-between mb-4">
            <div class="col-12 col-xl-5">
                <h5 class="mb-0">
                    @Localizer["Public.ShowingResults", rangeStart, rangeEnd, Model.TotalCount]
                </h5>
            </div>

            <!-- Client-side text search over the loaded cards -->
            <div class="col-sm-6 col-xl-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" id="tourSearchInput" class="form-control border-start-0"
                           placeholder="@Localizer["Public.Filter.tours.on.this.page"]">
                </div>
            </div>

            <!-- Server-side sort -->
            <div class="col-sm-6 col-xl-3">
                <form method="get" asp-area="Public" asp-controller="Tours" asp-action="Index" id="sortForm">
                    @if (!string.IsNullOrWhiteSpace(Model.Query))
                    {
                        <input type="hidden" name="q" value="@Model.Query" />
                    }
                    <select name="sort" class="form-select" onchange="document.getElementById('sortForm').submit();" aria-label="@Localizer["Public.Sort.tours"]">
                        <option value="popularity_desc" selected="@(Model.Sort == "popularity_desc")">@Localizer["Public.Most.popular"]</option>
                        <option value="newest" selected="@(Model.Sort == "newest")">@Localizer["Public.Newest"]</option>
                        <option value="rating_desc" selected="@(Model.Sort == "rating_desc")">@Localizer["Public.Top.rated"]</option>
                        <option value="price_asc" selected="@(Model.Sort == "price_asc")">@Localizer["Public.Price.low.to.high"]</option>
                        <option value="price_desc" selected="@(Model.Sort == "price_desc")">@Localizer["Public.Price.high.to.low"]</option>
                    </select>
                </form>
            </div>
        </div>
        <!-- Filter bar END -->

        @if (Model.Categories.Count > 0)
        {
            <!-- Client-side category chips -->
            <div class="row mb-4">
                <div class="col-12">
                    <ul class="list-inline mb-0" id="categoryChips">
                        <li class="list-inline-item mb-2">
                            <button type="button" class="btn btn-sm btn-primary js-category-chip active" data-category="">@Localizer["Public.All"]</button>
                        </li>
                        @foreach (var cat in Model.Categories)
                        {
                            <li class="list-inline-item mb-2">
                                <button type="button" class="btn btn-sm btn-light js-category-chip" data-category="@cat.Slug">@cat.Name</button>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (!Model.HasResults)
        {
            <!-- Empty state -->
            <div class="row">
                <div class="col-12 text-center py-5">
                    <img src="~/assets/images/element/17.svg" class="h-100px mb-3" alt="@Localizer["Public.No.tours"]">
                    <h5 class="mb-1">@Localizer["Public.No.tours.found"]</h5>
                    <p class="mb-0">@Localizer["Public.Try.a.different.sort.or.check.back.soon"]</p>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4" id="tourGrid">
                @foreach (var tour in Model.Tours)
                {
                    <partial name="_TourCard"
                             model="tour"
                             view-data='@(new ViewDataDictionary(ViewData) { { "isAuthed", User.Identity?.IsAuthenticated == true }, { "colClass", "col-md-6 col-xl-4 js-tour-card" }, { "dataTitle", tour.Name.ToLowerInvariant() } })' />
                }
            </div>

            <!-- No client-filter matches notice -->
            <div class="row d-none" id="noFilterMatch">
                <div class="col-12 text-center py-5">
                    <h6 class="mb-0">@Localizer["Public.No.tours.on.this.page.match.your.filter"]</h6>
                </div>
            </div>

            <!-- Pagination (shared partial preserves query string, swaps page) -->
            <partial name="_Pagination"
                     model='new YallaJo.Web.Areas.Public.Models.Shared.PaginationVm { PageNumber = Model.PageNumber, TotalPages = Model.TotalPages, AriaLabel = Localizer["Public.Tours.pagination"] }' />
        }
    </div>
</section>
<!-- ======================= Tour grid END -->

@section Scripts {
    <script src="~/assets/js/tours-index.js" asp-append-version="true"></script>
}
