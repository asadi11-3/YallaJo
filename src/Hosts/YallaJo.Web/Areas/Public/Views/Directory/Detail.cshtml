@model YallaJo.Web.Areas.Public.Models.Directory.BusinessDetailVm
@using YallaJo.Web.Infrastructure.Seo
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    ViewData.SetSeo(new SeoModel
    {
        Title = Model.Seo?.MetaTitle ?? Model.Name,
        Description = Model.Seo?.MetaDescription ?? Model.Description,
        Canonical = Model.Seo?.Canonical ?? $"{baseUrl}/businesses/{Model.Id}",
        OgImage = Model.Seo?.OgImage,
        OgType = "website"
    });
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isAuthed = User.Identity?.IsAuthenticated == true;

    string Money(decimal amount, string? currency) =>
        string.IsNullOrWhiteSpace(currency) ? amount.ToString("N0") : $"{amount:N0} {currency}";
}

@functions {
    static string TypeIcon(string? type) => (type ?? string.Empty).ToLowerInvariant() switch
    {
        "restaurant" => "bi bi-cup-hot",
        "hotel" => "bi bi-building",
        "shop" => "bi bi-shop",
        "agency" => "bi bi-briefcase",
        "transport" => "bi bi-truck",
        "guide" => "bi bi-person-badge",
        "activity" => "bi bi-bicycle",
        _ => "bi bi-geo-alt",
    };
}

@Html.AntiForgeryToken()

<!-- Banner -->
<section class="pt-4 pb-0">
    <div class="container">
        <a asp-area="Public" asp-controller="Directory" asp-action="Index" class="btn btn-sm btn-light mb-3">
            <i class="bi bi-arrow-left me-1"></i>Back to directory
        </a>

        <div class="d-sm-flex justify-content-between align-items-start">
            <div>
                <div class="mb-2">
                    @if (!string.IsNullOrWhiteSpace(Model.BusinessType))
                    {
                        <span class="badge text-bg-dark me-1"><i class="@TypeIcon(Model.BusinessType) fa-fw me-1"></i>@Model.BusinessType</span>
                    }
                    @if (Model.IsVerified)
                    {
                        <span class="badge text-bg-success me-1"><i class="bi bi-patch-check-fill me-1"></i>@Localizer["Public.Verified"]</span>
                    }
                    @if (Model.IsFeatured)
                    {
                        <span class="badge text-bg-warning">@Localizer["Public.Featured"]</span>
                    }
                </div>
                <h1 class="h3 mb-1">@Model.Name</h1>
                <ul class="nav nav-divider align-items-center text-muted small">
                    @if (!string.IsNullOrWhiteSpace(Model.Location))
                    {
                        <li class="nav-item"><i class="bi bi-geo-alt-fill me-1"></i>@Model.Location</li>
                    }
                    <li class="nav-item">
                        <i class="bi bi-star-fill text-warning me-1"></i>@Model.AverageRating.ToString("0.0")
                        <span class="text-muted">(@Localizer["Public.Reviews.Count", Model.ReviewCount])</span>
                    </li>
                </ul>
            </div>
            <div class="mt-3 mt-sm-0">
                @if (isAuthed)
                {
                    <button type="button" class="btn btn-sm btn-light js-favorite" data-entity-type="Business" data-entity-id="@Model.Id">
                        <i class="bi bi-heart"></i> Save
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-sm btn-light" disabled data-bs-toggle="tooltip" title="@Localizer["Public.Log.in.to.save"]">
                        <i class="bi bi-heart"></i> Save
                    </button>
                }
            </div>
        </div>
    </div>
</section>

<!-- Gallery -->
<section class="pt-3 pb-0">
    <div class="container">
        @if (Model.ImageUrls.Any())
        {
            <div class="row g-2">
                <div class="col-lg-8">
                    <a href="@Model.ImageUrls[0]" class="glightbox" data-gallery="business-gallery">
                        <img src="@Model.ImageUrls[0]" class="rounded-3 w-100 hero-img-h380 object-cover" alt="@Model.Name">
                    </a>
                </div>
                <div class="col-lg-4">
                    <div class="row g-2">
                        @foreach (var img in Model.ImageUrls.Skip(1).Take(4))
                        {
                            <div class="col-6">
                                <a href="@img" class="glightbox" data-gallery="business-gallery">
                                    <img src="@img" class="rounded-3 w-100 thumb-h185 object-cover" alt="@Model.Name">
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="rounded-3 bg-light d-flex align-items-center justify-content-center hero-img-h320">
                <i class="@TypeIcon(Model.BusinessType) display-3 text-secondary"></i>
            </div>
        }
    </div>
</section>

<!-- Content -->
<section class="pt-4">
    <div class="container">
        <div class="row g-4 g-xl-5">
            <div class="col-xl-8">
                <!-- Overview -->
                <div class="card border mb-4">
                    <div class="card-header border-bottom">
                        <h4 class="card-header-title mb-0">@Localizer["Public.Overview"]</h4>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <p class="mb-0 preserve-whitespace">@Model.Description</p>
                        }
                        else
                        {
                            <p class="text-muted mb-0">@Localizer["Public.No.description.available.for.this.place.yet"]</p>
                        }
                    </div>
                </div>

                <!-- Amenities -->
                @if (Model.Amenities.Any())
                {
                    <div class="card border mb-4">
                        <div class="card-header border-bottom">
                            <h4 class="card-header-title mb-0">@Localizer["Public.Amenities"]</h4>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                @foreach (var a in Model.Amenities)
                                {
                                    <div class="col-sm-6 col-lg-4">
                                        <span class="d-inline-flex align-items-center">
                                            <i class="@(string.IsNullOrWhiteSpace(a.Icon) ? "bi bi-check-circle-fill text-success" : a.Icon) me-2"></i>
                                            @a.Name
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- Services -->
                @if (Model.Services.Any())
                {
                    <div class="card border mb-4">
                        <div class="card-header border-bottom">
                            <h4 class="card-header-title mb-0">@Localizer["Public.Services"]</h4>
                        </div>
                        <div class="card-body">
                            <ul class="list-group list-group-borderless mb-0">
                                @foreach (var s in Model.Services)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span>
                                            <span class="fw-semibold">@s.Name</span>
                                            @if (s.DurationMinutes is > 0)
                                            {
                                                <small class="text-muted ms-2"><i class="bi bi-clock me-1"></i>@Localizer["Public.MinutesShort", s.DurationMinutes]</small>
                                            }
                                        </span>
                                        <span class="text-success fw-semibold">@Money(s.Price, s.Currency)</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }

                <!-- Accessibility -->
                @if (Model.AccessibilityFeatures.Any())
                {
                    <div class="card border mb-4">
                        <div class="card-header border-bottom">
                            <h4 class="card-header-title mb-0">@Localizer["Public.Accessibility"]</h4>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                @foreach (var f in Model.AccessibilityFeatures)
                                {
                                    <div class="col-sm-6">
                                        <span class="d-inline-flex align-items-center">
                                            <i class="bi @(f.IsAvailable ? "bi-check-circle-fill text-success" : "bi-x-circle text-muted") me-2"></i>
                                            <span>
                                                @f.Name
                                                @if (!string.IsNullOrWhiteSpace(f.Description))
                                                {
                                                    <small class="d-block text-muted">@f.Description</small>
                                                }
                                            </span>
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Sidebar -->
            <aside class="col-xl-4">
                @if (Model.Weather is { } weather)
                {
                    <div class="card border mb-4">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <h6 class="text-secondary mb-1"><i class="bi bi-cloud-sun me-1" aria-hidden="true"></i>@Localizer["Public.Weather"]</h6>
                                    @if (weather.HasTemperature)
                                    {
                                        <span class="h3 mb-0">@weather.Temperature.GetValueOrDefault().ToString("0")&deg;C</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(weather.Condition))
                                    {
                                        <div class="text-secondary">@weather.Condition</div>
                                    }
                                </div>
                                <ul class="list-unstyled small text-secondary mb-0 text-end">
                                    @if (weather.FeelsLike.HasValue)
                                    {
                                        <li>@Localizer["Public.FeelsLike", weather.FeelsLike.Value.ToString("0")]&deg;C</li>
                                    }
                                    @if (weather.Humidity.HasValue)
                                    {
                                        <li><i class="bi bi-droplet me-1" aria-hidden="true"></i>@weather.Humidity.Value%</li>
                                    }
                                    @if (weather.WindSpeed.HasValue)
                                    {
                                        <li><i class="bi bi-wind me-1" aria-hidden="true"></i>@Localizer["Public.KmPerHour", weather.WindSpeed.Value.ToString("0.#")]</li>
                                    }
                                </ul>
                            </div>
                            @if (weather.IsStale && !string.IsNullOrWhiteSpace(weather.StaleHumanLabel))
                            {
                                <small class="text-secondary d-block mt-2">@weather.StaleHumanLabel</small>
                            }
                        </div>
                    </div>
                }

                <div class="card border mb-4">
                    <div class="card-header border-bottom">
                        <h5 class="card-header-title mb-0">@Localizer["Public.Contact.amp.info"]</h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-group list-group-borderless mb-0">
                            @if (!string.IsNullOrWhiteSpace(Model.Address))
                            {
                                <li class="list-group-item d-flex px-0"><i class="bi bi-geo-alt-fill text-primary me-2"></i><span>@Model.Address</span></li>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Phone))
                            {
                                <li class="list-group-item d-flex px-0"><i class="bi bi-telephone-fill text-primary me-2"></i><a class="text-reset" href="tel:@Model.Phone">@Model.Phone</a></li>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Email))
                            {
                                <li class="list-group-item d-flex px-0"><i class="bi bi-envelope-fill text-primary me-2"></i><a class="text-reset" href="mailto:@Model.Email">@Model.Email</a></li>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Website))
                            {
                                <li class="list-group-item d-flex px-0"><i class="bi bi-globe text-primary me-2"></i><a class="text-reset" href="@Model.Website" target="_blank" rel="noopener">@Localizer["Public.Visit.website"]</a></li>
                            }
                        </ul>
                    </div>
                </div>

                @if (Model.Hours.Any())
                {
                    @* Phase 8.5: current-day highlight + open-now badge computed client-side in directory-detail.js
                       (client local time approximates business time; acceptable until backend exposes a timezone). *@
                    <div class="card border mb-4" data-yj-component="business-hours"
                         data-open-label="@Localizer["Public.OpenNow"]"
                         data-closed-label="@Localizer["Public.ClosedNow"]">
                        <div class="card-header border-bottom d-flex align-items-center justify-content-between">
                            <h5 class="card-header-title mb-0">@Localizer["Public.Opening.hours"]</h5>
                            <span class="badge d-none ms-2" data-yj-open-badge aria-live="polite"></span>
                        </div>
                        <div class="card-body">
                            <ul class="list-group list-group-borderless mb-0">
                                @foreach (var h in Model.Hours)
                                {
                                    @* Day names arrive as English strings from the API; localize via the current UI culture. *@
                                    var dayLabel = Enum.TryParse<DayOfWeek>(h.DayOfWeek, true, out var dow)
                                        ? System.Globalization.CultureInfo.CurrentUICulture.DateTimeFormat.GetDayName(dow)
                                        : h.DayOfWeek;
                                    <li class="list-group-item d-flex justify-content-between px-0"
                                        data-yj-day="@h.DayOfWeek"
                                        data-yj-closed="@(h.IsClosed ? "true" : "false")"
                                        data-yj-open="@h.OpenTime"
                                        data-yj-close="@h.CloseTime">
                                        <span class="fw-semibold">@dayLabel</span>
                                        @if (h.IsClosed)
                                        {
                                            <span class="text-danger">@Localizer["Public.Closed"]</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted" dir="ltr">@h.OpenTime - @h.CloseTime</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }

                <div class="card border bg-light">
                    <div class="card-body">
                        <h6 class="mb-2">@Localizer["Public.Want.to.save.this.place"]</h6>
                        @if (isAuthed)
                        {
                            <button type="button" class="btn btn-outline-primary w-100 js-favorite" data-entity-type="Business" data-entity-id="@Model.Id">
                                <i class="bi bi-heart me-1"></i>@Localizer["Public.Save.to.wishlist"]
                            </button>
                        }
                        else
                        {
                            <a asp-area="Auth" asp-controller="Auth" asp-action="SignIn" class="btn btn-outline-primary w-100">
                                <i class="bi bi-box-arrow-in-right me-1"></i>@Localizer["Public.Log.in.to.save"]
                            </a>
                        }
                    </div>
                </div>
            </aside>
        </div>
    </div>
</section>

@if (Model.Seo?.HasFaqs == true)
{
    <section class="pb-5">
        <div class="container">
            <h4 class="mb-3">@Localizer["Public.Frequently.asked.questions"]</h4>
            <div class="accordion accordion-flush" id="businessFaq">
                @for (var i = 0; i < Model.Seo.Faqs.Count; i++)
                {
                    var faq = Model.Seo.Faqs[i];
                    var headingId = $"businessFaqHeading{i}";
                    var collapseId = $"businessFaqCollapse{i}";
                    var expanded = i == 0;
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="@headingId">
                            <button class="accordion-button @(expanded ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(expanded ? "true" : "false")" aria-controls="@collapseId">
                                @faq.Question
                            </button>
                        </h2>
                        <div id="@collapseId" class="accordion-collapse collapse @(expanded ? "show" : "")" aria-labelledby="@headingId" data-bs-parent="#businessFaq">
                            <div class="accordion-body">
                                @faq.Answer
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (ViewData["AccessibilityReviews"] is YallaJo.Web.Areas.Public.Models.AccessibilityReviews.AccessibilityReviewListVm accessibilityReviews)
{
    <partial name="~/Areas/Public/Views/Shared/_AccessibilityReviews.cshtml" model="accessibilityReviews" />
}

@if (ViewData["Reviews"] is YallaJo.Web.Areas.Public.Models.Reviews.ReviewListVm reviews)
{
    <partial name="~/Areas/Public/Views/Shared/_Reviews.cshtml" model="reviews" />
    @if (User.Identity?.IsAuthenticated == true)
    {
        <section class="pb-5">
            <div class="container">
                <div class="row g-4">
                    <div class="col-lg-7">
                        <form method="post" asp-area="Public" asp-controller="Reviews" asp-action="CreateReview" asp-route-targetType="business" asp-route-targetId="@Model.Id" class="card border p-3 mb-3 mb-lg-0" data-loading data-success-message="@Localizer["Public.Review.Created"]">
                            @Html.AntiForgeryToken()
                            <h3 class="h6 mb-3">@Localizer["Public.Write.a.review"]</h3>
                            <input type="hidden" name="Review.TargetId" value="@Model.Id" />
                                <input type="hidden" name="returnUrl" value="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" />
                            <div class="mb-2">
                                <label class="form-label" for="directoryReviewRating">@Localizer["Public.Rating"]</label>
                                <select class="form-select" id="directoryReviewRating" name="Review.Rating">
                                    <option value="5">@Localizer["Public.5.Excellent"]</option>
                                    <option value="4">@Localizer["Public.4.Very.good"]</option>
                                    <option value="3">@Localizer["Public.3.Average"]</option>
                                    <option value="2">@Localizer["Public.2.Poor"]</option>
                                    <option value="1">@Localizer["Public.1.Terrible"]</option>
                                </select>
                            </div>
                            <div class="mb-2">
                                <label class="form-label" for="directoryReviewTitle">@Localizer["Public.Title"]</label>
                                <input class="form-control" id="directoryReviewTitle" name="Review.Title" maxlength="150" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label" for="directoryReviewContent">@Localizer["Public.Your.review"]</label>
                                <textarea class="form-control" id="directoryReviewContent" name="Review.Content" rows="4" minlength="20" maxlength="2000" required></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="directoryReviewVisitDate">@Localizer["Public.Visit.date.optional"]</label>
                                <input type="date" class="form-control" id="directoryReviewVisitDate" name="Review.VisitDate" />
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">@Localizer["Public.Submit.review"]</button>
                        </form>
                    </div>
                    <div class="col-lg-5">
                        <form method="post" asp-area="Public" asp-controller="Reviews" asp-action="ReportEntity" asp-route-targetType="business" asp-route-targetId="@Model.Id" class="card border p-3" data-loading data-success-message="@Localizer["Public.Review.Reported"]">
                            @Html.AntiForgeryToken()
                            <h3 class="h6 mb-3">@Localizer["Public.Report.this.business"]</h3>
                            <input type="hidden" name="Report.EntityId" value="@Model.Id" />
                                <input type="hidden" name="returnUrl" value="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)" />
                            <div class="mb-2">
                                <label class="form-label" for="directoryReportReason">@Localizer["Public.Reason"]</label>
                                <select class="form-select" id="directoryReportReason" name="Report.Reason">
                                    <option value="Inappropriate">@Localizer["Public.Inappropriate"]</option>
                                    <option value="Misleading">@Localizer["Public.Misleading"]</option>
                                    <option value="Spam">@Localizer["Public.Spam"]</option>
                                    <option value="Harassment">@Localizer["Public.Harassment"]</option>
                                    <option value="FakeReview">@Localizer["Public.Fake.review"]</option>
                                    <option value="Other">@Localizer["Public.Other"]</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="directoryReportDescription">@Localizer["Public.Details"]</label>
                                <textarea class="form-control" id="directoryReportDescription" name="Report.Description" rows="3" minlength="5" maxlength="1000" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-outline-secondary btn-sm">@Localizer["Public.Submit.report"]</button>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    }
}

@section Scripts {
    <script src="~/assets/js/directory-detail.js" asp-append-version="true"></script>
    <script src="~/assets/js/reviews.js" asp-append-version="true"></script>
}
