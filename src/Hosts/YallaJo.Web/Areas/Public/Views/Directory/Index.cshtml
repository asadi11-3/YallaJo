@model YallaJo.Web.Areas.Public.Models.Directory.DirectoryVm
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Public.Explore.the.Directory"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isAuthed = User.Identity?.IsAuthenticated == true;
    var firstResult = Model.TotalCount == 0 ? 0 : ((Model.PageNumber - 1) * Model.PageSize) + 1;
    var lastResult = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount);
}

@functions {
    static string TypeIcon(string? type) => (type ?? string.Empty).ToLowerInvariant() switch
    {
        "restaurant" => "bi-egg-fried",
        "hotel" => "bi-building",
        "shop" => "bi-bag",
        "agency" => "bi-briefcase",
        "transport" => "bi-bus-front",
        "guide" => "bi-person-badge",
        "activity" => "bi-compass",
        _ => "bi-shop"
    };
}

@Html.AntiForgeryToken()

<!-- Banner -->
@* Inline style justified (UI-PERF-X6): background-image URL is resolved at runtime via Url.Content *@
<section class="position-relative py-6 py-lg-7" style="background-image:url('@Url.Content("~/assets/images/bg/20.jpg")'); background-position:center; background-size:cover;">
    <div class="bg-overlay bg-dark opacity-7"></div>
    <div class="container position-relative">
        <div class="row">
            <div class="col-xl-9 mx-auto text-center">
                <h6 class="text-white fw-normal mb-3">@Localizer["Public.Discover.amp.connect.with.great.places"]</h6>
                <h1 class="display-5 text-white mb-4">@Localizer["Public.Explore.the.Directory"]</h1>
                <form class="row g-2 justify-content-center" asp-area="Public" asp-controller="Directory" asp-action="Index" method="get">
                    <div class="col-lg-5">
                        <input class="form-control form-control-lg" type="text" name="q" value="@Model.Query" placeholder="@Localizer["Public.What.are.you.looking.for"]" />
                    </div>
                    <div class="col-lg-3">
                        <select class="form-select form-select-lg" name="businessType">
                            <option value="">@Localizer["Public.All.categories"]</option>
                            @foreach (var t in Model.BusinessTypes)
                            {
                                if (string.Equals(t.Value, Model.SelectedBusinessType, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@t.Value" selected>@t.Label</option>
                                }
                                else
                                {
                                    <option value="@t.Value">@t.Label</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-lg-2">
                        <input class="form-control form-control-lg" type="text" name="city" value="@Model.City" placeholder="@Localizer["Public.City"]" />
                    </div>
                    <div class="col-lg-2 d-grid">
                        <button class="btn btn-lg btn-primary mb-0" type="submit">@Localizer["Public.Search"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- Category quick filters -->
<section class="pt-4 pb-0">
    <div class="container">
        <div class="d-flex flex-wrap gap-2 justify-content-center">
            <a asp-area="Public" asp-controller="Directory" asp-action="Index" asp-route-q="@Model.Query" asp-route-city="@Model.City"
               class="btn btn-sm @(string.IsNullOrEmpty(Model.SelectedBusinessType) ? "btn-primary" : "btn-primary-soft")">@Localizer["Public.All"]</a>
            @foreach (var t in Model.BusinessTypes)
            {
                var active = string.Equals(t.Value, Model.SelectedBusinessType, StringComparison.OrdinalIgnoreCase);
                <a asp-area="Public" asp-controller="Directory" asp-action="Index" asp-route-q="@Model.Query" asp-route-city="@Model.City" asp-route-businessType="@t.Value"
                   class="btn btn-sm @(active ? "btn-primary" : "btn-primary-soft")">
                    <i class="bi @TypeIcon(t.Value) me-1"></i>@t.Label
                </a>
            }
        </div>
    </div>
</section>

<!-- Listing -->
<section class="pt-4">
    <div class="container">
        <div class="d-sm-flex justify-content-between align-items-center mb-4">
            <h5 class="mb-2 mb-sm-0">
                @if (Model.HasResults)
                {
                    <text>@Localizer["Public.ShowingPlaces", firstResult, lastResult, Model.TotalCount]</text>
                }
                else
                {
                    <text>@Localizer["Public.No.places.found"]</text>
                }
            </h5>
        </div>

        @if (!Model.HasResults)
        {
            <div class="text-center py-5">
                <img src="@Url.Content("~/assets/images/element/17.svg")" class="h-100px mb-3" alt="@Localizer["Public.No.results"]" />
                <h5 class="mb-1">@Localizer["Public.Nothing.matched.your.search"]</h5>
                <p class="mb-0">@Localizer["Public.Try.a.different.category.city.or.search.term"]</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var biz in Model.Businesses)
                {
                    @* Shared card partial (Phase 3.3 consistency: card-hover-shadow + col-md-6 col-xl-4 grid) *@
                    <partial name="_BusinessCard"
                             model="biz"
                             view-data='@(new ViewDataDictionary(ViewData) { { "isAuthed", isAuthed }, { "colClass", "col-md-6 col-xl-4" } })' />
                }
            </div>

            @* Pagination (shared partial preserves query string, swaps page) *@
            <partial name="_Pagination"
                     model='new YallaJo.Web.Areas.Public.Models.Shared.PaginationVm { PageNumber = Model.PageNumber, TotalPages = Model.TotalPages, AriaLabel = Localizer["Public.Directory.pages"] }' />
        }
    </div>
</section>

@section Scripts {
    <script src="~/assets/js/directory-index.js" asp-append-version="true"></script>
}
