@using YallaJo.Web.Areas.Admin.Modules.ContentPlaces.Features.Places.ViewModels
@model CreatePlaceVm
@{
    ViewData["Title"] = "Create Place";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Create Place</h2>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <form asp-area="Admin" asp-controller="Places" asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        @* Strongly typed against the shared abstract PlaceFormVm. *@
        <partial name="_Form" model="(PlaceFormVm)Model" />

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
