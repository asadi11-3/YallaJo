@model YallaJo.Web.Areas.Admin.Models.Home.DashboardVm
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Dashboard"];
    ViewData["AdminNav"] = "Dashboard";

    // Culture-aware numbers/currency (CON3): never string-concatenate. JOD uses
    // 3 decimals (fils); counts use the integer "N0" pattern under the request
    // culture's IFormatProvider so AR renders Arabic-Indic numerals when configured.
    var culture = System.Globalization.CultureInfo.CurrentCulture;

    var revenueValue = Model.TotalRevenue > 0 ? Model.TotalRevenue : Model.Revenue;
    var bookingsValue = Model.TotalBookings > 0 ? Model.TotalBookings : Model.Bookings;
    var usersValue = Model.TotalUsers > 0 ? Model.TotalUsers : Model.Users;

    string Count(int n) => n.ToString("N0", culture);
    // Revenue shown as a whole figure (fils omitted on the KPI tile for scan-ability).
    string Amount(decimal d) => d.ToString("N0", culture);

    var hasAlerts = Model.Alerts > 0;
}

@*
    KPI status text (A11Y5): each tile carries colour + icon + TEXT, never colour
    alone. The Alerts tile especially states its condition in words.
*@

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">@Localizer["Admin.Dashboard"]</h1>
</div>

<!-- KPI tiles -->
<div class="row g-4 mb-4">
    <div class="col-md-6 col-xxl-3">
        <div class="card card-body shadow p-4 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h6 fw-light mb-1">@Localizer["Admin.Revenue"]</h2>
                    <p class="font-data h3 mb-1"><bdi>@Amount(revenueValue)</bdi></p>
                    <span class="badge bg-success bg-opacity-10 text-success">@Localizer["Admin.Kpi.Total"]</span>
                </div>
                <div class="icon-lg rounded-circle bg-success bg-opacity-10 text-success">
                    <i class="fa-solid fa-sack-dollar fa-fw" aria-hidden="true"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xxl-3">
        <div class="card card-body shadow p-4 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h6 fw-light mb-1">@Localizer["Admin.Bookings"]</h2>
                    <p class="font-data h3 mb-1"><bdi>@Count(bookingsValue)</bdi></p>
                    <span class="badge bg-primary bg-opacity-10 text-primary">@Localizer["Admin.Kpi.Total"]</span>
                </div>
                <div class="icon-lg rounded-circle bg-primary bg-opacity-10 text-primary">
                    <i class="fa-solid fa-ticket fa-fw" aria-hidden="true"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xxl-3">
        <div class="card card-body shadow p-4 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h6 fw-light mb-1">@Localizer["Admin.Users"]</h2>
                    <p class="font-data h3 mb-1"><bdi>@Count(usersValue)</bdi></p>
                    <span class="badge bg-info bg-opacity-10 text-info">@Localizer["Admin.Kpi.Total"]</span>
                </div>
                <div class="icon-lg rounded-circle bg-info bg-opacity-10 text-info">
                    <i class="fa-solid fa-users fa-fw" aria-hidden="true"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xxl-3">
        <div class="card card-body shadow p-4 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h6 fw-light mb-1">@Localizer["Admin.Alerts"]</h2>
                    <p class="font-data h3 mb-1"><bdi>@Count(Model.Alerts)</bdi></p>
                    @if (hasAlerts)
                    {
                        <span class="badge bg-warning bg-opacity-10 text-warning">
                            <i class="fa-solid fa-triangle-exclamation fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Kpi.NeedsAttention"]
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success bg-opacity-10 text-success">
                            <i class="fa-solid fa-circle-check fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Kpi.AllClear"]
                        </span>
                    }
                </div>
                <div class="icon-lg rounded-circle @(hasAlerts ? "bg-warning text-warning" : "bg-success text-success") bg-opacity-10">
                    <i class="fa-solid @(hasAlerts ? "fa-triangle-exclamation" : "fa-circle-check") fa-fw" aria-hidden="true"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts -->
<div class="row g-4 mb-4">
    <div class="col-xxl-8">
        <div class="card shadow h-100">
            <div class="card-header border-bottom">
                <h2 class="card-header-title h5 mb-0">@Localizer["Admin.RevenueTrend"]</h2>
            </div>
            <div class="card-body">
                @if (Model.HasRevenueSeries)
                {
                    <div id="ChartRevenue" role="img" aria-label="@Localizer["Admin.RevenueTrend"]"></div>
                }
                else
                {
                    <div class="text-center py-5">
                        <img src="~/assets/images/element/17.svg" alt="" width="80" height="80" class="h-80px mb-3" aria-hidden="true" />
                        <p class="mb-3 text-secondary">@Localizer["Admin.Empty.Revenue"]</p>
                        <a class="btn btn-sm btn-primary-soft" asp-area="Admin" asp-controller="Bookings" asp-action="Index">@Localizer["Admin.Empty.ViewBookings"]</a>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-xxl-4">
        <div class="card shadow h-100">
            <div class="card-header border-bottom">
                <h2 class="card-header-title h5 mb-0">@Localizer["Admin.BookingsBreakdown"]</h2>
            </div>
            <div class="card-body">
                @if (Model.TotalBookings > 0)
                {
                    <div id="ChartBookings" role="img" aria-label="@Localizer["Admin.BookingsBreakdown"]"></div>
                }
                else
                {
                    <div class="text-center py-5">
                        <img src="~/assets/images/element/17.svg" alt="" width="80" height="80" class="h-80px mb-3" aria-hidden="true" />
                        <p class="mb-3 text-secondary">@Localizer["Admin.Empty.Bookings"]</p>
                        <a class="btn btn-sm btn-primary-soft" asp-area="Admin" asp-controller="Bookings" asp-action="Index">@Localizer["Admin.Empty.ViewBookings"]</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-xxl-6">
        <div class="card shadow h-100">
            <div class="card-header border-bottom">
                <h2 class="card-header-title h5 mb-0">@Localizer["Admin.Users"]</h2>
            </div>
            <div class="card-body">
                @if (Model.TotalUsers > 0)
                {
                    <div id="ChartUsers" role="img" aria-label="@Localizer["Admin.Users"]"></div>
                }
                else
                {
                    <div class="text-center py-5">
                        <img src="~/assets/images/element/17.svg" alt="" width="80" height="80" class="h-80px mb-3" aria-hidden="true" />
                        <p class="mb-3 text-secondary">@Localizer["Admin.Empty.Users"]</p>
                        <a class="btn btn-sm btn-primary-soft" asp-area="Admin" asp-controller="Users" asp-action="Index">@Localizer["Admin.Empty.ViewUsers"]</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent interactions -->
    <div class="col-xxl-6">
        <div class="card shadow h-100">
            <div class="card-header border-bottom">
                <h2 class="card-header-title h5 mb-0">@Localizer["Admin.RecentActivity"]</h2>
            </div>
            <div class="card-body">
                @if (Model.HasInteractions)
                {
                    <ul class="list-group list-group-borderless">
                        @foreach (var i in Model.RecentInteractions)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div>
                                    <span class="fw-semibold">@i.InteractionType</span>
                                    <span class="text-secondary small ms-1">@i.EntityType</span>
                                </div>
                                <span class="font-data small text-secondary">
                                    <bdi>@i.OccurredAt.ToString("g", culture)</bdi>
                                </span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-center py-5">
                        <img src="~/assets/images/element/17.svg" alt="" width="80" height="80" class="h-80px mb-3" aria-hidden="true" />
                        <p class="mb-0 text-secondary">@Localizer["Admin.Empty.Activity"]</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@*
    CSP-safe server→client data hand-off (A6/SEC1/J3/JS5): a NON-executable JSON
    data island, read by wwwroot/assets/js/admin-dashboard.js via the
    data-yj-component root below. No inline executable <script>, no nonce needed.
    Chart labels are localized server-side here so the JS never hard-codes copy
    (CON1).
*@
<script type="application/json" data-yj-component="admin-dashboard">
    {
        "revenue": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueSeries.Select(p => new { x = p.Date, y = p.Revenue }))),
        "bookings": [@Model.CompletedBookings, @Model.CancelledBookings, @Model.OtherBookings],
        "users": [@Model.TotalUsers, @Model.NewUsers],
        "labels": {
            "revenue": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Admin.Revenue"].Value)),
            "users": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Admin.Users"].Value)),
            "completed": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Admin.Bookings.Completed"].Value)),
            "cancelled": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Admin.Bookings.Cancelled"].Value)),
            "other": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Admin.Bookings.Other"].Value)),
            "totalUsers": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Admin.Users.Total"].Value)),
            "newUsers": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Admin.Users.New"].Value))
        }
    }
</script>

@section Scripts {
    <script src="~/assets/js/admin-dashboard.js" asp-append-version="true" defer></script>
}
