@using Microsoft.Extensions.Localization
@model YallaJo.Web.Areas.Admin.Models.Specializations.UpdateSpecializationVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Specializations.EditTitle"].Value;
    ViewData["AdminNav"] = "Specializations";
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Specializations.EditHeading"]</h1>
        <p class="mb-0 text-secondary fw-semibold">@Model.Name</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left fa-fw" aria-hidden="true"></i> @Localizer["Admin.Specializations.Back"]
    </a>
</div>

<div class="card shadow">
    <div class="card-header border-bottom">
        <h2 class="card-header-title h5 mb-0">@Localizer["Admin.Specializations.EditHeading"]</h2>
    </div>
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Specializations" asp-action="Edit" asp-route-id="@Model.Id" method="post" class="col-lg-6">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label">@Localizer["Admin.Specializations.NameLabel"]</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger" role="alert"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">@Localizer["Admin.Specializations.DescriptionLabel"]</label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger" role="alert"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Icon" class="form-label">@Localizer["Admin.Specializations.IconLabel"]</label>
                <input asp-for="Icon" class="form-control" dir="ltr" aria-describedby="edit-icon-help" />
                <small id="edit-icon-help" class="form-text">@Localizer["Admin.Specializations.IconHelp"]</small>
                <span asp-validation-for="Icon" class="text-danger" role="alert"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">@Localizer["Admin.Specializations.ActiveLabel"]</label>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk fa-fw" aria-hidden="true"></i> @Localizer["Admin.Specializations.Save"]
            </button>
            <a asp-action="Index" class="btn btn-link">@Localizer["Admin.Specializations.Cancel"]</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
