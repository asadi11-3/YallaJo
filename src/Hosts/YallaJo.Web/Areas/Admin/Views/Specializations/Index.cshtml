@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.Shared
@using YallaJo.Web.Infrastructure.Authorization
@model YallaJo.Web.Areas.Admin.Models.Specializations.SpecializationListVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Specializations.Title"].Value;
    ViewData["AdminNav"] = "Specializations";
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Specializations.Title"]</h1>
        <p class="mb-0 text-secondary">@Localizer["Admin.Specializations.Subtitle"]</p>
    </div>
</div>

@if (ViewBag.Error is string vbe)
{
    <div class="alert alert-danger" role="alert">@vbe</div>
}

<permission require="@WebPermission.Specialization.Create">
    <div class="card shadow mb-4">
        <div class="card-header border-bottom">
            <h2 class="card-header-title h5 mb-0">@Localizer["Admin.Specializations.CreateHeading"]</h2>
        </div>
        <div class="card-body">
            <form data-loading asp-area="Admin" asp-controller="Specializations" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Create.Name" class="form-label">@Localizer["Admin.Specializations.NameLabel"]</label>
                        <input asp-for="Create.Name" class="form-control" />
                        <span asp-validation-for="Create.Name" class="text-danger" role="alert"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Create.Description" class="form-label">@Localizer["Admin.Specializations.DescriptionLabel"]</label>
                        <input asp-for="Create.Description" class="form-control" />
                        <span asp-validation-for="Create.Description" class="text-danger" role="alert"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Create.Icon" class="form-label">@Localizer["Admin.Specializations.IconLabel"]</label>
                        <input asp-for="Create.Icon" class="form-control" dir="ltr" aria-describedby="icon-help" />
                        <small id="icon-help" class="form-text">@Localizer["Admin.Specializations.IconHelp"]</small>
                        <span asp-validation-for="Create.Icon" class="text-danger" role="alert"></span>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-plus fa-fw" aria-hidden="true"></i> @Localizer["Admin.Specializations.CreateSubmit"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</permission>

<section class="card shadow" aria-labelledby="specializations-heading">
    <div class="card-header border-bottom">
        <h2 id="specializations-heading" class="card-header-title h5 mb-0">@Localizer["Admin.Specializations.Directory"]</h2>
    </div>
    <div class="card-body">
        @if (Model.Specializations.Count == 0)
        {
            <div class="text-center py-5">
                <img src="~/assets/images/element/17.svg" loading="lazy" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
                <p class="mb-3 text-secondary">@Localizer["Admin.Specializations.EmptyMessage"]</p>
                <permission require="@WebPermission.Specialization.Create">
                    <a href="#Create_Name" class="btn btn-sm btn-primary">
                        <i class="fa-solid fa-plus fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Specializations.EmptyCta"]
                    </a>
                </permission>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">@Localizer["Admin.Specializations.ColName"]</th>
                            <th scope="col">@Localizer["Admin.Specializations.ColDescription"]</th>
                            <th scope="col">@Localizer["Admin.Specializations.ColIcon"]</th>
                            <th scope="col">@Localizer["Admin.Specializations.ColStatus"]</th>
                            <th scope="col" class="text-end">@Localizer["Admin.Specializations.ColActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Specializations)
                        {
                            <tr>
                                <td class="fw-semibold">@s.Name</td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(s.Description))
                                    {
                                        <span class="text-secondary" aria-label="@Localizer["Admin.Specializations.NoDescription"]">&mdash;</span>
                                    }
                                    else
                                    {
                                        @s.Description
                                    }
                                </td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(s.Icon))
                                    {
                                        <span class="text-secondary" aria-label="@Localizer["Admin.Specializations.NoIcon"]">&mdash;</span>
                                    }
                                    else
                                    {
                                        <bdi dir="ltr" class="font-data text-secondary">@s.Icon</bdi>
                                    }
                                </td>
                                <td>
                                    @if (s.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success"><i class="fa-solid fa-circle-check fa-fw" aria-hidden="true"></i> @Localizer["Admin.Specializations.Active"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary"><i class="fa-solid fa-circle-minus fa-fw" aria-hidden="true"></i> @Localizer["Admin.Specializations.Inactive"]</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <permission require="@WebPermission.Specialization.Update">
                                        <a asp-area="Admin" asp-controller="Specializations" asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary"
                                           data-yj-modal-target="#editSpecializationModal"
                                           data-action="@Url.Action("Edit", new { area = "Admin", id = s.Id })"
                                           data-field-id="@s.Id"
                                           data-field-name="@s.Name"
                                           data-field-description="@s.Description"
                                           data-field-icon="@s.Icon"
                                           data-field-is-active="@s.IsActive">
                                            <i class="fa-solid fa-pen fa-fw" aria-hidden="true"></i> @Localizer["Admin.Specializations.Edit"]
                                        </a>
                                    </permission>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

<permission require="@WebPermission.Specialization.Update">
    @{ var editOpen = Model.EditId is not null; }
    @* Edit modal (F8 §4.7): JS opens it via admin-modal-crud.js; deep links / no-JS
       render it server-side open (PE1) with anchor-based close controls. *@
    <div class="modal fade@(editOpen ? " show d-block" : "")" id="editSpecializationModal" tabindex="-1"
         role="dialog" aria-modal="true" aria-labelledby="editSpecializationModalLabel"
         data-yj-component="modal-crud">
        <div class="modal-dialog modal-dialog-centered">
            <form data-loading asp-area="Admin" asp-controller="Specializations" asp-action="Edit"
                  asp-route-id="@Model.Edit.Id" method="post" class="modal-content">
                @Html.AntiForgeryToken()
                <partial name="Partials/_ModalHeader"
                         model="@(new ModalHeaderVm { TitleId = "editSpecializationModalLabel", Title = Localizer["Admin.Specializations.EditHeading"].Value, CloseLabel = Localizer["Admin.Specializations.Cancel"].Value, CloseUrl = editOpen ? Url.Action("Index") : null })" />
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    <input type="hidden" asp-for="Edit.Id" data-yj-field="id" />
                    <div class="mb-3">
                        <label asp-for="Edit.Name" class="form-label">@Localizer["Admin.Specializations.NameLabel"]</label>
                        <input asp-for="Edit.Name" class="form-control" data-yj-field="name" />
                        <span asp-validation-for="Edit.Name" class="text-danger" role="alert"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Edit.Description" class="form-label">@Localizer["Admin.Specializations.DescriptionLabel"]</label>
                        <input asp-for="Edit.Description" class="form-control" data-yj-field="description" />
                        <span asp-validation-for="Edit.Description" class="text-danger" role="alert"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Edit.Icon" class="form-label">@Localizer["Admin.Specializations.IconLabel"]</label>
                        <input asp-for="Edit.Icon" class="form-control" dir="ltr" aria-describedby="edit-icon-help" data-yj-field="icon" />
                        <small id="edit-icon-help" class="form-text">@Localizer["Admin.Specializations.IconHelp"]</small>
                        <span asp-validation-for="Edit.Icon" class="text-danger" role="alert"></span>
                    </div>
                    <div class="form-check mb-0">
                        <input asp-for="Edit.IsActive" class="form-check-input" data-yj-field="isActive" />
                        <label asp-for="Edit.IsActive" class="form-check-label">@Localizer["Admin.Specializations.ActiveLabel"]</label>
                    </div>
                </div>
                <div class="modal-footer">
                    @if (editOpen)
                    {
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">@Localizer["Admin.Specializations.Cancel"]</a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.Specializations.Cancel"]</button>
                    }
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk fa-fw" aria-hidden="true"></i> @Localizer["Admin.Specializations.Save"]
                    </button>
                </div>
            </form>
        </div>
    </div>
    @if (editOpen)
    {
        <div class="modal-backdrop fade show"></div>
    }
</permission>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/admin-modal-crud.js" asp-append-version="true"></script>
}
