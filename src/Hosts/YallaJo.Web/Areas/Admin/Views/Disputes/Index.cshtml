@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.Disputes
@using YallaJo.Web.Infrastructure.Authorization
@model DisputesVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Disputes.Title"].Value;
    ViewData["AdminNav"] = "Disputes";

    var culture = CultureInfo.CurrentCulture;
    string Date(DateTime dt) => dt.ToString("yyyy-MM-dd HH:mm", culture);

    var statuses = new[] { "Open", "UnderReview", "Resolved", "Escalated", "Closed" };
    var resolutions = new[] { "RefundFull", "RefundPartial", "NoRefund", "Compromise" };
    var hasFilter = !string.IsNullOrWhiteSpace(Model.StatusFilter);
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Disputes.Title"]</h1>
        <p class="text-secondary mb-0">@Localizer["Admin.Disputes.Subtitle"]</p>
    </div>
</div>

<form method="get" asp-area="Admin" asp-controller="Disputes" asp-action="Index" class="card card-body shadow mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-sm-4">
            <label class="form-label small fw-semibold" for="status">@Localizer["Admin.Disputes.StatusLabel"]</label>
            <select class="form-select" id="status" name="status" aria-describedby="status-help">
                <option value="">@Localizer["Admin.Disputes.AllStatuses"]</option>
                @foreach (var s in statuses)
                {
                    <option value="@s" selected="@(string.Equals(Model.StatusFilter, s, StringComparison.OrdinalIgnoreCase))">@Localizer["Admin.Disputes.Status." + s]</option>
                }
            </select>
            <small id="status-help" class="form-text">@Localizer["Admin.Disputes.StatusHelp"]</small>
        </div>
        <div class="col-sm-auto">
            <button type="submit" class="btn btn-primary">@Localizer["Admin.Disputes.Apply"]</button>
            <a asp-area="Admin" asp-controller="Disputes" asp-action="Index" class="btn btn-outline-secondary">@Localizer["Admin.Disputes.Reset"]</a>
        </div>
    </div>
</form>

<section class="card shadow" aria-labelledby="disputes-heading">
    <div class="card-header border-bottom">
        <h2 id="disputes-heading" class="card-header-title h5 mb-0">@Localizer["Admin.Disputes.Directory"]</h2>
    </div>

    @if (Model.Disputes.Count == 0)
    {
        <div class="card-body">
            <div class="text-center py-5">
                <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
                <p class="mb-3 text-secondary">@Localizer["Admin.Disputes.EmptyMessage"]</p>
                @if (hasFilter)
                {
                    <a asp-area="Admin" asp-controller="Disputes" asp-action="Index" class="btn btn-sm btn-primary-soft">@Localizer["Admin.Disputes.ClearFilter"]</a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["Admin.Disputes.ColReason"]</th>
                        <th scope="col">@Localizer["Admin.Disputes.ColStatus"]</th>
                        <th scope="col">@Localizer["Admin.Disputes.ColResolution"]</th>
                        <th scope="col">@Localizer["Admin.Disputes.ColCreated"]</th>
                        <th scope="col" class="text-end">@Localizer["Admin.Disputes.ColActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Disputes)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@d.Reason</div>
                                @if (!string.IsNullOrWhiteSpace(d.Description))
                                {
                                    <div class="small text-secondary text-truncate mw-280">@d.Description</div>
                                }
                            </td>
                            <td>
                                <span class="badge bg-@DisputesMapper.StatusColor(d.Status) bg-opacity-10 text-@DisputesMapper.StatusColor(d.Status)">
                                    <i class="fa-solid fa-@DisputesMapper.StatusIcon(d.Status) fa-fw" aria-hidden="true"></i>
                                    @Localizer["Admin.Disputes.Status." + d.Status]
                                </span>
                            </td>
                            <td>
                                @if (d.Resolution is not null)
                                {
                                    <div>@Localizer["Admin.Disputes.Resolution." + d.Resolution]</div>
                                    @if (!string.IsNullOrWhiteSpace(d.ResolutionNotes))
                                    {
                                        <div class="small text-secondary text-truncate mw-220">@d.ResolutionNotes</div>
                                    }
                                }
                                else
                                {
                                    <span class="text-secondary" aria-label="@Localizer["Admin.Disputes.NoResolution"]">&mdash;</span>
                                }
                            </td>
                            <td><bdi dir="ltr" class="font-data">@Date(d.CreatedAt)</bdi></td>
                            <td class="text-end">
                                @if (d.CanReview)
                                {
                                    <permission require="@WebPermission.AdminFinanceDashboard.Update">
                                        <form method="post" asp-area="Admin" asp-controller="Disputes" asp-action="Review" asp-route-id="@d.Id" class="d-inline"
                                              data-confirm="@Localizer["Admin.Disputes.ReviewConfirm"]"
                                              data-confirm-title="@Localizer["Admin.Disputes.ReviewTitle"]"
                                              data-confirm-action="@Localizer["Admin.Disputes.Review"]">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-info">
                                                <i class="fa-solid fa-magnifying-glass fa-fw" aria-hidden="true"></i> @Localizer["Admin.Disputes.Review"]
                                            </button>
                                        </form>
                                    </permission>
                                }
                                @if (d.CanEscalate)
                                {
                                    <permission require="@WebPermission.AdminFinanceDashboard.Update">
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#escalateModal-@d.Id.ToString("N")">
                                            <i class="fa-solid fa-triangle-exclamation fa-fw" aria-hidden="true"></i> @Localizer["Admin.Disputes.Escalate"]
                                        </button>
                                    </permission>
                                }
                                @if (d.CanResolve)
                                {
                                    <permission require="@WebPermission.AdminFinanceDashboard.Approve">
                                        <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#resolveModal-@d.Id.ToString("N")">
                                            <i class="fa-solid fa-circle-check fa-fw" aria-hidden="true"></i> @Localizer["Admin.Disputes.Resolve"]
                                        </button>
                                    </permission>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@foreach (var d in Model.Disputes)
{
    var nid = d.Id.ToString("N");

    @if (d.CanResolve)
    {
        <permission require="@WebPermission.AdminFinanceDashboard.Approve">
            <div class="modal fade" id="resolveModal-@nid" tabindex="-1" aria-labelledby="resolveTitle-@nid" aria-describedby="resolveBody-@nid" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                <div class="modal-dialog modal-dialog-centered">
                    <form method="post" asp-area="Admin" asp-controller="Disputes" asp-action="Resolve" asp-route-id="@d.Id" class="modal-content" role="dialog" aria-modal="true" aria-labelledby="resolveTitle-@nid">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h2 class="modal-title h5" id="resolveTitle-@nid">@Localizer["Admin.Disputes.ResolveModalTitle"]</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Admin.Disputes.Close"]"></button>
                        </div>
                        <div class="modal-body" id="resolveBody-@nid">
                            <p class="small text-secondary">@d.Reason</p>
                            <div class="mb-3">
                                <label class="form-label" for="resolution-@nid">@Localizer["Admin.Disputes.ResolutionLabel"]</label>
                                <select class="form-select" id="resolution-@nid" name="resolution" required aria-describedby="resolution-help-@nid">
                                    @foreach (var r in resolutions)
                                    {
                                        <option value="@r">@Localizer["Admin.Disputes.Resolution." + r]</option>
                                    }
                                </select>
                                <small id="resolution-help-@nid" class="form-text">@Localizer["Admin.Disputes.ResolutionHelp"]</small>
                            </div>
                            <div class="mb-2">
                                <label class="form-label" for="notes-@nid">@Localizer["Admin.Disputes.NotesLabel"]</label>
                                <textarea class="form-control" id="notes-@nid" name="notes" rows="3" maxlength="1000" aria-describedby="notes-help-@nid"></textarea>
                                <small id="notes-help-@nid" class="form-text">@Localizer["Admin.Disputes.NotesHelp"]</small>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.Disputes.Cancel"]</button>
                            <button type="submit" class="btn btn-success">@Localizer["Admin.Disputes.ResolveSubmit"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </permission>
    }
    @if (d.CanEscalate)
    {
        <permission require="@WebPermission.AdminFinanceDashboard.Update">
            <div class="modal fade" id="escalateModal-@nid" tabindex="-1" aria-labelledby="escalateTitle-@nid" aria-describedby="escalateBody-@nid" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                <div class="modal-dialog modal-dialog-centered">
                    <form method="post" asp-area="Admin" asp-controller="Disputes" asp-action="Escalate" asp-route-id="@d.Id" class="modal-content" role="dialog" aria-modal="true" aria-labelledby="escalateTitle-@nid">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h2 class="modal-title h5" id="escalateTitle-@nid">@Localizer["Admin.Disputes.EscalateModalTitle"]</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Admin.Disputes.Close"]"></button>
                        </div>
                        <div class="modal-body" id="escalateBody-@nid">
                            <p class="small text-secondary">@d.Reason</p>
                            <label class="form-label" for="reason-@nid">@Localizer["Admin.Disputes.ReasonLabel"]</label>
                            <textarea class="form-control" id="reason-@nid" name="reason" rows="3" maxlength="1000" required aria-describedby="reason-help-@nid"></textarea>
                            <small id="reason-help-@nid" class="form-text">@Localizer["Admin.Disputes.ReasonHelp"]</small>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.Disputes.Cancel"]</button>
                            <button type="submit" class="btn btn-danger">@Localizer["Admin.Disputes.EscalateSubmit"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </permission>
    }
}
