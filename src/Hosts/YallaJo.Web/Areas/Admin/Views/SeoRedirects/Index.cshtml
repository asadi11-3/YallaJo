@using YallaJo.Web.Areas.Admin.Models.SeoRedirects
@using YallaJo.Web.Infrastructure.Authorization
@model RedirectsVm
@{
    ViewData["Title"] = "SEO Redirects";
    ViewData["AdminNav"] = "SeoRedirects";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">SEO Redirects</h1>
        <p class="text-muted mb-0">Manage URL redirects (301/302/307/308) for moved or retired pages.</p>
    </div>
    <permission require="@WebPermission.Redirect.Create">
        <button type="button" class="btn btn-primary-soft" data-bs-toggle="modal" data-bs-target="#createRedirectModal">
            <i class="bi bi-plus-lg me-1"></i> Add redirect
        </button>
    </permission>
</div>

<div class="card shadow mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small mb-1">Old URL contains</label>
                <input type="text" name="OldUrl" value="@Model.OldUrlFilter" class="form-control form-control-sm" placeholder="/old-path" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Active</label>
                <select name="IsActive" class="form-select form-select-sm">
                    <option value="">All</option>
                    <option value="true" selected="@(Model.IsActiveFilter == true)">Active</option>
                    <option value="false" selected="@(Model.IsActiveFilter == false)">Inactive</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Status code</label>
                <input type="number" name="StatusCode" min="300" max="399" class="form-control form-control-sm" placeholder="301" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="bi bi-funnel me-1"></i> Apply
                </button>
            </div>
        </form>
    </div>
</div>

@if (!Model.HasRedirects)
{
    <div class="card card-body shadow text-center py-5">
        <img src="~/assets/images/element/17.svg" class="h-80px mb-3 mx-auto" alt="No redirects" />
        <h5 class="mb-1">No redirects found</h5>
        <p class="text-muted mb-0">Create a redirect to send visitors from an old URL to a new one.</p>
    </div>
}
else
{
    <div class="card shadow">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Old URL</th>
                        <th>New URL</th>
                        <th>Status</th>
                        <th>Active</th>
                        <th class="text-end">Hits</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Redirects)
                    {
                        var statusColor = RedirectsMapper.StatusBadge(r.StatusCode);
                        <tr>
                            <td class="text-break"><code>@r.OldUrl</code></td>
                            <td class="text-break"><code>@r.NewUrl</code></td>
                            <td><span class="badge bg-@statusColor bg-opacity-10 text-@statusColor">@r.StatusCode</span></td>
                            <td>
                                @if (r.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">@r.HitCount</td>
                            <td>@r.CreatedAt.ToString("g")</td>
                            <td class="text-end">
                                <permission require="@WebPermission.Redirect.Update">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editRedirect-@r.Id">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                </permission>
                                <permission require="@WebPermission.Redirect.Delete">
                                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this redirect?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger-soft">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </permission>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-OldUrl="@Model.OldUrlFilter" asp-route-IsActive="@Model.IsActiveFilter">Previous</a>
                </li>
                <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.TotalPages</span></li>
                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-OldUrl="@Model.OldUrlFilter" asp-route-IsActive="@Model.IsActiveFilter">Next</a>
                </li>
            </ul>
        </nav>
    }

    @* Per-row edit modals *@
    <permission require="@WebPermission.Redirect.Update">
        @foreach (var r in Model.Redirects)
        {
            <div class="modal fade" id="editRedirect-@r.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form asp-action="Update" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Id" value="@r.Id" />
                            <div class="modal-header">
                                <h5 class="modal-title">Edit redirect</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label">Old URL</label>
                                    <input type="text" class="form-control" value="@r.OldUrl" disabled />
                                    <div class="form-text">Old URL cannot be changed; delete and recreate to change it.</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">New URL</label>
                                    <input type="text" name="NewUrl" value="@r.NewUrl" class="form-control" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Status code</label>
                                    <select name="StatusCode" class="form-select">
                                        <option value="301" selected="@(r.StatusCode == 301)">301 – Permanent</option>
                                        <option value="302" selected="@(r.StatusCode == 302)">302 – Found</option>
                                        <option value="307" selected="@(r.StatusCode == 307)">307 – Temporary</option>
                                        <option value="308" selected="@(r.StatusCode == 308)">308 – Permanent</option>
                                    </select>
                                </div>
                                <div class="form-check">
                                    <input type="checkbox" name="IsActive" value="true" class="form-check-input" id="active-@r.Id" checked="@r.IsActive" />
                                    <label class="form-check-label" for="active-@r.Id">Active</label>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary-soft">Save changes</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </permission>
}

<permission require="@WebPermission.Redirect.Create">
    <div class="modal fade" id="createRedirectModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">Add redirect</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Old URL</label>
                            <input type="text" name="OldUrl" class="form-control" placeholder="/old-path" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">New URL</label>
                            <input type="text" name="NewUrl" class="form-control" placeholder="/new-path" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Status code</label>
                            <select name="StatusCode" class="form-select">
                                <option value="301" selected>301 – Permanent</option>
                                <option value="302">302 – Found</option>
                                <option value="307">307 – Temporary</option>
                                <option value="308">308 – Permanent</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary-soft">Create redirect</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</permission>
