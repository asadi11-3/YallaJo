@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.SeoRedirects
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Shared
@model RedirectsVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.SeoRedirects.Title"].Value;
    ViewData["AdminNav"] = "SeoRedirects";
    var culture = CultureInfo.CurrentCulture;
    string Count(long n) => n.ToString("N0", culture);
    string Date(DateTime dt) => dt.ToString("yyyy-MM-dd HH:mm", culture);
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.SeoRedirects.Title"]</h1>
        <p class="text-secondary mb-0">@Localizer["Admin.SeoRedirects.Subtitle"]</p>
    </div>
    <permission require="@WebPermission.Redirect.Create">
        <button type="button" class="btn btn-primary-soft" data-bs-toggle="modal" data-bs-target="#createRedirectModal">
            <i class="fa-solid fa-plus fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.SeoRedirects.Add"]
        </button>
    </permission>
</div>

@if (ViewBag.Error is string vbe)
{
    <div class="alert alert-danger" role="alert">@vbe</div>
}

<div class="card shadow mb-4">
    <div class="card-header border-bottom">
        <h2 class="card-header-title h5 mb-0">@Localizer["Admin.SeoRedirects.FiltersHeading"]</h2>
    </div>
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="r-old" class="form-label">@Localizer["Admin.SeoRedirects.OldUrlFilterLabel"]</label>
                <input id="r-old" type="text" name="OldUrl" value="@Model.OldUrlFilter" class="form-control" dir="ltr" placeholder="/old-path" />
            </div>
            <div class="col-md-3">
                <label for="r-active" class="form-label">@Localizer["Admin.SeoRedirects.ActiveLabel"]</label>
                <select id="r-active" name="IsActive" class="form-select">
                    <option value="">@Localizer["Admin.SeoRedirects.AllStatuses"]</option>
                    <option value="true" selected="@(Model.IsActiveFilter == true)">@Localizer["Admin.SeoRedirects.Active"]</option>
                    <option value="false" selected="@(Model.IsActiveFilter == false)">@Localizer["Admin.SeoRedirects.Inactive"]</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="r-status" class="form-label">@Localizer["Admin.SeoRedirects.StatusCodeLabel"]</label>
                <input id="r-status" type="number" name="StatusCode" min="300" max="399" class="form-control" dir="ltr" placeholder="301" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">@Localizer["Admin.SeoRedirects.Apply"]</button>
            </div>
        </form>
    </div>
</div>

@if (!Model.HasRedirects)
{
    <div class="card shadow">
        <partial name="Partials/_EmptyState"
                 model="@(new EmptyStateVm { Message = Localizer["Admin.SeoRedirects.EmptyMessage"].Value, ContainerClass = "card-body text-center py-5" })" />
    </div>
}
else
{
    <section class="card shadow" aria-labelledby="r-directory">
        <div class="card-header border-bottom">
            <h2 id="r-directory" class="card-header-title h5 mb-0">@Localizer["Admin.SeoRedirects.Directory"]</h2>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["Admin.SeoRedirects.ColOldUrl"]</th>
                        <th scope="col">@Localizer["Admin.SeoRedirects.ColNewUrl"]</th>
                        <th scope="col">@Localizer["Admin.SeoRedirects.ColStatus"]</th>
                        <th scope="col">@Localizer["Admin.SeoRedirects.ColActive"]</th>
                        <th scope="col" class="text-end">@Localizer["Admin.SeoRedirects.ColHits"]</th>
                        <th scope="col">@Localizer["Admin.SeoRedirects.ColCreated"]</th>
                        <th scope="col" class="text-end">@Localizer["Admin.SeoRedirects.ColActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Redirects)
                    {
                        var statusColor = RedirectsMapper.StatusBadge(r.StatusCode);
                        <tr>
                            <td class="text-break"><bdi dir="ltr" class="font-data">@r.OldUrl</bdi></td>
                            <td class="text-break"><bdi dir="ltr" class="font-data">@r.NewUrl</bdi></td>
                            <td><span class="badge bg-@statusColor bg-opacity-10 text-@statusColor"><bdi dir="ltr">@r.StatusCode</bdi></span></td>
                            <td>
                                @if (r.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success"><i class="fa-solid fa-circle-check fa-fw" aria-hidden="true"></i> @Localizer["Admin.SeoRedirects.Active"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary"><i class="fa-solid fa-circle-minus fa-fw" aria-hidden="true"></i> @Localizer["Admin.SeoRedirects.Inactive"]</span>
                                }
                            </td>
                            <td class="text-end"><bdi dir="ltr" class="font-data">@Count(r.HitCount)</bdi></td>
                            <td><bdi dir="ltr" class="font-data">@Date(r.CreatedAt)</bdi></td>
                            <td class="text-end">
                                <permission require="@WebPermission.Redirect.Update">
                                    <button type="button" class="btn btn-sm btn-outline-secondary tap-target" data-bs-toggle="modal" data-bs-target="#editRedirect-@r.Id.ToString("N")" aria-label="@Localizer["Admin.SeoRedirects.Edit"]">
                                        <i class="fa-solid fa-pen fa-fw" aria-hidden="true"></i>
                                    </button>
                                </permission>
                                <permission require="@WebPermission.Redirect.Delete">
                                    <form data-loading asp-action="Delete" method="post" class="d-inline"
                                          data-confirm="@Localizer["Admin.SeoRedirects.DeleteConfirm"]" data-confirm-title="@Localizer["Admin.SeoRedirects.DeleteTitle"]" data-confirm-action="@Localizer["Admin.SeoRedirects.Delete"]" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger-soft tap-target" aria-label="@Localizer["Admin.SeoRedirects.Delete"]">
                                            <i class="fa-solid fa-trash fa-fw" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </permission>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.HasPrevious || Model.HasNext)
        {
            <partial name="Partials/_PaginationFooter"
                     model="@(new PaginationFooterVm
                     {
                         HasPrevious = Model.HasPrevious,
                         HasNext = Model.HasNext,
                         Page = Model.Page,
                         PreviousUrl = Url.Action("Index", new { page = Model.Page - 1, OldUrl = Model.OldUrlFilter, IsActive = Model.IsActiveFilter }),
                         NextUrl = Url.Action("Index", new { page = Model.Page + 1, OldUrl = Model.OldUrlFilter, IsActive = Model.IsActiveFilter }),
                         PreviousText = Localizer["Admin.SeoRedirects.Previous"].Value,
                         NextText = Localizer["Admin.SeoRedirects.Next"].Value,
                         PageLabel = Localizer["Admin.SeoRedirects.PageLabel"].Value
                     })" />
        }
    </section>

    <permission require="@WebPermission.Redirect.Update">
        @foreach (var r in Model.Redirects)
        {
            <div class="modal fade" id="editRedirect-@r.Id.ToString("N")" tabindex="-1" aria-labelledby="editRedirectTitle-@r.Id.ToString("N")" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                <div class="modal-dialog modal-dialog-centered">
                    <form data-loading asp-action="Update" method="post" class="modal-content" role="dialog" aria-modal="true" aria-labelledby="editRedirectTitle-@r.Id.ToString("N")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="@r.Id" />
                        <partial name="Partials/_ModalHeader"
                                 model="@(new ModalHeaderVm { TitleId = $"editRedirectTitle-{r.Id.ToString("N")}", Title = Localizer["Admin.SeoRedirects.EditTitle"].Value, CloseLabel = Localizer["Admin.SeoRedirects.Close"].Value })" />
                        <div class="modal-body">
                            <div class="mb-3">
                                <label for="er-old-@r.Id.ToString("N")" class="form-label">@Localizer["Admin.SeoRedirects.OldUrlLabel"]</label>
                                <input id="er-old-@r.Id.ToString("N")" type="text" class="form-control" dir="ltr" value="@r.OldUrl" disabled />
                                <div class="form-text">@Localizer["Admin.SeoRedirects.OldUrlHelp"]</div>
                            </div>
                            <div class="mb-3">
                                <label for="er-new-@r.Id.ToString("N")" class="form-label">@Localizer["Admin.SeoRedirects.NewUrlLabel"]</label>
                                <input id="er-new-@r.Id.ToString("N")" type="text" name="NewUrl" value="@r.NewUrl" class="form-control" dir="ltr" />
                            </div>
                            <div class="mb-3">
                                <label for="er-status-@r.Id.ToString("N")" class="form-label">@Localizer["Admin.SeoRedirects.StatusCodeLabel"]</label>
                                <select id="er-status-@r.Id.ToString("N")" name="StatusCode" class="form-select">
                                    <option value="301" selected="@(r.StatusCode == 301)">@Localizer["Admin.SeoRedirects.Status301"]</option>
                                    <option value="302" selected="@(r.StatusCode == 302)">@Localizer["Admin.SeoRedirects.Status302"]</option>
                                    <option value="307" selected="@(r.StatusCode == 307)">@Localizer["Admin.SeoRedirects.Status307"]</option>
                                    <option value="308" selected="@(r.StatusCode == 308)">@Localizer["Admin.SeoRedirects.Status308"]</option>
                                </select>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" name="IsActive" value="true" class="form-check-input" id="active-@r.Id.ToString("N")" checked="@r.IsActive" />
                                <label class="form-check-label" for="active-@r.Id.ToString("N")">@Localizer["Admin.SeoRedirects.Active"]</label>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.SeoRedirects.Cancel"]</button>
                            <button type="submit" class="btn btn-primary">@Localizer["Admin.SeoRedirects.Save"]</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </permission>
}

<permission require="@WebPermission.Redirect.Create">
    <div class="modal fade" id="createRedirectModal" tabindex="-1" aria-labelledby="createRedirectTitle" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <form data-loading asp-action="Create" method="post" class="modal-content" role="dialog" aria-modal="true" aria-labelledby="createRedirectTitle">
                @Html.AntiForgeryToken()
                <partial name="Partials/_ModalHeader"
                         model="@(new ModalHeaderVm { TitleId = "createRedirectTitle", Title = Localizer["Admin.SeoRedirects.Add"].Value, CloseLabel = Localizer["Admin.SeoRedirects.Close"].Value })" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="cr-old" class="form-label">@Localizer["Admin.SeoRedirects.OldUrlLabel"]</label>
                        <input id="cr-old" type="text" name="OldUrl" class="form-control" dir="ltr" placeholder="/old-path" required />
                    </div>
                    <div class="mb-3">
                        <label for="cr-new" class="form-label">@Localizer["Admin.SeoRedirects.NewUrlLabel"]</label>
                        <input id="cr-new" type="text" name="NewUrl" class="form-control" dir="ltr" placeholder="/new-path" required />
                    </div>
                    <div class="mb-3">
                        <label for="cr-status" class="form-label">@Localizer["Admin.SeoRedirects.StatusCodeLabel"]</label>
                        <select id="cr-status" name="StatusCode" class="form-select">
                            <option value="301" selected>@Localizer["Admin.SeoRedirects.Status301"]</option>
                            <option value="302">@Localizer["Admin.SeoRedirects.Status302"]</option>
                            <option value="307">@Localizer["Admin.SeoRedirects.Status307"]</option>
                            <option value="308">@Localizer["Admin.SeoRedirects.Status308"]</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.SeoRedirects.Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@Localizer["Admin.SeoRedirects.CreateSubmit"]</button>
                </div>
            </form>
        </div>
    </div>
</permission>
