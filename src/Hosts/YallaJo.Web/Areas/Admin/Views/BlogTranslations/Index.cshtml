@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.BlogTranslations
@model BlogTranslationsIndexVm
@{
    ViewData["Title"] = "Blog translations";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <a asp-area="Admin" asp-controller="Blogs" asp-action="Edit" asp-route-id="@Model.BlogId"
       class="btn btn-sm btn-outline-secondary mb-3">← Back to blog</a>

    <h2 class="mb-3">Translations</h2>

    @* Success/Error flash banners are rendered globally by the shared _Alerts partial. *@

    @if (!Model.HasArabic)
    {
        <div class="alert alert-warning">
            An Arabic (<code>ar</code>) translation is required before this blog can be published.
        </div>
    }

    @if (!Model.HasTranslations)
    {
        <div class="alert alert-info">No translations yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Language</th>
                        <th>Title</th>
                        <th>Summary</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Translations)
                    {
                        <tr>
                            <td><span class="badge text-bg-secondary text-uppercase">@t.LanguageCode</span></td>
                            <td>@t.Title</td>
                            <td>@(string.IsNullOrWhiteSpace(t.SummaryPreview) ? "—" : t.SummaryPreview)</td>
                            <td class="text-end">
                                <permission require="@WebPermission.Blog.Update">
                                    <a asp-area="Admin" asp-controller="BlogTranslations" asp-action="Edit"
                                       asp-route-id="@Model.BlogId" asp-route-languageCode="@t.LanguageCode"
                                       class="btn btn-sm btn-outline-primary">Edit</a>
                                </permission>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <permission require="@WebPermission.Blog.Update">
        <a asp-area="Admin" asp-controller="BlogTranslations" asp-action="Edit"
           asp-route-id="@Model.BlogId" asp-route-languageCode="ar"
           class="btn btn-primary">@(Model.HasArabic ? "Edit Arabic translation" : "Add Arabic translation")</a>
    </permission>
</div>
