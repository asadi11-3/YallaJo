@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Providers
@model ProviderQueueVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Providers.Title"].Value;
    ViewData["AdminNav"] = "Providers";

    var culture = CultureInfo.CurrentCulture;
    string Count(int n) => n.ToString("N0", culture);
    string Day(DateTime? d) => d?.ToString("yyyy-MM-dd", culture) ?? "—";
}

@* Success/Error flash banners are rendered globally by the shared _Alerts partial. *@

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Providers.Title"]</h1>
        <p class="mb-0 text-secondary">@Localizer["Admin.Providers.Subtitle"]</p>
    </div>
    <span class="badge bg-primary bg-opacity-10 text-primary align-self-start mt-2 mt-sm-0">
        <bdi class="font-data">@Count(Model.TotalCount)</bdi> @Localizer["Admin.Providers.TotalLabel"]
    </span>
</div>

@* ── Filters: status + provider type (A11Y4 labelled selects, F10 names not ids) ── *@
<div class="card shadow mb-4">
    <div class="card-header border-bottom">
        <h2 class="card-header-title h5 mb-0">@Localizer["Admin.Providers.FiltersHeading"]</h2>
    </div>
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Providers" asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-sm-6 col-lg-4">
                <label for="filter-status" class="form-label">@Localizer["Admin.Providers.StatusLabel"]</label>
                <select id="filter-status" name="status" class="form-select">
                    <option value="">@Localizer["Admin.Providers.AllStatuses"]</option>
                    @foreach (var opt in Model.StatusOptions)
                    {
                        <option value="@opt.Value" selected="@(string.Equals(opt.Value, Model.Status, StringComparison.OrdinalIgnoreCase))">@opt.Label</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-lg-4">
                <label for="filter-type" class="form-label">@Localizer["Admin.Providers.TypeLabel"]</label>
                <select id="filter-type" name="type" class="form-select">
                    <option value="">@Localizer["Admin.Providers.AllTypes"]</option>
                    @foreach (var opt in Model.TypeOptions)
                    {
                        <option value="@opt.Value" selected="@(string.Equals(opt.Value, Model.Type, StringComparison.OrdinalIgnoreCase))">@opt.Label</option>
                    }
                </select>
            </div>
            <div class="col-lg-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-filter fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Providers.ApplyFilters"]
                </button>
                <a asp-area="Admin" asp-controller="Providers" asp-action="Index" class="btn btn-outline-secondary">@Localizer["Admin.Providers.ClearFilters"]</a>
            </div>
        </form>
    </div>
</div>

@* ── Queue ── *@
<div class="card shadow">
    <div class="card-header border-bottom">
        <h2 class="card-header-title h5 mb-0">@Localizer["Admin.Providers.QueueHeading"]</h2>
    </div>
    <div class="card-body">
        @if (!Model.HasItems)
        {
            <div class="text-center py-5">
                <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
                <p class="mb-3 text-secondary">@Localizer["Admin.Providers.EmptyMessage"]</p>
                <a asp-area="Admin" asp-controller="Providers" asp-action="Index" class="btn btn-sm btn-primary-soft">@Localizer["Admin.Providers.EmptyCta"]</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th scope="col">@Localizer["Admin.Providers.ColBusiness"]</th>
                            <th scope="col">@Localizer["Admin.Providers.ColType"]</th>
                            <th scope="col">@Localizer["Admin.Providers.ColContact"]</th>
                            <th scope="col">@Localizer["Admin.Providers.ColStatus"]</th>
                            <th scope="col" class="text-end">@Localizer["Admin.Providers.ColDocs"]</th>
                            <th scope="col">@Localizer["Admin.Providers.ColSubmitted"]</th>
                            <th scope="col" class="text-end">@Localizer["Admin.Providers.ColActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Items)
                        {
                            <tr>
                                <td>
                                    <a asp-area="Admin" asp-controller="Providers" asp-action="Details"
                                       asp-route-id="@row.ApplicationId" class="fw-semibold text-decoration-none">@row.BusinessName</a>
                                    @if (row.ReapplicationCount > 0)
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary ms-1"
                                              title="@Localizer["Admin.Providers.Reapplications"]">
                                            <i class="fa-solid fa-rotate-right fa-fw" aria-hidden="true"></i>
                                            <bdi class="font-data">@Count(row.ReapplicationCount)</bdi>
                                            <span class="visually-hidden">@Localizer["Admin.Providers.Reapplications"]</span>
                                        </span>
                                    }
                                </td>
                                <td>@row.TypeLabel</td>
                                <td><bdi dir="ltr" class="text-secondary small">@row.ContactEmail</bdi></td>
                                <td>
                                    <span class="badge @row.StatusBadgeClass">
                                        <i class="fa-solid fa-circle-info fa-fw" aria-hidden="true"></i> @row.StatusLabel
                                    </span>
                                </td>
                                <td class="text-end"><bdi class="font-data">@Count(row.DocumentCount)</bdi></td>
                                <td><bdi class="font-data">@Day(row.SubmittedAt)</bdi></td>
                                <td class="text-end">
                                    <div class="d-flex flex-column align-items-end gap-2">
                                        <a asp-area="Admin" asp-controller="Providers" asp-action="Details"
                                           asp-route-id="@row.ApplicationId" class="btn btn-sm btn-outline-secondary">
                                            @Localizer["Admin.Providers.Manage"]
                                        </a>
                                        @if (row.CanApprove)
                                        {
                                            <permission require="@WebPermission.AdminProviderQueue.Approve">
                                                <form asp-area="Admin" asp-controller="Providers" asp-action="Approve"
                                                      asp-route-id="@row.ApplicationId" method="post"
                                                      data-confirm="@Localizer["Admin.Providers.ApproveConfirm", row.BusinessName]"
                                                      data-confirm-title="@Localizer["Admin.Providers.ApproveTitle"]"
                                                      data-confirm-action="@Localizer["Admin.Providers.Approve"]">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-success">@Localizer["Admin.Providers.Approve"]</button>
                                                </form>
                                            </permission>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (Model.HasPreviousPage || Model.HasNextPage)
    {
        <div class="card-footer border-top">
            <nav aria-label="@Localizer["Admin.Providers.PaginationLabel"]">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-area="Admin" asp-controller="Providers" asp-action="Index"
                           asp-route-status="@Model.Status" asp-route-type="@Model.Type" asp-route-page="@(Model.Page - 1)">
                            @Localizer["Admin.Providers.Previous"]
                        </a>
                    </li>
                    <li class="page-item active">
                        <span class="page-link">@Localizer["Admin.Providers.PageLabel"] <bdi class="font-data">@Count(Model.Page)</bdi></span>
                    </li>
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-area="Admin" asp-controller="Providers" asp-action="Index"
                           asp-route-status="@Model.Status" asp-route-type="@Model.Type" asp-route-page="@(Model.Page + 1)">
                            @Localizer["Admin.Providers.Next"]
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<p class="text-secondary small mt-3 mb-0">@Localizer["Admin.Providers.QueueHint"]</p>
