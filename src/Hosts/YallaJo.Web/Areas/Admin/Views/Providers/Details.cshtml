@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Providers
@model ProviderDetailsVm
@{
    ViewData["Title"] = "Provider application";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-area="Admin" asp-controller="Providers" asp-action="Index"
           class="btn btn-sm btn-outline-secondary">← Back to queue</a>
        <span class="badge @Model.StatusBadgeClass fs-6">@Model.StatusLabel</span>
    </div>

    @* Success/Error flash banners are rendered globally by the shared _Alerts partial. *@

    <h2 class="mb-1">@Model.BusinessName</h2>
    <p class="text-muted">@Model.TypeLabel</p>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card mb-3">
                <div class="card-header"><strong>Application details</strong></div>
                <div class="card-body">
                    <dl class="row mb-0 small">
                        <dt class="col-sm-4">Application ID</dt>
                        <dd class="col-sm-8"><code>@Model.ApplicationId</code></dd>

                        <dt class="col-sm-4">Applicant user ID</dt>
                        <dd class="col-sm-8"><code>@Model.UserId</code></dd>

                        <dt class="col-sm-4">Contact email</dt>
                        <dd class="col-sm-8">@Model.ContactEmail</dd>

                        <dt class="col-sm-4">Contact phone</dt>
                        <dd class="col-sm-8">@Model.ContactPhone</dd>

                        <dt class="col-sm-4">Address</dt>
                        <dd class="col-sm-8">@Model.Address</dd>

                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8" style="white-space: pre-wrap;">@Model.Description</dd>

                        <dt class="col-sm-4">Submitted</dt>
                        <dd class="col-sm-8">@(Model.SubmittedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>

                        <dt class="col-sm-4">Reviewed</dt>
                        <dd class="col-sm-8">@(Model.ReviewedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>

                        @if (Model.ReviewedByUserId.HasValue)
                        {
                            <dt class="col-sm-4">Reviewed by</dt>
                            <dd class="col-sm-8"><code>@Model.ReviewedByUserId</code></dd>
                        }

                        <dt class="col-sm-4">Reapplications</dt>
                        <dd class="col-sm-8">@Model.ReapplicationCount</dd>

                        @if (Model.CoolingPeriodEndsAt.HasValue)
                        {
                            <dt class="col-sm-4">Cooling period ends</dt>
                            <dd class="col-sm-8">@Model.CoolingPeriodEndsAt.Value.ToString("yyyy-MM-dd")</dd>
                        }
                    </dl>

                    @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
                    {
                        <div class="alert alert-danger mt-3 mb-0">
                            <strong>Rejection reason:</strong> @Model.RejectionReason
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.SuspensionReason))
                    {
                        <div class="alert alert-warning mt-3 mb-0">
                            <strong>Suspension reason:</strong> @Model.SuspensionReason
                        </div>
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header"><strong>Documents</strong></div>
                <div class="card-body">
                    @if (Model.HasMissingDocuments)
                    {
                        <div class="alert alert-info py-2">
                            <strong>Missing required documents:</strong>
                            @string.Join(", ", Model.MissingDocumentTypes)
                        </div>
                    }

                    @if (!Model.HasDocuments)
                    {
                        <p class="small text-muted mb-0">No documents uploaded.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Type</th>
                                        <th>File</th>
                                        <th class="text-end">Size</th>
                                        <th>Uploaded</th>
                                        <th>Expires</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var doc in Model.Documents)
                                    {
                                        <tr>
                                            <td>@doc.DocumentTypeLabel</td>
                                            <td class="text-truncate" style="max-width: 200px;">@doc.FileName</td>
                                            <td class="text-end">@doc.FileSizeLabel</td>
                                            <td>@doc.UploadedAt.ToString("yyyy-MM-dd")</td>
                                            <td>@(doc.ExpiresAt?.ToString("yyyy-MM-dd") ?? "—")</td>
                                            <td class="text-end">
                                                @if (!string.IsNullOrWhiteSpace(doc.FileUrl))
                                                {
                                                    <a href="@doc.FileUrl" target="_blank" rel="noopener noreferrer"
                                                       class="btn btn-sm btn-outline-primary">Open</a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card mb-3">
                <div class="card-header"><strong>Actions</strong></div>
                <div class="card-body d-flex flex-column gap-3">
                    @if (!Model.HasAnyAction)
                    {
                        <p class="text-muted small mb-0">No actions are available for this status.</p>
                    }

                    @if (Model.CanApprove)
                    {
                        <permission require="@WebPermission.AdminProviderQueue.Approve">
                            <form asp-area="Admin" asp-controller="Providers" asp-action="Approve"
                                  asp-route-id="@Model.ApplicationId" asp-route-fromDetails="true" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success w-100">Approve</button>
                            </form>
                        </permission>
                    }

                    @if (Model.CanReject)
                    {
                        <permission require="@WebPermission.AdminProviderQueue.Reject">
                            <form asp-area="Admin" asp-controller="Providers" asp-action="Reject"
                                  asp-route-id="@Model.ApplicationId" asp-route-fromDetails="true" method="post">
                                @Html.AntiForgeryToken()
                                <label class="form-label small mb-1">Rejection reason</label>
                                <textarea name="reason" class="form-control form-control-sm mb-2" rows="2"
                                          placeholder="Reason for rejection" required></textarea>
                                <button type="submit" class="btn btn-outline-danger w-100">Reject</button>
                            </form>
                        </permission>
                    }

                    @if (Model.CanRequestDocs)
                    {
                        <permission require="@WebPermission.AdminProviderQueue.RequestDocs">
                            <form asp-area="Admin" asp-controller="Providers" asp-action="RequestDocuments"
                                  asp-route-id="@Model.ApplicationId" asp-route-fromDetails="true" method="post">
                                @Html.AntiForgeryToken()
                                <label class="form-label small mb-1">Missing documents</label>
                                <select name="missingDocumentTypes" class="form-select form-select-sm mb-2" multiple size="6" required>
                                    @foreach (var doc in Model.DocumentTypeOptions)
                                    {
                                        <option value="@doc.Value">@doc.Label</option>
                                    }
                                </select>
                                <textarea name="notes" class="form-control form-control-sm mb-2" rows="2"
                                          placeholder="Notes for the provider" required></textarea>
                                <button type="submit" class="btn btn-info w-100">Request documents</button>
                            </form>
                        </permission>
                    }

                    @if (Model.CanSuspend)
                    {
                        <permission require="@WebPermission.AdminProviderQueue.Suspend">
                            <form asp-area="Admin" asp-controller="Providers" asp-action="Suspend"
                                  asp-route-id="@Model.ApplicationId" asp-route-fromDetails="true" method="post">
                                @Html.AntiForgeryToken()
                                <label class="form-label small mb-1">Suspension reason</label>
                                <textarea name="reason" class="form-control form-control-sm mb-2" rows="2"
                                          placeholder="Reason for suspension" required></textarea>
                                <button type="submit" class="btn btn-outline-warning w-100">Suspend</button>
                            </form>
                        </permission>
                    }

                    @if (Model.CanReinstate)
                    {
                        <permission require="@WebPermission.AdminProviderQueue.Reinstate">
                            <form asp-area="Admin" asp-controller="Providers" asp-action="Reinstate"
                                  asp-route-id="@Model.ApplicationId" asp-route-fromDetails="true" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-success w-100">Reinstate</button>
                            </form>
                        </permission>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
