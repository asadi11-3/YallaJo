@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Providers
@using YallaJo.Web.Areas.Admin.Models.Shared
@model ProviderQueueVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    // Swappable listing fragment (S1/PE1): rendered inline on first load and
    // returned alone for listing.js (WantsAjax) refinements.
    var culture = CultureInfo.CurrentCulture;
    string Count(int n) => n.ToString("N0", culture);
    string Day(DateTime? d) => d?.ToString("yyyy-MM-dd", culture) ?? "—";

    // Counted status tabs (§5.6/L6): plain GET links — PE1-safe, and listing.js
    // intercepts them automatically (same pathname, inside the listing root).
    // Counts are best-effort (ERR3): null StatusCounts just hides the badges.
    var counts = Model.StatusCounts;
    bool IsActive(string? value) => value is null
        ? string.IsNullOrEmpty(Model.Status)
        : string.Equals(Model.Status, value, StringComparison.OrdinalIgnoreCase);
    string TabUrl(string? value) => Url.Action("Index", "Providers", new { area = "Admin", status = value, type = Model.Type })!;
    var queueTabs = new QueueTabsVm
    {
        AriaLabel = Localizer["Admin.Shared.QueueTabsAria"].Value,
        Tabs =
        [
            new QueueTabVm { Label = Localizer["Admin.Providers.AllStatuses"].Value, Url = TabUrl(null), Active = IsActive(null) },
            new QueueTabVm { Label = Localizer["Admin.Providers.Status.Pending"].Value, Url = TabUrl("Pending"), Active = IsActive("Pending"), Count = counts?.Pending },
            new QueueTabVm { Label = Localizer["Admin.Providers.Status.AwaitingDocs"].Value, Url = TabUrl("MoreDocsNeeded"), Active = IsActive("MoreDocsNeeded"), Count = counts?.AwaitingDocuments },
            new QueueTabVm { Label = Localizer["Admin.Providers.Status.Approved"].Value, Url = TabUrl("Approved"), Active = IsActive("Approved"), Count = counts?.Approved },
            new QueueTabVm { Label = Localizer["Admin.Providers.Status.Suspended"].Value, Url = TabUrl("Suspended"), Active = IsActive("Suspended"), Count = counts?.Suspended },
            new QueueTabVm { Label = Localizer["Admin.Providers.Status.Rejected"].Value, Url = TabUrl("Rejected"), Active = IsActive("Rejected"), Count = counts?.Rejected },
        ],
    };
}

<div class="card-body border-bottom py-2">
    <partial name="Partials/_QueueTabs" model="queueTabs" />
</div>

@if (ViewBag.Error is string vbe)
{
    <div class="alert alert-danger m-3 mb-0" role="alert">@vbe</div>
}

<div class="card-body">
    @if (!Model.HasItems)
    {
        <partial name="Partials/_EmptyState"
                 model="@(new EmptyStateVm { Message = Localizer["Admin.Providers.EmptyMessage"].Value, CtaText = Localizer["Admin.Providers.EmptyCta"].Value, CtaUrl = Url.Action("Index", "Providers", new { area = "Admin" }) })" />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["Admin.Providers.ColBusiness"]</th>
                        <th scope="col">@Localizer["Admin.Providers.ColType"]</th>
                        <th scope="col">@Localizer["Admin.Providers.ColContact"]</th>
                        <th scope="col">@Localizer["Admin.Providers.ColStatus"]</th>
                        <th scope="col" class="text-end">@Localizer["Admin.Providers.ColDocs"]</th>
                        <th scope="col">@Localizer["Admin.Providers.ColSubmitted"]</th>
                        <th scope="col" class="text-end">@Localizer["Admin.Providers.ColActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Items)
                    {
                        <tr>
                            <td>
                                <a asp-area="Admin" asp-controller="Providers" asp-action="Details"
                                   asp-route-id="@row.ApplicationId" class="fw-semibold text-decoration-none">@row.BusinessName</a>
                                @if (row.ReapplicationCount > 0)
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary ms-1"
                                          title="@Localizer["Admin.Providers.Reapplications"]">
                                        <i class="fa-solid fa-rotate-right fa-fw" aria-hidden="true"></i>
                                        <bdi class="font-data">@Count(row.ReapplicationCount)</bdi>
                                        <span class="visually-hidden">@Localizer["Admin.Providers.Reapplications"]</span>
                                    </span>
                                }
                            </td>
                            <td>@row.TypeLabel</td>
                            <td><bdi dir="ltr" class="text-secondary small">@row.ContactEmail</bdi></td>
                            <td>
                                <span class="badge @row.StatusBadgeClass">
                                    <i class="fa-solid fa-circle-info fa-fw" aria-hidden="true"></i> @row.StatusLabel
                                </span>
                            </td>
                            <td class="text-end"><bdi class="font-data">@Count(row.DocumentCount)</bdi></td>
                            <td><bdi class="font-data">@Day(row.SubmittedAt)</bdi></td>
                            <td class="text-end">
                                <div class="d-flex flex-column align-items-end gap-2">
                                    <a asp-area="Admin" asp-controller="Providers" asp-action="Details"
                                       asp-route-id="@row.ApplicationId" class="btn btn-sm btn-outline-secondary">
                                        @Localizer["Admin.Providers.Manage"]
                                    </a>
                                    @if (row.CanApprove)
                                    {
                                        <permission require="@WebPermission.AdminProviderQueue.Approve">
                                            <form asp-area="Admin" asp-controller="Providers" asp-action="Approve"
                                                  asp-route-id="@row.ApplicationId" method="post"
                                                  data-confirm="@Localizer["Admin.Providers.ApproveConfirm", row.BusinessName]"
                                                  data-confirm-title="@Localizer["Admin.Providers.ApproveTitle"]"
                                                  data-confirm-action="@Localizer["Admin.Providers.Approve"]" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-success">@Localizer["Admin.Providers.Approve"]</button>
                                            </form>
                                        </permission>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Model.HasPreviousPage || Model.HasNextPage)
{
    <partial name="Partials/_PaginationFooter"
             model="@(new PaginationFooterVm
             {
                 HasPrevious = Model.HasPreviousPage,
                 HasNext = Model.HasNextPage,
                 Page = Model.Page,
                 PreviousUrl = Url.Action("Index", "Providers", new { area = "Admin", status = Model.Status, type = Model.Type, page = Model.Page - 1 }),
                 NextUrl = Url.Action("Index", "Providers", new { area = "Admin", status = Model.Status, type = Model.Type, page = Model.Page + 1 }),
                 PreviousText = Localizer["Admin.Providers.Previous"].Value,
                 NextText = Localizer["Admin.Providers.Next"].Value,
                 PageLabel = Localizer["Admin.Providers.PageLabel"].Value
             })" />
}
