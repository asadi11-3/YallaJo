@model YallaJo.Web.Areas.Admin.Models.Translations.UpdateTranslationVm
@{
    ViewData["Title"] = "Edit Translation";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var original   = (ViewBag.Original as string) ?? string.Empty;
    var entityType = ViewBag.EntityType?.ToString() ?? string.Empty;
    var entityId   = ViewBag.EntityId?.ToString() ?? string.Empty;
}

<div class="container mt-4">
    <h2>Edit Translation</h2>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @if (!string.IsNullOrEmpty(original))
    {
        <div class="mb-3">
            <label class="form-label">Original</label>
            <textarea class="form-control" rows="3" readonly>@original</textarea>
        </div>
    }

    <form asp-area="Admin" asp-controller="Translations" asp-action="Edit"
          asp-route-id="@Model.Id" method="post" class="col-md-8">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" name="entityType" value="@entityType" />
        <input type="hidden" name="entityId"   value="@entityId" />

        <div class="mb-3">
            <label asp-for="TranslatedText" class="form-label"></label>
            <textarea asp-for="TranslatedText" class="form-control" rows="4"></textarea>
            <span asp-validation-for="TranslatedText" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index"
           asp-route-entityType="@entityType"
           asp-route-entityId="@entityId"
           class="btn btn-link">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
