@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Translations
@model YallaJo.Web.Areas.Admin.Models.Translations.TranslationListVm
@{
    ViewData["Title"] = "Translations";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h2>Translations</h2>
        <permission require="@WebPermission.TranslationCache.Create">
            <a asp-area="Admin" asp-controller="Translations" asp-action="OnDemand"
               class="btn btn-outline-secondary">On-demand translate</a>
        </permission>
    </div>
    <p class="text-muted">Select an entity to view or manage its translations.</p>

    @* Success/Error flash banners are rendered globally by the shared _Alerts partial (in _Layout). *@
    @if (ViewBag.Error       is string vbe) { <div class="alert alert-danger">@vbe</div> }

    <form asp-area="Admin" asp-controller="Translations" asp-action="Index" method="get"
          class="row g-2 mb-4">
        <div class="col-md-3">
            <label class="form-label">Entity type</label>
            <select name="entityType" asp-items="Html.GetEnumSelectList<EntityTypeOption>()" class="form-select">
                <option value="">—</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Entity ID</label>
            <input name="entityId" class="form-control"
                   value="@(Model.HasFilter ? Model.Filter.EntityId.ToString() : string.Empty)"
                   placeholder="00000000-0000-0000-0000-000000000000" />
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-outline-secondary">Load</button>
        </div>
    </form>

    @if (Model.HasFilter)
    {
        <table class="table table-sm table-bordered align-middle">
            <thead>
                <tr>
                    <th>Field</th>
                    <th>From → To</th>
                    <th>Original</th>
                    <th>Translated</th>
                    <th>Status</th>
                    <th>Conf.</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Translations.OrderBy(x => x.FieldName).ThenBy(x => x.ToLanguage))
                {
                    <tr>
                        <td>@(t.FieldName ?? "—")</td>
                        <td><code>@t.FromLanguage → @t.ToLanguage</code></td>
                        <td style="max-width:240px; word-break:break-word;">@t.OriginalText</td>
                        <td style="max-width:240px; word-break:break-word;">@t.TranslatedText</td>
                        <td>@t.Status</td>
                        <td>@(t.Confidence?.ToString("0.00") ?? "—")</td>
                        <td>
                            <permission require="@WebPermission.TranslationCache.Update">
                                <a asp-area="Admin" asp-controller="Translations" asp-action="Edit"
                                   asp-route-id="@t.Id"
                                   asp-route-original="@t.OriginalText"
                                   asp-route-translated="@t.TranslatedText"
                                   asp-route-entityType="@Model.Filter.EntityType"
                                   asp-route-entityId="@Model.Filter.EntityId"
                                   class="btn btn-sm btn-outline-secondary">Edit</a>
                                <form asp-area="Admin" asp-controller="Translations" asp-action="Approve"
                                      asp-route-id="@t.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="entityType" value="@Model.Filter.EntityType" />
                                    <input type="hidden" name="entityId" value="@Model.Filter.EntityId" />
                                    <button type="submit" class="btn btn-sm btn-outline-success">Approve</button>
                                </form>
                            </permission>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
