@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Translations
@using YallaJo.Web.Areas.Admin.Models.Shared
@model YallaJo.Web.Areas.Admin.Models.Translations.TranslationListVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Translations.Title"].Value;
    ViewData["AdminNav"] = "Translations";

    var culture = CultureInfo.CurrentCulture;
    string Date(DateTime dt) => dt.ToString("yyyy-MM-dd HH:mm", culture);
    string Conf(double? c) => c.HasValue ? c.Value.ToString("0.00", culture) : "—";

    (string Color, string Icon) StatusBadge(string status) => status.ToLowerInvariant() switch
    {
        "approved" or "reviewed" or "human" => ("success", "circle-check"),
        "pending" or "auto" or "machine" => ("warning", "robot"),
        "rejected" => ("danger", "circle-xmark"),
        _ => ("secondary", "circle-question"),
    };

    var hasContext = Model.HasFilter;
    var entityType = Model.Filter.EntityType;
    var entityId = Model.Filter.EntityId;
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Translations.Title"]</h1>
        <p class="mb-0 text-secondary">@Localizer["Admin.Translations.Subtitle"]</p>
    </div>
    <permission require="@WebPermission.TranslationCache.Create">
        <a asp-area="Admin" asp-controller="Translations" asp-action="OnDemand" class="btn btn-outline-primary">
            <i class="fa-solid fa-language fa-fw" aria-hidden="true"></i> @Localizer["Admin.Translations.OnDemand"]
        </a>
    </permission>
</div>

@if (ViewBag.Error is string vbe)
{
    <div class="alert alert-danger" role="alert">@vbe</div>
}

@if (!hasContext)
{
    <div class="card shadow">
        <div class="card-body text-center py-5">
            <img src="~/assets/images/element/17.svg" loading="lazy" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
            <h2 class="h5">@Localizer["Admin.Translations.NoContextHeading"]</h2>
            <p class="mb-3 text-secondary">@Localizer["Admin.Translations.NoContextMessage"]</p>
            <permission require="@WebPermission.TranslationCache.Create">
                <a asp-area="Admin" asp-controller="Translations" asp-action="OnDemand" class="btn btn-sm btn-primary-soft">
                    <i class="fa-solid fa-language fa-fw" aria-hidden="true"></i> @Localizer["Admin.Translations.OnDemand"]
                </a>
            </permission>
        </div>
    </div>
}
else
{
    <div class="card shadow mb-4">
        <div class="card-header border-bottom">
            <h2 class="card-header-title h5 mb-0">@Localizer["Admin.Translations.ContextHeading"]</h2>
        </div>
        <div class="card-body">
            <p class="mb-0 text-secondary">
                @Localizer["Admin.Translations.ContextLabel"]
                <span class="badge bg-primary bg-opacity-10 text-primary ms-1">@entityType.ToString()</span>
            </p>
        </div>
    </div>

    <section class="card shadow" aria-labelledby="translations-heading">
        <div class="card-header border-bottom">
            <h2 id="translations-heading" class="card-header-title h5 mb-0">@Localizer["Admin.Translations.Directory"]</h2>
        </div>
        <div class="card-body">
            @if (Model.Translations.Count == 0)
            {
                <partial name="Partials/_EmptyState"
                         model="@(new EmptyStateVm { Message = Localizer["Admin.Translations.EmptyMessage"].Value })" />
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">@Localizer["Admin.Translations.ColField"]</th>
                                <th scope="col">@Localizer["Admin.Translations.ColLanguages"]</th>
                                <th scope="col">@Localizer["Admin.Translations.ColOriginal"]</th>
                                <th scope="col">@Localizer["Admin.Translations.ColTranslated"]</th>
                                <th scope="col">@Localizer["Admin.Translations.ColStatus"]</th>
                                <th scope="col">@Localizer["Admin.Translations.ColConfidence"]</th>
                                <th scope="col" class="text-end">@Localizer["Admin.Translations.ColActions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.Translations.OrderBy(x => x.FieldName).ThenBy(x => x.ToLanguage))
                            {
                                var sb = StatusBadge(t.Status);
                                <tr>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(t.FieldName))
                                        {
                                            <span class="text-secondary" aria-label="@Localizer["Admin.Translations.NoField"]">&mdash;</span>
                                        }
                                        else
                                        {
                                            <span class="fw-semibold">@t.FieldName</span>
                                        }
                                    </td>
                                    <td><bdi dir="ltr" class="font-data text-secondary">@t.FromLanguage &rarr; @t.ToLanguage</bdi></td>
                                    <td class="text-break mw-240">@t.OriginalText</td>
                                    <td class="text-break mw-240"><bdi>@t.TranslatedText</bdi></td>
                                    <td>
                                        <span class="badge bg-@sb.Color bg-opacity-10 text-@sb.Color"><i class="fa-solid fa-@sb.Icon fa-fw" aria-hidden="true"></i> @t.Status</span>
                                    </td>
                                    <td><bdi dir="ltr" class="font-data">@Conf(t.Confidence)</bdi></td>
                                    <td class="text-end">
                                        <permission require="@WebPermission.TranslationCache.Update">
                                            <a asp-area="Admin" asp-controller="Translations" asp-action="Edit"
                                               asp-route-id="@t.Id"
                                               asp-route-original="@t.OriginalText"
                                               asp-route-translated="@t.TranslatedText"
                                               asp-route-entityType="@entityType"
                                               asp-route-entityId="@entityId"
                                               class="btn btn-sm btn-outline-secondary"
                                               data-yj-modal-target="#editTranslationModal"
                                               data-action="@Url.Action("Edit", new { area = "Admin", id = t.Id })"
                                               data-field-id="@t.Id"
                                               data-field-translated-text="@t.TranslatedText"
                                               data-field-original="@t.OriginalText"
                                               data-field-entity-type="@entityType"
                                               data-field-entity-id="@entityId">
                                                <i class="fa-solid fa-pen fa-fw" aria-hidden="true"></i> @Localizer["Admin.Translations.Edit"]
                                            </a>
                                            <form data-loading asp-area="Admin" asp-controller="Translations" asp-action="Approve" asp-route-id="@t.Id" method="post" class="d-inline"
                                                  data-confirm="@Localizer["Admin.Translations.ApproveConfirm"]"
                                                  data-confirm-title="@Localizer["Admin.Translations.ApproveTitle"]"
                                                  data-confirm-action="@Localizer["Admin.Translations.Approve"]" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="entityType" value="@entityType" />
                                                <input type="hidden" name="entityId" value="@entityId" />
                                                <button type="submit" class="btn btn-sm btn-outline-success">
                                                    <i class="fa-solid fa-check fa-fw" aria-hidden="true"></i> @Localizer["Admin.Translations.Approve"]
                                                </button>
                                            </form>
                                        </permission>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <permission require="@WebPermission.TranslationCache.Update">
        @{ var editOpen = Model.EditId is not null; }
        @* Edit modal (F8 §4.7): JS opens it via admin-modal-crud.js; deep links / no-JS
           render it server-side open (PE1) with anchor-based close controls. *@
        <div class="modal fade@(editOpen ? " show d-block" : "")" id="editTranslationModal" tabindex="-1"
             role="dialog" aria-modal="true" aria-labelledby="editTranslationModalLabel"
             data-yj-component="modal-crud">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <form data-loading asp-area="Admin" asp-controller="Translations" asp-action="Edit"
                      asp-route-id="@Model.Edit.Id" method="post" class="modal-content">
                    @Html.AntiForgeryToken()
                    <partial name="Partials/_ModalHeader"
                             model="@(new ModalHeaderVm { TitleId = "editTranslationModalLabel", Title = Localizer["Admin.Translations.EditHeading"].Value, CloseLabel = Localizer["Admin.Translations.Cancel"].Value, CloseUrl = editOpen ? Url.Action("Index", new { entityType, entityId }) : null })" />
                    <div class="modal-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                        <input type="hidden" asp-for="Edit.Id" data-yj-field="id" />
                        <input type="hidden" name="entityType" value="@entityType" data-yj-field="entityType" />
                        <input type="hidden" name="entityId" value="@entityId" data-yj-field="entityId" />
                        <div class="mb-3">
                            <label for="edit-original-text" class="form-label">@Localizer["Admin.Translations.OriginalLabel"]</label>
                            <textarea id="edit-original-text" name="original" class="form-control" rows="3" readonly data-yj-field="original">@Model.EditOriginal</textarea>
                        </div>
                        <div class="mb-0">
                            <label asp-for="Edit.TranslatedText" class="form-label">@Localizer["Admin.Translations.TranslatedLabel"]</label>
                            <textarea asp-for="Edit.TranslatedText" class="form-control" rows="4" data-yj-field="translatedText"></textarea>
                            <span asp-validation-for="Edit.TranslatedText" class="text-danger" role="alert"></span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        @if (editOpen)
                        {
                            <a href="@Url.Action("Index", new { entityType, entityId })" class="btn btn-outline-secondary">@Localizer["Admin.Translations.Cancel"]</a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.Translations.Cancel"]</button>
                        }
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk fa-fw" aria-hidden="true"></i> @Localizer["Admin.Translations.Save"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
        @if (editOpen)
        {
            <div class="modal-backdrop fade show"></div>
        }
    </permission>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/admin-modal-crud.js" asp-append-version="true"></script>
}
