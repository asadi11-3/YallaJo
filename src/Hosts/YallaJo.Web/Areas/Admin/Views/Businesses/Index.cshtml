@using YallaJo.Web.Areas.Admin.Models.Businesses
@using YallaJo.Web.Infrastructure.Authorization
@model BusinessesVm
@{
    ViewData["Title"] = "Business approvals";
    ViewData["AdminNav"] = "Businesses";
    var statuses = new[] { "Pending", "Approved", "Rejected", "Suspended", "MoreDocsNeeded" };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Business approvals</h1>
        <p class="text-body-secondary mb-0">Review and moderate the businesses registered under a place.</p>
    </div>
</div>

<div class="card card-body shadow mb-4">
    <form method="get" asp-area="Admin" asp-controller="Businesses" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label" for="placeId">Place ID</label>
            <input type="text" class="form-control font-data" id="placeId" name="placeId"
                   value="@(Model.PlaceId?.ToString("D"))" placeholder="00000000-0000-0000-0000-000000000000" />
        </div>
        <div class="col-md-4">
            <label class="form-label" for="status">Status</label>
            <select class="form-select" id="status" name="status">
                <option value="">All statuses</option>
                @foreach (var s in statuses)
                {
                    if (string.Equals(s, Model.StatusFilter, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@s" selected>@s</option>
                    }
                    else
                    {
                        <option value="@s">@s</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Apply</button>
            <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Businesses" asp-action="Index">Reset</a>
        </div>
    </form>
</div>

@if (Model.Businesses.Count > 0)
{
    <div class="card shadow">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Business</th>
                        <th>Type</th>
                        <th>Location</th>
                        <th>Rating</th>
                        <th>Verified</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Businesses)
                    {
                        var color = BusinessesMapper.StatusColor(b.Status);
                        <tr>
                            <td>
                                <div class="fw-semibold">@b.Name</div>
                                <div class="small text-body-secondary">@b.Slug</div>
                            </td>
                            <td>@b.BusinessType</td>
                            <td>@(string.Join(", ", new[] { b.City, b.Country }.Where(x => !string.IsNullOrWhiteSpace(x))))</td>
                            <td>
                                <span class="font-data">@b.AverageRating.ToString("N1")</span>
                                <span class="small text-body-secondary">(@b.ReviewCount)</span>
                            </td>
                            <td>
                                @if (b.IsVerified)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success">Verified</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary">Unverified</span>
                                }
                            </td>
                            <td><span class="badge bg-@color bg-opacity-10 text-@color">@b.Status</span></td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1 flex-wrap justify-content-end">
                                    <permission require="@WebPermission.Business.Approve">
                                        <form method="post" asp-action="Approve" asp-route-id="@b.Id" asp-route-placeId="@Model.PlaceId" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success">Approve</button>
                                        </form>
                                    </permission>
                                    <permission require="@WebPermission.Business.Reject">
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal-@b.Id">Reject</button>
                                    </permission>
                                    <permission require="@WebPermission.Business.RequestDocs">
                                        <button type="button" class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#docsModal-@b.Id">Request docs</button>
                                    </permission>
                                    <permission require="@WebPermission.Business.Suspend">
                                        <button type="button" class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#suspendModal-@b.Id">Suspend</button>
                                    </permission>
                                    <permission require="@WebPermission.Business.Reinstate">
                                        <form method="post" asp-action="Reinstate" asp-route-id="@b.Id" asp-route-placeId="@Model.PlaceId" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Reinstate</button>
                                        </form>
                                    </permission>
                                    <permission require="@WebPermission.Business.Delete">
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@b.Id">Delete</button>
                                    </permission>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @foreach (var b in Model.Businesses)
    {
        <permission require="@WebPermission.Business.Reject">
            <div class="modal fade" id="rejectModal-@b.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <form method="post" asp-action="Reject" asp-route-id="@b.Id" asp-route-placeId="@Model.PlaceId" class="modal-content">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title">Reject @b.Name</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <label class="form-label" for="reject-reason-@b.Id">Reason</label>
                            <textarea class="form-control" id="reject-reason-@b.Id" name="reason" rows="3" required></textarea>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger">Reject business</button>
                        </div>
                    </form>
                </div>
            </div>
        </permission>
        <permission require="@WebPermission.Business.RequestDocs">
            <div class="modal fade" id="docsModal-@b.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <form method="post" asp-action="RequestMoreDocs" asp-route-id="@b.Id" asp-route-placeId="@Model.PlaceId" class="modal-content">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title">Request documents from @b.Name</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <label class="form-label" for="docs-reason-@b.Id">Note</label>
                            <textarea class="form-control" id="docs-reason-@b.Id" name="reason" rows="3" required></textarea>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-info">Send request</button>
                        </div>
                    </form>
                </div>
            </div>
        </permission>
        <permission require="@WebPermission.Business.Suspend">
            <div class="modal fade" id="suspendModal-@b.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <form method="post" asp-action="Suspend" asp-route-id="@b.Id" asp-route-placeId="@Model.PlaceId" class="modal-content">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title">Suspend @b.Name</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <label class="form-label" for="suspend-reason-@b.Id">Reason</label>
                            <textarea class="form-control" id="suspend-reason-@b.Id" name="reason" rows="3" required></textarea>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-warning">Suspend business</button>
                        </div>
                    </form>
                </div>
            </div>
        </permission>
        <permission require="@WebPermission.Business.Delete">
            <div class="modal fade" id="deleteModal-@b.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <form method="post" asp-action="Delete" asp-route-id="@b.Id" asp-route-placeId="@Model.PlaceId" class="modal-content">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title">Delete @b.Name</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="mb-0">This permanently deletes the business. This action cannot be undone.</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger">Delete business</button>
                        </div>
                    </form>
                </div>
            </div>
        </permission>
    }

    @if (Model.HasPrevious || Model.HasNext)
    {
        <nav class="d-flex justify-content-between align-items-center mt-3">
            <div class="small text-body-secondary">Page @Model.PageNumber of @Model.TotalPages (@Model.TotalCount total)</div>
            <div class="d-flex gap-2">
                @if (Model.HasPrevious)
                {
                    <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-route-placeId="@Model.PlaceId" asp-route-status="@Model.StatusFilter" asp-route-page="@(Model.PageNumber - 1)">Previous</a>
                }
                @if (Model.HasNext)
                {
                    <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-route-placeId="@Model.PlaceId" asp-route-status="@Model.StatusFilter" asp-route-page="@(Model.PageNumber + 1)">Next</a>
                }
            </div>
        </nav>
    }
}
else
{
    <div class="card card-body shadow text-center py-5">
        <img src="~/assets/images/element/17.svg" alt="" class="h-80px mx-auto mb-3" />
        <p class="text-body-secondary mb-0">
            @(Model.PlaceId is null
                ? "Enter a place ID above to view its businesses."
                : "No businesses found for this place.")
        </p>
    </div>
}
