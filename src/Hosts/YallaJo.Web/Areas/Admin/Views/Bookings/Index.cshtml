@using YallaJo.Web.Areas.Admin.Models.Bookings
@using YallaJo.Web.Infrastructure.Authorization
@model BookingsVm
@{
    ViewData["Title"] = "Bookings";
    ViewData["AdminNav"] = "Bookings";

    string Money(decimal amount, string? currency) => $"{amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)} {currency}".Trim();

    var statuses = new[]
    {
        "Pending", "Confirmed", "InProgress", "Completed", "Cancelled",
        "Refunded", "NoShow", "AwaitingPayment", "PendingConfirmation", "Rejected",
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Bookings</h1>
        <p class="text-muted mb-0">Review bookings and issue force-majeure refunds.</p>
    </div>
</div>

<div class="card card-body shadow mb-4">
    <form method="get" asp-area="Admin" asp-controller="Bookings" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-sm-4 col-lg-3">
            <label class="form-label" for="Status">Status</label>
            <select class="form-select" id="Status" name="Status">
                <option value="">All statuses</option>
                @foreach (var status in statuses)
                {
                    if (string.Equals(status, Model.StatusFilter, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@status" selected>@status</option>
                    }
                    else
                    {
                        <option value="@status">@status</option>
                    }
                }
            </select>
        </div>
        <div class="col-sm-4 col-lg-3">
            <label class="form-label" for="FromDate">From</label>
            <input type="date" class="form-control" id="FromDate" name="FromDate" value="@Model.FromDate" />
        </div>
        <div class="col-sm-4 col-lg-3">
            <label class="form-label" for="ToDate">To</label>
            <input type="date" class="form-control" id="ToDate" name="ToDate" value="@Model.ToDate" />
        </div>
        <div class="col-sm-12 col-lg-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Apply</button>
            <a asp-area="Admin" asp-controller="Bookings" asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

@if (Model.Bookings.Count == 0)
{
    <div class="card card-body shadow text-center py-5">
        <img src="~/assets/images/element/17.svg" alt="" class="h-80px mb-3 mx-auto" />
        <p class="text-muted mb-0">No bookings to display.</p>
    </div>
}
else
{
    <div class="card shadow">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Booking</th>
                        <th>User</th>
                        <th>Participants</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Bookings)
                    {
                        var color = BookingsMapper.StatusColor(b.Status);
                        <tr>
                            <td class="font-data">@b.Reference</td>
                            <td class="font-data">@b.Id.ToString("D").Substring(0, 8)</td>
                            <td class="font-data">@b.UserId.ToString("D").Substring(0, 8)</td>
                            <td class="font-data">@b.ParticipantCount</td>
                            <td class="font-data">@Money(b.TotalAmount, b.Currency)</td>
                            <td><span class="badge bg-@color bg-opacity-10 text-@color">@b.Status</span></td>
                            <td class="font-data">@b.CreatedAt.ToString("g")</td>
                            <td class="text-end">
                                @if (b.CanForceRefund)
                                {
                                    <permission require="@WebPermission.AdminBookingDashboard.Update">
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                data-bs-toggle="modal" data-bs-target="#forceRefundModal-@b.Id">
                                            Force refund
                                        </button>
                                    </permission>
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.NextCursor))
    {
        <div class="mt-3 text-center">
            <a class="btn btn-outline-secondary"
               asp-area="Admin" asp-controller="Bookings" asp-action="Index"
               asp-route-cursor="@Model.NextCursor"
               asp-route-Status="@Model.StatusFilter"
               asp-route-FromDate="@Model.FromDate"
               asp-route-ToDate="@Model.ToDate">
                Load more
            </a>
        </div>
    }

    <permission require="@WebPermission.AdminBookingDashboard.Update">
        @foreach (var b in Model.Bookings.Where(x => x.CanForceRefund))
        {
            <div class="modal fade" id="forceRefundModal-@b.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form method="post" asp-area="Admin" asp-controller="Bookings" asp-action="ForceRefund" asp-route-id="@b.Id">
                            @Html.AntiForgeryToken()
                            <div class="modal-header">
                                <h5 class="modal-title">Force refund booking @b.Reference</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <p class="text-muted">This cancels the booking with a 100% refund and bypasses the refund policy. The action is audit-logged.</p>
                                <label class="form-label" for="reason-@b.Id">Reason</label>
                                <textarea class="form-control" id="reason-@b.Id" name="reason" rows="3" required></textarea>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-danger">Force refund</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </permission>
}
