@using YallaJo.Web.Areas.Admin.Models.Bookings
@using YallaJo.Web.Infrastructure.Authorization
@model AdminBookingDetailsVm
@{
    ViewData["Title"] = "Booking details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string Money(decimal amount) => $"{amount.ToString("0.##")} {Model.Currency}";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">Booking <code>@Model.Reference</code></h2>
            <span class="badge @Model.StatusBadgeClass">@Model.Status</span>
        </div>
        <a asp-area="Admin" asp-controller="Bookings" asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to bookings</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border mb-3">
                <div class="card-header"><strong>Overview</strong></div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Tour</dt>
                        <dd class="col-sm-8">@Model.TourName <span class="text-muted small d-block"><code>@Model.TourId</code></span></dd>

                        <dt class="col-sm-4">Provider ID</dt>
                        <dd class="col-sm-8"><code>@Model.ProviderId</code></dd>

                        <dt class="col-sm-4">Traveler</dt>
                        <dd class="col-sm-8">@Model.TravelerHandle</dd>

                        <dt class="col-sm-4">Availability slot ID</dt>
                        <dd class="col-sm-8"><code>@Model.AvailabilitySlotId</code></dd>

                        <dt class="col-sm-4">Guests</dt>
                        <dd class="col-sm-8">@Model.ParticipantCount</dd>

                        <dt class="col-sm-4">Instant booking</dt>
                        <dd class="col-sm-8">@(Model.IsInstantBooking ? "Yes" : "No")</dd>

                        <dt class="col-sm-4">Special requests</dt>
                        <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.SpecialRequests) ? "—" : Model.SpecialRequests)</dd>

                        <dt class="col-sm-4">Created</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                        <dt class="col-sm-4">Payment expires</dt>
                        <dd class="col-sm-8">@(Model.PaymentExpiresAt is { } p ? p.ToString("yyyy-MM-dd HH:mm") : "—")</dd>

                        <dt class="col-sm-4">Last updated</dt>
                        <dd class="col-sm-8">@(Model.UpdatedAt is { } u ? u.ToString("yyyy-MM-dd HH:mm") : "—")</dd>
                    </dl>
                </div>
            </div>

            @if (Model.IsCancelled)
            {
                <div class="card border">
                    <div class="card-header"><strong>Cancellation</strong></div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Cancelled at</dt>
                            <dd class="col-sm-8">@(Model.CancelledAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
                            <dt class="col-sm-4">Reason</dt>
                            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.CancellationReason) ? "—" : Model.CancellationReason)</dd>
                            <dt class="col-sm-4">Refund</dt>
                            <dd class="col-sm-8">@(Model.RefundAmount is { } r ? Money(r) : "—")</dd>
                        </dl>
                    </div>
                </div>
            }

            @* ── Dispute lifecycle (FE-1A-2 / FE-1A-3) ───────────────────────── *@
            @if (Model.IsDisputed)
            {
                <div class="card border border-warning mt-3">
                    <div class="card-header"><strong class="text-warning">Dispute under review</strong></div>
                    <div class="card-body">
                        <dl class="row mb-3">
                            <dt class="col-sm-4">Opened at</dt>
                            <dd class="col-sm-8">@(Model.DisputedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
                            <dt class="col-sm-4">Reason</dt>
                            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.DisputeReason) ? "—" : Model.DisputeReason)</dd>
                        </dl>
                        <permission require="@WebPermission.BookingDispute.Resolve">
                            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#resolveDisputeModal">
                                Resolve dispute
                            </button>
                        </permission>
                    </div>
                </div>
            }
            else if (Model.IsResolved)
            {
                <div class="card border mt-3">
                    <div class="card-header"><strong class="text-primary">Dispute resolution</strong></div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Resolved at</dt>
                            <dd class="col-sm-8">@(Model.ResolvedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
                            <dt class="col-sm-4">Notes</dt>
                            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.ResolutionNotes) ? "—" : Model.ResolutionNotes)</dd>
                        </dl>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-5">
            <div class="card border">
                <div class="card-header"><strong>Pricing</strong></div>
                <div class="card-body">
                    @if (Model.LineItems.Count > 0)
                    {
                        <table class="table table-sm mb-3">
                            <thead><tr><th>Tier</th><th class="text-end">Qty</th><th class="text-end">Unit</th></tr></thead>
                            <tbody>
                                @foreach (var li in Model.LineItems)
                                {
                                    <tr>
                                        <td>@li.TierType</td>
                                        <td class="text-end">@li.Count</td>
                                        <td class="text-end">@li.UnitPrice.ToString("0.##") @li.Currency</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    <div class="d-flex justify-content-between"><span>Subtotal</span><span>@Money(Model.Subtotal)</span></div>
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between text-success"><span>Discount</span><span>-@Money(Model.DiscountAmount)</span></div>
                    }
                    <hr class="my-2" />
                    <div class="d-flex justify-content-between fw-bold"><span>Total</span><span>@Money(Model.TotalAmount)</span></div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.IsDisputed)
{
    <permission require="@WebPermission.BookingDispute.Resolve">
        <div class="modal fade" id="resolveDisputeModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <form method="post" asp-area="Admin" asp-controller="Bookings" asp-action="ResolveDispute" asp-route-id="@Model.Id" class="modal-content">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">Resolve dispute — @Model.Reference</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label" for="resolutionNotes">Resolution notes</label>
                            <textarea class="form-control" id="resolutionNotes" name="resolutionNotes" rows="4"
                                      minlength="10" maxlength="2000" required
                                      placeholder="Explain the outcome (at least 10 characters)…"></textarea>
                        </div>

                        @* FE-1A-3: optional refund — gated by Refund.Create. *@
                        <permission require="@WebPermission.Refund.Create">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="issueRefund" name="issueRefund" value="true"
                                       data-bs-toggle="collapse" data-bs-target="#refundFields" aria-expanded="false" aria-controls="refundFields" />
                                <label class="form-check-label" for="issueRefund">Also issue a refund</label>
                            </div>
                            <div class="collapse border rounded p-3 bg-light" id="refundFields">
                                <p class="small text-muted mb-2">
                                    The refund is a separate step. If it fails after the dispute is resolved,
                                    you'll be told to retry it manually — the dispute stays resolved.
                                </p>
                                <div class="mb-2">
                                    <label class="form-label" for="paymentId">Payment ID</label>
                                    <input type="text" class="form-control" id="paymentId" name="paymentId" placeholder="GUID of the payment to refund" />
                                </div>
                                <div class="row g-2">
                                    <div class="col-8">
                                        <label class="form-label" for="refundAmount">Amount</label>
                                        <input type="number" step="0.01" min="0.01" class="form-control" id="refundAmount" name="refundAmount"
                                               value="@Model.TotalAmount.ToString("0.##")" />
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label" for="refundCurrency">Currency</label>
                                        <input type="text" class="form-control" id="refundCurrency" name="refundCurrency" value="@Model.Currency" readonly />
                                    </div>
                                </div>
                            </div>
                        </permission>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Resolve dispute</button>
                    </div>
                </form>
            </div>
        </div>
    </permission>
}
