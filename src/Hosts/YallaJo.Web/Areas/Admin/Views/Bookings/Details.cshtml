@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.Bookings
@using YallaJo.Web.Infrastructure.Authorization
@model AdminBookingDetailsVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.BookingDetails.Title"].Value;
    ViewData["AdminNav"] = "Bookings";

    var culture = CultureInfo.CurrentCulture;
    string Money(decimal amount, string? currency = null) =>
        $"{amount.ToString("N2", culture)} {(string.IsNullOrWhiteSpace(currency) ? Model.Currency : currency)}";
    string Date(DateTime value) => value.ToString("yyyy-MM-dd HH:mm", culture);
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.BookingDetails.Heading"] <bdi dir="ltr" class="font-data">@Model.Reference</bdi></h1>
        <span class="badge @Model.StatusBadgeClass">
            <i class="fa-solid fa-@(AdminBookingsMapper.StatusIcon(Model.Status)) fa-fw" aria-hidden="true"></i>
            @Localizer["Admin.Bookings.Status." + Model.Status]
        </span>
    </div>
    <a asp-area="Admin" asp-controller="Bookings" asp-action="Index" class="btn btn-outline-secondary align-self-start">@Localizer["Admin.BookingDetails.Back"]</a>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <section class="card shadow mb-4" aria-labelledby="overview-heading">
            <div class="card-header border-bottom">
                <h2 class="card-header-title h5 mb-0" id="overview-heading">@Localizer["Admin.BookingDetails.OverviewHeading"]</h2>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">@Localizer["Admin.BookingDetails.TourLabel"]</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.TourName</dd>

                    <dt class="col-sm-4">@Localizer["Admin.BookingDetails.TravelerLabel"]</dt>
                    <dd class="col-sm-8">@Model.TravelerHandle</dd>

                    <dt class="col-sm-4">@Localizer["Admin.BookingDetails.GuestsLabel"]</dt>
                    <dd class="col-sm-8"><bdi class="font-data">@Model.ParticipantCount.ToString("N0", culture)</bdi></dd>

                    <dt class="col-sm-4">@Localizer["Admin.BookingDetails.InstantLabel"]</dt>
                    <dd class="col-sm-8">@(Model.IsInstantBooking ? Localizer["Admin.BookingDetails.Yes"] : Localizer["Admin.BookingDetails.No"])</dd>

                    <dt class="col-sm-4">@Localizer["Admin.BookingDetails.SpecialRequestsLabel"]</dt>
                    <dd class="col-sm-8">
                        @if (string.IsNullOrWhiteSpace(Model.SpecialRequests))
                        {
                            <span class="text-secondary">—</span>
                        }
                        else
                        {
                            @Model.SpecialRequests
                        }
                    </dd>

                    <dt class="col-sm-4">@Localizer["Admin.BookingDetails.CreatedLabel"]</dt>
                    <dd class="col-sm-8"><bdi class="font-data" dir="ltr">@Date(Model.CreatedAt)</bdi></dd>

                    <dt class="col-sm-4">@Localizer["Admin.BookingDetails.PaymentExpiresLabel"]</dt>
                    <dd class="col-sm-8">
                        @if (Model.PaymentExpiresAt is { } pe)
                        {
                            <bdi class="font-data" dir="ltr">@Date(pe)</bdi>
                        }
                        else
                        {
                            <span class="text-secondary">—</span>
                        }
                    </dd>

                    <dt class="col-sm-4">@Localizer["Admin.BookingDetails.UpdatedLabel"]</dt>
                    <dd class="col-sm-8">
                        @if (Model.UpdatedAt is { } up)
                        {
                            <bdi class="font-data" dir="ltr">@Date(up)</bdi>
                        }
                        else
                        {
                            <span class="text-secondary">—</span>
                        }
                    </dd>
                </dl>
            </div>
        </section>

        @if (Model.IsCancelled)
        {
            <section class="card shadow mb-4" aria-labelledby="cancellation-heading">
                <div class="card-header border-bottom">
                    <h2 class="card-header-title h5 mb-0" id="cancellation-heading">@Localizer["Admin.BookingDetails.CancellationHeading"]</h2>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">@Localizer["Admin.BookingDetails.CancelledAtLabel"]</dt>
                        <dd class="col-sm-8">
                            @if (Model.CancelledAt is { } ca)
                            {
                                <bdi class="font-data" dir="ltr">@Date(ca)</bdi>
                            }
                            else
                            {
                                <span class="text-secondary">—</span>
                            }
                        </dd>
                        <dt class="col-sm-4">@Localizer["Admin.BookingDetails.CancellationReasonLabel"]</dt>
                        <dd class="col-sm-8">
                            @if (string.IsNullOrWhiteSpace(Model.CancellationReason))
                            {
                                <span class="text-secondary">—</span>
                            }
                            else
                            {
                                @Model.CancellationReason
                            }
                        </dd>
                        <dt class="col-sm-4">@Localizer["Admin.BookingDetails.RefundAmountLabel"]</dt>
                        <dd class="col-sm-8">
                            @if (Model.RefundAmount is { } ra)
                            {
                                <bdi class="font-data" dir="ltr">@Money(ra)</bdi>
                            }
                            else
                            {
                                <span class="text-secondary">—</span>
                            }
                        </dd>
                    </dl>
                </div>
            </section>
        }

        @if (Model.IsDisputed)
        {
            <section class="card shadow border-warning mb-4" aria-labelledby="dispute-heading">
                <div class="card-header border-bottom">
                    <h2 class="card-header-title h5 mb-0 text-warning" id="dispute-heading">@Localizer["Admin.BookingDetails.DisputeHeading"]</h2>
                </div>
                <div class="card-body">
                    <dl class="row mb-3">
                        <dt class="col-sm-4">@Localizer["Admin.BookingDetails.DisputedAtLabel"]</dt>
                        <dd class="col-sm-8">
                            @if (Model.DisputedAt is { } da)
                            {
                                <bdi class="font-data" dir="ltr">@Date(da)</bdi>
                            }
                            else
                            {
                                <span class="text-secondary">—</span>
                            }
                        </dd>
                        <dt class="col-sm-4">@Localizer["Admin.BookingDetails.DisputeReasonLabel"]</dt>
                        <dd class="col-sm-8">
                            @if (string.IsNullOrWhiteSpace(Model.DisputeReason))
                            {
                                <span class="text-secondary">—</span>
                            }
                            else
                            {
                                @Model.DisputeReason
                            }
                        </dd>
                    </dl>
                    <permission require="@WebPermission.BookingDispute.Resolve">
                        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#resolveDisputeModal">
                            <i class="fa-solid fa-gavel fa-fw" aria-hidden="true"></i> @Localizer["Admin.BookingDetails.ResolveDispute"]
                        </button>
                    </permission>
                </div>
            </section>
        }
        else if (Model.IsResolved)
        {
            <section class="card shadow mb-4" aria-labelledby="resolution-heading">
                <div class="card-header border-bottom">
                    <h2 class="card-header-title h5 mb-0 text-primary" id="resolution-heading">@Localizer["Admin.BookingDetails.ResolutionHeading"]</h2>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">@Localizer["Admin.BookingDetails.ResolvedAtLabel"]</dt>
                        <dd class="col-sm-8">
                            @if (Model.ResolvedAt is { } resAt)
                            {
                                <bdi class="font-data" dir="ltr">@Date(resAt)</bdi>
                            }
                            else
                            {
                                <span class="text-secondary">—</span>
                            }
                        </dd>
                        <dt class="col-sm-4">@Localizer["Admin.BookingDetails.ResolutionNotesLabel"]</dt>
                        <dd class="col-sm-8">
                            @if (string.IsNullOrWhiteSpace(Model.ResolutionNotes))
                            {
                                <span class="text-secondary">—</span>
                            }
                            else
                            {
                                @Model.ResolutionNotes
                            }
                        </dd>
                    </dl>
                </div>
            </section>
        }
    </div>

    <div class="col-lg-5">
        <section class="card shadow" aria-labelledby="pricing-heading">
            <div class="card-header border-bottom">
                <h2 class="card-header-title h5 mb-0" id="pricing-heading">@Localizer["Admin.BookingDetails.PricingHeading"]</h2>
            </div>
            <div class="card-body">
                @if (Model.LineItems.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-3">
                            <thead>
                                <tr>
                                    <th scope="col">@Localizer["Admin.BookingDetails.ColTier"]</th>
                                    <th scope="col" class="text-end">@Localizer["Admin.BookingDetails.ColQty"]</th>
                                    <th scope="col" class="text-end">@Localizer["Admin.BookingDetails.ColUnitPrice"]</th>
                                    <th scope="col" class="text-end">@Localizer["Admin.BookingDetails.ColLineTotal"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var li in Model.LineItems)
                                {
                                    <tr>
                                        <td>@li.TierType</td>
                                        <td class="text-end"><bdi class="font-data">@li.Count.ToString("N0", culture)</bdi></td>
                                        <td class="text-end"><bdi class="font-data" dir="ltr">@Money(li.UnitPrice, li.Currency)</bdi></td>
                                        <td class="text-end"><bdi class="font-data" dir="ltr">@Money(li.UnitPrice * li.Count, li.Currency)</bdi></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <div class="d-flex justify-content-between">
                    <span>@Localizer["Admin.BookingDetails.SubtotalLabel"]</span>
                    <bdi class="font-data" dir="ltr">@Money(Model.Subtotal)</bdi>
                </div>
                @if (Model.DiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between text-success">
                        <span>@Localizer["Admin.BookingDetails.DiscountLabel"]</span>
                        <bdi class="font-data" dir="ltr">-@Money(Model.DiscountAmount)</bdi>
                    </div>
                }
                <hr class="my-2" />
                <div class="d-flex justify-content-between fw-bold">
                    <span>@Localizer["Admin.BookingDetails.TotalLabel"]</span>
                    <bdi class="font-data" dir="ltr">@Money(Model.TotalAmount)</bdi>
                </div>
            </div>
        </section>
    </div>
</div>

@if (Model.IsDisputed)
{
    <permission require="@WebPermission.BookingDispute.Resolve">
        <div class="modal fade" id="resolveDisputeModal" tabindex="-1"
             aria-labelledby="resolveDisputeTitle" aria-describedby="resolveDisputeBody" aria-hidden="true"
             data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <form method="post" asp-area="Admin" asp-controller="Bookings" asp-action="ResolveDispute" asp-route-id="@Model.Id"
                      class="modal-content" role="dialog" aria-modal="true" aria-labelledby="resolveDisputeTitle">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="resolveDisputeTitle">@Localizer["Admin.BookingDetails.ResolveModalTitle", Model.Reference]</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Admin.BookingDetails.Close"]"></button>
                    </div>
                    <div class="modal-body" id="resolveDisputeBody">
                        <div class="mb-3">
                            <label class="form-label" for="resolutionNotes">@Localizer["Admin.BookingDetails.ResolutionNotesFieldLabel"]</label>
                            <textarea class="form-control" id="resolutionNotes" name="resolutionNotes" rows="4"
                                      minlength="10" maxlength="2000" required aria-describedby="resolutionNotes-help"></textarea>
                            <div class="form-text" id="resolutionNotes-help">@Localizer["Admin.BookingDetails.ResolutionNotesHelp"]</div>
                        </div>

                        <permission require="@WebPermission.Refund.Create">
                            @if (Model.HasRefundablePayments)
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="issueRefund" name="issueRefund" value="true"
                                           data-bs-toggle="collapse" data-bs-target="#refundFields" aria-expanded="false" aria-controls="refundFields" />
                                    <label class="form-check-label" for="issueRefund">@Localizer["Admin.BookingDetails.IssueRefundLabel"]</label>
                                </div>
                                <div class="collapse border rounded p-3" id="refundFields">
                                    <div class="mb-2">
                                        <label class="form-label" for="paymentId">@Localizer["Admin.BookingDetails.PaymentLabel"]</label>
                                        <select class="form-select" id="paymentId" name="paymentId" aria-describedby="paymentId-help">
                                            @foreach (var p in Model.Payments)
                                            {
                                                var optLabel = $"{Money(p.Amount, p.Currency)} · {Localizer["Admin.Bookings.Status." + p.Status].Value} · {Date(p.When)}";
                                                if (p.RefundedTotal > 0)
                                                {
                                                    optLabel += " · " + Localizer["Admin.BookingDetails.AlreadyRefunded", Money(p.RefundedTotal, p.Currency)].Value;
                                                }
                                                <option value="@p.Id">@optLabel</option>
                                            }
                                        </select>
                                        <div class="form-text" id="paymentId-help">@Localizer["Admin.BookingDetails.PaymentHelp"]</div>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-8">
                                            <label class="form-label" for="refundAmount">@Localizer["Admin.BookingDetails.RefundAmountFieldLabel"]</label>
                                            <input type="number" step="0.001" min="0" inputmode="decimal" class="form-control" id="refundAmount" name="refundAmount"
                                                   dir="ltr" value="@Model.TotalAmount.ToString("0.###", CultureInfo.InvariantCulture)" />
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label" for="refundCurrency">@Localizer["Admin.BookingDetails.RefundCurrencyLabel"]</label>
                                            <input type="text" class="form-control" id="refundCurrency" name="refundCurrency" dir="ltr" value="@Model.Currency" readonly />
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <p class="small text-secondary mb-0">
                                    <i class="fa-solid fa-circle-info fa-fw" aria-hidden="true"></i>
                                    @Localizer["Admin.BookingDetails.NoRefundablePayments"]
                                </p>
                            }
                        </permission>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.BookingDetails.Cancel"]</button>
                        <button type="submit" class="btn btn-success">@Localizer["Admin.BookingDetails.ResolveSubmit"]</button>
                    </div>
                </form>
            </div>
        </div>
    </permission>
}
