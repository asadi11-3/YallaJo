@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.GuideApplications
@model GuideApplicationsVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.GuideApplications.Title"].Value;
    ViewData["AdminNav"] = "GuideApplications";

    var culture = CultureInfo.CurrentCulture;
    string Count(int n) => n.ToString("N0", culture);

    var statuses = new[] { "Submitted", "Approved", "Rejected", "Draft" };
    var hasTour = Model.TourId.HasValue && Model.TourId.Value != Guid.Empty;
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.GuideApplications.Title"]</h1>
        <p class="text-secondary mb-0">@Localizer["Admin.GuideApplications.Subtitle"]</p>
    </div>
    @if (hasTour && Model.TotalCount > 0)
    {
        <span class="badge bg-primary bg-opacity-10 text-primary fs-6">
            <bdi class="font-data">@Count(Model.TotalCount)</bdi> @Localizer["Admin.GuideApplications.TotalLabel"]
        </span>
    }
</div>

@* ViewBag.Error renders inside the listing fragment so AJAX fallbacks surface it too. *@

<section class="card shadow mb-4" aria-labelledby="ga-filters-heading">
    <div class="card-header border-bottom">
        <h2 id="ga-filters-heading" class="card-header-title h5 mb-0">@Localizer["Admin.GuideApplications.FiltersHeading"]</h2>
    </div>
    <div class="card-body">
        <form method="get" asp-area="Admin" asp-controller="GuideApplications" asp-action="Index"
              class="row g-3 align-items-end" data-yj-listing>
            <div class="col-md-6 col-lg-5">
                <label for="tourId" class="form-label">@Localizer["Admin.GuideApplications.TourLabel"]</label>
                <select id="tourId" name="tourId" class="form-select" aria-describedby="tourId-help">
                    <option value="">@Localizer["Admin.GuideApplications.ChooseTour"]</option>
                    @foreach (var t in Model.TourOptions)
                    {
                        if (Model.TourId == t.Id)
                        {
                            <option value="@t.Id" selected>@t.Name</option>
                        }
                        else
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    }
                </select>
                <div id="tourId-help" class="form-text">@Localizer["Admin.GuideApplications.TourPlaceholder"]</div>
            </div>
            <div class="col-md-4 col-lg-4">
                <label for="status" class="form-label">@Localizer["Admin.GuideApplications.StatusLabel"]</label>
                <select id="status" name="status" class="form-select">
                    <option value="">@Localizer["Admin.GuideApplications.AllStatuses"]</option>
                    @foreach (var s in statuses)
                    {
                        if (string.Equals(Model.StatusFilter, s, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@s" selected>@Localizer["Admin.GuideApplications.Status." + s]</option>
                        }
                        else
                        {
                            <option value="@s">@Localizer["Admin.GuideApplications.Status." + s]</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2 col-lg-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@Localizer["Admin.GuideApplications.Apply"]</button>
                <a asp-area="Admin" asp-controller="GuideApplications" asp-action="Index" class="btn btn-outline-secondary">@Localizer["Admin.GuideApplications.Reset"]</a>
            </div>
        </form>
    </div>
</section>

<section class="card shadow" aria-labelledby="ga-directory-heading">
    <div class="card-header border-bottom">
        <h2 id="ga-directory-heading" class="card-header-title h5 mb-0">@Localizer["Admin.GuideApplications.Directory"]</h2>
    </div>
    @* S1/L1/A11Y9: listing.js refines this region in place (skeleton, swap, history). *@
    <div id="listingResults" data-yj-component="listing" aria-live="polite" aria-busy="false"
         data-error-text="@Localizer["Public.Results.Error"]"
         data-retry-text="@Localizer["Public.Retry"]"
         data-loading-text="@Localizer["Public.Loading"]">
        <partial name="_GuideApplicationsResults" model="Model" />
    </div>
</section>

@section Scripts {
    <script src="~/assets/js/listing.js" asp-append-version="true" defer></script>
}
