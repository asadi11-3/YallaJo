@using YallaJo.Web.Areas.Admin.Models.GuideApplications
@using YallaJo.Web.Infrastructure.Authorization
@model GuideApplicationsVm
@{
    ViewData["Title"] = "Guide applications";
    ViewData["AdminNav"] = "GuideApplications";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Guide applications</h1>
        <p class="text-body-secondary mb-0">Review and moderate tour-guide applications for a specific tour.</p>
    </div>
    @if (Model.TourId is not null)
    {
        <span class="badge bg-secondary bg-opacity-10 text-secondary fs-6">
            <span class="font-data">@Model.TotalCount</span> total
        </span>
    }
</div>

<div class="card card-body shadow mb-4">
    <form method="get" asp-area="Admin" asp-controller="GuideApplications" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-5">
            <label for="tourId" class="form-label">Tour ID</label>
            <input type="text" class="form-control font-data" id="tourId" name="tourId"
                   value="@(Model.TourId?.ToString("D"))" placeholder="00000000-0000-0000-0000-000000000000" />
        </div>
        <div class="col-md-3">
            <label for="status" class="form-label">Status</label>
            <select class="form-select" id="status" name="status">
                <option value="">All</option>
                <option value="Submitted" selected="@(Model.StatusFilter == "Submitted")">Submitted</option>
                <option value="Approved" selected="@(Model.StatusFilter == "Approved")">Approved</option>
                <option value="Rejected" selected="@(Model.StatusFilter == "Rejected")">Rejected</option>
                <option value="Draft" selected="@(Model.StatusFilter == "Draft")">Draft</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Apply</button>
            <a asp-area="Admin" asp-controller="GuideApplications" asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

@if (Model.Applications.Count > 0)
{
    <div class="card shadow">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Application</th>
                        <th scope="col">Tour</th>
                        <th scope="col">Guide user</th>
                        <th scope="col">Proposed price</th>
                        <th scope="col">Resubmissions</th>
                        <th scope="col">Created</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Applications)
                    {
                        var color = GuideApplicationsMapper.StatusColor(row.Status);
                        <tr>
                            <td class="font-data text-truncate" style="max-width: 9rem;" title="@row.ApplicationId">@row.ApplicationId</td>
                            <td>@(string.IsNullOrWhiteSpace(row.TourTitle) ? "—" : row.TourTitle)</td>
                            <td class="font-data text-truncate" style="max-width: 9rem;" title="@row.GuideUserId">@row.GuideUserId</td>
                            <td class="font-data">@(row.ProposedBasePrice?.ToString("N2") ?? "—")</td>
                            <td class="font-data">@row.ResubmissionCount</td>
                            <td class="font-data">@row.CreatedAt.ToString("g")</td>
                            <td><span class="badge bg-@color bg-opacity-10 text-@color">@row.Status</span></td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <permission require="@WebPermission.GuideApplication.Approve">
                                        <form method="post" asp-area="Admin" asp-controller="GuideApplications" asp-action="Approve"
                                              asp-route-tourId="@row.TourId" asp-route-id="@row.ApplicationId" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                        </form>
                                    </permission>
                                    <permission require="@WebPermission.GuideApplication.Reject">
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                data-bs-toggle="modal" data-bs-target="#rejectModal-@row.ApplicationId">
                                            Reject
                                        </button>
                                        <div class="modal fade" id="rejectModal-@row.ApplicationId" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form method="post" asp-area="Admin" asp-controller="GuideApplications" asp-action="Reject"
                                                          asp-route-tourId="@row.TourId" asp-route-id="@row.ApplicationId">
                                                        @Html.AntiForgeryToken()
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Reject guide application</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body text-start">
                                                            <label for="reason-@row.ApplicationId" class="form-label">Rejection reason</label>
                                                            <textarea class="form-control" id="reason-@row.ApplicationId" name="reason" rows="3" required></textarea>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-danger">Reject application</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </permission>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Guide applications pagination">
        <span class="text-body-secondary small">
            Page <span class="font-data">@Model.Page</span>
        </span>
        <div class="btn-group">
            @if (Model.HasPrevious)
            {
                <a class="btn btn-outline-secondary btn-sm"
                   asp-area="Admin" asp-controller="GuideApplications" asp-action="Index"
                   asp-route-tourId="@Model.TourId" asp-route-status="@Model.StatusFilter" asp-route-page="@(Model.Page - 1)">Previous</a>
            }
            @if (Model.HasNext)
            {
                <a class="btn btn-outline-secondary btn-sm"
                   asp-area="Admin" asp-controller="GuideApplications" asp-action="Index"
                   asp-route-tourId="@Model.TourId" asp-route-status="@Model.StatusFilter" asp-route-page="@(Model.Page + 1)">Next</a>
            }
        </div>
    </nav>
}
else
{
    <div class="card card-body shadow text-center py-5">
        <img src="~/assets/images/element/17.svg" alt="" class="mx-auto mb-3" style="height: 80px;" />
        <p class="text-body-secondary mb-0">
            @(Model.TourId is null
                ? "Enter a tour ID above to view its guide applications."
                : "No guide applications found for this tour.")
        </p>
    </div>
}
