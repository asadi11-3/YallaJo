@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.Support
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Shared
@model SupportTicketDetailVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.SupportDetails.Title"].Value;
    ViewData["AdminNav"] = "Support";
    var culture = CultureInfo.CurrentCulture;
    string Date(DateTime dt) => dt.ToString("yyyy-MM-dd HH:mm", culture);
    var canAct = !Model.IsClosed;
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Model.Subject</h1>
        <p class="text-secondary mb-0">
            <span class="badge bg-@SupportMapper.StatusColor(Model.Status) bg-opacity-10 text-@SupportMapper.StatusColor(Model.Status)">
                <i class="fa-solid fa-@(SupportMapper.StatusIcon(Model.Status)) fa-fw" aria-hidden="true"></i>
                @Localizer["Admin.Support.Status." + Model.Status]
            </span>
        </p>
    </div>
    <a asp-area="Admin" asp-controller="Support" asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left fa-fw" aria-hidden="true"></i> @Localizer["Admin.SupportDetails.Back"]
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <section class="card shadow mb-4" aria-labelledby="conversation-heading">
            <div class="card-header border-bottom">
                <h2 id="conversation-heading" class="card-header-title h5 mb-0">@Localizer["Admin.SupportDetails.Conversation"]</h2>
            </div>
            <div class="card-body">
                @if (Model.Messages.Count == 0)
                {
                    <p class="text-secondary mb-0">@Localizer["Admin.SupportDetails.NoMessages"]</p>
                }
                else
                {
                    @foreach (var m in Model.Messages)
                    {
                        <div class="border rounded p-3 mb-3 @(m.IsInternal ? "bg-warning bg-opacity-10" : "")">
                            <div class="d-flex justify-content-between small text-secondary mb-1">
                                @if (!string.IsNullOrWhiteSpace(m.AuthorEmail))
                                {
                                    <span class="fw-semibold"><bdi dir="ltr">@m.AuthorEmail</bdi></span>
                                }
                                else
                                {
                                    <span>@Localizer["Admin.SupportDetails.UnknownAuthor"]</span>
                                }
                                <bdi dir="ltr" class="font-data">@Date(m.CreatedAt)</bdi>
                            </div>
                            @if (m.IsInternal)
                            {
                                <span class="badge bg-warning bg-opacity-10 text-warning mb-2">
                                    <i class="fa-solid fa-lock fa-fw" aria-hidden="true"></i> @Localizer["Admin.SupportDetails.InternalNote"]
                                </span>
                            }
                            <div>@m.Body</div>
                        </div>
                    }
                }
            </div>
            @if (canAct)
            {
                <div class="card-footer border-top">
                    <form method="post" asp-area="Admin" asp-controller="Support" asp-action="Reply" asp-route-id="@Model.Id">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <label class="form-label" for="body">@Localizer["Admin.SupportDetails.ReplyLabel"]</label>
                            <textarea class="form-control" id="body" name="body" rows="3" required aria-describedby="body-help"></textarea>
                            <div class="form-text" id="body-help">@Localizer["Admin.SupportDetails.ReplyHelp"]</div>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="isInternal" name="isInternal" value="true" />
                            <label class="form-check-label" for="isInternal">@Localizer["Admin.SupportDetails.InternalCheck"]</label>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-paper-plane fa-fw" aria-hidden="true"></i> @Localizer["Admin.SupportDetails.PostReply"]
                        </button>
                    </form>
                </div>
            }
        </section>
    </div>

    <div class="col-lg-4">
        <section class="card shadow mb-4" aria-labelledby="details-heading">
            <div class="card-header border-bottom">
                <h2 id="details-heading" class="card-header-title h5 mb-0">@Localizer["Admin.SupportDetails.DetailsHeading"]</h2>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">@Localizer["Admin.SupportDetails.CategoryLabel"]</dt>
                    <dd class="col-7">@Localizer["Admin.Support.Category." + Model.Category]</dd>
                    <dt class="col-5">@Localizer["Admin.SupportDetails.PriorityLabel"]</dt>
                    <dd class="col-7">@Model.Priority</dd>
                    <dt class="col-5">@Localizer["Admin.SupportDetails.RequesterLabel"]</dt>
                    <dd class="col-7">
                        @if (!string.IsNullOrWhiteSpace(Model.RequesterEmail))
                        {
                            <bdi dir="ltr">@Model.RequesterEmail</bdi>
                        }
                        else
                        {
                            <span class="text-secondary">@Localizer["Admin.Support.UnknownRequester"]</span>
                        }
                    </dd>
                    <dt class="col-5">@Localizer["Admin.SupportDetails.AssignedLabel"]</dt>
                    <dd class="col-7">
                        @if (!string.IsNullOrWhiteSpace(Model.AssigneeEmail))
                        {
                            <bdi dir="ltr">@Model.AssigneeEmail</bdi>
                        }
                        else
                        {
                            <span class="text-secondary">@Localizer["Admin.SupportDetails.Unassigned"]</span>
                        }
                    </dd>
                    <dt class="col-5">@Localizer["Admin.SupportDetails.SlaLabel"]</dt>
                    <dd class="col-7"><bdi dir="ltr" class="font-data">@Date(Model.SlaBreachAt)</bdi></dd>
                    <dt class="col-5">@Localizer["Admin.SupportDetails.CreatedLabel"]</dt>
                    <dd class="col-7"><bdi dir="ltr" class="font-data">@Date(Model.CreatedAt)</bdi></dd>
                    @if (!string.IsNullOrWhiteSpace(Model.ResolverEmail))
                    {
                        <dt class="col-5">@Localizer["Admin.SupportDetails.ResolvedByLabel"]</dt>
                        <dd class="col-7"><bdi dir="ltr">@Model.ResolverEmail</bdi></dd>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.ResolutionNotes))
                    {
                        <dt class="col-5">@Localizer["Admin.SupportDetails.ResolutionLabel"]</dt>
                        <dd class="col-7">@Model.ResolutionNotes</dd>
                    }
                </dl>
            </div>
        </section>

        @if (canAct)
        {
            <section class="card shadow" aria-labelledby="actions-heading">
                <div class="card-header border-bottom">
                    <h2 id="actions-heading" class="card-header-title h5 mb-0">@Localizer["Admin.SupportDetails.ActionsHeading"]</h2>
                </div>
                <div class="card-body d-grid gap-3">
                    <permission require="@WebPermission.AdminSupportQueue.Assign">
                        <form method="post" asp-area="Admin" asp-controller="Support" asp-action="Assign" asp-route-id="@Model.Id">
                            @Html.AntiForgeryToken()
                            <label class="form-label" for="adminUserId">@Localizer["Admin.SupportDetails.AssignLabel"]</label>
                            <div class="d-flex gap-2">
                                @if (Model.AdminOptions.Count > 0)
                                {
                                    <select class="form-select" id="adminUserId" name="adminUserId" required aria-describedby="assign-help">
                                        <option value="">@Localizer["Admin.SupportDetails.AssignPlaceholder"]</option>
                                        @foreach (var a in Model.AdminOptions)
                                        {
                                            <option value="@a.Id">@a.Email</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-outline-primary">@Localizer["Admin.SupportDetails.Assign"]</button>
                                }
                                else
                                {
                                    <span class="text-secondary small" id="adminUserId">@Localizer["Admin.SupportDetails.NoAdmins"]</span>
                                }
                            </div>
                            <div class="form-text" id="assign-help">@Localizer["Admin.SupportDetails.AssignHelp"]</div>
                        </form>
                    </permission>
                    <permission require="@WebPermission.AdminSupportQueue.Resolve">
                        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#resolveModal">
                            <i class="fa-solid fa-circle-check fa-fw" aria-hidden="true"></i> @Localizer["Admin.SupportDetails.Resolve"]
                        </button>
                    </permission>
                    <permission require="@WebPermission.SupportTicket.Close">
                        <form method="post" asp-area="Admin" asp-controller="Support" asp-action="Close" asp-route-id="@Model.Id"
                              data-confirm="@Localizer["Admin.SupportDetails.CloseConfirm"]"
                              data-confirm-title="@Localizer["Admin.SupportDetails.CloseTitle"]"
                              data-confirm-action="@Localizer["Admin.SupportDetails.CloseAction"]" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                            <button type="submit" class="btn btn-outline-secondary w-100">
                                <i class="fa-solid fa-circle-xmark fa-fw" aria-hidden="true"></i> @Localizer["Admin.SupportDetails.CloseTicket"]
                            </button>
                        </form>
                    </permission>
                </div>
            </section>
        }
    </div>
</div>

@if (canAct)
{
    <permission require="@WebPermission.AdminSupportQueue.Resolve">
        <div class="modal fade" id="resolveModal" tabindex="-1" aria-labelledby="resolveModalTitle" aria-describedby="resolveModalBody" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <form method="post" asp-area="Admin" asp-controller="Support" asp-action="Resolve" asp-route-id="@Model.Id" class="modal-content" role="dialog" aria-modal="true" aria-labelledby="resolveModalTitle">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                    <partial name="Partials/_ModalHeader"
                             model="@(new ModalHeaderVm { TitleId = "resolveModalTitle", Title = Localizer["Admin.SupportDetails.ResolveTitle"].Value, CloseLabel = Localizer["Admin.SupportDetails.Close"].Value })" />
                    <div class="modal-body" id="resolveModalBody">
                        <label class="form-label" for="notes">@Localizer["Admin.SupportDetails.NotesLabel"]</label>
                        <textarea class="form-control" id="notes" name="notes" rows="3" maxlength="1000" aria-describedby="notes-help"></textarea>
                        <div class="form-text" id="notes-help">@Localizer["Admin.SupportDetails.NotesHelp"]</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.SupportDetails.Cancel"]</button>
                        <button type="submit" class="btn btn-success">@Localizer["Admin.SupportDetails.ResolveSubmit"]</button>
                    </div>
                </form>
            </div>
        </div>
    </permission>
}
