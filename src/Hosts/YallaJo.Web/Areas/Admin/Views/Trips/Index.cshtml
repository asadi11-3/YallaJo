@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.Trips
@using YallaJo.Web.Infrastructure.Authorization
@model TripsVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Trips.Title"].Value;
    ViewData["AdminNav"] = "Tours";

    var culture = CultureInfo.CurrentCulture;
    var detail = Model.Detail;

    string Count(int n) => n.ToString("N0", culture);
    string Rating(decimal r) => r.ToString("N1", culture);
    string Money(decimal amount, string? currency) =>
        string.IsNullOrWhiteSpace(currency) ? amount.ToString("N2", culture) : $"{amount.ToString("N2", culture)} {currency}";
    string Date(DateTime d) => d.ToString("yyyy-MM-dd HH:mm", culture);
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Trips.Title"]</h1>
        <p class="text-secondary mb-0">@Localizer["Admin.Trips.Subtitle"]</p>
    </div>
</div>

@if (detail is not null)
{
    var color = TripsMapper.StatusColor(detail.StatusName);
    var icon = TripsMapper.StatusIcon(detail.StatusName);
    var canModerate = !string.IsNullOrEmpty(detail.RowVersionBase64);
    var rejectTitleId = "reject-modal-title";
    var rejectDescId = "reject-modal-desc";
    var suspendTitleId = "suspend-modal-title";
    var suspendDescId = "suspend-modal-desc";

    <section class="card shadow mb-4" aria-labelledby="trip-review-heading">
        <div class="card-header border-bottom d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div>
                <h2 id="trip-review-heading" class="card-header-title h5 mb-1">@detail.Name</h2>
                @if (!string.IsNullOrWhiteSpace(detail.ShortDescription))
                {
                    <p class="text-secondary small mb-0">@detail.ShortDescription</p>
                }
            </div>
            <span class="badge bg-@color bg-opacity-10 text-@color">
                <i class="fa-solid fa-@icon fa-fw" aria-hidden="true"></i> @detail.StatusName
            </span>
        </div>

        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">@Localizer["Admin.Trips.BasePrice"]</dt>
                <dd class="col-sm-3"><bdi class="font-data" dir="ltr">@Money(detail.BasePrice, detail.Currency)</bdi></dd>
                <dt class="col-sm-3">@Localizer["Admin.Trips.Created"]</dt>
                <dd class="col-sm-3"><bdi class="font-data" dir="ltr">@Date(detail.CreatedAt)</bdi></dd>

                <dt class="col-sm-3">@Localizer["Admin.Trips.Rating"]</dt>
                <dd class="col-sm-3">
                    <bdi class="font-data" dir="ltr">@Rating(detail.AverageRating)</bdi>
                    <span class="text-secondary small">(@Localizer["Admin.Trips.ReviewsCount", Count(detail.ReviewCount)])</span>
                </dd>
                <dt class="col-sm-3">@Localizer["Admin.Trips.Duration"]</dt>
                <dd class="col-sm-3">@Localizer["Admin.Trips.Minutes", Count(detail.DurationMinutes)]</dd>

                <dt class="col-sm-3">@Localizer["Admin.Trips.MaxGroup"]</dt>
                <dd class="col-sm-3"><bdi class="font-data" dir="ltr">@Count(detail.MaxGroupSize)</bdi></dd>
                <dt class="col-sm-3">@Localizer["Admin.Trips.Bookings"]</dt>
                <dd class="col-sm-3"><bdi class="font-data" dir="ltr">@Count(detail.BookingCount)</bdi></dd>
            </dl>

            @if (!canModerate)
            {
                <div class="alert alert-warning mt-3 mb-0" role="alert">@Localizer["Admin.Trips.ReloadToModerate"]</div>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <permission require="@WebPermission.Tour.Approve">
                        <form method="post" asp-area="Admin" asp-controller="Trips" asp-action="Approve" asp-route-id="@detail.Id"
                              data-confirm="@Localizer["Admin.Trips.ApproveConfirm", detail.Name]"
                              data-confirm-title="@Localizer["Admin.Trips.ApproveTitle"]"
                              data-confirm-action="@Localizer["Admin.Trips.Approve"]" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="rowVersion" value="@detail.RowVersionBase64" />
                            <button type="submit" class="btn btn-success">
                                <i class="fa-solid fa-circle-check fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Trips.Approve"]
                            </button>
                        </form>
                    </permission>
                    <permission require="@WebPermission.Tour.Reinstate">
                        <form method="post" asp-area="Admin" asp-controller="Trips" asp-action="Reinstate" asp-route-id="@detail.Id"
                              data-confirm="@Localizer["Admin.Trips.ReinstateConfirm", detail.Name]"
                              data-confirm-title="@Localizer["Admin.Trips.ReinstateTitle"]"
                              data-confirm-action="@Localizer["Admin.Trips.Reinstate"]" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="rowVersion" value="@detail.RowVersionBase64" />
                            <button type="submit" class="btn btn-info">
                                <i class="fa-solid fa-rotate-left fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Trips.Reinstate"]
                            </button>
                        </form>
                    </permission>
                    <permission require="@WebPermission.Tour.Reject">
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">
                            <i class="fa-solid fa-circle-xmark fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Trips.Reject"]
                        </button>
                    </permission>
                    <permission require="@WebPermission.Tour.Suspend">
                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#suspendModal">
                            <i class="fa-solid fa-circle-pause fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Trips.Suspend"]
                        </button>
                    </permission>
                </div>

                <permission require="@WebPermission.Tour.Reject">
                    <div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="@rejectTitleId"
                         aria-describedby="@rejectDescId" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                        <div class="modal-dialog modal-dialog-centered">
                            <form method="post" asp-area="Admin" asp-controller="Trips" asp-action="Reject" asp-route-id="@detail.Id"
                                  class="modal-content" role="dialog" aria-modal="true" aria-labelledby="@rejectTitleId">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="rowVersion" value="@detail.RowVersionBase64" />
                                <div class="modal-header">
                                    <h2 id="@rejectTitleId" class="modal-title h5">@Localizer["Admin.Trips.RejectTitle"]</h2>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Admin.Trips.Close"]"></button>
                                </div>
                                <div class="modal-body">
                                    <p id="@rejectDescId" class="text-secondary small">@Localizer["Admin.Trips.RejectBody", detail.Name]</p>
                                    <label for="rejectReason" class="form-label">@Localizer["Admin.Trips.ReasonLabel"]</label>
                                    <textarea id="rejectReason" name="reason" class="form-control" rows="3" maxlength="1000"
                                              required aria-describedby="reject-reason-help"></textarea>
                                    <div id="reject-reason-help" class="form-text">@Localizer["Admin.Trips.ReasonHelp"]</div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.Trips.Cancel"]</button>
                                    <button type="submit" class="btn btn-danger">@Localizer["Admin.Trips.RejectSubmit"]</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </permission>

                <permission require="@WebPermission.Tour.Suspend">
                    <div class="modal fade" id="suspendModal" tabindex="-1" aria-labelledby="@suspendTitleId"
                         aria-describedby="@suspendDescId" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                        <div class="modal-dialog modal-dialog-centered">
                            <form method="post" asp-area="Admin" asp-controller="Trips" asp-action="Suspend" asp-route-id="@detail.Id"
                                  class="modal-content" role="dialog" aria-modal="true" aria-labelledby="@suspendTitleId">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="rowVersion" value="@detail.RowVersionBase64" />
                                <div class="modal-header">
                                    <h2 id="@suspendTitleId" class="modal-title h5">@Localizer["Admin.Trips.SuspendTitle"]</h2>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Admin.Trips.Close"]"></button>
                                </div>
                                <div class="modal-body">
                                    <p id="@suspendDescId" class="text-secondary small">@Localizer["Admin.Trips.SuspendBody", detail.Name]</p>
                                    <label for="suspendReason" class="form-label">@Localizer["Admin.Trips.ReasonLabel"]</label>
                                    <textarea id="suspendReason" name="reason" class="form-control" rows="3" maxlength="1000"
                                              required aria-describedby="suspend-reason-help"></textarea>
                                    <div id="suspend-reason-help" class="form-text">@Localizer["Admin.Trips.ReasonHelp"]</div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.Trips.Cancel"]</button>
                                    <button type="submit" class="btn btn-danger">@Localizer["Admin.Trips.SuspendSubmit"]</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </permission>
            }
        </div>
    </section>
}

<section class="card shadow" aria-labelledby="approved-tours-heading">
    <div class="card-header border-bottom">
        <h2 id="approved-tours-heading" class="card-header-title h5 mb-0">@Localizer["Admin.Trips.DirectoryHeading"]</h2>
    </div>
    <div class="card-body">
        @if (Model.Tours.Count == 0)
        {
            <div class="text-center py-5">
                <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
                <p class="mb-0 text-secondary">@Localizer["Admin.Trips.EmptyMessage"]</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">@Localizer["Admin.Trips.ColName"]</th>
                            <th scope="col" class="text-end">@Localizer["Admin.Trips.ColBasePrice"]</th>
                            <th scope="col">@Localizer["Admin.Trips.ColStatus"]</th>
                            <th scope="col" class="text-end">@Localizer["Admin.Trips.ColBookings"]</th>
                            <th scope="col">@Localizer["Admin.Trips.ColCreated"]</th>
                            <th scope="col" class="text-end">@Localizer["Admin.Trips.ColActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tour in Model.Tours)
                        {
                            var rowColor = TripsMapper.StatusColor(tour.Status);
                            var rowIcon = TripsMapper.StatusIcon(tour.Status);
                            <tr>
                                <td><span class="fw-semibold">@tour.Name</span></td>
                                <td class="text-end"><bdi class="font-data" dir="ltr">@Money(tour.BasePrice, tour.Currency)</bdi></td>
                                <td>
                                    <span class="badge bg-@rowColor bg-opacity-10 text-@rowColor">
                                        <i class="fa-solid fa-@rowIcon fa-fw" aria-hidden="true"></i> @tour.Status
                                    </span>
                                </td>
                                <td class="text-end"><bdi class="font-data" dir="ltr">@Count(tour.BookingCount)</bdi></td>
                                <td><bdi class="font-data" dir="ltr">@Date(tour.CreatedAt)</bdi></td>
                                <td class="text-end">
                                    <permission require="@WebPermission.Tour.Approve">
                                        <a asp-area="Admin" asp-controller="Trips" asp-action="Index" asp-route-id="@tour.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fa-solid fa-gavel fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Trips.Review"]
                                        </a>
                                    </permission>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (Model.HasPreviousPage || Model.HasNextPage)
    {
        <div class="card-footer border-top">
            <nav class="d-flex justify-content-between align-items-center" aria-label="@Localizer["Admin.Trips.PaginationLabel"]">
                @if (Model.HasPreviousPage)
                {
                    <a asp-area="Admin" asp-controller="Trips" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)"
                       class="btn btn-sm btn-outline-secondary">
                        <i class="fa-solid fa-chevron-left fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Trips.Previous"]
                    </a>
                }
                else
                {
                    <span></span>
                }
                <span class="text-secondary small">@Localizer["Admin.Trips.PageLabel"] <bdi class="font-data" dir="ltr">@Count(Model.PageNumber)</bdi></span>
                @if (Model.HasNextPage)
                {
                    <a asp-area="Admin" asp-controller="Trips" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)"
                       class="btn btn-sm btn-outline-secondary">
                        @Localizer["Admin.Trips.Next"]<i class="fa-solid fa-chevron-right fa-fw ms-1" aria-hidden="true"></i>
                    </a>
                }
                else
                {
                    <span></span>
                }
            </nav>
        </div>
    }
</section>
