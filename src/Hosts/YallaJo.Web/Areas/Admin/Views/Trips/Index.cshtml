@using YallaJo.Web.Areas.Admin.Models.Trips
@using YallaJo.Web.Infrastructure.Authorization
@model TripsVm
@{
    ViewData["Title"] = "Tour approvals";
    ViewData["AdminNav"] = "Tours";
    var detail = Model.Detail;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h4 mb-1">Tour approvals</h1>
        <p class="text-body-secondary mb-0">Look up a tour by id to review and moderate it.</p>
    </div>
</div>

<div class="card card-body shadow mb-4">
    <form method="get" asp-area="Admin" asp-controller="Trips" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-sm-8 col-md-6">
            <label for="id" class="form-label small fw-bold">Tour id</label>
            <input type="text" id="id" name="id" value="@(Model.LookupId?.ToString("D"))"
                   class="form-control font-data" placeholder="00000000-0000-0000-0000-000000000000" />
        </div>
        <div class="col-sm-4 col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Look up</button>
            <a asp-area="Admin" asp-controller="Trips" asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

@if (detail is not null)
{
    var color = TripsMapper.StatusColor(detail.StatusName);
    var canModerate = !string.IsNullOrEmpty(detail.RowVersionBase64);
    <div class="card card-body shadow mb-4">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h2 class="h5 mb-1">@detail.Name</h2>
                <div class="text-body-secondary small font-data">@detail.Id.ToString("D")</div>
            </div>
            <span class="badge bg-@color bg-opacity-10 text-@color">@detail.StatusName</span>
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-3">Base price</dt>
            <dd class="col-sm-3 font-data">@detail.BasePrice.ToString("N2") @detail.Currency</dd>
            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-3 font-data">@detail.CreatedAt.ToString("g")</dd>

            <dt class="col-sm-3">Rating</dt>
            <dd class="col-sm-3 font-data">@detail.AverageRating.ToString("N1") (@detail.ReviewCount)</dd>
            <dt class="col-sm-3">Duration</dt>
            <dd class="col-sm-3 font-data">@detail.DurationMinutes min</dd>

            <dt class="col-sm-3">Max group</dt>
            <dd class="col-sm-3 font-data">@detail.MaxGroupSize</dd>
            <dt class="col-sm-3">Bookings</dt>
            <dd class="col-sm-3 font-data">@detail.BookingCount</dd>
        </dl>

        @if (!canModerate)
        {
            <div class="alert alert-warning mt-3 mb-0">Reload to moderate this tour.</div>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2 mt-3">
                <permission require="@WebPermission.Tour.Approve">
                    <form method="post" asp-area="Admin" asp-controller="Trips" asp-action="Approve" asp-route-id="@detail.Id">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="rowVersion" value="@detail.RowVersionBase64" />
                        <button type="submit" class="btn btn-success">Approve</button>
                    </form>
                </permission>
                <permission require="@WebPermission.Tour.Reinstate">
                    <form method="post" asp-area="Admin" asp-controller="Trips" asp-action="Reinstate" asp-route-id="@detail.Id">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="rowVersion" value="@detail.RowVersionBase64" />
                        <button type="submit" class="btn btn-info">Reinstate</button>
                    </form>
                </permission>
                <permission require="@WebPermission.Tour.Reject">
                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">Reject</button>
                </permission>
                <permission require="@WebPermission.Tour.Suspend">
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#suspendModal">Suspend</button>
                </permission>
            </div>

            <permission require="@WebPermission.Tour.Reject">
                <div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                        <form method="post" asp-area="Admin" asp-controller="Trips" asp-action="Reject" asp-route-id="@detail.Id" class="modal-content">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="rowVersion" value="@detail.RowVersionBase64" />
                            <div class="modal-header">
                                <h5 class="modal-title">Reject tour</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <label for="rejectReason" class="form-label">Reason</label>
                                <textarea id="rejectReason" name="reason" class="form-control" rows="3" required></textarea>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-danger">Reject tour</button>
                            </div>
                        </form>
                    </div>
                </div>
            </permission>

            <permission require="@WebPermission.Tour.Suspend">
                <div class="modal fade" id="suspendModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                        <form method="post" asp-area="Admin" asp-controller="Trips" asp-action="Suspend" asp-route-id="@detail.Id" class="modal-content">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="rowVersion" value="@detail.RowVersionBase64" />
                            <div class="modal-header">
                                <h5 class="modal-title">Suspend tour</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <label for="suspendReason" class="form-label">Reason</label>
                                <textarea id="suspendReason" name="reason" class="form-control" rows="3" required></textarea>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-danger">Suspend tour</button>
                            </div>
                        </form>
                    </div>
                </div>
            </permission>
        }
    </div>
}

<div class="card card-body shadow">
    <h2 class="h5 mb-3">Approved tours</h2>
    @if (Model.Tours.Count == 0)
    {
        <div class="text-center py-5">
            <img src="~/assets/images/element/17.svg" class="h-80px mb-3" alt="" />
            <p class="text-body-secondary mb-0">No tours to display.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th class="text-end">Base price</th>
                        <th>Status</th>
                        <th class="text-end">Bookings</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tour in Model.Tours)
                    {
                        var rowColor = TripsMapper.StatusColor(tour.Status);
                        <tr>
                            <td class="font-data text-truncate" style="max-width: 140px;">@tour.Id.ToString("D")</td>
                            <td>@tour.Name</td>
                            <td class="text-end font-data">@tour.BasePrice.ToString("N2") @tour.Currency</td>
                            <td><span class="badge bg-@rowColor bg-opacity-10 text-@rowColor">@tour.Status</span></td>
                            <td class="text-end font-data">@tour.BookingCount</td>
                            <td class="font-data">@tour.CreatedAt.ToString("g")</td>
                            <td class="text-end">
                                <a asp-area="Admin" asp-controller="Trips" asp-action="Index" asp-route-id="@tour.Id"
                                   class="btn btn-sm btn-outline-primary">Review</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.HasPreviousPage || Model.HasNextPage)
        {
            <nav class="d-flex justify-content-between mt-3">
                @if (Model.HasPreviousPage)
                {
                    <a asp-area="Admin" asp-controller="Trips" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)"
                       class="btn btn-outline-secondary">Previous</a>
                }
                else
                {
                    <span></span>
                }
                @if (Model.HasNextPage)
                {
                    <a asp-area="Admin" asp-controller="Trips" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)"
                       class="btn btn-outline-secondary">Next</a>
                }
            </nav>
        }
    }
</div>
