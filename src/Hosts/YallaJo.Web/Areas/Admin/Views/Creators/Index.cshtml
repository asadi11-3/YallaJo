@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.Creators
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Shared
@model CreatorsVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Creators.Title"].Value;
    ViewData["AdminNav"] = "Creators";

    var culture = CultureInfo.CurrentCulture;
    string Count(int n) => n.ToString("N0", culture);
    string Date(DateTime dt) => dt.ToString("yyyy-MM-dd HH:mm", culture);

    var statuses = new[] { "Draft", "Pending", "Approved", "Rejected", "MoreInfoNeeded" };
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Creators.Title"]</h1>
        <p class="text-secondary mb-0">@Localizer["Admin.Creators.Subtitle"]</p>
    </div>
    @if (Model.TotalCount > 0)
    {
        <span class="badge bg-primary bg-opacity-10 text-primary fs-6">
            <bdi class="font-data">@Count(Model.TotalCount)</bdi> @Localizer["Admin.Creators.TotalLabel"]
        </span>
    }
</div>

@if (!string.IsNullOrWhiteSpace(ViewBag.Error as string))
{
    <div class="alert alert-danger" role="alert">@ViewBag.Error</div>
}

<section class="card shadow mb-4" aria-labelledby="creators-filters-heading">
    <div class="card-header border-bottom">
        <h2 id="creators-filters-heading" class="card-header-title h5 mb-0">@Localizer["Admin.Creators.FiltersHeading"]</h2>
    </div>
    <div class="card-body">
        <form method="get" asp-area="Admin" asp-controller="Creators" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-sm-6 col-lg-4">
                <label for="status" class="form-label">@Localizer["Admin.Creators.StatusLabel"]</label>
                <select id="status" name="status" class="form-select">
                    <option value="">@Localizer["Admin.Creators.AllStatuses"]</option>
                    @foreach (var s in statuses)
                    {
                        if (string.Equals(Model.StatusFilter, s, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@s" selected>@Localizer["Admin.Creators.Status." + s]</option>
                        }
                        else
                        {
                            <option value="@s">@Localizer["Admin.Creators.Status." + s]</option>
                        }
                    }
                </select>
            </div>
            <div class="col-sm-6 col-lg-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@Localizer["Admin.Creators.Apply"]</button>
                <a asp-area="Admin" asp-controller="Creators" asp-action="Index" class="btn btn-outline-secondary">@Localizer["Admin.Creators.Reset"]</a>
            </div>
        </form>
    </div>
</section>

@if (Model.Detail is { } detail)
{
    var color = CreatorsMapper.StatusColor(detail.Status);
    var icon = CreatorsMapper.StatusIcon(detail.Status);
    var applicant = string.IsNullOrWhiteSpace(detail.ApplicantEmail) ? Localizer["Admin.Creators.UnknownApplicant"].Value : detail.ApplicantEmail;
    <section class="card shadow mb-4" aria-labelledby="creator-detail-heading">
        <div class="card-header border-bottom d-flex justify-content-between align-items-center">
            <h2 id="creator-detail-heading" class="card-header-title h5 mb-0">@Localizer["Admin.Creators.DetailHeading"]</h2>
            <span class="badge bg-@color bg-opacity-10 text-@color">
                <i class="fa-solid fa-@icon fa-fw" aria-hidden="true"></i> @Localizer["Admin.Creators.Status." + detail.Status]
            </span>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">@Localizer["Admin.Creators.Applicant"]</dt>
                <dd class="col-sm-9"><bdi dir="ltr">@applicant</bdi></dd>

                <dt class="col-sm-3">@Localizer["Admin.Creators.Source"]</dt>
                <dd class="col-sm-9">@detail.Source</dd>

                <dt class="col-sm-3">@Localizer["Admin.Creators.Submitted"]</dt>
                <dd class="col-sm-9"><bdi dir="ltr" class="font-data">@Date(detail.CreatedAt)</bdi></dd>

                <dt class="col-sm-3">@Localizer["Admin.Creators.Reapplications"]</dt>
                <dd class="col-sm-9"><bdi class="font-data">@Count(detail.ReapplicationCount)</bdi></dd>

                @if (detail.ReviewedAt is { } reviewed)
                {
                    <dt class="col-sm-3">@Localizer["Admin.Creators.Reviewed"]</dt>
                    <dd class="col-sm-9"><bdi dir="ltr" class="font-data">@Date(reviewed)</bdi></dd>
                }

                @if (!string.IsNullOrWhiteSpace(detail.Bio))
                {
                    <dt class="col-sm-3">@Localizer["Admin.Creators.Bio"]</dt>
                    <dd class="col-sm-9">@detail.Bio</dd>
                }

                @if (detail.PortfolioUrls.Count > 0)
                {
                    <dt class="col-sm-3">@Localizer["Admin.Creators.Portfolio"]</dt>
                    <dd class="col-sm-9">
                        @foreach (var url in detail.PortfolioUrls)
                        {
                            <a href="@url" target="_blank" rel="noopener noreferrer" class="d-block"><bdi dir="ltr">@url</bdi></a>
                        }
                    </dd>
                }

                @if (detail.SampleWorkUrls.Count > 0)
                {
                    <dt class="col-sm-3">@Localizer["Admin.Creators.SampleWork"]</dt>
                    <dd class="col-sm-9">
                        @foreach (var url in detail.SampleWorkUrls)
                        {
                            <a href="@url" target="_blank" rel="noopener noreferrer" class="d-block"><bdi dir="ltr">@url</bdi></a>
                        }
                    </dd>
                }

                @if (detail.FreeTags.Count > 0)
                {
                    <dt class="col-sm-3">@Localizer["Admin.Creators.Tags"]</dt>
                    <dd class="col-sm-9">
                        @foreach (var tag in detail.FreeTags)
                        {
                            <span class="badge bg-secondary bg-opacity-10 text-secondary me-1">@tag</span>
                        }
                    </dd>
                }

                @if (detail.SocialHandles.Count > 0)
                {
                    <dt class="col-sm-3">@Localizer["Admin.Creators.Social"]</dt>
                    <dd class="col-sm-9">
                        @foreach (var pair in detail.SocialHandles)
                        {
                            <div><span class="fw-semibold">@pair.Key:</span> <bdi dir="ltr">@pair.Value</bdi></div>
                        }
                    </dd>
                }

                @if (!string.IsNullOrWhiteSpace(detail.AdminNote))
                {
                    <dt class="col-sm-3">@Localizer["Admin.Creators.AdminNote"]</dt>
                    <dd class="col-sm-9">@detail.AdminNote</dd>
                }
            </dl>

            <hr />

            <div class="d-flex flex-wrap gap-2">
                <permission require="@WebPermission.AdminCreatorQueue.Approve">
                    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#approveModal">
                        <i class="fa-solid fa-circle-check fa-fw" aria-hidden="true"></i> @Localizer["Admin.Creators.Approve"]
                    </button>
                </permission>
                <permission require="@WebPermission.AdminCreatorQueue.Reject">
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">
                        <i class="fa-solid fa-circle-xmark fa-fw" aria-hidden="true"></i> @Localizer["Admin.Creators.Reject"]
                    </button>
                </permission>
                <permission require="@WebPermission.AdminCreatorQueue.RequestMoreInfo">
                    <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#moreInfoModal">
                        <i class="fa-solid fa-circle-question fa-fw" aria-hidden="true"></i> @Localizer["Admin.Creators.RequestInfo"]
                    </button>
                </permission>
                <permission require="@WebPermission.AdminCreatorQueue.Suspend">
                    <button type="button" class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#suspendModal">
                        <i class="fa-solid fa-circle-pause fa-fw" aria-hidden="true"></i> @Localizer["Admin.Creators.Suspend"]
                    </button>
                </permission>
                <permission require="@WebPermission.AdminCreatorQueue.Reinstate">
                    <form method="post" asp-area="Admin" asp-controller="Creators" asp-action="Reinstate" asp-route-id="@detail.Id" class="d-inline"
                          data-confirm="@Localizer["Admin.Creators.ReinstateConfirm"]"
                          data-confirm-title="@Localizer["Admin.Creators.ReinstateTitle"]"
                          data-confirm-action="@Localizer["Admin.Creators.ReinstateAction"]" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-success">
                            <i class="fa-solid fa-circle-play fa-fw" aria-hidden="true"></i> @Localizer["Admin.Creators.Reinstate"]
                        </button>
                    </form>
                </permission>
            </div>
        </div>
    </section>

    <permission require="@WebPermission.AdminCreatorQueue.Approve">
        <div class="modal fade" id="approveModal" tabindex="-1" aria-labelledby="approveModalTitle" aria-describedby="approveModalBody" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <form method="post" asp-area="Admin" asp-controller="Creators" asp-action="Approve" asp-route-id="@detail.Id" class="modal-content" role="dialog" aria-modal="true" aria-labelledby="approveModalTitle">
                    @Html.AntiForgeryToken()
                    <partial name="Partials/_ModalHeader"
                             model="@(new ModalHeaderVm { TitleId = "approveModalTitle", Title = Localizer["Admin.Creators.ApproveTitle"].Value, CloseLabel = Localizer["Admin.Creators.Close"].Value })" />
                    <div class="modal-body" id="approveModalBody">
                        <div class="mb-3">
                            <label for="displayName" class="form-label">@Localizer["Admin.Creators.DisplayNameLabel"]</label>
                            <input id="displayName" name="displayName" class="form-control" required maxlength="100" aria-describedby="displayName-help" />
                            <div id="displayName-help" class="form-text">@Localizer["Admin.Creators.DisplayNameHelp"]</div>
                        </div>
                        <div class="mb-0">
                            <label for="avatarUrl" class="form-label">@Localizer["Admin.Creators.AvatarLabel"]</label>
                            <input id="avatarUrl" name="avatarUrl" class="form-control" type="url" dir="ltr" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.Creators.Cancel"]</button>
                        <button type="submit" class="btn btn-success">@Localizer["Admin.Creators.Approve"]</button>
                    </div>
                </form>
            </div>
        </div>
    </permission>

    <permission require="@WebPermission.AdminCreatorQueue.Reject">
        <div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalTitle" aria-describedby="rejectModalBody" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <form method="post" asp-area="Admin" asp-controller="Creators" asp-action="Reject" asp-route-id="@detail.Id" class="modal-content" role="dialog" aria-modal="true" aria-labelledby="rejectModalTitle">
                    @Html.AntiForgeryToken()
                    <partial name="Partials/_ModalHeader"
                             model="@(new ModalHeaderVm { TitleId = "rejectModalTitle", Title = Localizer["Admin.Creators.RejectTitle"].Value, CloseLabel = Localizer["Admin.Creators.Close"].Value })" />
                    <div class="modal-body" id="rejectModalBody">
                        <label for="rejectReason" class="form-label">@Localizer["Admin.Creators.ReasonLabel"]</label>
                        <textarea id="rejectReason" name="reason" class="form-control" rows="3" maxlength="1000" required aria-describedby="rejectReason-help"></textarea>
                        <div id="rejectReason-help" class="form-text">@Localizer["Admin.Creators.ReasonHelp"]</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.Creators.Cancel"]</button>
                        <button type="submit" class="btn btn-danger">@Localizer["Admin.Creators.Reject"]</button>
                    </div>
                </form>
            </div>
        </div>
    </permission>

    <permission require="@WebPermission.AdminCreatorQueue.RequestMoreInfo">
        <div class="modal fade" id="moreInfoModal" tabindex="-1" aria-labelledby="moreInfoModalTitle" aria-describedby="moreInfoModalBody" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <form method="post" asp-area="Admin" asp-controller="Creators" asp-action="RequestMoreInfo" asp-route-id="@detail.Id" class="modal-content" role="dialog" aria-modal="true" aria-labelledby="moreInfoModalTitle">
                    @Html.AntiForgeryToken()
                    <partial name="Partials/_ModalHeader"
                             model="@(new ModalHeaderVm { TitleId = "moreInfoModalTitle", Title = Localizer["Admin.Creators.RequestInfoTitle"].Value, CloseLabel = Localizer["Admin.Creators.Close"].Value })" />
                    <div class="modal-body" id="moreInfoModalBody">
                        <label for="adminNote" class="form-label">@Localizer["Admin.Creators.NoteLabel"]</label>
                        <textarea id="adminNote" name="adminNote" class="form-control" rows="3" maxlength="1000" required aria-describedby="adminNote-help"></textarea>
                        <div id="adminNote-help" class="form-text">@Localizer["Admin.Creators.NoteHelp"]</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.Creators.Cancel"]</button>
                        <button type="submit" class="btn btn-info">@Localizer["Admin.Creators.SendRequest"]</button>
                    </div>
                </form>
            </div>
        </div>
    </permission>

    <permission require="@WebPermission.AdminCreatorQueue.Suspend">
        <div class="modal fade" id="suspendModal" tabindex="-1" aria-labelledby="suspendModalTitle" aria-describedby="suspendModalBody" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <form method="post" asp-area="Admin" asp-controller="Creators" asp-action="Suspend" asp-route-id="@detail.Id" class="modal-content" role="dialog" aria-modal="true" aria-labelledby="suspendModalTitle">
                    @Html.AntiForgeryToken()
                    <partial name="Partials/_ModalHeader"
                             model="@(new ModalHeaderVm { TitleId = "suspendModalTitle", Title = Localizer["Admin.Creators.SuspendTitle"].Value, CloseLabel = Localizer["Admin.Creators.Close"].Value })" />
                    <div class="modal-body" id="suspendModalBody">
                        <label for="suspendReason" class="form-label">@Localizer["Admin.Creators.ReasonLabel"]</label>
                        <textarea id="suspendReason" name="reason" class="form-control" rows="3" maxlength="1000" required aria-describedby="suspendReason-help"></textarea>
                        <div id="suspendReason-help" class="form-text">@Localizer["Admin.Creators.ReasonHelp"]</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.Creators.Cancel"]</button>
                        <button type="submit" class="btn btn-warning">@Localizer["Admin.Creators.Suspend"]</button>
                    </div>
                </form>
            </div>
        </div>
    </permission>
}

<section class="card shadow" aria-labelledby="creators-directory-heading">
    <div class="card-header border-bottom">
        <h2 id="creators-directory-heading" class="card-header-title h5 mb-0">@Localizer["Admin.Creators.Directory"]</h2>
    </div>
    @if (Model.Applications.Count == 0)
    {
        <div class="card-body">
            <div class="text-center py-5">
                <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
                <p class="mb-3 text-secondary">@Localizer["Admin.Creators.EmptyMessage"]</p>
                @if (!string.IsNullOrWhiteSpace(Model.StatusFilter))
                {
                    <a asp-area="Admin" asp-controller="Creators" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="fa-solid fa-arrow-rotate-left fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Creators.Reset"]
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["Admin.Creators.ColApplicant"]</th>
                        <th scope="col">@Localizer["Admin.Creators.ColStatus"]</th>
                        <th scope="col">@Localizer["Admin.Creators.ColSource"]</th>
                        <th scope="col" class="text-end">@Localizer["Admin.Creators.ColReapplications"]</th>
                        <th scope="col">@Localizer["Admin.Creators.ColSubmitted"]</th>
                        <th scope="col" class="text-end">@Localizer["Admin.Creators.ColActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Applications)
                    {
                        var rowColor = CreatorsMapper.StatusColor(row.Status);
                        var rowIcon = CreatorsMapper.StatusIcon(row.Status);
                        <tr>
                            <td>
                                @if (string.IsNullOrWhiteSpace(row.ApplicantEmail))
                                {
                                    <span class="text-secondary">@Localizer["Admin.Creators.UnknownApplicant"]</span>
                                }
                                else
                                {
                                    <span class="fw-semibold"><bdi dir="ltr">@row.ApplicantEmail</bdi></span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-@rowColor bg-opacity-10 text-@rowColor">
                                    <i class="fa-solid fa-@rowIcon fa-fw" aria-hidden="true"></i> @Localizer["Admin.Creators.Status." + row.Status]
                                </span>
                            </td>
                            <td>@row.Source</td>
                            <td class="text-end"><bdi class="font-data">@Count(row.ReapplicationCount)</bdi></td>
                            <td><bdi dir="ltr" class="font-data">@Date(row.CreatedAt)</bdi></td>
                            <td class="text-end">
                                <a asp-area="Admin" asp-controller="Creators" asp-action="Index"
                                   asp-route-id="@row.Id" asp-route-status="@Model.StatusFilter"
                                   class="btn btn-sm btn-outline-primary">@Localizer["Admin.Creators.Review"]</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.HasPreviousPage || Model.HasNextPage)
        {
            <partial name="Partials/_PaginationFooter"
                     model="@(new PaginationFooterVm
                     {
                         HasPrevious = Model.HasPreviousPage,
                         HasNext = Model.HasNextPage,
                         Page = Model.PageNumber,
                         PreviousUrl = Url.Action("Index", "Creators", new { area = "Admin", page = Model.PageNumber - 1, status = Model.StatusFilter }),
                         NextUrl = Url.Action("Index", "Creators", new { area = "Admin", page = Model.PageNumber + 1, status = Model.StatusFilter }),
                         PreviousText = Localizer["Admin.Creators.Previous"].Value,
                         NextText = Localizer["Admin.Creators.Next"].Value,
                         PageLabel = Localizer["Admin.Creators.PageLabel"].Value
                     })" />
        }
    }
</section>
