@model YallaJo.Web.Areas.Admin.Models.Payments.PaymentsVm
@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.Payments
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Shared
@inject YallaJo.Web.Infrastructure.Identity.ICurrentUser CurrentUser
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@*
    Swappable listing fragment (S1/PE1): served whole-page inside Payments/Index and
    standalone for listing.js fetches (WantsAjax). Keep all row markup + refund modals here.
*@
@{
    var culture = CultureInfo.CurrentCulture;
    var canRefund = CurrentUser.HasPermission(WebPermission.Refund.Create);
    var hasFilters = !string.IsNullOrWhiteSpace(Model.StatusFilter) || !string.IsNullOrWhiteSpace(Model.TypeFilter);

    string Money(decimal amount, string? currency)
        => amount.ToString("N3", culture) + " " + (string.IsNullOrWhiteSpace(currency) ? Model.Currency : currency);
    string Date(DateTime dt) => dt.ToString("yyyy-MM-dd HH:mm", culture);

    // §8.7 — a payment is refundable when it has settled and still has a refundable balance.
    bool IsRefundable(PaymentRowVm p)
    {
        var status = p.Status?.Trim().ToLowerInvariant();
        var settled = status is "succeeded" or "completed" or "captured" or "partiallyrefunded" or "partially refunded";
        return settled && p.Amount - p.RefundedTotal > 0m;
    }
}
@if (ViewBag.Error is string vbe)
{
    <div class="alert alert-danger m-3 mb-0" role="alert">@vbe</div>
}
<div class="card-body">
    @if (Model.Payments.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["Admin.Finance.ColReference"]</th>
                        <th scope="col">@Localizer["Admin.Finance.ColType"]</th>
                        <th scope="col">@Localizer["Admin.Finance.ColStatus"]</th>
                        <th scope="col" class="text-end">@Localizer["Admin.Finance.ColAmount"]</th>
                        <th scope="col" class="text-end">@Localizer["Admin.Finance.ColRefunded"]</th>
                        <th scope="col">@Localizer["Admin.Finance.ColGateway"]</th>
                        <th scope="col">@Localizer["Admin.Finance.ColCreated"]</th>
                        @if (canRefund)
                        {
                            <th scope="col" class="text-end">@Localizer["Admin.Finance.ColActions"]</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Payments)
                    {
                        var color = PaymentsMapper.StatusColor(p.Status);
                        var icon = PaymentsMapper.StatusIcon(p.Status);
                        <tr>
                            <td>
                                @if (string.IsNullOrWhiteSpace(p.GatewayTransactionId))
                                {
                                    <span class="text-secondary" aria-label="@Localizer["Admin.Finance.NoReference"]">&mdash;</span>
                                }
                                else
                                {
                                    <bdi class="font-data" dir="ltr">@p.GatewayTransactionId</bdi>
                                }
                            </td>
                            <td>@p.PaymentType</td>
                            <td>
                                <span class="badge bg-@color bg-opacity-10 text-@color">
                                    <i class="fa-solid fa-@icon fa-fw" aria-hidden="true"></i> @p.Status
                                </span>
                            </td>
                            <td class="text-end"><bdi class="font-data" dir="ltr">@Money(p.Amount, p.Currency)</bdi></td>
                            <td class="text-end">
                                @if (p.RefundedTotal > 0)
                                {
                                    <bdi class="font-data" dir="ltr">@Money(p.RefundedTotal, p.Currency)</bdi>
                                }
                                else
                                {
                                    <span class="text-secondary" aria-label="@Localizer["Admin.Finance.NoRefund"]">&mdash;</span>
                                }
                            </td>
                            <td>@p.GatewayProvider</td>
                            <td><bdi class="font-data small text-secondary" dir="ltr">@Date(p.CreatedAt)</bdi></td>
                            @if (canRefund)
                            {
                                <td class="text-end">
                                    @if (IsRefundable(p))
                                    {
                                        <permission require="@WebPermission.Refund.Create">
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    data-bs-toggle="modal" data-bs-target="#refundModal-@p.Id.ToString("N")">
                                                <i class="fa-solid fa-rotate-left fa-fw" aria-hidden="true"></i>
                                                <span>@Localizer["Admin.Finance.Refund"]</span>
                                            </button>
                                        </permission>
                                    }
                                    else
                                    {
                                        <span class="text-secondary small" aria-label="@Localizer["Admin.Finance.NotRefundable"]">&mdash;</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* §8.7 — per-row refund modals (rendered only for refundable rows the admin can act on) *@
        @if (canRefund)
        {
            foreach (var p in Model.Payments.Where(IsRefundable))
            {
                var modalId = $"refundModal-{p.Id:N}";
                var labelId = $"refundLabel-{p.Id:N}";
                var descId = $"refundDesc-{p.Id:N}";
                var amountId = $"amount-{p.Id:N}";
                var reasonId = $"reason-{p.Id:N}";
                var maxRefund = p.Amount - p.RefundedTotal;
                var reference = string.IsNullOrWhiteSpace(p.GatewayTransactionId)
                    ? Localizer["Admin.Finance.ThisPayment"].Value
                    : p.GatewayTransactionId;
                <permission require="@WebPermission.Refund.Create">
                    <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="@labelId" aria-describedby="@descId"
                         aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                        <div class="modal-dialog modal-dialog-centered">
                            <form method="post" asp-area="Admin" asp-controller="Payments" asp-action="Refund"
                                  asp-route-id="@p.Id" class="modal-content" role="dialog" aria-modal="true" aria-labelledby="@labelId">
                                @Html.AntiForgeryToken()
                                <partial name="Partials/_ModalHeader"
                                         model="@(new ModalHeaderVm { TitleId = labelId, Title = Localizer["Admin.Finance.RefundTitle"].Value, CloseLabel = Localizer["Admin.Finance.Close"].Value })" />
                                <div class="modal-body" id="@descId">
                                    <p class="small text-secondary">
                                        @Localizer["Admin.Finance.RefundIntro", reference]<br />
                                        @Localizer["Admin.Finance.RefundCharged", Money(p.Amount, p.Currency)]
                                        @Localizer["Admin.Finance.RefundAlready", Money(p.RefundedTotal, p.Currency)]
                                        <strong>@Localizer["Admin.Finance.RefundBalance", Money(maxRefund, p.Currency)]</strong>
                                    </p>
                                    <input type="hidden" name="currency" value="@p.Currency" />
                                    <div class="mb-3">
                                        <label class="form-label" for="@amountId">@Localizer["Admin.Finance.AmountLabel", p.Currency]</label>
                                        <input type="number" step="0.001" min="0.001" dir="ltr"
                                               max="@maxRefund.ToString(CultureInfo.InvariantCulture)"
                                               class="form-control font-data" id="@amountId" name="amount"
                                               value="@maxRefund.ToString(CultureInfo.InvariantCulture)" required />
                                    </div>
                                    <div class="mb-1">
                                        <label class="form-label" for="@reasonId">@Localizer["Admin.Finance.ReasonLabel"]</label>
                                        <textarea class="form-control" id="@reasonId" name="reason"
                                                  rows="3" maxlength="500" required aria-describedby="@reasonId-help"
                                                  placeholder="@Localizer["Admin.Finance.ReasonPlaceholder"]"></textarea>
                                        <small id="@reasonId-help" class="form-text">@Localizer["Admin.Finance.ReasonHelp"]</small>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.Finance.Cancel"]</button>
                                    <button type="submit" class="btn btn-danger">
                                        <i class="fa-solid fa-rotate-left fa-fw" aria-hidden="true"></i>
                                        <span>@Localizer["Admin.Finance.RefundSubmit"]</span>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </permission>
            }
        }

        @if (Model.NextCursor is { } next)
        {
            @* Cursor pager — same-pathname anchor, so listing.js refines it in place (R6). *@
            <div class="text-center mt-3">
                <a class="btn btn-outline-primary btn-sm"
                   asp-area="Admin" asp-controller="Payments" asp-action="Index"
                   asp-route-Status="@Model.StatusFilter" asp-route-Type="@Model.TypeFilter"
                   asp-route-Cursor="@next">@Localizer["Admin.Finance.LoadMore"]</a>
            </div>
        }
    }
    else
    {
        <partial name="Partials/_EmptyState"
                 model="@(new EmptyStateVm { Message = Localizer["Admin.Finance.EmptyMessage"].Value, CtaText = hasFilters ? Localizer["Admin.Finance.ClearFilters"].Value : null, CtaUrl = hasFilters ? Url.Action("Index", "Payments", new { area = "Admin" }) : null })" />
    }
</div>
