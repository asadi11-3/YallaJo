@model YallaJo.Web.Areas.Admin.Models.Payments.PaymentsVm
@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.Payments
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Shared
@inject YallaJo.Web.Infrastructure.Identity.ICurrentUser CurrentUser
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Finance.Title"].Value;
    ViewData["AdminNav"] = "Finance";

    var culture = CultureInfo.CurrentCulture;

    string Count(int n) => n.ToString("N0", culture);
    string Money(decimal amount, string? currency)
        => amount.ToString("N3", culture) + " " + (string.IsNullOrWhiteSpace(currency) ? Model.Currency : currency);
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Finance.Title"]</h1>
        <p class="mb-0 text-secondary">@Localizer["Admin.Finance.Subtitle"]</p>
    </div>
</div>

@* KPI tiles *@
<div class="row g-4 mb-4">
    <div class="col-md-6 col-xxl-3">
        <div class="card card-body shadow p-4 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h6 fw-light mb-1">@Localizer["Admin.Finance.GrossRevenue"]</h2>
                    <p class="font-data h3 mb-0"><bdi dir="ltr">@Money(Model.GrossRevenue, Model.Currency)</bdi></p>
                </div>
                <div class="icon-lg rounded-circle bg-success bg-opacity-10 text-success">
                    <i class="fa-solid fa-sack-dollar fa-fw" aria-hidden="true"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xxl-3">
        <div class="card card-body shadow p-4 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h6 fw-light mb-1">@Localizer["Admin.Finance.PlatformCommission"]</h2>
                    <p class="font-data h3 mb-0"><bdi dir="ltr">@Money(Model.PlatformCommissionEstimate, Model.Currency)</bdi></p>
                </div>
                <div class="icon-lg rounded-circle bg-primary bg-opacity-10 text-primary">
                    <i class="fa-solid fa-percent fa-fw" aria-hidden="true"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xxl-3">
        <div class="card card-body shadow p-4 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h6 fw-light mb-1">@Localizer["Admin.Finance.ProviderNet"]</h2>
                    <p class="font-data h3 mb-0"><bdi dir="ltr">@Money(Model.ProviderNetEstimate, Model.Currency)</bdi></p>
                </div>
                <div class="icon-lg rounded-circle bg-info bg-opacity-10 text-info">
                    <i class="fa-solid fa-hand-holding-dollar fa-fw" aria-hidden="true"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xxl-3">
        <div class="card card-body shadow p-4 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h6 fw-light mb-1">@Localizer["Admin.Finance.OpenDisputes"]</h2>
                    <p class="font-data h3 mb-0"><bdi dir="ltr">@Count(Model.OpenDisputeCount)</bdi></p>
                </div>
                <div class="icon-lg rounded-circle bg-warning bg-opacity-10 text-warning">
                    <i class="fa-solid fa-scale-balanced fa-fw" aria-hidden="true"></i>
                </div>
            </div>
        </div>
    </div>
</div>

@* Filters *@
<div class="card shadow mb-4">
    <div class="card-header border-bottom">
        <h2 class="card-header-title h5 mb-0">@Localizer["Admin.Finance.FiltersHeading"]</h2>
    </div>
    <div class="card-body">
        <form method="get" asp-area="Admin" asp-controller="Payments" asp-action="Index" class="row g-3 align-items-end" data-yj-listing>
            <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="Status">@Localizer["Admin.Finance.StatusLabel"]</label>
                <input type="text" class="form-control" id="Status" name="Status" dir="ltr"
                       value="@Model.StatusFilter" aria-describedby="status-help"
                       placeholder="@Localizer["Admin.Finance.StatusPlaceholder"]" />
                <small id="status-help" class="form-text">@Localizer["Admin.Finance.StatusHelp"]</small>
            </div>
            <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="Type">@Localizer["Admin.Finance.TypeLabel"]</label>
                <input type="text" class="form-control" id="Type" name="Type" dir="ltr"
                       value="@Model.TypeFilter" aria-describedby="type-help"
                       placeholder="@Localizer["Admin.Finance.TypePlaceholder"]" />
                <small id="type-help" class="form-text">@Localizer["Admin.Finance.TypeHelp"]</small>
            </div>
            <div class="col-sm-6 col-lg-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@Localizer["Admin.Finance.Apply"]</button>
                <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Payments" asp-action="Index">@Localizer["Admin.Finance.Reset"]</a>
            </div>
        </form>
    </div>
</div>

@* Payments table *@
<section class="card shadow" aria-labelledby="payments-heading">
    <div class="card-header border-bottom d-flex justify-content-between align-items-center">
        <h2 id="payments-heading" class="card-header-title h5 mb-0">@Localizer["Admin.Finance.Directory"]</h2>
        @if (Model.TotalCount is { } total)
        {
            <span class="badge bg-secondary bg-opacity-10 text-secondary">
                <bdi class="font-data" dir="ltr">@Count(total)</bdi> @Localizer["Admin.Finance.TotalLabel"]
            </span>
        }
    </div>
    @* S1/L1/A11Y9 — listing.js swaps this fragment in place; ViewBag.Error renders inside it. *@
    <div id="listingResults" data-yj-component="listing" aria-live="polite" aria-busy="false"
         data-error-text="@Localizer["Public.Results.Error"]"
         data-retry-text="@Localizer["Public.Retry"]"
         data-loading-text="@Localizer["Public.Loading"]">
        <partial name="_PaymentsResults" model="Model" />
    </div>
</section>

@section Scripts {
    <script src="~/assets/js/listing.js" asp-append-version="true" defer></script>
}
