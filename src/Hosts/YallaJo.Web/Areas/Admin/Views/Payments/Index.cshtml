@model YallaJo.Web.Areas.Admin.Models.Payments.PaymentsVm
@using YallaJo.Web.Areas.Admin.Models.Payments
@using YallaJo.Web.Infrastructure.Authorization
@inject YallaJo.Web.Infrastructure.Identity.ICurrentUser CurrentUser
@{
    ViewData["Title"] = "Earnings";
    ViewData["AdminNav"] = "Finance";
    var canRefund = CurrentUser.HasPermission(WebPermission.Refund.Create);
}
@functions {
    static string Money(decimal amount, string? currency)
        => string.IsNullOrWhiteSpace(currency) ? amount.ToString("N2") : $"{amount:N2} {currency}";

    // §8.7 — a payment is refundable when it has settled and still has a refundable balance.
    static bool IsRefundable(PaymentRowVm p)
    {
        var status = p.Status?.Trim().ToLowerInvariant();
        var settled = status is "succeeded" or "completed" or "captured" or "partiallyrefunded" or "partially refunded";
        return settled && p.Amount - p.RefundedTotal > 0m;
    }
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Earnings</h1>
</div>

<!-- KPI tiles -->
<div class="row g-4 mb-4">
    <div class="col-md-6 col-xxl-3">
        <div class="card card-body shadow p-4 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-light mb-1">Gross revenue</h6>
                    <h3 class="font-data mb-0">@Money(Model.GrossRevenue, Model.Currency)</h3>
                </div>
                <div class="icon-lg rounded-circle bg-success bg-opacity-10 text-success">
                    <i class="fa-solid fa-sack-dollar fa-fw"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xxl-3">
        <div class="card card-body shadow p-4 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-light mb-1">Platform commission</h6>
                    <h3 class="font-data mb-0">@Money(Model.PlatformCommissionEstimate, Model.Currency)</h3>
                </div>
                <div class="icon-lg rounded-circle bg-primary bg-opacity-10 text-primary">
                    <i class="fa-solid fa-percent fa-fw"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xxl-3">
        <div class="card card-body shadow p-4 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-light mb-1">Provider net</h6>
                    <h3 class="font-data mb-0">@Money(Model.ProviderNetEstimate, Model.Currency)</h3>
                </div>
                <div class="icon-lg rounded-circle bg-info bg-opacity-10 text-info">
                    <i class="fa-solid fa-hand-holding-dollar fa-fw"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xxl-3">
        <div class="card card-body shadow p-4 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-light mb-1">Open disputes</h6>
                    <h3 class="font-data mb-0">@Model.OpenDisputeCount.ToString("N0")</h3>
                </div>
                <div class="icon-lg rounded-circle bg-warning bg-opacity-10 text-warning">
                    <i class="fa-solid fa-scale-balanced fa-fw"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card shadow mb-4">
    <div class="card-body">
        <form method="get" asp-area="Admin" asp-controller="Payments" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="Status">Status</label>
                <input type="text" class="form-control" id="Status" name="Status"
                       value="@Model.StatusFilter" placeholder="e.g. Succeeded, Pending" />
            </div>
            <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="Type">Type</label>
                <input type="text" class="form-control" id="Type" name="Type"
                       value="@Model.TypeFilter" placeholder="e.g. Payment, Refund" />
            </div>
            <div class="col-sm-6 col-lg-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Apply</button>
                <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Payments" asp-action="Index">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Payments table -->
<div class="card shadow">
    <div class="card-header border-bottom d-flex justify-content-between align-items-center">
        <h5 class="card-header-title mb-0">Payments</h5>
        @if (Model.TotalCount is { } total)
        {
            <span class="badge bg-secondary bg-opacity-10 text-secondary font-data">@total.ToString("N0") total</span>
        }
    </div>
    <div class="card-body">
        @if (Model.Payments.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Payment</th>
                            <th scope="col">Type</th>
                            <th scope="col">Status</th>
                            <th scope="col" class="text-end">Amount</th>
                            <th scope="col" class="text-end">Refunded</th>
                            <th scope="col">Gateway</th>
                            <th scope="col">Created</th>
                            @if (canRefund)
                            {
                                <th scope="col" class="text-end">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Payments)
                        {
                            var color = PaymentsMapper.StatusColor(p.Status);
                            <tr>
                                <td class="font-data small">@p.Id.ToString("D")</td>
                                <td>@p.PaymentType</td>
                                <td>
                                    <span class="badge bg-@color bg-opacity-10 text-@color">@p.Status</span>
                                </td>
                                <td class="text-end font-data">@Money(p.Amount, p.Currency)</td>
                                <td class="text-end font-data">@(p.RefundedTotal > 0 ? Money(p.RefundedTotal, p.Currency) : "-")</td>
                                <td>@p.GatewayProvider</td>
                                <td class="font-data small text-secondary">@p.CreatedAt.ToString("g")</td>
                                @if (canRefund)
                                {
                                    <td class="text-end">
                                        @if (IsRefundable(p))
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    data-bs-toggle="modal" data-bs-target="#refundModal-@p.Id.ToString("N")">
                                                <i class="fa-solid fa-rotate-left fa-fw" aria-hidden="true"></i>
                                                <span>Refund</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-secondary small">&mdash;</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* §8.7 — per-row refund modals (rendered only for refundable rows the admin can act on) *@
            @if (canRefund)
            {
                foreach (var p in Model.Payments.Where(IsRefundable))
                {
                    var modalId = $"refundModal-{p.Id:N}";
                    var labelId = $"refundLabel-{p.Id:N}";
                    var maxRefund = p.Amount - p.RefundedTotal;
                    <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="@labelId" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <form method="post" asp-area="Admin" asp-controller="Payments" asp-action="Refund"
                                      asp-route-id="@p.Id" onsubmit="return confirm('Refund this payment? This action cannot be undone.');">
                                    @Html.AntiForgeryToken()
                                    <div class="modal-header">
                                        <h2 class="modal-title h5 mb-0" id="@labelId">Refund payment</h2>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p class="small text-secondary">
                                            Payment <bdi class="font-data" dir="ltr">@p.Id.ToString("D")</bdi><br />
                                            Charged <strong>@Money(p.Amount, p.Currency)</strong>,
                                            already refunded <strong>@Money(p.RefundedTotal, p.Currency)</strong>.
                                            Refundable balance: <strong>@Money(maxRefund, p.Currency)</strong>.
                                        </p>
                                        <input type="hidden" name="currency" value="@p.Currency" />
                                        <div class="mb-3">
                                            <label class="form-label" for="amount-@p.Id.ToString("N")">Amount (@p.Currency)</label>
                                            <input type="number" step="0.01" min="0.01" max="@maxRefund.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                   class="form-control font-data" id="amount-@p.Id.ToString("N")" name="amount"
                                                   value="@maxRefund.ToString(System.Globalization.CultureInfo.InvariantCulture)" required />
                                        </div>
                                        <div class="mb-1">
                                            <label class="form-label" for="reason-@p.Id.ToString("N")">Reason</label>
                                            <textarea class="form-control" id="reason-@p.Id.ToString("N")" name="reason"
                                                      rows="3" maxlength="500" required placeholder="Why is this payment being refunded?"></textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-danger">
                                            <i class="fa-solid fa-rotate-left fa-fw" aria-hidden="true"></i>
                                            <span>Issue refund</span>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }

            @if (Model.NextCursor is { } next)
            {
                <div class="text-center mt-3">
                    <a class="btn btn-outline-primary btn-sm"
                       asp-area="Admin" asp-controller="Payments" asp-action="Index"
                       asp-route-Status="@Model.StatusFilter" asp-route-Type="@Model.TypeFilter"
                       asp-route-Cursor="@next">Load more</a>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <img src="~/assets/images/element/17.svg" alt="" class="h-80px mb-3" />
                <p class="mb-0 text-secondary">No payments match these filters.</p>
            </div>
        }
    </div>
</div>
