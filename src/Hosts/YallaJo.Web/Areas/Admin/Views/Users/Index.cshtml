@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Users
@using YallaJo.Web.Areas.Admin.Models.Shared
@using YallaJo.Web.Areas.Admin.Helpers
@model YallaJo.Web.Areas.Admin.Models.Users.UserListVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Users.Title"].Value;
    ViewData["AdminNav"] = "Users";

    // CON3 — culture-aware integer formatting (no string concatenation of numerals).
    string Count(int n) => n.ToString("N0", CultureInfo.CurrentCulture);
}

@* ── Page header: single <h1> (A11Y6) + total-count badge ─────────────────── *@
<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Users.Title"]</h1>
        <p class="mb-0 text-secondary small">@Localizer["Admin.Users.Subtitle"]</p>
    </div>
    @if (Model.TotalCount > 0)
    {
        <span class="badge bg-primary bg-opacity-10 text-primary align-self-start mt-2 mt-sm-0">
            <bdi class="font-data">@Count(Model.TotalCount)</bdi>
            <span class="ms-1">@Localizer["Admin.Users.TotalLabel"]</span>
        </span>
    }
</div>

@* Success/Error flash banners render globally via the shared _Alerts partial;
   the listing error alert renders inside the swappable fragment (_UsersResults). *@
<div class="card shadow" data-yj-component="admin-users-list">
    <div class="card-header border-bottom d-sm-flex justify-content-between align-items-center">
        <h2 class="card-header-title h5 mb-2 mb-sm-0">@Localizer["Admin.Users.Directory"]</h2>

        @* L-row filter — purely client-side over rendered rows (progressive enhancement). *@
        @if (Model.Users.Count > 0)
        {
            <div class="position-relative">
                <label for="users-filter" class="visually-hidden">@Localizer["Admin.Users.FilterLabel"]</label>
                <input id="users-filter" type="search" class="form-control form-control-sm"
                       placeholder="@Localizer["Admin.Users.FilterPlaceholder"]"
                       aria-describedby="users-filter-help" autocomplete="off"
                       data-yj-users-filter />
                <small id="users-filter-help" class="visually-hidden">@Localizer["Admin.Users.FilterHelp"]</small>
            </div>
        }
    </div>

    @* S1/L1/A11Y9 — AJAX listing region: listing.js swaps this fragment in place
       (skeleton + pushState + popstate + inline retry); JS-off keeps native GETs. *@
    <div id="listingResults" data-yj-component="listing"
         aria-live="polite" aria-busy="false"
         data-error-text="@Localizer["Public.Results.Error"]"
         data-retry-text="@Localizer["Public.Retry"]"
         data-loading-text="@Localizer["Public.Loading"]">
        <partial name="_UsersResults" model="Model" />
    </div>
</div>

@section Scripts {
    @* A6/SEC1/J3 — page JS lives in external CSP-safe files (no inline script). *@
    <script src="~/assets/js/listing.js" asp-append-version="true" defer></script>
    <script src="~/assets/js/admin-users.js" asp-append-version="true" defer></script>
}
