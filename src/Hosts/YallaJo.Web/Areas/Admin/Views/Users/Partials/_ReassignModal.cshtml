@using Microsoft.Extensions.Localization
@model Guid
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    var userId = Model;
    var email = (ViewData["TargetEmail"] as string) ?? string.Empty;
    var modalId = $"mdl-reassign-{userId}";
    var titleId = $"{modalId}-title";
    var bannerId = $"{modalId}-banner";
    var newEmailId = $"{modalId}-new-email";
    var reasonId = $"{modalId}-reason";
    var checkboxId = $"{modalId}-understand";
}
<div class="modal fade admin-action-modal" id="@modalId" tabindex="-1" aria-labelledby="@titleId" aria-describedby="@bannerId" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form asp-area="Admin" asp-controller="Lifecycle" asp-action="Reassign" asp-route-userId="@userId" method="post" id="reassign-form">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-danger text-white">
                    <h2 class="modal-title h5" id="@titleId">
                        <i class="fa-solid fa-right-left fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.UserModal.Reassign.Title"]
                    </h2>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@Localizer["Admin.UserModal.Close"]"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger" id="@bannerId">
                        <p class="mb-1">@Localizer["Admin.UserModal.Reassign.BannerIntro"]</p>
                        <ul class="mb-1">
                            <li>@Localizer["Admin.UserModal.Reassign.Item1"]</li>
                            <li>@Localizer["Admin.UserModal.Reassign.Item2"]</li>
                            <li>@Localizer["Admin.UserModal.Reassign.Item3"]</li>
                            <li>@Localizer["Admin.UserModal.Reassign.Item4"]</li>
                            <li>@Localizer["Admin.UserModal.Reassign.Item5"]</li>
                            <li>@Localizer["Admin.UserModal.Reassign.Item6"]</li>
                        </ul>
                        <p class="mb-0">@Localizer["Admin.UserModal.Reassign.BannerOutro"]</p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(email))
                    {
                        <p class="mb-3 small text-muted">@Localizer["Admin.UserModal.Reassign.CurrentOwner", email]</p>
                    }
                    <div class="mb-3">
                        <label class="form-label" for="@newEmailId">@Localizer["Admin.UserModal.Reassign.NewEmailLabel"]</label>
                        <input id="@newEmailId" name="NewEmail" type="email" required maxlength="320" class="form-control" placeholder="@Localizer["Admin.UserModal.Reassign.NewEmailPlaceholder"]" dir="ltr" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="@reasonId">@Localizer["Admin.UserModal.Reassign.ReasonLabel"]</label>
                        <textarea id="@reasonId" name="Reason" maxlength="500" rows="2" class="form-control" placeholder="@Localizer["Admin.UserModal.Reassign.ReasonPlaceholder"]"></textarea>
                        <div class="form-text">@Localizer["Admin.UserModal.CharLimit"]</div>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="@checkboxId" name="IUnderstand" value="true" />
                        <label class="form-check-label" for="@checkboxId">@Localizer["Admin.UserModal.Reassign.UnderstandLabel"]</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Admin.UserModal.Cancel"]</button>
                    <button type="submit" class="btn btn-danger" disabled data-reassign-submit>@Localizer["Admin.UserModal.Reassign.Submit"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
