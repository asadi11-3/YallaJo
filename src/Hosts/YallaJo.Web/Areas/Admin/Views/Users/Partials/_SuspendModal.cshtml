@using Microsoft.Extensions.Localization
@model Guid
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    var userId = Model;
    var email = (ViewData["TargetEmail"] as string) ?? string.Empty;
    var modalId = $"mdl-suspend-{userId}";
    var titleId = $"{modalId}-title";
    var bannerId = $"{modalId}-banner";
}
<div class="modal fade admin-action-modal" id="@modalId" tabindex="-1" aria-labelledby="@titleId" aria-describedby="@bannerId" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-area="Admin" asp-controller="Lifecycle" asp-action="Suspend" asp-route-userId="@userId" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-warning-subtle">
                    <h2 class="modal-title h5" id="@titleId">
                        <i class="fa-solid fa-circle-pause fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.UserModal.Suspend.Title"]
                    </h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Admin.UserModal.Close"]"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning" id="@bannerId">@Localizer["Admin.UserModal.Suspend.Banner"]</div>
                    <p class="mb-0">
                        @if (!string.IsNullOrWhiteSpace(email))
                        {
                            @Localizer["Admin.UserModal.Suspend.Confirm", email]
                        }
                        else
                        {
                            @Localizer["Admin.UserModal.Suspend.Confirm", Localizer["Admin.UserModal.ThisUser"].Value]
                        }
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Admin.UserModal.Cancel"]</button>
                    <button type="submit" class="btn btn-warning">@Localizer["Admin.UserModal.Suspend.Submit"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
