@*
    Phase 5C — Reactivate admin lifecycle modal.
    Triggered by `data-bs-toggle="modal" data-bs-target="#mdl-reactivate-{userId}"`.
    Posts to LifecycleController.Reactivate (anti-forgery enforced).
*@
@model Guid
@{
    var userId = Model;
    var email = (ViewData["TargetEmail"] as string) ?? string.Empty;
    var modalId = $"mdl-reactivate-{userId}";
    var titleId = $"{modalId}-title";
    var bannerId = $"{modalId}-banner";
}

<div class="modal fade admin-action-modal" id="@modalId" tabindex="-1"
     aria-labelledby="@titleId" aria-describedby="@bannerId" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-area="Admin" asp-controller="Lifecycle"
                  asp-action="Reactivate" asp-route-userId="@userId" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-success-subtle">
                    <h5 class="modal-title" id="@titleId">
                        <i class="bi bi-play-circle me-1"></i> Reactivate account
                    </h5>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info small mb-3" id="@bannerId">
                        Restores login access. The user will sign in with their
                        existing credentials. No new sessions are created — they
                        must re-login.
                    </div>
                    <p class="mb-0">
                        Are you sure you want to reactivate
                        @if (!string.IsNullOrWhiteSpace(email))
                        {
                            <strong>@email</strong>
                        }
                        else
                        {
                            <span>this user</span>
                        }
                        ?
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Reactivate</button>
                </div>
            </form>
        </div>
    </div>
</div>
