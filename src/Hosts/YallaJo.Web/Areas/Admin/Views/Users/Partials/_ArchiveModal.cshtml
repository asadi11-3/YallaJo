@using Microsoft.Extensions.Localization
@model Guid
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    var userId = Model;
    var email = (ViewData["TargetEmail"] as string) ?? string.Empty;
    var modalId = $"mdl-archive-{userId}";
    var titleId = $"{modalId}-title";
    var bannerId = $"{modalId}-banner";
    var inputId = $"{modalId}-confirm";
    var confirmToken = Localizer["Admin.Users.Archive.ConfirmToken"].Value;
}
<div class="modal fade admin-action-modal" id="@modalId" tabindex="-1" aria-labelledby="@titleId" aria-describedby="@bannerId" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-area="Admin" asp-controller="Lifecycle" asp-action="Archive" asp-route-userId="@userId" method="post" id="archive-form">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-danger text-white">
                    <h2 class="modal-title h5" id="@titleId">
                        <i class="fa-solid fa-box-archive fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.UserModal.Archive.Title"]
                    </h2>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@Localizer["Admin.UserModal.Close"]"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-danger" id="@bannerId">@Localizer["Admin.UserModal.Archive.Banner"]</div>
                    <p>
                        @if (!string.IsNullOrWhiteSpace(email))
                        {
                            @Localizer["Admin.UserModal.Archive.AboutTo", email]
                        }
                        else
                        {
                            @Localizer["Admin.UserModal.Archive.AboutTo", Localizer["Admin.UserModal.ThisUser"].Value]
                        }
                    </p>
                    <label class="form-label" for="@inputId">@Localizer["Admin.UserModal.Archive.ConfirmLabel", confirmToken]</label>
                    <input id="@inputId" name="ConfirmText" type="text" autocomplete="off" required class="form-control" placeholder="@confirmToken" dir="auto" data-confirm-token="@confirmToken" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Admin.UserModal.Cancel"]</button>
                    <button type="submit" class="btn btn-danger" disabled data-archive-submit>@Localizer["Admin.UserModal.Archive.Submit"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
