@using Microsoft.Extensions.Localization
@model Guid
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    var userId = Model;
    var email = (ViewData["TargetEmail"] as string) ?? string.Empty;
    var modalId = $"mdl-reset-pwd-{userId}";
    var titleId = $"{modalId}-title";
    var bannerId = $"{modalId}-banner";
    var reasonId = $"{modalId}-reason";
}
<div class="modal fade admin-action-modal" id="@modalId" tabindex="-1" aria-labelledby="@titleId" aria-describedby="@bannerId" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-area="Admin" asp-controller="Lifecycle" asp-action="ResetPassword" asp-route-userId="@userId" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-warning-subtle">
                    <h2 class="modal-title h5" id="@titleId">
                        <i class="fa-solid fa-key fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.UserModal.Reset.Title"]
                    </h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Admin.UserModal.Close"]"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning" id="@bannerId">@Localizer["Admin.UserModal.Reset.Banner"]</div>
                    <p>
                        @if (!string.IsNullOrWhiteSpace(email))
                        {
                            @Localizer["Admin.UserModal.Reset.AboutTo", email]
                        }
                        else
                        {
                            @Localizer["Admin.UserModal.Reset.AboutTo", Localizer["Admin.UserModal.ThisUser"].Value]
                        }
                    </p>
                    <label class="form-label" for="@reasonId">@Localizer["Admin.UserModal.Reset.ReasonLabel"]</label>
                    <textarea id="@reasonId" name="Reason" maxlength="500" rows="2" class="form-control" placeholder="@Localizer["Admin.UserModal.Reset.ReasonPlaceholder"]"></textarea>
                    <div class="form-text">@Localizer["Admin.UserModal.CharLimit"]</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Admin.UserModal.Cancel"]</button>
                    <button type="submit" class="btn btn-warning">@Localizer["Admin.UserModal.Reset.Submit"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
