@using Microsoft.Extensions.Localization
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Users
@using YallaJo.Web.Areas.Admin.Helpers
@model YallaJo.Web.Areas.Admin.Models.Users.UserDetailsVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.UserDetails.Title"].Value;
    ViewData["AdminNav"] = "Users";
}

@* ── Page header: single <h1> (A11Y6). Email is the human-readable name (F10);
     the GUID is never shown, only used in route/form values below. ─────────── *@
<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.UserDetails.Heading"]</h1>
        <p class="mb-0 text-secondary"><bdi dir="ltr">@Model.Email</bdi></p>
    </div>
    <a asp-area="Admin" asp-controller="Users" asp-action="Index"
       class="btn btn-sm btn-outline-secondary align-self-start mt-2 mt-sm-0">
        <i class="fa-solid fa-arrow-left fa-fw" aria-hidden="true"></i>
        <span>@Localizer["Admin.UserDetails.Back"]</span>
    </a>
</div>

<div data-yj-component="admin-users-details">

    @* ── Overview: status + roles ─────────────────────────────────────────── *@
    <div class="card shadow mb-4">
        <div class="card-header border-bottom">
            <h2 class="card-header-title h5 mb-0">@Localizer["Admin.UserDetails.OverviewHeading"]</h2>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">@Localizer["Admin.UserDetails.StatusLabel"]</dt>
                <dd class="col-sm-9">
                    <partial name="Partials/_LifecycleBadge"
                             model="@(new LifecycleBadgeVm(Model.IsActive, null))" />
                </dd>
                <dt class="col-sm-3">@Localizer["Admin.UserDetails.RolesLabel"]</dt>
                <dd class="col-sm-9 mb-0">
                    @if (Model.CurrentRoles.Any())
                    {
                        foreach (var role in Model.CurrentRoles)
                        {
                            <span class="badge bg-secondary bg-opacity-10 text-secondary me-1">@role</span>
                        }
                    }
                    else
                    {
                        <span class="text-secondary">@Localizer["Admin.UserDetails.NoRoles"]</span>
                    }
                </dd>
            </dl>

            @* Canonical RBAC Activate / Deactivate (gated by User.UpdateAny).
               Deactivate routes through the shared F8 confirm modal (data-confirm);
               Activate is non-destructive so it submits directly. *@
            <permission require="@WebPermission.User.UpdateAny">
                <div class="mt-3 d-flex flex-wrap gap-2">
                    @if (Model.IsActive)
                    {
                        <form asp-area="Admin" asp-controller="Users"
                              asp-action="Deactivate" asp-route-userId="@Model.UserId" method="post" class="d-inline"
                              data-confirm="@Localizer["Admin.UserDetails.DeactivateConfirm", Model.Email]"
                              data-confirm-title="@Localizer["Admin.UserDetails.DeactivateTitle"]"
                              data-confirm-action="@Localizer["Admin.UserDetails.DeactivateAction"]" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning btn-sm">
                                <i class="fa-solid fa-ban fa-fw" aria-hidden="true"></i>
                                <span>@Localizer["Admin.UserDetails.Deactivate"]</span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-area="Admin" asp-controller="Users"
                              asp-action="Activate" asp-route-userId="@Model.UserId" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success btn-sm">
                                <i class="fa-solid fa-circle-check fa-fw" aria-hidden="true"></i>
                                <span>@Localizer["Admin.UserDetails.Activate"]</span>
                            </button>
                        </form>
                    }
                </div>
            </permission>
        </div>
    </div>

    @* ── Admin lifecycle actions (Bootstrap modals → LifecycleController) ───── *@
    <permission require="@WebPermission.User.UpdateAny">
        @{
            var modalViewData = new ViewDataDictionary(ViewData) { ["TargetEmail"] = Model.Email };
        }
        <div class="card shadow mb-4">
            <div class="card-header border-bottom">
                <h2 class="card-header-title h5 mb-0">@Localizer["Admin.UserDetails.AdminActionsHeading"]</h2>
                <small class="text-secondary">@Localizer["Admin.UserDetails.AdminActionsHint"]</small>
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-warning btn-sm"
                            data-bs-toggle="modal" data-bs-target="#mdl-suspend-@Model.UserId">
                        <i class="fa-solid fa-circle-pause fa-fw" aria-hidden="true"></i>
                        <span>@Localizer["Admin.UserDetails.Suspend"]</span>
                    </button>

                    <button type="button" class="btn btn-success btn-sm"
                            data-bs-toggle="modal" data-bs-target="#mdl-reactivate-@Model.UserId">
                        <i class="fa-solid fa-circle-play fa-fw" aria-hidden="true"></i>
                        <span>@Localizer["Admin.UserDetails.Reactivate"]</span>
                    </button>

                    <button type="button" class="btn btn-dark btn-sm"
                            data-bs-toggle="modal" data-bs-target="#mdl-archive-@Model.UserId">
                        <i class="fa-solid fa-box-archive fa-fw" aria-hidden="true"></i>
                        <span>@Localizer["Admin.UserDetails.Archive"]</span>
                    </button>

                    <button type="button" class="btn btn-outline-warning btn-sm"
                            data-bs-toggle="modal" data-bs-target="#mdl-reset-pwd-@Model.UserId">
                        <i class="fa-solid fa-key fa-fw" aria-hidden="true"></i>
                        <span>@Localizer["Admin.UserDetails.ResetPassword"]</span>
                    </button>

                    <button type="button" class="btn btn-outline-danger btn-sm"
                            data-bs-toggle="modal" data-bs-target="#mdl-reassign-@Model.UserId">
                        <i class="fa-solid fa-right-left fa-fw" aria-hidden="true"></i>
                        <span>@Localizer["Admin.UserDetails.Reassign"]</span>
                    </button>

                    @* Force-revoke all active sessions — F8 confirm via data-confirm. *@
                    <form asp-area="Admin" asp-controller="Lifecycle" asp-action="RevokeSessions"
                          asp-route-userId="@Model.UserId" method="post" class="d-inline"
                          data-confirm="@Localizer["Admin.UserDetails.RevokeConfirm"]"
                          data-confirm-title="@Localizer["Admin.UserDetails.RevokeTitle"]"
                          data-confirm-action="@Localizer["Admin.UserDetails.RevokeAction"]" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="fa-solid fa-right-from-bracket fa-fw" aria-hidden="true"></i>
                            <span>@Localizer["Admin.UserDetails.RevokeSessions"]</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>

        @* Modals (rendered once; opened via the buttons above). *@
        <partial name="Partials/_SuspendModal"            model="Model.UserId" view-data="modalViewData" />
        <partial name="Partials/_ReactivateModal"         model="Model.UserId" view-data="modalViewData" />
        <partial name="Partials/_ArchiveModal"            model="Model.UserId" view-data="modalViewData" />
        <partial name="Partials/_AdminResetPasswordModal" model="Model.UserId" view-data="modalViewData" />
        <partial name="Partials/_ReassignModal"           model="Model.UserId" view-data="modalViewData" />
    </permission>

    @* ── Roles management ─────────────────────────────────────────────────── *@
    <div class="card shadow mb-4">
        <div class="card-header border-bottom">
            <h2 class="card-header-title h5 mb-0">@Localizer["Admin.UserDetails.RolesHeading"]</h2>
        </div>
        <div class="card-body">
            @* Assign role — F10: a <select> of role NAMES, the id is the option value. *@
            <permission require="@WebPermission.UserRole.Create">
                <form asp-area="Admin" asp-controller="Users"
                      asp-action="AssignRole" asp-route-userId="@Model.UserId" method="post"
                      class="row g-2 align-items-end mb-3">
                    @Html.AntiForgeryToken()
                    <div class="col-sm-auto">
                        <label for="RoleId" class="form-label small mb-1">@Localizer["Admin.UserDetails.RoleSelectLabel"]</label>
                        <select name="RoleId" id="RoleId" class="form-select form-select-sm"
                                asp-items="@(new SelectList(Model.AvailableRoles, "Id", "Name"))">
                            <option value="">@Localizer["Admin.UserDetails.RoleSelectPlaceholder"]</option>
                        </select>
                    </div>
                    <div class="col-sm-auto">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fa-solid fa-plus fa-fw" aria-hidden="true"></i>
                            <span>@Localizer["Admin.UserDetails.AssignRole"]</span>
                        </button>
                    </div>
                </form>
            </permission>

            @if (Model.CurrentRoles.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle w-auto mb-0">
                        <thead>
                            <tr>
                                <th scope="col">@Localizer["Admin.UserDetails.ColRole"]</th>
                                <permission require="@WebPermission.UserRole.Delete">
                                    <th scope="col" class="text-end">@Localizer["Admin.UserDetails.ColAction"]</th>
                                </permission>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in Model.AvailableRoles.Where(r => Model.CurrentRoles.Contains(r.Name)))
                            {
                                <tr>
                                    <td><span class="fw-semibold">@role.Name</span></td>
                                    <permission require="@WebPermission.UserRole.Delete">
                                        <td class="text-end">
                                            <form asp-area="Admin" asp-controller="Users"
                                                  asp-action="RemoveRole"
                                                  asp-route-userId="@Model.UserId"
                                                  asp-route-roleId="@role.Id" method="post" class="d-inline"
                                                  data-confirm="@Localizer["Admin.UserDetails.RemoveRoleConfirm", role.Name]"
                                                  data-confirm-title="@Localizer["Admin.UserDetails.RemoveRoleTitle"]"
                                                  data-confirm-action="@Localizer["Admin.UserDetails.RemoveAction"]" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                                    <i class="fa-solid fa-trash-can fa-fw" aria-hidden="true"></i>
                                                    <span>@Localizer["Admin.UserDetails.Remove"]</span>
                                                </button>
                                            </form>
                                        </td>
                                    </permission>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="mb-0 text-secondary">@Localizer["Admin.UserDetails.NoRolesAssigned"]</p>
            }
        </div>
    </div>

    @* ── Claims management ────────────────────────────────────────────────── *@
    <div class="card shadow mb-4">
        <div class="card-header border-bottom">
            <h2 class="card-header-title h5 mb-0">@Localizer["Admin.UserDetails.ClaimsHeading"]</h2>
        </div>
        <div class="card-body">
            <permission require="@WebPermission.User.UpdateAny">
                <form asp-area="Admin" asp-controller="Users"
                      asp-action="AddClaim" asp-route-userId="@Model.UserId" method="post"
                      class="row g-2 align-items-end mb-3">
                    @Html.AntiForgeryToken()
                    <div class="col-sm-auto">
                        <label for="ClaimType" class="form-label small mb-1">@Localizer["Admin.UserDetails.ClaimTypeLabel"]</label>
                        <input name="ClaimType" id="ClaimType" class="form-control form-control-sm"
                               placeholder="@Localizer["Admin.UserDetails.ClaimTypePlaceholder"]" />
                    </div>
                    <div class="col-sm-auto">
                        <label for="ClaimValue" class="form-label small mb-1">@Localizer["Admin.UserDetails.ClaimValueLabel"]</label>
                        <input name="ClaimValue" id="ClaimValue" class="form-control form-control-sm"
                               placeholder="@Localizer["Admin.UserDetails.ClaimValuePlaceholder"]" />
                    </div>
                    <div class="col-sm-auto">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fa-solid fa-plus fa-fw" aria-hidden="true"></i>
                            <span>@Localizer["Admin.UserDetails.AddClaim"]</span>
                        </button>
                    </div>
                </form>
            </permission>

            @if (Model.Claims.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle w-auto mb-0">
                        <thead>
                            <tr>
                                <th scope="col">@Localizer["Admin.UserDetails.ColClaimType"]</th>
                                <th scope="col">@Localizer["Admin.UserDetails.ColClaimValue"]</th>
                                <permission require="@WebPermission.User.UpdateAny">
                                    <th scope="col" class="text-end">@Localizer["Admin.UserDetails.ColAction"]</th>
                                </permission>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Claims)
                            {
                                <tr>
                                    <td><span class="fw-semibold">@c.ClaimType</span></td>
                                    <td><bdi dir="ltr">@c.ClaimValue</bdi></td>
                                    <permission require="@WebPermission.User.UpdateAny">
                                        <td class="text-end">
                                            <form asp-area="Admin" asp-controller="Users"
                                                  asp-action="RemoveClaim"
                                                  asp-route-userId="@Model.UserId"
                                                  asp-route-claimId="@c.Id" method="post" class="d-inline"
                                                  data-confirm="@Localizer["Admin.UserDetails.RemoveClaimConfirm", c.ClaimType]"
                                                  data-confirm-title="@Localizer["Admin.UserDetails.RemoveClaimTitle"]"
                                                  data-confirm-action="@Localizer["Admin.UserDetails.RemoveAction"]" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                                    <i class="fa-solid fa-trash-can fa-fw" aria-hidden="true"></i>
                                                    <span>@Localizer["Admin.UserDetails.Remove"]</span>
                                                </button>
                                            </form>
                                        </td>
                                    </permission>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="mb-0 text-secondary">@Localizer["Admin.UserDetails.NoClaims"]</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @* A6/SEC1/J3 — modal gating + double-submit guard live in external CSP-safe JS. *@
    <script src="~/assets/js/admin-users.js" asp-append-version="true" defer></script>
}
