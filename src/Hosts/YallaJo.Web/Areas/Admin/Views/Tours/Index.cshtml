@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.Tours
@model AdminToursIndexVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Tours.Title"].Value;
    ViewData["AdminNav"] = "Tours";
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Tours.Title"]</h1>
        <p class="text-secondary mb-0">@Localizer["Admin.Tours.Subtitle"]</p>
    </div>
</div>

@* ViewBag.Error renders inside the listing fragment so AJAX fallbacks surface it too. *@

<div class="card shadow">
    <div class="card-header border-bottom">
        <form asp-area="Admin" asp-controller="Tours" asp-action="Index" method="get"
              class="row g-2 align-items-end" data-yj-listing>
            <div class="col-sm-4">
                <label class="form-label" for="status">@Localizer["Admin.Tours.FilterStatus"]</label>
                <select id="status" name="status" class="form-select">
                    <option value="">@Localizer["Admin.Tours.AllStatuses"]</option>
                    @foreach (var s in AdminToursIndexVm.StatusFilters)
                    {
                        if (string.Equals(s, Model.Status, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@s" selected>@s</option>
                        }
                        else
                        {
                            <option value="@s">@s</option>
                        }
                    }
                </select>
            </div>
            <div class="col-sm-3 d-grid">
                <button type="submit" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-filter fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Tours.Filter"]
                </button>
            </div>
        </form>
    </div>

    @* S1/L1/A11Y9: listing.js refines this region in place (skeleton, swap, history). *@
    <div id="listingResults" data-yj-component="listing" aria-live="polite" aria-busy="false"
         data-error-text="@Localizer["Public.Results.Error"]"
         data-retry-text="@Localizer["Public.Retry"]"
         data-loading-text="@Localizer["Public.Loading"]">
        <partial name="_ToursResults" model="Model" />
    </div>
</div>

<p class="text-secondary small mt-3 mb-0">@Localizer["Admin.Tours.ActionsHint"]</p>

@section Scripts {
    <script src="~/assets/js/listing.js" asp-append-version="true" defer></script>
}
