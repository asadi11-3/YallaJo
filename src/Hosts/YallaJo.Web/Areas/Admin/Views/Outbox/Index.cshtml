@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.Outbox
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Shared
@model OutboxVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Outbox.Title"].Value;
    ViewData["AdminNav"] = "Outbox";

    var culture = CultureInfo.CurrentCulture;
    string Count(int n) => n.ToString("N0", culture);
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Outbox.Title"]</h1>
        <p class="text-secondary mb-0">@Localizer["Admin.Outbox.Subtitle"]</p>
    </div>
    @if (Model.TotalCount > 0)
    {
        <span class="badge bg-danger bg-opacity-10 text-danger">
            <i class="fa-solid fa-triangle-exclamation fa-fw" aria-hidden="true"></i>
            <bdi class="font-data">@Count(Model.TotalCount)</bdi> @Localizer["Admin.Outbox.DeadLabel"]
        </span>
    }
</div>

@* ViewBag.Error renders inside the listing fragment so AJAX fallbacks surface it too. *@

<form method="get" asp-controller="Outbox" asp-action="Index" class="card card-body shadow mb-4" data-yj-listing>
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="outbox-module">@Localizer["Admin.Outbox.ModuleLabel"]</label>
            <input id="outbox-module" name="Module" value="@Model.ModuleFilter" class="form-control" dir="ltr"
                   aria-describedby="outbox-module-help" placeholder="@Localizer["Admin.Outbox.ModulePlaceholder"]" />
            <small id="outbox-module-help" class="form-text">@Localizer["Admin.Outbox.ModuleHelp"]</small>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">@Localizer["Admin.Outbox.Apply"]</button>
            <a asp-controller="Outbox" asp-action="Index" class="btn btn-outline-secondary">@Localizer["Admin.Outbox.Reset"]</a>
        </div>
    </div>
</form>

<section class="card shadow" aria-labelledby="outbox-heading">
    <div class="card-header border-bottom">
        <h2 id="outbox-heading" class="card-header-title h5 mb-0">@Localizer["Admin.Outbox.Directory"]</h2>
    </div>
    @* S1/L1/A11Y9 — listing.js swaps this fragment for AJAX filtering. *@
    <div id="listingResults" data-yj-component="listing" aria-live="polite" aria-busy="false"
         data-error-text="@Localizer["Public.Results.Error"]"
         data-retry-text="@Localizer["Public.Retry"]"
         data-loading-text="@Localizer["Public.Loading"]">
        <partial name="_OutboxResults" model="Model" />
    </div>
</section>

<permission require="@WebPermission.Outbox.Replay">
    <section class="card shadow mt-4" aria-labelledby="outbox-backfill-heading">
        <div class="card-header border-bottom">
            <h2 id="outbox-backfill-heading" class="card-header-title h5 mb-0">@Localizer["Admin.Outbox.BackfillHeading"]</h2>
        </div>
        <div class="card-body">
            <p class="text-secondary">@Localizer["Admin.Outbox.BackfillHint"]</p>
            <form method="post" asp-action="BackfillTourSnapshots" class="row g-2 align-items-end"
                  data-confirm="@Localizer["Admin.Outbox.BackfillConfirm"]"
                  data-confirm-title="@Localizer["Admin.Outbox.BackfillTitle"]"
                  data-confirm-action="@Localizer["Admin.Outbox.BackfillSubmit"]" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                @Html.AntiForgeryToken()
                <div class="col-sm-4">
                    <label class="form-label" for="outbox-batch-size">@Localizer["Admin.Outbox.BatchSizeLabel"]</label>
                    <input id="outbox-batch-size" name="batchSize" type="number" min="1" max="10000" dir="ltr"
                           class="form-control" aria-describedby="outbox-batch-size-help" />
                    <small id="outbox-batch-size-help" class="form-text">@Localizer["Admin.Outbox.BatchSizeHelp"]</small>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-database fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Outbox.BackfillSubmit"]
                    </button>
                </div>
            </form>
        </div>
    </section>
</permission>

@section Scripts {
    <script src="~/assets/js/listing.js" asp-append-version="true" defer></script>
}
