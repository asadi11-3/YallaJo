@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.Outbox
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Shared
@model OutboxVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@*
    Swappable listing fragment (S1/PE1): rendered inside the page on full
    requests and returned alone for listing.js AJAX refinements.
*@
@{
    var culture = CultureInfo.CurrentCulture;
    string Count(int n) => n.ToString("N0", culture);
    string Date(DateTime dt) => dt.ToString("yyyy-MM-dd HH:mm", culture);
    var hasFilter = !string.IsNullOrWhiteSpace(Model.ModuleFilter);
}
@if (ViewBag.Error is string vbe && !string.IsNullOrWhiteSpace(vbe))
{
    <div class="alert alert-danger m-3 mb-0" role="alert">@vbe</div>
}
@if (Model.DeadLetters.Count == 0)
{
    <partial name="Partials/_EmptyState"
             model="@(new EmptyStateVm { Message = Localizer["Admin.Outbox.EmptyMessage"].Value, CtaText = hasFilter ? Localizer["Admin.Outbox.ClearFilter"].Value : null, CtaUrl = hasFilter ? Url.Action("Index", "Outbox") : null, ContainerClass = "card-body text-center py-5" })" />
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">@Localizer["Admin.Outbox.ColModule"]</th>
                    <th scope="col">@Localizer["Admin.Outbox.ColType"]</th>
                    <th scope="col">@Localizer["Admin.Outbox.ColOccurred"]</th>
                    <th scope="col" class="text-end">@Localizer["Admin.Outbox.ColRetries"]</th>
                    <th scope="col">@Localizer["Admin.Outbox.ColLastError"]</th>
                    <th scope="col" class="text-end">@Localizer["Admin.Outbox.ColActions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.DeadLetters)
                {
                    <tr>
                        <td class="fw-semibold">@d.Module</td>
                        <td><bdi dir="ltr">@d.Type</bdi></td>
                        <td><bdi class="font-data" dir="ltr">@Date(d.OccurredOnUtc)</bdi></td>
                        <td class="text-end"><bdi class="font-data">@Count(d.RetryCount)</bdi></td>
                        <td class="text-truncate mw-280">
                            @if (string.IsNullOrWhiteSpace(d.LastError))
                            {
                                <span class="text-secondary" aria-label="@Localizer["Admin.Outbox.NoError"]">&mdash;</span>
                            }
                            else
                            {
                                <bdi dir="ltr" class="text-break">@d.LastError</bdi>
                            }
                        </td>
                        <td class="text-end">
                            <permission require="@WebPermission.Outbox.Replay">
                                <form method="post" asp-action="Replay" asp-route-module="@d.Module" asp-route-id="@d.Id"
                                      class="d-inline"
                                      data-confirm="@Localizer["Admin.Outbox.ReplayConfirm"]"
                                      data-confirm-title="@Localizer["Admin.Outbox.ReplayTitle"]"
                                      data-confirm-action="@Localizer["Admin.Outbox.Replay"]" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                        <i class="fa-solid fa-arrows-rotate fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Outbox.Replay"]
                                    </button>
                                </form>
                            </permission>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
