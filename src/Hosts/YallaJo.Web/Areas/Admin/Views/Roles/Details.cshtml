@using Microsoft.Extensions.Localization
@using YallaJo.Web.Infrastructure.Authorization
@model YallaJo.Web.Areas.Admin.Models.Roles.RoleDetailsVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.RoleDetails.Title"].Value;
    ViewData["AdminNav"] = "Roles";
}

@* Page header — single <h1> (A11Y6); role NAME is shown, never the GUID (F10). *@
<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.RoleDetails.Heading"]</h1>
        <p class="mb-0 text-secondary fw-semibold">@Model.Name</p>
    </div>
    <a asp-area="Admin" asp-controller="Roles" asp-action="Index"
       class="btn btn-outline-secondary btn-sm align-self-start mt-2 mt-sm-0">
        <i class="fa-solid fa-arrow-left fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.RoleDetails.Back"]
    </a>
</div>

@* ── Overview ───────────────────────────────────────────────────────── *@
<div class="card shadow mb-4">
    <div class="card-header">
        <h2 class="card-header-title h5 mb-0">@Localizer["Admin.RoleDetails.OverviewHeading"]</h2>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Localizer["Admin.RoleDetails.StatusLabel"]</dt>
            <dd class="col-sm-9">
                @* A11Y5 — status conveyed by colour + icon + text. *@
                <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                    <i class="fa-solid @(Model.IsActive ? "fa-circle-check" : "fa-ban") fa-fw" aria-hidden="true"></i>
                    <span>@(Model.IsActive ? Localizer["Admin.Roles.StatusActive"] : Localizer["Admin.Roles.StatusInactive"])</span>
                </span>
            </dd>
            <dt class="col-sm-3">@Localizer["Admin.RoleDetails.DescriptionLabel"]</dt>
            <dd class="col-sm-9 mb-0">
                @if (string.IsNullOrWhiteSpace(Model.Description))
                {
                    <span class="text-secondary" aria-label="@Localizer["Admin.Roles.NoDescription"]">—</span>
                }
                else
                {
                    @Model.Description
                }
            </dd>
        </dl>
    </div>

    <permission require="@WebPermission.Role.Update">
        <div class="card-footer">
            <h3 class="h6">@Localizer["Admin.RoleDetails.UpdateHeading"]</h3>
            <form asp-area="Admin" asp-controller="Roles"
                  asp-action="Update" asp-route-roleId="@Model.RoleId" method="post"
                  class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-12 col-md-8">
                    <label for="role-description" class="form-label">@Localizer["Admin.RoleDetails.DescriptionLabel"]</label>
                    <input id="role-description" name="Description" value="@Model.Description"
                           class="form-control" autocomplete="off"
                           placeholder="@Localizer["Admin.Roles.DescriptionPlaceholder"]" />
                </div>
                <div class="col-12 col-md-4">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa-solid fa-floppy-disk fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.RoleDetails.Save"]
                    </button>
                </div>
            </form>

            @if (Model.IsActive)
            {
                <form asp-area="Admin" asp-controller="Roles"
                      asp-action="Deactivate" asp-route-roleId="@Model.RoleId" method="post" class="mt-3"
                      data-confirm="@Localizer["Admin.Roles.DeactivateConfirm", Model.Name]"
                      data-confirm-title="@Localizer["Admin.Roles.DeactivateTitle"]"
                      data-confirm-action="@Localizer["Admin.Roles.DeactivateAction"]">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning btn-sm">
                        <i class="fa-solid fa-ban fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.RoleDetails.DeactivateRole"]
                    </button>
                </form>
            }
        </div>
    </permission>
</div>

@* ── Claims ─────────────────────────────────────────────────────────── *@
<div class="card shadow">
    <div class="card-header">
        <h2 class="card-header-title h5 mb-0">@Localizer["Admin.RoleDetails.ClaimsHeading"]</h2>
    </div>
    <div class="card-body">
        <permission require="@WebPermission.RoleClaim.Create">
            <form asp-area="Admin" asp-controller="Roles"
                  asp-action="AddClaim" asp-route-roleId="@Model.RoleId" method="post"
                  class="row g-2 align-items-end mb-4">
                @Html.AntiForgeryToken()
                <div class="col-12 col-md-5">
                    <label for="claim-type" class="form-label">@Localizer["Admin.RoleDetails.ClaimTypeLabel"]</label>
                    <input id="claim-type" name="ClaimType" class="form-control" autocomplete="off" dir="ltr"
                           placeholder="@Localizer["Admin.RoleDetails.ClaimTypePlaceholder"]" />
                </div>
                <div class="col-12 col-md-5">
                    <label for="claim-value" class="form-label">@Localizer["Admin.RoleDetails.ClaimValueLabel"]</label>
                    <input id="claim-value" name="ClaimValue" class="form-control" autocomplete="off" dir="ltr"
                           placeholder="@Localizer["Admin.RoleDetails.ClaimValuePlaceholder"]" />
                </div>
                <div class="col-12 col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa-solid fa-plus fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.RoleDetails.AddClaim"]
                    </button>
                </div>
            </form>
        </permission>

        @if (Model.Claims.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">@Localizer["Admin.RoleDetails.ColClaimType"]</th>
                            <th scope="col">@Localizer["Admin.RoleDetails.ColClaimValue"]</th>
                            <permission require="@WebPermission.RoleClaim.Delete">
                                <th scope="col" class="text-end">@Localizer["Admin.RoleDetails.ColAction"]</th>
                            </permission>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Claims)
                        {
                            <tr>
                                <td><bdi dir="ltr">@c.ClaimType</bdi></td>
                                <td><bdi dir="ltr">@c.ClaimValue</bdi></td>
                                <permission require="@WebPermission.RoleClaim.Delete">
                                    <td class="text-end">
                                        <form asp-area="Admin" asp-controller="Roles"
                                              asp-action="RemoveClaim"
                                              asp-route-roleId="@Model.RoleId"
                                              asp-route-claimId="@c.Id" method="post" class="d-inline"
                                              data-confirm="@Localizer["Admin.RoleDetails.RemoveClaimConfirm", c.ClaimType]"
                                              data-confirm-title="@Localizer["Admin.RoleDetails.RemoveClaimTitle"]"
                                              data-confirm-action="@Localizer["Admin.RoleDetails.RemoveAction"]">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fa-solid fa-trash-can fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.RoleDetails.Remove"]
                                            </button>
                                        </form>
                                    </td>
                                </permission>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="mb-0 text-secondary">@Localizer["Admin.RoleDetails.NoClaims"]</p>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
