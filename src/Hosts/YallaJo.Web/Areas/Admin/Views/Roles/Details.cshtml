@using YallaJo.Web.Infrastructure.Authorization
@model YallaJo.Web.Areas.Admin.Models.Roles.RoleDetailsVm
@{
    ViewData["Title"] = "Role Details";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <h1 class="h3">Role: @Model.Name</h1>
    <a asp-area="Admin" asp-controller="Roles" asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">← Back</a>

    @* Success/Error flash banners are rendered globally by the shared _Alerts partial (in _Layout). *@

    <dl class="row">
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                @(Model.IsActive ? "Active" : "Inactive")
            </span>
        </dd>
        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@(Model.Description ?? "—")</dd>
    </dl>

    @* Update description *@
    <permission require="@WebPermission.Role.Update">
        <h5>Update Description</h5>
        <form asp-area="Admin" asp-controller="Roles"
              asp-action="Update" asp-route-roleId="@Model.RoleId" method="post" class="row g-2 mb-3">
            @Html.AntiForgeryToken()
            <div class="col-auto">
                <input name="Description" value="@Model.Description"
                       class="form-control" placeholder="Description" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">Save</button>
            </div>
        </form>

        @if (Model.IsActive)
        {
            <form asp-area="Admin" asp-controller="Roles"
                  asp-action="Deactivate" asp-route-roleId="@Model.RoleId" method="post" class="mb-4">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-warning btn-sm"
                        onclick="return confirm('Deactivate role @Model.Name?')">Deactivate role</button>
            </form>
        }
    </permission>

    <hr />

    @* Add Claim *@
    <permission require="@WebPermission.RoleClaim.Create">
        <h5>Add Claim</h5>
        <form asp-area="Admin" asp-controller="Roles"
              asp-action="AddClaim" asp-route-roleId="@Model.RoleId" method="post" class="row g-2 mb-3">
            @Html.AntiForgeryToken()
            <div class="col-auto">
                <input name="ClaimType" class="form-control" placeholder="Type" />
            </div>
            <div class="col-auto">
                <input name="ClaimValue" class="form-control" placeholder="Value" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-sm">Add Claim</button>
            </div>
        </form>
    </permission>

    @* Existing claims + Remove *@
    @if (Model.Claims.Any())
    {
        <h5>Claims</h5>
        <table class="table table-sm w-auto">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Value</th>
                    <permission require="@WebPermission.RoleClaim.Delete"><th></th></permission>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Claims)
                {
                    <tr>
                        <td>@c.ClaimType</td>
                        <td>@c.ClaimValue</td>
                        <permission require="@WebPermission.RoleClaim.Delete">
                            <td>
                                <form asp-area="Admin" asp-controller="Roles"
                                      asp-action="RemoveClaim"
                                      asp-route-roleId="@Model.RoleId"
                                      asp-route-claimId="@c.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm"
                                            onclick="return confirm('Remove this claim?')">Remove</button>
                                </form>
                            </td>
                        </permission>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
