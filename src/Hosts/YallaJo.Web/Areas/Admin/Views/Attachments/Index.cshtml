@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Attachments
@model YallaJo.Web.Areas.Admin.Models.Attachments.AttachmentListVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Attachments.Title"].Value;
    ViewData["AdminNav"] = "Attachments";

    var culture = CultureInfo.CurrentCulture;
    string Date(DateTime dt) => dt.ToString("yyyy-MM-dd HH:mm", culture);

    var hasContext = Model.HasFilter;
    var entityType = Model.Filter.EntityType;
    var entityId = Model.Filter.EntityId;
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Attachments.Title"]</h1>
        <p class="mb-0 text-secondary">@Localizer["Admin.Attachments.Subtitle"]</p>
    </div>
</div>

@if (ViewBag.Error is string vbe)
{
    <div class="alert alert-danger" role="alert">@vbe</div>
}

@if (!hasContext)
{
    <div class="card shadow">
        <div class="card-body text-center py-5">
            <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
            <h2 class="h5">@Localizer["Admin.Attachments.NoContextHeading"]</h2>
            <p class="mb-0 text-secondary">@Localizer["Admin.Attachments.NoContextMessage"]</p>
        </div>
    </div>
}
else
{
    <div class="card shadow mb-4">
        <div class="card-header border-bottom">
            <h2 class="card-header-title h5 mb-0">@Localizer["Admin.Attachments.ContextHeading"]</h2>
        </div>
        <div class="card-body">
            <p class="mb-0 text-secondary">
                @Localizer["Admin.Attachments.ContextLabel"]
                <span class="badge bg-primary bg-opacity-10 text-primary ms-1">@entityType.ToString()</span>
            </p>
        </div>
    </div>

    <permission require="@WebPermission.Attachment.Create">
        <div class="card shadow mb-4">
            <div class="card-header border-bottom">
                <h2 class="card-header-title h5 mb-0">@Localizer["Admin.Attachments.UploadHeading"]</h2>
            </div>
            <div class="card-body">
                <form asp-area="Admin" asp-controller="Attachments" asp-action="Upload" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="EntityType" value="@entityType" />
                    <input type="hidden" name="EntityId" value="@entityId" />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="upload-file" class="form-label">@Localizer["Admin.Attachments.FileLabel"]</label>
                            <input id="upload-file" type="file" name="File" class="form-control" required aria-describedby="file-help" />
                            <small id="file-help" class="form-text">@Localizer["Admin.Attachments.FileHelp"]</small>
                        </div>
                        <div class="col-md-3">
                            <label for="upload-type" class="form-label">@Localizer["Admin.Attachments.TypeLabel"]</label>
                            <select id="upload-type" name="AttachmentType" asp-items="Html.GetEnumSelectList<AttachmentTypeOption>()" class="form-select"></select>
                        </div>
                        <div class="col-md-2">
                            <label for="upload-sort" class="form-label">@Localizer["Admin.Attachments.SortLabel"]</label>
                            <input id="upload-sort" name="SortOrder" type="number" value="0" min="0" class="form-control" dir="ltr" />
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-upload fa-fw" aria-hidden="true"></i> @Localizer["Admin.Attachments.UploadSubmit"]
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </permission>

    <section class="card shadow" aria-labelledby="attachments-heading">
        <div class="card-header border-bottom">
            <h2 id="attachments-heading" class="card-header-title h5 mb-0">@Localizer["Admin.Attachments.Directory"]</h2>
        </div>
        <div class="card-body">
            @if (Model.Attachments.Count == 0)
            {
                <div class="text-center py-5">
                    <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
                    <p class="mb-0 text-secondary">@Localizer["Admin.Attachments.EmptyMessage"]</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">@Localizer["Admin.Attachments.ColPreview"]</th>
                                <th scope="col">@Localizer["Admin.Attachments.ColFile"]</th>
                                <th scope="col">@Localizer["Admin.Attachments.ColType"]</th>
                                <th scope="col">@Localizer["Admin.Attachments.ColSort"]</th>
                                <th scope="col">@Localizer["Admin.Attachments.ColUploaded"]</th>
                                <th scope="col" class="text-end">@Localizer["Admin.Attachments.ColActions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Attachments.OrderBy(x => x.SortOrder))
                            {
                                var isImage = string.Equals(a.Type, "Image", StringComparison.OrdinalIgnoreCase);
                                <tr>
                                    <td>
                                        @if (isImage)
                                        {
                                            <img src="@(a.ThumbnailUrl ?? a.Url)" width="80" height="80" loading="lazy"
                                                 alt="@(a.OriginalFileName ?? Localizer["Admin.Attachments.ImageAlt"].Value)"
                                                 class="rounded object-fit-cover" />
                                        }
                                        else
                                        {
                                            <a href="@a.Url" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">
                                                <i class="fa-solid fa-up-right-from-square fa-fw" aria-hidden="true"></i> @Localizer["Admin.Attachments.Open"]
                                            </a>
                                        }
                                    </td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(a.OriginalFileName))
                                        {
                                            <span class="text-secondary" aria-label="@Localizer["Admin.Attachments.NoFileName"]">&mdash;</span>
                                        }
                                        else
                                        {
                                            <bdi dir="ltr" class="text-break">@a.OriginalFileName</bdi>
                                        }
                                    </td>
                                    <td><span class="badge bg-secondary bg-opacity-10 text-secondary">@a.Type</span></td>
                                    <td><bdi dir="ltr" class="font-data">@a.SortOrder</bdi></td>
                                    <td><bdi dir="ltr" class="font-data text-secondary">@Date(a.UploadedAt)</bdi></td>
                                    <td class="text-end">
                                        @if (isImage)
                                        {
                                            <permission require="@WebPermission.EntityImage.Update">
                                                <form asp-area="Admin" asp-controller="Attachments" asp-action="SetPrimary" asp-route-id="@a.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="EntityType" value="@entityType" />
                                                    <input type="hidden" name="EntityId" value="@entityId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                        <i class="fa-solid fa-star fa-fw" aria-hidden="true"></i> @Localizer["Admin.Attachments.MakePrimary"]
                                                    </button>
                                                </form>
                                            </permission>
                                        }
                                        <permission require="@WebPermission.Attachment.Delete">
                                            <form asp-area="Admin" asp-controller="Attachments" asp-action="Delete" asp-route-id="@a.Id" method="post" class="d-inline"
                                                  data-confirm="@Localizer["Admin.Attachments.DeleteConfirm"]"
                                                  data-confirm-title="@Localizer["Admin.Attachments.DeleteTitle"]"
                                                  data-confirm-action="@Localizer["Admin.Attachments.Delete"]" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="entityType" value="@entityType" />
                                                <input type="hidden" name="entityId" value="@entityId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="fa-solid fa-trash fa-fw" aria-hidden="true"></i> @Localizer["Admin.Attachments.Delete"]
                                                </button>
                                            </form>
                                        </permission>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
}
