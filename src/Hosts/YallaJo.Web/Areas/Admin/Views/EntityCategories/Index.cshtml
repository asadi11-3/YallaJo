@using Microsoft.Extensions.Localization
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Shared
@model YallaJo.Web.Areas.Admin.Models.EntityCategories.EntityCategoriesVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.EntityCategories.Title"].Value;
    ViewData["AdminNav"] = "EntityCategories";

    var entityType = Model.Query.EntityType;
    var entityId = Model.Query.EntityId;
    var hasContext = Model.HasQueried;
    var assignedIds = new HashSet<Guid>(Model.Assigned.Select(a => a.CategoryId));
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.EntityCategories.Title"]</h1>
        <p class="mb-0 text-secondary">@Localizer["Admin.EntityCategories.Subtitle"]</p>
    </div>
</div>

@if (ViewBag.Error is string vbe)
{
    <div class="alert alert-danger" role="alert">@vbe</div>
}

@if (!hasContext)
{
    <div class="card shadow">
        <partial name="Partials/_EmptyState"
                 model="@(new EmptyStateVm { Message = Localizer["Admin.EntityCategories.NoContextMessage"].Value, Heading = Localizer["Admin.EntityCategories.NoContextHeading"].Value, ContainerClass = "card-body text-center py-5" })" />
    </div>
}
else
{
    <div class="card shadow mb-4">
        <div class="card-header border-bottom">
            <h2 class="card-header-title h5 mb-0">@Localizer["Admin.EntityCategories.ContextHeading"]</h2>
        </div>
        <div class="card-body">
            <p class="mb-0 text-secondary">
                @Localizer["Admin.EntityCategories.ContextLabel"]
                <span class="badge bg-primary bg-opacity-10 text-primary ms-1"><bdi dir="ltr">@entityType</bdi></span>
            </p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xxl-6">
            <div class="card shadow h-100">
                <div class="card-header border-bottom">
                    <h2 class="card-header-title h5 mb-0">@Localizer["Admin.EntityCategories.AssignedHeading"]</h2>
                </div>
                <div class="card-body">
                    @if (!Model.HasAssigned)
                    {
                        <partial name="Partials/_EmptyState"
                                 model="@(new EmptyStateVm { Message = Localizer["Admin.EntityCategories.NoneAssigned"].Value, ContainerClass = "text-center py-4" })" />
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">@Localizer["Admin.EntityCategories.ColName"]</th>
                                        <th scope="col">@Localizer["Admin.EntityCategories.ColSlug"]</th>
                                        <th scope="col" class="text-end">@Localizer["Admin.EntityCategories.ColActions"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.Assigned)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@row.Name</td>
                                            <td><bdi dir="ltr" class="font-data text-secondary">@row.Slug</bdi></td>
                                            <td class="text-end">
                                                <permission require="@WebPermission.EntityCategory.Delete">
                                                    <form asp-area="Admin" asp-controller="EntityCategories" asp-action="Remove" method="post" class="d-inline"
                                                          data-confirm="@Localizer["Admin.EntityCategories.RemoveConfirm", row.Name]"
                                                          data-confirm-title="@Localizer["Admin.EntityCategories.RemoveTitle"]"
                                                          data-confirm-action="@Localizer["Admin.EntityCategories.Remove"]" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="entityType" value="@entityType" />
                                                        <input type="hidden" name="entityId" value="@entityId" />
                                                        <input type="hidden" name="categoryId" value="@row.CategoryId" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            <i class="fa-solid fa-xmark fa-fw" aria-hidden="true"></i> @Localizer["Admin.EntityCategories.Remove"]
                                                        </button>
                                                    </form>
                                                </permission>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <permission require="@WebPermission.EntityCategory.Create">
            <div class="col-xxl-6">
                <div class="card shadow h-100">
                    <div class="card-header border-bottom">
                        <h2 class="card-header-title h5 mb-0">@Localizer["Admin.EntityCategories.AssignHeading"]</h2>
                    </div>
                    <div class="card-body">
                        <form asp-area="Admin" asp-controller="EntityCategories" asp-action="Assign" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="entityType" value="@entityType" />
                            <input type="hidden" name="entityId" value="@entityId" />
                            <div class="mb-3">
                                <label for="categoryIds" class="form-label">@Localizer["Admin.EntityCategories.SelectLabel"]</label>
                                <select id="categoryIds" name="categoryIds" class="form-select" multiple size="10" aria-describedby="categoryIds-help">
                                    @foreach (var o in Model.AvailableCategories)
                                    {
                                        if (assignedIds.Contains(o.Id))
                                        {
                                            <option value="@o.Id" disabled>@o.Name @Localizer["Admin.EntityCategories.AssignedSuffix"]</option>
                                        }
                                        else if (!o.IsActive)
                                        {
                                            <option value="@o.Id">@o.Name @Localizer["Admin.EntityCategories.InactiveSuffix"]</option>
                                        }
                                        else
                                        {
                                            <option value="@o.Id">@o.Name</option>
                                        }
                                    }
                                </select>
                                <small id="categoryIds-help" class="form-text">@Localizer["Admin.EntityCategories.SelectHelp"]</small>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-plus fa-fw" aria-hidden="true"></i> @Localizer["Admin.EntityCategories.AssignSubmit"]
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </permission>
    </div>
}
