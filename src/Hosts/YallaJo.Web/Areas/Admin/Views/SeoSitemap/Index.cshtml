@using YallaJo.Web.Areas.Admin.Models.SeoSitemap
@using YallaJo.Web.Infrastructure.Authorization
@model SeoSitemapVm
@{
    ViewData["Title"] = "SEO Sitemap";
    ViewData["AdminNav"] = "SeoSitemap";
    var freqOptions = new[] { "always", "hourly", "daily", "weekly", "monthly", "yearly", "never" };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">SEO Sitemap</h1>
        <p class="text-muted mb-0">Review sitemap entries, tune crawl priority/frequency, and regenerate the sitemap.</p>
    </div>
    <permission require="@WebPermission.Sitemap.Refresh">
        <form asp-area="Admin" asp-controller="SeoSitemap" asp-action="Regenerate" method="post"
              onsubmit="return confirm('Regenerate the sitemap now?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary-soft">
                <i class="bi bi-arrow-repeat me-1"></i>Regenerate sitemap
            </button>
        </form>
    </permission>
</div>

@if (ViewBag.Error is string vbe)
{
    <div class="alert alert-danger">@vbe</div>
}
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<form asp-area="Admin" asp-controller="SeoSitemap" asp-action="Index" method="get" class="card card-body shadow-sm mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Entity type</label>
            <input type="text" name="EntityType" value="@Model.EntityTypeFilter" class="form-control" placeholder="Tour, Place, ..." />
        </div>
        <div class="col-md-3">
            <label class="form-label">Active</label>
            <select name="IsActive" class="form-select">
                <option value="">All</option>
                <option value="true" selected="@(Model.IsActiveFilter == true)">Active</option>
                <option value="false" selected="@(Model.IsActiveFilter == false)">Inactive</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-secondary w-100">Apply</button>
        </div>
    </div>
</form>

@if (!Model.HasEntries)
{
    <div class="card card-body shadow text-center py-5">
        <img src="~/assets/images/element/17.svg" class="h-80px mb-3 mx-auto" alt="No entries" />
        <h5 class="mb-1">No sitemap entries</h5>
        <p class="text-muted mb-0">Regenerate the sitemap to populate entries, or adjust your filters.</p>
    </div>
}
else
{
    <div class="card shadow">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>URL</th>
                        <th>Entity type</th>
                        <th>Priority</th>
                        <th>Change freq</th>
                        <th>Last modified</th>
                        <th>Active</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Entries)
                    {
                        <tr>
                            <td class="text-truncate" style="max-width: 320px;" title="@e.Url">@e.Url</td>
                            <td>@e.EntityType</td>
                            <td>@(e.Priority?.ToString("0.0##") ?? "—")</td>
                            <td>@(e.ChangeFrequency ?? "—")</td>
                            <td>@(e.LastModified?.ToString("g") ?? "—")</td>
                            <td>
                                @if (e.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <permission require="@WebPermission.Sitemap.Update">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editSitemap-@e.Id">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                </permission>
                                <permission require="@WebPermission.Sitemap.Delete">
                                    <form asp-area="Admin" asp-controller="SeoSitemap" asp-action="Delete" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this sitemap entry?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@e.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger-soft"><i class="bi bi-trash"></i></button>
                                    </form>
                                </permission>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-area="Admin" asp-controller="SeoSitemap" asp-action="Index"
                       asp-route-page="@(Model.Page - 1)" asp-route-entityType="@Model.EntityTypeFilter" asp-route-isActive="@Model.IsActiveFilter">Previous</a>
                </li>
                <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.TotalPages</span></li>
                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-area="Admin" asp-controller="SeoSitemap" asp-action="Index"
                       asp-route-page="@(Model.Page + 1)" asp-route-entityType="@Model.EntityTypeFilter" asp-route-isActive="@Model.IsActiveFilter">Next</a>
                </li>
            </ul>
        </nav>
    }

    <permission require="@WebPermission.Sitemap.Update">
        @foreach (var e in Model.Entries)
        {
            <div class="modal fade" id="editSitemap-@e.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form asp-area="Admin" asp-controller="SeoSitemap" asp-action="Update" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Id" value="@e.Id" />
                            <div class="modal-header">
                                <h5 class="modal-title">Edit sitemap entry</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <p class="small text-muted text-truncate" title="@e.Url">@e.Url</p>
                                <div class="mb-3">
                                    <label class="form-label">Priority</label>
                                    <input type="number" name="Priority" step="0.1" min="0" max="1" value="@(e.Priority?.ToString("0.0##"))" class="form-control" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Change frequency</label>
                                    <select name="ChangeFrequency" class="form-select">
                                        <option value="">— none —</option>
                                        @foreach (var f in freqOptions)
                                        {
                                            <option value="@f" selected="@(string.Equals(e.ChangeFrequency, f, StringComparison.OrdinalIgnoreCase))">@f</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary-soft">Save</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </permission>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
