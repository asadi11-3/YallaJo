@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.Places
@model CreatePlaceVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"]    = Localizer["Admin.PlaceForm.CreateTitle"].Value;
    ViewData["AdminNav"] = "Places";
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">@Localizer["Admin.PlaceForm.CreateTitle"]</h1>
    <a asp-area="Admin" asp-controller="Places" asp-action="Index"
       class="btn btn-outline-secondary mt-3 mt-sm-0">@Localizer["Admin.PlaceForm.Back"]</a>
</div>

<div class="card shadow">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

        <form data-loading asp-area="Admin" asp-controller="Places" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            @* Strongly typed against the shared abstract PlaceFormVm. *@
            <partial name="_Form" model="(PlaceFormVm)Model" />

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@Localizer["Admin.PlaceForm.Create"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Admin.PlaceForm.Cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/yj-map.js" asp-append-version="true"></script>
}
