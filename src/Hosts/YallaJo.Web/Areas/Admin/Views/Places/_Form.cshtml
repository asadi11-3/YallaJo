@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.Places
@using YallaJo.Web.Infrastructure.Maps
@model PlaceFormVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer

@*
    Shared form fields for Create.cshtml and Edit.cshtml. Strongly typed against the abstract
    base PlaceFormVm so both flows reuse the same field layout. The hidden Id input lives in
    Edit.cshtml — it is not part of PlaceFormVm.
*@

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label">@Localizer["Admin.PlaceForm.Name"]</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger" role="alert"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Slug" class="form-label">@Localizer["Admin.PlaceForm.Slug"]</label>
        <input asp-for="Slug" class="form-control" dir="ltr"
               aria-describedby="place-slug-help" placeholder="lowercase-and-hyphens" />
        <span asp-validation-for="Slug" class="text-danger" role="alert"></span>
        <small id="place-slug-help" class="form-text">@Localizer["Admin.PlaceForm.SlugHelp"]</small>
    </div>

    <div class="col-md-4">
        <label asp-for="PlaceType" class="form-label">@Localizer["Admin.PlaceForm.PlaceType"]</label>
        <select asp-for="PlaceType"
                asp-items="Html.GetEnumSelectList<PlaceTypeOption>()"
                class="form-select"></select>
        <span asp-validation-for="PlaceType" class="text-danger" role="alert"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Latitude" class="form-label">@Localizer["Admin.PlaceForm.Latitude"]</label>
        <input asp-for="Latitude" type="number" step="any" class="form-control" dir="ltr" />
        <span asp-validation-for="Latitude" class="text-danger" role="alert"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Longitude" class="form-label">@Localizer["Admin.PlaceForm.Longitude"]</label>
        <input asp-for="Longitude" type="number" step="any" class="form-control" dir="ltr" />
        <span asp-validation-for="Longitude" class="text-danger" role="alert"></span>
    </div>

    <div class="col-12">
        @* V13 maps: click-to-set location picker (renders nothing when Mapbox is disabled). (0,0) = unset. *@
        @{
            var hasPin = Model.Latitude != 0 || Model.Longitude != 0;
        }
        <partial name="_Map" model='new MapVm { Mode = "picker", Latitude = hasPin ? Model.Latitude : (decimal?)null, Longitude = hasPin ? Model.Longitude : (decimal?)null, InputLatSelector = "#Latitude", InputLngSelector = "#Longitude", CssClass = "yj-map-short" }' />
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label">@Localizer["Admin.PlaceForm.Description"]</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger" role="alert"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="Address" class="form-label">@Localizer["Admin.PlaceForm.Address"]</label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger" role="alert"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="PostalCode" class="form-label">@Localizer["Admin.PlaceForm.PostalCode"]</label>
        <input asp-for="PostalCode" class="form-control" dir="ltr" />
        <span asp-validation-for="PostalCode" class="text-danger" role="alert"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="City" class="form-label">@Localizer["Admin.PlaceForm.City"]</label>
        <input asp-for="City" class="form-control" />
        <span asp-validation-for="City" class="text-danger" role="alert"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Country" class="form-label">@Localizer["Admin.PlaceForm.Country"]</label>
        <input asp-for="Country" class="form-control" />
        <span asp-validation-for="Country" class="text-danger" role="alert"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Phone" class="form-label">@Localizer["Admin.PlaceForm.Phone"]</label>
        <input asp-for="Phone" class="form-control" dir="ltr" />
        <span asp-validation-for="Phone" class="text-danger" role="alert"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Email" class="form-label">@Localizer["Admin.PlaceForm.Email"]</label>
        <input asp-for="Email" type="email" class="form-control" dir="ltr" />
        <span asp-validation-for="Email" class="text-danger" role="alert"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Website" class="form-label">@Localizer["Admin.PlaceForm.Website"]</label>
        <input asp-for="Website" type="url" class="form-control" dir="ltr" />
        <span asp-validation-for="Website" class="text-danger" role="alert"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="MetaTitle" class="form-label">@Localizer["Admin.PlaceForm.MetaTitle"]</label>
        <input asp-for="MetaTitle" class="form-control" />
        <span asp-validation-for="MetaTitle" class="text-danger" role="alert"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="MetaDescription" class="form-label">@Localizer["Admin.PlaceForm.MetaDescription"]</label>
        <input asp-for="MetaDescription" class="form-control" />
        <span asp-validation-for="MetaDescription" class="text-danger" role="alert"></span>
    </div>
</div>
