@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Shared
@model YallaJo.Web.Areas.Admin.Models.Places.PlaceListVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    var culture = CultureInfo.CurrentCulture;
}

@if (Model.Items.Count == 0)
{
    <div class="card-body">
        <partial name="Partials/_EmptyState"
                 model="@(new EmptyStateVm { Message = Localizer["Admin.Places.EmptyMessage"].Value, CtaText = Localizer["Admin.Places.EmptyCta"].Value, CtaUrl = Url.Action("Index", "Places", new { area = "Admin" }) })" />
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">@Localizer["Admin.Places.ColName"]</th>
                    <th scope="col">@Localizer["Admin.Places.ColType"]</th>
                    <th scope="col">@Localizer["Admin.Places.ColLocation"]</th>
                    <th scope="col">@Localizer["Admin.Places.ColRating"]</th>
                    <th scope="col">@Localizer["Admin.Places.ColFeatured"]</th>
                    <th scope="col">@Localizer["Admin.Places.ColVerified"]</th>
                    <th scope="col">@Localizer["Admin.Places.ColActions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Items)
                {
                    var location = string.Join(", ",
                        new[] { p.City, p.Country }.Where(s => !string.IsNullOrWhiteSpace(s)));

                    <tr>
                        <td>
                            <span class="fw-semibold">@p.Name</span>
                            <div class="text-secondary small"><bdi dir="ltr">@p.Slug</bdi></div>
                        </td>
                        <td>@p.PlaceType</td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(location))
                            {
                                <span class="text-secondary" aria-label="@Localizer["Admin.Places.NoLocation"]">—</span>
                            }
                            else
                            {
                                @location
                            }
                        </td>
                        <td>
                            <bdi class="font-data">@p.AverageRating.ToString("0.0", culture)</bdi>
                            <span class="text-secondary small">(<bdi class="font-data">@p.ReviewCount.ToString("N0", culture)</bdi>)</span>
                        </td>
                        <td>
                            @if (p.IsFeatured)
                            {
                                <span class="badge bg-warning bg-opacity-10 text-warning">
                                    <i class="fa-solid fa-star fa-fw" aria-hidden="true"></i> @Localizer["Admin.Places.Featured"]
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary">
                                    <i class="fa-solid fa-minus fa-fw" aria-hidden="true"></i> @Localizer["Admin.Places.NotFeatured"]
                                </span>
                            }
                        </td>
                        <td>
                            @if (p.IsVerified)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success">
                                    <i class="fa-solid fa-circle-check fa-fw" aria-hidden="true"></i> @Localizer["Admin.Places.Verified"]
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary">
                                    <i class="fa-solid fa-circle fa-fw" aria-hidden="true"></i> @Localizer["Admin.Places.Unverified"]
                                </span>
                            }
                        </td>
                        <td class="text-nowrap">
                            <div class="btn-group" role="group" aria-label="@Localizer["Admin.Places.RowActionsLabel"]">
                                <permission require="@WebPermission.Place.Read">
                                    <a asp-area="Admin" asp-controller="Places" asp-action="Details" asp-route-id="@p.Id"
                                       class="btn btn-sm btn-outline-secondary">@Localizer["Admin.Places.Manage"]</a>
                                </permission>

                                <permission require="@WebPermission.Place.Update">
                                    <a asp-area="Admin" asp-controller="Places" asp-action="Edit" asp-route-id="@p.Id"
                                       class="btn btn-sm btn-outline-secondary">@Localizer["Admin.Places.Edit"]</a>

                                    <form data-loading asp-area="Admin" asp-controller="Places" asp-action="Feature"
                                          asp-route-id="@p.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="featured" value="@(p.IsFeatured ? "false" : "true")" />
                                        <button type="submit" class="btn btn-sm btn-outline-warning">
                                            @(p.IsFeatured ? Localizer["Admin.Places.Unfeature"] : Localizer["Admin.Places.Feature"])
                                        </button>
                                    </form>

                                    <form data-loading asp-area="Admin" asp-controller="Places" asp-action="Verify"
                                          asp-route-id="@p.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="verified" value="@(p.IsVerified ? "false" : "true")" />
                                        <button type="submit" class="btn btn-sm btn-outline-info">
                                            @(p.IsVerified ? Localizer["Admin.Places.Unverify"] : Localizer["Admin.Places.Verify"])
                                        </button>
                                    </form>
                                </permission>

                                <permission require="@WebPermission.Place.DeleteOwn">
                                    <form data-loading asp-area="Admin" asp-controller="Places" asp-action="Delete"
                                          asp-route-id="@p.Id" method="post" class="d-inline"
                                          data-confirm="@Localizer["Admin.Places.DeleteConfirm", p.Name]"
                                          data-confirm-title="@Localizer["Admin.Places.DeleteTitle"]"
                                          data-confirm-action="@Localizer["Admin.Places.DeleteAction"]" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Admin.Places.Delete"]</button>
                                    </form>
                                </permission>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
