@using YallaJo.Web.Infrastructure.Authorization
@model YallaJo.Web.Areas.Admin.Models.Places.PlaceListVm

<table class="table table-sm table-bordered align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th>Slug</th>
            <th>Type</th>
            <th>City</th>
            <th>Country</th>
            <th>Rating</th>
            <th>Featured</th>
            <th>Verified</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="9" class="text-center text-muted">No places found.</td>
            </tr>
        }
        else
        {
            @foreach (var p in Model.Items)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>@p.Slug</td>
                    <td>@p.PlaceType</td>
                    <td>@(p.City ?? "—")</td>
                    <td>@(p.Country ?? "—")</td>
                    <td>@p.AverageRating.ToString("0.0") <span class="text-muted small">(@p.ReviewCount)</span></td>
                    <td>@(p.IsFeatured ? "✓" : "—")</td>
                    <td>@(p.IsVerified ? "✓" : "—")</td>
                    <td class="text-nowrap">
                        <a asp-area="Admin" asp-controller="Places" asp-action="Details" asp-route-id="@p.Id"
                           class="btn btn-sm btn-outline-secondary">Details</a>

                        <permission require="@WebPermission.Place.Update">
                            <a asp-area="Admin" asp-controller="Places" asp-action="Edit" asp-route-id="@p.Id"
                               class="btn btn-sm btn-outline-secondary">Edit</a>

                            <form asp-area="Admin" asp-controller="Places" asp-action="Feature"
                                  asp-route-id="@p.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="featured" value="@(p.IsFeatured ? "false" : "true")" />
                                <button type="submit" class="btn btn-sm btn-outline-warning">
                                    @(p.IsFeatured ? "Unfeature" : "Feature")
                                </button>
                            </form>

                            <form asp-area="Admin" asp-controller="Places" asp-action="Verify"
                                  asp-route-id="@p.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="verified" value="@(p.IsVerified ? "false" : "true")" />
                                <button type="submit" class="btn btn-sm btn-outline-info">
                                    @(p.IsVerified ? "Unverify" : "Verify")
                                </button>
                            </form>
                        </permission>

                        <permission require="@WebPermission.Place.DeleteOwn">
                            <form asp-area="Admin" asp-controller="Places" asp-action="Delete"
                                  asp-route-id="@p.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Delete this place?');">Delete</button>
                            </form>
                        </permission>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
