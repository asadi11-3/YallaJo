@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Shared
@model YallaJo.Web.Areas.Admin.Models.Places.PlaceListVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"]    = Localizer["Admin.Places.Title"].Value;
    ViewData["AdminNav"] = "Places";

    var culture = CultureInfo.CurrentCulture;
    string Count(int n) => n.ToString("N0", culture);
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Places.Title"]</h1>
        <p class="mb-0 text-secondary">@Localizer["Admin.Places.Subtitle"]</p>
    </div>
    <div class="d-flex align-items-center gap-2 mt-3 mt-sm-0">
        <span class="badge bg-primary bg-opacity-10 text-primary">
            <bdi class="font-data">@Count(Model.TotalCount)</bdi> @Localizer["Admin.Places.TotalLabel"]
        </span>
        <permission require="@WebPermission.Place.Create">
            <a asp-area="Admin" asp-controller="Places" asp-action="Create" class="btn btn-sm btn-primary">
                <i class="fa-solid fa-plus fa-fw" aria-hidden="true"></i> @Localizer["Admin.Places.New"]
            </a>
        </permission>
    </div>
</div>

@* ViewBag.Error renders inside the listing fragment so AJAX fallbacks surface it too. *@

<div class="card shadow mb-4">
    <div class="card-header border-bottom">
        <h2 class="card-header-title h5 mb-0">@Localizer["Admin.Places.FiltersHeading"]</h2>
    </div>
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Places" asp-action="Index" method="get" class="row g-3"
              data-yj-listing>
            <div class="col-md-3">
                <label asp-for="Filter.City" class="form-label">@Localizer["Admin.Places.CityLabel"]</label>
                <input asp-for="Filter.City" class="form-control"
                       placeholder="@Localizer["Admin.Places.CityPlaceholder"]" />
            </div>
            <div class="col-md-3">
                <label asp-for="Filter.Country" class="form-label">@Localizer["Admin.Places.CountryLabel"]</label>
                <input asp-for="Filter.Country" class="form-control"
                       placeholder="@Localizer["Admin.Places.CountryPlaceholder"]" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="Filter_RatingMin">@Localizer["Admin.Places.RatingLabel"]</label>
                <div class="input-group">
                    <input asp-for="Filter.RatingMin" type="number" step="0.1" min="0" max="5"
                           class="form-control" dir="ltr"
                           aria-label="@Localizer["Admin.Places.RatingMinAria"]"
                           placeholder="@Localizer["Admin.Places.RatingMinPlaceholder"]" />
                    <input asp-for="Filter.RatingMax" type="number" step="0.1" min="0" max="5"
                           class="form-control" dir="ltr"
                           aria-label="@Localizer["Admin.Places.RatingMaxAria"]"
                           placeholder="@Localizer["Admin.Places.RatingMaxPlaceholder"]" />
                </div>
            </div>
            <div class="col-md-3">
                <label asp-for="Filter.HasActiveTours" class="form-label">@Localizer["Admin.Places.HasToursLabel"]</label>
                <select asp-for="Filter.HasActiveTours" class="form-select">
                    <option value="">@Localizer["Admin.Places.AnyOption"]</option>
                    <option value="true">@Localizer["Admin.Places.YesOption"]</option>
                    <option value="false">@Localizer["Admin.Places.NoOption"]</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="pageSize" class="form-label">@Localizer["Admin.Places.PageSizeLabel"]</label>
                <select id="pageSize" name="pageSize" class="form-select">
                    @foreach (var size in new[] { 10, 20, 50 })
                    {
                        if (size == Model.PageSize)
                        {
                            <option value="@size" selected>@Count(size)</option>
                        }
                        else
                        {
                            <option value="@size">@Count(size)</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@Localizer["Admin.Places.ApplyFilters"]</button>
                <a asp-area="Admin" asp-controller="Places" asp-action="Index"
                   class="btn btn-outline-secondary">@Localizer["Admin.Places.ClearFilters"]</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow">
    <div class="card-header border-bottom">
        <h2 class="card-header-title h5 mb-0">@Localizer["Admin.Places.DirectoryHeading"]</h2>
    </div>
    @* S1/L1/A11Y9 — listing.js swaps this fragment on filter/pager refinements. *@
    <div id="listingResults" data-yj-component="listing" aria-live="polite" aria-busy="false"
         data-error-text="@Localizer["Public.Results.Error"]"
         data-retry-text="@Localizer["Public.Retry"]"
         data-loading-text="@Localizer["Public.Loading"]">
        <partial name="_PlacesResults" model="Model" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/listing.js" asp-append-version="true" defer></script>
}
