@using System.Globalization
@using YallaJo.Web.Infrastructure.Authorization
@model YallaJo.Web.Areas.Admin.Models.Places.PlaceListVm
@{
    ViewData["Title"] = "Places";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var f = Model.Filter;

    Dictionary<string, string?> RouteValuesFor(int targetPage) => new()
    {
        ["page"]                  = targetPage.ToString(CultureInfo.InvariantCulture),
        ["pageSize"]              = Model.PageSize.ToString(CultureInfo.InvariantCulture),
        ["Filter.CategoryId"]     = f.CategoryId?.ToString(),
        ["Filter.RatingMin"]      = f.RatingMin?.ToString(CultureInfo.InvariantCulture),
        ["Filter.RatingMax"]      = f.RatingMax?.ToString(CultureInfo.InvariantCulture),
        ["Filter.City"]           = f.City,
        ["Filter.Country"]        = f.Country,
        ["Filter.HasActiveTours"] = f.HasActiveTours?.ToString(),
    };
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Places</h2>
        <permission require="@WebPermission.Place.Create">
            <a asp-area="Admin" asp-controller="Places" asp-action="Create"
               class="btn btn-primary">New Place</a>
        </permission>
    </div>

    @* Success/Error flash banners are rendered globally by the shared _Alerts partial (in _Layout). *@
    @if (ViewBag.Error       is string vbe) { <div class="alert alert-danger">@vbe</div> }

    <div class="card mb-3 p-3">
        <form asp-area="Admin" asp-controller="Places" asp-action="Index" method="get" class="row g-2">
            <div class="col-md-3">
                <label asp-for="Filter.City" class="form-label"></label>
                <input asp-for="Filter.City" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="Filter.Country" class="form-label"></label>
                <input asp-for="Filter.Country" class="form-control" />
            </div>
            <div class="col-md-3">
                <label asp-for="Filter.CategoryId" class="form-label"></label>
                <input asp-for="Filter.CategoryId" class="form-control" placeholder="GUID (optional)" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Rating range</label>
                <div class="input-group">
                    <input asp-for="Filter.RatingMin" type="number" step="0.1" min="0" max="5"
                           class="form-control" placeholder="min" />
                    <input asp-for="Filter.RatingMax" type="number" step="0.1" min="0" max="5"
                           class="form-control" placeholder="max" />
                </div>
            </div>
            <div class="col-md-3">
                <label asp-for="Filter.HasActiveTours" class="form-label"></label>
                <select asp-for="Filter.HasActiveTours" class="form-select">
                    <option value="">— any —</option>
                    <option value="true">Yes</option>
                    <option value="false">No</option>
                </select>
            </div>
            <div class="col-md-2">
                <label for="pageSize" class="form-label">Page size</label>
                <select id="pageSize" name="pageSize" class="form-select">
                    @foreach (var size in new[] { 10, 20, 50 })
                    {
                        if (size == Model.PageSize)
                        {
                            <option value="@size" selected>@size</option>
                        }
                        else
                        {
                            <option value="@size">@size</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-7 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary">Filter</button>
                <a asp-area="Admin" asp-controller="Places" asp-action="Index"
                   class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>

    <partial name="_Table" model="Model" />

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Place list pagination">
            <ul class="pagination">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-area="Admin" asp-controller="Places" asp-action="Index"
                       asp-all-route-data="RouteValuesFor(Model.Page - 1)">Previous</a>
                </li>

                <li class="page-item active" aria-current="page">
                    <span class="page-link">Page @Model.Page of @Model.TotalPages (@Model.TotalCount items)</span>
                </li>

                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-area="Admin" asp-controller="Places" asp-action="Index"
                       asp-all-route-data="RouteValuesFor(Model.Page + 1)">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
