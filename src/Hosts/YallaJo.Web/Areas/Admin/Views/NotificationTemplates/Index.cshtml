@using YallaJo.Web.Areas.Admin.Models.NotificationTemplates
@using YallaJo.Web.Infrastructure.Authorization
@model NotificationTemplatesListVm
@{
    ViewData["Title"] = "Notification templates";
    ViewData["AdminNav"] = "NotificationTemplates";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Notification templates</h1>
        <p class="text-body-secondary mb-0">Manage the messaging templates used across channels.</p>
    </div>
    <permission require="@WebPermission.NotificationTemplate.Create">
        <a class="btn btn-primary" asp-area="Admin" asp-controller="NotificationTemplates" asp-action="Create">
            <i class="bi bi-plus-lg me-1"></i>New template
        </a>
    </permission>
</div>

@if (Model.Templates.Count == 0)
{
    <div class="card card-body shadow text-center py-5">
        <img src="~/assets/images/element/17.svg" class="h-100px mb-3" alt="" />
        <p class="text-body-secondary mb-0">No notification templates to display.</p>
    </div>
}
else
{
    <div class="card card-body shadow p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Channel</th>
                        <th>Language</th>
                        <th>Title</th>
                        <th>Updated</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Templates)
                    {
                        var color = NotificationTemplatesMapper.ChannelColor(t.Channel);
                        <tr>
                            <td>@t.Type</td>
                            <td>
                                <span class="badge bg-@color bg-opacity-10 text-@color">@t.Channel</span>
                            </td>
                            <td class="font-data">@t.LanguageCode</td>
                            <td>@t.Title</td>
                            <td class="font-data">@((t.UpdatedAt ?? t.CreatedAt).ToString("g"))</td>
                            <td class="text-end">
                                <permission require="@WebPermission.NotificationTemplate.Update">
                                    <a class="btn btn-sm btn-light" asp-area="Admin" asp-controller="NotificationTemplates" asp-action="Edit" asp-route-id="@t.Id">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </permission>
                                <permission require="@WebPermission.NotificationTemplate.Delete">
                                    <button type="button" class="btn btn-sm btn-light text-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@t.Id">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </permission>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <permission require="@WebPermission.NotificationTemplate.Delete">
        @foreach (var t in Model.Templates)
        {
            <div class="modal fade" id="deleteModal-@t.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form method="post" asp-area="Admin" asp-controller="NotificationTemplates" asp-action="Delete" asp-route-id="@t.Id">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="rowVersion" value="@t.RowVersion" />
                            <div class="modal-header">
                                <h5 class="modal-title">Delete template</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <p class="mb-0">Delete the <strong>@t.Type</strong> (@t.Channel) template? This cannot be undone.</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-danger">Delete template</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </permission>
}
