@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.NotificationTemplates
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Shared
@model NotificationTemplatesListVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.NotificationTemplates.Title"].Value;
    ViewData["AdminNav"] = "NotificationTemplates";

    var culture = CultureInfo.CurrentCulture;
    string Date(DateTime dt) => dt.ToString("yyyy-MM-dd HH:mm", culture);
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.NotificationTemplates.Title"]</h1>
        <p class="text-secondary mb-0">@Localizer["Admin.NotificationTemplates.Subtitle"]</p>
    </div>
    <permission require="@WebPermission.NotificationTemplate.Create">
        <a class="btn btn-primary" asp-area="Admin" asp-controller="NotificationTemplates" asp-action="Create">
            <i class="fa-solid fa-plus fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.NotificationTemplates.New"]
        </a>
    </permission>
</div>

@if (ViewBag.Error is string templatesError && !string.IsNullOrWhiteSpace(templatesError))
{
    <div class="alert alert-danger" role="alert">@templatesError</div>
}

<section class="card shadow" aria-labelledby="templates-heading">
    <div class="card-header border-bottom">
        <h2 id="templates-heading" class="card-header-title h5 mb-0">@Localizer["Admin.NotificationTemplates.Directory"]</h2>
    </div>
    @if (Model.Templates.Count == 0)
    {
        <div class="card-body text-center py-5">
            <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
            <p class="mb-3 text-secondary">@Localizer["Admin.NotificationTemplates.EmptyMessage"]</p>
            <permission require="@WebPermission.NotificationTemplate.Create">
                <a class="btn btn-sm btn-primary-soft" asp-area="Admin" asp-controller="NotificationTemplates" asp-action="Create">@Localizer["Admin.NotificationTemplates.New"]</a>
            </permission>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["Admin.NotificationTemplates.ColType"]</th>
                        <th scope="col">@Localizer["Admin.NotificationTemplates.ColChannel"]</th>
                        <th scope="col">@Localizer["Admin.NotificationTemplates.ColLanguage"]</th>
                        <th scope="col">@Localizer["Admin.NotificationTemplates.ColTitle"]</th>
                        <th scope="col">@Localizer["Admin.NotificationTemplates.ColUpdated"]</th>
                        <th scope="col" class="text-end">@Localizer["Admin.NotificationTemplates.ColActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Templates)
                    {
                        var color = NotificationTemplatesMapper.ChannelColor(t.Channel);
                        var icon = NotificationTemplatesMapper.ChannelIcon(t.Channel);
                        <tr>
                            <td class="fw-semibold">@t.Type</td>
                            <td>
                                <span class="badge bg-@color bg-opacity-10 text-@color">
                                    <i class="fa-solid fa-@icon fa-fw" aria-hidden="true"></i> @t.Channel
                                </span>
                            </td>
                            <td><bdi class="font-data" dir="ltr">@t.LanguageCode</bdi></td>
                            <td>@t.Title</td>
                            <td><bdi class="font-data" dir="ltr">@Date(t.UpdatedAt ?? t.CreatedAt)</bdi></td>
                            <td class="text-end">
                                <permission require="@WebPermission.NotificationTemplate.Update">
                                    <a class="btn btn-sm btn-outline-secondary tap-target" asp-area="Admin" asp-controller="NotificationTemplates" asp-action="Edit" asp-route-id="@t.Id"
                                       aria-label="@Localizer["Admin.NotificationTemplates.Edit"]">
                                        <i class="fa-solid fa-pen fa-fw" aria-hidden="true"></i>
                                    </a>
                                </permission>
                                <permission require="@WebPermission.NotificationTemplate.Delete">
                                    <button type="button" class="btn btn-sm btn-outline-danger tap-target" data-bs-toggle="modal"
                                            data-bs-target="#deleteTemplate-@t.Id.ToString("N")" aria-label="@Localizer["Admin.NotificationTemplates.Delete"]">
                                        <i class="fa-solid fa-trash fa-fw" aria-hidden="true"></i>
                                    </button>
                                </permission>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<permission require="@WebPermission.NotificationTemplate.Delete">
    @foreach (var t in Model.Templates)
    {
        var titleId = $"deleteTemplateTitle-{t.Id:N}";
        var bodyId = $"deleteTemplateBody-{t.Id:N}";
        <div class="modal fade" id="deleteTemplate-@t.Id.ToString("N")" tabindex="-1"
             aria-labelledby="@titleId" aria-describedby="@bodyId" aria-hidden="true"
             data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <form data-loading method="post" asp-area="Admin" asp-controller="NotificationTemplates" asp-action="Delete" asp-route-id="@t.Id"
                      class="modal-content" role="dialog" aria-modal="true" aria-labelledby="@titleId">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="rowVersion" value="@t.RowVersion" />
                    <partial name="Partials/_ModalHeader"
                             model="@(new ModalHeaderVm { TitleId = titleId, Title = Localizer["Admin.NotificationTemplates.DeleteTitle"].Value, CloseLabel = Localizer["Admin.NotificationTemplates.Close"].Value })" />
                    <div class="modal-body" id="@bodyId">
                        <p class="mb-0">@Localizer["Admin.NotificationTemplates.DeleteBody", t.Type, t.Channel]</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.NotificationTemplates.Cancel"]</button>
                        <button type="submit" class="btn btn-danger">@Localizer["Admin.NotificationTemplates.DeleteSubmit"]</button>
                    </div>
                </form>
            </div>
        </div>
    }
</permission>
