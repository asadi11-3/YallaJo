@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.NotificationTemplates
@using YallaJo.Web.Infrastructure.Authorization
@model NotificationTemplateEditVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Model.IsNew
        ? Localizer["Admin.NotificationTemplates.CreateTitle"].Value
        : Localizer["Admin.NotificationTemplates.EditTitle"].Value;
    ViewData["AdminNav"] = "NotificationTemplates";

    var channels = new[] { "InApp", "Push", "Email", "Sms" };
    var types = new[]
    {
        "WelcomeEmail", "EmailVerification", "PasswordResetRequested", "PasswordChanged", "ProfileUpdated",
        "AccountDeactivated", "AccountReactivated", "BookingConfirmed", "BookingCancelled", "BookingCompleted",
        "BookingReminderUpcoming", "ProviderBookingReceived", "ProviderBookingCancelled", "PaymentCompleted",
        "PaymentFailed", "RefundInitiated", "RefundCompleted", "PayoutScheduled", "PayoutCompleted", "PayoutFailed",
        "ReviewPosted", "ReviewReplied", "ReviewAutoHidden", "ReportResolved", "SupportTicketCreated",
        "SupportTicketResolved", "OtpDelivery", "SecurityAlert", "LoginFromNewDevice", "TwoFactorEnabled",
        "Business", "ProviderApproved", "ProviderRejected", "ProviderSuspended", "ProviderReinstated",
        "GuideApplicationApproved", "GuideApplicationRejected", "TourProposalApproved", "TourProposalRejected",
        "NewGuideApplication", "NewJoinRequest", "JoinRequestApproved", "JoinRequestRejected",
        "AgencyAffiliationCreated", "AgencyAffiliationApproved", "GuideOfferingSuspended", "GuideApplicationSubmitted"
    };

    var formAction = Model.IsNew ? "Create" : "Update";
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
        <p class="text-secondary mb-0">
            @(Model.IsNew ? Localizer["Admin.NotificationTemplates.CreateSubtitle"] : Localizer["Admin.NotificationTemplates.EditSubtitle"])
        </p>
    </div>
    <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="NotificationTemplates" asp-action="Index">@Localizer["Admin.NotificationTemplates.Back"]</a>
</div>

<section class="card shadow" aria-labelledby="template-form-heading">
    <div class="card-header border-bottom">
        <h2 id="template-form-heading" class="card-header-title h5 mb-0">@Localizer["Admin.NotificationTemplates.FormHeading"]</h2>
    </div>
    <div class="card-body">
        <form method="post" asp-area="Admin" asp-controller="NotificationTemplates" asp-action="@formAction" asp-route-id="@(Model.IsNew ? null : Model.Id?.ToString())">
            @Html.AntiForgeryToken()

            @if (Model.IsNew)
            {
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label" for="Type">@Localizer["Admin.NotificationTemplates.TypeLabel"]</label>
                        <select class="form-select" id="Type" name="Type" required>
                            <option value="">@Localizer["Admin.NotificationTemplates.TypePlaceholder"]</option>
                            @foreach (var type in types)
                            {
                                <option value="@type" selected="@(type == Model.Type)">@type</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="Channel">@Localizer["Admin.NotificationTemplates.ChannelLabel"]</label>
                        <select class="form-select" id="Channel" name="Channel" required>
                            <option value="">@Localizer["Admin.NotificationTemplates.ChannelPlaceholder"]</option>
                            @foreach (var channel in channels)
                            {
                                <option value="@channel" selected="@(channel == Model.Channel)">@channel</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="LanguageCode">@Localizer["Admin.NotificationTemplates.LanguageLabel"]</label>
                        <input class="form-control" id="LanguageCode" name="LanguageCode" value="@Model.LanguageCode" dir="ltr"
                               aria-describedby="language-help" required />
                        <small id="language-help" class="form-text">@Localizer["Admin.NotificationTemplates.LanguageHelp"]</small>
                    </div>
                </div>
            }
            else
            {
                <input type="hidden" name="RowVersion" value="@Model.RowVersion" />
                <dl class="row mb-3">
                    <dt class="col-sm-3">@Localizer["Admin.NotificationTemplates.TypeLabel"]</dt>
                    <dd class="col-sm-9 fw-semibold">@Model.Type</dd>
                    <dt class="col-sm-3">@Localizer["Admin.NotificationTemplates.ChannelLabel"]</dt>
                    <dd class="col-sm-9">@Model.Channel</dd>
                    <dt class="col-sm-3">@Localizer["Admin.NotificationTemplates.LanguageLabel"]</dt>
                    <dd class="col-sm-9"><bdi class="font-data" dir="ltr">@Model.LanguageCode</bdi></dd>
                </dl>
            }

            <div class="mb-3">
                <label class="form-label" for="Title">@Localizer["Admin.NotificationTemplates.TitleLabel"]</label>
                <input class="form-control" id="Title" name="Title" value="@Model.Title" required />
            </div>

            <div class="mb-3">
                <label class="form-label" for="Body">@Localizer["Admin.NotificationTemplates.BodyLabel"]</label>
                <textarea class="form-control" id="Body" name="Body" rows="8" aria-describedby="body-help" required>@Model.Body</textarea>
                <small id="body-help" class="form-text">@Localizer["Admin.NotificationTemplates.BodyHelp"]</small>
            </div>

            <div class="mb-3">
                <label class="form-label" for="HtmlBody">@Localizer["Admin.NotificationTemplates.HtmlBodyLabel"]</label>
                <textarea class="form-control font-data" id="HtmlBody" name="HtmlBody" rows="10" dir="ltr">@Model.HtmlBody</textarea>
            </div>

            <div class="d-flex gap-2">
                <permission require="@(Model.IsNew ? WebPermission.NotificationTemplate.Create : WebPermission.NotificationTemplate.Update)">
                    <button type="submit" class="btn btn-primary">
                        @(Model.IsNew ? Localizer["Admin.NotificationTemplates.CreateSubmit"] : Localizer["Admin.NotificationTemplates.Save"])
                    </button>
                </permission>
                <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="NotificationTemplates" asp-action="Index">@Localizer["Admin.NotificationTemplates.Cancel"]</a>
            </div>
        </form>
    </div>
</section>
