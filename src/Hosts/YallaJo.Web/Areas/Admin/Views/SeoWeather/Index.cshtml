@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.SeoWeather
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Shared
@using YallaJo.Web.Infrastructure.Maps
@model SeoWeatherVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.SeoWeather.Title"].Value;
    ViewData["AdminNav"] = "SeoWeather";
    var culture = CultureInfo.CurrentCulture;
    string Num(decimal? v, string suffix = "") => v.HasValue ? v.Value.ToString("0.##", culture) + suffix : "—";
    string Int(int? v, string suffix = "") => v.HasValue ? v.Value.ToString("N0", culture) + suffix : "—";
    string Date(DateTime d) => d.ToString("yyyy-MM-dd HH:mm", culture);
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.SeoWeather.Title"]</h1>
        <p class="text-secondary mb-0">@Localizer["Admin.SeoWeather.Subtitle"]</p>
    </div>
</div>

@if (ViewBag.Error is string vbe)
{
    <div class="alert alert-danger" role="alert">@vbe</div>
}
<div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

<section class="card shadow mb-4" aria-labelledby="weather-lookup-heading">
    <div class="card-header border-bottom">
        <h2 id="weather-lookup-heading" class="card-header-title h5 mb-0">@Localizer["Admin.SeoWeather.LookupHeading"]</h2>
    </div>
    <div class="card-body">
        <form asp-area="Admin" asp-controller="SeoWeather" asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-8">
                <label class="form-label" for="PlaceId">@Localizer["Admin.SeoWeather.PlaceLabel"]</label>
                <select class="form-select" id="PlaceId" name="PlaceId" aria-describedby="weather-place-help">
                    <option value="">@Localizer["Admin.SeoWeather.PlacePlaceholder"]</option>
                    @foreach (var p in Model.PlaceOptions)
                    {
                        @if (Model.PlaceId == p.Id)
                        {
                            <option value="@p.Id" selected>@p.Name</option>
                        }
                        else
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    }
                </select>
                <small id="weather-place-help" class="form-text">@Localizer["Admin.SeoWeather.PlaceHelp"]</small>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary-soft w-100">@Localizer["Admin.SeoWeather.Load"]</button>
            </div>
        </form>
        @if (!Model.PlaceOptions.Any())
        {
            <p class="text-secondary small mb-0 mt-2">@Localizer["Admin.SeoWeather.NoPlaces"]</p>
        }
    </div>
</section>

@if (Model.HasQueried)
{
    @if (Model.Exists && Model.Weather is not null)
    {
        var w = Model.Weather;
        <section class="card shadow mb-4" aria-labelledby="weather-snapshot-heading">
            <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                <h2 id="weather-snapshot-heading" class="card-header-title h5 mb-0">@Localizer["Admin.SeoWeather.SnapshotHeading"]</h2>
                @if (w.IsStale)
                {
                    <span class="badge bg-warning bg-opacity-10 text-warning">
                        <i class="fa-solid fa-clock-rotate-left fa-fw" aria-hidden="true"></i> @(w.StaleHumanLabel ?? Localizer["Admin.SeoWeather.Stale"].Value)
                    </span>
                }
                else
                {
                    <span class="badge bg-success bg-opacity-10 text-success">
                        <i class="fa-solid fa-circle-check fa-fw" aria-hidden="true"></i> @Localizer["Admin.SeoWeather.Fresh"]
                    </span>
                }
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6 col-lg-3"><div class="small text-secondary">@Localizer["Admin.SeoWeather.Condition"]</div><div class="fw-semibold">@(string.IsNullOrWhiteSpace(w.Condition) ? "—" : w.Condition)</div></div>
                    <div class="col-sm-6 col-lg-3"><div class="small text-secondary">@Localizer["Admin.SeoWeather.Temperature"]</div><div class="fw-semibold"><bdi dir="ltr" class="font-data">@Num(w.Temperature, "°")</bdi></div></div>
                    <div class="col-sm-6 col-lg-3"><div class="small text-secondary">@Localizer["Admin.SeoWeather.FeelsLike"]</div><div class="fw-semibold"><bdi dir="ltr" class="font-data">@Num(w.FeelsLike, "°")</bdi></div></div>
                    <div class="col-sm-6 col-lg-3"><div class="small text-secondary">@Localizer["Admin.SeoWeather.Humidity"]</div><div class="fw-semibold"><bdi dir="ltr" class="font-data">@Int(w.Humidity, "%")</bdi></div></div>
                    <div class="col-sm-6 col-lg-3"><div class="small text-secondary">@Localizer["Admin.SeoWeather.WindSpeed"]</div><div class="fw-semibold"><bdi dir="ltr" class="font-data">@Num(w.WindSpeed)</bdi></div></div>
                    <div class="col-sm-6 col-lg-3"><div class="small text-secondary">@Localizer["Admin.SeoWeather.WindDirection"]</div><div class="fw-semibold"><bdi dir="ltr" class="font-data">@Int(w.WindDirection, "°")</bdi></div></div>
                    <div class="col-sm-6 col-lg-3"><div class="small text-secondary">@Localizer["Admin.SeoWeather.UvIndex"]</div><div class="fw-semibold"><bdi dir="ltr" class="font-data">@Num(w.UvIndex)</bdi></div></div>
                    <div class="col-sm-6 col-lg-3"><div class="small text-secondary">@Localizer["Admin.SeoWeather.Fetched"]</div><div class="fw-semibold"><bdi dir="ltr" class="font-data">@Date(w.FetchedAt)</bdi></div></div>
                    <div class="col-sm-6 col-lg-3"><div class="small text-secondary">@Localizer["Admin.SeoWeather.Expires"]</div><div class="fw-semibold"><bdi dir="ltr" class="font-data">@Date(w.ExpiresAt)</bdi></div></div>
                </div>

                <permission require="@WebPermission.Weather.Delete">
                    <form data-loading asp-area="Admin" asp-controller="SeoWeather" asp-action="Purge" method="post" class="mt-3"
                          data-confirm="@Localizer["Admin.SeoWeather.PurgeConfirm"].Value"
                          data-confirm-title="@Localizer["Admin.SeoWeather.PurgeTitle"].Value"
                          data-confirm-action="@Localizer["Admin.SeoWeather.Purge"].Value" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="placeId" value="@Model.PlaceId" />
                        <button type="submit" class="btn btn-sm btn-danger-soft">
                            <i class="fa-solid fa-trash fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.SeoWeather.Purge"]
                        </button>
                    </form>
                </permission>
            </div>
        </section>
    }
    else
    {
        <partial name="Partials/_EmptyState"
                 model="@(new EmptyStateVm { Message = Localizer["Admin.SeoWeather.NoSnapshot"].Value, ContainerClass = "card card-body shadow text-center py-5 mb-4", ImageClass = "h-80px mb-3 mx-auto" })" />
    }

    <permission require="@WebPermission.Weather.Refresh">
        <section class="card shadow mb-4" aria-labelledby="weather-refresh-heading">
            <div class="card-header border-bottom">
                <h2 id="weather-refresh-heading" class="card-header-title h5 mb-0">@Localizer["Admin.SeoWeather.RefreshHeading"]</h2>
            </div>
            <div class="card-body">
                <form data-loading asp-area="Admin" asp-controller="SeoWeather" asp-action="Refresh" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RefreshForm.PlaceId" value="@(Model.PlaceId ?? Guid.Empty)" />
                    <div class="col-md-4">
                        <label class="form-label" for="weather-lat">@Localizer["Admin.SeoWeather.LatitudeLabel"]</label>
                        <input class="form-control" id="weather-lat" asp-for="RefreshForm.Latitude" type="number" step="any" dir="ltr" />
                        <span asp-validation-for="RefreshForm.Latitude" class="text-danger small" role="alert"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="weather-lng">@Localizer["Admin.SeoWeather.LongitudeLabel"]</label>
                        <input class="form-control" id="weather-lng" asp-for="RefreshForm.Longitude" type="number" step="any" dir="ltr" />
                        <span asp-validation-for="RefreshForm.Longitude" class="text-danger small" role="alert"></span>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary-soft w-100">
                            <i class="fa-solid fa-arrows-rotate fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.SeoWeather.RefreshNow"]
                        </button>
                    </div>
                    <div class="col-12">
                        @* V13 maps: pick the refresh coordinates on a map (renders nothing when Mapbox is disabled). (0,0) = unset. *@
                        @{
                            var hasPin = Model.RefreshForm.Latitude != 0 || Model.RefreshForm.Longitude != 0;
                        }
                        <partial name="_Map" model='new MapVm { Mode = "picker", Latitude = hasPin ? Model.RefreshForm.Latitude : (decimal?)null, Longitude = hasPin ? Model.RefreshForm.Longitude : (decimal?)null, InputLatSelector = "#weather-lat", InputLngSelector = "#weather-lng", CssClass = "yj-map-short" }' />
                    </div>
                </form>
            </div>
        </section>
    </permission>
}
<permission require="@WebPermission.Weather.Update">
    <section class="card shadow mb-4" aria-labelledby="weather-budget-heading">
        <div class="card-header border-bottom">
            <h2 id="weather-budget-heading" class="card-header-title h5 mb-0">@Localizer["Admin.SeoWeather.BudgetHeading"]</h2>
        </div>
        <div class="card-body">
            <p class="text-secondary small mb-3">@Localizer["Admin.SeoWeather.BudgetHint"]</p>
            <form data-loading asp-area="Admin" asp-controller="SeoWeather" asp-action="ResetBudget" method="post" class="row g-3 align-items-end"
                  data-confirm="@Localizer["Admin.SeoWeather.ResetBudgetConfirm"].Value"
                  data-confirm-title="@Localizer["Admin.SeoWeather.ResetBudgetTitle"].Value"
                  data-confirm-action="@Localizer["Admin.SeoWeather.ResetBudget"].Value" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                @Html.AntiForgeryToken()
                <div class="col-md-4">
                    <label class="form-label" for="weather-budget-date">@Localizer["Admin.SeoWeather.BudgetDateLabel"]</label>
                    <input class="form-control" id="weather-budget-date" asp-for="BudgetForm.Date" type="date" dir="ltr" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-outline-secondary w-100">
                        <i class="fa-solid fa-rotate-left fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.SeoWeather.ResetBudget"]
                    </button>
                </div>
            </form>
        </div>
    </section>
</permission>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/yj-map.js" asp-append-version="true"></script>
}
