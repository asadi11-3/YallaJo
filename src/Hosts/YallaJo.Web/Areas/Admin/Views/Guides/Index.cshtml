@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.Guides
@using YallaJo.Web.Infrastructure.Authorization
@model GuidesVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Guides.Title"].Value;
    ViewData["AdminNav"] = "Guides";
    var culture = CultureInfo.CurrentCulture;
    string Count(int n) => n.ToString("N0", culture);
    string Rating(decimal d) => d.ToString("N1", culture);
    var detail = Model.Detail;
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Guides.Title"]</h1>
        <p class="text-secondary mb-0">@Localizer["Admin.Guides.Subtitle"]</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(ViewBag.Error as string))
{
    <div class="alert alert-danger" role="alert">@ViewBag.Error</div>
}

<section class="card shadow mb-4" aria-labelledby="guide-picker-heading">
    <div class="card-header border-bottom">
        <h2 id="guide-picker-heading" class="card-header-title h5 mb-0">@Localizer["Admin.Guides.PickerHeading"]</h2>
    </div>
    <div class="card-body">
        @if (Model.GuideOptions.Count > 0)
        {
            <form method="get" asp-area="Admin" asp-controller="Guides" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-sm-8 col-md-6">
                    <label for="id" class="form-label">@Localizer["Admin.Guides.SelectLabel"]</label>
                    <select id="id" name="id" class="form-select" aria-describedby="guide-select-help">
                        <option value="">@Localizer["Admin.Guides.SelectPlaceholder"]</option>
                        @foreach (var option in Model.GuideOptions)
                        {
                            if (Model.LookupId == option.Id)
                            {
                                <option value="@option.Id" selected>@option.Name</option>
                            }
                            else
                            {
                                <option value="@option.Id">@option.Name</option>
                            }
                        }
                    </select>
                    <small id="guide-select-help" class="form-text">@Localizer["Admin.Guides.SelectHelp"]</small>
                </div>
                <div class="col-sm-4 col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">@Localizer["Admin.Guides.LookUp"]</button>
                    <a asp-area="Admin" asp-controller="Guides" asp-action="Index" class="btn btn-outline-secondary">@Localizer["Admin.Guides.Reset"]</a>
                </div>
            </form>
        }
        else
        {
            <div class="text-center py-5">
                <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
                <p class="mb-0 text-secondary">@Localizer["Admin.Guides.NoGuides"]</p>
            </div>
        }
    </div>
</section>

@if (detail is not null)
{
    <section class="card shadow mb-4" aria-labelledby="guide-detail-heading">
        <div class="card-header border-bottom d-flex justify-content-between align-items-start gap-2">
            <h2 id="guide-detail-heading" class="card-header-title h5 mb-0">
                @(string.IsNullOrWhiteSpace(detail.DisplayName) ? Localizer["Admin.Guides.UnnamedGuide"].Value : detail.DisplayName)
            </h2>
            @if (detail.HasFirstAid)
            {
                <span class="badge bg-success bg-opacity-10 text-success">
                    <i class="fa-solid fa-kit-medical fa-fw" aria-hidden="true"></i> @Localizer["Admin.Guides.FirstAidYes"]
                </span>
            }
            else
            {
                <span class="badge bg-secondary bg-opacity-10 text-secondary">
                    <i class="fa-solid fa-circle-minus fa-fw" aria-hidden="true"></i> @Localizer["Admin.Guides.FirstAidNo"]
                </span>
            }
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">@Localizer["Admin.Guides.Account"]</dt>
                <dd class="col-sm-9">
                    @if (string.IsNullOrWhiteSpace(detail.UserEmail))
                    {
                        <span class="text-secondary">@Localizer["Admin.Guides.UnknownAccount"]</span>
                    }
                    else
                    {
                        <bdi dir="ltr">@detail.UserEmail</bdi>
                    }
                </dd>

                <dt class="col-sm-3">@Localizer["Admin.Guides.Experience"]</dt>
                <dd class="col-sm-9"><bdi class="font-data" dir="ltr">@Count(detail.YearsOfExperience)</bdi></dd>

                <dt class="col-sm-3">@Localizer["Admin.Guides.Rating"]</dt>
                <dd class="col-sm-9">
                    <bdi class="font-data" dir="ltr">@Rating(detail.AverageRating)</bdi>
                    <span class="text-secondary">(<bdi class="font-data" dir="ltr">@Count(detail.ReviewCount)</bdi> @Localizer["Admin.Guides.Reviews"])</span>
                </dd>

                <dt class="col-sm-3">@Localizer["Admin.Guides.Tours"]</dt>
                <dd class="col-sm-9"><bdi class="font-data" dir="ltr">@Count(detail.TourCount)</bdi></dd>

                @if (!string.IsNullOrWhiteSpace(detail.MoTALicenseNumber))
                {
                    <dt class="col-sm-3">@Localizer["Admin.Guides.License"]</dt>
                    <dd class="col-sm-9"><bdi class="font-data" dir="ltr">@detail.MoTALicenseNumber</bdi></dd>
                }

                @if (detail.Languages.Count > 0)
                {
                    <dt class="col-sm-3">@Localizer["Admin.Guides.Languages"]</dt>
                    <dd class="col-sm-9">
                        @foreach (var lang in detail.Languages)
                        {
                            <span class="badge bg-info bg-opacity-10 text-info me-1">@lang</span>
                        }
                    </dd>
                }

                @if (detail.Specializations.Count > 0)
                {
                    <dt class="col-sm-3">@Localizer["Admin.Guides.Specializations"]</dt>
                    <dd class="col-sm-9">
                        @foreach (var spec in detail.Specializations)
                        {
                            <span class="badge bg-secondary bg-opacity-10 text-secondary me-1">@spec</span>
                        }
                    </dd>
                }

                @if (!string.IsNullOrWhiteSpace(detail.Bio))
                {
                    <dt class="col-sm-3">@Localizer["Admin.Guides.Bio"]</dt>
                    <dd class="col-sm-9">@detail.Bio</dd>
                }
            </dl>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <permission require="@WebPermission.TourGuideProfile.Update">
                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editGuideModal">
                        <i class="fa-solid fa-pen fa-fw" aria-hidden="true"></i>
                        <span>@Localizer["Admin.Guides.EditProfile"]</span>
                    </button>
                </permission>
                <permission require="@WebPermission.TourGuideProfile.Suspend">
                    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#suspendModal">
                        <i class="fa-solid fa-ban fa-fw" aria-hidden="true"></i>
                        <span>@Localizer["Admin.Guides.Suspend"]</span>
                    </button>
                </permission>
                <permission require="@WebPermission.TourGuideProfile.Reinstate">
                    <form method="post" asp-area="Admin" asp-controller="Guides" asp-action="Reinstate" asp-route-id="@detail.Id"
                          data-confirm="@Localizer["Admin.Guides.ReinstateConfirm"]"
                          data-confirm-title="@Localizer["Admin.Guides.ReinstateTitle"]"
                          data-confirm-action="@Localizer["Admin.Guides.Reinstate"]">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-success">
                            <i class="fa-solid fa-circle-play fa-fw" aria-hidden="true"></i>
                            <span>@Localizer["Admin.Guides.Reinstate"]</span>
                        </button>
                    </form>
                </permission>
                <permission require="@WebPermission.TourGuideProfile.DeleteAny">
                    <button type="button" class="btn btn-outline-danger ms-auto" data-bs-toggle="modal" data-bs-target="#deleteGuideModal">
                        <i class="fa-solid fa-user-slash fa-fw" aria-hidden="true"></i>
                        <span>@Localizer["Admin.Guides.Deactivate"]</span>
                    </button>
                </permission>
            </div>
        </div>
    </section>

    @* Edit guide profile (§8.14) *@
    <permission require="@WebPermission.TourGuideProfile.Update">
        <div class="modal fade" id="editGuideModal" tabindex="-1" aria-labelledby="editGuideLabel" aria-describedby="editGuideBody" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form method="post" asp-area="Admin" asp-controller="Guides" asp-action="Edit" asp-route-id="@detail.Id"
                      class="modal-content" role="dialog" aria-modal="true" aria-labelledby="editGuideLabel">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h2 class="modal-title h5 mb-0" id="editGuideLabel">@Localizer["Admin.Guides.EditTitle"]</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Admin.Guides.Close"]"></button>
                    </div>
                    <div class="modal-body" id="editGuideBody">
                        <div class="mb-3">
                            <label class="form-label" for="edit-years">@Localizer["Admin.Guides.Experience"]</label>
                            <input type="number" min="0" max="80" class="form-control font-data" dir="ltr"
                                   id="edit-years" name="YearsOfExperience" value="@detail.YearsOfExperience" />
                        </div>
                        <div class="form-check mb-3">
                            <input type="checkbox" class="form-check-input" id="edit-firstaid"
                                   name="HasFirstAid" value="true" @(detail.HasFirstAid ? "checked" : "") />
                            <label class="form-check-label" for="edit-firstaid">@Localizer["Admin.Guides.FirstAidLabel"]</label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="edit-license">@Localizer["Admin.Guides.License"]</label>
                            <input type="text" maxlength="100" class="form-control font-data" dir="ltr"
                                   id="edit-license" name="MoTALicenseNumber" value="@detail.MoTALicenseNumber" />
                        </div>
                        <div class="mb-1">
                            <label class="form-label" for="edit-bio">@Localizer["Admin.Guides.Bio"]</label>
                            <textarea class="form-control" id="edit-bio" name="Bio" rows="4" maxlength="2000">@detail.Bio</textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.Guides.Cancel"]</button>
                        <button type="submit" class="btn btn-primary">@Localizer["Admin.Guides.Save"]</button>
                    </div>
                </form>
            </div>
        </div>
    </permission>

    @* Suspend guide (§8.14 — reason required) *@
    <permission require="@WebPermission.TourGuideProfile.Suspend">
        <div class="modal fade" id="suspendModal" tabindex="-1" aria-labelledby="suspendLabel" aria-describedby="suspendBody"
             aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <form method="post" asp-area="Admin" asp-controller="Guides" asp-action="Suspend" asp-route-id="@detail.Id"
                      class="modal-content" role="dialog" aria-modal="true" aria-labelledby="suspendLabel">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h2 class="modal-title h5 mb-0" id="suspendLabel">@Localizer["Admin.Guides.SuspendTitle"]</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Admin.Guides.Close"]"></button>
                    </div>
                    <div class="modal-body" id="suspendBody">
                        <label for="suspend-reason" class="form-label">@Localizer["Admin.Guides.ReasonLabel"]</label>
                        <textarea id="suspend-reason" name="reason" class="form-control" rows="3" maxlength="1000" required
                                  aria-describedby="suspend-reason-help"></textarea>
                        <small id="suspend-reason-help" class="form-text">@Localizer["Admin.Guides.ReasonHelp"]</small>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.Guides.Cancel"]</button>
                        <button type="submit" class="btn btn-danger">@Localizer["Admin.Guides.Suspend"]</button>
                    </div>
                </form>
            </div>
        </div>
    </permission>

    @* Deactivate guide (§8.14 — destructive, MOD3 static backdrop, MOD4 alertdialog) *@
    <permission require="@WebPermission.TourGuideProfile.DeleteAny">
        <div class="modal fade" id="deleteGuideModal" tabindex="-1" aria-labelledby="deleteGuideLabel" aria-describedby="deleteGuideBody"
             aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <form method="post" asp-area="Admin" asp-controller="Guides" asp-action="Delete" asp-route-id="@detail.Id"
                      class="modal-content" role="alertdialog" aria-modal="true" aria-labelledby="deleteGuideLabel">
                    @Html.AntiForgeryToken()
                    <div class="modal-header bg-danger text-white">
                        <h2 class="modal-title h5 mb-0" id="deleteGuideLabel">@Localizer["Admin.Guides.DeactivateTitle"]</h2>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@Localizer["Admin.Guides.Close"]"></button>
                    </div>
                    <div class="modal-body" id="deleteGuideBody">
                        <p class="mb-0">
                            @Localizer["Admin.Guides.DeactivateBody", string.IsNullOrWhiteSpace(detail.DisplayName) ? Localizer["Admin.Guides.ThisGuide"].Value : detail.DisplayName]
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.Guides.Cancel"]</button>
                        <button type="submit" class="btn btn-danger">@Localizer["Admin.Guides.Deactivate"]</button>
                    </div>
                </form>
            </div>
        </div>
    </permission>
}
else if (Model.LookupId is not null)
{
    <div class="card shadow">
        <div class="card-body text-center py-5">
            <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
            <p class="mb-0 text-secondary">@Localizer["Admin.Guides.NotFound"]</p>
        </div>
    </div>
}
