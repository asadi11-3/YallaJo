@using YallaJo.Web.Areas.Admin.Models.Guides
@using YallaJo.Web.Infrastructure.Authorization
@model GuidesVm
@{
    ViewData["Title"] = "Tour guides";
    ViewData["AdminNav"] = "Guides";
    var detail = Model.Detail;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Tour guides</h1>
        <p class="text-secondary mb-0">Look up a tour guide by ID to review and moderate their profile.</p>
    </div>
</div>

<div class="card card-body shadow p-4 mb-4">
    <form method="get" asp-area="Admin" asp-controller="Guides" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-sm-8 col-md-6">
            <label for="id" class="form-label small fw-semibold">Guide ID</label>
            <input type="text" id="id" name="id" value="@Model.LookupId?.ToString("D")"
                   class="form-control font-data" placeholder="00000000-0000-0000-0000-000000000000" />
        </div>
        <div class="col-sm-4 col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Look up</button>
            <a asp-area="Admin" asp-controller="Guides" asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

@if (detail is not null)
{
    <div class="card card-body shadow p-4">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <div>
                <h2 class="h4 mb-1">@(string.IsNullOrWhiteSpace(detail.DisplayName) ? "Unnamed guide" : detail.DisplayName)</h2>
                <span class="text-secondary font-data">@detail.Id.ToString("D")</span>
            </div>
            @if (detail.HasFirstAid)
            {
                <span class="badge bg-success bg-opacity-10 text-success">First aid certified</span>
            }
            else
            {
                <span class="badge bg-secondary bg-opacity-10 text-secondary">No first aid record</span>
            }
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-3">User ID</dt>
            <dd class="col-sm-9 font-data">@detail.UserId.ToString("D")</dd>

            <dt class="col-sm-3">Years of experience</dt>
            <dd class="col-sm-9 font-data">@detail.YearsOfExperience</dd>

            <dt class="col-sm-3">Average rating</dt>
            <dd class="col-sm-9 font-data">@detail.AverageRating.ToString("N1") <span class="text-secondary">(@detail.ReviewCount reviews)</span></dd>

            <dt class="col-sm-3">Tours</dt>
            <dd class="col-sm-9 font-data">@detail.TourCount</dd>

            @if (!string.IsNullOrWhiteSpace(detail.MoTALicenseNumber))
            {
                <dt class="col-sm-3">MoTA license</dt>
                <dd class="col-sm-9 font-data">@detail.MoTALicenseNumber</dd>
            }

            @if (detail.Languages.Count > 0)
            {
                <dt class="col-sm-3">Languages</dt>
                <dd class="col-sm-9">
                    @foreach (var lang in detail.Languages)
                    {
                        <span class="badge bg-info bg-opacity-10 text-info me-1">@lang</span>
                    }
                </dd>
            }

            @if (detail.Specializations.Count > 0)
            {
                <dt class="col-sm-3">Specializations</dt>
                <dd class="col-sm-9">
                    @foreach (var spec in detail.Specializations)
                    {
                        <span class="badge bg-secondary bg-opacity-10 text-secondary me-1">@spec</span>
                    }
                </dd>
            }

            @if (!string.IsNullOrWhiteSpace(detail.Bio))
            {
                <dt class="col-sm-3">Bio</dt>
                <dd class="col-sm-9">@detail.Bio</dd>
            }
        </dl>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <permission require="@WebPermission.TourGuideProfile.Update">
                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editGuideModal">
                    <i class="fa-solid fa-pen fa-fw" aria-hidden="true"></i>
                    <span>Edit profile</span>
                </button>
            </permission>
            <permission require="@WebPermission.TourGuideProfile.Suspend">
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#suspendModal">
                    Suspend guide
                </button>
            </permission>
            <permission require="@WebPermission.TourGuideProfile.Reinstate">
                <form method="post" asp-area="Admin" asp-controller="Guides" asp-action="Reinstate" asp-route-id="@detail.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-success">Reinstate guide</button>
                </form>
            </permission>
            <permission require="@WebPermission.TourGuideProfile.DeleteAny">
                <button type="button" class="btn btn-outline-danger ms-auto" data-bs-toggle="modal" data-bs-target="#deleteGuideModal">
                    <i class="fa-solid fa-user-slash fa-fw" aria-hidden="true"></i>
                    <span>Deactivate</span>
                </button>
            </permission>
        </div>
    </div>

    @* §8.14 — edit guide profile *@
    <permission require="@WebPermission.TourGuideProfile.Update">
        <div class="modal fade" id="editGuideModal" tabindex="-1" aria-labelledby="editGuideLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form method="post" asp-area="Admin" asp-controller="Guides" asp-action="Edit" asp-route-id="@detail.Id">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h2 class="modal-title h5 mb-0" id="editGuideLabel">Edit guide profile</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label" for="edit-years">Years of experience</label>
                                <input type="number" min="0" max="80" class="form-control font-data"
                                       id="edit-years" name="YearsOfExperience" value="@detail.YearsOfExperience" />
                            </div>
                            <div class="form-check mb-3">
                                <input type="checkbox" class="form-check-input" id="edit-firstaid"
                                       name="HasFirstAid" value="true" @(detail.HasFirstAid ? "checked" : "") />
                                <label class="form-check-label" for="edit-firstaid">First aid certified</label>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="edit-license">MoTA license number</label>
                                <input type="text" maxlength="100" class="form-control font-data"
                                       id="edit-license" name="MoTALicenseNumber" value="@detail.MoTALicenseNumber" />
                            </div>
                            <div class="mb-1">
                                <label class="form-label" for="edit-bio">Bio</label>
                                <textarea class="form-control" id="edit-bio" name="Bio" rows="4" maxlength="2000">@detail.Bio</textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </permission>

    @* §8.14 — deactivate guide (destructive — MOD12 confirm) *@
    <permission require="@WebPermission.TourGuideProfile.DeleteAny">
        <div class="modal fade" id="deleteGuideModal" tabindex="-1" aria-labelledby="deleteGuideLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form method="post" asp-area="Admin" asp-controller="Guides" asp-action="Delete" asp-route-id="@detail.Id"
                          onsubmit="return confirm('Deactivate this tour guide? Their profile will be removed from the marketplace.');">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h2 class="modal-title h5 mb-0" id="deleteGuideLabel">Deactivate tour guide</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p class="mb-0">
                                This deactivates
                                <strong>@(string.IsNullOrWhiteSpace(detail.DisplayName) ? "this guide" : detail.DisplayName)</strong>
                                (<bdi class="font-data" dir="ltr">@detail.Id.ToString("D")</bdi>) and removes them from the marketplace.
                            </p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger">Deactivate guide</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </permission>

    <permission require="@WebPermission.TourGuideProfile.Suspend">
        <div class="modal fade" id="suspendModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form method="post" asp-area="Admin" asp-controller="Guides" asp-action="Suspend" asp-route-id="@detail.Id">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title">Suspend tour guide</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <label for="suspend-reason" class="form-label small fw-semibold">Reason</label>
                            <textarea id="suspend-reason" name="reason" class="form-control" rows="3" required></textarea>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger">Suspend</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </permission>
}
else if (Model.LookupId is not null)
{
    <div class="card card-body shadow p-5 text-center">
        <img src="~/assets/images/element/17.svg" class="h-100px mb-3 mx-auto" alt="" />
        <p class="text-secondary mb-0">No tour guide found for that ID.</p>
    </div>
}
else
{
    <div class="card card-body shadow p-5 text-center">
        <img src="~/assets/images/element/17.svg" class="h-100px mb-3 mx-auto" alt="" />
        <p class="text-secondary mb-0">Enter a guide ID to view and moderate a tour guide.</p>
    </div>
}
