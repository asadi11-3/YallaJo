@inject YallaJo.Web.Infrastructure.Identity.ICurrentUser CurrentUser
@{
    var nav = ViewData["AdminNav"] as string ?? string.Empty;
    string Active(string key) => string.Equals(nav, key, StringComparison.OrdinalIgnoreCase) ? "nav-link active" : "nav-link";

    bool Has(string permission) => CurrentUser.HasPermission(permission);

    // Cluster visibility: only render a section header if the user can see at least one item in it.
    var showOverview = Has(WebPermission.AdminDashboard.Read) || Has(WebPermission.AuditLog.Read) || Has(WebPermission.System.Read) || Has(WebPermission.Interaction.Read);
    var showPeople = Has(WebPermission.User.Read) || Has(WebPermission.Role.Read) || Has(WebPermission.User.Create);
    var showMarketplace = Has(WebPermission.AdminProviderQueue.Read) || Has(WebPermission.Place.Read) || Has(WebPermission.Tour.Approve) || Has(WebPermission.Business.Read);
    var showCommerce = Has(WebPermission.AdminFinanceDashboard.Read) || Has(WebPermission.Payout.Read) || Has(WebPermission.CommissionRule.Read) || Has(WebPermission.AdminBookingDashboard.Read);
    var showContent = Has(WebPermission.AdminBlogQueue.Read) || Has(WebPermission.Category.Read) || Has(WebPermission.Tag.Read)
        || Has(WebPermission.Language.Read) || Has(WebPermission.Specialization.Read) || Has(WebPermission.TranslationCache.Read)
        || Has(WebPermission.Attachment.Read) || Has(WebPermission.Batch.Read);
    var showTaxonomy = Has(WebPermission.Category.Read) || Has(WebPermission.Tag.Read) || Has(WebPermission.Language.Read)
        || Has(WebPermission.Specialization.Read) || Has(WebPermission.TranslationCache.Read) || Has(WebPermission.Attachment.Read);
    var showTrust = Has(WebPermission.AdminCreatorQueue.Read) || Has(WebPermission.TourGuideProfile.Read) || Has(WebPermission.GuideApplication.Read) || Has(WebPermission.AdminModerationQueue.Read) || Has(WebPermission.SupportTicket.Read);
    var showOpsSystem = Has(WebPermission.NotificationTemplate.Read) || Has(WebPermission.Batch.Read) || Has(WebPermission.Outbox.Read);
    var showSeo = Has(WebPermission.Redirect.Read) || Has(WebPermission.SeoMetadata.Read) || Has(WebPermission.Sitemap.Read) || Has(WebPermission.Weather.Read) || Has(WebPermission.FaqItem.Read);
}

<ul class="navbar-nav flex-column" id="navbar-sidebar">

    @if (showOverview)
    {
        <li class="nav-item ms-2 my-2 text-uppercase small fw-bold opacity-75">Overview</li>

        <permission require="@WebPermission.AdminDashboard.Read">
            <li class="nav-item">
                <a class="@Active("Dashboard")" asp-area="Admin" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2 fa-fw me-2"></i>Dashboard
                </a>
            </li>
        </permission>

        @if (Has(WebPermission.AuditLog.Read) || Has(WebPermission.System.Read))
        {
            <li class="nav-item">
                <a class="@Active("Audit")" asp-area="Admin" asp-controller="AuditLogs" asp-action="Index">
                    <i class="bi bi-clock-history fa-fw me-2"></i>Activity &amp; audit
                </a>
            </li>
        }

        <permission require="@WebPermission.Interaction.Read">
            <li class="nav-item">
                <a class="@Active("Statistics")" asp-area="Admin" asp-controller="Statistics" asp-action="Index">
                    <i class="bi bi-graph-up fa-fw me-2"></i>Analytics
                </a>
            </li>
        </permission>
    }

    @if (showPeople)
    {
        <li class="nav-item ms-2 my-2 text-uppercase small fw-bold opacity-75">People &amp; access</li>

        <permission require="@WebPermission.User.Read">
            <li class="nav-item">
                <a class="@Active("Users")" asp-area="Admin" asp-controller="Users" asp-action="Index">
                    <i class="bi bi-people fa-fw me-2"></i>Users
                </a>
            </li>
        </permission>

        <permission require="@WebPermission.Role.Read">
            <li class="nav-item">
                <a class="@Active("Roles")" asp-area="Admin" asp-controller="Roles" asp-action="Index">
                    <i class="bi bi-shield-lock fa-fw me-2"></i>Roles
                </a>
            </li>
        </permission>

        <permission require="@WebPermission.User.Create">
            <li class="nav-item">
                <a class="@Active("Invitations")" asp-area="Admin" asp-controller="Invitations" asp-action="Index">
                    <i class="bi bi-envelope-plus fa-fw me-2"></i>Invitations
                </a>
            </li>
        </permission>
    }

    @if (showMarketplace)
    {
        <li class="nav-item ms-2 my-2 text-uppercase small fw-bold opacity-75">Marketplace ops</li>

        <permission require="@WebPermission.AdminProviderQueue.Read">
            <li class="nav-item">
                <a class="@Active("Providers")" asp-area="Admin" asp-controller="Providers" asp-action="Index">
                    <i class="bi bi-shop fa-fw me-2"></i>Provider approvals
                </a>
            </li>
        </permission>

        <permission require="@WebPermission.Place.Read">
            <li class="nav-item">
                <a class="@Active("Places")" asp-area="Admin" asp-controller="Places" asp-action="Index">
                    <i class="bi bi-geo-alt fa-fw me-2"></i>Places &amp; businesses
                </a>
            </li>
        </permission>

        <permission require="@WebPermission.Tour.Approve">
            <li class="nav-item">
                <a class="@Active("Tours")" asp-area="Admin" asp-controller="Trips" asp-action="Index">
                    <i class="bi bi-map fa-fw me-2"></i>Tour approvals
                </a>
            </li>
        </permission>

        <permission require="@WebPermission.Business.Read">
            <li class="nav-item">
                <a class="@Active("Businesses")" asp-area="Admin" asp-controller="Businesses" asp-action="Index">
                    <i class="bi bi-building-check fa-fw me-2"></i>Business approvals
                </a>
            </li>
        </permission>
    }

    @if (showCommerce)
    {
        <li class="nav-item ms-2 my-2 text-uppercase small fw-bold opacity-75">Commerce</li>

        <permission require="@WebPermission.AdminBookingDashboard.Read">
            <li class="nav-item">
                <a class="@Active("Bookings")" asp-area="Admin" asp-controller="Bookings" asp-action="Index">
                    <i class="bi bi-calendar-check fa-fw me-2"></i>Bookings
                </a>
            </li>
        </permission>

        <permission require="@WebPermission.AdminFinanceDashboard.Read">
            <li class="nav-item">
                <a class="@Active("Finance")" asp-area="Admin" asp-controller="Payments" asp-action="Index">
                    <i class="bi bi-cash-coin fa-fw me-2"></i>Earnings
                </a>
            </li>
        </permission>

        <permission require="@WebPermission.Payout.Read">
            <li class="nav-item">
                <a class="@Active("Payouts")" asp-area="Admin" asp-controller="Payouts" asp-action="Index">
                    <i class="bi bi-bank fa-fw me-2"></i>Payouts
                </a>
            </li>
        </permission>

        <permission require="@WebPermission.AdminFinanceDashboard.Read">
            <li class="nav-item">
                <a class="@Active("Disputes")" asp-area="Admin" asp-controller="Disputes" asp-action="Index">
                    <i class="bi bi-exclamation-octagon fa-fw me-2"></i>Disputes
                </a>
            </li>
        </permission>

        <permission require="@WebPermission.CommissionRule.Read">
            <li class="nav-item">
                <a class="@Active("Commissions")" asp-area="Admin" asp-controller="Commissions" asp-action="Index">
                    <i class="bi bi-percent fa-fw me-2"></i>Commission rules
                </a>
            </li>
        </permission>
    }

    @if (showContent)
    {
        <li class="nav-item ms-2 my-2 text-uppercase small fw-bold opacity-75">Content</li>

        <permission require="@WebPermission.AdminBlogQueue.Read">
            <li class="nav-item">
                <a class="@Active("Blogs")" asp-area="Admin" asp-controller="Blogs" asp-action="Index">
                    <i class="bi bi-journal-text fa-fw me-2"></i>Blog moderation
                </a>
            </li>
        </permission>

        @if (showTaxonomy)
        {
            <li class="nav-item">
                <a class="nav-link @(nav.StartsWith("Taxonomy", StringComparison.OrdinalIgnoreCase) ? "" : "collapsed")"
                   data-bs-toggle="collapse" href="#collapseTaxonomy" role="button"
                   aria-expanded="@(nav.StartsWith("Taxonomy", StringComparison.OrdinalIgnoreCase) ? "true" : "false")" aria-controls="collapseTaxonomy">
                    <i class="bi bi-tags fa-fw me-2"></i>Taxonomy
                </a>
                <ul class="nav collapse flex-column ms-3 @(nav.StartsWith("Taxonomy", StringComparison.OrdinalIgnoreCase) ? "show" : "")" id="collapseTaxonomy" data-bs-parent="#navbar-sidebar">
                    <permission require="@WebPermission.Category.Read">
                        <li class="nav-item"><a class="@Active("TaxonomyCategories")" asp-area="Admin" asp-controller="Categories" asp-action="Index">Categories</a></li>
                    </permission>
                    <permission require="@WebPermission.Tag.Read">
                        <li class="nav-item"><a class="@Active("TaxonomyTags")" asp-area="Admin" asp-controller="Tags" asp-action="Index">Tags</a></li>
                    </permission>
                    <permission require="@WebPermission.Language.Read">
                        <li class="nav-item"><a class="@Active("TaxonomyLanguages")" asp-area="Admin" asp-controller="Languages" asp-action="Index">Languages</a></li>
                    </permission>
                    <permission require="@WebPermission.Specialization.Read">
                        <li class="nav-item"><a class="@Active("TaxonomySpecializations")" asp-area="Admin" asp-controller="Specializations" asp-action="Index">Specializations</a></li>
                    </permission>
                    <permission require="@WebPermission.TranslationCache.Read">
                        <li class="nav-item"><a class="@Active("TaxonomyTranslations")" asp-area="Admin" asp-controller="Translations" asp-action="Index">Translations</a></li>
                    </permission>
                    <permission require="@WebPermission.Attachment.Read">
                        <li class="nav-item"><a class="@Active("TaxonomyAttachments")" asp-area="Admin" asp-controller="Attachments" asp-action="Index">Attachments</a></li>
                    </permission>
                </ul>
            </li>
        }
    }

    @if (showTrust)
    {
        <li class="nav-item ms-2 my-2 text-uppercase small fw-bold opacity-75">Trust &amp; moderation</li>

        <permission require="@WebPermission.AdminCreatorQueue.Read">
            <li class="nav-item">
                <a class="@Active("Creators")" asp-area="Admin" asp-controller="Creators" asp-action="Index">
                    <i class="bi bi-person-badge fa-fw me-2"></i>Creator approvals
                </a>
            </li>
        </permission>

        <permission require="@WebPermission.TourGuideProfile.Read">
            <li class="nav-item">
                <a class="@Active("Guides")" asp-area="Admin" asp-controller="Guides" asp-action="Index">
                    <i class="bi bi-person-vcard fa-fw me-2"></i>Tour guides
                </a>
            </li>
        </permission>

        <permission require="@WebPermission.GuideApplication.Read">
            <li class="nav-item">
                <a class="@Active("GuideApplications")" asp-area="Admin" asp-controller="GuideApplications" asp-action="Index">
                    <i class="bi bi-card-checklist fa-fw me-2"></i>Guide applications
                </a>
            </li>
        </permission>

        <permission require="@WebPermission.AdminModerationQueue.Read">
            <li class="nav-item">
                <a class="@Active("Reports")" asp-area="Admin" asp-controller="Reports" asp-action="Index">
                    <i class="bi bi-flag fa-fw me-2"></i>Reports
                </a>
            </li>
            <li class="nav-item">
                <a class="@Active("FlaggedReviews")" asp-area="Admin" asp-controller="FlaggedReviews" asp-action="Index">
                    <i class="bi bi-star fa-fw me-2"></i>Flagged reviews
                </a>
            </li>
            <li class="nav-item">
                <a class="@Active("Moderation")" asp-area="Admin" asp-controller="Moderation" asp-action="Index">
                    <i class="bi bi-shield-exclamation fa-fw me-2"></i>Moderation
                </a>
            </li>
        </permission>

        <permission require="@WebPermission.SupportTicket.Read">
            <li class="nav-item">
                <a class="@Active("Support")" asp-area="Admin" asp-controller="Support" asp-action="Index">
                    <i class="bi bi-headset fa-fw me-2"></i>Support
                </a>
            </li>
        </permission>
    }

    @if (showSeo)
    {
        <li class="nav-item ms-2 my-2 text-uppercase small fw-bold opacity-75">SEO &amp; site</li>

        <permission require="@WebPermission.Redirect.Read">
            <li class="nav-item">
                <a class="@Active("SeoRedirects")" asp-area="Admin" asp-controller="SeoRedirects" asp-action="Index">
                    <i class="bi bi-signpost-split fa-fw me-2"></i>Redirects
                </a>
            </li>
        </permission>

        <permission require="@WebPermission.SeoMetadata.Read">
            <li class="nav-item">
                <a class="@Active("SeoMetadata")" asp-area="Admin" asp-controller="SeoMetadata" asp-action="Index">
                    <i class="bi bi-card-heading fa-fw me-2"></i>Metadata
                </a>
            </li>
        </permission>

        <permission require="@WebPermission.Sitemap.Read">
            <li class="nav-item">
                <a class="@Active("SeoSitemap")" asp-area="Admin" asp-controller="SeoSitemap" asp-action="Index">
                    <i class="bi bi-diagram-3 fa-fw me-2"></i>Sitemap
                </a>
            </li>
        </permission>

        <permission require="@WebPermission.Weather.Read">
            <li class="nav-item">
                <a class="@Active("SeoWeather")" asp-area="Admin" asp-controller="SeoWeather" asp-action="Index">
                    <i class="bi bi-cloud-sun fa-fw me-2"></i>Weather
                </a>
            </li>
        </permission>

        <permission require="@WebPermission.FaqItem.Read">
            <li class="nav-item">
                <a class="@Active("SeoFaq")" asp-area="Admin" asp-controller="SeoFaq" asp-action="Index">
                    <i class="bi bi-question-circle fa-fw me-2"></i>FAQ
                </a>
            </li>
        </permission>
    }

    @if (showOpsSystem)
    {
        <li class="nav-item ms-2 my-2 text-uppercase small fw-bold opacity-75">Ops &amp; system</li>

        <permission require="@WebPermission.NotificationTemplate.Read">
            <li class="nav-item">
                <a class="@Active("NotificationTemplates")" asp-area="Admin" asp-controller="NotificationTemplates" asp-action="Index">
                    <i class="bi bi-envelope-paper fa-fw me-2"></i>Notification templates
                </a>
            </li>
        </permission>

        <permission require="@WebPermission.Batch.Read">
            <li class="nav-item">
                <a class="@Active("Recommendations")" asp-area="Admin" asp-controller="Recommendations" asp-action="Index">
                    <i class="bi bi-stars fa-fw me-2"></i>Recommendations
                </a>
            </li>
        </permission>

        <permission require="@WebPermission.Outbox.Read">
            <li class="nav-item">
                <a class="@Active("Outbox")" asp-area="Admin" asp-controller="Outbox" asp-action="Index">
                    <i class="bi bi-inboxes fa-fw me-2"></i>Outbox dead-letters
                </a>
            </li>
        </permission>
    }

</ul>
