@using Microsoft.Extensions.Localization
@inject YallaJo.Web.Infrastructure.Identity.ICurrentUser CurrentUser
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    var nav = ViewData["AdminNav"] as string ?? string.Empty;

    // Active-state helpers. The active link also carries aria-current="page" (A11Y1).
    bool IsActive(string key) => string.Equals(nav, key, StringComparison.OrdinalIgnoreCase);
    string Active(string key) => IsActive(key) ? "nav-link active" : "nav-link";

    // Nav driver (plan §9 line 13): prefer the DB-backed GET /security/me permission snapshot
    // supplied by AdminNavViewComponent. When absent (direct partial render or snapshot load
    // failure) fall back to the request's JWT-claim permissions so the shell still renders (ERR3).
    var securityMePermissions = ViewData["SecurityMePermissions"] as IReadOnlyCollection<string>;
    // Honor the "*" wildcard granted to super-roles, whose DB-backed snapshot drops the
    // explicit permission array (kept off the JWT for IIS header-size limits) and carries
    // only "*". An empty/absent snapshot falls back to the request's JWT-claim permissions
    // so the shell still renders (ERR3). Mirrors PermissionTagHelper.HasPermission.
    bool Has(string permission) => securityMePermissions is { Count: > 0 }
        ? securityMePermissions.Contains("*") || securityMePermissions.Contains(permission)
        : CurrentUser.HasPermission(permission);

    // Cluster visibility: only render a section header if the user can see at least one item in it.
    var showOverview = Has(WebPermission.AdminDashboard.Read) || Has(WebPermission.AuditLog.Read) || Has(WebPermission.System.Read) || Has(WebPermission.Interaction.Read);
    var showPeople = Has(WebPermission.User.Read) || Has(WebPermission.Role.Read) || Has(WebPermission.User.Create);
    var showMarketplace = Has(WebPermission.AdminProviderQueue.Read) || Has(WebPermission.Place.Read) || Has(WebPermission.Tour.Approve) || Has(WebPermission.Business.Read);
    var showCommerce = Has(WebPermission.AdminFinanceDashboard.Read) || Has(WebPermission.Payout.Read) || Has(WebPermission.CommissionRule.Read) || Has(WebPermission.AdminBookingDashboard.Read);
    var showContent = Has(WebPermission.AdminBlogQueue.Read) || Has(WebPermission.Category.Read) || Has(WebPermission.Tag.Read)
        || Has(WebPermission.Language.Read) || Has(WebPermission.Specialization.Read) || Has(WebPermission.TranslationCache.Read)
        || Has(WebPermission.Attachment.Read) || Has(WebPermission.Batch.Read);
    var showTaxonomy = Has(WebPermission.Category.Read) || Has(WebPermission.Tag.Read) || Has(WebPermission.Language.Read)
        || Has(WebPermission.Specialization.Read) || Has(WebPermission.TranslationCache.Read) || Has(WebPermission.Attachment.Read);
    var showTrust = Has(WebPermission.AdminCreatorQueue.Read) || Has(WebPermission.TourGuideProfile.Read) || Has(WebPermission.GuideApplication.Read) || Has(WebPermission.AdminModerationQueue.Read) || Has(WebPermission.SupportTicket.Read);
    var showOpsSystem = Has(WebPermission.NotificationTemplate.Read) || Has(WebPermission.Batch.Read) || Has(WebPermission.Outbox.Read);
    var showSeo = Has(WebPermission.Redirect.Read) || Has(WebPermission.SeoMetadata.Read) || Has(WebPermission.Sitemap.Read) || Has(WebPermission.Weather.Read) || Has(WebPermission.FaqItem.Read);

    var taxonomyOpen = nav.StartsWith("Taxonomy", StringComparison.OrdinalIgnoreCase);
}

