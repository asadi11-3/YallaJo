@using Microsoft.Extensions.Localization
@using YallaJo.Web.Infrastructure.Authorization
@model YallaJo.Web.Areas.Admin.Models.EntityTags.EntityTagsVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.EntityTags.Title"].Value;
    ViewData["AdminNav"] = "EntityTags";

    var entityType = Model.Query.EntityType;
    var entityId = Model.Query.EntityId;
    var hasContext = Model.HasQueried;
    var assignedIds = new HashSet<Guid>(Model.Assigned.Select(a => a.TagId));
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.EntityTags.Title"]</h1>
        <p class="mb-0 text-secondary">@Localizer["Admin.EntityTags.Subtitle"]</p>
    </div>
</div>

@if (ViewBag.Error is string vbe)
{
    <div class="alert alert-danger" role="alert">@vbe</div>
}

@if (!hasContext)
{
    <div class="card shadow">
        <div class="card-body text-center py-5">
            <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
            <h2 class="h5">@Localizer["Admin.EntityTags.NoContextHeading"]</h2>
            <p class="mb-0 text-secondary">@Localizer["Admin.EntityTags.NoContextMessage"]</p>
        </div>
    </div>
}
else
{
    <div class="card shadow mb-4">
        <div class="card-header border-bottom">
            <h2 class="card-header-title h5 mb-0">@Localizer["Admin.EntityTags.ContextHeading"]</h2>
        </div>
        <div class="card-body">
            <p class="mb-0 text-secondary">
                @Localizer["Admin.EntityTags.ContextLabel"]
                <span class="badge bg-primary bg-opacity-10 text-primary ms-1"><bdi dir="ltr">@entityType</bdi></span>
            </p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xxl-6">
            <div class="card shadow h-100">
                <div class="card-header border-bottom">
                    <h2 class="card-header-title h5 mb-0">@Localizer["Admin.EntityTags.AssignedHeading"]</h2>
                </div>
                <div class="card-body">
                    @if (!Model.HasAssigned)
                    {
                        <div class="text-center py-4">
                            <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
                            <p class="mb-0 text-secondary">@Localizer["Admin.EntityTags.NoneAssigned"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">@Localizer["Admin.EntityTags.ColName"]</th>
                                        <th scope="col">@Localizer["Admin.EntityTags.ColSlug"]</th>
                                        <th scope="col" class="text-end">@Localizer["Admin.EntityTags.ColActions"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in Model.Assigned)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@t.Name</td>
                                            <td><bdi dir="ltr" class="font-data text-secondary">@t.Slug</bdi></td>
                                            <td class="text-end">
                                                <permission require="@WebPermission.EntityTag.Delete">
                                                    <form asp-area="Admin" asp-controller="EntityTags" asp-action="Remove" method="post" class="d-inline"
                                                          data-confirm="@Localizer["Admin.EntityTags.RemoveConfirm", t.Name]"
                                                          data-confirm-title="@Localizer["Admin.EntityTags.RemoveTitle"]"
                                                          data-confirm-action="@Localizer["Admin.EntityTags.Remove"]">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="entityType" value="@entityType" />
                                                        <input type="hidden" name="entityId" value="@entityId" />
                                                        <input type="hidden" name="tagId" value="@t.TagId" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            <i class="fa-solid fa-xmark fa-fw" aria-hidden="true"></i> @Localizer["Admin.EntityTags.Remove"]
                                                        </button>
                                                    </form>
                                                </permission>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <permission require="@WebPermission.EntityTag.Create">
            <div class="col-xxl-6">
                <div class="card shadow h-100">
                    <div class="card-header border-bottom">
                        <h2 class="card-header-title h5 mb-0">@Localizer["Admin.EntityTags.AssignHeading"]</h2>
                    </div>
                    <div class="card-body">
                        <form asp-area="Admin" asp-controller="EntityTags" asp-action="Assign" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="entityType" value="@entityType" />
                            <input type="hidden" name="entityId" value="@entityId" />
                            <div class="mb-3">
                                <label for="tagIds" class="form-label">@Localizer["Admin.EntityTags.SelectLabel"]</label>
                                <select id="tagIds" name="tagIds" class="form-select" multiple size="8" aria-describedby="tagIds-help">
                                    @foreach (var opt in Model.AvailableTags)
                                    {
                                        if (assignedIds.Contains(opt.Id))
                                        {
                                            <option value="@opt.Id" disabled>@opt.Name @Localizer["Admin.EntityTags.AssignedSuffix"]</option>
                                        }
                                        else if (!opt.IsActive)
                                        {
                                            <option value="@opt.Id">@opt.Name @Localizer["Admin.EntityTags.InactiveSuffix"]</option>
                                        }
                                        else
                                        {
                                            <option value="@opt.Id">@opt.Name</option>
                                        }
                                    }
                                </select>
                                <small id="tagIds-help" class="form-text">@Localizer["Admin.EntityTags.SelectHelp"]</small>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-plus fa-fw" aria-hidden="true"></i> @Localizer["Admin.EntityTags.AssignSubmit"]
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </permission>
    </div>
}
