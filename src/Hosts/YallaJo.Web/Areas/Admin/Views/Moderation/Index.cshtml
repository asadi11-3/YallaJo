@using YallaJo.Web.Areas.Admin.Models.Moderation
@using YallaJo.Web.Infrastructure.Authorization
@model ModerationVm
@{
    ViewData["Title"] = "Moderation";
    ViewData["AdminNav"] = "Moderation";
    var entityTypes = Enum.GetValues<ModerationEntityType>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Moderation</h1>
        <p class="text-secondary mb-0">Immutable audit trail of admin moderation actions, plus manual warn / ban tools.</p>
    </div>
    <div class="d-flex gap-2">
        <permission require="@WebPermission.AdminModerationQueue.Warn">
            <button type="button" class="btn btn-sm btn-warning-soft" data-bs-toggle="modal" data-bs-target="#warnModal">
                <i class="bi bi-exclamation-triangle me-1"></i>Warn user
            </button>
        </permission>
        <permission require="@WebPermission.AdminModerationQueue.Ban">
            <button type="button" class="btn btn-sm btn-danger-soft" data-bs-toggle="modal" data-bs-target="#banModal">
                <i class="bi bi-slash-circle me-1"></i>Ban user
            </button>
        </permission>
    </div>
</div>

@if (!Model.HasLogs)
{
    <div class="card card-body shadow text-center py-5">
        <img src="~/assets/images/element/17.svg" class="h-80px mb-3 mx-auto" alt="" />
        <p class="text-secondary mb-0">No moderation actions recorded yet.</p>
    </div>
}
else
{
    <div class="card shadow">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Action</th>
                        <th>Target</th>
                        <th>Notes</th>
                        <th>Admin</th>
                        <th>When</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.Logs)
                    {
                        <tr>
                            <td><span class="badge bg-@ModerationMapper.ActionColor(l.Action) bg-opacity-10 text-@ModerationMapper.ActionColor(l.Action)">@l.Action</span></td>
                            <td>
                                <div class="text-secondary small">@l.EntityType <span class="font-data">@l.EntityId.ToString("D")[..8]</span></div>
                                @if (l.SourceReportId is { } src && src != Guid.Empty)
                                {
                                    <div class="text-secondary small">from report <span class="font-data">@src.ToString("D")[..8]</span></div>
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(l.Notes) ? "—" : l.Notes)</td>
                            <td class="font-data small">@l.AdminUserId.ToString("D")[..8]</td>
                            <td class="font-data">@l.ActionedAt.ToString("g")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.NextCursor is { } next && next != Guid.Empty)
    {
        <div class="mt-3 text-center">
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-afterCursor="@next">Load more</a>
        </div>
    }
}

<permission require="@WebPermission.AdminModerationQueue.Warn">
    <div class="modal fade" id="warnModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form asp-action="Warn" method="post" class="modal-content">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Warn a user</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">User ID</label>
                    <input name="UserId" class="form-control mb-3" placeholder="00000000-0000-0000-0000-000000000000" required />
                    <label class="form-label">Entity type</label>
                    <select name="EntityType" class="form-select mb-3" required>
                        @foreach (var t in entityTypes)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                    <label class="form-label">Entity ID</label>
                    <input name="EntityId" class="form-control mb-3" placeholder="00000000-0000-0000-0000-000000000000" required />
                    <label class="form-label">Reason</label>
                    <textarea name="Reason" class="form-control" rows="3" maxlength="1000" required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Issue warning</button>
                </div>
            </form>
        </div>
    </div>
</permission>

<permission require="@WebPermission.AdminModerationQueue.Ban">
    <div class="modal fade" id="banModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form asp-action="Ban" method="post" class="modal-content">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Ban a user</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">User ID</label>
                    <input name="UserId" class="form-control mb-3" placeholder="00000000-0000-0000-0000-000000000000" required />
                    <label class="form-label">Entity type</label>
                    <select name="EntityType" class="form-select mb-3" required>
                        @foreach (var t in entityTypes)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                    <label class="form-label">Entity ID</label>
                    <input name="EntityId" class="form-control mb-3" placeholder="00000000-0000-0000-0000-000000000000" required />
                    <label class="form-label">Reason</label>
                    <textarea name="Reason" class="form-control mb-3" rows="3" maxlength="1000" required></textarea>
                    <label class="form-label">Expires at (optional — leave blank for a permanent ban)</label>
                    <input name="ExpiresAt" type="datetime-local" class="form-control" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Ban user</button>
                </div>
            </form>
        </div>
    </div>
</permission>

<permission require="@WebPermission.AdminModerationQueue.Ban">
    <div class="card shadow mt-4">
        <div class="card-header border-bottom">
            <h6 class="mb-0">Lift a ban</h6>
        </div>
        <div class="card-body">
            <form asp-action="Unban" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-sm-8">
                    <label class="form-label">Banned user ID</label>
                    <input name="userId" class="form-control" placeholder="00000000-0000-0000-0000-000000000000" required />
                </div>
                <div class="col-sm-4">
                    <button type="submit" class="btn btn-success-soft w-100" onclick="return confirm('Lift the active ban for this user?');">
                        <i class="bi bi-check-circle me-1"></i>Unban
                    </button>
                </div>
            </form>
        </div>
    </div>
</permission>
