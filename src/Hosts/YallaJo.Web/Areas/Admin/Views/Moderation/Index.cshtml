@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.Moderation
@using YallaJo.Web.Infrastructure.Authorization
@model ModerationVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Moderation.Title"].Value;
    ViewData["AdminNav"] = "Moderation";
    var entityTypes = Enum.GetValues<ModerationEntityType>();
    var culture = CultureInfo.CurrentCulture;
    string Date(DateTime dt) => dt.ToString("yyyy-MM-dd HH:mm", culture);
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Moderation.Title"]</h1>
        <p class="text-secondary mb-0">@Localizer["Admin.Moderation.Subtitle"]</p>
    </div>
    <div class="d-flex gap-2">
        <permission require="@WebPermission.AdminModerationQueue.Warn">
            <button type="button" class="btn btn-sm btn-warning-soft" data-bs-toggle="modal" data-bs-target="#warnModal">
                <i class="fa-solid fa-triangle-exclamation fa-fw" aria-hidden="true"></i> @Localizer["Admin.Moderation.WarnUser"]
            </button>
        </permission>
        <permission require="@WebPermission.AdminModerationQueue.Ban">
            <button type="button" class="btn btn-sm btn-danger-soft" data-bs-toggle="modal" data-bs-target="#banModal">
                <i class="fa-solid fa-ban fa-fw" aria-hidden="true"></i> @Localizer["Admin.Moderation.BanUser"]
            </button>
        </permission>
    </div>
</div>

@if (ViewBag.Error is string err && !string.IsNullOrWhiteSpace(err))
{
    <div class="alert alert-danger" role="alert">@err</div>
}

<section class="card shadow" aria-labelledby="moderation-heading">
    <div class="card-header border-bottom">
        <h2 id="moderation-heading" class="card-header-title h5 mb-0">@Localizer["Admin.Moderation.Directory"]</h2>
    </div>
    @if (!Model.HasLogs)
    {
        <div class="card-body text-center py-5">
            <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
            <p class="mb-0 text-secondary">@Localizer["Admin.Moderation.EmptyMessage"]</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["Admin.Moderation.ColAction"]</th>
                        <th scope="col">@Localizer["Admin.Moderation.ColTarget"]</th>
                        <th scope="col">@Localizer["Admin.Moderation.ColNotes"]</th>
                        <th scope="col">@Localizer["Admin.Moderation.ColAdmin"]</th>
                        <th scope="col">@Localizer["Admin.Moderation.ColWhen"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.Logs)
                    {
                        var color = ModerationMapper.ActionColor(l.Action);
                        var icon = ModerationMapper.ActionIcon(l.Action);
                        <tr>
                            <td>
                                <span class="badge bg-@color bg-opacity-10 text-@color"><i class="fa-solid fa-@icon fa-fw" aria-hidden="true"></i> @l.Action</span>
                            </td>
                            <td><span class="fw-semibold">@l.EntityType</span></td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(l.Notes))
                                {
                                    <span class="text-secondary" aria-label="@Localizer["Admin.Moderation.NoNotes"]">&mdash;</span>
                                }
                                else
                                {
                                    @l.Notes
                                }
                            </td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(l.AdminEmail))
                                {
                                    <span class="text-secondary">@Localizer["Admin.Moderation.UnknownAdmin"]</span>
                                }
                                else
                                {
                                    <bdi dir="ltr">@l.AdminEmail</bdi>
                                }
                            </td>
                            <td><bdi dir="ltr" class="font-data">@Date(l.ActionedAt)</bdi></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.NextCursor is { } next && next != Guid.Empty)
        {
            <div class="card-footer border-top text-center">
                <a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-route-afterCursor="@next">@Localizer["Admin.Moderation.LoadMore"]</a>
            </div>
        }
    }
</section>

<permission require="@WebPermission.AdminModerationQueue.Warn">
    <div class="modal fade" id="warnModal" tabindex="-1" aria-labelledby="warnModalTitle" aria-describedby="warnModalBody" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <form asp-action="Warn" method="post" class="modal-content" role="dialog" aria-modal="true" aria-labelledby="warnModalTitle">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title h5" id="warnModalTitle">@Localizer["Admin.Moderation.WarnTitle"]</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Admin.Moderation.Close"]"></button>
                </div>
                <div class="modal-body" id="warnModalBody">
                    <p class="small text-secondary">@Localizer["Admin.Moderation.OperatorHelp"]</p>
                    <label class="form-label" for="warn-user-id">@Localizer["Admin.Moderation.UserIdLabel"]</label>
                    <input id="warn-user-id" name="UserId" class="form-control mb-3" dir="ltr" required aria-describedby="warn-user-id-help" />
                    <div class="form-text mb-3" id="warn-user-id-help">@Localizer["Admin.Moderation.UserIdHelp"]</div>
                    <label class="form-label" for="warn-entity-type">@Localizer["Admin.Moderation.EntityTypeLabel"]</label>
                    <select id="warn-entity-type" name="EntityType" class="form-select mb-3" required>
                        @foreach (var t in entityTypes)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                    <label class="form-label" for="warn-entity-id">@Localizer["Admin.Moderation.EntityIdLabel"]</label>
                    <input id="warn-entity-id" name="EntityId" class="form-control mb-3" dir="ltr" required aria-describedby="warn-entity-id-help" />
                    <div class="form-text mb-3" id="warn-entity-id-help">@Localizer["Admin.Moderation.EntityIdHelp"]</div>
                    <label class="form-label" for="warn-reason">@Localizer["Admin.Moderation.ReasonLabel"]</label>
                    <textarea id="warn-reason" name="Reason" class="form-control" rows="3" maxlength="1000" required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.Moderation.Cancel"]</button>
                    <button type="submit" class="btn btn-warning">@Localizer["Admin.Moderation.IssueWarning"]</button>
                </div>
            </form>
        </div>
    </div>
</permission>

<permission require="@WebPermission.AdminModerationQueue.Ban">
    <div class="modal fade" id="banModal" tabindex="-1" aria-labelledby="banModalTitle" aria-describedby="banModalBody" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <form asp-action="Ban" method="post" class="modal-content" role="dialog" aria-modal="true" aria-labelledby="banModalTitle">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 class="modal-title h5" id="banModalTitle">@Localizer["Admin.Moderation.BanTitle"]</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Admin.Moderation.Close"]"></button>
                </div>
                <div class="modal-body" id="banModalBody">
                    <p class="small text-secondary">@Localizer["Admin.Moderation.OperatorHelp"]</p>
                    <label class="form-label" for="ban-user-id">@Localizer["Admin.Moderation.UserIdLabel"]</label>
                    <input id="ban-user-id" name="UserId" class="form-control mb-3" dir="ltr" required aria-describedby="ban-user-id-help" />
                    <div class="form-text mb-3" id="ban-user-id-help">@Localizer["Admin.Moderation.UserIdHelp"]</div>
                    <label class="form-label" for="ban-entity-type">@Localizer["Admin.Moderation.EntityTypeLabel"]</label>
                    <select id="ban-entity-type" name="EntityType" class="form-select mb-3" required>
                        @foreach (var t in entityTypes)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                    <label class="form-label" for="ban-entity-id">@Localizer["Admin.Moderation.EntityIdLabel"]</label>
                    <input id="ban-entity-id" name="EntityId" class="form-control mb-3" dir="ltr" required aria-describedby="ban-entity-id-help" />
                    <div class="form-text mb-3" id="ban-entity-id-help">@Localizer["Admin.Moderation.EntityIdHelp"]</div>
                    <label class="form-label" for="ban-reason">@Localizer["Admin.Moderation.ReasonLabel"]</label>
                    <textarea id="ban-reason" name="Reason" class="form-control mb-3" rows="3" maxlength="1000" required></textarea>
                    <label class="form-label" for="ban-expires">@Localizer["Admin.Moderation.ExpiresLabel"]</label>
                    <input id="ban-expires" name="ExpiresAt" type="datetime-local" class="form-control" dir="ltr" aria-describedby="ban-expires-help" />
                    <div class="form-text" id="ban-expires-help">@Localizer["Admin.Moderation.ExpiresHelp"]</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.Moderation.Cancel"]</button>
                    <button type="submit" class="btn btn-danger">@Localizer["Admin.Moderation.BanUser"]</button>
                </div>
            </form>
        </div>
    </div>
</permission>

<permission require="@WebPermission.AdminModerationQueue.Ban">
    <section class="card shadow mt-4" aria-labelledby="unban-heading">
        <div class="card-header border-bottom">
            <h2 id="unban-heading" class="card-header-title h5 mb-0">@Localizer["Admin.Moderation.UnbanHeading"]</h2>
        </div>
        <div class="card-body">
            <form asp-action="Unban" method="post" class="row g-2 align-items-end"
                  data-confirm="@Localizer["Admin.Moderation.UnbanConfirm"]"
                  data-confirm-title="@Localizer["Admin.Moderation.UnbanHeading"]"
                  data-confirm-action="@Localizer["Admin.Moderation.Unban"]" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                @Html.AntiForgeryToken()
                <div class="col-sm-8">
                    <label class="form-label" for="unban-user-id">@Localizer["Admin.Moderation.BannedUserIdLabel"]</label>
                    <input id="unban-user-id" name="userId" class="form-control" dir="ltr" required aria-describedby="unban-user-id-help" />
                    <div class="form-text" id="unban-user-id-help">@Localizer["Admin.Moderation.UserIdHelp"]</div>
                </div>
                <div class="col-sm-4">
                    <button type="submit" class="btn btn-success-soft w-100"><i class="fa-solid fa-circle-check fa-fw" aria-hidden="true"></i> @Localizer["Admin.Moderation.Unban"]</button>
                </div>
            </form>
        </div>
    </section>
</permission>
