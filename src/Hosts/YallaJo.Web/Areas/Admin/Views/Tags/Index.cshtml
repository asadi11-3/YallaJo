@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.Shared
@using YallaJo.Web.Infrastructure.Authorization
@model YallaJo.Web.Areas.Admin.Models.Tags.TagListVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Tags.Title"].Value;
    ViewData["AdminNav"] = "Tags";
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Tags.Title"]</h1>
        <p class="text-secondary mb-0">@Localizer["Admin.Tags.Subtitle"]</p>
    </div>
</div>

@if (ViewBag.Error is string vbe)
{
    <div class="alert alert-danger" role="alert">@vbe</div>
}

<permission require="@WebPermission.Tag.Create">
    <section class="card shadow mb-4" aria-labelledby="create-tag-heading">
        <div class="card-header border-bottom">
            <h2 id="create-tag-heading" class="card-header-title h5 mb-0">@Localizer["Admin.Tags.CreateHeading"]</h2>
        </div>
        <div class="card-body">
            <form asp-area="Admin" asp-controller="Tags" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                <div class="row g-3">
                    <div class="col-md-5">
                        <label asp-for="Create.Name" class="form-label">@Localizer["Admin.Tags.NameLabel"]</label>
                        <input asp-for="Create.Name" class="form-control" />
                        <span asp-validation-for="Create.Name" class="text-danger" role="alert"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Create.Slug" class="form-label">@Localizer["Admin.Tags.SlugLabel"]</label>
                        <input asp-for="Create.Slug" class="form-control" dir="ltr" aria-describedby="create-tag-slug-help" />
                        <small id="create-tag-slug-help" class="form-text">@Localizer["Admin.Tags.SlugHelp"]</small>
                        <span asp-validation-for="Create.Slug" class="text-danger" role="alert"></span>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fa-solid fa-plus fa-fw" aria-hidden="true"></i> @Localizer["Admin.Tags.CreateSubmit"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </section>
</permission>

<section class="card shadow" aria-labelledby="tags-heading">
    <div class="card-header border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 id="tags-heading" class="card-header-title h5 mb-0">@Localizer["Admin.Tags.Directory"]</h2>
        <form asp-area="Admin" asp-controller="Tags" asp-action="Index" method="get" class="d-flex align-items-center gap-2">
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="activeOnly" name="activeOnly" value="true"
                       @(Model.ActiveOnly ? "checked" : "") />
                <label class="form-check-label" for="activeOnly">@Localizer["Admin.Tags.ActiveOnly"]</label>
            </div>
            <button type="submit" class="btn btn-sm btn-outline-secondary">
                <i class="fa-solid fa-filter fa-fw" aria-hidden="true"></i> @Localizer["Admin.Tags.Apply"]
            </button>
        </form>
    </div>
    <div class="card-body">
        @if (Model.Tags.Count == 0)
        {
            <div class="text-center py-5">
                <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
                <p class="mb-3 text-secondary">@Localizer["Admin.Tags.EmptyMessage"]</p>
                <permission require="@WebPermission.Tag.Create">
                    <a href="#Create_Name" class="btn btn-sm btn-primary">
                        <i class="fa-solid fa-plus fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Tags.EmptyCta"]
                    </a>
                </permission>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">@Localizer["Admin.Tags.ColName"]</th>
                            <th scope="col">@Localizer["Admin.Tags.ColSlug"]</th>
                            <th scope="col">@Localizer["Admin.Tags.ColStatus"]</th>
                            <th scope="col" class="text-end">@Localizer["Admin.Tags.ColActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Tags)
                        {
                            <tr>
                                <td><span class="fw-semibold">@t.Name</span></td>
                                <td><bdi dir="ltr" class="font-data">@t.Slug</bdi></td>
                                <td>
                                    @if (t.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success">
                                            <i class="fa-solid fa-circle-check fa-fw" aria-hidden="true"></i> @Localizer["Admin.Tags.StatusActive"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary">
                                            <i class="fa-solid fa-circle-minus fa-fw" aria-hidden="true"></i> @Localizer["Admin.Tags.StatusInactive"]
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <permission require="@WebPermission.Tag.Update">
                                            <a asp-area="Admin" asp-controller="Tags" asp-action="Edit" asp-route-id="@t.Id"
                                               class="btn btn-sm btn-outline-secondary"
                                               data-yj-modal-target="#editTagModal"
                                               data-action="@Url.Action("Edit", new { area = "Admin", id = t.Id })"
                                               data-field-id="@t.Id" data-field-name="@t.Name" data-field-slug="@t.Slug">
                                                <i class="fa-solid fa-pen fa-fw" aria-hidden="true"></i> @Localizer["Admin.Tags.Manage"]
                                            </a>
                                        </permission>
                                        <permission require="@WebPermission.Tag.Delete">
                                            <form asp-area="Admin" asp-controller="Tags" asp-action="Delete" asp-route-id="@t.Id"
                                                  method="post" class="d-inline"
                                                  data-confirm="@Localizer["Admin.Tags.DeleteConfirm", t.Name]"
                                                  data-confirm-title="@Localizer["Admin.Tags.DeleteTitle"]"
                                                  data-confirm-action="@Localizer["Admin.Tags.Delete"]" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="fa-solid fa-trash fa-fw" aria-hidden="true"></i> @Localizer["Admin.Tags.Delete"]
                                                </button>
                                            </form>
                                        </permission>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

<permission require="@WebPermission.Tag.Update">
    @{
        var editOpen = Model.EditId is not null;
    }
    @* Edit modal (F8 §4.7): JS opens it via admin-modal-crud.js; deep links / no-JS
       render it server-side open (PE1) with anchor-based close controls. *@
    <div class="modal fade@(editOpen ? " show d-block" : "")" id="editTagModal" tabindex="-1"
         role="dialog" aria-modal="true" aria-labelledby="editTagModalLabel"
         data-yj-component="modal-crud">
        <div class="modal-dialog modal-dialog-centered">
            <form asp-area="Admin" asp-controller="Tags" asp-action="Edit"
                  asp-route-id="@Model.Edit.Id" method="post" class="modal-content">
                @Html.AntiForgeryToken()
                <partial name="Partials/_ModalHeader"
                         model="@(new ModalHeaderVm { TitleId = "editTagModalLabel", Title = Localizer["Admin.Tags.EditHeading"].Value, CloseLabel = Localizer["Admin.Tags.Cancel"].Value, CloseUrl = editOpen ? Url.Action("Index") : null })" />
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    <input type="hidden" asp-for="Edit.Id" data-yj-field="id" />
                    <div class="mb-3">
                        <label asp-for="Edit.Name" class="form-label">@Localizer["Admin.Tags.NameLabel"]</label>
                        <input asp-for="Edit.Name" class="form-control" data-yj-field="name" />
                        <span asp-validation-for="Edit.Name" class="text-danger" role="alert"></span>
                    </div>
                    <div class="mb-0">
                        <label asp-for="Edit.Slug" class="form-label">@Localizer["Admin.Tags.SlugLabel"]</label>
                        <input asp-for="Edit.Slug" class="form-control" dir="ltr" aria-describedby="edit-tag-slug-help" data-yj-field="slug" />
                        <small id="edit-tag-slug-help" class="form-text">@Localizer["Admin.Tags.SlugHelp"]</small>
                        <span asp-validation-for="Edit.Slug" class="text-danger" role="alert"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    @if (editOpen)
                    {
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">@Localizer["Admin.Tags.Cancel"]</a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.Tags.Cancel"]</button>
                    }
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk fa-fw" aria-hidden="true"></i> @Localizer["Admin.Tags.Save"]
                    </button>
                </div>
            </form>
        </div>
    </div>
    @if (editOpen)
    {
        <div class="modal-backdrop fade show"></div>
    }
</permission>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/admin-modal-crud.js" asp-append-version="true"></script>
}
