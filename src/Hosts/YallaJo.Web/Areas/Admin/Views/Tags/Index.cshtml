@using YallaJo.Web.Infrastructure.Authorization
@model YallaJo.Web.Areas.Admin.Models.Tags.TagListVm
@{
    ViewData["Title"] = "Tags";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Tags</h2>

    @if (TempData["Success"] is string ok)  { <div class="alert alert-success">@ok</div> }
    @if (TempData["Error"]   is string err) { <div class="alert alert-danger">@err</div> }
    @if (ViewBag.Error       is string vbe) { <div class="alert alert-danger">@vbe</div> }

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <permission require="@WebPermission.Tag.Create">
        <div class="card mb-4 p-3">
            <h5>Create Tag</h5>
            <form asp-area="Admin" asp-controller="Tags" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-2">
                    <div class="col-md-5">
                        <label asp-for="Create.Name" class="form-label"></label>
                        <input asp-for="Create.Name" class="form-control" />
                        <span asp-validation-for="Create.Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Create.Slug" class="form-label"></label>
                        <input asp-for="Create.Slug" class="form-control" />
                        <span asp-validation-for="Create.Slug" class="text-danger"></span>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary">Create</button>
                    </div>
                </div>
            </form>
        </div>
    </permission>

    <table class="table table-sm table-bordered">
        <thead>
            <tr>
                <th>Name</th>
                <th>Slug</th>
                <th>Active</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Tags)
            {
                <tr>
                    <td>@t.Name</td>
                    <td>@t.Slug</td>
                    <td>@(t.IsActive ? "✓" : "—")</td>
                    <td>
                        <permission require="@WebPermission.Tag.Update">
                            <a asp-area="Admin" asp-controller="Tags" asp-action="Edit" asp-route-id="@t.Id"
                               class="btn btn-sm btn-outline-secondary">Edit</a>
                        </permission>
                        <permission require="@WebPermission.Tag.Delete">
                            <form asp-area="Admin" asp-controller="Tags" asp-action="Delete" asp-route-id="@t.Id"
                                  method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Delete this tag?');">Delete</button>
                            </form>
                        </permission>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
