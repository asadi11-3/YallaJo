@using Microsoft.Extensions.Localization
@model YallaJo.Web.Areas.Admin.Models.Tags.UpdateTagVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Tags.EditTitle"].Value;
    ViewData["AdminNav"] = "Tags";
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Tags.EditHeading"]</h1>
        <p class="text-secondary mb-0 fw-semibold">@Model.Name</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left fa-fw" aria-hidden="true"></i> @Localizer["Admin.Tags.Back"]
    </a>
</div>

<section class="card shadow" aria-labelledby="edit-tag-heading">
    <div class="card-header border-bottom">
        <h2 id="edit-tag-heading" class="card-header-title h5 mb-0">@Localizer["Admin.Tags.EditHeading"]</h2>
    </div>
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Tags" asp-action="Edit"
              asp-route-id="@Model.Id" method="post" class="col-lg-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">@Localizer["Admin.Tags.NameLabel"]</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger" role="alert"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slug" class="form-label">@Localizer["Admin.Tags.SlugLabel"]</label>
                <input asp-for="Slug" class="form-control" dir="ltr" aria-describedby="edit-tag-slug-help" />
                <small id="edit-tag-slug-help" class="form-text">@Localizer["Admin.Tags.SlugHelp"]</small>
                <span asp-validation-for="Slug" class="text-danger" role="alert"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-floppy-disk fa-fw" aria-hidden="true"></i> @Localizer["Admin.Tags.Save"]
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Admin.Tags.Cancel"]</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
