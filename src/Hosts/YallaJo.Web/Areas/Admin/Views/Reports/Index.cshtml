@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.Reports
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Shared
@model ReportsVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Reports.Title"].Value;
    ViewData["AdminNav"] = "Reports";
    var culture = CultureInfo.CurrentCulture;
    string Date(DateTime dt) => dt.ToString("yyyy-MM-dd HH:mm", culture);
    var actions = new[] { "Dismiss", "RemoveContent", "WarnUser", "BanUser", "RestoreContent", "UnbanUser" };
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Reports.Title"]</h1>
        <p class="text-secondary mb-0">@Localizer["Admin.Reports.Subtitle"]</p>
    </div>
</div>

@if (ViewBag.Error is string err && !string.IsNullOrWhiteSpace(err))
{
    <div class="alert alert-danger" role="alert">@err</div>
}

@if (Model.Reports.Count == 0)
{
    <section class="card shadow">
        <partial name="Partials/_EmptyState"
                 model="@(new EmptyStateVm { Message = Localizer["Admin.Reports.EmptyMessage"].Value, ContainerClass = "card-body text-center py-5" })" />
    </section>
}
else
{
    <section class="card shadow" aria-labelledby="reports-heading">
        <div class="card-header border-bottom">
            <h2 id="reports-heading" class="card-header-title h5 mb-0">@Localizer["Admin.Reports.Directory"]</h2>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["Admin.Reports.ColReporter"]</th>
                        <th scope="col">@Localizer["Admin.Reports.ColTarget"]</th>
                        <th scope="col">@Localizer["Admin.Reports.ColReason"]</th>
                        <th scope="col">@Localizer["Admin.Reports.ColStatus"]</th>
                        <th scope="col">@Localizer["Admin.Reports.ColSubmitted"]</th>
                        <th scope="col" class="text-end">@Localizer["Admin.Reports.ColActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Reports)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(r.ReporterEmail))
                                {
                                    <span class="fw-semibold"><bdi dir="ltr">@r.ReporterEmail</bdi></span>
                                }
                                else
                                {
                                    <span class="text-secondary">@Localizer["Admin.Reports.UnknownReporter"]</span>
                                }
                            </td>
                            <td><span class="fw-semibold">@r.EntityType</span></td>
                            <td>
                                <div>@r.Reason</div>
                                @if (!string.IsNullOrWhiteSpace(r.Description))
                                {
                                    <div class="text-secondary small">@r.Description</div>
                                }
                            </td>
                            <td>
                                <span class="badge bg-@ReportsMapper.StatusColor(r.Status) bg-opacity-10 text-@ReportsMapper.StatusColor(r.Status)">
                                    <i class="fa-solid fa-@(ReportsMapper.StatusIcon(r.Status)) fa-fw" aria-hidden="true"></i>
                                    @Localizer["Admin.Reports.Status." + r.Status]
                                </span>
                            </td>
                            <td><bdi dir="ltr" class="font-data">@Date(r.SubmittedAt)</bdi></td>
                            <td class="text-end">
                                @if (r.CanResolve)
                                {
                                    <permission require="@WebPermission.AdminModerationQueue.Resolve">
                                        <button type="button" class="btn btn-sm btn-primary-soft" data-bs-toggle="modal" data-bs-target="#resolveModal-@r.Id.ToString("N")">
                                            <i class="fa-solid fa-gavel fa-fw" aria-hidden="true"></i> @Localizer["Admin.Reports.Resolve"]
                                        </button>
                                    </permission>
                                }
                                else
                                {
                                    <span class="text-secondary" aria-label="@Localizer["Admin.Reports.NoAction"]">&mdash;</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.NextCursor is { } next && next != Guid.Empty)
        {
            <div class="card-footer border-top text-center">
                <a class="btn btn-sm btn-outline-primary" asp-action="Index" asp-route-afterCursor="@next">
                    <i class="fa-solid fa-arrow-down fa-fw" aria-hidden="true"></i> @Localizer["Admin.Reports.LoadMore"]
                </a>
            </div>
        }
    </section>

    <permission require="@WebPermission.AdminModerationQueue.Resolve">
        @foreach (var r in Model.Reports.Where(x => x.CanResolve))
        {
            var modalId = "resolveModal-" + r.Id.ToString("N");
            var titleId = modalId + "-title";
            var bodyId = modalId + "-body";
            <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="@titleId" aria-describedby="@bodyId" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                <div class="modal-dialog modal-dialog-centered">
                    <form asp-action="Resolve" asp-route-id="@r.Id" method="post" class="modal-content" role="dialog" aria-modal="true" aria-labelledby="@titleId">
                        @Html.AntiForgeryToken()
                        <partial name="Partials/_ModalHeader"
                                 model="@(new ModalHeaderVm { TitleId = titleId, Title = Localizer["Admin.Reports.ResolveTitle"].Value, CloseLabel = Localizer["Admin.Reports.Close"].Value })" />
                        <div class="modal-body" id="@bodyId">
                            <label class="form-label" for="@(modalId)-action">@Localizer["Admin.Reports.ActionLabel"]</label>
                            <select name="action" id="@(modalId)-action" class="form-select mb-3" required>
                                @foreach (var a in actions)
                                {
                                    <option value="@a">@Localizer["Admin.Reports.Action." + a]</option>
                                }
                            </select>
                            <label class="form-label" for="@(modalId)-notes">@Localizer["Admin.Reports.NotesLabel"]</label>
                            <textarea name="notes" id="@(modalId)-notes" class="form-control" rows="3" maxlength="1000" aria-describedby="@(modalId)-notes-help"></textarea>
                            <div class="form-text" id="@(modalId)-notes-help">@Localizer["Admin.Reports.NotesHelp"]</div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.Reports.Cancel"]</button>
                            <button type="submit" class="btn btn-primary">@Localizer["Admin.Reports.ResolveSubmit"]</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </permission>
}
