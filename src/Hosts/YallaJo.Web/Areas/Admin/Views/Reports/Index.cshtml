@using YallaJo.Web.Areas.Admin.Models.Reports
@using YallaJo.Web.Infrastructure.Authorization
@model ReportsVm
@{
    ViewData["Title"] = "Reports";
    ViewData["AdminNav"] = "Reports";
    var actions = new[] { "Dismiss", "RemoveContent", "WarnUser", "BanUser", "RestoreContent", "UnbanUser" };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Reports</h1>
        <p class="text-secondary mb-0">User-submitted content reports awaiting moderation.</p>
    </div>
</div>

@if (Model.Reports.Count == 0)
{
    <div class="card card-body shadow text-center py-5">
        <img src="~/assets/images/element/17.svg" class="h-80px mb-3 mx-auto" alt="" />
        <p class="text-secondary mb-0">No reports to display.</p>
    </div>
}
else
{
    <div class="card shadow">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Report</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Reports)
                    {
                        <tr>
                            <td>
                                <div class="font-data small">@r.Id.ToString("D")[..8]</div>
                                <div class="text-secondary small">@r.EntityType <span class="font-data">@r.EntityId.ToString("D")[..8]</span></div>
                            </td>
                            <td>
                                <div>@r.Reason</div>
                                <div class="text-secondary small">@r.Description</div>
                            </td>
                            <td><span class="badge bg-@ReportsMapper.StatusColor(r.Status) bg-opacity-10 text-@ReportsMapper.StatusColor(r.Status)">@r.Status</span></td>
                            <td class="font-data">@r.SubmittedAt.ToString("g")</td>
                            <td class="text-end">
                                @if (r.CanResolve)
                                {
                                    <permission require="@WebPermission.AdminModerationQueue.Resolve">
                                        <button type="button" class="btn btn-sm btn-primary-soft" data-bs-toggle="modal" data-bs-target="#resolveModal-@r.Id">Resolve</button>
                                    </permission>
                                }
                                else
                                {
                                    <span class="text-secondary">&mdash;</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.NextCursor is { } next && next != Guid.Empty)
    {
        <div class="mt-3 text-center">
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-afterCursor="@next">Load more</a>
        </div>
    }

    <permission require="@WebPermission.AdminModerationQueue.Resolve">
        @foreach (var r in Model.Reports.Where(x => x.CanResolve))
        {
            <div class="modal fade" id="resolveModal-@r.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <form asp-action="Resolve" asp-route-id="@r.Id" method="post" class="modal-content">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title">Resolve report</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <label class="form-label">Action</label>
                            <select name="action" class="form-select mb-3" required>
                                @foreach (var a in actions)
                                {
                                    <option value="@a">@a</option>
                                }
                            </select>
                            <label class="form-label">Notes</label>
                            <textarea name="notes" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Resolve</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </permission>
}
