@model YallaJo.Web.Areas.Admin.Models.Statistics.StatisticsVm
@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.Shared
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Stats.Title"].Value;
    ViewData["AdminNav"] = "Statistics";

    var culture = CultureInfo.CurrentCulture;
    string Count(int n) => n.ToString("N0", culture);

    // F10: never surface a raw entity GUID. Resolve to a human name when the
    // backend could fetch one, else fall back to the localized entity-type label.
    string EntityLabel(YallaJo.Web.Areas.Admin.Models.Statistics.InteractionRowVm r)
    {
        if (!string.IsNullOrWhiteSpace(r.EntityName))
        {
            return r.EntityName!;
        }
        var key = $"Admin.Stats.Entity.{r.EntityType}";
        var localized = Localizer[key];
        return localized.ResourceNotFound ? r.EntityType : localized.Value;
    }

    var queryInteractionType = Model.IsUserLookup
        ? string.Empty
        : ViewContext.HttpContext.Request.Query["InteractionType"].ToString();
    var queryEntityType = Model.IsUserLookup
        ? string.Empty
        : ViewContext.HttpContext.Request.Query["EntityType"].ToString();

    var typeLabelsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.TypeBreakdown.Select(t => t.InteractionType));
    var typeCountsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.TypeBreakdown.Select(t => t.Count));
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Stats.Title"]</h1>
        <p class="mb-0 text-secondary">@Localizer["Admin.Stats.Subtitle"]</p>
    </div>
</div>

<!-- Filters -->
<div class="card shadow mb-4">
    <div class="card-header border-bottom">
        <h2 class="card-header-title h5 mb-0">@Localizer["Admin.Stats.FiltersHeading"]</h2>
    </div>
    <div class="card-body">
        <form method="get" asp-area="Admin" asp-controller="Statistics" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-sm-6 col-lg-4">
                <label class="form-label" for="InteractionType">@Localizer["Admin.Stats.InteractionTypeLabel"]</label>
                <input type="text" class="form-control" id="InteractionType" name="InteractionType"
                       value="@queryInteractionType"
                       aria-describedby="InteractionTypeHelp"
                       placeholder="@Localizer["Admin.Stats.InteractionTypePlaceholder"]" />
                <small id="InteractionTypeHelp" class="form-text text-secondary">@Localizer["Admin.Stats.InteractionTypeHelp"]</small>
            </div>
            <div class="col-sm-6 col-lg-4">
                <label class="form-label" for="EntityType">@Localizer["Admin.Stats.EntityTypeLabel"]</label>
                <input type="text" class="form-control" id="EntityType" name="EntityType"
                       value="@queryEntityType"
                       aria-describedby="EntityTypeHelp"
                       placeholder="@Localizer["Admin.Stats.EntityTypePlaceholder"]" />
                <small id="EntityTypeHelp" class="form-text text-secondary">@Localizer["Admin.Stats.EntityTypeHelp"]</small>
            </div>
            <div class="col-lg-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@Localizer["Admin.Stats.Apply"]</button>
                <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Statistics" asp-action="Index">@Localizer["Admin.Stats.Reset"]</a>
            </div>
        </form>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Type breakdown -->
    <div class="col-xxl-5">
        <div class="card shadow h-100">
            <div class="card-header border-bottom">
                <h2 class="card-header-title h5 mb-0">@Localizer["Admin.Stats.ChartHeading"]</h2>
            </div>
            <div class="card-body">
                @if (Model.TypeBreakdown.Count > 0)
                {
                    @*
                        Chart region four-states (§4.8): skeleton overlay reserves the final chart
                        height (zero CLS — L1), opacity-only shimmer (X13) gated by reduced-motion
                        (M3, site.css). admin-statistics.js removes it on render completion or shows
                        an inline retryable error (ERR3) from the localized data-* copy (CON1).
                        aria-live announces the settled chart politely (A11Y9).
                    *@
                    <div id="ChartTypes" role="img" aria-label="@Localizer["Admin.Stats.ChartAriaLabel"]"
                         aria-live="polite" aria-busy="true" class="position-relative yj-chart-host-320"
                         data-error-text="@Localizer["Public.Results.Error"]" data-retry-text="@Localizer["Public.Retry"]">
                        <div class="position-absolute top-0 start-0 w-100 h-100 placeholder-glow" data-yj-skeleton aria-hidden="true">
                            <span class="placeholder w-100 h-100 rounded"></span>
                        </div>
                    </div>
                    @* SANITIZED (SEC3): both values come from System.Text.Json.JsonSerializer.Serialize
                       (see typeLabelsJson/typeCountsJson above). The default System.Text.Json encoder is
                       HTML-safe — it escapes <, >, &, ' and non-ASCII as \uXXXX, so a value containing
                       "</script>" is emitted as "\u003C/script\u003E" and cannot break out of this
                       non-executable application/json island. Html.Raw only suppresses Razor's
                       double-encoding of that already-safe JSON. *@
                    <script type="application/json" data-yj-component="admin-statistics">
                        {
                            "typeLabels": @Html.Raw(typeLabelsJson),
                            "typeCounts": @Html.Raw(typeCountsJson)
                        }
                    </script>
                }
                else
                {
                    <partial name="Partials/_EmptyState"
                             model="@(new EmptyStateVm { Message = Localizer["Admin.Stats.EmptyChart"].Value, ImageClass = "mb-3" })" />
                }
            </div>
        </div>
    </div>

    <!-- Summary -->
    <div class="col-xxl-7">
        <div class="card shadow h-100">
            <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                <h2 class="card-header-title h5 mb-0">
                    @(Model.IsUserLookup ? Localizer["Admin.Stats.SummaryForUser"] : Localizer["Admin.Stats.SummaryRecent"])
                </h2>
                <span class="badge bg-secondary bg-opacity-10 text-secondary">
                    <bdi class="font-data">@Count(Model.TotalShown)</bdi> @Localizer["Admin.Stats.ShownLabel"]
                </span>
            </div>
            <div class="card-body p-0">
                @if (Model.Recent.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">@Localizer["Admin.Stats.ColType"]</th>
                                    <th scope="col">@Localizer["Admin.Stats.ColEntity"]</th>
                                    <th scope="col">@Localizer["Admin.Stats.ColUser"]</th>
                                    <th scope="col">@Localizer["Admin.Stats.ColWhen"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.Recent)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-info bg-opacity-10 text-info">@row.InteractionType</span>
                                        </td>
                                        <td>
                                            <span class="fw-semibold">@EntityLabel(row)</span>
                                            <div class="small text-secondary">@row.EntityType</div>
                                        </td>
                                        <td class="small">
                                            @if (!string.IsNullOrWhiteSpace(row.UserName))
                                            {
                                                <bdi dir="ltr">@row.UserName</bdi>
                                            }
                                            else
                                            {
                                                <span class="text-secondary">@Localizer["Admin.Stats.Anonymous"]</span>
                                            }
                                        </td>
                                        <td class="small text-secondary">
                                            <bdi class="font-data">@row.OccurredAt.ToString("g", culture)</bdi>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <partial name="Partials/_EmptyState"
                             model="@(new EmptyStateVm { Message = Localizer["Admin.Stats.EmptyTable"].Value, CtaText = Localizer["Admin.Stats.EmptyCta"].Value, CtaUrl = Url.Action("Index", "Statistics", new { area = "Admin" }), ImageClass = "mb-3" })" />
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    @* Per-page chart bundle (A6/J2) — only the chart views pay for ApexCharts. *@
    <link rel="stylesheet" type="text/css" href="~/assets/vendor/apexcharts/css/apexcharts.css" />
}

@section Scripts {
    @* Deferred scripts execute in document order: ApexCharts is defined before the page script runs. *@
    <script src="~/assets/vendor/apexcharts/js/apexcharts.min.js" defer></script>
    <script src="~/assets/js/admin-statistics.js" asp-append-version="true" defer></script>
}
