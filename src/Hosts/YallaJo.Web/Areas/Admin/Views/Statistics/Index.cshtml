@model YallaJo.Web.Areas.Admin.Models.Statistics.StatisticsVm
@{
    ViewData["Title"] = "Analytics";
    ViewData["AdminNav"] = "Statistics";
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Analytics</h1>
</div>

<!-- Filters -->
<div class="card shadow mb-4">
    <div class="card-body">
        <form method="get" asp-area="Admin" asp-controller="Statistics" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="InteractionType">Interaction type</label>
                <input type="text" class="form-control" id="InteractionType" name="InteractionType"
                       value="@(Model.IsUserLookup ? string.Empty : ViewContext.HttpContext.Request.Query["InteractionType"].ToString())"
                       placeholder="e.g. view, favorite" />
            </div>
            <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="EntityType">Entity type</label>
                <input type="text" class="form-control" id="EntityType" name="EntityType"
                       value="@(Model.IsUserLookup ? string.Empty : ViewContext.HttpContext.Request.Query["EntityType"].ToString())"
                       placeholder="e.g. Tour, Place" />
            </div>
            <div class="col-sm-6 col-lg-3">
                <label class="form-label" for="UserId">User id (lookup)</label>
                <input type="text" class="form-control font-data" id="UserId" name="UserId"
                       value="@Model.UserLookupId" placeholder="GUID" />
            </div>
            <div class="col-sm-6 col-lg-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Apply</button>
                <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Statistics" asp-action="Index">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Type breakdown -->
    <div class="col-xxl-5">
        <div class="card shadow h-100">
            <div class="card-header border-bottom">
                <h5 class="card-header-title mb-0">Interaction types</h5>
            </div>
            <div class="card-body">
                @if (Model.TypeBreakdown.Count > 0)
                {
                    <div id="ChartTypes"></div>
                }
                else
                {
                    <div class="text-center py-5">
                        <img src="~/assets/images/element/17.svg" alt="" class="h-80px mb-3" />
                        <p class="mb-0 text-secondary">No interactions match this filter.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Summary -->
    <div class="col-xxl-7">
        <div class="card shadow h-100">
            <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-header-title mb-0">
                    @(Model.IsUserLookup ? "Interactions for user" : "Recent interactions")
                </h5>
                <span class="badge bg-secondary bg-opacity-10 text-secondary">
                    <span class="font-data">@Model.TotalShown.ToString("N0")</span> shown
                </span>
            </div>
            <div class="card-body p-0">
                @if (Model.Recent.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Entity</th>
                                    <th>User</th>
                                    <th>When</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.Recent)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-info bg-opacity-10 text-info">@row.InteractionType</span>
                                        </td>
                                        <td>
                                            <span class="fw-semibold">@row.EntityType</span>
                                            <div class="font-data small text-secondary">@row.EntityId</div>
                                        </td>
                                        <td class="font-data small">@(row.UserId?.ToString() ?? "anonymous")</td>
                                        <td class="font-data small text-secondary">@row.OccurredAt.ToString("g")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <img src="~/assets/images/element/17.svg" alt="" class="h-80px mb-3" />
                        <p class="mb-0 text-secondary">No interactions to show.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var typeLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TypeBreakdown.Select(t => t.InteractionType)));
            var typeCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TypeBreakdown.Select(t => t.Count)));

            var ink = getComputedStyle(document.body).getPropertyValue('--bs-body-color') || '#212529';

            function exists(id) { return document.getElementById(id) !== null; }

            if (exists('ChartTypes') && typeCounts.length) {
                new ApexCharts(document.getElementById('ChartTypes'), {
                    chart: { type: 'donut', height: 320, fontFamily: 'inherit' },
                    series: typeCounts,
                    labels: typeLabels,
                    colors: ['#5143d9', '#0cbc87', '#4f9ef8', '#f7c32e', '#d6293e'],
                    legend: { position: 'bottom', labels: { colors: ink } },
                    dataLabels: { enabled: true }
                }).render();
            }
        })();
    </script>
}
