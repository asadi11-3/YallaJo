@using YallaJo.Web.Areas.Admin.Models.Growth
@using YallaJo.Web.Infrastructure.Authorization
@model GrowthVm
@{
    ViewData["Title"] = "Growth tools";
    ViewData["AdminNav"] = "Growth";

    string MonthName(int m) => m is >= 1 and <= 12
        ? System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m)
        : m.ToString();
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Growth tools</h1>
        <p class="text-secondary mb-0">Seasonality boosts, holiday calendar, photogenic flags, A/B experiments, and re-engagement segments.</p>
    </div>
</div>

@if (ViewData["SegmentJson"] is string segmentJson)
{
    <div class="card shadow mb-4">
        <div class="card-header"><strong>Segment result</strong> <span class="text-secondary">— rule: @ViewData["SegmentRule"]</span></div>
        <div class="card-body">
            <pre class="mb-0 small" dir="ltr" style="white-space:pre-wrap;">@segmentJson</pre>
        </div>
    </div>
}

<div class="row g-4">
    <!-- ── Seasonality rules ─────────────────────────────────────────── -->
    <div class="col-xl-6">
        <div class="card shadow h-100">
            <div class="card-header"><strong>Seasonality rules</strong></div>
            <div class="card-body">
                @if (Model.SeasonalityLoadFailed)
                {
                    <div class="alert alert-warning">
                        <i class="fa-solid fa-triangle-exclamation fa-fw" aria-hidden="true"></i>
                        Could not load seasonality rules.
                    </div>
                }
                else if (Model.SeasonalityRules.Count == 0)
                {
                    <p class="text-secondary">No active seasonality rules.</p>
                }
                else
                {
                    <div class="table-responsive mb-3">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Place</th>
                                    <th scope="col">Window</th>
                                    <th scope="col" class="text-end">Multiplier</th>
                                    <th scope="col"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.SeasonalityRules)
                                {
                                    <tr>
                                        <td><bdi class="font-data small" dir="ltr">@r.PlaceId.ToString("D")[..8]…</bdi></td>
                                        <td class="small">@MonthName(r.MonthStart) – @MonthName(r.MonthEnd)</td>
                                        <td class="text-end font-data">×@r.Multiplier.ToString("0.00")</td>
                                        <td class="text-end">
                                            <permission require="@WebPermission.SeasonalityRule.Delete">
                                                <form method="post" asp-area="Admin" asp-controller="Growth"
                                                      asp-action="DeactivateSeasonalityRule" asp-route-ruleId="@r.Id"
                                                      onsubmit="return confirm('Deactivate this seasonality rule?');" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                                                </form>
                                            </permission>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <permission require="@WebPermission.SeasonalityRule.Create">
                    <form method="post" asp-area="Admin" asp-controller="Growth" asp-action="CreateSeasonalityRule" class="border-top pt-3">
                        @Html.AntiForgeryToken()
                        <h2 class="h6">Add a rule</h2>
                        <div class="mb-2">
                            <label class="form-label small" for="s-place">Place ID</label>
                            <input type="text" class="form-control form-control-sm font-data" id="s-place" name="PlaceId" required />
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col">
                                <label class="form-label small" for="s-start">Month start</label>
                                <input type="number" min="1" max="12" class="form-control form-control-sm" id="s-start" name="MonthStart" required />
                            </div>
                            <div class="col">
                                <label class="form-label small" for="s-end">Month end</label>
                                <input type="number" min="1" max="12" class="form-control form-control-sm" id="s-end" name="MonthEnd" required />
                            </div>
                            <div class="col">
                                <label class="form-label small" for="s-mult">Multiplier</label>
                                <input type="number" step="0.01" min="0.01" class="form-control form-control-sm" id="s-mult" name="Multiplier" value="1.00" required />
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small" for="s-desc">Description</label>
                            <input type="text" class="form-control form-control-sm" id="s-desc" name="Description" maxlength="200" />
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary">Create rule</button>
                    </form>
                </permission>
            </div>
        </div>
    </div>

    <!-- ── Holiday calendar ──────────────────────────────────────────── -->
    <div class="col-xl-6">
        <div class="card shadow h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Holiday calendar</strong>
                <form method="get" asp-area="Admin" asp-controller="Growth" asp-action="Index" class="d-flex gap-2 align-items-center">
                    <label class="form-label small mb-0" for="h-year">Year</label>
                    <input type="number" min="2000" max="2100" class="form-control form-control-sm" style="width:6rem"
                           id="h-year" name="year" value="@Model.Year" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary">View</button>
                </form>
            </div>
            <div class="card-body">
                @if (Model.HolidaysLoadFailed)
                {
                    <div class="alert alert-warning">Could not load the holiday calendar.</div>
                }
                else if (Model.Holidays.Count == 0)
                {
                    <p class="text-secondary">No holiday entries for @Model.Year.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var h in Model.Holidays)
                        {
                            <li class="list-group-item d-flex justify-content-between px-0">
                                <span>@h.HolidayName</span>
                                <span class="text-secondary small font-data" dir="ltr">@h.StartDate.ToString("MMM d") – @h.EndDate.ToString("MMM d")</span>
                            </li>
                        }
                    </ul>
                }

                <permission require="@WebPermission.HolidayCalendar.Create">
                    <form method="post" asp-area="Admin" asp-controller="Growth" asp-action="CreateHoliday" class="border-top pt-3">
                        @Html.AntiForgeryToken()
                        <h2 class="h6">Add a holiday</h2>
                        <div class="mb-2">
                            <label class="form-label small" for="h-name">Name</label>
                            <input type="text" class="form-control form-control-sm" id="h-name" name="HolidayName" maxlength="200" required />
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col">
                                <label class="form-label small" for="h-start">Start</label>
                                <input type="date" class="form-control form-control-sm" id="h-start" name="StartDate" required />
                            </div>
                            <div class="col">
                                <label class="form-label small" for="h-end">End</label>
                                <input type="date" class="form-control form-control-sm" id="h-end" name="EndDate" required />
                            </div>
                            <div class="col">
                                <label class="form-label small" for="h-yr">Year</label>
                                <input type="number" min="2000" max="2100" class="form-control form-control-sm" id="h-yr" name="Year" value="@Model.Year" required />
                            </div>
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary">Create holiday</button>
                    </form>
                </permission>
            </div>
        </div>
    </div>

    <!-- ── A/B experiments ───────────────────────────────────────────── -->
    <permission require="@WebPermission.Experiment.Create">
        <div class="col-xl-6">
            <div class="card shadow h-100">
                <div class="card-header"><strong>A/B experiments</strong></div>
                <div class="card-body">
                    <form method="post" asp-area="Admin" asp-controller="Growth" asp-action="CreateExperiment" class="mb-3">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <label class="form-label small" for="e-name">Name</label>
                            <input type="text" class="form-control form-control-sm" id="e-name" name="Name" maxlength="200" required />
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col">
                                <label class="form-label small" for="e-start">Starts</label>
                                <input type="datetime-local" class="form-control form-control-sm" id="e-start" name="StartsAt" required />
                            </div>
                            <div class="col">
                                <label class="form-label small" for="e-end">Expires</label>
                                <input type="datetime-local" class="form-control form-control-sm" id="e-end" name="ExpiresAt" required />
                            </div>
                            <div class="col">
                                <label class="form-label small" for="e-traffic">Traffic %</label>
                                <input type="number" min="0" max="100" class="form-control form-control-sm" id="e-traffic" name="TrafficPercent" value="100" required />
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small" for="e-variants">Variants (JSON)</label>
                            <textarea class="form-control form-control-sm font-data" id="e-variants" name="VariantsJson" rows="2" dir="ltr">[]</textarea>
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary">Create experiment</button>
                    </form>

                    <div class="border-top pt-3">
                        <h2 class="h6">Manage by ID</h2>
                        <div class="d-flex flex-wrap gap-2">
                            <form method="post" asp-area="Admin" asp-controller="Growth" asp-action="StartExperiment" class="d-flex gap-2">
                                @Html.AntiForgeryToken()
                                <input type="text" class="form-control form-control-sm font-data" name="experimentId" placeholder="Experiment ID" required />
                                <button type="submit" class="btn btn-sm btn-outline-success">Start</button>
                            </form>
                            <form method="post" asp-area="Admin" asp-controller="Growth" asp-action="CompleteExperiment" class="d-flex gap-2"
                                  onsubmit="return confirm('Complete this experiment? It can no longer collect data afterwards.');">
                                @Html.AntiForgeryToken()
                                <input type="text" class="form-control form-control-sm font-data" name="experimentId" placeholder="Experiment ID" required />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Complete</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </permission>

    <!-- ── Photogenic + Segments ─────────────────────────────────────── -->
    <div class="col-xl-6">
        <permission require="@WebPermission.Photogenic.Update">
            <div class="card shadow mb-4">
                <div class="card-header"><strong>Photogenic flag</strong></div>
                <div class="card-body">
                    <form method="post" asp-area="Admin" asp-controller="Growth" asp-action="SetPhotogenic" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <div class="col-sm-4">
                            <label class="form-label small" for="p-kind">Entity kind</label>
                            <input type="text" class="form-control form-control-sm" id="p-kind" name="kind" placeholder="Tour / Place" required />
                        </div>
                        <div class="col-sm-5">
                            <label class="form-label small" for="p-id">Entity ID</label>
                            <input type="text" class="form-control form-control-sm font-data" id="p-id" name="entityId" required />
                        </div>
                        <div class="col-sm-3 form-check mt-4 ms-2">
                            <input type="checkbox" class="form-check-input" id="p-flag" name="isPhotogenic" value="true" checked />
                            <label class="form-check-label small" for="p-flag">Photogenic</label>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-sm btn-primary">Apply</button>
                        </div>
                    </form>
                </div>
            </div>
        </permission>

        <div class="card shadow">
            <div class="card-header"><strong>Re-engagement segments</strong></div>
            <div class="card-body">
                <form method="get" asp-area="Admin" asp-controller="Growth" asp-action="Segment" class="row g-2 align-items-end">
                    <div class="col-sm-5">
                        <label class="form-label small" for="seg-rule">Rule</label>
                        <input type="text" class="form-control form-control-sm" id="seg-rule" name="rule" required />
                    </div>
                    <div class="col-sm-3">
                        <label class="form-label small" for="seg-kind">Entity kind</label>
                        <input type="text" class="form-control form-control-sm" id="seg-kind" name="entityKind" />
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label small" for="seg-id">Entity ID</label>
                        <input type="text" class="form-control form-control-sm font-data" id="seg-id" name="entityId" />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-sm btn-primary">Query segment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
