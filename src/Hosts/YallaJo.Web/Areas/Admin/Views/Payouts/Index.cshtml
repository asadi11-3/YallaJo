@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.Payouts
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Shared
@model PayoutsVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Payouts.Title"].Value;
    ViewData["AdminNav"] = "Payouts";

    var culture = CultureInfo.CurrentCulture;
    // CON3: culture-aware, JOD uses 3 decimals (fils).
    string Money(decimal amount, string? currency) => amount.ToString("N3", culture) + " " + (currency ?? "JOD");
    string Count(int n) => n.ToString("N0", culture);
    string Date(DateTime dt) => dt.ToString("yyyy-MM-dd HH:mm", culture);
    string Period(DateOnly start, DateOnly end) => start.ToString("yyyy-MM-dd", culture) + " \u2013 " + end.ToString("yyyy-MM-dd", culture);
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Payouts.Title"]</h1>
        <p class="text-secondary mb-0">@Localizer["Admin.Payouts.Subtitle"]</p>
    </div>
    <permission require="@WebPermission.Payout.Trigger">
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#triggerModal">
            <i class="fa-solid fa-arrows-rotate fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Payouts.RunBatch"]
        </button>
    </permission>
</div>

<section class="card shadow" aria-labelledby="payouts-heading">
    <div class="card-header border-bottom d-flex justify-content-between align-items-center">
        <h2 id="payouts-heading" class="card-header-title h5 mb-0">@Localizer["Admin.Payouts.Directory"]</h2>
    </div>

    @if (Model.Payouts.Count == 0)
    {
        <div class="card-body">
            <partial name="Partials/_EmptyState"
                     model="@(new EmptyStateVm { Message = Localizer["Admin.Payouts.EmptyMessage"].Value, CtaText = Localizer["Admin.Payouts.EmptyCta"].Value, CtaUrl = Url.Action("Index", "Home") })" />
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["Admin.Payouts.ColPeriod"]</th>
                        <th scope="col" class="text-end">@Localizer["Admin.Payouts.ColGross"]</th>
                        <th scope="col" class="text-end">@Localizer["Admin.Payouts.ColCommission"]</th>
                        <th scope="col" class="text-end">@Localizer["Admin.Payouts.ColNet"]</th>
                        <th scope="col" class="text-end">@Localizer["Admin.Payouts.ColLines"]</th>
                        <th scope="col">@Localizer["Admin.Payouts.ColStatus"]</th>
                        <th scope="col">@Localizer["Admin.Payouts.ColCreated"]</th>
                        <th scope="col" class="text-end">@Localizer["Admin.Payouts.ColActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Payouts)
                    {
                        var color = PayoutsMapper.StatusColor(p.Status);
                        var icon = PayoutsMapper.StatusIcon(p.Status);
                        <tr>
                            <td>
                                <span class="fw-semibold d-block"><bdi dir="ltr" class="font-data">@Period(p.BatchPeriodStart, p.BatchPeriodEnd)</bdi></span>
                                @if (!string.IsNullOrWhiteSpace(p.FailureReason))
                                {
                                    <small class="text-danger d-block">
                                        <i class="fa-solid fa-triangle-exclamation fa-fw" aria-hidden="true"></i> @p.FailureReason
                                    </small>
                                }
                            </td>
                            <td class="text-end"><bdi dir="ltr" class="font-data">@Money(p.GrossAmount, p.Currency)</bdi></td>
                            <td class="text-end"><bdi dir="ltr" class="font-data">@Money(p.CommissionAmount, p.Currency)</bdi></td>
                            <td class="text-end fw-semibold"><bdi dir="ltr" class="font-data">@Money(p.NetAmount, p.Currency)</bdi></td>
                            <td class="text-end"><bdi dir="ltr" class="font-data">@Count(p.ItemCount)</bdi></td>
                            <td>
                                <span class="badge bg-@color bg-opacity-10 text-@color">
                                    <i class="fa-solid fa-@icon fa-fw" aria-hidden="true"></i> @p.Status
                                </span>
                            </td>
                            <td><bdi dir="ltr" class="font-data">@Date(p.CreatedAt)</bdi></td>
                            <td class="text-end">
                                @if (p.CanApprove)
                                {
                                    <permission require="@WebPermission.Payout.Approve">
                                        <form asp-action="Approve" asp-route-id="@p.Id" method="post" class="d-inline"
                                              data-confirm="@Localizer["Admin.Payouts.ApproveConfirm", Money(p.NetAmount, p.Currency)]"
                                              data-confirm-title="@Localizer["Admin.Payouts.ApproveTitle"]"
                                              data-confirm-action="@Localizer["Admin.Payouts.Approve"]" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="fa-solid fa-check fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Payouts.Approve"]
                                            </button>
                                        </form>
                                    </permission>
                                }
                                else
                                {
                                    <span class="text-secondary small" aria-label="@Localizer["Admin.Payouts.NoAction"]">&mdash;</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.NextCursor is { } next && next != Guid.Empty)
        {
            <div class="card-footer border-top text-center">
                <a asp-action="Index" asp-route-Cursor="@next" class="btn btn-outline-primary btn-sm">
                    @Localizer["Admin.Payouts.LoadMore"]
                </a>
            </div>
        }
    }
</section>

<permission require="@WebPermission.Payout.Trigger">
    <div class="modal fade" id="triggerModal" tabindex="-1" aria-labelledby="triggerModalTitle" aria-describedby="triggerModalBody"
         aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <form asp-action="Trigger" method="post" class="modal-content" role="dialog" aria-modal="true" aria-labelledby="triggerModalTitle">
                @Html.AntiForgeryToken()
                <partial name="Partials/_ModalHeader"
                         model="@(new ModalHeaderVm { TitleId = "triggerModalTitle", Title = Localizer["Admin.Payouts.RunBatchTitle"].Value, CloseLabel = Localizer["Admin.Payouts.Close"].Value })" />
                <div class="modal-body" id="triggerModalBody">
                    <p class="mb-0">@Localizer["Admin.Payouts.RunBatchBody"]</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Admin.Payouts.Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@Localizer["Admin.Payouts.RunBatchSubmit"]</button>
                </div>
            </form>
        </div>
    </div>
</permission>
