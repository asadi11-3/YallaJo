@using YallaJo.Web.Areas.Admin.Models.Payouts
@using YallaJo.Web.Infrastructure.Authorization
@model PayoutsVm
@{
    ViewData["Title"] = "Payouts";
    ViewData["AdminNav"] = "Payouts";
}

@functions {
    static string Money(decimal amount, string? currency)
        => $"{amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)} {currency}".Trim();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Payouts</h1>
        <p class="text-body-secondary mb-0">Provider payout batches awaiting approval.</p>
    </div>
    <permission require="@WebPermission.Payout.Trigger">
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#triggerModal">
            <i class="bi bi-arrow-repeat fa-fw me-1"></i>Run payout batch
        </button>
    </permission>
</div>

@if (Model.Payouts.Count == 0)
{
    <div class="card card-body shadow text-center py-5">
        <img src="~/assets/images/element/17.svg" class="h-100px mb-3 mx-auto" alt="" />
        <h5 class="mb-1">No pending payouts</h5>
        <p class="text-body-secondary mb-0">There are no payout batches awaiting approval right now.</p>
    </div>
}
else
{
    <div class="card shadow">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Payout</th>
                        <th>Period</th>
                        <th>Net amount</th>
                        <th>Lines</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Payouts)
                    {
                        <tr>
                            <td>
                                <span class="font-data d-block text-truncate" style="max-width: 12ch;">@p.Id.ToString("D")</span>
                                <small class="text-body-secondary font-data">Provider @p.ProviderId.ToString("D").Substring(0, 8)</small>
                            </td>
                            <td class="font-data">@p.BatchPeriodStart.ToString("yyyy-MM-dd") &ndash; @p.BatchPeriodEnd.ToString("yyyy-MM-dd")</td>
                            <td class="font-data">@Money(p.NetAmount, p.Currency)</td>
                            <td class="font-data">@p.ItemCount</td>
                            <td>
                                <span class="badge bg-@PayoutsMapper.StatusColor(p.Status) bg-opacity-10 text-@PayoutsMapper.StatusColor(p.Status)">@p.Status</span>
                            </td>
                            <td class="font-data">@p.CreatedAt.ToString("g")</td>
                            <td class="text-end">
                                @if (p.CanApprove)
                                {
                                    <permission require="@WebPermission.Payout.Approve">
                                        <form asp-action="Approve" asp-route-id="@p.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="bi bi-check2 fa-fw me-1"></i>Approve
                                            </button>
                                        </form>
                                    </permission>
                                }
                                else
                                {
                                    <span class="text-body-secondary small">&mdash;</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.NextCursor is { } next && next != Guid.Empty)
    {
        <div class="text-center mt-3">
            <a asp-action="Index" asp-route-cursor="@next" class="btn btn-outline-primary">Load more</a>
        </div>
    }
}

<permission require="@WebPermission.Payout.Trigger">
    <div class="modal fade" id="triggerModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Trigger" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">Run payout batch</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0">This generates a new payout batch for all eligible providers. Continue?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Run batch</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</permission>
