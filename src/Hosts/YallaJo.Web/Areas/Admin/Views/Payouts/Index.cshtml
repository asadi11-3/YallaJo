@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Models.Payouts
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Shared
@model PayoutsVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Payouts.Title"].Value;
    ViewData["AdminNav"] = "Payouts";
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Payouts.Title"]</h1>
        <p class="text-secondary mb-0">@Localizer["Admin.Payouts.Subtitle"]</p>
    </div>
    <permission require="@WebPermission.Payout.Trigger">
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#triggerModal">
            <i class="fa-solid fa-arrows-rotate fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Payouts.RunBatch"]
        </button>
    </permission>
</div>

<section class="card shadow" aria-labelledby="payouts-heading">
    <div class="card-header border-bottom d-flex justify-content-between align-items-center">
        <h2 id="payouts-heading" class="card-header-title h5 mb-0">@Localizer["Admin.Payouts.Directory"]</h2>
    </div>
    @* S1/L1/A11Y9 — listing.js swaps this fragment in place; ViewBag.Error renders inside it. *@
    <div id="listingResults" data-yj-component="listing" aria-live="polite" aria-busy="false"
         data-error-text="@Localizer["Public.Results.Error"]"
         data-retry-text="@Localizer["Public.Retry"]"
         data-loading-text="@Localizer["Public.Loading"]">
        <partial name="_PayoutsResults" model="Model" />
    </div>
</section>

<permission require="@WebPermission.Payout.Trigger">
    <div class="modal fade" id="triggerModal" tabindex="-1" aria-labelledby="triggerModalTitle" aria-describedby="triggerModalBody"
         aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <form data-loading asp-action="Trigger" method="post" class="modal-content" role="dialog" aria-modal="true" aria-labelledby="triggerModalTitle">
                @Html.AntiForgeryToken()
                <partial name="Partials/_ModalHeader"
                         model="@(new ModalHeaderVm { TitleId = "triggerModalTitle", Title = Localizer["Admin.Payouts.RunBatchTitle"].Value, CloseLabel = Localizer["Admin.Payouts.Close"].Value })" />
                <div class="modal-body" id="triggerModalBody">
                    <p class="mb-0">@Localizer["Admin.Payouts.RunBatchBody"]</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Admin.Payouts.Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@Localizer["Admin.Payouts.RunBatchSubmit"]</button>
                </div>
            </form>
        </div>
    </div>
</permission>

@section Scripts {
    <script src="~/assets/js/listing.js" asp-append-version="true" defer></script>
}
