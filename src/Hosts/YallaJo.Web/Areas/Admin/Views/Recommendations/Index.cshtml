@using YallaJo.Web.Areas.Admin.Models.Recommendations
@using YallaJo.Web.Infrastructure.Authorization
@model RecommendationsVm
@{
    ViewData["Title"] = "Recommendations";
    ViewData["AdminNav"] = "Recommendations";

    var entityKinds = new[] { "Tour", "Place", "Business", "Category" };
    var contexts = new[]
    {
        "SimilarTours", "SimilarBusinesses", "SimilarHotels", "AddAMeal", "AddAnActivity",
        "WhereToStay", "ExploreNearby", "PersonalizedFeed", "BecauseYouViewed", "BecauseYouBooked",
        "PostBookingAddOn", "PostBookingFollowUp"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Recommendations</h1>
        <p class="text-muted mb-0">Suggestion batches, boost packages and editorial pins.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <permission require="@WebPermission.BoostPackage.Create">
            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#createBoostModal">
                <i class="bi bi-rocket-takeoff me-1"></i>Create boost
            </button>
        </permission>
        <permission require="@WebPermission.EditorialPin.Create">
            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#createPinModal">
                <i class="bi bi-pin-angle me-1"></i>Create pin
            </button>
        </permission>
        <permission require="@WebPermission.BoostPackage.Delete">
            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deactivateBoostModal">
                Deactivate boost
            </button>
        </permission>
        <permission require="@WebPermission.EditorialPin.Delete">
            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deactivatePinModal">
                Deactivate pin
            </button>
        </permission>
    </div>
</div>

<div class="card shadow">
    <div class="card-header">
        <h2 class="h6 mb-0">Suggestion batches</h2>
    </div>
    @if (Model.Batches.Count == 0)
    {
        <div class="card-body text-center py-5">
            <img src="~/assets/images/element/17.svg" class="h-80px mb-3" alt="" />
            <p class="text-muted mb-0">No recommendation batches to display.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Batch</th>
                        <th>Source</th>
                        <th>Context</th>
                        <th>Algorithm</th>
                        <th>Items</th>
                        <th>Freshness</th>
                        <th>Computed</th>
                        <permission require="@WebPermission.Batch.Refresh">
                            <th class="text-end">Actions</th>
                        </permission>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Batches)
                    {
                        <tr>
                            <td class="font-data">@b.Id.ToString("D").Substring(0, 8)</td>
                            <td>
                                <span class="d-block">@b.SourceKind</span>
                                <span class="font-data text-muted small">@b.SourceId.ToString("D").Substring(0, 8)</span>
                            </td>
                            <td>@b.Context</td>
                            <td>@b.AlgorithmVersion</td>
                            <td class="font-data">@b.ItemCount</td>
                            <td>
                                <span class="badge bg-@(b.IsStale ? "warning" : "success") bg-opacity-10 text-@(b.IsStale ? "warning" : "success")">
                                    @(b.IsStale ? "Stale" : "Fresh")
                                </span>
                            </td>
                            <td class="font-data">@b.ComputedAt.ToString("g")</td>
                            <permission require="@WebPermission.Batch.Refresh">
                                <td class="text-end">
                                    <form method="post" asp-action="RefreshBatches" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="SourceKind" value="@b.SourceKind" />
                                        <input type="hidden" name="SourceId" value="@b.SourceId" />
                                        <input type="hidden" name="Context" value="@b.Context" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
                                        </button>
                                    </form>
                                </td>
                            </permission>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<permission require="@WebPermission.BoostPackage.Create">
    <div class="modal fade" id="createBoostModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-action="CreateBoost" class="modal-content">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Create boost package</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Provider id</label>
                        <input name="ProviderId" class="form-control font-data" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Entity kind</label>
                        <select name="EntityKind" class="form-select" required>
                            @foreach (var k in entityKinds)
                            {
                                <option value="@k">@k</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Entity id</label>
                        <input name="EntityId" class="form-control font-data" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Multiplier</label>
                        <input name="Multiplier" type="number" step="0.01" class="form-control font-data" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Starts at</label>
                        <input name="StartsAt" type="datetime-local" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Expires at</label>
                        <input name="ExpiresAt" type="datetime-local" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create boost</button>
                </div>
            </form>
        </div>
    </div>
</permission>

<permission require="@WebPermission.EditorialPin.Create">
    <div class="modal fade" id="createPinModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-action="CreatePin" class="modal-content">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Create editorial pin</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Entity kind</label>
                        <select name="EntityKind" class="form-select" required>
                            @foreach (var k in entityKinds)
                            {
                                <option value="@k">@k</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Entity id</label>
                        <input name="EntityId" class="form-control font-data" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Position</label>
                        <input name="Position" type="number" class="form-control font-data" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Context</label>
                        <select name="Context" class="form-select" required>
                            @foreach (var c in contexts)
                            {
                                <option value="@c">@c</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Badge text <span class="text-muted">(optional)</span></label>
                        <input name="BadgeText" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Expires at <span class="text-muted">(optional)</span></label>
                        <input name="ExpiresAt" type="datetime-local" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create pin</button>
                </div>
            </form>
        </div>
    </div>
</permission>

<permission require="@WebPermission.BoostPackage.Delete">
    <div class="modal fade" id="deactivateBoostModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-action="DeactivateBoost" class="modal-content">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Deactivate boost package</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Boost package id</label>
                        <input name="boostId" class="form-control font-data" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Deactivate boost</button>
                </div>
            </form>
        </div>
    </div>
</permission>

<permission require="@WebPermission.EditorialPin.Delete">
    <div class="modal fade" id="deactivatePinModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-action="DeactivatePin" class="modal-content">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Deactivate editorial pin</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Editorial pin id</label>
                        <input name="pinId" class="form-control font-data" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Deactivate pin</button>
                </div>
            </form>
        </div>
    </div>
</permission>
