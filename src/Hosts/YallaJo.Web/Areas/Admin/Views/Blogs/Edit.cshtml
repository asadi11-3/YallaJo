@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Blogs
@model EditBlogVm
@{
    ViewData["Title"] = "Edit blog";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var isPublished = string.Equals(Model.StatusLabel, "Published", StringComparison.OrdinalIgnoreCase);
    var isDraft = string.Equals(Model.StatusLabel, "Draft", StringComparison.OrdinalIgnoreCase);
    var isPendingReview = string.Equals(Model.StatusLabel, "PendingReview", StringComparison.OrdinalIgnoreCase);
    var isHidden = string.Equals(Model.StatusLabel, "Hidden", StringComparison.OrdinalIgnoreCase);
    var isRemoved = string.Equals(Model.StatusLabel, "Removed", StringComparison.OrdinalIgnoreCase);
}

<div class="container mt-4">
    <a asp-area="Admin" asp-controller="Blogs" asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">← Back</a>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Edit blog</h2>
        <div>
            <span class="badge text-bg-secondary">@Model.StatusLabel</span>
            @if (Model.IsFeatured) { <span class="badge text-bg-warning">Featured</span> }
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-4">
        <div class="col-lg-8">
            <form asp-area="Admin" asp-controller="Blogs" asp-action="Edit" asp-route-id="@Model.Id" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="RowVersion" />

                <div class="col-md-8">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="ReadTimeMinutes" class="form-label"></label>
                    <input asp-for="ReadTimeMinutes" class="form-control" />
                    <span asp-validation-for="ReadTimeMinutes" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Slug" class="form-label"></label>
                    <input asp-for="Slug" class="form-control" />
                    <span asp-validation-for="Slug" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="PlaceId" class="form-label"></label>
                    <input asp-for="PlaceId" class="form-control" />
                    <span asp-validation-for="PlaceId" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Summary" class="form-label"></label>
                    <textarea asp-for="Summary" class="form-control" rows="2"></textarea>
                </div>

                <div class="col-12">
                    <label asp-for="Content" class="form-label"></label>
                    <textarea asp-for="Content" class="form-control" rows="12"></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MetaTitle" class="form-label"></label>
                    <input asp-for="MetaTitle" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="MetaDescription" class="form-label"></label>
                    <input asp-for="MetaDescription" class="form-control" />
                </div>

                <div class="col-12">
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </form>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header"><strong>Status actions</strong></div>
                <div class="card-body d-grid gap-2">
                    @if (isPendingReview)
                    {
                        <permission require="@WebPermission.Blog.Approve">
                            <form asp-area="Admin" asp-controller="Blogs" asp-action="Approve" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="fromEdit" value="true" />
                                <button type="submit" class="btn btn-success w-100">Approve &amp; publish</button>
                            </form>
                        </permission>
                        <permission require="@WebPermission.Blog.Reject">
                            <form asp-area="Admin" asp-controller="Blogs" asp-action="Reject" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="fromEdit" value="true" />
                                <textarea name="reason" class="form-control mb-2" rows="2" placeholder="Rejection reason" required></textarea>
                                <button type="submit" class="btn btn-outline-danger w-100">Reject</button>
                            </form>
                        </permission>
                    }
                    @if (isDraft)
                    {
                        <permission require="@WebPermission.Blog.Approve">
                            <form asp-area="Admin" asp-controller="Blogs" asp-action="Publish" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success w-100">Publish</button>
                            </form>
                        </permission>
                    }
                    @if (isPublished)
                    {
                        <permission require="@WebPermission.Blog.Approve">
                            <form asp-area="Admin" asp-controller="Blogs" asp-action="Unpublish" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-secondary w-100">Unpublish</button>
                            </form>
                            <form asp-area="Admin" asp-controller="Blogs" asp-action="Archive" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-secondary w-100">Archive</button>
                            </form>
                        </permission>
                        @if (!Model.IsFeatured)
                        {
                            <permission require="@WebPermission.Blog.Feature">
                                <form asp-area="Admin" asp-controller="Blogs" asp-action="Feature" asp-route-id="@Model.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-warning w-100">Feature</button>
                                </form>
                            </permission>
                        }
                        else
                        {
                            <permission require="@WebPermission.Blog.Unfeature">
                                <form asp-area="Admin" asp-controller="Blogs" asp-action="Unfeature" asp-route-id="@Model.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-warning w-100">Unfeature</button>
                                </form>
                            </permission>
                        }

                        <permission require="@WebPermission.Blog.Approve">
                            <form asp-area="Admin" asp-controller="Blogs" asp-action="Hide" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <textarea name="reason" class="form-control mb-2" rows="2" placeholder="Reason for hiding" required></textarea>
                                <button type="submit" class="btn btn-outline-secondary w-100">Hide</button>
                            </form>
                        </permission>
                    }

                    @if (isHidden)
                    {
                        <permission require="@WebPermission.Blog.Approve">
                            <form asp-area="Admin" asp-controller="Blogs" asp-action="Unhide" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success w-100">Unhide (publish)</button>
                            </form>
                        </permission>
                    }

                    <permission require="@WebPermission.Blog.DeleteOwn">
                        <form asp-area="Admin" asp-controller="Blogs" asp-action="Delete" asp-route-id="@Model.Id" method="post"
                              onsubmit="return confirm('Delete this blog?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger w-100">Delete</button>
                        </form>
                    </permission>

                    @if (!isRemoved)
                    {
                        <permission require="@WebPermission.Blog.Remove">
                            <hr />
                            <div class="text-danger small fw-bold">Danger zone</div>
                            <form asp-area="Admin" asp-controller="Blogs" asp-action="Remove" asp-route-id="@Model.Id" method="post"
                                  onsubmit="return confirm('Permanently remove this blog? This cannot be undone.');">
                                @Html.AntiForgeryToken()
                                <textarea name="reason" class="form-control mb-2" rows="2" placeholder="Reason for removal" required></textarea>
                                <button type="submit" class="btn btn-danger w-100">Remove (moderation)</button>
                            </form>
                        </permission>
                    }
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header"><strong>Info</strong></div>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between"><span>Views</span><strong>@Model.ViewCount</strong></li>
                    <li class="list-group-item d-flex justify-content-between"><span>Language</span><strong>@Model.LanguageCode</strong></li>
                    <li class="list-group-item d-flex justify-content-between"><span>Published</span><strong>@(Model.PublishedAt?.ToString("yyyy-MM-dd") ?? "—")</strong></li>
                </ul>
            </div>

            <permission require="@WebPermission.Attachment.Read">
                <div class="card mt-3">
                    <div class="card-header"><strong>Images / attachments</strong></div>
                    <div class="card-body">
                        <p class="small text-muted mb-2">Blog images are managed through the shared attachments page.</p>
                        <a asp-area="Admin" asp-controller="Attachments" asp-action="Index"
                           asp-route-entityType="Blog" asp-route-entityId="@Model.Id"
                           class="btn btn-outline-secondary w-100">Manage images / attachments</a>
                    </div>
                </div>
            </permission>

            <permission require="@WebPermission.Blog.Update">
                <div class="card mt-3">
                    <div class="card-header"><strong>Translations</strong></div>
                    <div class="card-body">
                        <p class="small text-muted mb-2">An Arabic translation is required before publishing.</p>
                        <a asp-area="Admin" asp-controller="BlogTranslations" asp-action="Index"
                           asp-route-id="@Model.Id"
                           class="btn btn-outline-secondary w-100">Manage translations</a>
                    </div>
                </div>
            </permission>

            <div class="card mt-3">
                <div class="card-header"><strong>Linked tours</strong></div>
                <div class="card-body">
                    @if (Model.LinkedTours.Count == 0)
                    {
                        <p class="small text-muted mb-2">No tours linked.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush small mb-2">
                            @foreach (var tour in Model.LinkedTours)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <span>@tour.DisplayName</span>
                                    <permission require="@WebPermission.BlogTourLink.Delete">
                                        <form asp-area="Admin" asp-controller="Blogs" asp-action="UnlinkTour"
                                              asp-route-id="@Model.Id" asp-route-tourId="@tour.TourId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Unlink</button>
                                        </form>
                                    </permission>
                                </li>
                            }
                        </ul>
                    }

                    <permission require="@WebPermission.BlogTourLink.Create">
                        @if (Model.AvailableTours.Count > 0)
                        {
                            <form asp-area="Admin" asp-controller="Blogs" asp-action="LinkTour"
                                  asp-route-id="@Model.Id" method="post" class="d-flex gap-1">
                                @Html.AntiForgeryToken()
                                <select name="tourId" class="form-select form-select-sm">
                                    @foreach (var opt in Model.AvailableTours)
                                    {
                                        <option value="@opt.TourId">@opt.Name</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary">Link</button>
                            </form>
                        }
                        else
                        {
                            <p class="small text-muted mb-0">No more published tours available to link.</p>
                        }
                    </permission>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
