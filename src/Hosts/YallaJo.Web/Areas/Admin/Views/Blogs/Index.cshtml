@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Infrastructure.Authorization
@using YallaJo.Web.Areas.Admin.Models.Blogs
@using YallaJo.Web.Areas.Admin.Models.Shared
@model BlogListVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Blogs.Title"].Value;
    ViewData["AdminNav"] = "Blogs";

    var culture = CultureInfo.CurrentCulture;
    string Count(int n) => n.ToString("N0", culture);
    string Date(DateTime? dt) => dt.HasValue ? dt.Value.ToString("yyyy-MM-dd", culture) : string.Empty;

    string TabUrl(BlogAdminTab tab) => Url.Action("Index", "Blogs", new { area = "Admin", tab })!;
    string PageUrl(int p) => Url.Action("Index", "Blogs",
        new { area = "Admin", tab = Model.Tab, page = p, search = Model.Search, isFeatured = Model.IsFeatured })!;

    (string Color, string Icon) StatusBadge(string status) => status?.Trim().ToLowerInvariant() switch
    {
        "published" => ("success", "circle-check"),
        "draft" => ("secondary", "pen-ruler"),
        "pendingreview" => ("warning", "clock"),
        "hidden" => ("info", "eye-slash"),
        "removed" => ("danger", "circle-xmark"),
        "deleted" => ("danger", "trash"),
        "archived" => ("secondary", "box-archive"),
        _ => ("secondary", "circle-question")
    };
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Blogs.Title"]</h1>
        <p class="mb-0 text-secondary">@Localizer["Admin.Blogs.Subtitle"]</p>
    </div>
    <permission require="@WebPermission.Blog.Create">
        <a asp-area="Admin" asp-controller="Blogs" asp-action="Create" class="btn btn-primary"
           data-yj-modal-target="#createBlogModal" data-action="@Url.Action("Create")">
            <i class="fa-solid fa-plus fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Blogs.New"]
        </a>
    </permission>
</div>

@if (ViewBag.Error is string vbe)
{
    <div class="alert alert-danger" role="alert">@vbe</div>
}

<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <a class="nav-link @(Model.Tab == BlogAdminTab.Published ? "active" : "")" href="@TabUrl(BlogAdminTab.Published)">@Localizer["Admin.Blogs.TabPublished"]</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.Tab == BlogAdminTab.Queue ? "active" : "")" href="@TabUrl(BlogAdminTab.Queue)">@Localizer["Admin.Blogs.TabQueue"]</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.Tab == BlogAdminTab.Deleted ? "active" : "")" href="@TabUrl(BlogAdminTab.Deleted)">@Localizer["Admin.Blogs.TabDeleted"]</a>
    </li>
</ul>

<section class="card shadow" aria-labelledby="blogs-heading">
    <div class="card-header border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 id="blogs-heading" class="card-header-title h5 mb-0">@Localizer["Admin.Blogs.Directory"]</h2>
        @if (Model.Tab != BlogAdminTab.Queue)
        {
            <form asp-area="Admin" asp-controller="Blogs" asp-action="Index" method="get" class="d-flex flex-wrap align-items-end gap-2 mb-0">
                <input type="hidden" name="tab" value="@Model.Tab" />
                <div>
                    <label for="blog-search" class="form-label small mb-1">@Localizer["Admin.Blogs.SearchLabel"]</label>
                    <input type="search" id="blog-search" name="search" value="@Model.Search" dir="ltr"
                           class="form-control form-control-sm" placeholder="@Localizer["Admin.Blogs.SearchPlaceholder"]"
                           aria-describedby="blog-search-help" />
                    <small id="blog-search-help" class="form-text">@Localizer["Admin.Blogs.SearchHelp"]</small>
                </div>
                <button type="submit" class="btn btn-sm btn-outline-secondary">
                    <i class="fa-solid fa-magnifying-glass fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Blogs.Search"]
                </button>
            </form>
        }
    </div>

    <div class="card-body">
        @if (!Model.HasItems)
        {
            <div class="text-center py-5">
                <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
                <p class="mb-3 text-secondary">@Localizer["Admin.Blogs.EmptyMessage"]</p>
                <permission require="@WebPermission.Blog.Create">
                    <a asp-area="Admin" asp-controller="Blogs" asp-action="Create" class="btn btn-sm btn-primary-soft"
                       data-yj-modal-target="#createBlogModal" data-action="@Url.Action("Create")">
                        <i class="fa-solid fa-plus fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Blogs.New"]
                    </a>
                </permission>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">@Localizer["Admin.Blogs.ColTitle"]</th>
                            <th scope="col">@Localizer["Admin.Blogs.ColSlug"]</th>
                            <th scope="col">@Localizer["Admin.Blogs.ColStatus"]</th>
                            <th scope="col" class="text-end">@Localizer["Admin.Blogs.ColViews"]</th>
                            <th scope="col">@(Model.IsDeletedTab ? Localizer["Admin.Blogs.ColDeleted"] : Localizer["Admin.Blogs.ColPublished"])</th>
                            <th scope="col" class="text-end">@Localizer["Admin.Blogs.ColActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var blog in Model.Items)
                        {
                            var badge = StatusBadge(blog.StatusLabel);
                            <tr>
                                <td>
                                    <span class="fw-semibold">@blog.Title</span>
                                    @if (blog.IsFeatured)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning ms-1">
                                            <i class="fa-solid fa-star fa-fw" aria-hidden="true"></i> @Localizer["Admin.Blogs.Featured"]
                                        </span>
                                    }
                                </td>
                                <td><bdi dir="ltr" class="font-data">@blog.Slug</bdi></td>
                                <td>
                                    <span class="badge bg-@badge.Color bg-opacity-10 text-@badge.Color">
                                        <i class="fa-solid fa-@badge.Icon fa-fw" aria-hidden="true"></i> @blog.StatusLabel
                                    </span>
                                </td>
                                <td class="text-end"><bdi dir="ltr" class="font-data">@Count(blog.ViewCount)</bdi></td>
                                <td>
                                    @{
                                        var when = Model.IsDeletedTab ? Date(blog.DeletedAt) : Date(blog.PublishedAt);
                                    }
                                    @if (string.IsNullOrEmpty(when))
                                    {
                                        <span class="text-secondary" aria-label="@Localizer["Admin.Blogs.NoDate"]">&mdash;</span>
                                    }
                                    else
                                    {
                                        <bdi dir="ltr" class="font-data">@when</bdi>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (Model.IsDeletedTab)
                                    {
                                        <permission require="@WebPermission.Blog.DeleteOwn">
                                            <form data-loading asp-area="Admin" asp-controller="Blogs" asp-action="Restore"
                                                  asp-route-id="@blog.Id" method="post" class="d-inline"
                                                  data-confirm="@Localizer["Admin.Blogs.RestoreConfirm", blog.Title]"
                                                  data-confirm-title="@Localizer["Admin.Blogs.RestoreTitle"]"
                                                  data-confirm-action="@Localizer["Admin.Blogs.Restore"]" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="rowVersion" value="@blog.RowVersion" />
                                                <button type="submit" class="btn btn-sm btn-outline-success">
                                                    <i class="fa-solid fa-rotate-left fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Blogs.Restore"]
                                                </button>
                                            </form>
                                        </permission>
                                    }
                                    else if (Model.Tab == BlogAdminTab.Queue)
                                    {
                                        <div class="d-flex justify-content-end align-items-start gap-2">
                                            <permission require="@WebPermission.Blog.Approve">
                                                <form data-loading asp-area="Admin" asp-controller="Blogs" asp-action="Approve"
                                                      asp-route-id="@blog.Id" method="post" class="d-inline"
                                                      data-confirm="@Localizer["Admin.Blogs.ApproveConfirm", blog.Title]"
                                                      data-confirm-title="@Localizer["Admin.Blogs.ApproveTitle"]"
                                                      data-confirm-action="@Localizer["Admin.Blogs.Approve"]" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                                        <i class="fa-solid fa-check fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Blogs.Approve"]
                                                    </button>
                                                </form>
                                            </permission>
                                            <permission require="@WebPermission.Blog.Reject">
                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                        data-bs-toggle="modal" data-bs-target="#rejectModal-@blog.Id.ToString("N")">
                                                    <i class="fa-solid fa-xmark fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Blogs.Reject"]
                                                </button>
                                            </permission>
                                        </div>
                                    }
                                    else
                                    {
                                        <permission require="@WebPermission.Blog.Update">
                                            <a asp-area="Admin" asp-controller="Blogs" asp-action="Edit"
                                               asp-route-id="@blog.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="fa-solid fa-pen fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Blogs.Manage"]
                                            </a>
                                        </permission>
                                        <permission require="@WebPermission.Blog.DeleteOwn">
                                            <form data-loading asp-area="Admin" asp-controller="Blogs" asp-action="Delete"
                                                  asp-route-id="@blog.Id" method="post" class="d-inline"
                                                  data-confirm="@Localizer["Admin.Blogs.DeleteConfirm", blog.Title]"
                                                  data-confirm-title="@Localizer["Admin.Blogs.DeleteTitle"]"
                                                  data-confirm-action="@Localizer["Admin.Blogs.Delete"]" data-confirm-cancel="@Localizer["Admin.Confirm.Cancel"]">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="fa-solid fa-trash fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Blogs.Delete"]
                                                </button>
                                            </form>
                                        </permission>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (Model.HasPreviousPage || Model.HasNextPage)
    {
        <partial name="Partials/_PaginationFooter"
                 model="@(new PaginationFooterVm
                 {
                     HasPrevious = Model.HasPreviousPage,
                     HasNext = Model.HasNextPage,
                     Page = Model.PageNumber,
                     PreviousUrl = PageUrl(Model.PageNumber - 1),
                     NextUrl = PageUrl(Model.PageNumber + 1),
                     PreviousText = Localizer["Admin.Blogs.Previous"].Value,
                     NextText = Localizer["Admin.Blogs.Next"].Value,
                     PageLabel = Localizer["Admin.Blogs.PageLabel"].Value
                 })" />
    }
</section>

@if (Model.HasItems && Model.Tab == BlogAdminTab.Queue)
{
    foreach (var blog in Model.Items)
    {
        <permission require="@WebPermission.Blog.Reject">
            <div class="modal fade" id="rejectModal-@blog.Id.ToString("N")" tabindex="-1"
                 aria-labelledby="rejectTitle-@blog.Id.ToString("N")" aria-describedby="rejectBody-@blog.Id.ToString("N")"
                 aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                <div class="modal-dialog modal-dialog-centered">
                    <form data-loading asp-area="Admin" asp-controller="Blogs" asp-action="Reject" asp-route-id="@blog.Id"
                          method="post" class="modal-content" role="dialog" aria-modal="true"
                          aria-labelledby="rejectTitle-@blog.Id.ToString("N")">
                        @Html.AntiForgeryToken()
                        <partial name="Partials/_ModalHeader"
                                 model="@(new ModalHeaderVm { TitleId = $"rejectTitle-{blog.Id.ToString("N")}", Title = Localizer["Admin.Blogs.RejectTitle"].Value, CloseLabel = Localizer["Admin.Blogs.Close"].Value })" />
                        <div class="modal-body" id="rejectBody-@blog.Id.ToString("N")">
                            <p class="mb-3">@Localizer["Admin.Blogs.RejectIntro", blog.Title]</p>
                            <label for="rejectReason-@blog.Id.ToString("N")" class="form-label">@Localizer["Admin.Blogs.ReasonLabel"]</label>
                            <textarea id="rejectReason-@blog.Id.ToString("N")" name="reason" rows="3" maxlength="1000" required
                                      class="form-control" aria-describedby="rejectReasonHelp-@blog.Id.ToString("N")"></textarea>
                            <small id="rejectReasonHelp-@blog.Id.ToString("N")" class="form-text">@Localizer["Admin.Blogs.ReasonHelp"]</small>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.Blogs.Cancel"]</button>
                            <button type="submit" class="btn btn-danger">@Localizer["Admin.Blogs.Reject"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </permission>
    }
}

<permission require="@WebPermission.Blog.Create">
    @{ var createOpen = Model.CreateOpen; }
    @* New-draft modal (F8 §4.7): JS opens it via admin-modal-crud.js; deep links /
       no-JS render it server-side open (PE1) with anchor-based close controls.
       Carries Title, language and content because the API requires real content at
       create time; all other fields are edited on the Edit page after creation. *@
    <div class="modal fade@(createOpen ? " show d-block" : "")" id="createBlogModal" tabindex="-1"
         role="dialog" aria-modal="true" aria-labelledby="createBlogModalLabel"
         data-yj-component="modal-crud">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <form data-loading asp-area="Admin" asp-controller="Blogs" asp-action="Create" method="post" class="modal-content">
                @Html.AntiForgeryToken()
                <partial name="Partials/_ModalHeader"
                         model="@(new ModalHeaderVm { TitleId = "createBlogModalLabel", Title = Localizer["Admin.Blogs.CreateHeading"].Value, CloseLabel = Localizer["Admin.Blogs.Cancel"].Value, CloseUrl = createOpen ? Url.Action("Index") : null })" />
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="Create.Title" class="form-label">@Localizer["Admin.Blogs.TitleLabel"]</label>
                        <input asp-for="Create.Title" class="form-control" aria-describedby="create-blog-title-help" />
                        <small id="create-blog-title-help" class="form-text">@Localizer["Admin.Blogs.TitleHelp"]</small>
                        <span asp-validation-for="Create.Title" class="text-danger" role="alert"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Create.SourceLanguageCode" class="form-label">@Localizer["Admin.Blogs.LanguageLabel"]</label>
                        <input asp-for="Create.SourceLanguageCode" class="form-control" dir="ltr" aria-describedby="create-blog-lang-help" />
                        <small id="create-blog-lang-help" class="form-text">@Localizer["Admin.Blogs.LanguageHelp"]</small>
                        <span asp-validation-for="Create.SourceLanguageCode" class="text-danger" role="alert"></span>
                    </div>
                    <div class="mb-0">
                        <label asp-for="Create.Content" class="form-label">@Localizer["Admin.Blogs.ContentLabel"]</label>
                        <textarea asp-for="Create.Content" class="form-control" rows="8"></textarea>
                        <span asp-validation-for="Create.Content" class="text-danger" role="alert"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    @if (createOpen)
                    {
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">@Localizer["Admin.Blogs.Cancel"]</a>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Admin.Blogs.Cancel"]</button>
                    }
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-plus fa-fw" aria-hidden="true"></i> @Localizer["Admin.Blogs.CreateSubmit"]
                    </button>
                </div>
            </form>
        </div>
    </div>
    @if (createOpen)
    {
        <div class="modal-backdrop fade show"></div>
    }
</permission>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/admin-modal-crud.js" asp-append-version="true"></script>
}
