@*
    Phase 5A — collapsible audit metadata renderer.

    Behavior:
    • Null / empty / whitespace input renders "—" with no toggle.
    • Valid JSON renders pretty-printed (indented) inside a Bootstrap
      collapse, with a small "Details" toggle button.
    • Invalid JSON renders the raw string the same way — Razor's HTML
      encoding handles XSS.

    The host page must pass a unique non-empty `id-suffix` (typically
    the audit row id) so multiple rows on the same page have distinct
    Bootstrap collapse target ids.
*@
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Admin.Helpers
@model string?
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer

@{
    var idSuffix = ViewData["id-suffix"] as string ?? Guid.NewGuid().ToString("N");
    var formatted = AuditMetadataFormatter.Format(Model);
    var collapseId = $"meta-{idSuffix}";
    var toggleLabel = formatted.IsValidJson
        ? Localizer["Admin.Audit.MetadataDetails"]
        : Localizer["Admin.Audit.MetadataRaw"];
}

@if (formatted.IsEmpty)
{
    <span class="text-secondary" aria-label="@Localizer["Admin.Audit.NotAvailable"]">—</span>
}
else
{
    <button class="btn btn-sm btn-link p-0"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#@collapseId"
            aria-expanded="false"
            aria-controls="@collapseId">
        @toggleLabel
    </button>
    <div class="collapse mt-1" id="@collapseId">
        @* dir="ltr" + <bdi>: JSON/code stays LTR inside RTL pages (RTL3).
           text-break replaces the X6-forbidden inline static style. *@
        <pre class="border rounded p-2 mb-0 small bg-light text-break" dir="ltr"><bdi>@formatted.Text</bdi></pre>
    </div>
}
