@using System.Globalization
@using YallaJo.Web.Areas.Admin.Models.Commissions
@using YallaJo.Web.Infrastructure.Authorization
@model CommissionsVm
@{
    ViewData["Title"] = "Commission rules";
    ViewData["AdminNav"] = "Commissions";

    string Money(decimal value) => value.ToString("N2", CultureInfo.InvariantCulture);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Commission rules</h1>
        <p class="text-body-secondary mb-0">Revenue-tier commission percentages applied to provider payouts.</p>
    </div>
    <permission require="@WebPermission.CommissionRule.Create">
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">
            <i class="bi bi-plus-lg me-1"></i>New rule
        </button>
    </permission>
</div>

<form method="get" asp-area="Admin" asp-controller="Commissions" asp-action="Index" class="card card-body shadow-sm mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label" for="tier">Tier</label>
            <input type="text" class="form-control font-data" id="tier" name="tier" value="@Model.TierFilter" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="currency">Currency</label>
            <input type="text" class="form-control font-data" id="currency" name="currency" value="@Model.CurrencyFilter" />
        </div>
        <div class="col-md-3">
            <div class="form-check mt-4">
                <input class="form-check-input" type="checkbox" id="includeInactive" name="includeInactive" value="true" @(Model.IncludeInactive ? "checked" : null) />
                <label class="form-check-label" for="includeInactive">Include inactive</label>
            </div>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary">Apply</button>
            <a asp-area="Admin" asp-controller="Commissions" asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </div>
</form>

@if (Model.Rules.Count == 0)
{
    <div class="text-center py-5">
        <img src="~/assets/images/element/17.svg" alt="" class="mb-3" style="height: 80px;" />
        <p class="text-body-secondary mb-0">No commission rules to display.</p>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Tier</th>
                        <th scope="col">Revenue band</th>
                        <th scope="col">Currency</th>
                        <th scope="col">Percentage</th>
                        <th scope="col">Status</th>
                        <th scope="col">Created</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rule in Model.Rules)
                    {
                        <tr>
                            <td>@rule.Tier</td>
                            <td class="font-data">
                                @Money(rule.MinMonthlyRevenue)
                                @if (rule.MaxMonthlyRevenue.HasValue)
                                {
                                    <span> &ndash; @Money(rule.MaxMonthlyRevenue.Value)</span>
                                }
                                else
                                {
                                    <span> and up</span>
                                }
                            </td>
                            <td>@rule.Currency</td>
                            <td class="font-data">@Money(rule.Percentage)%</td>
                            <td>
                                @if (rule.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary">Inactive</span>
                                }
                            </td>
                            <td class="font-data">@rule.CreatedAt.ToString("g", CultureInfo.InvariantCulture)</td>
                            <td class="text-end">
                                <permission require="@WebPermission.CommissionRule.Update">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editModal-@rule.Id">Edit</button>
                                </permission>
                                <permission require="@WebPermission.CommissionRule.Delete">
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@rule.Id">Delete</button>
                                </permission>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @foreach (var rule in Model.Rules)
    {
        <permission require="@WebPermission.CommissionRule.Update">
            <div class="modal fade" id="editModal-@rule.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <form method="post" asp-area="Admin" asp-controller="Commissions" asp-action="Update" asp-route-id="@rule.Id" class="modal-content">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title">Edit rule &mdash; @rule.Tier (@rule.Currency)</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label" for="edit-min-@rule.Id">Min monthly revenue</label>
                                <input type="number" step="0.01" class="form-control font-data" id="edit-min-@rule.Id" name="MinMonthlyRevenue" value="@rule.MinMonthlyRevenue.ToString(CultureInfo.InvariantCulture)" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="edit-max-@rule.Id">Max monthly revenue (optional)</label>
                                <input type="number" step="0.01" class="form-control font-data" id="edit-max-@rule.Id" name="MaxMonthlyRevenue" value="@(rule.MaxMonthlyRevenue?.ToString(CultureInfo.InvariantCulture))" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="edit-pct-@rule.Id">Percentage</label>
                                <input type="number" step="0.01" class="form-control font-data" id="edit-pct-@rule.Id" name="Percentage" value="@rule.Percentage.ToString(CultureInfo.InvariantCulture)" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="edit-notes-@rule.Id">Notes</label>
                                <textarea class="form-control" id="edit-notes-@rule.Id" name="Notes" rows="2">@rule.Notes</textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </permission>
        <permission require="@WebPermission.CommissionRule.Delete">
            <div class="modal fade" id="deleteModal-@rule.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <form method="post" asp-area="Admin" asp-controller="Commissions" asp-action="Delete" asp-route-id="@rule.Id" class="modal-content">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title">Delete rule</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p>Deactivate the @rule.Tier (@rule.Currency) commission rule?</p>
                            <div class="mb-3">
                                <label class="form-label" for="delete-reason-@rule.Id">Reason (optional)</label>
                                <input type="text" class="form-control" id="delete-reason-@rule.Id" name="reason" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger">Delete rule</button>
                        </div>
                    </form>
                </div>
            </div>
        </permission>
    }
}

<permission require="@WebPermission.CommissionRule.Create">
    <div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-area="Admin" asp-controller="Commissions" asp-action="Create" class="modal-content">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">New commission rule</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" for="create-tier">Tier</label>
                        <input type="text" class="form-control" id="create-tier" name="Tier" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="create-min">Min monthly revenue</label>
                        <input type="number" step="0.01" class="form-control font-data" id="create-min" name="MinMonthlyRevenue" value="0" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="create-max">Max monthly revenue (optional)</label>
                        <input type="number" step="0.01" class="form-control font-data" id="create-max" name="MaxMonthlyRevenue" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="create-currency">Currency</label>
                        <input type="text" class="form-control" id="create-currency" name="Currency" value="JOD" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="create-pct">Percentage</label>
                        <input type="number" step="0.01" class="form-control font-data" id="create-pct" name="Percentage" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="create-notes">Notes</label>
                        <textarea class="form-control" id="create-notes" name="Notes" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create rule</button>
                </div>
            </form>
        </div>
    </div>
</permission>
