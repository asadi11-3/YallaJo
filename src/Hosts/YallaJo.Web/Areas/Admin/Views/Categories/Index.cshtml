@using YallaJo.Web.Infrastructure.Authorization
@model YallaJo.Web.Areas.Admin.Models.Categories.CategoryListVm
@{
    ViewData["Title"] = "Categories";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Categories</h2>

    @if (TempData["Success"] is string ok)  { <div class="alert alert-success">@ok</div> }
    @if (TempData["Error"]   is string err) { <div class="alert alert-danger">@err</div> }
    @if (ViewBag.Error       is string vbe) { <div class="alert alert-danger">@vbe</div> }

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <permission require="@WebPermission.Category.Create">
        <div class="card mb-4 p-3">
            <h5>Create Category</h5>
            <form asp-area="Admin" asp-controller="Categories" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-2">
                    <div class="col-md-3">
                        <label asp-for="Create.Name" class="form-label"></label>
                        <input asp-for="Create.Name" class="form-control" />
                        <span asp-validation-for="Create.Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Create.Slug" class="form-label"></label>
                        <input asp-for="Create.Slug" class="form-control" />
                        <span asp-validation-for="Create.Slug" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Create.ParentCategoryId" class="form-label"></label>
                        <select asp-for="Create.ParentCategoryId" class="form-select">
                            <option value="">— none (root) —</option>
                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c.Id">@(new string('—', c.Depth)) @c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-1">
                        <label asp-for="Create.Icon" class="form-label"></label>
                        <input asp-for="Create.Icon" class="form-control" />
                    </div>
                    <div class="col-md-1">
                        <label asp-for="Create.SortOrder" class="form-label"></label>
                        <input asp-for="Create.SortOrder" class="form-control" />
                    </div>
                    <div class="col-md-1">
                        <label asp-for="Create.SourceLanguageCode" class="form-label">Lang</label>
                        <input asp-for="Create.SourceLanguageCode" class="form-control" />
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary">Create</button>
                    </div>
                </div>
            </form>
        </div>
    </permission>

    <table class="table table-sm table-bordered align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Slug</th>
                <th>Icon</th>
                <th>Sort</th>
                <th>Active</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Categories)
            {
                <tr>
                    <td>@(new string('·', c.Depth * 2)) @c.Name</td>
                    <td>@c.Slug</td>
                    <td>@(c.Icon ?? "—")</td>
                    <td>@c.SortOrder</td>
                    <td>@(c.IsActive ? "✓" : "—")</td>
                    <td>
                        <permission require="@WebPermission.Category.Update">
                            <a asp-area="Admin" asp-controller="Categories" asp-action="Edit" asp-route-id="@c.Id"
                               class="btn btn-sm btn-outline-secondary">Edit</a>
                            @if (c.IsActive)
                            {
                                <form asp-area="Admin" asp-controller="Categories" asp-action="Deactivate" asp-route-id="@c.Id"
                                      method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-warning">Deactivate</button>
                                </form>
                            }
                            else
                            {
                                <form asp-area="Admin" asp-controller="Categories" asp-action="Activate" asp-route-id="@c.Id"
                                      method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                                </form>
                            }
                        </permission>
                        <permission require="@WebPermission.Category.Delete">
                            <form asp-area="Admin" asp-controller="Categories" asp-action="Delete" asp-route-id="@c.Id"
                                  method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Delete this category?');">Delete</button>
                            </form>
                        </permission>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
