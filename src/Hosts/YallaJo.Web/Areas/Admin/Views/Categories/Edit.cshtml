@using Microsoft.Extensions.Localization
@model YallaJo.Web.Areas.Admin.Models.Categories.UpdateCategoryVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Categories.EditTitle"].Value;
    ViewData["AdminNav"] = "Categories";
}

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Categories.EditHeading"]</h1>
        <p class="text-secondary mb-0 fw-semibold">@Model.Name</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left fa-fw" aria-hidden="true"></i> @Localizer["Admin.Categories.Back"]
    </a>
</div>

<section class="card shadow" aria-labelledby="edit-category-heading">
    <div class="card-header border-bottom">
        <h2 id="edit-category-heading" class="card-header-title h5 mb-0">@Localizer["Admin.Categories.EditHeading"]</h2>
    </div>
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Categories" asp-action="Edit"
              asp-route-id="@Model.Id" method="post" class="col-lg-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">@Localizer["Admin.Categories.NameLabel"]</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger" role="alert"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slug" class="form-label">@Localizer["Admin.Categories.SlugLabel"]</label>
                <input asp-for="Slug" class="form-control" dir="ltr" aria-describedby="edit-slug-help" />
                <small id="edit-slug-help" class="form-text">@Localizer["Admin.Categories.SlugHelp"]</small>
                <span asp-validation-for="Slug" class="text-danger" role="alert"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ParentCategoryId" class="form-label">@Localizer["Admin.Categories.ParentLabel"]</label>
                <select asp-for="ParentCategoryId" class="form-select" aria-describedby="edit-parent-help">
                    <option value="">@Localizer["Admin.Categories.ParentNone"]</option>
                    @foreach (var opt in Model.ParentOptions)
                    {
                        var label = new string('\u2014', opt.Depth) + " " + opt.Name;
                        <option value="@opt.Id">@label</option>
                    }
                </select>
                <small id="edit-parent-help" class="form-text">@Localizer["Admin.Categories.ParentHelp"]</small>
                <span asp-validation-for="ParentCategoryId" class="text-danger" role="alert"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Icon" class="form-label">@Localizer["Admin.Categories.IconLabel"]</label>
                <input asp-for="Icon" class="form-control" dir="ltr" />
                <span asp-validation-for="Icon" class="text-danger" role="alert"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SortOrder" class="form-label">@Localizer["Admin.Categories.SortLabel"]</label>
                <input asp-for="SortOrder" class="form-control" dir="ltr" />
                <span asp-validation-for="SortOrder" class="text-danger" role="alert"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SourceLanguageCode" class="form-label">@Localizer["Admin.Categories.LanguageLabel"]</label>
                <input asp-for="SourceLanguageCode" class="form-control" dir="ltr" />
                <span asp-validation-for="SourceLanguageCode" class="text-danger" role="alert"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-floppy-disk fa-fw" aria-hidden="true"></i> @Localizer["Admin.Categories.Save"]
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Admin.Categories.Cancel"]</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
