@using Microsoft.Extensions.Localization
@using YallaJo.Web.Infrastructure.Authorization
@model YallaJo.Web.Areas.Admin.Models.Invitations.ResendInviteVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Admin.Resend.Title"].Value;
    ViewData["AdminNav"] = "Invitations";
}

@* Success/Error flash banners are rendered globally by the shared _Alerts partial in the layout. *@

<div class="d-sm-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">@Localizer["Admin.Resend.Heading"]</h1>
        <p class="mb-0 text-secondary">@Localizer["Admin.Resend.Subtitle"]</p>
    </div>
    <a asp-area="Admin" asp-controller="Invitations" asp-action="Index" class="btn btn-outline-secondary btn-sm mt-3 mt-sm-0">
        <i class="fa-solid fa-arrow-left fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Resend.Back"]
    </a>
</div>

<permission require="@WebPermission.User.Create">
    <div class="row g-4">
        <div class="col-xxl-6">
            <div class="card shadow">
                <div class="card-header border-bottom">
                    <h2 class="card-header-title h5 mb-0">@Localizer["Admin.Resend.FormHeading"]</h2>
                </div>
                <div class="card-body">
                    <form asp-area="Admin" asp-controller="Invitations" asp-action="ResendSubmit" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label for="resend-email" class="form-label">@Localizer["Admin.Resend.EmailLabel"]</label>
                            <input asp-for="Email" id="resend-email" class="form-control" type="email"
                                   autocomplete="email" dir="ltr" aria-describedby="resend-email-help"
                                   placeholder="@Localizer["Admin.Resend.EmailPlaceholder"]" />
                            <small id="resend-email-help" class="form-text text-secondary">@Localizer["Admin.Resend.EmailHelp"]</small>
                            <span asp-validation-for="Email" class="text-danger d-block" role="alert"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-paper-plane fa-fw me-1" aria-hidden="true"></i>@Localizer["Admin.Resend.Submit"]
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</permission>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
