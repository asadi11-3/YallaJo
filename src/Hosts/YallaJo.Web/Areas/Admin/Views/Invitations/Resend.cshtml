@using YallaJo.Web.Infrastructure.Authorization
@model YallaJo.Web.Areas.Admin.Models.Invitations.ResendInviteVm
@{
    ViewData["Title"] = "Resend Invite";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <h2>Resend Invite</h2>
    <p class="text-muted">
        Issues a fresh invite token for a pending account and emails a new link. Disabled for accounts that have already completed onboarding.
    </p>

    @* Success/Error flash banners are rendered globally by the shared _Alerts partial (in _Layout). *@

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <permission require="@WebPermission.User.Create">
        <form asp-area="Admin" asp-controller="Invitations" asp-action="ResendSubmit" method="post" class="col-md-6">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Resend invite</button>
            <a asp-area="Admin" asp-controller="Invitations" asp-action="Index" class="btn btn-link">Back to invite user</a>
        </form>
    </permission>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
