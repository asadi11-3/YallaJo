@using YallaJo.Web.Infrastructure.Authorization
@inject YallaJo.Web.Infrastructure.Identity.ICurrentUser CurrentUser
@model YallaJo.Web.Areas.Guide.Shared.GuideSidebarVm
@{
    var active = ViewData["GuideNav"] as string ?? "Dashboard";
    string Nav(string key) => active == key ? "nav-link active" : "nav-link";
    bool Has(string permission) => CurrentUser.HasPermission(permission);
}

<section class="pt-4">
    <div class="container">
        <div class="card rounded-3 border p-3 pb-2">
            <div class="d-sm-flex align-items-center">
                <div class="avatar avatar-xl flex-shrink-0">
                    <img class="avatar-img rounded-circle border border-white border-3"
                         src="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? Url.Content("~/assets/images/avatar/01.jpg") : Model.AvatarUrl)"
                         alt="avatar">
                </div>
                <div class="ms-sm-3 mt-2 mt-sm-0">
                    <h5 class="mb-0"><span class="fw-light">Hi,</span> @(string.IsNullOrWhiteSpace(Model.DisplayName) ? "Guide" : Model.DisplayName)</h5>
                    @if (!string.IsNullOrWhiteSpace(Model.Email))
                    {
                        <span class="small text-body-secondary">@Model.Email</span>
                    }
                </div>
                <span class="badge bg-primary-soft ms-sm-auto mt-2 mt-sm-0">Guide</span>
            </div>

            <button class="btn btn-primary w-100 d-block d-xl-none mt-3"
                    type="button" data-bs-toggle="offcanvas" data-bs-target="#guideDashboardMenu"
                    aria-controls="guideDashboardMenu">
                <i class="bi bi-list me-1"></i> Dashboard Menu
            </button>

            <div class="offcanvas-xl offcanvas-end mt-xl-3" tabindex="-1" id="guideDashboardMenu">
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title">Menu</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#guideDashboardMenu" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body p-3 p-xl-0">
                    <div class="navbar navbar-expand-xl w-100">
                        <ul class="navbar-nav nav nav-pills nav-pills-primary-soft flex-xl-row flex-column w-100">
                            <li class="nav-item">
                                <a class="@Nav("Dashboard")" asp-area="Guide" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-house-door fa-fw me-1"></i>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@Nav("Profile")" asp-area="Guide" asp-controller="Profile" asp-action="Index">
                                    <i class="bi bi-person-badge fa-fw me-1"></i>My Profile
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@Nav("MyTours")" asp-area="Guide" asp-controller="MyTours" asp-action="Index">
                                    <i class="bi bi-map fa-fw me-1"></i>My Tours &amp; Offerings
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@Nav("Availability")" asp-area="Guide" asp-controller="Availability" asp-action="Index">
                                    <i class="bi bi-calendar-x fa-fw me-1"></i>Availability
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@Nav("Earnings")" asp-area="Guide" asp-controller="Earnings" asp-action="Index">
                                    <i class="bi bi-graph-up-arrow fa-fw me-1"></i>Earnings
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@Nav("Analytics")" asp-area="Guide" asp-controller="Analytics" asp-action="Index">
                                    <i class="bi bi-bar-chart fa-fw me-1"></i>Analytics
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@Nav("Applications")" asp-area="Guide" asp-controller="Applications" asp-action="Index">
                                    <i class="bi bi-file-earmark-text fa-fw me-1"></i>Applications
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@Nav("Discounts")" asp-area="Guide" asp-controller="Discounts" asp-action="Index">
                                    <i class="bi bi-tag fa-fw me-1"></i>Discounts
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@Nav("JoinRequests")" asp-area="Guide" asp-controller="JoinRequests" asp-action="Index">
                                    <i class="bi bi-people fa-fw me-1"></i>Join Requests
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@Nav("Proposals")" asp-area="Guide" asp-controller="Proposals" asp-action="Index">
                                    <i class="bi bi-lightbulb fa-fw me-1"></i>My Proposals
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@Nav("Agency")" asp-area="Guide" asp-controller="Agency" asp-action="Index">
                                    <i class="bi bi-building fa-fw me-1"></i>My Agency
                                </a>
                            </li>
                            @if (Has(WebPermission.AgencyRoster.Read))
                            {
                                <li class="nav-item">
                                    <a class="@Nav("AgencyRoster")" asp-area="Guide" asp-controller="AgencyRoster" asp-action="Index">
                                        <i class="bi bi-people-fill fa-fw me-1"></i>Agency Roster
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="@Nav("Reviews")" asp-area="Guide" asp-controller="Reviews" asp-action="Index">
                                    <i class="bi bi-star fa-fw me-1"></i>Reviews
                                </a>
                            </li>
                            <li class="nav-item ms-xl-auto">
                                <form asp-area="Auth" asp-controller="Auth" asp-action="Logout" method="post" class="d-grid">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="nav-link text-start text-danger bg-danger-soft-hover border-0 bg-transparent w-100">
                                        <i class="fas fa-sign-out-alt fa-fw me-1"></i>Sign Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
