@using YallaJo.Web.Areas.Guide.Models.AgencyRoster
@model AgencyRosterVm
@{
    ViewData["Title"] = Localizer["Guide.AgencyRoster.Title"].Value;
}

@await Component.InvokeAsync("GuideSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h1 class="h4 mb-0"><i class="fa-solid fa-people-group me-2" aria-hidden="true"></i>@Localizer["Guide.AgencyRoster.Heading"]</h1>
            <div class="d-flex gap-2 align-items-center">
                @if (Model.PendingApplicationCount > 0)
                {
                    <span class="badge bg-warning bg-opacity-10 text-warning align-self-center">
                        <i class="fa-solid fa-clock fa-fw" aria-hidden="true"></i>
                        @Localizer["Guide.AgencyRoster.PendingCount", Model.PendingApplicationCount]
                    </span>
                }
                <permission require="@WebPermission.AgencyRoster.Create">
                    <a href="#invite-guide" class="btn btn-sm btn-primary">
                        <i class="fa-solid fa-user-plus me-1" aria-hidden="true"></i>@Localizer["Guide.AgencyRoster.InviteGuide"]
                    </a>
                </permission>
            </div>
        </div>

        @* Swappable AJAX region (PE1: full PRG without JS — provider-actions.js enhances).
           The fragment root carries data-yj-swap="roster". *@
        <partial name="_RosterTables" model="Model" />

        @* ── Invite a guide (merged from the retired Invite page; anchor target for the 301) ── *@
        <permission require="@WebPermission.AgencyRoster.Create">
            <div class="card border" id="invite-guide">
                <div class="card-header border-bottom">
                    <h2 class="card-header-title h5 mb-0">
                        <i class="fa-solid fa-user-plus me-2" aria-hidden="true"></i>@Localizer["Guide.AgencyInvite.Heading"]
                    </h2>
                </div>
                <div class="card-body">
                    <partial name="_InviteGuideForm" model="Model.InviteForm" />
                </div>
            </div>
        </permission>
    </div>
</section>

@* ── Shared reason modal (MOD8) ──
   Single instance fed by guide-roster.js: title/confirm text come from the triggering
   form's data-reason-title/data-reason-action; the value is written back into that
   form's hidden reason input. The modal itself contains NO form. *@
<div class="modal fade" id="roster-reason-modal" tabindex="-1" aria-labelledby="roster-reason-title" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="roster-reason-title"></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Guide.Common.Close"]"></button>
            </div>
            <div class="modal-body">
                <label class="form-label" for="roster-reason-text">@Localizer["Guide.AgencyRoster.ReasonLabel"]</label>
                <textarea id="roster-reason-text" rows="3" maxlength="500" class="form-control"
                          aria-describedby="roster-reason-help"></textarea>
                <div id="roster-reason-help" class="form-text">@Localizer["Guide.AgencyRoster.ReasonHelp"]</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Guide.Common.Cancel"]</button>
                <button type="button" class="btn btn-danger" id="roster-reason-accept"></button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* CSP-safe external handlers (A6/SEC1/J3): provider-actions.js posts the data-yj-ajax
       forms and swaps the roster fragment; guide-roster.js runs the shared reason modal. *@
    <script src="~/assets/js/provider-actions.js" asp-append-version="true"></script>
    <script src="~/assets/js/guide-roster.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
}
