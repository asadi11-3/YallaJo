@using YallaJo.Web.Areas.Guide.Models.AgencyRoster
@using YallaJo.Web.Areas.Guide.Shared
@model InviteGuideFormVm
@{
    ViewData["Title"] = "Invite a guide";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as GuideSidebarVm ?? new GuideSidebarVm();
}

<partial name="_GuideSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="fs-4 mb-0"><i class="bi bi-person-plus me-2"></i>Invite a guide</h1>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to roster</a>
        </div>

        <div class="card border">
            <div class="card-body">
                @if (!Model.HasAvailableGuides)
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-person-x fs-1 d-block mb-2"></i>
                        <p class="mb-0">There are no unaffiliated guides available to invite right now.</p>
                    </div>
                }
                else
                {
                    <form asp-action="Invite" method="post" class="vstack gap-3">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div>
                            <label asp-for="GuideUserId" class="form-label"></label>
                            <select asp-for="GuideUserId" class="form-select">
                                <option value="">— Select a guide —</option>
                                @foreach (var g in Model.AvailableGuides)
                                {
                                    <option value="@g.UserId">@g.BusinessName (@g.ContactEmail)</option>
                                }
                            </select>
                            <span asp-validation-for="GuideUserId" class="text-danger"></span>
                        </div>

                        <div>
                            <label asp-for="ProposedCommissionPercentage" class="form-label"></label>
                            <div class="input-group" style="max-width: 200px;">
                                <input asp-for="ProposedCommissionPercentage" class="form-control" type="number" step="0.01" min="0" max="100" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="ProposedCommissionPercentage" class="text-danger"></span>
                        </div>

                        <div>
                            <label asp-for="Message" class="form-label"></label>
                            <textarea asp-for="Message" class="form-control" rows="3" maxlength="1000"
                                      placeholder="Optional message to the guide (max 1000 characters)."></textarea>
                            <span asp-validation-for="Message" class="text-danger"></span>
                        </div>

                        <div>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send me-1"></i>Send invitation
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</section>
