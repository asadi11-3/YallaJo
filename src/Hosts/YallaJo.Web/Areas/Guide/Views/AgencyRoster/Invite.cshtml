@using YallaJo.Web.Areas.Guide.Models.AgencyRoster
@model InviteGuideFormVm
@{
    ViewData["Title"] = Localizer["Guide.AgencyInvite.Title"].Value;
}

@await Component.InvokeAsync("GuideSidebar")

<section class="pt-0">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h1 class="h4 mb-0"><i class="fa-solid fa-user-plus me-2" aria-hidden="true"></i>@Localizer["Guide.AgencyInvite.Heading"]</h1>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>@Localizer["Guide.AgencyInvite.Back"]
            </a>
        </div>

        <div class="card border">
            <div class="card-body">
                @if (!Model.HasAvailableGuides)
                {
                    <partial name="_GuideEmptyState" model='new EmptyStateVm(Localizer["Guide.AgencyInvite.NoGuides"].Value)' />
                }
                else
                {
                    <form asp-action="Invite" method="post" class="vstack gap-3">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <div>
                            <label asp-for="GuideUserId" class="form-label">@Localizer["Guide.AgencyInvite.GuideLabel"]</label>
                            <select asp-for="GuideUserId" class="form-select">
                                <option value="">@Localizer["Guide.AgencyInvite.SelectGuide"]</option>
                                @foreach (var g in Model.AvailableGuides)
                                {
                                    <option value="@g.UserId">@g.BusinessName (@g.ContactEmail)</option>
                                }
                            </select>
                            <span asp-validation-for="GuideUserId" class="text-danger" role="alert"></span>
                        </div>

                        <div>
                            <label asp-for="ProposedCommissionPercentage" class="form-label">@Localizer["Guide.AgencyInvite.CommissionLabel"]</label>
                            <div class="input-group commission-input">
                                <input asp-for="ProposedCommissionPercentage" class="form-control" type="number" step="0.01" min="0" max="100" dir="ltr" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="ProposedCommissionPercentage" class="text-danger" role="alert"></span>
                        </div>

                        <div>
                            <label asp-for="Message" class="form-label">@Localizer["Guide.AgencyInvite.MessageLabel"]</label>
                            <textarea asp-for="Message" class="form-control" rows="3" maxlength="1000"
                                      aria-describedby="invite-message-help"
                                      placeholder="@Localizer["Guide.AgencyInvite.MessagePlaceholder"]"></textarea>
                            <div id="invite-message-help" class="form-text">@Localizer["Guide.AgencyInvite.MessageHelp"]</div>
                            <span asp-validation-for="Message" class="text-danger" role="alert"></span>
                        </div>

                        <div>
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-paper-plane me-1" aria-hidden="true"></i>@Localizer["Guide.AgencyInvite.Send"]
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</section>
