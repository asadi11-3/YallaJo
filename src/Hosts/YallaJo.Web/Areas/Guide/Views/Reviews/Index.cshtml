@model YallaJo.Web.Areas.Guide.Models.Reviews.ReviewsVm
@{
    ViewData["Title"] = Localizer["Guide.Reviews.Title"].Value;
}

@await Component.InvokeAsync("GuideSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h1 class="h4 mb-0"><i class="fa-solid fa-star me-2" aria-hidden="true"></i>@Localizer["Guide.Reviews.Heading"]</h1>
        </div>

        <div class="row g-4">
            <div class="col-sm-6 col-xl-3">
                <partial name="_GuideStatCard" model='new StatCardVm(Localizer["Guide.Reviews.AverageRating"].Value, GuideFormat.Rating(Model.AverageRating), "star", "warning")' />
            </div>
            <div class="col-sm-6 col-xl-3">
                <partial name="_GuideStatCard" model='new StatCardVm(Localizer["Guide.Reviews.TotalReviews"].Value, GuideFormat.Count(Model.ReviewCount), "comments", "primary")' />
            </div>
        </div>

        <div class="card border">
            <div class="card-header border-bottom">
                <h2 class="card-header-title h5 mb-0">@Localizer["Guide.Reviews.ListHeading"]</h2>
            </div>
            <div class="card-body">
                @* Phase 4: results fragment swapped via AJAX by listing.js; plain markup without JS (PE1).
                   The fragment root also carries data-yj-swap="reviews" so provider-actions.js can
                   swap it after a reply POST (B3). *@
                <div id="listingResults" data-yj-component="listing" aria-live="polite" aria-busy="false"
                     data-error-text="@Localizer["Public.Results.Error"]" data-retry-text="@Localizer["Public.Retry"]" data-loading-text="@Localizer["Public.Loading"]">
                    <partial name="_ReviewsResults" model="Model" />
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/assets/js/listing.js" asp-append-version="true"></script>
    @* provider-actions.js posts the data-yj-ajax reply forms and swaps the reviews fragment (B3). *@
    <script src="~/assets/js/provider-actions.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
}
