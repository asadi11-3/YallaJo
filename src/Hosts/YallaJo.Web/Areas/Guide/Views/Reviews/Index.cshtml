@model YallaJo.Web.Areas.Guide.Models.Reviews.ReviewsVm
@using YallaJo.Web.Areas.Guide.Shared
@inject Microsoft.Extensions.Localization.IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = "Reviews";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as GuideSidebarVm ?? new GuideSidebarVm();

    string Stars(decimal rating)
    {
        var full = (int)Math.Round(rating, MidpointRounding.AwayFromZero);
        if (full < 0) full = 0;
        if (full > 5) full = 5;
        return string.Concat(Enumerable.Repeat("★", full)) + string.Concat(Enumerable.Repeat("☆", 5 - full));
    }

    string StatusBadge(string status) => status?.ToLowerInvariant() switch
    {
        "published" or "approved" => "success",
        "awaitingmoderation" or "pending" => "warning",
        "autohidden" or "removedbyadmin" or "removed" => "danger",
        _ => "secondary"
    };
}

<partial name="_GuideSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h1 class="h3 mb-0">Reviews</h1>
        </div>

        <div class="row g-4">
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1 text-body-secondary">Average Rating</h6>
                            <h4 class="mb-0">@Model.AverageRating.ToString("0.0") <small class="text-warning">@Stars(Model.AverageRating)</small></h4>
                        </div>
                        <div class="icon-xl bg-warning-soft text-warning rounded-circle">
                            <i class="bi bi-star-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1 text-body-secondary">Total Reviews</h6>
                            <h4 class="mb-0">@Model.ReviewCount</h4>
                        </div>
                        <div class="icon-xl bg-primary-soft text-primary rounded-circle">
                            <i class="bi bi-chat-square-text"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border">
            <div class="card-header border-bottom">
                <h5 class="card-header-title mb-0">What travellers say</h5>
            </div>
            <div class="card-body">
                @if (!Model.HasReviews)
                {
                    <div class="text-center text-body-secondary py-4">
                        <i class="bi bi-chat-square-heart fs-1 d-block mb-2"></i>
                        You don't have any reviews yet.
                    </div>
                }
                else
                {
                    <div class="vstack gap-3">
                        @foreach (var review in Model.Reviews)
                        {
                            <div class="border rounded p-3">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div>
                                        <span class="text-warning fs-5">@Stars(review.Rating)</span>
                                        <span class="ms-1 fw-semibold">@review.Rating.ToString("0.0")</span>
                                        @if (review.IsVerifiedBooking)
                                        {
                                            <span class="badge bg-success-soft ms-2"><i class="bi bi-patch-check"></i> Verified booking</span>
                                        }
                                        <span class="badge bg-@(StatusBadge(review.Status))-soft ms-1">@review.Status</span>
                                    </div>
                                    <small class="text-body-secondary">@review.CreatedAt.ToString("dd MMM yyyy")</small>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(review.Title))
                                {
                                    <h6 class="mt-2 mb-1">@review.Title</h6>
                                }
                                <p class="mb-1">@review.Content</p>
                                <div class="d-flex gap-3 text-body-secondary small">
                                    @if (review.VisitDate is { } visit)
                                    {
                                        <span><i class="bi bi-calendar-event"></i> @Localizer["Public.Visited", visit.ToString("dd MMM yyyy")]</span>
                                    }
                                    <span><i class="bi bi-hand-thumbs-up"></i> @Localizer["Public.HelpfulCount", review.HelpfulVoteCount]</span>
                                </div>
                                @if (review.Replies.Count > 0)
                                {
                                    <div class="mt-3 ps-3 border-start">
                                        @foreach (var reply in review.Replies)
                                        {
                                            <div class="mb-2">
                                                <div class="small fw-semibold text-body-secondary">
                                                    <i class="bi bi-reply-fill"></i> Your reply
                                                    <span class="fw-normal">· @reply.CreatedAt.ToString("dd MMM yyyy")</span>
                                                </div>
                                                <div class="small">@reply.Content</div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    @if (Model.TotalPages > 1)
                    {
                        <nav class="mt-3">
                            <ul class="pagination justify-content-center mb-0">
                                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                    <a class="page-link" asp-area="Guide" asp-controller="Reviews" asp-action="Index" asp-route-page="@(Model.Page - 1)">@Localizer["Public.Previous"]</a>
                                </li>
                                <li class="page-item disabled"><span class="page-link">@Localizer["Public.PageOf", Model.Page, Model.TotalPages]</span></li>
                                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                    <a class="page-link" asp-area="Guide" asp-controller="Reviews" asp-action="Index" asp-route-page="@(Model.Page + 1)">@Localizer["Public.Next"]</a>
                                </li>
                            </ul>
                        </nav>
                    }
                }
            </div>
        </div>
    </div>
</section>
