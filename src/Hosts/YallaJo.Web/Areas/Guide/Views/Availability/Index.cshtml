@model YallaJo.Web.Areas.Guide.Models.Availability.AvailabilityVm
@{
    ViewData["Title"] = Localizer["Guide.Availability.Title"].Value;
    // Thin DateOnly adapter — GuideFormat.Date takes DateTime (same yyyy-MM-dd output).
    string Date(DateOnly d) => GuideFormat.Date(d.ToDateTime(TimeOnly.MinValue));
}

@await Component.InvokeAsync("GuideSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">
        <div>
            <h1 class="h4 mb-1"><i class="fa-solid fa-calendar-xmark me-2" aria-hidden="true"></i>@Localizer["Guide.Availability.Heading"]</h1>
            <p class="text-body-secondary mb-0">@Localizer["Guide.Availability.Subtitle"]</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-5">
                <div class="card card-body border">
                    <h2 class="card-header-title h5 mb-3">@Localizer["Guide.Availability.AddHeading"]</h2>
                    <form asp-area="Guide" asp-controller="Availability" asp-action="Add" method="post" class="vstack gap-3" data-loading>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger small" role="alert"></div>
                        <div>
                            <label asp-for="Form.StartDate" class="form-label">@Localizer["Guide.Availability.StartDate"]</label>
                            <input asp-for="Form.StartDate" class="form-control" type="date" dir="ltr" />
                            <span asp-validation-for="Form.StartDate" class="text-danger small" role="alert"></span>
                        </div>
                        <div>
                            <label asp-for="Form.EndDate" class="form-label">@Localizer["Guide.Availability.EndDate"]</label>
                            <input asp-for="Form.EndDate" class="form-control" type="date" dir="ltr" />
                            <span asp-validation-for="Form.EndDate" class="text-danger small" role="alert"></span>
                        </div>
                        <div>
                            <label asp-for="Form.Reason" class="form-label">@Localizer["Guide.Availability.Reason"]</label>
                            <input asp-for="Form.Reason" class="form-control" placeholder="@Localizer["Guide.Availability.ReasonPlaceholder"]" />
                            <span asp-validation-for="Form.Reason" class="text-danger small" role="alert"></span>
                        </div>
                        <div>
                            <button type="submit" class="btn btn-primary mb-0">
                                <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>@Localizer["Guide.Availability.AddBlock"]
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card border">
                    <div class="card-header border-bottom">
                        <h2 class="card-header-title h5 mb-0">@Localizer["Guide.Availability.BlockedHeading"]</h2>
                    </div>
                    <div class="card-body">
                        @if (!Model.HasBlocks)
                        {
                            <partial name="_GuideEmptyState" model='new EmptyStateVm(Localizer["Guide.Availability.NoBlocks"].Value)' />
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th scope="col">@Localizer["Guide.Availability.ColFrom"]</th>
                                            <th scope="col">@Localizer["Guide.Availability.ColTo"]</th>
                                            <th scope="col">@Localizer["Guide.Availability.ColReason"]</th>
                                            <th scope="col">@Localizer["Guide.Availability.ColStatus"]</th>
                                            <th scope="col" class="text-end">@Localizer["Guide.Availability.ColActions"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var block in Model.Blocks)
                                        {
                                            <tr>
                                                <td><bdi dir="ltr" class="font-data">@Date(block.StartDate)</bdi></td>
                                                <td><bdi dir="ltr" class="font-data">@Date(block.EndDate)</bdi></td>
                                                <td>
                                                    @if (string.IsNullOrWhiteSpace(block.Reason))
                                                    {
                                                        <span class="text-body-secondary" aria-label="@Localizer["Guide.Availability.NoReason"]">&mdash;</span>
                                                    }
                                                    else
                                                    {
                                                        @block.Reason
                                                    }
                                                </td>
                                                <td>
                                                    @if (block.IsActive)
                                                    {
                                                        <span class="badge bg-warning bg-opacity-10 text-warning"><i class="fa-solid fa-clock fa-fw" aria-hidden="true"></i> @Localizer["Guide.Availability.Active"]</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary bg-opacity-10 text-secondary"><i class="fa-solid fa-circle-check fa-fw" aria-hidden="true"></i> @Localizer["Guide.Availability.Past"]</span>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <form asp-area="Guide" asp-controller="Availability" asp-action="Delete" asp-route-blockId="@block.Id" method="post" class="d-inline" data-loading
                                                          data-confirm='@Localizer["Guide.Availability.DeleteBody", Date(block.StartDate), Date(block.EndDate)]'
                                                          data-confirm-title='@Localizer["Guide.Availability.DeleteTitle"]'
                                                          data-confirm-action='@Localizer["Guide.Availability.DeleteConfirm"]'
                                                          data-confirm-cancel='@Localizer["Guide.Common.Cancel"]'>
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger mb-0"
                                                                aria-label="@Localizer["Guide.Availability.DeleteLabel"]">
                                                            <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
