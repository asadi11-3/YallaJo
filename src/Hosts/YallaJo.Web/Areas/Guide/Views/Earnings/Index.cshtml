@model YallaJo.Web.Areas.Guide.Models.Earnings.EarningsVm
@{
    ViewData["Title"] = Localizer["Guide.Earnings.Title"].Value;
    // Thin DateOnly adapter — GuideFormat.Date takes DateTime (same yyyy-MM-dd output).
    string Date(DateOnly d) => GuideFormat.Date(d.ToDateTime(TimeOnly.MinValue));
}

@await Component.InvokeAsync("GuideSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">
        <h1 class="fs-4 mb-0"><i class="fa-solid fa-arrow-trend-up me-2" aria-hidden="true"></i>@Localizer["Guide.Earnings.Heading"]</h1>
        <div class="row g-4">
            <div class="col-sm-6 col-xl-3">
                <partial name="_GuideStatCard" model='new StatCardVm(Localizer["Guide.Earnings.NetEarnings"].Value, GuideFormat.Money(Model.NetEarnings, Model.Currency), "wallet", "success")' />
            </div>
            <div class="col-sm-6 col-xl-3">
                <partial name="_GuideStatCard" model='new StatCardVm(Localizer["Guide.Earnings.ThisMonth"].Value, GuideFormat.Money(Model.ThisMonth, Model.Currency), "calendar-day", "primary")' />
            </div>
            <div class="col-sm-6 col-xl-3">
                <partial name="_GuideStatCard" model='new StatCardVm(Localizer["Guide.Earnings.PendingPayout"].Value, GuideFormat.Money(Model.PendingPayout, Model.Currency), "hourglass-half", "warning")' />
            </div>
            <div class="col-sm-6 col-xl-3">
                <partial name="_GuideStatCard" model='new StatCardVm(Localizer["Guide.Earnings.CommissionDeducted"].Value, GuideFormat.Money(Model.CommissionDeducted, Model.Currency), "percent", "info")' />
            </div>
        </div>

        <div class="card card-body border">
            <h2 class="h6 mb-3">@Localizer["Guide.Earnings.ByTour"]</h2>
            @if (!Model.HasByTour)
            {
                <partial name="_GuideEmptyState" model='new EmptyStateVm(Localizer["Guide.Earnings.NoByTour"].Value)' />
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">@Localizer["Guide.Earnings.ColTour"]</th>
                                <th scope="col" class="text-end">@Localizer["Guide.Earnings.ColBookings"]</th>
                                <th scope="col" class="text-end">@Localizer["Guide.Earnings.ColGross"]</th>
                                <th scope="col" class="text-end">@Localizer["Guide.Earnings.ColCommission"]</th>
                                <th scope="col" class="text-end">@Localizer["Guide.Earnings.ColNet"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.ByTour)
                            {
                                <tr>
                                    <td class="fw-semibold">@row.TourName</td>
                                    <td class="text-end"><bdi dir="ltr" class="font-data">@GuideFormat.Count(row.BookingCount)</bdi></td>
                                    <td class="text-end"><bdi dir="ltr" class="font-data">@GuideFormat.Money(row.GrossAmount, row.Currency)</bdi></td>
                                    <td class="text-end"><bdi dir="ltr" class="font-data">@GuideFormat.Money(row.CommissionAmount, row.Currency)</bdi></td>
                                    <td class="text-end fw-semibold"><bdi dir="ltr" class="font-data">@GuideFormat.Money(row.NetAmount, row.Currency)</bdi></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="card card-body border">
            <h2 class="h6 mb-3">@Localizer["Guide.Earnings.History"]</h2>
            @if (!Model.HasHistory)
            {
                <partial name="_GuideEmptyState" model='new EmptyStateVm(Localizer["Guide.Earnings.NoHistory"].Value)' />
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">@Localizer["Guide.Earnings.ColDate"]</th>
                                <th scope="col" class="text-end">@Localizer["Guide.Earnings.ColGross"]</th>
                                <th scope="col" class="text-end">@Localizer["Guide.Earnings.ColCommission"]</th>
                                <th scope="col" class="text-end">@Localizer["Guide.Earnings.ColNet"]</th>
                                <th scope="col">@Localizer["Guide.Earnings.ColStatus"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.History)
                            {
                                <tr>
                                    <td><bdi dir="ltr" class="font-data">@Date(row.EarnedDate)</bdi></td>
                                    <td class="text-end"><bdi dir="ltr" class="font-data">@GuideFormat.Money(row.GrossAmount, row.Currency)</bdi></td>
                                    <td class="text-end"><bdi dir="ltr" class="font-data">@GuideFormat.Money(row.CommissionAmount, row.Currency)</bdi></td>
                                    <td class="text-end fw-semibold"><bdi dir="ltr" class="font-data">@GuideFormat.Money(row.NetAmount, row.Currency)</bdi></td>
                                    <td>
                                        <partial name="_GuideStatusBadge" model="new StatusBadgeVm(row.Status)" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <partial name="_GuidePagination" model='new PaginationVm(Model.Page, Model.TotalPages, Model.HasPreviousPage, Model.HasNextPage, "Earnings", Localizer["Guide.Earnings.Pagination"].Value)' />
            }
        </div>
    </div>
</section>
