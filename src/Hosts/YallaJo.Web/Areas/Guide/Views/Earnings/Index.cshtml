@model YallaJo.Web.Areas.Guide.Models.Earnings.EarningsVm
@{
    ViewData["Title"] = Localizer["Guide.Earnings.Title"].Value;
    var culture = CultureInfo.CurrentUICulture;
    string Money(decimal a, string? c) => a.ToString("N3", culture) + " " + (string.IsNullOrWhiteSpace(c) ? "JOD" : c);
    string Count(int n) => n.ToString("N0", culture);
    string Date(DateOnly d) => d.ToString("yyyy-MM-dd", culture);
    (string Color, string Icon) StatusStyle(string status) => status?.ToLowerInvariant() switch
    {
        "paid" or "completed" => ("success", "circle-check"),
        "pending" => ("warning", "clock"),
        "cancelled" or "refunded" => ("danger", "circle-xmark"),
        _ => ("secondary", "circle-info"),
    };
    string StatusLabel(string s) => Localizer["Guide.Status." + (string.IsNullOrWhiteSpace(s) ? "Unknown" : s)];
}

@await Component.InvokeAsync("GuideSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">
        <h1 class="fs-4 mb-0"><i class="fa-solid fa-arrow-trend-up me-2" aria-hidden="true"></i>@Localizer["Guide.Earnings.Heading"]</h1>
        <div class="row g-4">
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h6 mb-1 text-body-secondary">@Localizer["Guide.Earnings.NetEarnings"]</h2>
                            <p class="h4 mb-0 font-data"><bdi dir="ltr">@Money(Model.NetEarnings, Model.Currency)</bdi></p>
                        </div>
                        <div class="icon-xl bg-success-soft text-success rounded-circle"><i class="fa-solid fa-wallet" aria-hidden="true"></i></div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h6 mb-1 text-body-secondary">@Localizer["Guide.Earnings.ThisMonth"]</h2>
                            <p class="h4 mb-0 font-data"><bdi dir="ltr">@Money(Model.ThisMonth, Model.Currency)</bdi></p>
                        </div>
                        <div class="icon-xl bg-primary-soft text-primary rounded-circle"><i class="fa-solid fa-calendar-day" aria-hidden="true"></i></div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h6 mb-1 text-body-secondary">@Localizer["Guide.Earnings.PendingPayout"]</h2>
                            <p class="h4 mb-0 font-data"><bdi dir="ltr">@Money(Model.PendingPayout, Model.Currency)</bdi></p>
                        </div>
                        <div class="icon-xl bg-warning-soft text-warning rounded-circle"><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i></div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h6 mb-1 text-body-secondary">@Localizer["Guide.Earnings.CommissionDeducted"]</h2>
                            <p class="h4 mb-0 font-data"><bdi dir="ltr">@Money(Model.CommissionDeducted, Model.Currency)</bdi></p>
                        </div>
                        <div class="icon-xl bg-info-soft text-info rounded-circle"><i class="fa-solid fa-percent" aria-hidden="true"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card card-body border">
            <h2 class="h6 mb-3">@Localizer["Guide.Earnings.ByTour"]</h2>
            @if (!Model.HasByTour)
            {
                <div class="text-center py-5">
                    <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
                    <p class="mb-0 text-body-secondary">@Localizer["Guide.Earnings.NoByTour"]</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">@Localizer["Guide.Earnings.ColTour"]</th>
                                <th scope="col" class="text-end">@Localizer["Guide.Earnings.ColBookings"]</th>
                                <th scope="col" class="text-end">@Localizer["Guide.Earnings.ColGross"]</th>
                                <th scope="col" class="text-end">@Localizer["Guide.Earnings.ColCommission"]</th>
                                <th scope="col" class="text-end">@Localizer["Guide.Earnings.ColNet"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.ByTour)
                            {
                                <tr>
                                    <td class="fw-semibold">@row.TourName</td>
                                    <td class="text-end"><bdi dir="ltr" class="font-data">@Count(row.BookingCount)</bdi></td>
                                    <td class="text-end"><bdi dir="ltr" class="font-data">@Money(row.GrossAmount, row.Currency)</bdi></td>
                                    <td class="text-end"><bdi dir="ltr" class="font-data">@Money(row.CommissionAmount, row.Currency)</bdi></td>
                                    <td class="text-end fw-semibold"><bdi dir="ltr" class="font-data">@Money(row.NetAmount, row.Currency)</bdi></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="card card-body border">
            <h2 class="h6 mb-3">@Localizer["Guide.Earnings.History"]</h2>
            @if (!Model.HasHistory)
            {
                <div class="text-center py-5">
                    <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
                    <p class="mb-0 text-body-secondary">@Localizer["Guide.Earnings.NoHistory"]</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">@Localizer["Guide.Earnings.ColDate"]</th>
                                <th scope="col" class="text-end">@Localizer["Guide.Earnings.ColGross"]</th>
                                <th scope="col" class="text-end">@Localizer["Guide.Earnings.ColCommission"]</th>
                                <th scope="col" class="text-end">@Localizer["Guide.Earnings.ColNet"]</th>
                                <th scope="col">@Localizer["Guide.Earnings.ColStatus"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.History)
                            {
                                var s = StatusStyle(row.Status);
                                <tr>
                                    <td><bdi dir="ltr" class="font-data">@Date(row.EarnedDate)</bdi></td>
                                    <td class="text-end"><bdi dir="ltr" class="font-data">@Money(row.GrossAmount, row.Currency)</bdi></td>
                                    <td class="text-end"><bdi dir="ltr" class="font-data">@Money(row.CommissionAmount, row.Currency)</bdi></td>
                                    <td class="text-end fw-semibold"><bdi dir="ltr" class="font-data">@Money(row.NetAmount, row.Currency)</bdi></td>
                                    <td>
                                        <span class="badge bg-@s.Color bg-opacity-10 text-@s.Color">
                                            <i class="fa-solid fa-@s.Icon fa-fw" aria-hidden="true"></i> @StatusLabel(row.Status)
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-3" aria-label="@Localizer["Guide.Earnings.Pagination"]">
                        <ul class="pagination pagination-sm justify-content-center mb-0">
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" asp-area="Guide" asp-controller="Earnings" asp-action="Index" asp-route-page="@(Model.Page - 1)">@Localizer["Guide.Common.Previous"]</a>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-link"><bdi dir="ltr">@Localizer["Guide.Common.PageOf", Model.Page, Model.TotalPages]</bdi></span>
                            </li>
                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link" asp-area="Guide" asp-controller="Earnings" asp-action="Index" asp-route-page="@(Model.Page + 1)">@Localizer["Guide.Common.Next"]</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</section>
