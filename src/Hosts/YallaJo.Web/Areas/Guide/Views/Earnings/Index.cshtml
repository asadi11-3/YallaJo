@model YallaJo.Web.Areas.Guide.Models.Earnings.EarningsVm
@using YallaJo.Web.Areas.Guide.Shared
@{
    ViewData["Title"] = "Earnings";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as GuideSidebarVm ?? new GuideSidebarVm();
    string Money(decimal a, string? c) => string.IsNullOrWhiteSpace(c) ? a.ToString("N2") : $"{a:N2} {c}";
    string StatusBadge(string status) => status?.ToLowerInvariant() switch
    {
        "paid" or "completed" => "bg-success-soft text-success",
        "pending" => "bg-warning-soft text-warning",
        "cancelled" or "refunded" => "bg-danger-soft text-danger",
        _ => "bg-secondary-soft text-secondary",
    };
}

<partial name="_GuideSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">
        <h1 class="fs-4 mb-0"><i class="bi bi-graph-up-arrow me-2"></i>Earnings</h1>
        <div class="row g-4">
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1 text-body-secondary">Net Earnings</h6>
                            <h4 class="mb-0">@Money(Model.NetEarnings, Model.Currency)</h4>
                        </div>
                        <div class="icon-xl bg-success-soft text-success rounded-circle">
                            <i class="bi bi-wallet2"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1 text-body-secondary">This Month</h6>
                            <h4 class="mb-0">@Money(Model.ThisMonth, Model.Currency)</h4>
                        </div>
                        <div class="icon-xl bg-primary-soft text-primary rounded-circle">
                            <i class="bi bi-calendar-month"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1 text-body-secondary">Pending Payout</h6>
                            <h4 class="mb-0">@Money(Model.PendingPayout, Model.Currency)</h4>
                        </div>
                        <div class="icon-xl bg-warning-soft text-warning rounded-circle">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1 text-body-secondary">Commission Deducted</h6>
                            <h4 class="mb-0">@Money(Model.CommissionDeducted, Model.Currency)</h4>
                        </div>
                        <div class="icon-xl bg-info-soft text-info rounded-circle">
                            <i class="bi bi-percent"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card card-body border">
            <h6 class="mb-3">Earnings by Tour</h6>
            @if (!Model.HasByTour)
            {
                <div class="text-center text-body-secondary py-4">
                    <i class="bi bi-graph-up-arrow fs-1 d-block mb-2"></i>
                    No tour earnings yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Tour</th>
                                <th class="text-end">Bookings</th>
                                <th class="text-end">Gross</th>
                                <th class="text-end">Commission</th>
                                <th class="text-end">Net</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.ByTour)
                            {
                                <tr>
                                    <td>@row.TourName</td>
                                    <td class="text-end">@row.BookingCount</td>
                                    <td class="text-end">@Money(row.GrossAmount, row.Currency)</td>
                                    <td class="text-end">@Money(row.CommissionAmount, row.Currency)</td>
                                    <td class="text-end fw-semibold">@Money(row.NetAmount, row.Currency)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="card card-body border">
            <h6 class="mb-3">Earnings History</h6>
            @if (!Model.HasHistory)
            {
                <div class="text-center text-body-secondary py-4">
                    <i class="bi bi-clock-history fs-1 d-block mb-2"></i>
                    No earnings history yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Booking</th>
                                <th class="text-end">Gross</th>
                                <th class="text-end">Commission</th>
                                <th class="text-end">Net</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.History)
                            {
                                <tr>
                                    <td>@row.EarnedDate.ToString("yyyy-MM-dd")</td>
                                    <td><code>@row.BookingId.ToString().Substring(0, 8)</code></td>
                                    <td class="text-end">@Money(row.GrossAmount, row.Currency)</td>
                                    <td class="text-end">@Money(row.CommissionAmount, row.Currency)</td>
                                    <td class="text-end fw-semibold">@Money(row.NetAmount, row.Currency)</td>
                                    <td><span class="badge @StatusBadge(row.Status)">@row.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-3">
                        <ul class="pagination pagination-sm justify-content-center mb-0">
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" asp-area="Guide" asp-controller="Earnings" asp-action="Index"
                                   asp-route-page="@(Model.Page - 1)">Previous</a>
                            </li>
                            <li class="page-item disabled">
                                <span class="page-link">Page @Model.Page of @Model.TotalPages</span>
                            </li>
                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link" asp-area="Guide" asp-controller="Earnings" asp-action="Index"
                                   asp-route-page="@(Model.Page + 1)">Next</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</section>
