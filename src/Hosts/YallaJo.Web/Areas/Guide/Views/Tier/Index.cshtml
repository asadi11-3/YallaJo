@model YallaJo.Web.Areas.Guide.Models.Dashboard.TierProgressVm
@{
    ViewData["Title"] = Localizer["Guide.Tier.Title"].Value;
    var culture = CultureInfo.CurrentUICulture;
    string PctW(int p) => Math.Clamp(p, 0, 100).ToString(CultureInfo.InvariantCulture) + "%";
    string Count(int n) => n.ToString("N0", culture);
    string Rating(decimal v) => v.ToString("0.0", culture);
    string Pct(decimal v) => v.ToString("0.##", culture) + "%";
}

@await Component.InvokeAsync("GuideSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">
        <h1 class="fs-4 mb-0"><i class="fa-solid fa-award me-2" aria-hidden="true"></i>@Localizer["Guide.Tier.Heading"]</h1>

        <div class="row g-4">
            <div class="col-lg-5">
                <div class="card border h-100">
                    <div class="card-body text-center d-flex flex-column justify-content-center">
                        <span class="small text-body-secondary">@Localizer["Guide.Tier.CurrentTier"]</span>
                        <div class="display-6 fw-bold my-1"><bdi>@(string.IsNullOrWhiteSpace(Model.CurrentTier) ? "—" : Model.CurrentTier)</bdi></div>
                        <div>
                            <span class="badge bg-success bg-opacity-10 text-success fs-6">
                                <i class="fa-solid fa-percent me-1" aria-hidden="true"></i><bdi dir="ltr">@Localizer["Guide.Tier.Commission", Pct(Model.CurrentCommissionRate)]</bdi>
                            </span>
                        </div>
                        @if (Model.HasNextTier)
                        {
                            <p class="small text-body-secondary mt-3 mb-0">@Localizer["Guide.Tier.MeetTargets"] <strong><bdi>@Model.NextTier</bdi></strong>.</p>
                        }
                        else
                        {
                            <p class="small text-body-secondary mt-3 mb-0">@Localizer["Guide.Tier.TopTier"]</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card border h-100">
                    <div class="card-header border-bottom"><h2 class="card-header-title h5 mb-0">@Localizer["Guide.Tier.ProgressHeading"]</h2></div>
                    <div class="card-body vstack gap-3">
                        @{
                            var toursMet = Model.CompletedTours >= Model.CompletedToursRequired;
                            var ratingMet = Model.AverageRating >= Model.AverageRatingRequired;
                            var monthsMet = Model.ActiveMonths >= Model.ActiveMonthsRequired;
                            var reportOk = Model.ReportRate <= Model.MaxReportRateAllowed;
                        }

                        <div>
                            <div class="d-flex justify-content-between small mb-1">
                                <span>@Localizer["Guide.Tier.CompletedTours"]</span>
                                <span class="@(toursMet ? "text-success" : "text-body-secondary")">
                                    @if (toursMet)
                                    {
                                        <i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>
                                    }
                                    <bdi dir="ltr" class="font-data">@Count(Model.CompletedTours) / @Count(Model.CompletedToursRequired)</bdi>
                                </span>
                            </div>
                            <div class="progress" role="progressbar" aria-label="@Localizer["Guide.Tier.CompletedTours"]" aria-valuenow="@Model.ToursPercent" aria-valuemin="0" aria-valuemax="100" style="height:.5rem;">
                                <div class="progress-bar @(toursMet ? "bg-success" : "")" style="width:@PctW(Model.ToursPercent)"></div>
                            </div>
                        </div>

                        <div>
                            <div class="d-flex justify-content-between small mb-1">
                                <span>@Localizer["Guide.Tier.AverageRating"]</span>
                                <span class="@(ratingMet ? "text-success" : "text-body-secondary")">
                                    @if (ratingMet)
                                    {
                                        <i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>
                                    }
                                    <bdi dir="ltr" class="font-data">@Rating(Model.AverageRating) / @Rating(Model.AverageRatingRequired)</bdi>
                                </span>
                            </div>
                            <div class="progress" role="progressbar" aria-label="@Localizer["Guide.Tier.AverageRating"]" aria-valuenow="@Model.RatingPercent" aria-valuemin="0" aria-valuemax="100" style="height:.5rem;">
                                <div class="progress-bar @(ratingMet ? "bg-success" : "")" style="width:@PctW(Model.RatingPercent)"></div>
                            </div>
                        </div>

                        <div>
                            <div class="d-flex justify-content-between small mb-1">
                                <span>@Localizer["Guide.Tier.ActiveMonths"]</span>
                                <span class="@(monthsMet ? "text-success" : "text-body-secondary")">
                                    @if (monthsMet)
                                    {
                                        <i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>
                                    }
                                    <bdi dir="ltr" class="font-data">@Count(Model.ActiveMonths) / @Count(Model.ActiveMonthsRequired)</bdi>
                                </span>
                            </div>
                            <div class="progress" role="progressbar" aria-label="@Localizer["Guide.Tier.ActiveMonths"]" aria-valuenow="@Model.ActiveMonthsPercent" aria-valuemin="0" aria-valuemax="100" style="height:.5rem;">
                                <div class="progress-bar @(monthsMet ? "bg-success" : "")" style="width:@PctW(Model.ActiveMonthsPercent)"></div>
                            </div>
                        </div>

                        <div>
                            <div class="d-flex justify-content-between small mb-1">
                                <span>@Localizer["Guide.Tier.ReportRate", Pct(Model.MaxReportRateAllowed)]</span>
                                <span class="@(reportOk ? "text-success" : "text-danger")">
                                    @if (reportOk)
                                    {
                                        <i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>
                                    }
                                    <bdi dir="ltr" class="font-data">@Pct(Model.ReportRate)</bdi>
                                </span>
                            </div>
                        </div>

                        <a asp-area="Guide" asp-controller="Analytics" asp-action="Index" class="btn btn-sm btn-secondary-soft align-self-start mt-2">
                            <i class="fa-solid fa-chart-line me-1" aria-hidden="true"></i>@Localizer["Guide.Tier.ViewAnalytics"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
