@model YallaJo.Web.Areas.Guide.Models.Applications.ApplicationsVm
@{
    ViewData["Title"] = Localizer["Guide.Applications.Title"].Value;
}

@await Component.InvokeAsync("GuideSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">
        <div>
            <h1 class="h4 mb-1"><i class="fa-solid fa-file-lines me-2" aria-hidden="true"></i>@Localizer["Guide.Applications.Heading"]</h1>
            <p class="text-body-secondary mb-0">@Localizer["Guide.Applications.Subtitle"]</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-5">
                <div class="card card-body border h-100">
                    <h2 class="card-header-title h5 mb-3"><i class="fa-solid fa-paper-plane me-2" aria-hidden="true"></i>@Localizer["Guide.Applications.ApplyHeading"]</h2>
                    <form asp-area="Guide" asp-controller="Applications" asp-action="Apply" method="post" data-loading>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Form.TourId" class="form-label">@Localizer["Guide.Applications.TourId"]</label>
                            @* F10: SSR select (PE1) progressively enhanced into an async searchable combobox by guide-applications.js. *@
                            <select asp-for="Form.TourId" class="form-select js-open-tour-picker"
                                    data-lookup-url="@Url.Action("OpenTours")"
                                    data-no-results="@Localizer["Guide.Applications.NoResults"]">
                                <option value="">@Localizer["Guide.Applications.SelectTour"]</option>
                                @foreach (var tour in Model.OpenTours)
                                {
                                    @* OptionTagHelper auto-selects the option matching Form.TourId via asp-for. *@
                                    <option value="@tour.TourId">@tour.Label</option>
                                }
                            </select>
                            <span asp-validation-for="Form.TourId" class="text-danger small" role="alert"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Form.Message" class="form-label">@Localizer["Guide.Applications.Message"]</label>
                            <textarea asp-for="Form.Message" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Form.Message" class="text-danger small" role="alert"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Form.RelevantExperience" class="form-label">@Localizer["Guide.Applications.Experience"]</label>
                            <textarea asp-for="Form.RelevantExperience" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Form.RelevantExperience" class="text-danger small" role="alert"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Form.ProposedBasePrice" class="form-label">@Localizer["Guide.Applications.ProposedPrice"]</label>
                            <input asp-for="Form.ProposedBasePrice" type="number" step="0.01" min="0" class="form-control" dir="ltr" />
                            <span asp-validation-for="Form.ProposedBasePrice" class="text-danger small" role="alert"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-paper-plane me-1" aria-hidden="true"></i>@Localizer["Guide.Applications.Submit"]
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card card-body border h-100">
                    <h2 class="card-header-title h5 mb-3"><i class="fa-solid fa-list-check me-2" aria-hidden="true"></i>@Localizer["Guide.Applications.MyApplications"]</h2>

                    @* Phase 4: results fragment swapped via AJAX by listing.js; plain markup without JS (PE1). *@
                    <div id="listingResults" data-yj-component="listing" aria-live="polite" aria-busy="false"
                         data-error-text="@Localizer["Public.Results.Error"]" data-retry-text="@Localizer["Public.Retry"]" data-loading-text="@Localizer["Public.Loading"]">
                        <partial name="_ApplicationsResults" model="Model" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/assets/js/listing.js" asp-append-version="true"></script>
    <script src="~/assets/js/guide-applications.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
}
