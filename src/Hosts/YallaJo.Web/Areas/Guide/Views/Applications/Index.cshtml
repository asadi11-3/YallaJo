@model YallaJo.Web.Areas.Guide.Models.Applications.ApplicationsVm
@using YallaJo.Web.Areas.Guide.Shared
@{
    ViewData["Title"] = "Applications";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as GuideSidebarVm ?? new GuideSidebarVm();

    string Money(decimal? amount, string currency = "JOD")
        => amount is null ? "—" : $"{amount.Value:N2} {currency}";

    string StatusBadge(string status) => status?.ToLowerInvariant() switch
    {
        "approved" or "accepted" => "bg-success-soft text-success",
        "rejected" or "declined" => "bg-danger-soft text-danger",
        "pending" or "submitted" => "bg-warning-soft text-warning",
        _ => "bg-secondary-soft text-secondary",
    };
}

<partial name="_GuideSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h1 class="h3 mb-0">Applications</h1>
                <p class="text-body-secondary mb-0">Apply to run a tour and track the status of your requests.</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-5">
                <div class="card card-body border h-100">
                    <h5 class="mb-3"><i class="bi bi-send me-2"></i>Apply to run a tour</h5>
                    <form asp-area="Guide" asp-controller="Applications" asp-action="Apply" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                        <div class="mb-3">
                            <label asp-for="Form.TourId" class="form-label"></label>
                            <input asp-for="Form.TourId" class="form-control" placeholder="00000000-0000-0000-0000-000000000000" />
                            <span asp-validation-for="Form.TourId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Form.Message" class="form-label"></label>
                            <textarea asp-for="Form.Message" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Form.Message" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Form.RelevantExperience" class="form-label"></label>
                            <textarea asp-for="Form.RelevantExperience" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Form.RelevantExperience" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Form.ProposedBasePrice" class="form-label"></label>
                            <input asp-for="Form.ProposedBasePrice" type="number" step="0.01" min="0" class="form-control" />
                            <span asp-validation-for="Form.ProposedBasePrice" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send me-1"></i>Submit application
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card card-body border h-100">
                    <h5 class="mb-3"><i class="bi bi-file-earmark-text me-2"></i>My applications</h5>

                    @if (!Model.HasApplications)
                    {
                        <div class="text-center text-body-secondary py-4">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            You haven't applied to run any tours yet.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Tour</th>
                                        <th>Status</th>
                                        <th>Proposed price</th>
                                        <th>Applied</th>
                                        <th>Reviewed</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var app in Model.Applications)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@app.TourTitle</div>
                                                @if (!string.IsNullOrWhiteSpace(app.Message))
                                                {
                                                    <div class="small text-body-secondary text-truncate" style="max-width: 280px;">@app.Message</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(app.RejectionReason))
                                                {
                                                    <div class="small text-danger"><i class="bi bi-exclamation-circle me-1"></i>@app.RejectionReason</div>
                                                }
                                            </td>
                                            <td><span class="badge @StatusBadge(app.Status)">@app.Status</span></td>
                                            <td>@Money(app.ProposedBasePrice)</td>
                                            <td>@app.CreatedAt.ToString("dd MMM yyyy")</td>
                                            <td>@(app.ReviewedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (Model.TotalPages > 1)
                        {
                            <nav class="mt-3">
                                <ul class="pagination pagination-sm mb-0 justify-content-center">
                                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                        <a class="page-link" asp-area="Guide" asp-controller="Applications" asp-action="Index" asp-route-page="@(Model.Page - 1)">Previous</a>
                                    </li>
                                    <li class="page-item disabled">
                                        <span class="page-link">Page @Model.Page of @Model.TotalPages</span>
                                    </li>
                                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                        <a class="page-link" asp-area="Guide" asp-controller="Applications" asp-action="Index" asp-route-page="@(Model.Page + 1)">Next</a>
                                    </li>
                                </ul>
                            </nav>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</section>
