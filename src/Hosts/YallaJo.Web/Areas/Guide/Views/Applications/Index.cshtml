@model YallaJo.Web.Areas.Guide.Models.Applications.ApplicationsVm
@{
    ViewData["Title"] = Localizer["Guide.Applications.Title"].Value;
    var culture = CultureInfo.CurrentUICulture;

    // Kept local: nullable input with "—" fallback and N2 precision differ from GuideFormat.Money (N3).
    string Money(decimal? amount, string currency = "JOD")
        => amount is null ? "—" : amount.Value.ToString("N2", culture) + " " + currency;

    // Kept local: "dd MMM yyyy" output differs from GuideFormat.Date (yyyy-MM-dd).
    string Date(DateTime d) => d.ToString("dd MMM yyyy", culture);
}

@await Component.InvokeAsync("GuideSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">
        <div>
            <h1 class="h4 mb-1"><i class="fa-solid fa-file-lines me-2" aria-hidden="true"></i>@Localizer["Guide.Applications.Heading"]</h1>
            <p class="text-body-secondary mb-0">@Localizer["Guide.Applications.Subtitle"]</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-5">
                <div class="card card-body border h-100">
                    <h2 class="card-header-title h5 mb-3"><i class="fa-solid fa-paper-plane me-2" aria-hidden="true"></i>@Localizer["Guide.Applications.ApplyHeading"]</h2>
                    <form asp-area="Guide" asp-controller="Applications" asp-action="Apply" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Form.TourId" class="form-label">@Localizer["Guide.Applications.TourId"]</label>
                            <input asp-for="Form.TourId" class="form-control font-data" dir="ltr" autocomplete="off"
                                   aria-describedby="apply-tour-help" placeholder="@Localizer["Guide.Applications.TourIdPlaceholder"]" />
                            <span asp-validation-for="Form.TourId" class="text-danger small" role="alert"></span>
                            <div id="apply-tour-help" class="form-text">@Localizer["Guide.Applications.TourIdHelp"]</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Form.Message" class="form-label">@Localizer["Guide.Applications.Message"]</label>
                            <textarea asp-for="Form.Message" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Form.Message" class="text-danger small" role="alert"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Form.RelevantExperience" class="form-label">@Localizer["Guide.Applications.Experience"]</label>
                            <textarea asp-for="Form.RelevantExperience" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Form.RelevantExperience" class="text-danger small" role="alert"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Form.ProposedBasePrice" class="form-label">@Localizer["Guide.Applications.ProposedPrice"]</label>
                            <input asp-for="Form.ProposedBasePrice" type="number" step="0.01" min="0" class="form-control" dir="ltr" />
                            <span asp-validation-for="Form.ProposedBasePrice" class="text-danger small" role="alert"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-paper-plane me-1" aria-hidden="true"></i>@Localizer["Guide.Applications.Submit"]
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card card-body border h-100">
                    <h2 class="card-header-title h5 mb-3"><i class="fa-solid fa-list-check me-2" aria-hidden="true"></i>@Localizer["Guide.Applications.MyApplications"]</h2>

                    @if (!Model.HasApplications)
                    {
                        <partial name="_GuideEmptyState" model='new EmptyStateVm(Localizer["Guide.Applications.NoApplications"].Value)' />
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">@Localizer["Guide.Applications.ColTour"]</th>
                                        <th scope="col">@Localizer["Guide.Applications.ColStatus"]</th>
                                        <th scope="col">@Localizer["Guide.Applications.ColPrice"]</th>
                                        <th scope="col">@Localizer["Guide.Applications.ColApplied"]</th>
                                        <th scope="col">@Localizer["Guide.Applications.ColReviewed"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var app in Model.Applications)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@app.TourTitle</div>
                                                @if (!string.IsNullOrWhiteSpace(app.Message))
                                                {
                                                    <div class="small text-body-secondary text-truncate yj-cell-truncate" title="@app.Message">@app.Message</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(app.RejectionReason))
                                                {
                                                    <div class="small text-danger"><i class="fa-solid fa-circle-exclamation me-1" aria-hidden="true"></i>@app.RejectionReason</div>
                                                }
                                            </td>
                                            <td><partial name="_GuideStatusBadge" model="new StatusBadgeVm(app.Status)" /></td>
                                            <td><bdi dir="ltr" class="font-data">@Money(app.ProposedBasePrice)</bdi></td>
                                            <td><bdi dir="ltr" class="font-data">@Date(app.CreatedAt)</bdi></td>
                                            <td>
                                                @if (app.ReviewedAt.HasValue)
                                                {
                                                    <bdi dir="ltr" class="font-data">@Date(app.ReviewedAt.Value)</bdi>
                                                }
                                                else
                                                {
                                                    <span class="text-body-secondary">&mdash;</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <partial name="_GuidePagination" model='new PaginationVm(Model.Page, Model.TotalPages, Model.HasPreviousPage, Model.HasNextPage, "Applications", Localizer["Guide.Applications.Pagination"].Value)' />
                    }
                </div>
            </div>
        </div>
    </div>
</section>
