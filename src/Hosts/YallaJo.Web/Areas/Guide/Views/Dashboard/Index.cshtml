@using YallaJo.Web.Areas.Guide.Models
@using YallaJo.Web.Areas.Guide.Shared
@model GuideDashboardVm
@{
    ViewData["Title"] = "Guide Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as GuideSidebarVm ?? new GuideSidebarVm();

    string Money(decimal amount, string? currency) =>
        string.IsNullOrWhiteSpace(currency) ? amount.ToString("N2") : $"{amount:N2} {currency}";
}

<partial name="_GuideSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">
        <h1 class="fs-4 mb-0"><i class="bi bi-house-door me-2"></i>Dashboard</h1>

        @if (!Model.IsGuide)
        {
            <div class="card card-body border text-center py-5">
                <img src="~/assets/images/element/17.svg" class="h-100px mb-3" alt="">
                <h5>You are not a registered guide yet</h5>
                <p class="text-body mb-0">Your guide profile is not active. Once a guide profile is created for your account, your tours, schedule and earnings will appear here.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="card card-body border">
                        <div class="d-flex align-items-center">
                            <div class="icon-xl bg-success bg-opacity-10 rounded-3 text-success"><i class="bi bi-signpost-2 fs-5"></i></div>
                            <div class="ms-3">
                                <h4 class="mb-0">@Model.TourCount</h4>
                                <span class="small">Assigned tours</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="card card-body border">
                        <div class="d-flex align-items-center">
                            <div class="icon-xl bg-warning bg-opacity-10 rounded-3 text-warning"><i class="bi bi-star fs-5"></i></div>
                            <div class="ms-3">
                                <h4 class="mb-0">@Model.AverageRating.ToString("0.0") <span class="small text-body">(@Model.ReviewCount)</span></h4>
                                <span class="small">Average rating</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="card card-body border">
                        <div class="d-flex align-items-center">
                            <div class="icon-xl bg-info bg-opacity-10 rounded-3 text-info"><i class="bi bi-graph-up-arrow fs-5"></i></div>
                            <div class="ms-3">
                                <h4 class="mb-0">@Money(Model.NetEarnings, Model.EarningsCurrency)</h4>
                                <span class="small">Net earnings</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="card card-body border">
                        <div class="d-flex align-items-center">
                            <div class="icon-xl bg-primary bg-opacity-10 rounded-3 text-primary"><i class="bi bi-hourglass-split fs-5"></i></div>
                            <div class="ms-3">
                                <h4 class="mb-0">@Money(Model.PendingPayout, Model.EarningsCurrency)</h4>
                                <span class="small">Pending payout</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border">
                <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="card-header-title mb-0">Recent tours</h5>
                    <a asp-area="Guide" asp-controller="MyTours" asp-action="Index" class="btn btn-sm btn-primary-soft mb-0">View all</a>
                </div>
                <div class="card-body">
                    @if (Model.RecentTours.Count == 0)
                    {
                        <div class="text-center py-4">
                            <img src="~/assets/images/element/17.svg" class="h-80px mb-2" alt="">
                            <p class="mb-0">No tours assigned to you yet.</p>
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-borderless">
                            @foreach (var tour in Model.RecentTours)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <div>
                                        <h6 class="mb-0">@tour.Title</h6>
                                        @if (tour.IsProposer)
                                        {
                                            <span class="small text-body">Proposed by you</span>
                                        }
                                    </div>
                                    <span class="badge text-bg-light">@(tour.OfferingStatus ?? "Assigned")</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        }
    </div>
</section>
