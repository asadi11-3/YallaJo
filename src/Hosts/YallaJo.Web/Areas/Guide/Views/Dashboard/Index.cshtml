@model YallaJo.Web.Areas.Guide.Models.Dashboard.DashboardVm
@using YallaJo.Web.Areas.Guide.Shared
@{
    ViewData["Title"] = "Guide Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as GuideSidebarVm ?? new GuideSidebarVm();
    string Money(decimal a, string? c) => string.IsNullOrWhiteSpace(c) ? a.ToString("N0") : $"{a:N0} {c}";
    string Pct(decimal v) => (v * 100m).ToString("0.#") + "%";
}

<partial name="_GuideSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">
        <h1 class="fs-4 mb-0"><i class="bi bi-house-door me-2"></i>Dashboard</h1>
        <div class="row g-4">
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1 text-body-secondary">Net Earnings</h6>
                            <h4 class="mb-0">@Money(Model.NetEarnings, Model.EarningsCurrency)</h4>
                        </div>
                        <div class="icon-xl bg-success-soft text-success rounded-circle">
                            <i class="bi bi-wallet2"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1 text-body-secondary">This Month</h6>
                            <h4 class="mb-0">@Money(Model.ThisMonth, Model.EarningsCurrency)</h4>
                        </div>
                        <div class="icon-xl bg-primary-soft text-primary rounded-circle">
                            <i class="bi bi-calendar-month"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1 text-body-secondary">Pending Payout</h6>
                            <h4 class="mb-0">@Money(Model.PendingPayout, Model.EarningsCurrency)</h4>
                        </div>
                        <div class="icon-xl bg-warning-soft text-warning rounded-circle">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1 text-body-secondary">Tours</h6>
                            <h4 class="mb-0">@Model.TourCount</h4>
                        </div>
                        <div class="icon-xl bg-info-soft text-info rounded-circle">
                            <i class="bi bi-map"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.TierProgress is { } tier)
        {
            <div class="card card-body border">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-award-fill text-warning fs-4"></i>
                        <h6 class="mb-0">Tier Progress</h6>
                        <span class="badge bg-primary-soft text-primary">@tier.CurrentTier</span>
                    </div>
                    <div class="text-body-secondary small">
                        Commission rate: <span class="fw-semibold text-body">@Pct(tier.CurrentCommissionRate)</span>
                        @if (tier.HasNextTier)
                        {
                            <span class="ms-2">Next tier: <span class="fw-semibold text-body">@tier.NextTier</span></span>
                        }
                    </div>
                </div>

                @if (!tier.HasNextTier)
                {
                    <p class="text-success mb-3"><i class="bi bi-check-circle-fill me-1"></i>You've reached the highest tier.</p>
                }

                <div class="row g-4">
                    <div class="col-md-6 col-xl-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-body-secondary">Completed Tours</span>
                            <span class="fw-semibold">@tier.CompletedTours / @tier.CompletedToursRequired</span>
                        </div>
                        <div class="progress" style="height: 6px;" role="progressbar" aria-valuenow="@tier.ToursPercent" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar bg-primary" style="width: @(tier.ToursPercent)%"></div>
                        </div>
                    </div>
                    <div class="col-md-6 col-xl-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-body-secondary">Average Rating</span>
                            <span class="fw-semibold">@tier.AverageRating.ToString("0.0") / @tier.AverageRatingRequired.ToString("0.0")</span>
                        </div>
                        <div class="progress" style="height: 6px;" role="progressbar" aria-valuenow="@tier.RatingPercent" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar bg-warning" style="width: @(tier.RatingPercent)%"></div>
                        </div>
                    </div>
                    <div class="col-md-6 col-xl-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-body-secondary">Active Months</span>
                            <span class="fw-semibold">@tier.ActiveMonths / @tier.ActiveMonthsRequired</span>
                        </div>
                        <div class="progress" style="height: 6px;" role="progressbar" aria-valuenow="@tier.ActiveMonthsPercent" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar bg-info" style="width: @(tier.ActiveMonthsPercent)%"></div>
                        </div>
                    </div>
                    <div class="col-md-6 col-xl-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-body-secondary">Report Rate</span>
                            <span class="fw-semibold @(tier.ReportRateOk ? "text-success" : "text-danger")">@Pct(tier.ReportRate) / @Pct(tier.MaxReportRateAllowed)</span>
                        </div>
                        <div class="progress" style="height: 6px;" role="progressbar" aria-valuenow="@tier.ReportRatePercent" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar @(tier.ReportRateOk ? "bg-success" : "bg-danger")" style="width: @(tier.ReportRatePercent)%"></div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row g-4">
            <div class="col-xl-4">
                <div class="card card-body border h-100">
                    <h6 class="mb-3">Profile</h6>
                    <ul class="list-unstyled mb-0 vstack gap-2">
                        <li class="d-flex justify-content-between">
                            <span class="text-body-secondary">Rating</span>
                            <span><i class="bi bi-star-fill text-warning me-1"></i>@Model.AverageRating.ToString("0.0") (@Model.ReviewCount)</span>
                        </li>
                        <li class="d-flex justify-content-between">
                            <span class="text-body-secondary">Experience</span>
                            <span>@Model.YearsOfExperience yrs</span>
                        </li>
                        <li class="d-flex justify-content-between">
                            <span class="text-body-secondary">First Aid</span>
                            <span>@(Model.HasFirstAid ? "Yes" : "No")</span>
                        </li>
                        <li class="d-flex justify-content-between">
                            <span class="text-body-secondary">Active Availability Blocks</span>
                            <span>@Model.ActiveAvailabilityBlocks</span>
                        </li>
                    </ul>
                    <a asp-area="Guide" asp-controller="Profile" asp-action="Index" class="btn btn-sm btn-primary-soft mt-3">
                        <i class="bi bi-pencil me-1"></i>Edit Profile
                    </a>
                </div>
            </div>

            <div class="col-xl-8">
                <div class="card card-body border h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="mb-0">Recent Tours</h6>
                        <a asp-area="Guide" asp-controller="MyTours" asp-action="Index" class="btn btn-sm btn-link">View all</a>
                    </div>
                    @if (Model.RecentTours.Count == 0)
                    {
                        <div class="text-center text-body-secondary py-4">
                            <i class="bi bi-map fs-1 d-block mb-2"></i>
                            No tours yet.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Tour</th>
                                        <th>Offering</th>
                                        <th>Private</th>
                                        <th>Assigned</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in Model.RecentTours)
                                    {
                                        <tr>
                                            <td>@t.Title</td>
                                            <td>@(string.IsNullOrWhiteSpace(t.OfferingStatus) ? "-" : t.OfferingStatus)</td>
                                            <td>@(t.OffersPrivateTour ? "Yes" : "No")</td>
                                            <td>@(t.AssignedAt?.ToString("yyyy-MM-dd") ?? "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
