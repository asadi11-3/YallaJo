@model YallaJo.Web.Areas.Guide.Models.Dashboard.DashboardVm
@{
    ViewData["Title"] = Localizer["Guide.Dashboard.Title"].Value;
}

@await Component.InvokeAsync("GuideSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">
        <h1 class="fs-4 mb-0"><i class="fa-solid fa-house me-2" aria-hidden="true"></i>@Localizer["Guide.Dashboard.Heading"]</h1>

        <div class="row g-4">
            <div class="col-sm-6 col-xl-3">
                <partial name="_GuideStatCard" model='new StatCardVm(Localizer["Guide.Dashboard.NetEarnings"].Value, GuideFormat.Money(Model.NetEarnings, Model.EarningsCurrency), "wallet", "success")' />
            </div>
            <div class="col-sm-6 col-xl-3">
                <partial name="_GuideStatCard" model='new StatCardVm(Localizer["Guide.Dashboard.ThisMonth"].Value, GuideFormat.Money(Model.ThisMonth, Model.EarningsCurrency), "calendar-day", "primary")' />
            </div>
            <div class="col-sm-6 col-xl-3">
                <partial name="_GuideStatCard" model='new StatCardVm(Localizer["Guide.Dashboard.PendingPayout"].Value, GuideFormat.Money(Model.PendingPayout, Model.EarningsCurrency), "hourglass-half", "warning")' />
            </div>
            <div class="col-sm-6 col-xl-3">
                <partial name="_GuideStatCard" model='new StatCardVm(Localizer["Guide.Dashboard.Tours"].Value, GuideFormat.Count(Model.TourCount), "map", "info")' />
            </div>
        </div>

        @if (Model.TierProgress is not null)
        {
            @* Anchor target for the retired /guide/tier page (301 -> /guide/dashboard#tier). *@
            <div id="tier">
                <partial name="_TierProgress" model="Model.TierProgress" />
            </div>
        }

        <div class="row g-4">
            <div class="col-xl-4">
                <div class="card card-body border h-100">
                    <h2 class="h6 mb-3">@Localizer["Guide.Dashboard.Profile"]</h2>
                    <ul class="list-unstyled mb-0 vstack gap-2">
                        <li class="d-flex justify-content-between">
                            <span class="text-body-secondary">@Localizer["Guide.Dashboard.Rating"]</span>
                            <span><i class="fa-solid fa-star text-warning me-1" aria-hidden="true"></i><bdi dir="ltr">@GuideFormat.Rating(Model.AverageRating) (@GuideFormat.Count(Model.ReviewCount))</bdi></span>
                        </li>
                        <li class="d-flex justify-content-between">
                            <span class="text-body-secondary">@Localizer["Guide.Dashboard.Experience"]</span>
                            <span><bdi dir="ltr">@Localizer["Guide.Dashboard.Years", Model.YearsOfExperience]</bdi></span>
                        </li>
                        <li class="d-flex justify-content-between">
                            <span class="text-body-secondary">@Localizer["Guide.Dashboard.FirstAid"]</span>
                            <span>@(Model.HasFirstAid ? Localizer["Guide.Common.Yes"] : Localizer["Guide.Common.No"])</span>
                        </li>
                        <li class="d-flex justify-content-between">
                            <span class="text-body-secondary">@Localizer["Guide.Dashboard.ActiveBlocks"]</span>
                            <span class="font-data"><bdi dir="ltr">@GuideFormat.Count(Model.ActiveAvailabilityBlocks)</bdi></span>
                        </li>
                    </ul>
                    <a asp-area="Guide" asp-controller="Profile" asp-action="Index" class="btn btn-sm btn-primary-soft mt-3">
                        <i class="fa-solid fa-pen me-1" aria-hidden="true"></i>@Localizer["Guide.Dashboard.EditProfile"]
                    </a>
                </div>
            </div>

            <div class="col-xl-8">
                <div class="card card-body border h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h6 mb-0">@Localizer["Guide.Dashboard.RecentTours"]</h2>
                        <a asp-area="Guide" asp-controller="MyTours" asp-action="Index" class="btn btn-sm btn-link">@Localizer["Guide.Dashboard.ViewAll"]</a>
                    </div>
                    @if (Model.RecentTours.Count == 0)
                    {
                        <partial name="_GuideEmptyState" model='new EmptyStateVm(Localizer["Guide.Dashboard.NoTours"].Value, Localizer["Guide.Dashboard.FindTours"].Value, Url.Action("Index", "Applications", new { area = "Guide" }))' />
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">@Localizer["Guide.Dashboard.ColTour"]</th>
                                        <th scope="col">@Localizer["Guide.Dashboard.ColOffering"]</th>
                                        <th scope="col">@Localizer["Guide.Dashboard.ColPrivate"]</th>
                                        <th scope="col">@Localizer["Guide.Dashboard.ColAssigned"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in Model.RecentTours)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@t.Title</td>
                                            <td>
                                                @if (string.IsNullOrWhiteSpace(t.OfferingStatus))
                                                {
                                                    <span class="text-body-secondary">&mdash;</span>
                                                }
                                                else
                                                {
                                                    <partial name="_GuideStatusBadge" model="new StatusBadgeVm(t.OfferingStatus)" />
                                                }
                                            </td>
                                            <td>@(t.OffersPrivateTour ? Localizer["Guide.Common.Yes"] : Localizer["Guide.Common.No"])</td>
                                            <td>
                                                @if (t.AssignedAt.HasValue)
                                                {
                                                    <bdi dir="ltr" class="font-data">@GuideFormat.Date(t.AssignedAt.Value)</bdi>
                                                }
                                                else
                                                {
                                                    <span class="text-body-secondary">&mdash;</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
