@model YallaJo.Web.Areas.Guide.Models.GuideScheduleVm
@using YallaJo.Web.Areas.Guide.Shared
@{
    ViewData["Title"] = "Schedule";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as GuideSidebarVm ?? new GuideSidebarVm();
}

<partial name="_GuideSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">
        <h1 class="fs-4 mb-0"><i class="bi bi-calendar-week me-2"></i>Schedule</h1>

        @if (!Model.IsGuide)
        {
            <div class="card border">
                <div class="card-body text-center py-5">
                    <img src="~/assets/images/element/17.svg" class="h-100px mb-3" alt="" />
                    <h5 class="mb-1">You are not a registered guide yet</h5>
                    <p class="text-secondary mb-0">Manage your unavailable dates here once you become a guide.</p>
                </div>
            </div>
        }
        else
        {
            <div class="card border">
                <div class="card-header border-bottom">
                    <h5 class="card-header-title mb-0">Block unavailable dates</h5>
                    <p class="small text-secondary mb-0">Add date ranges where you are not available to guide tours.</p>
                </div>
                <div class="card-body">
                    <form method="post" asp-area="Guide" asp-controller="Schedule" asp-action="Add" class="row g-3 align-items-end">
                        @Html.AntiForgeryToken()
                        <div class="col-md-3">
                            <label class="form-label" asp-for="NewBlock.StartDate"></label>
                            <input class="form-control" type="date" asp-for="NewBlock.StartDate" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" asp-for="NewBlock.EndDate"></label>
                            <input class="form-control" type="date" asp-for="NewBlock.EndDate" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" asp-for="NewBlock.Reason"></label>
                            <input class="form-control" asp-for="NewBlock.Reason" placeholder="e.g. Vacation" />
                        </div>
                        <div class="col-md-2 d-grid">
                            <button type="submit" class="btn btn-primary-soft"><i class="bi bi-plus-lg me-1"></i>Add block</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card border">
                <div class="card-header border-bottom">
                    <h5 class="card-header-title mb-0">Unavailable dates</h5>
                </div>
                <div class="card-body">
                    @if (!Model.HasBlocks)
                    {
                        <div class="text-center py-4">
                            <img src="~/assets/images/element/17.svg" class="h-80px mb-3" alt="" />
                            <p class="text-secondary mb-0">No unavailable dates set. You are available for all dates.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col">Dates</th>
                                        <th scope="col">Reason</th>
                                        <th scope="col">Added</th>
                                        <th scope="col" class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var block in Model.Blocks)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@block.StartDate.ToString("d MMM yyyy") &ndash; @block.EndDate.ToString("d MMM yyyy")</td>
                                            <td>@(string.IsNullOrWhiteSpace(block.Reason) ? "—" : block.Reason)</td>
                                            <td class="small text-secondary">@block.CreatedAt.ToString("d MMM yyyy")</td>
                                            <td class="text-end">
                                                <form method="post" asp-area="Guide" asp-controller="Schedule" asp-action="Delete" asp-route-id="@block.Id"
                                                      onsubmit="return confirm('Remove this unavailable block?');" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-danger-soft"><i class="bi bi-trash me-1"></i>Remove</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>
