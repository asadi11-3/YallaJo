@model YallaJo.Web.Areas.Guide.Models.MyTours.OfferingDetailVm
@using YallaJo.Web.Areas.Guide.Models.MyTours
@{
    ViewData["Title"] = Localizer["Guide.Offering.Title"].Value;
}

@await Component.InvokeAsync("GuideSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <a class="btn btn-sm btn-link px-0 text-body-secondary"
                   asp-area="Guide" asp-controller="MyTours" asp-action="Index">
                    <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i>@Localizer["Guide.Offering.Back"]
                </a>
                <h1 class="h4 mb-0"><i class="fa-solid fa-gear me-2" aria-hidden="true"></i>@Localizer["Guide.Offering.Heading"]</h1>
                <p class="text-body-secondary mb-0">
                    @Localizer["Guide.Offering.StatusLabel"]
                    <partial name="_GuideStatusBadge" model="new StatusBadgeVm(Model.Status)" />
                    @if (Model.IsProposer)
                    {
                        <span class="badge bg-primary bg-opacity-10 text-primary ms-1">
                            <i class="fa-solid fa-lightbulb fa-fw" aria-hidden="true"></i> @Localizer["Guide.Offering.Proposer"]
                        </span>
                    }
                </p>
            </div>
        </div>

        @* Schedules — swappable AJAX fragment (PE1: full PRG without JS, provider-actions.js enhances) *@
        <partial name="_OfferingSchedules" model="Model" />

        @* Pricing tiers — swappable AJAX fragment *@
        <partial name="_OfferingPricingTiers" model="Model" />

        @* Private tour — swappable AJAX fragment *@
        <partial name="_OfferingPrivateTour" model="Model" />

        @* Danger zone — remove the whole offering from this tour (full PRG: success leaves this page for Index) *@
        <permission require="@WebPermission.GuideOffering.Delete">
            <div class="card border border-danger-subtle">
                <div class="card-header border-bottom bg-transparent">
                    <h2 class="card-header-title h5 mb-0 text-danger"><i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>@Localizer["Guide.Offering.RemoveHeading"]</h2>
                </div>
                <div class="card-body d-sm-flex justify-content-between align-items-center gap-3">
                    <p class="small text-body-secondary mb-2 mb-sm-0">@Localizer["Guide.Offering.RemoveMsg"]</p>
                    <form method="post" class="flex-shrink-0" data-loading
                          asp-area="Guide" asp-controller="MyTours" asp-action="RemoveOffering"
                          asp-route-tourId="@Model.TourId"
                          data-confirm='@Localizer["Guide.Offering.RemoveModalBody"]'
                          data-confirm-title='@Localizer["Guide.Offering.RemoveModalTitle"]'
                          data-confirm-cancel='@Localizer["Guide.Common.Cancel"]'
                          data-confirm-action='@Localizer["Guide.Offering.RemoveConfirm"]'>
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="fa-solid fa-circle-xmark me-1" aria-hidden="true"></i>@Localizer["Guide.Offering.RemoveOffering"]
                        </button>
                    </form>
                </div>
            </div>
        </permission>
    </div>
</section>

@section Scripts {
    <script src="~/assets/js/provider-actions.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
}
