@model YallaJo.Web.Areas.Guide.Models.MyTours.MyToursVm
@using YallaJo.Web.Areas.Guide.Shared
@{
    ViewData["Title"] = "My Tours";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as GuideSidebarVm ?? new GuideSidebarVm();
}

<partial name="_GuideSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h4 mb-0">My Tours</h1>
                <p class="text-secondary mb-0">Tours you run and their guide offerings.</p>
            </div>
        </div>

        @if (!Model.HasTours)
        {
            <div class="card card-body border text-center py-5">
                <i class="bi bi-map fs-1 text-secondary"></i>
                <h2 class="h5 mt-3">No tours yet</h2>
                <p class="text-secondary mb-0">Once you are assigned to or propose a tour, it will appear here.</p>
            </div>
        }
        else
        {
            <div class="card border">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Tour</th>
                                <th scope="col">Role</th>
                                <th scope="col">Offering</th>
                                <th scope="col">Private tour</th>
                                <th scope="col">Assigned</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tour in Model.Tours)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">@tour.Title</span>
                                        @if (!string.IsNullOrWhiteSpace(tour.Slug))
                                        {
                                            <div class="text-secondary small">@tour.Slug</div>
                                        }
                                    </td>
                                    <td>
                                        @if (tour.IsProposer)
                                        {
                                            <span class="badge bg-primary-soft text-primary">Proposer</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-soft text-secondary">Assigned</span>
                                        }
                                    </td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(tour.OfferingStatus))
                                        {
                                            <span class="text-secondary">&mdash;</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-soft text-info">@tour.OfferingStatus</span>
                                        }
                                    </td>
                                    <td>
                                        @if (tour.OffersPrivateTour)
                                        {
                                            <i class="bi bi-check-circle-fill text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-dash-circle text-secondary"></i>
                                        }
                                    </td>
                                    <td>
                                        @(tour.AssignedAt.HasValue ? tour.AssignedAt.Value.ToString("yyyy-MM-dd") : "—")
                                    </td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-primary-soft"
                                           asp-area="Guide" asp-controller="MyTours" asp-action="Offering"
                                           asp-route-tourId="@tour.TourId">
                                            <i class="bi bi-gear me-1"></i>Manage offering
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Tours pagination">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-area="Guide" asp-controller="MyTours" asp-action="Index"
                               asp-route-page="@(Model.Page - 1)">Previous</a>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">Page @Model.Page of @Model.TotalPages</span>
                        </li>
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-area="Guide" asp-controller="MyTours" asp-action="Index"
                               asp-route-page="@(Model.Page + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</section>
