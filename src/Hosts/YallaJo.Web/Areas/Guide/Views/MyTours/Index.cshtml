@model YallaJo.Web.Areas.Guide.Models.MyTours.MyToursVm
@{
    ViewData["Title"] = Localizer["Guide.MyTours.Title"].Value;
}

@await Component.InvokeAsync("GuideSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h1 class="h4 mb-0"><i class="fa-solid fa-map me-2" aria-hidden="true"></i>@Localizer["Guide.MyTours.Heading"]</h1>
                <p class="text-body-secondary mb-0">@Localizer["Guide.MyTours.Subtitle"]</p>
            </div>
        </div>

        @* Phase 4: results fragment swapped via AJAX by listing.js; plain markup without JS (PE1). *@
        <div id="listingResults" data-yj-component="listing" aria-live="polite" aria-busy="false"
             data-error-text="@Localizer["Public.Results.Error"]" data-retry-text="@Localizer["Public.Retry"]" data-loading-text="@Localizer["Public.Loading"]">
            <partial name="_MyToursResults" model="Model" />
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/assets/js/listing.js" asp-append-version="true"></script>
}
