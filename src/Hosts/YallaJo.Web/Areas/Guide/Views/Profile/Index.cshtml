@model YallaJo.Web.Areas.Guide.Models.Profile.ProfileVm
@{
    ViewData["Title"] = Localizer["Guide.Profile.Title"].Value;
}

@await Component.InvokeAsync("GuideSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">

        <div class="d-flex align-items-center justify-content-between">
            <h1 class="h4 mb-0"><i class="fa-solid fa-id-badge me-2" aria-hidden="true"></i>@Localizer["Guide.Profile.Heading"]</h1>
        </div>

        @* Header / images *@
        <div class="card card-body border">
            <div class="row g-4 align-items-center">
                <div class="col-auto">
                    @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" class="rounded-circle yj-avatar-96" width="96" height="96" alt="@Model.DisplayName" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-primary-soft d-flex align-items-center justify-content-center yj-avatar-96">
                            <i class="fa-solid fa-user fs-1 text-primary" aria-hidden="true"></i>
                        </div>
                    }
                </div>
                <div class="col">
                    <h2 class="h5 mb-1">@Model.DisplayName</h2>
                    <div class="hstack gap-3 text-body-secondary small">
                        <span><i class="fa-solid fa-star text-warning me-1" aria-hidden="true"></i><bdi dir="ltr">@GuideFormat.Rating(Model.AverageRating) (@GuideFormat.Count(Model.ReviewCount))</bdi></span>
                        <span><i class="fa-solid fa-map me-1" aria-hidden="true"></i><bdi dir="ltr">@Localizer["Guide.Profile.ToursCount", GuideFormat.Count(Model.TourCount)]</bdi></span>
                    </div>
                </div>
                <div class="col-12 col-md-auto">
                    <div class="row g-2">
                        <div class="col">
                            <form asp-area="Guide" asp-controller="Profile" asp-action="UploadAvatar" method="post" enctype="multipart/form-data" class="hstack gap-2">
                                @Html.AntiForgeryToken()
                                <label for="avatar-file" class="visually-hidden">@Localizer["Guide.Profile.AvatarUpload"]</label>
                                <input id="avatar-file" type="file" name="file" accept="image/*" class="form-control form-control-sm" required />
                                <button type="submit" class="btn btn-sm btn-primary-soft text-nowrap">@Localizer["Guide.Profile.Avatar"]</button>
                            </form>
                        </div>
                        <div class="col">
                            <form asp-area="Guide" asp-controller="Profile" asp-action="UploadCover" method="post" enctype="multipart/form-data" class="hstack gap-2">
                                @Html.AntiForgeryToken()
                                <label for="cover-file" class="visually-hidden">@Localizer["Guide.Profile.CoverUpload"]</label>
                                <input id="cover-file" type="file" name="file" accept="image/*" class="form-control form-control-sm" required />
                                <button type="submit" class="btn btn-sm btn-primary-soft text-nowrap">@Localizer["Guide.Profile.Cover"]</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Core fields *@
        <div class="card card-body border">
            <h2 class="h6 mb-3">@Localizer["Guide.Profile.Details"]</h2>
            <form asp-area="Guide" asp-controller="Profile" asp-action="Update" method="post" class="vstack gap-3">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small" role="alert"></div>

                <div>
                    <label asp-for="Form.Bio" class="form-label">@Localizer["Guide.Profile.Bio"]</label>
                    <textarea asp-for="Form.Bio" class="form-control" rows="4" aria-describedby="bio-help" placeholder="@Localizer["Guide.Profile.BioPlaceholder"]"></textarea>
                    <div id="bio-help" class="form-text">@Localizer["Guide.Profile.BioHelp"]</div>
                    <span asp-validation-for="Form.Bio" class="text-danger small" role="alert"></span>
                </div>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <label asp-for="Form.YearsOfExperience" class="form-label">@Localizer["Guide.Profile.YearsLabel"]</label>
                        <input asp-for="Form.YearsOfExperience" class="form-control" type="number" min="0" max="80" dir="ltr" />
                        <span asp-validation-for="Form.YearsOfExperience" class="text-danger small" role="alert"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Form.MoTALicenseNumber" class="form-label">@Localizer["Guide.Profile.LicenseLabel"]</label>
                        <input asp-for="Form.MoTALicenseNumber" class="form-control" dir="ltr" />
                        <span asp-validation-for="Form.MoTALicenseNumber" class="text-danger small" role="alert"></span>
                    </div>
                </div>

                <div class="form-check">
                    <input asp-for="Form.HasFirstAid" class="form-check-input" type="checkbox" />
                    <label asp-for="Form.HasFirstAid" class="form-check-label">@Localizer["Guide.Profile.FirstAidLabel"]</label>
                </div>

                <div>
                    <button type="submit" class="btn btn-primary">@Localizer["Guide.Profile.SaveChanges"]</button>
                </div>
            </form>
        </div>

        @* Languages *@
        <div class="card card-body border">
            <h2 class="h6 mb-3">@Localizer["Guide.Profile.Languages"]</h2>

            @if (Model.Languages.Count == 0)
            {
                <p class="text-body-secondary small mb-3">@Localizer["Guide.Profile.NoLanguages"]</p>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var lang in Model.Languages)
                    {
                        <span class="badge bg-primary-soft text-primary d-inline-flex align-items-center gap-2 py-2">
                            @lang.Name@(string.IsNullOrWhiteSpace(lang.Proficiency) ? "" : $" · {lang.Proficiency}")
                            <form asp-area="Guide" asp-controller="Profile" asp-action="RemoveLanguage" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="languageId" value="@lang.LanguageId" />
                                <button type="submit" class="btn btn-sm btn-link p-0 text-danger lh-1" title="@Localizer["Guide.Profile.Remove"]" aria-label="@Localizer["Guide.Profile.RemoveLanguageLabel", lang.Name]">
                                    <i class="fa-solid fa-circle-xmark" aria-hidden="true"></i>
                                </button>
                            </form>
                        </span>
                    }
                </div>
            }

            @if (Model.AvailableLanguages.Count > 0)
            {
                <form asp-area="Guide" asp-controller="Profile" asp-action="AddLanguage" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-sm-5">
                        <label for="add-language" class="form-label">@Localizer["Guide.Profile.Language"]</label>
                        <select id="add-language" name="languageId" class="form-select" required>
                            <option value="">@Localizer["Guide.Profile.SelectLanguage"]</option>
                            @foreach (var opt in Model.AvailableLanguages)
                            {
                                <option value="@opt.Id">@opt.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-4">
                        <label for="add-proficiency" class="form-label">@Localizer["Guide.Profile.Proficiency"]</label>
                        <select id="add-proficiency" name="proficiency" class="form-select" required>
                            @foreach (var p in YallaJo.Web.Areas.Guide.Models.Profile.ProfileVm.ProficiencyOptions)
                            {
                                <option value="@p">@Localizer["Guide.Profile.Proficiency." + p]</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <button type="submit" class="btn btn-primary-soft w-100">@Localizer["Guide.Profile.AddLanguage"]</button>
                    </div>
                </form>
            }
        </div>

        @* Specializations *@
        <div class="card card-body border">
            <h2 class="h6 mb-3">@Localizer["Guide.Profile.Specializations"]</h2>

            @if (Model.Specializations.Count == 0)
            {
                <p class="text-body-secondary small mb-3">@Localizer["Guide.Profile.NoSpecializations"]</p>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var spec in Model.Specializations)
                    {
                        <span class="badge bg-info-soft text-info py-2">
                            @if (!string.IsNullOrWhiteSpace(spec.Icon))
                            {
                                <i class="fa-solid @spec.Icon me-1" aria-hidden="true"></i>
                            }
                            @spec.Name
                        </span>
                    }
                </div>
            }

            @if (Model.AvailableSpecializations.Count > 0)
            {
                <form asp-area="Guide" asp-controller="Profile" asp-action="AddSpecialization" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-sm-9">
                        <label for="add-specialization" class="form-label">@Localizer["Guide.Profile.Specialization"]</label>
                        <select id="add-specialization" name="specializationId" class="form-select" required>
                            <option value="">@Localizer["Guide.Profile.SelectSpecialization"]</option>
                            @foreach (var opt in Model.AvailableSpecializations)
                            {
                                <option value="@opt.Id">@opt.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <button type="submit" class="btn btn-primary-soft w-100">@Localizer["Guide.Profile.Add"]</button>
                    </div>
                </form>
            }
        </div>

        @* Danger zone — self-deactivate the guide profile (DELETE /guides/me). *@
        <permission require="@WebPermission.TourGuideProfile.DeleteOwn">
            <div class="card border border-danger-subtle">
                <div class="card-header border-bottom">
                    <h2 class="h6 mb-0 text-danger"><i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>@Localizer["Guide.Profile.DeactivateHeading"]</h2>
                </div>
                <div class="card-body d-sm-flex justify-content-between align-items-center gap-3">
                    <p class="small text-body-secondary mb-2 mb-sm-0">@Localizer["Guide.Profile.DeactivateMsg"]</p>
                    <button type="button" class="btn btn-outline-danger flex-shrink-0" data-bs-toggle="modal" data-bs-target="#deactivateProfileModal">
                        <i class="fa-solid fa-user-xmark me-1" aria-hidden="true"></i>@Localizer["Guide.Profile.Deactivate"]
                    </button>
                </div>
            </div>

            <div class="modal fade" id="deactivateProfileModal" tabindex="-1" aria-labelledby="deactivateProfileTitle" aria-describedby="deactivateProfileBody" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                <div class="modal-dialog modal-dialog-centered">
                    <form asp-area="Guide" asp-controller="Profile" asp-action="Deactivate" method="post" class="modal-content" role="dialog" aria-modal="true" aria-labelledby="deactivateProfileTitle">
                        @Html.AntiForgeryToken()
                        <div class="modal-header bg-danger text-white">
                            <h2 class="modal-title h5" id="deactivateProfileTitle">@Localizer["Guide.Profile.DeactivateModalTitle"]</h2>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@Localizer["Guide.Common.Close"]"></button>
                        </div>
                        <div class="modal-body" id="deactivateProfileBody">
                            <p class="mb-0">@Localizer["Guide.Profile.DeactivateModalBody"]</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Guide.Common.Cancel"]</button>
                            <button type="submit" class="btn btn-danger">@Localizer["Guide.Profile.DeactivateConfirm"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </permission>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
