@model YallaJo.Web.Areas.Guide.Models.Profile.ProfileVm
@using YallaJo.Web.Areas.Guide.Shared
@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as GuideSidebarVm ?? new GuideSidebarVm();
}

<partial name="_GuideSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">

        <div class="d-flex align-items-center justify-content-between">
            <h1 class="h4 mb-0">My Profile</h1>
        </div>

        <!-- Header / images -->
        <div class="card card-body border">
            <div class="row g-4 align-items-center">
                <div class="col-auto">
                    @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" class="rounded-circle" width="96" height="96" alt="Avatar" style="object-fit:cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-primary-soft d-flex align-items-center justify-content-center" style="width:96px;height:96px;">
                            <i class="bi bi-person fs-1 text-primary"></i>
                        </div>
                    }
                </div>
                <div class="col">
                    <h2 class="h5 mb-1">@Model.DisplayName</h2>
                    <div class="hstack gap-3 text-secondary small">
                        <span><i class="bi bi-star-fill text-warning me-1"></i>@Model.AverageRating.ToString("0.0") (@Model.ReviewCount)</span>
                        <span><i class="bi bi-map me-1"></i>@Model.TourCount tours</span>
                    </div>
                </div>
                <div class="col-12 col-md-auto">
                    <div class="row g-2">
                        <div class="col">
                            <form asp-area="Guide" asp-controller="Profile" asp-action="UploadAvatar" method="post" enctype="multipart/form-data" class="hstack gap-2">
                                @Html.AntiForgeryToken()
                                <input type="file" name="file" accept="image/*" class="form-control form-control-sm" required />
                                <button type="submit" class="btn btn-sm btn-primary-soft text-nowrap">Avatar</button>
                            </form>
                        </div>
                        <div class="col">
                            <form asp-area="Guide" asp-controller="Profile" asp-action="UploadCover" method="post" enctype="multipart/form-data" class="hstack gap-2">
                                @Html.AntiForgeryToken()
                                <input type="file" name="file" accept="image/*" class="form-control form-control-sm" required />
                                <button type="submit" class="btn btn-sm btn-primary-soft text-nowrap">Cover</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Core fields -->
        <div class="card card-body border">
            <h3 class="h6 mb-3">Details</h3>
            <form asp-area="Guide" asp-controller="Profile" asp-action="Update" method="post" class="vstack gap-3">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                <div>
                    <label asp-for="Form.Bio" class="form-label">Bio</label>
                    <textarea asp-for="Form.Bio" class="form-control" rows="4" placeholder="Tell travellers about yourself..."></textarea>
                    <span asp-validation-for="Form.Bio" class="text-danger small"></span>
                </div>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <label asp-for="Form.YearsOfExperience" class="form-label"></label>
                        <input asp-for="Form.YearsOfExperience" class="form-control" type="number" min="0" max="80" />
                        <span asp-validation-for="Form.YearsOfExperience" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Form.MoTALicenseNumber" class="form-label"></label>
                        <input asp-for="Form.MoTALicenseNumber" class="form-control" />
                        <span asp-validation-for="Form.MoTALicenseNumber" class="text-danger small"></span>
                    </div>
                </div>

                <div class="form-check">
                    <input asp-for="Form.HasFirstAid" class="form-check-input" type="checkbox" />
                    <label asp-for="Form.HasFirstAid" class="form-check-label"></label>
                </div>

                <div>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </form>
        </div>

        <!-- Languages -->
        <div class="card card-body border">
            <h3 class="h6 mb-3">Languages</h3>

            @if (Model.Languages.Count == 0)
            {
                <p class="text-secondary small mb-3">No languages added yet.</p>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var lang in Model.Languages)
                    {
                        <span class="badge bg-primary-soft text-primary d-inline-flex align-items-center gap-2 py-2">
                            @lang.Name@(string.IsNullOrWhiteSpace(lang.Proficiency) ? "" : $" · {lang.Proficiency}")
                            <form asp-area="Guide" asp-controller="Profile" asp-action="RemoveLanguage" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="languageId" value="@lang.LanguageId" />
                                <button type="submit" class="btn btn-sm btn-link p-0 text-danger lh-1" title="Remove">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </form>
                        </span>
                    }
                </div>
            }

            @if (Model.AvailableLanguages.Count > 0)
            {
                <form asp-area="Guide" asp-controller="Profile" asp-action="AddLanguage" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-sm-5">
                        <label class="form-label">Language</label>
                        <select name="languageId" class="form-select" required>
                            <option value="">Select a language…</option>
                            @foreach (var opt in Model.AvailableLanguages)
                            {
                                <option value="@opt.Id">@opt.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label">Proficiency</label>
                        <select name="proficiency" class="form-select" required>
                            @foreach (var p in YallaJo.Web.Areas.Guide.Models.Profile.ProfileVm.ProficiencyOptions)
                            {
                                <option value="@p">@p</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <button type="submit" class="btn btn-primary-soft w-100">Add language</button>
                    </div>
                </form>
            }
        </div>

        <!-- Specializations -->
        <div class="card card-body border">
            <h3 class="h6 mb-3">Specializations</h3>

            @if (Model.Specializations.Count == 0)
            {
                <p class="text-secondary small mb-3">No specializations added yet.</p>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var spec in Model.Specializations)
                    {
                        <span class="badge bg-info-soft text-info py-2">
                            @if (!string.IsNullOrWhiteSpace(spec.Icon))
                            {
                                <i class="bi @spec.Icon me-1"></i>
                            }
                            @spec.Name
                        </span>
                    }
                </div>
            }

            @if (Model.AvailableSpecializations.Count > 0)
            {
                <form asp-area="Guide" asp-controller="Profile" asp-action="AddSpecialization" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-sm-9">
                        <label class="form-label">Specialization</label>
                        <select name="specializationId" class="form-select" required>
                            <option value="">Select a specialization…</option>
                            @foreach (var opt in Model.AvailableSpecializations)
                            {
                                <option value="@opt.Id">@opt.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <button type="submit" class="btn btn-primary-soft w-100">Add</button>
                    </div>
                </form>
            }
        </div>

        @* Danger zone — self-deactivate the guide profile (DELETE /guides/me). *@
        <div class="card border border-danger-subtle">
            <div class="card-header border-bottom">
                <h2 class="h6 mb-0 text-danger"><i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>Deactivate profile</h2>
            </div>
            <div class="card-body d-sm-flex justify-content-between align-items-center gap-3">
                <p class="small text-body-secondary mb-2 mb-sm-0">
                    Deactivating hides your guide profile and removes you from public listings. You can re-apply later.
                </p>
                <form asp-area="Guide" asp-controller="Profile" asp-action="Deactivate" method="post" class="flex-shrink-0"
                      onsubmit="return confirm('Deactivate your guide profile? You will be removed from public listings.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger"><i class="bi bi-person-x me-1" aria-hidden="true"></i>Deactivate</button>
                </form>
            </div>
        </div>

    </div>
</section>
