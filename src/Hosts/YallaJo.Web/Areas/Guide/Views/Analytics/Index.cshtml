@model YallaJo.Web.Areas.Guide.Models.Analytics.AnalyticsVm
@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Guide.Shared
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Guide.Analytics.Title"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as GuideSidebarVm ?? new GuideSidebarVm();
    var culture = CultureInfo.CurrentUICulture;
    string Count(int n) => n.ToString("N0", culture);
    string Pct(decimal value) => value.ToString("N1", culture) + "%";
    int Bar(int value, int max) => max <= 0 ? 0 : (int)Math.Round(value * 100.0 / max);
}

<partial name="_GuideSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h1 class="h4 mb-0"><i class="fa-solid fa-chart-column me-2" aria-hidden="true"></i>@Localizer["Guide.Analytics.Heading"]</h1>
                <p class="text-body-secondary mb-0">@Localizer["Guide.Analytics.Subtitle"]</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h6 mb-1 text-body-secondary">@Localizer["Guide.Analytics.TotalBookings"]</h2>
                            <p class="h4 mb-0 font-data"><bdi dir="ltr">@Count(Model.TotalBookings)</bdi></p>
                        </div>
                        <div class="icon-xl bg-primary-soft text-primary rounded-circle">
                            <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h6 mb-1 text-body-secondary">@Localizer["Guide.Analytics.Upcoming"]</h2>
                            <p class="h4 mb-0 font-data"><bdi dir="ltr">@Count(Model.UpcomingBookings)</bdi></p>
                        </div>
                        <div class="icon-xl bg-info-soft text-info rounded-circle">
                            <i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h6 mb-1 text-body-secondary">@Localizer["Guide.Analytics.Completed"]</h2>
                            <p class="h4 mb-0 font-data"><bdi dir="ltr">@Count(Model.CompletedBookings)</bdi></p>
                        </div>
                        <div class="icon-xl bg-success-soft text-success rounded-circle">
                            <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="card card-body border h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h6 mb-1 text-body-secondary">@Localizer["Guide.Analytics.CancellationRate"]</h2>
                            <p class="h4 mb-0 font-data"><bdi dir="ltr">@Pct(Model.CancellationRate)</bdi></p>
                        </div>
                        <div class="icon-xl bg-warning-soft text-warning rounded-circle">
                            <i class="fa-solid fa-circle-xmark" aria-hidden="true"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-xl-7">
                <div class="card border h-100">
                    <div class="card-header border-bottom">
                        <h2 class="card-header-title h5 mb-0">@Localizer["Guide.Analytics.BookingTrends"]</h2>
                    </div>
                    <div class="card-body">
                        @if (Model.HasBookingTrends)
                        {
                            <div class="vstack gap-3">
                                @foreach (var trend in Model.BookingTrends)
                                {
                                    <div>
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="small text-body-secondary"><bdi dir="ltr">@trend.Period</bdi></span>
                                            <span class="small fw-semibold font-data"><bdi dir="ltr">@Count(trend.BookingCount)</bdi></span>
                                        </div>
                                        <div class="progress" style="height: 8px;" role="progressbar"
                                             aria-label="@trend.Period"
                                             aria-valuenow="@trend.BookingCount" aria-valuemin="0" aria-valuemax="@Model.MaxTrendCount">
                                            <div class="progress-bar bg-primary" style="width: @(Bar(trend.BookingCount, Model.MaxTrendCount))%"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
                                <p class="text-body-secondary mb-0">@Localizer["Guide.Analytics.NoTrends"]</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-5">
                <div class="card border h-100">
                    <div class="card-header border-bottom">
                        <h2 class="card-header-title h5 mb-0">@Localizer["Guide.Analytics.PeakDays"]</h2>
                    </div>
                    <div class="card-body">
                        @if (Model.HasPeakDays)
                        {
                            <div class="vstack gap-3">
                                @foreach (var day in Model.PeakDays)
                                {
                                    <div>
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="small text-body-secondary">@day.DayOfWeek</span>
                                            <span class="small fw-semibold font-data"><bdi dir="ltr">@Count(day.BookingCount)</bdi></span>
                                        </div>
                                        <div class="progress" style="height: 8px;" role="progressbar"
                                             aria-label="@day.DayOfWeek"
                                             aria-valuenow="@day.BookingCount" aria-valuemin="0" aria-valuemax="@Model.MaxPeakDayCount">
                                            <div class="progress-bar bg-info" style="width: @(Bar(day.BookingCount, Model.MaxPeakDayCount))%"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
                                <p class="text-body-secondary mb-0">@Localizer["Guide.Analytics.NoPeakDays"]</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card border">
            <div class="card-header border-bottom">
                <h2 class="card-header-title h5 mb-0">@Localizer["Guide.Analytics.PopularTours"]</h2>
            </div>
            <div class="card-body">
                @if (Model.HasPopularTours)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">@Localizer["Guide.Analytics.ColTour"]</th>
                                    <th scope="col" class="text-end">@Localizer["Guide.Analytics.ColBookings"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tour in Model.PopularTours)
                                {
                                    <tr>
                                        <td>@tour.TourName</td>
                                        <td class="text-end fw-semibold font-data"><bdi dir="ltr">@Count(tour.BookingCount)</bdi></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
                        <p class="text-body-secondary mb-0">@Localizer["Guide.Analytics.NoPopularTours"]</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
