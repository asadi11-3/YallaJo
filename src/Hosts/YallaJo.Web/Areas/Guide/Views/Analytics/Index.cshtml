@model YallaJo.Web.Areas.Guide.Models.Analytics.AnalyticsVm
@{
    ViewData["Title"] = Localizer["Guide.Analytics.Title"].Value;
    var culture = CultureInfo.CurrentUICulture;
    // Kept local: CancellationRate arrives as a 0-100 value formatted N1, unlike GuideFormat.Pct (0-1 fraction, "0.#").
    string Pct(decimal value) => value.ToString("N1", culture) + "%";
    int Bar(int value, int max) => max <= 0 ? 0 : (int)Math.Round(value * 100.0 / max);
}

@await Component.InvokeAsync("GuideSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h1 class="h4 mb-0"><i class="fa-solid fa-chart-column me-2" aria-hidden="true"></i>@Localizer["Guide.Analytics.Heading"]</h1>
                <p class="text-body-secondary mb-0">@Localizer["Guide.Analytics.Subtitle"]</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-sm-6 col-xl-3">
                <partial name="_GuideStatCard" model='new StatCardVm(Localizer["Guide.Analytics.TotalBookings"].Value, GuideFormat.Count(Model.TotalBookings), "calendar-check", "primary")' />
            </div>
            <div class="col-sm-6 col-xl-3">
                <partial name="_GuideStatCard" model='new StatCardVm(Localizer["Guide.Analytics.Upcoming"].Value, GuideFormat.Count(Model.UpcomingBookings), "hourglass-half", "info")' />
            </div>
            <div class="col-sm-6 col-xl-3">
                <partial name="_GuideStatCard" model='new StatCardVm(Localizer["Guide.Analytics.Completed"].Value, GuideFormat.Count(Model.CompletedBookings), "circle-check", "success")' />
            </div>
            <div class="col-sm-6 col-xl-3">
                <partial name="_GuideStatCard" model='new StatCardVm(Localizer["Guide.Analytics.CancellationRate"].Value, Pct(Model.CancellationRate), "circle-xmark", "warning")' />
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-xl-7">
                <div class="card border h-100">
                    <div class="card-header border-bottom">
                        <h2 class="card-header-title h5 mb-0">@Localizer["Guide.Analytics.BookingTrends"]</h2>
                    </div>
                    <div class="card-body">
                        @if (Model.HasBookingTrends)
                        {
                            <div class="vstack gap-3">
                                @foreach (var trend in Model.BookingTrends)
                                {
                                    <div>
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="small text-body-secondary"><bdi dir="ltr">@trend.Period</bdi></span>
                                            <span class="small fw-semibold font-data"><bdi dir="ltr">@GuideFormat.Count(trend.BookingCount)</bdi></span>
                                        </div>
                                        <div class="progress yj-progress-thin" role="progressbar"
                                             aria-label="@trend.Period"
                                             aria-valuenow="@trend.BookingCount" aria-valuemin="0" aria-valuemax="@Model.MaxTrendCount">
                                            @* X6: data-driven width *@
                                            <div class="progress-bar bg-primary" style="width: @(Bar(trend.BookingCount, Model.MaxTrendCount))%"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <partial name="_GuideEmptyState" model='new EmptyStateVm(Localizer["Guide.Analytics.NoTrends"].Value)' />
                        }
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-5">
                <div class="card border h-100">
                    <div class="card-header border-bottom">
                        <h2 class="card-header-title h5 mb-0">@Localizer["Guide.Analytics.PeakDays"]</h2>
                    </div>
                    <div class="card-body">
                        @if (Model.HasPeakDays)
                        {
                            <div class="vstack gap-3">
                                @foreach (var day in Model.PeakDays)
                                {
                                    <div>
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="small text-body-secondary">@day.DayOfWeek</span>
                                            <span class="small fw-semibold font-data"><bdi dir="ltr">@GuideFormat.Count(day.BookingCount)</bdi></span>
                                        </div>
                                        <div class="progress yj-progress-thin" role="progressbar"
                                             aria-label="@day.DayOfWeek"
                                             aria-valuenow="@day.BookingCount" aria-valuemin="0" aria-valuemax="@Model.MaxPeakDayCount">
                                            @* X6: data-driven width *@
                                            <div class="progress-bar bg-info" style="width: @(Bar(day.BookingCount, Model.MaxPeakDayCount))%"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <partial name="_GuideEmptyState" model='new EmptyStateVm(Localizer["Guide.Analytics.NoPeakDays"].Value)' />
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card border">
            <div class="card-header border-bottom">
                <h2 class="card-header-title h5 mb-0">@Localizer["Guide.Analytics.PopularTours"]</h2>
            </div>
            <div class="card-body">
                @if (Model.HasPopularTours)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">@Localizer["Guide.Analytics.ColTour"]</th>
                                    <th scope="col" class="text-end">@Localizer["Guide.Analytics.ColBookings"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tour in Model.PopularTours)
                                {
                                    <tr>
                                        <td>@tour.TourName</td>
                                        <td class="text-end fw-semibold font-data"><bdi dir="ltr">@GuideFormat.Count(tour.BookingCount)</bdi></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <partial name="_GuideEmptyState" model='new EmptyStateVm(Localizer["Guide.Analytics.NoPopularTours"].Value)' />
                }
            </div>
        </div>
    </div>
</section>
