@model YallaJo.Web.Areas.Guide.Models.JoinRequests.JoinRequestsVm
@using YallaJo.Web.Areas.Guide.Models.JoinRequests
@{
    ViewData["Title"] = Localizer["Guide.JoinRequests.Title"].Value;
    var culture = CultureInfo.CurrentUICulture;
    // Kept local: "dd MMM yyyy"(+HH:mm) output differs from GuideFormat.Date/DateTimeShort (yyyy-MM-dd).
    string Date(DateTime d) => d.ToString("dd MMM yyyy", culture);
    string DateTimeS(DateTime d) => d.ToString("dd MMM yyyy HH:mm", culture);
}

@await Component.InvokeAsync("GuideSidebar")

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h1 class="h4 mb-1"><i class="fa-solid fa-users me-2" aria-hidden="true"></i>@Localizer["Guide.JoinRequests.Heading"]</h1>
                <p class="text-body-secondary mb-0">@Localizer["Guide.JoinRequests.Subtitle"]</p>
            </div>
            @if (Model.PendingCount > 0)
            {
                <span class="badge bg-warning bg-opacity-10 text-warning fs-6"><i class="fa-solid fa-clock fa-fw" aria-hidden="true"></i> @Localizer["Guide.JoinRequests.PendingCount", GuideFormat.Count(Model.PendingCount)]</span>
            }
        </div>

        <div class="card card-body border">
            @if (!Model.HasRequests)
            {
                <partial name="_GuideEmptyState" model='new EmptyStateVm(Localizer["Guide.JoinRequests.NoRequests"].Value)' />
            }
            else
            {
                var index = 0;
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">@Localizer["Guide.JoinRequests.ColRequest"]</th>
                                <th scope="col">@Localizer["Guide.JoinRequests.ColParticipants"]</th>
                                <th scope="col">@Localizer["Guide.JoinRequests.ColMessage"]</th>
                                <th scope="col">@Localizer["Guide.JoinRequests.ColStatus"]</th>
                                <th scope="col">@Localizer["Guide.JoinRequests.ColRequested"]</th>
                                <th scope="col">@Localizer["Guide.JoinRequests.ColExpires"]</th>
                                <th scope="col" class="text-end">@Localizer["Guide.JoinRequests.ColActions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in Model.Requests)
                            {
                                index++;
                                <tr>
                                    <td class="fw-semibold">@Localizer["Guide.JoinRequests.RequestLabel", GuideFormat.Count(index)]</td>
                                    <td><bdi dir="ltr" class="font-data">@GuideFormat.Count(req.ParticipantCount)</bdi></td>
                                    <td class="text-truncate yj-cell-truncate" title="@req.Message">
                                        @if (string.IsNullOrWhiteSpace(req.Message))
                                        {
                                            <span class="text-body-secondary" aria-label="@Localizer["Guide.JoinRequests.NoMessage"]">&mdash;</span>
                                        }
                                        else
                                        {
                                            @req.Message
                                        }
                                        @if (!string.IsNullOrWhiteSpace(req.ResponseMessage))
                                        {
                                            <div class="small text-body-secondary mt-1">
                                                <i class="fa-solid fa-reply me-1" aria-hidden="true"></i> @req.ResponseMessage
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <partial name="_GuideStatusBadge" model="new StatusBadgeVm(req.Status.ToString())" />
                                        @if (req.IsExpired)
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary"><i class="fa-solid fa-hourglass-end fa-fw" aria-hidden="true"></i> @Localizer["Guide.JoinRequests.Expired"]</span>
                                        }
                                    </td>
                                    <td><bdi dir="ltr" class="font-data">@Date(req.CreatedAt)</bdi></td>
                                    <td><bdi dir="ltr" class="font-data">@DateTimeS(req.ExpiresAt)</bdi></td>
                                    <td class="text-end">
                                        @if (req.IsPending && !req.IsExpired)
                                        {
                                            <div class="d-inline-flex gap-2">
                                                <form asp-area="Guide" asp-controller="JoinRequests" asp-action="Approve" method="post" class="d-inline" data-loading>
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="RequestId" value="@req.Id" />
                                                    <button type="submit" class="btn btn-sm btn-success-soft">
                                                        <i class="fa-solid fa-check me-1" aria-hidden="true"></i>@Localizer["Guide.JoinRequests.Approve"]
                                                    </button>
                                                </form>
                                                <button type="button" class="btn btn-sm btn-danger-soft"
                                                        data-bs-toggle="modal" data-bs-target="#reject-req-@req.Id">
                                                    <i class="fa-solid fa-xmark me-1" aria-hidden="true"></i>@Localizer["Guide.JoinRequests.Reject"]
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-body-secondary small">
                                                @if (req.RespondedAt.HasValue)
                                                {
                                                    <bdi dir="ltr">@Date(req.RespondedAt.Value)</bdi>
                                                }
                                                else
                                                {
                                                    <span>&mdash;</span>
                                                }
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</section>

@if (Model.HasRequests)
{
    foreach (var req in Model.Requests)
    {
        if (req.IsPending && !req.IsExpired)
        {
            <div class="modal fade" id="reject-req-@req.Id" tabindex="-1" aria-labelledby="reject-req-title-@req.Id" aria-describedby="reject-req-body-@req.Id" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title h5" id="reject-req-title-@req.Id">@Localizer["Guide.JoinRequests.RejectTitle"]</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Guide.Common.Close"]"></button>
                        </div>
                        <form asp-area="Guide" asp-controller="JoinRequests" asp-action="Reject" method="post" data-loading>
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="RequestId" value="@req.Id" />
                            <div class="modal-body" id="reject-req-body-@req.Id">
                                <p>@Localizer["Guide.JoinRequests.RejectBody"]</p>
                                <label class="form-label" for="reject-reason-@req.Id">@Localizer["Guide.JoinRequests.ReasonLabel"]</label>
                                <textarea id="reject-reason-@req.Id" name="ResponseMessage" rows="3" maxlength="500" class="form-control"
                                          aria-describedby="reject-reason-help-@req.Id"></textarea>
                                <div id="reject-reason-help-@req.Id" class="form-text">@Localizer["Guide.JoinRequests.ReasonHelp"]</div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Guide.Common.Cancel"]</button>
                                <button type="submit" class="btn btn-danger">@Localizer["Guide.JoinRequests.RejectConfirm"]</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
