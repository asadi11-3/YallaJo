@model YallaJo.Web.Areas.Accounts.Models.Overview.OverviewVm
@* Phase 5a (Accounts plan): Overview "Picks for you" rail body — ERR3 retryable, AJAX-reloadable. *@
@if (Model.RecommendationsFailed)
{
    <div class="text-center py-4">
        <p class="text-muted mb-2">@Localizer["Accounts.Overview.RecommendationsFailed"]</p>
        <a asp-area="Accounts" asp-controller="Overview" asp-action="Index" class="btn btn-sm btn-outline-primary js-overview-retry">@Localizer["Accounts.Overview.Retry"]</a>
    </div>
}
else if (Model.Recommendations is { Count: > 0 })
{
    <div class="vstack gap-3">
        @foreach (var r in Model.Recommendations)
        {
            <div class="d-flex align-items-center gap-3">
                <div class="min-w-0 flex-grow-1">
                    <h3 class="h6 mb-0 text-truncate">
                        @if (r.DetailUrl is not null)
                        {
                            <a href="@r.DetailUrl" class="text-reset text-primary-hover text-decoration-none">@r.Name</a>
                        }
                        else
                        {
                            @r.Name
                        }
                    </h3>
                    <span class="small text-muted">@r.KindLabel</span>
                </div>
                @if (r.AverageRating > 0)
                {
                    <span class="badge bg-warning bg-opacity-10 text-warning flex-shrink-0">
                        <i class="bi bi-star-fill me-1" aria-hidden="true"></i>@r.AverageRating.ToString("0.0")
                    </span>
                }
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-4">
        <p class="text-muted mb-2">@Localizer["Accounts.Overview.NoRecommendations"]</p>
        <a asp-area="Accounts" asp-controller="Recommendations" asp-action="Index" class="btn btn-sm btn-primary">@Localizer["Accounts.Overview.Discover"]</a>
    </div>
}
