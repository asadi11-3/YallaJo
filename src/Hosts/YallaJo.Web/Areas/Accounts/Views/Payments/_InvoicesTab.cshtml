@model YallaJo.Web.Areas.Accounts.Models.Invoices.InvoicesVm
@using YallaJo.Web.Infrastructure.Authorization
@* Phase 3 (Accounts plan): invoices list extracted from Invoices/Index into the Billing hub tab (R2/PE1).
   The Download GET keeps its route and Invoice.Download permission gate. *@
@{
    string Money(decimal amount, string? currency) =>
        string.IsNullOrWhiteSpace(currency) ? amount.ToString("N2") : $"{amount:N2} {currency}";

    string StatusBadge(string status) => status?.ToLowerInvariant() switch
    {
        "paid" or "issued" or "settled" => "success",
        "pending" or "draft" => "warning",
        "void" or "cancelled" or "refunded" => "danger",
        _ => "secondary",
    };
}

<div class="card border">
    <div class="card-header border-bottom d-flex justify-content-between align-items-center">
        <h4 class="card-header-title mb-0">@Localizer["Accounts.Billing.MyInvoices"]</h4>
        @if (Model.HasInvoices)
        {
            <span class="badge bg-primary bg-opacity-10 text-primary">@Model.Invoices.Count</span>
        }
    </div>
    <div class="card-body">
        @if (!Model.HasInvoices)
        {
            <div class="text-center py-5">
                <i class="bi bi-receipt display-5 text-body-secondary d-block mb-2" aria-hidden="true"></i>
                <h6 class="mb-1">@Localizer["Accounts.Billing.NoInvoices"]</h6>
                <p class="text-body-secondary mb-0">@Localizer["Accounts.Billing.NoInvoicesHelp"]</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@Localizer["Accounts.Billing.ColInvoiceNo"]</th>
                            <th>@Localizer["Accounts.Billing.ColSeller"]</th>
                            <th>@Localizer["Accounts.Billing.ColIssued"]</th>
                            <th>@Localizer["Accounts.JoinRequests.Status"]</th>
                            <th class="text-end">@Localizer["Accounts.Billing.ColTotal"]</th>
                            <th class="text-end">@Localizer["Accounts.Settings.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var inv in Model.Invoices)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold"><span dir="ltr">@inv.InvoiceNumber</span></span>
                                    <div class="small text-body-secondary">
                                        @Localizer["Accounts.Billing.ItemCount", inv.ItemCount]
                                    </div>
                                </td>
                                <td>@inv.SellerName</td>
                                <td>@inv.IssuedAt.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="badge bg-@StatusBadge(inv.Status) bg-opacity-10 text-@StatusBadge(inv.Status)">
                                        @inv.Status
                                    </span>
                                </td>
                                <td class="text-end fw-semibold"><span dir="ltr">@Money(inv.AmountTotal, inv.Currency)</span></td>
                                <td class="text-end">
                                    @if (inv.PdfAvailable)
                                    {
                                        <permission require="@WebPermission.Invoice.Download">
                                            <a class="btn btn-sm btn-primary-soft"
                                               asp-area="Accounts" asp-controller="Invoices"
                                               asp-action="Download" asp-route-id="@inv.Id">
                                                <i class="bi bi-download me-1" aria-hidden="true"></i>@Localizer["Accounts.Billing.Pdf"]
                                            </a>
                                        </permission>
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary small">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
