@model YallaJo.Web.Areas.Accounts.Models.Disputes.DisputesVm
@* Phase 3 (Accounts plan): disputes list + open-dispute modal extracted from Disputes/Index into the
   Billing hub tab (R2/PE1). The Open POST keeps its /accounts/disputes route and Refund.Create gate;
   pager links now target the hub (/accounts/payments?tab=disputes&page=N). *@

<div class="card border">
    <div class="card-header border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 class="card-header-title h4 mb-0">@Localizer["Accounts.Billing.MyDisputes"]</h2>
        @if (Model.CanOpenDispute)
        {
            <button type="button" class="btn btn-sm btn-primary mb-0" data-bs-toggle="modal" data-bs-target="#openDisputeModal">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>@Localizer["Accounts.Billing.OpenDispute"]
            </button>
        }
    </div>

    <div class="card-body">
        @if (!Model.HasDisputes)
        {
            <div class="text-center py-5">
                <i class="bi bi-shield-check display-5 text-secondary mb-3 d-block" aria-hidden="true"></i>
                <h3 class="h6 mb-1">@Localizer["Accounts.Billing.NoDisputes"]</h3>
                <p class="text-muted mb-3">@Localizer["Accounts.Billing.NoDisputesHelp"]</p>
                @if (Model.CanOpenDispute)
                {
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#openDisputeModal">
                        @Localizer["Accounts.Billing.OpenDispute"]
                    </button>
                }
                else
                {
                    <p class="small text-muted mb-0">@Localizer["Accounts.Billing.NoDisputablePayments"]</p>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">@Localizer["Accounts.Billing.ColReason"]</th>
                            <th scope="col">@Localizer["Accounts.JoinRequests.Status"]</th>
                            <th scope="col">@Localizer["Accounts.Billing.ColOpened"]</th>
                            <th scope="col">@Localizer["Accounts.Billing.ColResolution"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Disputes)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold d-block">@d.Reason</span>
                                    <span class="small text-muted">@d.Description</span>
                                </td>
                                <td><span class="badge @d.StatusBadgeClass">@d.Status</span></td>
                                <td class="small text-muted">@d.CreatedAt.ToString("d MMM yyyy")</td>
                                <td class="small">
                                    @if (d.IsResolved)
                                    {
                                        <span class="d-block">@(d.Resolution ?? Localizer["Accounts.Status.Resolved"].Value)</span>
                                        @if (!string.IsNullOrWhiteSpace(d.ResolutionNotes))
                                        {
                                            <span class="text-muted">@d.ResolutionNotes</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* ── Pager (D1): shared _PrevNextPager partial — links target the Billing hub disputes tab ── *@
            <partial name="_PrevNextPager" view-data='@(new ViewDataDictionary(ViewData)
            {
                { "prevUrl", Model.HasPreviousPage ? Url.Action("Index", "Payments", new { area = "Accounts", tab = "disputes", page = Model.PageNumber - 1 }) : null },
                { "nextUrl", Model.HasNextPage ? Url.Action("Index", "Payments", new { area = "Accounts", tab = "disputes", page = Model.PageNumber + 1 }) : null },
                { "ariaLabel", Localizer["Accounts.Disputes.Pagination"].Value }
            })' />
        }
    </div>
</div>

@* ── Open-dispute modal (ViewModel form + anti-forgery) ──────────── *@
@if (Model.CanOpenDispute)
{
    <div class="modal fade" id="openDisputeModal" tabindex="-1" aria-labelledby="openDisputeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-area="Accounts" asp-controller="Disputes" asp-action="Open" method="post"
                      data-loading>
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="openDisputeModalLabel">@Localizer["Accounts.Billing.OpenDispute"]</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Accounts.Confirm.Close"]"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label" asp-for="Form.PaymentId">@Localizer["Accounts.Billing.Payment"]</label>
                            <select class="form-select" asp-for="Form.PaymentId">
                                <option value="">@Localizer["Accounts.Billing.ChoosePayment"]</option>
                                @foreach (var p in Model.DisputablePayments)
                                {
                                    <option value="@p.PaymentId">@p.Label</option>
                                }
                            </select>
                            <span asp-validation-for="Form.PaymentId" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" asp-for="Form.Reason">@Localizer["Accounts.Billing.ColReason"]</label>
                            <input class="form-control" asp-for="Form.Reason" maxlength="120" placeholder="@Localizer["Accounts.Billing.ReasonPlaceholder"]" />
                            <span asp-validation-for="Form.Reason" class="text-danger small"></span>
                        </div>
                        <div class="mb-1">
                            <label class="form-label" asp-for="Form.Description">@Localizer["Accounts.Billing.Description"]</label>
                            <textarea class="form-control" asp-for="Form.Description" rows="4" maxlength="2000"
                                      placeholder="@Localizer["Accounts.Billing.DescriptionPlaceholder"]"></textarea>
                            <span asp-validation-for="Form.Description" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light mb-0" data-bs-dismiss="modal">@Localizer["Public.Confirm.Cancel"]</button>
                        <button type="submit" class="btn btn-primary mb-0">@Localizer["Accounts.Booking.SubmitDispute"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
