@model YallaJo.Web.Areas.Accounts.Models.Payments.BillingVm
@using YallaJo.Web.Areas.Accounts.Shared
@using YallaJo.Web.Infrastructure.Authorization
@{
    ViewData["Title"] = "Billing";
    ViewData["AccountNav"] = "Payments";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as AccountSidebarVm ?? new AccountSidebarVm();
    var activeTab = (Model.ActiveTab ?? "payments").ToLowerInvariant();

    string TabClass(string name) => activeTab == name ? "nav-link active" : "nav-link";
    string PaneClass(string name) => activeTab == name ? "tab-pane fade show active" : "tab-pane fade";
    string Selected(string name) => activeTab == name ? "true" : "false";
}

@* Phase 3 (Accounts plan): Billing hub — Payments, Invoices and Disputes consolidated into one tabbed page (R2/PE1).
   The retired /accounts/invoices and /accounts/disputes pages 301 here with ?tab=. *@
<section class="pt-3">
    <div class="container">
        <div class="row g-4 g-xl-5">
            <partial name="_AccountSidebar" model="sidebar" />

            <div class="col-lg-8 col-xl-9">
                <partial name="_AccountMenuToggle" />

                <ul class="nav nav-tabs nav-bottom-line mb-4 flex-nowrap overflow-auto" id="billingTabs" data-yj-component="account-tabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="@TabClass("payments")" id="tab-payments" data-bs-toggle="tab" data-bs-target="#pane-payments" type="button" role="tab" aria-controls="pane-payments" aria-selected="@Selected("payments")">
                            <i class="bi bi-credit-card fa-fw me-1" aria-hidden="true"></i>@Localizer["Accounts.Billing.Tab.Payments"]
                        </button>
                    </li>
                    <permission require="@WebPermission.Invoice.Read">
                        <li class="nav-item" role="presentation">
                            <button class="@TabClass("invoices")" id="tab-invoices" data-bs-toggle="tab" data-bs-target="#pane-invoices" type="button" role="tab" aria-controls="pane-invoices" aria-selected="@Selected("invoices")">
                                <i class="bi bi-receipt fa-fw me-1" aria-hidden="true"></i>@Localizer["Accounts.Billing.Tab.Invoices"]
                            </button>
                        </li>
                    </permission>
                    <permission require="@WebPermission.Refund.Read">
                        <li class="nav-item" role="presentation">
                            <button class="@TabClass("disputes")" id="tab-disputes" data-bs-toggle="tab" data-bs-target="#pane-disputes" type="button" role="tab" aria-controls="pane-disputes" aria-selected="@Selected("disputes")">
                                <i class="bi bi-exclamation-octagon fa-fw me-1" aria-hidden="true"></i>@Localizer["Accounts.Billing.Tab.Disputes"]
                            </button>
                        </li>
                    </permission>
                </ul>

                <div class="tab-content">
                    <div class="@PaneClass("payments")" id="pane-payments" role="tabpanel" aria-labelledby="tab-payments" tabindex="0">
                        <partial name="_PaymentsTab" model="Model.Payments" />
                    </div>
                    <permission require="@WebPermission.Invoice.Read">
                        <div class="@PaneClass("invoices")" id="pane-invoices" role="tabpanel" aria-labelledby="tab-invoices" tabindex="0">
                            <partial name="_InvoicesTab" model="Model.Invoices" />
                        </div>
                    </permission>
                    <permission require="@WebPermission.Refund.Read">
                        <div class="@PaneClass("disputes")" id="pane-disputes" role="tabpanel" aria-labelledby="tab-disputes" tabindex="0">
                            <partial name="_DisputesTab" model="Model.Disputes" />
                        </div>
                    </permission>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/accounts-settings.js" asp-append-version="true"></script>
}
