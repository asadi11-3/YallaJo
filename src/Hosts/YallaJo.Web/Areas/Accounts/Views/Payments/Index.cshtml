@model YallaJo.Web.Areas.Accounts.Models.Payments.PaymentsVm
@using YallaJo.Web.Areas.Accounts.Shared
@{
    ViewData["Title"] = "My Payments";
    ViewData["AccountNav"] = "Payments";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as AccountSidebarVm ?? new AccountSidebarVm();

    string Money(decimal amount, string? currency)
        => string.IsNullOrWhiteSpace(currency) ? amount.ToString("N2") : $"{amount:N2} {currency}";

    string StatusBadge(string status) => status?.ToLowerInvariant() switch
    {
        "completed" or "succeeded" or "paid" or "captured" => "success",
        "pending" or "processing" or "initiated" or "requiresaction" => "warning",
        "failed" or "cancelled" or "canceled" or "expired" => "danger",
        "refunded" or "partiallyrefunded" => "info",
        _ => "secondary",
    };

    string PrettyType(string type) => type?.ToLowerInvariant() switch
    {
        "booking" => "Booking",
        "refund" => "Refund",
        _ => type ?? "—",
    };
}

<section class="pt-3">
    <div class="container">
        <div class="row g-4 g-xl-5">
            <partial name="_AccountSidebar" model="sidebar" />

            <div class="col-lg-8 col-xl-9">
                <button class="btn btn-primary-soft d-lg-none mb-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasSidebar">
                    <i class="bi bi-list me-1"></i> Account menu
                </button>

                <div class="card border">
                    <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                        <h4 class="card-header-title mb-0">My Payments</h4>
                        @if (Model.HasPayments)
                        {
                            <span class="badge bg-primary bg-opacity-10 text-primary">@Model.Payments.Count</span>
                        }
                    </div>
                    <div class="card-body">
                        @if (!Model.HasPayments)
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-credit-card-2-front display-5 text-body-tertiary"></i>
                                <h6 class="mt-3 mb-1">No payments yet</h6>
                                <p class="text-secondary mb-0">Your payment history will appear here once you complete a booking.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Type</th>
                                            <th>Method</th>
                                            <th>Status</th>
                                            <th class="text-end">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in Model.Payments)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="fw-semibold">@p.CreatedAt.ToString("dd MMM yyyy")</span>
                                                    @if (p.PaidAt is { } paid)
                                                    {
                                                        <small class="d-block text-secondary">Paid @paid.ToString("dd MMM yyyy")</small>
                                                    }
                                                </td>
                                                <td>@PrettyType(p.PaymentType)</td>
                                                <td>@p.PaymentMethod</td>
                                                <td>
                                                    <span class="badge bg-@(StatusBadge(p.Status)) bg-opacity-10 text-@StatusBadge(p.Status)">@p.Status</span>
                                                    @if (p.IsRefunded)
                                                    {
                                                        <span class="badge bg-info bg-opacity-10 text-info ms-1">Refunded @Money(p.RefundedTotal, p.Currency)</span>
                                                    }
                                                </td>
                                                <td class="text-end fw-semibold">@Money(p.Amount, p.Currency)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
