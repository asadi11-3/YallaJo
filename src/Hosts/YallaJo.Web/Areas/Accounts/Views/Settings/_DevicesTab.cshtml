@model YallaJo.Web.Areas.Accounts.Models.Settings.SettingsVm
@* Phase 2 (Accounts plan): Devices tab — push-notification device tokens, extracted from Settings/Index. *@

<div class="card border">
    <div class="card-header border-bottom">
        <h4 class="card-header-title mb-0">@Localizer["Accounts.Settings.Tab.Devices"]</h4>
        <p class="mb-0 small">@Localizer["Accounts.Devices.Hint"]</p>
    </div>
    <div class="card-body">
        @if (Model.Devices.Count == 0)
        {
            <p class="text-body-secondary small mb-3">@Localizer["Accounts.Devices.None"]</p>
        }
        else
        {
            <div class="table-responsive mb-3">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">@Localizer["Accounts.Settings.Device"]</th>
                            <th scope="col">@Localizer["Accounts.Devices.Platform"]</th>
                            <th scope="col">@Localizer["Accounts.Devices.LastSeen"]</th>
                            <th scope="col" class="text-end">@Localizer["Accounts.Settings.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Devices)
                        {
                            <tr>
                                <td class="small"><span dir="ltr">@d.DeviceId</span></td>
                                <td class="small">@d.Platform</td>
                                <td class="small">@d.LastSeenAt.ToString("d MMM yyyy")</td>
                                <td class="text-end">
                                    <form asp-area="Accounts" asp-controller="Settings" asp-action="RemoveDevice"
                                          asp-route-id="@d.Id" method="post" class="d-inline"
                                          data-confirm="@Localizer["Accounts.Confirm.RemoveDevice"]" data-confirm-title="@Localizer["Public.Confirm.Title"]" data-confirm-action="@Localizer["Public.Confirm.Delete"]" data-confirm-cancel="@Localizer["Public.Confirm.Cancel"]">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger mb-0">@Localizer["Accounts.Common.Remove"]</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <form asp-area="Accounts" asp-controller="Settings" asp-action="RegisterDevice" method="post" class="row g-2 align-items-end" data-loading>
            @Html.AntiForgeryToken()
            <div class="col-sm-4">
                <label class="form-label" for="deviceId">@Localizer["Accounts.Devices.DeviceId"]</label>
                <input class="form-control" id="deviceId" name="deviceId" placeholder="@Localizer["Accounts.Devices.DeviceIdPlaceholder"]" />
            </div>
            <div class="col-sm-3">
                <label class="form-label" for="platform">@Localizer["Accounts.Devices.Platform"]</label>
                <select class="form-select" id="platform" name="platform">
                    <option value="Web">Web</option>
                    <option value="Android">Android</option>
                    <option value="iOS">iOS</option>
                </select>
            </div>
            <div class="col-sm-3">
                <label class="form-label" for="token">@Localizer["Accounts.Devices.Token"]</label>
                <input class="form-control" id="token" name="token" placeholder="@Localizer["Accounts.Devices.TokenPlaceholder"]" />
            </div>
            <div class="col-sm-2 d-grid">
                <button type="submit" class="btn btn-primary mb-0">@Localizer["Accounts.Devices.Register"]</button>
            </div>
        </form>
    </div>
</div>
