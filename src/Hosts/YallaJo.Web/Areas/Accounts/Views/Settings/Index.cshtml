@model YallaJo.Web.Areas.Accounts.Models.Settings.SettingsVm
@using YallaJo.Web.Areas.Accounts.Shared
@using YallaJo.Web.Areas.Accounts.Models.Privacy
@{
    ViewData["Title"] = "Settings";
    ViewData["AccountNav"] = "Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as AccountSidebarVm ?? new AccountSidebarVm();

    // Phase 2 (Accounts plan): tabbed settings hub (UI-UX-R2/PE1). The server honours ?tab= so the
    // hub works without JavaScript; accounts-settings.js syncs the active tab with the URL hash.
    var activeTab = ViewData["SettingsTab"] as string ?? "notifications";
    string PaneClass(string key) => activeTab == key ? "tab-pane fade show active" : "tab-pane fade";
    string TabClass(string key) => activeTab == key ? "nav-link active" : "nav-link";
    string Selected(string key) => activeTab == key ? "true" : "false";
}

<section class="pt-3">
    <div class="container">
        <div class="row g-4 g-xl-5">
            <partial name="_AccountSidebar" model="sidebar" />

            <div class="col-lg-8 col-xl-9">
                <partial name="_AccountMenuToggle" />

                <ul class="nav nav-tabs nav-bottom-line mb-4 flex-nowrap overflow-auto" id="settingsTabs"
                    data-yj-component="settings-tabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="@TabClass("notifications") text-nowrap" id="tab-notifications" data-bs-toggle="tab"
                                data-bs-target="#pane-notifications" type="button" role="tab"
                                aria-controls="pane-notifications" aria-selected="@Selected("notifications")">
                            <i class="bi bi-bell me-1" aria-hidden="true"></i>@Localizer["Accounts.Settings.Tab.Notifications"]
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="@TabClass("security") text-nowrap" id="tab-security" data-bs-toggle="tab"
                                data-bs-target="#pane-security" type="button" role="tab"
                                aria-controls="pane-security" aria-selected="@Selected("security")">
                            <i class="bi bi-shield-lock me-1" aria-hidden="true"></i>@Localizer["Accounts.Settings.Tab.Security"]
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="@TabClass("devices") text-nowrap" id="tab-devices" data-bs-toggle="tab"
                                data-bs-target="#pane-devices" type="button" role="tab"
                                aria-controls="pane-devices" aria-selected="@Selected("devices")">
                            <i class="bi bi-phone me-1" aria-hidden="true"></i>@Localizer["Accounts.Settings.Tab.Devices"]
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="@TabClass("linked") text-nowrap" id="tab-linked" data-bs-toggle="tab"
                                data-bs-target="#pane-linked" type="button" role="tab"
                                aria-controls="pane-linked" aria-selected="@Selected("linked")">
                            <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>@Localizer["Accounts.Settings.Tab.Linked"]
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="@TabClass("privacy") text-nowrap" id="tab-privacy" data-bs-toggle="tab"
                                data-bs-target="#pane-privacy" type="button" role="tab"
                                aria-controls="pane-privacy" aria-selected="@Selected("privacy")">
                            <i class="bi bi-shield-check me-1" aria-hidden="true"></i>@Localizer["Accounts.Settings.Tab.Privacy"]
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="@TabClass("account") text-nowrap text-danger" id="tab-account" data-bs-toggle="tab"
                                data-bs-target="#pane-account" type="button" role="tab"
                                aria-controls="pane-account" aria-selected="@Selected("account")">
                            <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>@Localizer["Accounts.Settings.Tab.Account"]
                        </button>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="@PaneClass("notifications")" id="pane-notifications" role="tabpanel" aria-labelledby="tab-notifications" tabindex="0">
                        <partial name="_NotificationsTab" model="Model" />
                    </div>
                    <div class="@PaneClass("security")" id="pane-security" role="tabpanel" aria-labelledby="tab-security" tabindex="0">
                        <partial name="_SecurityTab" model="Model" />
                    </div>
                    <div class="@PaneClass("devices")" id="pane-devices" role="tabpanel" aria-labelledby="tab-devices" tabindex="0">
                        <partial name="_DevicesTab" model="Model" />
                    </div>
                    <div class="@PaneClass("linked")" id="pane-linked" role="tabpanel" aria-labelledby="tab-linked" tabindex="0">
                        <partial name="_LinkedTab" model="Model" />
                    </div>
                    <div class="@PaneClass("privacy")" id="pane-privacy" role="tabpanel" aria-labelledby="tab-privacy" tabindex="0">
                        <partial name="_PrivacyTab" model="new PrivacyVm()" />
                    </div>
                    <div class="@PaneClass("account")" id="pane-account" role="tabpanel" aria-labelledby="tab-account" tabindex="0">
                        <partial name="_AccountDangerTab" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/accounts-settings.js" asp-append-version="true"></script>
}
