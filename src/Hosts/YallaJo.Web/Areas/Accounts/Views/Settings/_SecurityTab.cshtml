@model YallaJo.Web.Areas.Accounts.Models.Settings.SettingsVm
@* Phase 2 (Accounts plan): Security tab — password change (single write stays on ChangePasswordController),
   phone number, active sessions and logout-all, consolidated from the retired ChangePassword/UpdatePhone pages. *@

<div class="vstack gap-4">

    @* ---------- Password ---------- *@
    <div class="card border">
        <div class="card-header border-bottom">
            <h4 class="card-header-title mb-0">@Localizer["Accounts.Settings.UpdatePassword"]</h4>
            <p class="mb-0 mt-1 small">@Localizer["Accounts.Settings.PasswordHint"]</p>
        </div>
        <div class="card-body">
            <form asp-area="Accounts" asp-controller="ChangePassword" asp-action="Index" method="post" class="row g-3" data-loading>
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@(Url.Action("Index", "Settings", new { area = "Accounts", tab = "security" }))" />
                <div class="col-12">
                    <label for="settingsCurrentPassword" class="form-label">@Localizer["Accounts.Settings.CurrentPassword"]</label>
                    <input type="password" id="settingsCurrentPassword" name="CurrentPassword" class="form-control" autocomplete="current-password" />
                </div>
                <div class="col-12">
                    <label for="settingsNewPassword" class="form-label">@Localizer["Accounts.Settings.NewPassword"]</label>
                    <input type="password" id="settingsNewPassword" name="NewPassword" class="form-control" autocomplete="new-password" />
                </div>
                <div class="col-12">
                    <label for="settingsConfirmNewPassword" class="form-label">@Localizer["Accounts.Settings.ConfirmNewPassword"]</label>
                    <input type="password" id="settingsConfirmNewPassword" name="ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                </div>
                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-primary mb-0">@Localizer["Accounts.Settings.ChangePassword"]</button>
                </div>
            </form>
        </div>
    </div>

    @* ---------- Security (phone + sessions) ---------- *@
    <div class="card border">
        <div class="card-header border-bottom">
            <h4 class="card-header-title mb-0">@Localizer["Accounts.Settings.SecuritySettings"]</h4>
        </div>
        <div class="card-body vstack gap-4">

            @* Phone number *@
            <div>
                <h6>@Localizer["Accounts.Settings.PhoneNumber"]</h6>
                <form asp-area="Accounts" asp-controller="Settings" asp-action="UpdatePhone" method="post" class="row g-2 align-items-end" data-loading>
                    @Html.AntiForgeryToken()
                    <div class="col-sm-8">
                        <label class="form-label" for="PhoneNumber">@Localizer["Accounts.Settings.PrimaryPhone"]</label>
                        <input class="form-control" type="tel" id="PhoneNumber" name="PhoneNumber" dir="ltr"
                               value="@Model.PhoneNumber" placeholder="+1 555 123 4567" autocomplete="tel" />
                    </div>
                    <div class="col-sm-4 d-grid">
                        <button type="submit" class="btn btn-primary mb-0">@Localizer["Accounts.Settings.UpdatePhone"]</button>
                    </div>
                </form>
            </div>

            <hr class="my-1" />

            @* Active sessions *@
            <div>
                <h6>@Localizer["Accounts.Settings.ActiveSessions"]</h6>
                @if (Model.Sessions.Count == 0)
                {
                    <p class="text-body-secondary small mb-0">@Localizer["Accounts.Settings.NoSessions"]</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">@Localizer["Accounts.Settings.Device"]</th>
                                    <th scope="col">@Localizer["Accounts.Settings.Ip"]</th>
                                    <th scope="col">@Localizer["Accounts.Settings.Started"]</th>
                                    <th scope="col">@Localizer["Accounts.JoinRequests.Expires"]</th>
                                    <th scope="col" class="text-end">@Localizer["Accounts.Settings.Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.Sessions)
                                {
                                    <tr>
                                        <td>
                                            @s.DeviceName
                                            @if (s.IsCurrent)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success ms-1">@Localizer["Accounts.Settings.ThisDevice"]</span>
                                            }
                                        </td>
                                        <td class="small"><span dir="ltr">@s.IpAddress</span></td>
                                        <td class="small">@s.CreatedAt.ToString("d MMM yyyy")</td>
                                        <td class="small">@s.ExpiresAt.ToString("d MMM yyyy")</td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-1">
                                                <form asp-area="Accounts" asp-controller="Settings" asp-action="TrustDevice"
                                                      asp-route-deviceId="@s.DeviceId" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary mb-0">@Localizer["Accounts.Settings.Trust"]</button>
                                                </form>
                                                @if (!s.IsCurrent)
                                                {
                                                    <form asp-area="Accounts" asp-controller="Settings" asp-action="RevokeSession"
                                                          asp-route-sessionId="@s.SessionId" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger mb-0">@Localizer["Accounts.Settings.SignOutSession"]</button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <form asp-area="Accounts" asp-controller="Settings" asp-action="LogoutAll" method="post" class="mt-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger mb-0">
                        <i class="fas fa-sign-out-alt me-2" aria-hidden="true"></i>@Localizer["Accounts.Settings.SignOutAll"]
                    </button>
                </form>
            </div>

        </div>
    </div>

</div>
