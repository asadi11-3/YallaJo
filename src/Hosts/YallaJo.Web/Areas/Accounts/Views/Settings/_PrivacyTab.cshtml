@model YallaJo.Web.Areas.Accounts.Models.Privacy.PrivacyVm
@* Phase 2 (Accounts plan): Privacy & data tab — GDPR data rights (export / delete recommendation data /
   cancel pending deletion), extracted from the retired Privacy/Index page. POST/GET routes and their
   RequirePermission gates are unchanged on PrivacyController. *@

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-warning" role="alert">@Model.LoadError</div>
}

<div class="card border">
    <div class="card-header border-bottom">
        <h4 class="card-header-title mb-0">Privacy &amp; Data</h4>
        <p class="small text-muted mb-0 mt-1">Manage your personal recommendation &amp; analytics data.</p>
    </div>

    @* ── Export ───────────────────────────────────────────────── *@
    <div class="card-body border-bottom">
        <h6 class="mb-1"><i class="bi bi-download me-2"></i>Download my data</h6>
        <p class="small text-muted mb-3">
            Export a copy of the personalization data we hold for you (your interactions,
            preferences and excluded items) as a JSON file.
        </p>
        <a asp-area="Accounts" asp-controller="Privacy" asp-action="Export"
           class="btn btn-sm btn-primary-soft mb-0">
            <i class="bi bi-download me-1"></i>Download my data (JSON)
        </a>
    </div>

    @* ── Delete recommendation data (destructive) ─────────────── *@
    <div class="card-body border-bottom">
        <h6 class="mb-1 text-danger"><i class="bi bi-shield-x me-2"></i>Delete my recommendation data</h6>
        <div class="alert alert-warning d-flex align-items-start gap-2 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div class="small">
                <strong>This deletes your recommendation &amp; analytics data only — not your account.</strong>
                To delete or deactivate your account, use the
                <a href="@(Url.Action("Index", "Settings", new { area = "Accounts", tab = "account" }))" class="alert-link">Account tab</a>
                instead.
            </div>
        </div>
        <p class="small text-muted mb-2">What happens when you request this:</p>
        <ul class="list-group list-group-borderless small mb-3">
            <li class="list-group-item d-flex py-1"><i class="bi bi-dot text-danger me-1"></i>Your interaction history, personalization preferences and "not interested" choices are scheduled for deletion.</li>
            <li class="list-group-item d-flex py-1"><i class="bi bi-dot text-danger me-1"></i>Deletion runs after a <strong>30-day window</strong> — you can cancel any time before then.</li>
            <li class="list-group-item d-flex py-1"><i class="bi bi-dot text-danger me-1"></i>Your bookings, reviews, invoices and account are <strong>not</strong> affected.</li>
            <li class="list-group-item d-flex py-1"><i class="bi bi-dot text-danger me-1"></i>Recommendations will become less personalized.</li>
        </ul>
        <button type="button" class="btn btn-sm btn-outline-danger mb-0"
                data-bs-toggle="modal" data-bs-target="#deleteDataModal">
            <i class="bi bi-shield-x me-1"></i>Delete my recommendation data
        </button>
    </div>

    @* ── Cancel pending deletion ──────────────────────────────── *@
    <div class="card-body">
        <h6 class="mb-1"><i class="bi bi-arrow-counterclockwise me-2"></i>Cancel a scheduled deletion</h6>
        <p class="small text-muted mb-3">
            Changed your mind? If a deletion is scheduled, you can cancel it here within the
            30-day window. If nothing is scheduled, we'll let you know.
        </p>
        <form asp-area="Accounts" asp-controller="Privacy" asp-action="CancelDeletion" method="post" class="mb-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-primary-soft mb-0">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Cancel scheduled deletion
            </button>
        </form>
    </div>
</div>

@* ── Typed-confirmation modal for the destructive delete-data action ─────────── *@
<div class="modal fade" id="deleteDataModal" tabindex="-1" aria-labelledby="deleteDataModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-area="Accounts" asp-controller="Privacy" asp-action="DeleteData" method="post" data-loading>
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteDataModalLabel">Delete recommendation data?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="small mb-2">
                        This schedules deletion of your <strong>recommendation &amp; analytics data only</strong>
                        (not your account) after a 30-day window. To confirm, type
                        <strong>DELETE</strong> below.
                    </p>
                    <label class="form-label small mb-1" for="confirmation">Type DELETE to confirm</label>
                    <input type="text" class="form-control" id="confirmation" name="confirmation"
                           autocomplete="off" placeholder="DELETE" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-primary-soft mb-0" data-bs-dismiss="modal">Keep my data</button>
                    <button type="submit" class="btn btn-sm btn-danger mb-0">
                        <i class="bi bi-shield-x me-1"></i>Delete my recommendation data
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
