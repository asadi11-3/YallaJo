@model YallaJo.Web.Areas.Accounts.Models.Privacy.PrivacyVm
@* Phase 2 (Accounts plan): Privacy & data tab — GDPR data rights (export / delete recommendation data /
   cancel pending deletion), extracted from the retired Privacy/Index page. POST/GET routes and their
   RequirePermission gates are unchanged on PrivacyController. *@

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="alert alert-warning" role="alert">@Model.LoadError</div>
}

<div class="card border">
    <div class="card-header border-bottom">
        <h4 class="card-header-title mb-0">@Localizer["Accounts.Settings.Tab.Privacy"]</h4>
        <p class="small text-muted mb-0 mt-1">@Localizer["Accounts.Privacy.Hint"]</p>
    </div>

    @* ── Export ───────────────────────────────────────────────── *@
    <div class="card-body border-bottom">
        <h6 class="mb-1"><i class="bi bi-download me-2" aria-hidden="true"></i>@Localizer["Accounts.Privacy.DownloadHeading"]</h6>
        <p class="small text-muted mb-3">@Localizer["Accounts.Privacy.DownloadHelp"]</p>
        <a asp-area="Accounts" asp-controller="Privacy" asp-action="Export"
           class="btn btn-sm btn-primary-soft mb-0">
            <i class="bi bi-download me-1" aria-hidden="true"></i>@Localizer["Accounts.Privacy.DownloadButton"]
        </a>
    </div>

    @* ── Delete recommendation data (destructive) ─────────────── *@
    <div class="card-body border-bottom">
        <h6 class="mb-1 text-danger"><i class="bi bi-shield-x me-2" aria-hidden="true"></i>@Localizer["Accounts.Privacy.DeleteHeading"]</h6>
        <div class="alert alert-warning d-flex align-items-start gap-2 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5" aria-hidden="true"></i>
            <div class="small">
                <strong>@Localizer["Accounts.Privacy.DeleteWarning"]</strong>
                @Localizer["Accounts.Privacy.DeleteAccountHintPre"]
                <a href="@(Url.Action("Index", "Settings", new { area = "Accounts", tab = "account" }))" class="alert-link">@Localizer["Accounts.Privacy.AccountTab"]</a>
                @Localizer["Accounts.Privacy.DeleteAccountHintPost"]
            </div>
        </div>
        <p class="small text-muted mb-2">@Localizer["Accounts.Privacy.WhatHappens"]</p>
        <ul class="list-group list-group-borderless small mb-3">
            <li class="list-group-item d-flex py-1"><i class="bi bi-dot text-danger me-1" aria-hidden="true"></i>@Localizer["Accounts.Privacy.DeleteItem1"]</li>
            <li class="list-group-item d-flex py-1"><i class="bi bi-dot text-danger me-1" aria-hidden="true"></i>@Localizer["Accounts.Privacy.DeleteItem2"]</li>
            <li class="list-group-item d-flex py-1"><i class="bi bi-dot text-danger me-1" aria-hidden="true"></i>@Localizer["Accounts.Privacy.DeleteItem3"]</li>
            <li class="list-group-item d-flex py-1"><i class="bi bi-dot text-danger me-1" aria-hidden="true"></i>@Localizer["Accounts.Privacy.DeleteItem4"]</li>
        </ul>
        <button type="button" class="btn btn-sm btn-outline-danger mb-0"
                data-bs-toggle="modal" data-bs-target="#deleteDataModal">
            <i class="bi bi-shield-x me-1" aria-hidden="true"></i>@Localizer["Accounts.Privacy.DeleteHeading"]
        </button>
    </div>

    @* ── Cancel pending deletion ──────────────────────────────── *@
    <div class="card-body">
        <h6 class="mb-1"><i class="bi bi-arrow-counterclockwise me-2" aria-hidden="true"></i>@Localizer["Accounts.Privacy.CancelHeading"]</h6>
        <p class="small text-muted mb-3">@Localizer["Accounts.Privacy.CancelHelp"]</p>
        <form asp-area="Accounts" asp-controller="Privacy" asp-action="CancelDeletion" method="post" class="mb-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-primary-soft mb-0">
                <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>@Localizer["Accounts.Privacy.CancelButton"]
            </button>
        </form>
    </div>
</div>

@* ── Typed-confirmation modal for the destructive delete-data action ─────────── *@
<div class="modal fade" id="deleteDataModal" tabindex="-1" aria-labelledby="deleteDataModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-area="Accounts" asp-controller="Privacy" asp-action="DeleteData" method="post" data-loading>
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteDataModalLabel">@Localizer["Accounts.Privacy.ModalTitle"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Accounts.Confirm.Close"]"></button>
                </div>
                <div class="modal-body">
                    <p class="small mb-2">@Localizer["Accounts.Privacy.ModalBody"]</p>
                        @{ var confirmToken = Localizer["Accounts.Privacy.DeleteConfirmToken"].Value; }
                        <label class="form-label small mb-1" for="confirmation">@Localizer["Accounts.Privacy.TypeToConfirm", confirmToken]</label>
                        <input type="text" class="form-control" id="confirmation" name="confirmation"
                               autocomplete="off" placeholder="@confirmToken" dir="auto" required />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-primary-soft mb-0" data-bs-dismiss="modal">@Localizer["Accounts.Privacy.KeepData"]</button>
                    <button type="submit" class="btn btn-sm btn-danger mb-0">
                        <i class="bi bi-shield-x me-1" aria-hidden="true"></i>@Localizer["Accounts.Privacy.DeleteHeading"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
