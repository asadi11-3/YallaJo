@model YallaJo.Web.Areas.Accounts.Models.Settings.SettingsVm
@* Phase 2 (Accounts plan): Linked accounts tab — display-only provider list, extracted from Settings/Index. *@

<div class="card border">
    <div class="card-header border-bottom">
        <h4 class="card-header-title mb-0">Linked accounts</h4>
        <p class="mb-0 small">Connect a social account to sign in faster.</p>
    </div>
    <div class="card-body">
        <p class="text-body-secondary small">
            To link a social account, sign out and use “Continue with…” on the sign-in page.
            You can remove a previously linked account below.
        </p>
        <ul class="list-group list-group-flush">
            @foreach (var provider in Model.LinkedAccounts)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                    <span>
                        <i class="bi bi-box-arrow-in-right me-2"></i>@provider.DisplayName
                    </span>
                    <a asp-area="Auth" asp-controller="ExternalProviders" asp-action="Index"
                       class="btn btn-sm btn-outline-secondary mb-0">Manage</a>
                </li>
            }
        </ul>
    </div>
</div>
