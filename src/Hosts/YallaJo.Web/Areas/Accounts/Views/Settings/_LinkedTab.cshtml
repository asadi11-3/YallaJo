@model YallaJo.Web.Areas.Accounts.Models.Settings.SettingsVm
@* Phase 2 (Accounts plan): Linked accounts tab — display-only provider list, extracted from Settings/Index. *@

<div class="card border">
    <div class="card-header border-bottom">
        <h4 class="card-header-title mb-0">@Localizer["Accounts.Settings.Tab.Linked"]</h4>
        <p class="mb-0 small">@Localizer["Accounts.Linked.Hint"]</p>
    </div>
    <div class="card-body">
        <p class="text-body-secondary small">@Localizer["Accounts.Linked.HelpText"]</p>
        <ul class="list-group list-group-flush">
            @foreach (var provider in Model.LinkedAccounts)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                    <span>
                        <i class="bi bi-box-arrow-in-right me-2" aria-hidden="true"></i>@provider.DisplayName
                    </span>
                    <a asp-area="Auth" asp-controller="ExternalProviders" asp-action="Index"
                       class="btn btn-sm btn-outline-secondary mb-0">@Localizer["Accounts.Overview.Manage"]</a>
                </li>
            }
        </ul>
    </div>
</div>
