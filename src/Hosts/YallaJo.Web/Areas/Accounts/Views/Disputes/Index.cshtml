@model YallaJo.Web.Areas.Accounts.Models.Disputes.DisputesVm
@using YallaJo.Web.Areas.Accounts.Shared
@{
    ViewData["Title"] = "My Disputes";
    ViewData["AccountNav"] = "Disputes";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as AccountSidebarVm ?? new AccountSidebarVm();
}

<section class="pt-3">
    <div class="container">
        <div class="row g-4 g-xl-5">
            <partial name="_AccountSidebar" model="sidebar" />

            <div class="col-lg-8 col-xl-9">
                <div class="d-grid d-lg-none mb-3">
                    <button class="btn btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasSidebar">
                        <i class="fas fa-sliders-h me-2"></i>Account menu
                    </button>
                </div>

                <div class="card border">
                    <div class="card-header border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <h1 class="card-header-title h4 mb-0">My Disputes</h1>
                        @if (Model.CanOpenDispute)
                        {
                            <button type="button" class="btn btn-sm btn-primary mb-0" data-bs-toggle="modal" data-bs-target="#openDisputeModal">
                                <i class="bi bi-plus-lg me-1"></i>Open a dispute
                            </button>
                        }
                    </div>

                    <div class="card-body">
                        @if (!Model.HasDisputes)
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-shield-check display-5 text-secondary mb-3 d-block"></i>
                                <h2 class="h6 mb-1">No disputes</h2>
                                <p class="text-muted mb-3">If something went wrong with a payment, you can raise a dispute and our team will look into it.</p>
                                @if (Model.CanOpenDispute)
                                {
                                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#openDisputeModal">
                                        Open a dispute
                                    </button>
                                }
                                else
                                {
                                    <p class="small text-muted mb-0">You don't have any payments that can be disputed yet.</p>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th scope="col">Reason</th>
                                            <th scope="col">Status</th>
                                            <th scope="col">Opened</th>
                                            <th scope="col">Resolution</th>
                                            <th scope="col" class="text-end">Links</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var d in Model.Disputes)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="fw-semibold d-block">@d.Reason</span>
                                                    <span class="small text-muted">@d.Description</span>
                                                </td>
                                                <td><span class="badge @d.StatusBadgeClass">@d.Status</span></td>
                                                <td class="small text-muted">@d.CreatedAt.ToString("d MMM yyyy")</td>
                                                <td class="small">
                                                    @if (d.IsResolved)
                                                    {
                                                        <span class="d-block">@(d.Resolution ?? "Resolved")</span>
                                                        @if (!string.IsNullOrWhiteSpace(d.ResolutionNotes))
                                                        {
                                                            <span class="text-muted">@d.ResolutionNotes</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <a asp-area="Accounts" asp-controller="Payments" asp-action="Index"
                                                       class="btn btn-sm btn-light border mb-0" title="View payments &amp; refunds">
                                                        <i class="bi bi-credit-card"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @* ── Pager (D1): driven only by HasPrevious/HasNext ───────── *@
                            @if (Model.HasPreviousPage || Model.HasNextPage)
                            {
                                <nav aria-label="Disputes pagination" class="mt-3">
                                    <ul class="pagination justify-content-center mb-0">
                                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                            <a class="page-link" asp-area="Accounts" asp-controller="Disputes" asp-action="Index"
                                               asp-route-page="@(Model.PageNumber - 1)" tabindex="@(Model.HasPreviousPage ? "0" : "-1")">Previous</a>
                                        </li>
                                        <li class="page-item disabled"><span class="page-link">Page @Model.PageNumber</span></li>
                                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                            <a class="page-link" asp-area="Accounts" asp-controller="Disputes" asp-action="Index"
                                               asp-route-page="@(Model.PageNumber + 1)" tabindex="@(Model.HasNextPage ? "0" : "-1")">Next</a>
                                        </li>
                                    </ul>
                                </nav>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── Open-dispute modal (ViewModel form + anti-forgery + F8 confirm) ──────────── *@
@if (Model.CanOpenDispute)
{
    <div class="modal fade" id="openDisputeModal" tabindex="-1" aria-labelledby="openDisputeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-area="Accounts" asp-controller="Disputes" asp-action="Open" method="post"
                      onsubmit="return confirm('Open this dispute? Our team will review it.');">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="openDisputeModalLabel">Open a dispute</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label" asp-for="Form.PaymentId">Payment</label>
                            <select class="form-select" asp-for="Form.PaymentId">
                                <option value="">Choose a payment…</option>
                                @foreach (var p in Model.DisputablePayments)
                                {
                                    <option value="@p.PaymentId">@p.Label</option>
                                }
                            </select>
                            <span asp-validation-for="Form.PaymentId" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" asp-for="Form.Reason">Reason</label>
                            <input class="form-control" asp-for="Form.Reason" maxlength="120" placeholder="e.g. Charged twice" />
                            <span asp-validation-for="Form.Reason" class="text-danger small"></span>
                        </div>
                        <div class="mb-1">
                            <label class="form-label" asp-for="Form.Description">Description</label>
                            <textarea class="form-control" asp-for="Form.Description" rows="4" maxlength="2000"
                                      placeholder="Describe what happened (at least 10 characters)."></textarea>
                            <span asp-validation-for="Form.Description" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light mb-0" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary mb-0">Submit dispute</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
