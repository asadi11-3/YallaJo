@model YallaJo.Web.Areas.Accounts.Models.Support.SupportTicketDetailVm
@using YallaJo.Web.Areas.Accounts.Shared
@using YallaJo.Web.Infrastructure.Authorization
@{
    ViewData["Title"] = "Support ticket";
    ViewData["AccountNav"] = "Support";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as AccountSidebarVm ?? new AccountSidebarVm();
}

<section class="pt-3">
    <div class="container">
        <div class="row g-4 g-xl-5">
            <partial name="_AccountSidebar" model="sidebar" />

            <div class="col-lg-8 col-xl-9">
                <partial name="_AccountMenuToggle" />

                <a asp-area="Accounts" asp-controller="Support" asp-action="Index" class="small d-inline-block mb-3 text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i>Back to my tickets
                </a>

                <partial name="_SupportTicketCard" model="Model" />
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/assets/js/provider-actions.js" asp-append-version="true"></script>
    <script src="~/assets/js/accounts-support.js" asp-append-version="true"></script>
}
