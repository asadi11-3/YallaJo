@model YallaJo.Web.Areas.Accounts.Models.Support.SupportTicketDetailVm
@using YallaJo.Web.Areas.Accounts.Shared
@using YallaJo.Web.Infrastructure.Authorization
@{
    ViewData["Title"] = "Support ticket";
    ViewData["AccountNav"] = "Support";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as AccountSidebarVm ?? new AccountSidebarVm();

    string TimeStamp(DateTime utc) => utc.ToString("dd MMM yyyy HH:mm") + " UTC";

    string StatusClass(string status) => status.ToLowerInvariant() switch
    {
        "closed" => "bg-secondary bg-opacity-10 text-secondary",
        "resolved" => "bg-success bg-opacity-10 text-success",
        "awaitinguser" => "bg-warning bg-opacity-10 text-warning",
        _ => "bg-primary bg-opacity-10 text-primary",
    };
}

<section class="pt-3">
    <div class="container">
        <div class="row g-4 g-xl-5">
            <partial name="_AccountSidebar" model="sidebar" />

            <div class="col-lg-8 col-xl-9">
                <partial name="_AccountMenuToggle" />

                <a asp-area="Accounts" asp-controller="Support" asp-action="Index" class="small d-inline-block mb-3 text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i>Back to my tickets
                </a>

                <div class="card border mb-4">
                    <div class="card-header border-bottom d-flex justify-content-between align-items-start">
                        <div class="me-2">
                            <h4 class="card-header-title mb-1">@Model.Subject</h4>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary small me-2">@Model.Category</span>
                            <span class="small text-muted">Opened @TimeStamp(Model.CreatedAt)</span>
                        </div>
                        <span class="badge @StatusClass(Model.Status) flex-shrink-0">@Model.Status</span>
                    </div>

                    <div class="card-body p-3">
                        @* ── Message thread (internal staff notes are excluded by the mapper) ── *@
                        @if (Model.Messages.Count == 0)
                        {
                            <p class="text-muted small text-center py-3 mb-0">No messages on this ticket yet.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var m in Model.Messages)
                                {
                                    <li class="mb-3">
                                        <div class="d-flex @(m.IsFromStaff ? "" : "justify-content-end")">
                                            <div class="rounded p-2 @(m.IsFromStaff ? "bg-light" : "bg-primary bg-opacity-10") max-w-80">
                                                <div class="small fw-bold mb-1">@(m.IsFromStaff ? "Support team" : "You")</div>
                                                <div class="small">@m.Body</div>
                                                <div class="small text-muted mt-1">@TimeStamp(m.CreatedAt)</div>
                                            </div>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    @if (Model.CanReply)
                    {
                        <div class="card-body border-top">
                            <form asp-area="Accounts" asp-controller="Support" asp-action="Reply" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <label class="form-label small mb-1" for="body">Reply</label>
                                <textarea class="form-control mb-2" id="body" name="body" rows="3"
                                          maxlength="4000" required placeholder="Type your reply…"></textarea>
                                <button type="submit" class="btn btn-sm btn-primary mb-0">Send reply</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="card-body border-top">
                            <p class="small text-muted mb-0">
                                This ticket is @Model.Status.ToLowerInvariant()@(Model.ClosedAt is { } c ? $" since {TimeStamp(c)}" : "") and can no longer be replied to.
                            </p>
                        </div>
                    }

                    @if (Model.CanClose)
                    {
                        <permission require="@WebPermission.SupportTicket.Close">
                            <div class="card-footer border-top text-end">
                                <form asp-area="Accounts" asp-controller="Support" asp-action="Close" asp-route-id="@Model.Id" method="post"
                                      class="m-0" data-confirm="@Localizer["Accounts.Confirm.CloseTicket"]" data-confirm-title="@Localizer["Public.Confirm.Title"]" data-confirm-action="@Localizer["Accounts.Confirm.Close"]" data-confirm-cancel="@Localizer["Public.Confirm.Cancel"]">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger mb-0">Close ticket</button>
                                </form>
                            </div>
                        </permission>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
