@model YallaJo.Web.Areas.Accounts.Models.Bookings.BookingDetailVm
@using YallaJo.Web.Areas.Accounts.Shared
@using YallaJo.Web.Infrastructure.Authorization
@{
    ViewData["Title"] = "Manage Booking";
    ViewData["AccountNav"] = "Bookings";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as AccountSidebarVm ?? new AccountSidebarVm();

}

<section class="pt-3">
    <div class="container">
        <div class="row g-4 g-xl-5">
            <partial name="_AccountSidebar" model="sidebar" />

            <div class="col-lg-8 col-xl-9">
                <partial name="_AccountMenuToggle" />

                <div class="mb-3 d-flex flex-wrap gap-2">
                    <a class="btn btn-sm btn-light mb-0" asp-area="Accounts" asp-controller="Bookings" asp-action="Index">
                        <i class="bi bi-arrow-left me-1"></i>Back to bookings
                    </a>
                    @* Phase 3 (Accounts plan): invoices live on the Billing hub now. *@
                    <a class="btn btn-sm btn-light mb-0" asp-area="Accounts" asp-controller="Payments" asp-action="Index" asp-route-tab="invoices">
                        <i class="bi bi-receipt me-1"></i>Invoices
                    </a>
                </div>

                <div class="card border mb-4">
                    <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                        <h4 class="card-header-title mb-0">@Model.TourName</h4>
                        <partial name="_StatusBadge" model="@Model.Status" />
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" class="img-fluid rounded mb-3 w-100 object-fit-cover img-max-h240" alt="@Model.TourName" />
                        }
                        <div class="row g-3 mb-2">
                            <div class="col-sm-6"><span class="text-muted small d-block">Reference</span><span class="d-inline-flex align-items-center gap-1"><strong id="bookingReference" dir="ltr">@Model.Reference</strong><button type="button" class="btn btn-sm btn-link p-0 js-copy-ref" data-copied-text="@Localizer["Public.Copied"]" title="@Localizer["Public.CopyReference"]" aria-label="@Localizer["Public.CopyReference"]"><i class="bi bi-clipboard" aria-hidden="true"></i></button></span></div>
                            <div class="col-sm-6"><span class="text-muted small d-block">Booked on</span><strong>@Model.CreatedAt.ToString("d MMM yyyy")</strong></div>
                            <div class="col-sm-6"><span class="text-muted small d-block">Guests</span><strong>@Model.ParticipantCount</strong></div>
                            <div class="col-sm-6"><span class="text-muted small d-block">Instant booking</span><strong>@(Model.IsInstantBooking ? "Yes" : "No")</strong></div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.SpecialRequests))
                        {
                            <div class="mt-2">
                                <span class="text-muted small d-block">Special requests</span>
                                <p class="mb-0">@Model.SpecialRequests</p>
                            </div>
                        }
                    </div>
                </div>

                <div class="card border mb-4">
                    <div class="card-header border-bottom"><h5 class="card-header-title mb-0">Price summary</h5></div>
                    <div class="card-body">
                        @foreach (var li in Model.LineItems)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span>@li.TierType &times; @li.Count</span>
                                <span>@((li.UnitPrice * li.Count).ToString("0.00")) @Model.Currency</span>
                            </div>
                        }
                        <hr />
                        <div class="d-flex justify-content-between mb-1"><span>Subtotal</span><span>@Model.Subtotal.ToString("0.00") @Model.Currency</span></div>
                        @if (Model.DiscountAmount > 0)
                        {
                            <div class="d-flex justify-content-between mb-1 text-success"><span>Discount</span><span>-@Model.DiscountAmount.ToString("0.00") @Model.Currency</span></div>
                        }
                        @if (Model.LoyaltyAmount > 0)
                        {
                            <div class="d-flex justify-content-between mb-1 text-success"><span>Loyalty</span><span>-@Model.LoyaltyAmount.ToString("0.00") @Model.Currency</span></div>
                        }
                        <div class="d-flex justify-content-between fw-bold border-top pt-2"><span>Total</span><span>@Model.TotalAmount.ToString("0.00") @Model.Currency</span></div>
                    </div>
                </div>

                @if (string.Equals(Model.Status, "AwaitingPayment", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="card border border-primary mb-3">
                        <div class="card-header border-bottom"><h5 class="card-header-title mb-0 text-primary">Complete payment</h5></div>
                        <div class="card-body">
                            <p class="small text-muted">Your booking is awaiting payment. Pay now to confirm it.</p>
                            <form asp-area="Accounts" asp-controller="Bookings" asp-action="Pay" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-primary mb-0">Pay now</button>
                            </form>
                        </div>
                    </div>
                }

                @if (Model.IsCancellable)
                {
                    <div class="card border border-danger">
                        <div class="card-header border-bottom"><h5 class="card-header-title mb-0 text-danger">Cancel booking</h5></div>
                        <div class="card-body">
                            <p class="small text-muted">Cancelling may be subject to the tour's cancellation policy. Any eligible refund is processed automatically.</p>
                            <form asp-area="Accounts" asp-controller="Bookings" asp-action="Cancel" asp-route-id="@Model.Id" method="post" data-loading data-confirm="@Localizer["Accounts.Booking.CancelConfirm"]" data-confirm-title="@Localizer["Accounts.Booking.CancelTitle"]" data-confirm-action="@Localizer["Accounts.Booking.CancelProceed"]" data-confirm-cancel="@Localizer["Accounts.Booking.KeepBooking"]">
                                @Html.AntiForgeryToken()
                                <div class="mb-3">
                                    <label class="form-label" for="reason">Reason (optional)</label>
                                    <textarea class="form-control" id="reason" name="reason" rows="2" maxlength="500"></textarea>
                                </div>
                                <button type="submit" class="btn btn-danger mb-0">Cancel this booking</button>
                            </form>
                        </div>
                    </div>
                }
                else if (Model.CancelledAt is not null)
                {
                    <div class="card border">
                        <div class="card-body">
                            <h6 class="text-danger mb-1">Booking cancelled</h6>
                            <p class="small text-muted mb-1">Cancelled on @Model.CancelledAt.Value.ToString("d MMM yyyy")</p>
                            @if (!string.IsNullOrWhiteSpace(Model.CancellationReason))
                            {
                                <p class="small mb-1">Reason: @Model.CancellationReason</p>
                            }
                            @if (Model.RefundAmount is > 0)
                            {
                                <p class="small text-success mb-0">Refund: @Model.RefundAmount.Value.ToString("0.00") @Model.Currency</p>
                            }
                        </div>
                    </div>
                }

                @* ── Dispute lifecycle (FE-1A) ─────────────────────────────────── *@
                @if (Model.IsDisputable)
                {
                    <permission require="@WebPermission.BookingDispute.Create">
                        <div class="card border border-warning mt-3">
                            <div class="card-header border-bottom"><h5 class="card-header-title mb-0 text-warning">Report an issue with this tour</h5></div>
                            <div class="card-body">
                                <p class="small text-muted">If something went wrong with your completed tour, you can open a dispute within 48 hours of completion. Our team will review it.</p>
                                <button type="button" class="btn btn-warning mb-0" data-bs-toggle="modal" data-bs-target="#disputeModal">
                                    <i class="bi bi-exclamation-triangle me-1"></i>Report an issue
                                </button>
                            </div>
                        </div>

                        <div class="modal fade" id="disputeModal" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <form asp-area="Accounts" asp-controller="Bookings" asp-action="OpenDispute" asp-route-id="@Model.Id" method="post" class="modal-content">
                                    @Html.AntiForgeryToken()
                                    <div class="modal-header">
                                        <h5 class="modal-title">Report an issue</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p class="small text-muted">Tell us what went wrong. This opens a formal dispute that our team will investigate.</p>
                                        <div class="mb-2">
                                            <label class="form-label" for="dispute-reason">What happened?</label>
                                            <textarea class="form-control" id="dispute-reason" name="reason" rows="4" minlength="10" maxlength="2000" required
                                                      placeholder="Describe the issue in at least 10 characters…"></textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-warning">Submit dispute</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </permission>
                }
                else if (Model.IsDisputed)
                {
                    <div class="card border border-warning mt-3">
                        <div class="card-body">
                            <h6 class="text-warning mb-1">Dispute under review</h6>
                            @if (Model.DisputedAt is not null)
                            {
                                <p class="small text-muted mb-1">Opened on @Model.DisputedAt.Value.ToString("d MMM yyyy")</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.DisputeReason))
                            {
                                <p class="small mb-0">Your report: @Model.DisputeReason</p>
                            }
                        </div>
                    </div>
                }
                else if (Model.IsResolved)
                {
                    <div class="card border mt-3">
                        <div class="card-body">
                            <h6 class="text-primary mb-1">Dispute resolved</h6>
                            @if (Model.ResolvedAt is not null)
                            {
                                <p class="small text-muted mb-1">Resolved on @Model.ResolvedAt.Value.ToString("d MMM yyyy")</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.ResolutionNotes))
                            {
                                <p class="small mb-0">Resolution: @Model.ResolutionNotes</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@* Phase 5c (Accounts plan): reuse the public copy-ref helper (#bookingReference + .js-copy-ref); its payment countdown no-ops when [data-expires-at] is absent. *@
@section Scripts {
    <script src="~/assets/js/booking-confirmation.js" asp-append-version="true"></script>
}
