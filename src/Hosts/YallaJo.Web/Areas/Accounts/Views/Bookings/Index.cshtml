@model YallaJo.Web.Areas.Accounts.Models.Bookings.BookingsVm
@using YallaJo.Web.Areas.Accounts.Shared
@{
    ViewData["Title"] = Localizer["Navbar.MyBookings"].Value;
    ViewData["AccountNav"] = "Bookings";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as AccountSidebarVm ?? new AccountSidebarVm();
    var tabs = Model.Tabs;
    var isJoinRequestsTab = string.Equals(Model.ActiveTab, "join-requests", StringComparison.OrdinalIgnoreCase);
    string TabLabel(string t) => t switch
    {
        "Upcoming" => Localizer["Accounts.Bookings.Tab.Upcoming"].Value,
        "Canceled" => Localizer["Accounts.Bookings.Tab.Canceled"].Value,
        "Completed" => Localizer["Accounts.Bookings.Tab.Completed"].Value,
        _ => t
    };
}

<section class="pt-3">
    <div class="container">
        <div class="row g-4 g-xl-5">
            <partial name="_AccountSidebar" model="sidebar" />

            <div class="col-lg-8 col-xl-9">
                <partial name="_AccountMenuToggle" />

                <div class="card border">
                    <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                        <h4 class="card-header-title mb-0">@Localizer["Navbar.MyBookings"]</h4>
                    </div>

                    <div class="card-body">
                        <ul class="nav nav-tabs nav-bottom-line mb-4 flex-nowrap overflow-auto">
                            @foreach (var tab in tabs)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(!isJoinRequestsTab && Model.ActiveTab == tab ? "active" : "")"
                                       asp-area="Accounts" asp-controller="Bookings" asp-action="Index" asp-route-tab="@tab">
                                        @TabLabel(tab)
                                    </a>
                                </li>
                            }
                            @* Phase 3 (Accounts plan): join requests folded into My Trips as an extra tab (PE1: real link). *@
                            <li class="nav-item">
                                <a class="nav-link @(isJoinRequestsTab ? "active" : "")"
                                   asp-area="Accounts" asp-controller="Bookings" asp-action="Index" asp-route-tab="join-requests">
                                    @Localizer["Accounts.Bookings.Tab.JoinRequests"]
                                </a>
                            </li>
                        </ul>

                        @if (!isJoinRequestsTab)
                        {
                            @* Phase 4e (Accounts plan): date-range filter — PE1 GET form, native date inputs, no JS. *@
                            <form method="get" asp-area="Accounts" asp-controller="Bookings" asp-action="Index" class="row g-2 align-items-end mb-3">
                                <input type="hidden" name="tab" value="@Model.ActiveTab" />
                                <div class="col-6 col-sm-4">
                                    <label class="form-label small mb-1" for="bookingFrom">@Localizer["Accounts.Bookings.From"]</label>
                                    <input type="date" class="form-control form-control-sm" id="bookingFrom" name="from" value="@Model.FromDate" />
                                </div>
                                <div class="col-6 col-sm-4">
                                    <label class="form-label small mb-1" for="bookingTo">@Localizer["Accounts.Bookings.To"]</label>
                                    <input type="date" class="form-control form-control-sm" id="bookingTo" name="to" value="@Model.ToDate" />
                                </div>
                                <div class="col-sm-4 d-flex align-items-end gap-2">
                                    <button type="submit" class="btn btn-sm btn-primary mb-0"><i class="bi bi-funnel me-1" aria-hidden="true"></i>@Localizer["Accounts.Bookings.Filter"]</button>
                                    @if (!string.IsNullOrEmpty(Model.FromDate) || !string.IsNullOrEmpty(Model.ToDate))
                                    {
                                        <a class="btn btn-sm btn-outline-secondary mb-0" asp-area="Accounts" asp-controller="Bookings" asp-action="Index" asp-route-tab="@Model.ActiveTab">@Localizer["Accounts.Bookings.ClearFilter"]</a>
                                    }
                                </div>
                            </form>
                        }

                        @if (isJoinRequestsTab)
                        {
                            <partial name="_JoinRequestsTab" model="Model.JoinRequests ?? new YallaJo.Web.Areas.Accounts.Models.JoinRequests.MyJoinRequestsVm()" />
                        }
                        else if (Model.Bookings.Count == 0)
                        {
                            @* Phase 1: shared empty state (UI-UX-L6) *@
                            <partial name="~/Areas/Public/Views/Shared/_EmptyState.cshtml" view-data='@(new ViewDataDictionary(ViewData)
                            {
                                { "title", Localizer["Accounts.Bookings.EmptyTitle"].Value },
                                { "message", Localizer["Accounts.Bookings.EmptyMessage"].Value }
                            })' />
                        }
                        else
                        {
                            <div class="vstack gap-3">
                                @foreach (var b in Model.Bookings)
                                {
                                    <div class="card border">
                                        <div class="row g-0 align-items-center">
                                            <div class="col-md-3">
                                                @if (!string.IsNullOrEmpty(b.ImageUrl))
                                                {
                                                    <img src="@b.ImageUrl" class="img-fluid rounded-start w-100 h-100 object-fit-cover min-h-120" alt="@b.TourName" />
                                                }
                                                else
                                                {
                                                    <div class="bg-light rounded-start w-100 h-100 d-flex align-items-center justify-content-center min-h-120">
                                                        <i class="bi bi-geo-alt display-6 text-secondary" aria-hidden="true"></i>
                                                    </div>
                                                }
                                            </div>
                                            <div class="col-md-9">
                                                <div class="card-body">
                                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                                        <div>
                                                            <h6 class="mb-1">@b.TourName</h6>
                                                            <p class="small text-muted mb-0">@Localizer["Accounts.Bookings.RefLabel"] <bdi>@b.Reference</bdi></p>
                                                        </div>
                                                        <partial name="_StatusBadge" model="@b.Status" />
                                                    </div>
                                                    <div class="d-flex flex-wrap gap-3 small text-muted mb-3">
                                                        <span><i class="bi bi-people me-1" aria-hidden="true"></i>@Localizer["Accounts.Booking.GuestCount", b.ParticipantCount]</span>
                                                        <span><i class="bi bi-calendar3 me-1" aria-hidden="true"></i>@b.Date.ToString("d MMM yyyy")</span>
                                                        <span><i class="bi bi-cash me-1" aria-hidden="true"></i><span dir="ltr">@b.TotalAmount.ToString("0.00") @b.Currency</span></span>
                                                    </div>
                                                    <a class="btn btn-sm btn-primary-soft mb-0"
                                                       asp-area="Accounts" asp-controller="Bookings" asp-action="Detail" asp-route-id="@b.Id">
                                                        @Localizer["Accounts.Bookings.ManageBooking"]
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @* Phase 3: join-request form client validation (PE1: native POST works without JS). *@
    <partial name="_ValidationScriptsPartial" />
}
