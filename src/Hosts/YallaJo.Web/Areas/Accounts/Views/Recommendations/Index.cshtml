@model YallaJo.Web.Areas.Accounts.Models.Recommendations.RecommendationsVm
@using YallaJo.Web.Areas.Accounts.Models.Recommendations
@using YallaJo.Web.Areas.Accounts.Shared
@{
    ViewData["Title"] = Localizer["Accounts.Nav.ForYou"].Value;
    ViewData["AccountNav"] = "Recommendations";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as AccountSidebarVm ?? new AccountSidebarVm();

    string Money(decimal? amount, string? currency)
    {
        if (amount is null) return "—";
        return string.IsNullOrWhiteSpace(currency)
            ? amount.Value.ToString("N2")
            : $"{amount.Value:N2} {currency}";
    }

    string Stars(decimal rating)
    {
        var full = (int)Math.Round(rating, MidpointRounding.AwayFromZero);
        return string.Concat(Enumerable.Range(1, 5).Select(i =>
            i <= full
                ? "<i class=\"bi bi-star-fill text-warning\" aria-hidden=\"true\"></i>"
                : "<i class=\"bi bi-star text-warning\" aria-hidden=\"true\"></i>"));
    }
}

<section class="pt-3">
    <div class="container">
        <div class="row g-4 g-xl-5">
            <partial name="_AccountSidebar" model="sidebar" />

            <div class="col-lg-8 col-xl-9">
                <partial name="_AccountMenuToggle" />

                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success" role="alert">@success</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger" role="alert">@error</div>
                }

                <div class="card border mb-4">
                    <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                        <h4 class="card-header-title mb-0">@Localizer["Accounts.Recommendations.Title"]</h4>
                        @if (Model.IsPersonalized)
                        {
                            <span class="badge bg-success bg-opacity-10 text-success">@Localizer["Accounts.Recommendations.Personalized"]</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary bg-opacity-10 text-secondary">@Localizer["Accounts.Recommendations.PopularPicks"]</span>
                        }
                    </div>
                    <div class="card-body">
                        @if (!Model.HasRecommendations)
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-stars display-5 text-body-secondary d-block mb-2" aria-hidden="true"></i>
                                <h6 class="mb-1">@Localizer["Accounts.Recommendations.EmptyTitle"]</h6>
                                <p class="text-body-secondary mb-0">@Localizer["Accounts.Recommendations.EmptyMessage"]</p>
                            </div>
                        }
                        else
                        {
                            @* Phase 4c: optimistic dismiss (NF6) + click tracking (JS5) via accounts-recommendations.js; native PRG preserved (PE1). *@
                            <div class="row g-4" id="recommendationsGrid" data-yj-component="recommendations" aria-live="polite" data-dismissed-text="@Localizer["Accounts.Recommendations.Dismissed"]" data-failed-text="@Localizer["Accounts.Recommendations.DismissFailed"]">
                                @foreach (var item in Model.Recommendations)
                                {
                                    <div class="col-md-6 js-rec-item">
                                        <div class="card card-body border h-100">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <span class="badge bg-primary bg-opacity-10 text-primary">@item.KindLabel</span>
                                                <div class="hstack gap-1">
                                                    @if (item.IsPinned)
                                                    {
                                                        <span class="badge bg-warning bg-opacity-10 text-warning" title="@Localizer["Accounts.Recommendations.EditorsChoice"]"><i class="bi bi-bookmark-star" aria-hidden="true"></i><span class="visually-hidden">@Localizer["Accounts.Recommendations.EditorsChoice"]</span></span>
                                                    }
                                                    @if (item.IsBoosted)
                                                    {
                                                        <span class="badge bg-info bg-opacity-10 text-info">@Localizer["Accounts.Recommendations.Promoted"]</span>
                                                    }
                                                    @if (item.IsFeatured)
                                                    {
                                                        <span class="badge bg-secondary bg-opacity-10 text-secondary">@Localizer["Accounts.Recommendations.Featured"]</span>
                                                    }
                                                </div>
                                            </div>

                                            <h6 class="mb-1">
                                                @if (item.DetailUrl is { } url)
                                                {
                                                    <a class="text-reset js-rec-link" href="@url" data-track-type="@item.Kind" data-track-id="@item.Id">@item.Name</a>
                                                }
                                                else
                                                {
                                                    @item.Name
                                                }
                                            </h6>

                                            <div class="small text-body-secondary mb-2">
                                                @Html.Raw(Stars(item.AverageRating))
                                                <span class="ms-2">@Localizer["Accounts.Recommendations.BookingsCount", item.BookingCount]</span>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(item.BadgeText))
                                            {
                                                <div class="mb-2"><span class="badge bg-danger bg-opacity-10 text-danger">@item.BadgeText</span></div>
                                            }

                                            @if (item.Signals.Count > 0)
                                            {
                                                <div class="d-flex flex-wrap gap-1 mb-3">
                                                    @foreach (var signal in item.Signals)
                                                    {
                                                        <span class="badge rounded-pill bg-light text-dark border" title="@signal.Description">@signal.Title</span>
                                                    }
                                                </div>
                                            }

                                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                                <span class="fw-bold" dir="ltr">@Money(item.BasePrice, item.Currency)</span>
                                                <form asp-area="Accounts" asp-controller="Recommendations" asp-action="NotInterested" method="post" class="m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="kind" value="@((byte)item.Kind)" />
                                                    <input type="hidden" name="entityId" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="@Localizer["Accounts.Recommendations.NotInterested"]" aria-label="@Localizer["Accounts.Recommendations.NotInterested"]">
                                                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="card border">
                    <div class="card-header border-bottom">
                        <h4 class="card-header-title mb-0">@Localizer["Accounts.Recommendations.PreferencesTitle"]</h4>
                    </div>
                    <div class="card-body">
                        <form asp-area="Accounts" asp-controller="Recommendations" asp-action="UpdatePreferences" method="post" data-loading>
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Preferences.BudgetTier" class="form-label"></label>
                                    <select asp-for="Preferences.BudgetTier" class="form-select">
                                        <option value="">@Localizer["Accounts.Recommendations.NoPreference"]</option>
                                        @foreach (var option in PreferencesFormVm.BudgetOptions)
                                        {
                                            <option value="@option">@option</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Preferences.CurrentTripStage" class="form-label"></label>
                                    <select asp-for="Preferences.CurrentTripStage" class="form-select">
                                        <option value="">@Localizer["Accounts.Recommendations.NotSet"]</option>
                                        @foreach (var stage in PreferencesFormVm.TripStageOptions)
                                        {
                                            <option value="@stage">@PreferencesFormVm.TripStageLabel(stage)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        <input asp-for="Preferences.IsFamilyTraveler" class="form-check-input" />
                                        <label asp-for="Preferences.IsFamilyTraveler" class="form-check-label"></label>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary">@Localizer["Accounts.Settings.SavePreferences"]</button>
                            </div>
                        </form>
                    </div>
                </div>

                @* §3.6 — cold-start onboarding quiz. Uses the current recommendation rows as the
                   quiz options; each is marked 👍 interested or 👎 not interested, posted as
                   "Kind:EntityId" tokens to the Onboarding action. *@
                @if (Model.HasRecommendations)
                {
                    <div class="card border mt-4">
                        <div class="card-header border-bottom">
                            <h4 class="card-header-title mb-0">@Localizer["Accounts.Recommendations.OnboardingTitle"]</h4>
                            <p class="small text-body mb-0">@Localizer["Accounts.Recommendations.OnboardingHint"]</p>
                        </div>
                        <div class="card-body">
                            <form asp-area="Accounts" asp-controller="Recommendations" asp-action="Onboarding" method="post">
                                @Html.AntiForgeryToken()
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                                <ul class="list-unstyled mb-3">
                                    @foreach (var rec in Model.Recommendations)
                                    {
                                        var token = $"{rec.Kind}:{rec.Id}";
                                        var groupName = $"onb-{rec.Id}";
                                        <li class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                            <span class="text-body"><bdi>@rec.Name</bdi> <span class="badge bg-light text-body ms-1">@rec.KindLabel</span></span>
                                            <span class="btn-group btn-group-sm" role="group" aria-label="@string.Format(Localizer["Accounts.Recommendations.PreferenceFor"].Value, rec.Name)">
                                                <input type="radio" class="btn-check" name="@groupName" id="@($"{groupName}-up")" value="up" autocomplete="off" />
                                                <label class="btn btn-outline-success" for="@($"{groupName}-up")"
                                                       data-onb-token="@token" data-onb-list="Interested"><i class="bi bi-hand-thumbs-up" aria-hidden="true"></i></label>
                                                <input type="radio" class="btn-check" name="@groupName" id="@($"{groupName}-down")" value="down" autocomplete="off" />
                                                <label class="btn btn-outline-danger" for="@($"{groupName}-down")"
                                                       data-onb-token="@token" data-onb-list="NotInterested"><i class="bi bi-hand-thumbs-down" aria-hidden="true"></i></label>
                                            </span>
                                        </li>
                                    }
                                </ul>
                                @* Hidden inputs populated by the script below from the selected radios. *@
                                <div id="onb-hidden-inputs"></div>
                                <button type="submit" class="btn btn-primary">@Localizer["Accounts.Recommendations.PersonaliseFeed"]</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/recommendations-onboarding.js" asp-append-version="true" defer></script>
    <script src="~/assets/js/accounts-recommendations.js" asp-append-version="true"></script>
}
