@model YallaJo.Web.Areas.Accounts.Models.Reviews.ReviewsHubVm
@using YallaJo.Web.Areas.Accounts.Shared
@using YallaJo.Web.Infrastructure.Authorization
@{
    ViewData["Title"] = "My Reviews";
    ViewData["AccountNav"] = "Reviews";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sidebar = ViewBag.Sidebar as AccountSidebarVm ?? new AccountSidebarVm();
    var activeTab = (Model.ActiveTab ?? "mine").ToLowerInvariant();

    string TabClass(string name) => activeTab == name ? "nav-link active" : "nav-link";
    string PaneClass(string name) => activeTab == name ? "tab-pane fade show active" : "tab-pane fade";
    string Selected(string name) => activeTab == name ? "true" : "false";
}

@* Phase 3 (Accounts plan): Reviews hub — my reviews + accessibility reviews as tabs (R2/PE1).
   The retired /accounts/accessibility-reviews page 301s here with ?tab=accessibility. *@
<section class="pt-3">
    <div class="container">
        <div class="row g-4 g-xl-5">
            <partial name="_AccountSidebar" model="sidebar" />

            <div class="col-lg-8 col-xl-9">
                <partial name="_AccountMenuToggle" />

                <ul class="nav nav-tabs nav-bottom-line mb-4 flex-nowrap overflow-auto" id="reviewsTabs" data-yj-component="account-tabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="@TabClass("mine")" id="tab-mine" data-bs-toggle="tab" data-bs-target="#pane-mine" type="button" role="tab" aria-controls="pane-mine" aria-selected="@Selected("mine")">
                            <i class="bi bi-star fa-fw me-1" aria-hidden="true"></i>@Localizer["Accounts.Reviews.Tab.Mine"]
                        </button>
                    </li>
                    <permission require="@WebPermission.AccessibilityReview.Read">
                        <li class="nav-item" role="presentation">
                            <button class="@TabClass("accessibility")" id="tab-accessibility" data-bs-toggle="tab" data-bs-target="#pane-accessibility" type="button" role="tab" aria-controls="pane-accessibility" aria-selected="@Selected("accessibility")">
                                <i class="bi bi-universal-access fa-fw me-1" aria-hidden="true"></i>@Localizer["Accounts.Reviews.Tab.Accessibility"]
                            </button>
                        </li>
                    </permission>
                </ul>

                <div class="tab-content">
                    <div class="@PaneClass("mine")" id="pane-mine" role="tabpanel" aria-labelledby="tab-mine" tabindex="0">
                        <partial name="_MyReviewsTab" model="Model.Reviews" />
                    </div>
                    <permission require="@WebPermission.AccessibilityReview.Read">
                        <div class="@PaneClass("accessibility")" id="pane-accessibility" role="tabpanel" aria-labelledby="tab-accessibility" tabindex="0">
                            <partial name="_AccessibilityReviewsTab" model="Model.Accessibility" />
                        </div>
                    </permission>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/accounts-settings.js" asp-append-version="true"></script>
}
