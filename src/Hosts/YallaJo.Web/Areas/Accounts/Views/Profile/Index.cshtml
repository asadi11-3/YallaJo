@model YallaJo.Web.Areas.Accounts.Models.Profile.ProfileVm
@{
    ViewData["Title"] = Localizer["Navbar.MyProfile"].Value;
    ViewData["AccountNav"] = "Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var displayName = string.IsNullOrWhiteSpace(Model.DisplayName)
        ? $"{Model.FirstName} {Model.LastName}".Trim()
        : Model.DisplayName;

    var sidebar = new YallaJo.Web.Areas.Accounts.Shared.AccountSidebarVm
    {
        AvatarUrl = Model.AvatarUrl,
        DisplayName = displayName,
        Email = Model.Email
    };

    // Profile-completion: derive from field presence (the /security/me endpoint
    // does not expose verified flags, so completion is computed from the data we have).
    var checks = new (string Label, bool Done)[]
    {
        (Localizer["Accounts.Profile.CheckName"].Value, !string.IsNullOrWhiteSpace(Model.FirstName) && !string.IsNullOrWhiteSpace(Model.LastName)),
        (Localizer["Accounts.Profile.CheckEmail"].Value, !string.IsNullOrWhiteSpace(Model.Email)),
        (Localizer["Accounts.Profile.CheckMobile"].Value, !string.IsNullOrWhiteSpace(Model.PhoneNumber)),
        (Localizer["Accounts.Profile.CheckDob"].Value, Model.DateOfBirth is not null),
        (Localizer["Accounts.Profile.CheckAddress"].Value, !string.IsNullOrWhiteSpace(Model.AddressLine) || !string.IsNullOrWhiteSpace(Model.City) || !string.IsNullOrWhiteSpace(Model.Country)),
    };
    var doneCount = checks.Count(c => c.Done);
    var pct = checks.Length == 0 ? 0 : (int)System.Math.Round(100.0 * doneCount / checks.Length);

    ViewBag.AvatarUrl = Model.AvatarUrl;
}

<section class="pt-3">
    <div class="container">
        <div class="row g-4 g-xl-5">
            <partial name="_AccountSidebar" model="sidebar" />

            <div class="col-lg-8 col-xl-9">
                <partial name="_AccountMenuToggle" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="vstack gap-4">
                    @* ── Complete Your Profile ──────────────────────────────── *@
                    <div class="bg-light rounded p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="mb-0">@Localizer["Accounts.Profile.CompleteTitle"]</h5>
                            <span class="fw-bold" dir="ltr">@pct%</span>
                        </div>
                        <div class="progress progress-sm bg-success bg-opacity-10" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                            @* Inline style justified (UI-PERF-X6): width is a runtime-computed percentage. *@
                            <div class="progress-bar bg-success" style="width:@(pct)%"></div>
                        </div>
                        <div class="bg-body rounded p-3 mt-3">
                            <ul class="list-inline hstack flex-wrap gap-3 mb-0">
                                @foreach (var c in checks)
                                {
                                    <li class="list-inline-item mb-0">
                                        @if (c.Done)
                                        {
                                            <i class="bi bi-check-circle-fill text-success me-1" aria-hidden="true"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-plus-circle-fill text-primary me-1" aria-hidden="true"></i>
                                        }
                                        @c.Label
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                    @* ── Personal Information ───────────────────────────────── *@
                    <div class="card border">
                        <div class="card-header border-bottom">
                            <h4 class="card-header-title mb-0">@Localizer["Accounts.Profile.PersonalInfo"]</h4>
                        </div>
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-4">
                                <span class="avatar avatar-xl me-3 avatar-editable">
                                    <img class="avatar-img rounded-circle border border-white border-3"
                                         data-avatar-img
                                         src="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? Url.Content("~/assets/images/avatar/01.jpg") : Model.AvatarUrl)"
                                         alt="@Localizer["Accounts.Nav.AvatarAlt"]">
                                    <button type="button" class="avatar-editable__trigger" data-avatar-edit-trigger
                                            title="@Localizer["Accounts.Profile.PhotoEdit"]" aria-label="@Localizer["Accounts.Profile.PhotoEdit"]">
                                        <i class="bi bi-camera-fill" aria-hidden="true"></i>
                                    </button>
                                </span>
                                <div>
                                    <h6 class="mb-1">@displayName</h6>
                                    <p class="text-body-secondary small mb-0">@Model.Email</p>
                                </div>
                            </div>

                            <form asp-area="Accounts" asp-controller="Profile" asp-action="Update" method="post" data-loading>
                                @Html.AntiForgeryToken()
                                <partial name="_UpdateProfileForm" model="Model.Update" />
                            </form>
                        </div>
                    </div>

                    @* ── Update password ────────────────────────────────────── *@
                    <div class="card border">
                        <div class="card-header border-bottom">
                            <h4 class="card-header-title mb-0">@Localizer["Accounts.Settings.UpdatePassword"]</h4>
                            <p class="mb-0 mt-1 small">@Localizer["Accounts.Settings.PasswordHint"]</p>
                        </div>
                        <div class="card-body">
                            <form asp-area="Accounts" asp-controller="ChangePassword" asp-action="Index" method="post" class="row g-3" data-loading>
                                @Html.AntiForgeryToken()
                                @* Phase 2 (Accounts plan): PRG returns here instead of the retired change-password page. *@
                                <input type="hidden" name="returnUrl" value="@(Url.Action("Index", "Profile", new { area = "Accounts" }))" />
                                <div class="col-12">
                                    <label for="CurrentPassword" class="form-label">@Localizer["Accounts.Settings.CurrentPassword"]</label>
                                    <input type="password" id="CurrentPassword" name="CurrentPassword" class="form-control" autocomplete="current-password" />
                                </div>
                                <div class="col-12">
                                    <label for="psw-input" class="form-label">@Localizer["Accounts.Settings.NewPassword"]</label>
                                    <div class="input-group">
                                        <input type="password" id="psw-input" name="NewPassword" class="form-control fakepassword" autocomplete="new-password" />
                                        <span class="input-group-text p-0 bg-transparent">
                                            <i class="fakepasswordicon fas fa-eye-slash cursor-pointer p-2" aria-hidden="true"></i>
                                        </span>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label for="ConfirmNewPassword" class="form-label">@Localizer["Accounts.Settings.ConfirmNewPassword"]</label>
                                    <input type="password" id="ConfirmNewPassword" name="ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                                </div>
                                <div class="col-12 text-end">
                                    <button type="submit" class="btn btn-primary mb-0">@Localizer["Accounts.Settings.ChangePassword"]</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Reusable profile-photo editor — a single instance shared by the Personal
       Information camera control and the sidebar pencil overlay. *@
    <partial name="_AvatarEditor" />
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/profile-avatar.js" asp-append-version="true"></script>
}
