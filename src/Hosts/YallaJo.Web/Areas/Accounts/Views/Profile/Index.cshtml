@model YallaJo.Web.Areas.Accounts.Models.Profile.ProfileVm
@using YallaJo.Web.Areas.Accounts.Models.Promo
@{
    ViewData["Title"] = Localizer["Navbar.MyProfile"].Value;
    ViewData["AccountNav"] = "Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var promoByKey = Model.Promos.ToDictionary(p => p.PlacementKey, StringComparer.OrdinalIgnoreCase);
    PromoBlockVm Slot(string key) => promoByKey.GetValueOrDefault(key)
        ?? new PromoBlockVm { PlacementKey = key, Title = string.Empty, IsActive = false };

    var displayName = string.IsNullOrWhiteSpace(Model.DisplayName)
        ? $"{Model.FirstName} {Model.LastName}".Trim()
        : Model.DisplayName;

    var sidebar = new YallaJo.Web.Areas.Accounts.Shared.AccountSidebarVm
    {
        AvatarUrl = Model.AvatarUrl,
        DisplayName = displayName,
        Email = Model.Email
    };

    ViewBag.AvatarUrl = Model.AvatarUrl;
}

<section class="pt-3">
    <div class="container">
        <div class="row g-4 g-xl-5">
            <partial name="_AccountSidebar" model="sidebar" />

            <div class="col-lg-8 col-xl-6">
                <partial name="_AccountMenuToggle" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <partial name="_ProfileCard" model="Model" />
            </div>

            @* ── Right rail: promotional placements ─────────────────────── *@
            @{
                var promoTop = Slot("MyProfile.RightRail.Top");
                var promoMiddle = Slot("MyProfile.RightRail.Middle");
                var promoBottom = Slot("MyProfile.RightRail.Bottom");
                var promoBanner = Slot("MyProfile.BottomBanner");
            }
            <div class="col-lg-12 col-xl-3">
                <div class="vstack gap-4">
                    <partial name="_PromoCard" model="promoTop" />
                    <partial name="_PromoCard" model="promoMiddle" />
                    <partial name="_PromoCard" model="promoBottom" />
                </div>
            </div>
        </div>

        @* ── Bottom banner promo ─────────────────────────────────────────── *@
        <div class="row mt-4">
            <div class="col-12">
                <partial name="_PromoCard" model="promoBanner" />
            </div>
        </div>
    </div>

    @* Reusable profile-photo editor — a single instance shared by the Personal
       Information camera control and the sidebar pencil overlay. *@
    <partial name="_AvatarEditor" />

    @* Reusable promo editor — a single instance shared by every promo card
       pencil. Only rendered for Admin/SuperAdmin/Owner (gated inside the partial). *@
    <partial name="_PromoEditor" />
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/provider-actions.js" asp-append-version="true"></script>
    <script src="~/assets/js/profile-avatar.js" asp-append-version="true"></script>
    <script src="~/assets/js/profile-promo.js" asp-append-version="true"></script>
}
