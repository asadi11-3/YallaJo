@model YallaJo.Web.Areas.Accounts.Models.Profile.UpdateProfileVm
@*
    Partial rendered with UpdateProfileVm as the top-level model so input names
    render flat (FirstName, LastName, ...) and bind cleanly to the controller's
    UpdateProfileVm parameter. Do NOT render the <form> tag here — the parent
    view owns the form element and antiforgery token so the request shape
    matches the controller's attribute route exactly.
*@
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-2">
    <div class="col-md-6 mb-3">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>
</div>

<div class="row g-2">
    <div class="col-md-6 mb-3">
        <label asp-for="DateOfBirth" class="form-label"></label>
        <input asp-for="DateOfBirth" class="form-control" />
        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Gender" class="form-label"></label>
        <select asp-for="Gender"
                asp-items="Html.GetEnumSelectList<YallaJo.Web.Areas.Accounts.Models.Profile.GenderOption>()"
                class="form-select">
            <option value="">—</option>
        </select>
        <span asp-validation-for="Gender" class="text-danger"></span>
    </div>
</div>

<div class="row g-2">
    <div class="col-md-6 mb-3">
        <label asp-for="Country" class="form-label"></label>
        <input asp-for="Country" class="form-control" />
        <span asp-validation-for="Country" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="City" class="form-label"></label>
        <input asp-for="City" class="form-control" />
        <span asp-validation-for="City" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="AddressLine" class="form-label"></label>
    <input asp-for="AddressLine" class="form-control" />
    <span asp-validation-for="AddressLine" class="text-danger"></span>
</div>

<button type="submit" class="btn btn-primary">Save changes</button>
