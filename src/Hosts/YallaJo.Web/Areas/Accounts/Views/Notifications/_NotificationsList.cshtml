@model YallaJo.Web.Areas.Accounts.Models.Notifications.NotificationsInboxVm
@using YallaJo.Web.Areas.Accounts.Models.Notifications
@using YallaJo.Web.Infrastructure.Authorization
@*
    Phase 4 (Accounts plan): notifications list fragment.
    Rendered on first paint AND returned for AJAX "Load more" (UI-UX-L1/S1).
    accounts-notifications.js appends the items from this fragment into the existing list.
*@
@{
    string TimeAgo(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalMinutes < 1) return Localizer["Accounts.Notifications.JustNow"].Value;
        if (span.TotalMinutes < 60) return Localizer["Accounts.Notifications.MinutesAgo", (int)span.TotalMinutes].Value;
        if (span.TotalHours < 24) return Localizer["Accounts.Notifications.HoursAgo", (int)span.TotalHours].Value;
        if (span.TotalDays < 7) return Localizer["Accounts.Notifications.DaysAgo", (int)span.TotalDays].Value;
        return utc.ToString("dd MMM yyyy");
    }

    string LoadMoreUrl() => Url.Action("Index", "Notifications", new
    {
        area = "Accounts",
        status = Model.Filter.Status,
        type = Model.Filter.Type,
        fromDate = Model.Filter.FromDate,
        toDate = Model.Filter.ToDate,
        cursor = Model.NextCursor,
    })!;
}

@if (!Model.HasItems)
{
    <div class="text-center py-5">
        <i class="bi bi-bell-slash fs-1 text-muted d-block mb-2" aria-hidden="true"></i>
        <p class="text-muted mb-1">@Localizer["Accounts.Notifications.Empty"]</p>
        <a asp-area="Accounts" asp-controller="Settings" asp-action="Index" class="small">@Localizer["Accounts.Notifications.ManagePreferences"]</a>
    </div>
}
else
{
    <ul class="list-group list-group-flush js-notifications-items">
        @foreach (var n in Model.Items)
        {
            <li class="list-group-item px-2 @(n.IsRead ? "" : "bg-primary bg-opacity-10")">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="me-2">
                        <div class="d-flex align-items-center mb-1">
                            <h6 class="mb-0 @(n.IsRead ? "text-body" : "fw-bold")">@n.Title</h6>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary ms-2 small">@n.Type</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(n.Body))
                        {
                            <p class="mb-1 small text-body-secondary">@n.Body</p>
                        }
                        <span class="small text-muted" dir="ltr" title="@n.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC">@TimeAgo(n.CreatedAt)</span>
                        @if (!string.IsNullOrWhiteSpace(n.LinkUrl))
                        {
                            <a href="@n.LinkUrl" class="small ms-2">@Localizer["Accounts.Notifications.View"]</a>
                        }
                    </div>
                    <div class="d-flex gap-1 flex-shrink-0">
                        @if (!n.IsRead)
                        {
                            <form asp-area="" asp-controller="Notifications" asp-action="MarkRead" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@n.Id" />
                                <button type="submit" class="btn btn-sm btn-link p-0 text-decoration-none" title="@Localizer["Accounts.Notifications.MarkRead"]" aria-label="@Localizer["Accounts.Notifications.MarkRead"]"><i class="bi bi-check2" aria-hidden="true"></i></button>
                            </form>
                        }
                        <permission require="@WebPermission.Notification.Delete">
                            <form asp-area="Accounts" asp-controller="Notifications" asp-action="Delete" asp-route-id="@n.Id" method="post" class="m-0"
                                  data-confirm="@Localizer["Accounts.Confirm.DeleteNotification"]" data-confirm-title="@Localizer["Public.Confirm.Title"]" data-confirm-action="@Localizer["Public.Confirm.Delete"]" data-confirm-cancel="@Localizer["Public.Confirm.Cancel"]">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="status" value="@Model.Filter.Status" />
                                <input type="hidden" name="type" value="@Model.Filter.Type" />
                                <input type="hidden" name="fromDate" value="@Model.Filter.FromDate" />
                                <input type="hidden" name="toDate" value="@Model.Filter.ToDate" />
                                <button type="submit" class="btn btn-sm btn-link p-0 text-danger text-decoration-none" title="@Localizer["Public.Confirm.Delete"]" aria-label="@Localizer["Public.Confirm.Delete"]"><i class="bi bi-trash" aria-hidden="true"></i></button>
                            </form>
                        </permission>
                    </div>
                </div>
            </li>
        }
    </ul>

    <div class="text-center mt-3 js-notifications-loadmore">
        @if (Model.HasNextPage)
        {
            <a href="@LoadMoreUrl()" class="btn btn-sm btn-outline-secondary js-notifications-more">@Localizer["Accounts.Notifications.LoadMore"]</a>
        }
        else
        {
            <span class="small text-muted">@Localizer["Accounts.Notifications.End"]</span>
        }
    </div>
}
