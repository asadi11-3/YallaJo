@model YallaJo.Web.Areas.Accounts.Features.UpdatePhone.ViewModels.UpdatePhoneVm
@{
    ViewData["Title"] = "Update Phone Number";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-card">
    <h2>Update Phone Number</h2>

    @if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-area="Accounts" asp-controller="UpdatePhone" asp-action="Index" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="PhoneNumber" class="form-label"></label>
            <input asp-for="PhoneNumber" type="tel" class="form-control" autocomplete="tel" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">Save</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
