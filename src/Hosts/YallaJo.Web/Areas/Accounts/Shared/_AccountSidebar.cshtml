@model YallaJo.Web.Areas.Accounts.Shared.AccountSidebarVm
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    var active = ViewData["AccountNav"] as string ?? "Profile";
    string Pill(string key) => active == key ? "nav-link active" : "nav-link";
    var inSettings = active == "Settings" || active == "ChangePassword";
}

<div class="col-lg-4 col-xl-3">
    <div class="offcanvas-lg offcanvas-end" tabindex="-1" id="offcanvasSidebar">
        <div class="offcanvas-header justify-content-end pb-2">
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#offcanvasSidebar" aria-label="@Localizer["Accounts.Confirm.Close"]"></button>
        </div>
        <div class="offcanvas-body p-3 p-lg-0">
            <div class="card bg-light w-100">
                @{
                    // On the My Profile page the pencil opens the shared photo editor; on every
                    // other Accounts page it falls back to a link to the profile page.
                    var onProfile = (ViewData["AccountNav"] as string) == "Profile";
                }
                <div class="card-body p-3">
                    <div class="text-center mb-3">
                        <div class="avatar avatar-xl mb-2 avatar-editable avatar-editable--sidebar">
                            <img class="avatar-img rounded-circle border border-white border-3"
                                 data-avatar-img
                                 src="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? Url.Content("~/assets/images/avatar/01.jpg") : Model.AvatarUrl)"
                                 alt="@Localizer["Accounts.Nav.AvatarAlt"]">
                            @if (onProfile)
                            {
                                <button type="button" class="avatar-editable__trigger" data-avatar-edit-trigger
                                        title="@Localizer["Accounts.Profile.PhotoEdit"]" aria-label="@Localizer["Accounts.Profile.PhotoEdit"]">
                                    <i class="bi bi-pencil-fill" aria-hidden="true"></i>
                                </button>
                            }
                            else
                            {
                                <a asp-area="Accounts" asp-controller="Profile" asp-action="Index" class="avatar-editable__trigger"
                                   title="@Localizer["Accounts.Nav.EditProfile"]" aria-label="@Localizer["Accounts.Nav.EditProfile"]">
                                    <i class="bi bi-pencil-fill" aria-hidden="true"></i>
                                </a>
                            }
                        </div>
                        <h6 class="mb-0">@Model.DisplayName</h6>
                        <a asp-area="Accounts" asp-controller="Profile" asp-action="Index" class="text-reset text-primary-hover small">@Model.Email</a>
                        <hr>
                    </div>
                    <ul class="nav nav-pills-primary-soft flex-column">
                        <li class="nav-item">
                            <a class="@Pill("Overview")" asp-area="Accounts" asp-controller="Overview" asp-action="Index">
                                <i class="bi bi-grid fa-fw me-2" aria-hidden="true"></i>@Localizer["Accounts.Nav.Overview"]
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="@Pill("Profile")" asp-area="Accounts" asp-controller="Profile" asp-action="Index">
                                <i class="bi bi-person fa-fw me-2" aria-hidden="true"></i>@Localizer["Navbar.MyProfile"]
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="@Pill("Bookings")" asp-area="Accounts" asp-controller="Bookings" asp-action="Index">
                                <i class="bi bi-ticket-perforated fa-fw me-2" aria-hidden="true"></i>@Localizer["Navbar.MyBookings"]
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="@Pill("Notifications")" asp-area="Accounts" asp-controller="Notifications" asp-action="Index">
                                <i class="bi bi-bell fa-fw me-2" aria-hidden="true"></i>@Localizer["Accounts.Settings.Tab.Notifications"]
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="@Pill("Support")" asp-area="Accounts" asp-controller="Support" asp-action="Index">
                                <i class="bi bi-life-preserver fa-fw me-2" aria-hidden="true"></i>@Localizer["Accounts.Nav.Support"]
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="@Pill("Wishlist")" asp-area="Accounts" asp-controller="Wishlist" asp-action="Index">
                                <i class="bi bi-heart fa-fw me-2" aria-hidden="true"></i>@Localizer["Navbar.Wishlist"]
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="@Pill("Recommendations")" asp-area="Accounts" asp-controller="Recommendations" asp-action="Index">
                                <i class="bi bi-stars fa-fw me-2" aria-hidden="true"></i>@Localizer["Accounts.Nav.ForYou"]
                            </a>
                        </li>
                        @* Phase 3 (Accounts plan): Join Requests live on the My Trips tab; Accessibility Reviews on the Reviews hub; Invoices and Disputes on the Billing hub. *@
                        <li class="nav-item">
                            <a class="@Pill("Reviews")" asp-area="Accounts" asp-controller="Reviews" asp-action="Index">
                                <i class="bi bi-star fa-fw me-2" aria-hidden="true"></i>@Localizer["Accounts.Reviews.Tab.Mine"]
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="@Pill("Payments")" asp-area="Accounts" asp-controller="Payments" asp-action="Index">
                                <i class="bi bi-credit-card fa-fw me-2" aria-hidden="true"></i>@Localizer["Accounts.Nav.Billing"]
                            </a>
                        </li>
                        @* Settings group: flat link when outside Settings; expands to sub-items when inside the Settings area. *@
                        <li class="nav-item">
                            <a class="@(inSettings ? "nav-link active" : "nav-link")" asp-area="Accounts" asp-controller="Settings" asp-action="Index" aria-expanded="@(inSettings ? "true" : "false")">
                                <i class="bi bi-gear fa-fw me-2" aria-hidden="true"></i>@Localizer["Navbar.Settings"]
                            </a>
                            @if (inSettings)
                            {
                                <ul class="nav nav-pills-primary-soft flex-column ms-3 mt-1 border-start ps-2">
                                    <li class="nav-item">
                                        <a class="@(active == "ChangePassword" ? "nav-link active" : "nav-link")" asp-area="Accounts" asp-controller="ChangePassword" asp-action="Index" aria-current="@(active == "ChangePassword" ? "page" : null)">
                                            <i class="bi bi-shield-lock fa-fw me-2" aria-hidden="true"></i>@Localizer["Accounts.Nav.ChangePassword"]
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-area="Accounts" asp-controller="Settings" asp-action="Index" asp-route-tab="devices">
                                            <i class="bi bi-phone fa-fw me-2" aria-hidden="true"></i>@Localizer["Accounts.Settings.Tab.Devices"]
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-area="Accounts" asp-controller="Settings" asp-action="Index" asp-route-tab="linked">
                                            <i class="bi bi-box-arrow-in-right fa-fw me-2" aria-hidden="true"></i>@Localizer["Accounts.Settings.Tab.Linked"]
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-area="Accounts" asp-controller="Settings" asp-action="Index" asp-route-tab="privacy">
                                            <i class="bi bi-shield-check fa-fw me-2" aria-hidden="true"></i>@Localizer["Accounts.Settings.Tab.Privacy"]
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" asp-area="Accounts" asp-controller="Settings" asp-action="Index" asp-route-tab="account">
                                            <i class="bi bi-exclamation-triangle fa-fw me-2" aria-hidden="true"></i>@Localizer["Accounts.Settings.Tab.Account"]
                                        </a>
                                    </li>
                                </ul>
                            }
                        </li>
                        @* Phase 2 (Accounts plan): Privacy & Data and Delete Profile moved into the Settings hub tabs. *@
                        <li class="nav-item mt-2">
                            <form asp-area="Auth" asp-controller="Auth" asp-action="Logout" method="post" class="d-grid">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="nav-link text-start text-danger bg-danger-soft-hover border-0 bg-transparent w-100">
                                    <i class="fas fa-sign-out-alt fa-fw me-2" aria-hidden="true"></i>@Localizer["Navbar.SignOut"]
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
