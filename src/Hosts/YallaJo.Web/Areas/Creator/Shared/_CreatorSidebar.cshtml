@using Microsoft.Extensions.Localization
@model YallaJo.Web.Areas.Creator.Shared.CreatorSidebarVm
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    var active = ViewData["CreatorNav"] as string ?? "Dashboard";
    string Nav(string key) => active == key ? "nav-link active" : "nav-link";
    bool Current(string key) => active == key;
}

<section class="pt-4">
    <div class="container">
        <div class="card rounded-3 border p-3 pb-2">
            <div class="d-sm-flex align-items-center">
                <div class="avatar avatar-xl flex-shrink-0">
                    <img class="avatar-img rounded-circle border border-white border-3"
                         src="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? Url.Content("~/assets/images/avatar/01.jpg") : Model.AvatarUrl)"
                         alt="avatar">
                </div>
                <div class="ms-sm-3 mt-2 mt-sm-0">
                    <h5 class="mb-0"><span class="fw-light">@Localizer["Creator.Nav.Greeting"]</span> @(string.IsNullOrWhiteSpace(Model.DisplayName) ? Localizer["Creator.Nav.DefaultName"].Value : Model.DisplayName)</h5>
                    @if (!string.IsNullOrWhiteSpace(Model.Email))
                    {
                        <span class="small text-body-secondary"><bdi dir="ltr">@Model.Email</bdi></span>
                    }
                </div>
            </div>

            <button class="btn btn-primary w-100 d-block d-xl-none mt-3"
                    type="button" data-bs-toggle="offcanvas" data-bs-target="#creatorDashboardMenu"
                    aria-controls="creatorDashboardMenu">
                <i class="fa-solid fa-bars fa-fw me-1" aria-hidden="true"></i> @Localizer["Creator.Nav.Menu"]
            </button>

            <div class="offcanvas-xl offcanvas-end mt-xl-3" tabindex="-1" id="creatorDashboardMenu" aria-label="@Localizer["Creator.Nav.Aria"]">
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title">@Localizer["Creator.Nav.Menu"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#creatorDashboardMenu" aria-label="@Localizer["Creator.Nav.Close"]"></button>
                </div>
                <div class="offcanvas-body p-3 p-xl-0">
                    <nav class="navbar navbar-expand-xl w-100" aria-label="@Localizer["Creator.Nav.Aria"]">
                        <ul class="navbar-nav nav nav-pills nav-pills-primary-soft flex-xl-row flex-column w-100">
                            <permission require="@WebPermission.Creator.Read">
                                <li class="nav-item">
                                    <a class="@Nav("Dashboard")" aria-current="@(Current("Dashboard") ? "page" : null)" asp-area="Creator" asp-controller="Dashboard" asp-action="Index">
                                        <i class="fa-solid fa-house fa-fw me-1" aria-hidden="true"></i>@Localizer["Creator.Nav.Dashboard"]
                                    </a>
                                </li>
                            </permission>
                            <permission require="@WebPermission.Creator.Read">
                                <li class="nav-item">
                                    <a class="@Nav("Profile")" aria-current="@(Current("Profile") ? "page" : null)" asp-area="Creator" asp-controller="Profile" asp-action="Index">
                                        <i class="fa-solid fa-id-badge fa-fw me-1" aria-hidden="true"></i>@Localizer["Creator.Nav.Profile"]
                                    </a>
                                </li>
                            </permission>
                            <permission require="@WebPermission.Blog.ReadOwn">
                                <li class="nav-item">
                                    <a class="@Nav("Articles")" aria-current="@(Current("Articles") ? "page" : null)" asp-area="Creator" asp-controller="Articles" asp-action="Index">
                                        <i class="fa-solid fa-book-open fa-fw me-1" aria-hidden="true"></i>@Localizer["Creator.Nav.Articles"]
                                    </a>
                                </li>
                            </permission>
                            <permission require="@WebPermission.Creator.Read">
                                <li class="nav-item">
                                    <a class="@Nav("Audience")" aria-current="@(Current("Audience") ? "page" : null)" asp-area="Creator" asp-controller="Audience" asp-action="Index">
                                        <i class="fa-solid fa-users fa-fw me-1" aria-hidden="true"></i>@Localizer["Creator.Nav.Audience"]
                                    </a>
                                </li>
                            </permission>
                            <permission require="@WebPermission.Creator.Read">
                                <li class="nav-item">
                                    <a class="@Nav("Preview")" aria-current="@(Current("Preview") ? "page" : null)" asp-area="Creator" asp-controller="Preview" asp-action="Index">
                                        <i class="fa-solid fa-eye fa-fw me-1" aria-hidden="true"></i>@Localizer["Creator.Nav.Preview"]
                                    </a>
                                </li>
                            </permission>
                            <permission require="@WebPermission.Creator.Submit">
                                <li class="nav-item">
                                    <a class="@Nav("Application")" aria-current="@(Current("Application") ? "page" : null)" asp-area="Creator" asp-controller="Application" asp-action="Index">
                                        <i class="fa-solid fa-pen-to-square fa-fw me-1" aria-hidden="true"></i>@Localizer["Creator.Nav.Application"]
                                    </a>
                                </li>
                            </permission>
                            <li class="nav-item ms-xl-auto">
                                <form asp-area="Auth" asp-controller="Auth" asp-action="Logout" method="post" class="d-grid">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="nav-link text-start text-danger bg-danger-soft-hover border-0 bg-transparent w-100">
                                        <i class="fa-solid fa-right-from-bracket fa-fw me-1" aria-hidden="true"></i>@Localizer["Creator.Nav.SignOut"]
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</section>
