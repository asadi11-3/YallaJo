@model YallaJo.Web.Areas.Creator.Models.Audience.CreatorAudienceVm
@using YallaJo.Web.Areas.Creator.Models.Audience
@{
    ViewData["Title"] = "Audience";
    var sidebar = ViewBag.Sidebar as YallaJo.Web.Areas.Creator.Shared.CreatorSidebarVm
                  ?? new YallaJo.Web.Areas.Creator.Shared.CreatorSidebarVm();
}

<partial name="_CreatorSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-sm-flex justify-content-between align-items-center">
            <h1 class="fs-4 mb-0"><i class="bi bi-people me-2"></i>Audience</h1>
        </div>

        @if (Model.State != AudienceState.Active)
        {
            <div class="card border">
                <div class="card-body text-center py-5">
                    <h5>Audience data unavailable</h5>
                    <p class="text-body-secondary mb-0">
                        Your audience data is unavailable until your creator profile is active.
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0 small">
                <i class="bi bi-info-circle me-1"></i>This is a read-only view of your audience.
            </div>

            @* ── Authoritative follower count (from /profile/mine) ──────────── *@
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <div class="card card-body border text-center">
                        <h5 class="mb-0">@Model.FollowerCount</h5>
                        <span class="small text-body-secondary">Followers</span>
                    </div>
                </div>
            </div>

            @* ── Anonymous follower list (no identities exposed) ────────────── *@
            <div class="card border">
                <div class="card-header border-bottom">
                    <h5 class="card-header-title mb-0">Recent followers</h5>
                </div>
                <div class="card-body">
                    @if (!Model.HasFollowers)
                    {
                        <p class="text-body-secondary mb-0">No followers yet.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-borderless">
                            @foreach (var f in Model.Followers)
                            {
                                <li class="list-group-item px-0 d-flex align-items-center">
                                    <div class="avatar avatar-sm flex-shrink-0">
                                        <img class="avatar-img rounded-circle border border-white border-2"
                                             src="@Url.Content("~/assets/images/avatar/01.jpg")" alt="follower">
                                    </div>
                                    <span class="ms-3">@f.Label</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            @if (Model.Pager.HasPreviousPage || Model.Pager.HasNextPage)
            {
                <nav class="d-flex justify-content-between align-items-center">
                    <span class="small text-body-secondary">Page @Model.Pager.PageNumber</span>
                    <div class="btn-group">
                        @if (Model.Pager.HasPreviousPage)
                        {
                            <a class="btn btn-sm btn-secondary-soft"
                               asp-area="Creator" asp-controller="Audience" asp-action="Index"
                               asp-route-page="@(Model.Pager.PageNumber - 1)">Previous</a>
                        }
                        @if (Model.Pager.HasNextPage)
                        {
                            <a class="btn btn-sm btn-secondary-soft"
                               asp-area="Creator" asp-controller="Audience" asp-action="Index"
                               asp-route-page="@(Model.Pager.PageNumber + 1)">Next</a>
                        }
                    </div>
                </nav>
            }
        }
    </div>
</section>
