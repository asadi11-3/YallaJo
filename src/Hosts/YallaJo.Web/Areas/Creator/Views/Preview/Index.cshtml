@model YallaJo.Web.Areas.Creator.Models.Preview.PublicProfilePreviewVm
@using YallaJo.Web.Areas.Creator.Models.Preview
@using System.Globalization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Creator.Preview.Title"].Value;
    var sidebar = ViewBag.Sidebar as YallaJo.Web.Areas.Creator.Shared.CreatorSidebarVm
                  ?? new YallaJo.Web.Areas.Creator.Shared.CreatorSidebarVm();
    var culture = CultureInfo.CurrentUICulture;
    string Date(DateTime d) => d.ToString("d MMM yyyy", culture);
    string Count(long n) => n.ToString("N0", culture);
}

<partial name="_CreatorSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-sm-flex justify-content-between align-items-center">
            <h1 class="fs-4 mb-0"><i class="fa-solid fa-eye me-2" aria-hidden="true"></i>@Localizer["Creator.Preview.Heading"]</h1>
        </div>

        @if (Model.State != PreviewState.Active)
        {
            <div class="card border">
                <div class="card-body text-center py-5">
                    <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
                    <h2 class="h5">@Localizer["Creator.Preview.UnavailableTitle"]</h2>
                    <p class="text-body-secondary mb-0">@Localizer["Creator.Preview.UnavailableMsg"]</p>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0 small" role="status">
                <i class="fa-solid fa-circle-info me-1" aria-hidden="true"></i>@Localizer["Creator.Preview.ReadOnly"]
            </div>

            @* ── Public profile header ─────────────────────────────────────── *@
            <div class="card border">
                <div class="card-body d-sm-flex align-items-center">
                    <div class="avatar avatar-xl flex-shrink-0">
                        <img class="avatar-img rounded-circle border border-white border-3"
                             src="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? Url.Content("~/assets/images/avatar/01.jpg") : Model.AvatarUrl)"
                             width="96" height="96" alt="@Model.DisplayName">
                    </div>
                    <div class="ms-sm-3 mt-2 mt-sm-0">
                        <h2 class="h4 mb-1">
                            @Model.DisplayName
                            @if (!string.IsNullOrWhiteSpace(Model.TrustTier))
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary ms-1">@Model.TrustTier</span>
                            }
                        </h2>
                        @if (!string.IsNullOrWhiteSpace(Model.Bio))
                        {
                            <p class="mb-0 text-body-secondary">@Model.Bio</p>
                        }
                    </div>
                </div>
            </div>

            @* ── Public metrics ────────────────────────────────────────────── *@
            <div class="row g-3">
                <div class="col-6 col-md">
                    <partial name="_StatCard" model="@(new YallaJo.Web.Areas.Creator.Shared.StatCardVm(Count(Model.ArticleCount), Localizer["Creator.Preview.Articles"].Value))" />
                </div>
                <div class="col-6 col-md">
                    <partial name="_StatCard" model="@(new YallaJo.Web.Areas.Creator.Shared.StatCardVm(Count(Model.FollowerCount), Localizer["Creator.Preview.Followers"].Value))" />
                </div>
                <div class="col-6 col-md">
                    <partial name="_StatCard" model="@(new YallaJo.Web.Areas.Creator.Shared.StatCardVm(Count(Model.TotalViewCount), Localizer["Creator.Preview.Views"].Value))" />
                </div>
                <div class="col-6 col-md">
                    <partial name="_StatCard" model="@(new YallaJo.Web.Areas.Creator.Shared.StatCardVm(Count(Model.TotalReactionCount), Localizer["Creator.Preview.Reactions"].Value))" />
                </div>
                <div class="col-6 col-md">
                    <partial name="_StatCard" model="@(new YallaJo.Web.Areas.Creator.Shared.StatCardVm(Count(Model.TotalCommentCount), Localizer["Creator.Preview.Comments"].Value))" />
                </div>
            </div>

            @* ── Published articles ────────────────────────────────────────── *@
            <div class="card border">
                <div class="card-header border-bottom">
                    <h2 class="card-header-title h5 mb-0">@Localizer["Creator.Preview.PublishedArticles"]</h2>
                </div>
                <div class="card-body">
                    @if (!Model.HasArticles)
                    {
                        <p class="text-body-secondary mb-0">@Localizer["Creator.Preview.NoArticles"]</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-borderless">
                            @foreach (var a in Model.Articles)
                            {
                                <li class="list-group-item px-0">
                                    @* Title links to the canonical public article page (Public/Blog/Post). *@
                                    <a asp-area="Public" asp-controller="Blog" asp-action="Post" asp-route-slug="@a.Slug"
                                       class="h6 d-block mb-1">@a.Title</a>
                                    @if (!string.IsNullOrWhiteSpace(a.Summary))
                                    {
                                        <p class="small text-body-secondary mb-1">@a.Summary</p>
                                    }
                                    <span class="small text-body-secondary">
                                        <bdi dir="ltr">@Count(a.ViewCount)</bdi> @Localizer["Creator.Preview.ViewsLabel"]
                                        @if (a.ReadTimeMinutes.HasValue)
                                        {
                                            <span> · @Localizer["Creator.Preview.MinRead", a.ReadTimeMinutes.Value]</span>
                                        }
                                        @if (a.PublishedAt.HasValue)
                                        {
                                            <span> · <bdi dir="ltr">@Date(a.PublishedAt.Value)</bdi></span>
                                        }
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            @if (Model.Pager.TotalPages > 1)
            {
                <nav class="d-flex justify-content-between align-items-center" aria-label="@Localizer["Creator.Preview.Pagination"]">
                    <span class="small text-body-secondary">
                        @Localizer["Creator.Preview.PageOf", Model.Pager.PageNumber, Model.Pager.TotalPages]
                    </span>
                    <div class="btn-group">
                        @if (Model.Pager.HasPreviousPage)
                        {
                            <a class="btn btn-sm btn-secondary-soft"
                               asp-area="Creator" asp-controller="Preview" asp-action="Index"
                               asp-route-page="@(Model.Pager.PageNumber - 1)">@Localizer["Creator.Preview.Previous"]</a>
                        }
                        @if (Model.Pager.HasNextPage)
                        {
                            <a class="btn btn-sm btn-secondary-soft"
                               asp-area="Creator" asp-controller="Preview" asp-action="Index"
                               asp-route-page="@(Model.Pager.PageNumber + 1)">@Localizer["Creator.Preview.Next"]</a>
                        }
                    </div>
                </nav>
            }
        }
    </div>
</section>
