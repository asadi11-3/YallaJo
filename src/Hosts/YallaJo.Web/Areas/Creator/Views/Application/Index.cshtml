@model YallaJo.Web.Areas.Creator.Models.Application.CreatorApplicationFormVm
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Creator.Application.Title"].Value;
    var sidebar = ViewBag.Sidebar as YallaJo.Web.Areas.Creator.Shared.CreatorSidebarVm
                  ?? new YallaJo.Web.Areas.Creator.Shared.CreatorSidebarVm();
}

<partial name="_CreatorSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-sm-flex justify-content-between align-items-center">
            <h1 class="fs-4 mb-0">
                <i class="fa-solid fa-pen-to-square me-2 text-primary" aria-hidden="true"></i>
                @Localizer["Creator.Application.Heading"]
            </h1>
            <permission require="@WebPermission.Creator.RedeemInvitation">
                <a href="#invite" class="btn btn-sm btn-primary-soft mt-2 mt-sm-0">
                    <i class="fa-solid fa-envelope-open-text me-1" aria-hidden="true"></i>
                    @Localizer["Creator.Application.RedeemInvitation"]
                </a>
            </permission>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Status) && !Model.IsEditable)
        {
            <div class="card border">
                <div class="card-body py-4">
                    @switch (Model.Status)
                    {
                        case "Pending":
                            <h2 class="h5 mb-1">@Localizer["Creator.Application.PendingTitle"]</h2>
                            <p class="text-body-secondary mb-0">@Localizer["Creator.Application.PendingMsg"]</p>
                            break;
                        case "Approved":
                            <h2 class="h5 mb-1">@Localizer["Creator.Application.ApprovedTitle"]</h2>
                            <p class="text-body-secondary mb-0">@Localizer["Creator.Application.ApprovedMsg"]</p>
                            break;
                        case "Rejected":
                            <h2 class="h5 mb-1">@Localizer["Creator.Application.RejectedTitle"]</h2>
                            @if (!string.IsNullOrWhiteSpace(Model.AdminNote))
                            {
                                <p class="text-body-secondary mb-0">@Localizer["Creator.Application.ReviewerNote", Model.AdminNote]</p>
                            }
                            break;
                        default:
                            <h2 class="h5 mb-1">@Localizer["Creator.Application.StatusLabel", Model.Status]</h2>
                            break;
                    }
                </div>
            </div>
        }
        else
        {
            @if (string.Equals(Model.Status, "MoreInfoNeeded", StringComparison.OrdinalIgnoreCase)
                 && !string.IsNullOrWhiteSpace(Model.AdminNote))
            {
                <div class="alert alert-warning mb-0" role="alert">
                    <i class="fa-solid fa-circle-info me-1" aria-hidden="true"></i>
                    @Localizer["Creator.Application.MoreInfoRequested", Model.AdminNote]
                </div>
            }

            var postAction = Model.IsNew ? "Create" : "Update";

            @if (Model.IsNew)
            {
                <form asp-area="Creator" asp-controller="Application" asp-action="@postAction" method="post" class="card border" data-loading>
                    <partial name="_ApplicationFormFields" model="Model" />
                    <div class="card-footer d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>
                            @Localizer["Creator.Application.SaveDraft"]
                        </button>
                    </div>
                </form>
            }
            else
            {
                <permission require="@WebPermission.Creator.Update">
                    <form asp-area="Creator" asp-controller="Application" asp-action="@postAction" method="post" class="card border" data-loading>
                        <input type="hidden" asp-for="ApplicationId" />
                        <input type="hidden" asp-for="Status" />
                        <partial name="_ApplicationFormFields" model="Model" />
                        <div class="card-footer d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>
                                @Localizer["Creator.Application.SaveChanges"]
                            </button>
                        </div>
                    </form>
                </permission>
            }

            @if (Model.CanSubmit)
            {
                <permission require="@WebPermission.Creator.Submit">
                    <form asp-area="Creator" asp-controller="Application" asp-action="Submit" method="post" data-loading>
                        <input type="hidden" name="applicationId" value="@Model.ApplicationId" />
                        <button type="submit" class="btn btn-success">
                            <i class="fa-solid fa-paper-plane me-1" aria-hidden="true"></i>
                            @Localizer["Creator.Application.SubmitForReview"]
                        </button>
                    </form>
                </permission>
            }
        }

        @* ── Invitation redemption (merged from the retired Invite page; PE1 native <details>, no JS) ── *@
        <permission require="@WebPermission.Creator.RedeemInvitation">
            @{ var inviteOpen = ViewData["InviteOpen"] as bool? == true; }
            <details id="invite" class="card border" open="@inviteOpen">
                <summary class="card-header bg-transparent">
                    <span class="h6 mb-0">
                        <i class="fa-solid fa-envelope-open-text me-2 text-primary" aria-hidden="true"></i>
                        @Localizer["Creator.Invite.Heading"]
                    </span>
                </summary>
                <form asp-area="Creator" asp-controller="Application" asp-action="Invite" method="post" data-loading>
                    <div class="card-body vstack gap-3">
                        <div>
                            <label for="Token" class="form-label">@Localizer["Creator.Invite.TokenLabel"]</label>
                            <input type="text" id="Token" name="Token" value="@(ViewData["InviteToken"] as string)"
                                   class="form-control" dir="ltr" aria-describedby="token-help"
                                   placeholder="@Localizer["Creator.Invite.TokenPlaceholder"]" />
                            <div id="token-help" class="form-text">@Localizer["Creator.Invite.TokenHelp"]</div>
                            @Html.ValidationMessage("Token", new { @class = "text-danger small", role = "alert" })
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>
                            @Localizer["Creator.Invite.Redeem"]
                        </button>
                    </div>
                </form>
            </details>
        </permission>
    </div>
</section>
