@model YallaJo.Web.Areas.Creator.Models.Application.CreatorApplicationFormVm
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer

<div class="card-body vstack gap-3">
    <div asp-validation-summary="ModelOnly" class="text-danger small" role="alert"></div>

    <div>
        <label asp-for="Bio" class="form-label">@Localizer["Creator.Application.BioLabel"]</label>
        <textarea asp-for="Bio" class="form-control" rows="4" aria-describedby="bio-help"
                  placeholder="@Localizer["Creator.Application.BioPlaceholder"]"></textarea>
        <div id="bio-help" class="form-text">@Localizer["Creator.Application.BioHelp"]</div>
        <span asp-validation-for="Bio" class="text-danger small" role="alert"></span>
    </div>

    <div>
        <label asp-for="PortfolioUrlsText" class="form-label">@Localizer["Creator.Application.PortfolioLabel"]</label>
        <textarea asp-for="PortfolioUrlsText" class="form-control" rows="3" dir="ltr" aria-describedby="portfolio-help"
                  placeholder="@Localizer["Creator.Application.UrlsPlaceholder"]"></textarea>
        <div id="portfolio-help" class="form-text">@Localizer["Creator.Application.UrlsHelp"]</div>
        <span asp-validation-for="PortfolioUrlsText" class="text-danger small" role="alert"></span>
    </div>

    <div>
        <label asp-for="SampleWorkUrlsText" class="form-label">@Localizer["Creator.Application.SampleWorkLabel"]</label>
        <textarea asp-for="SampleWorkUrlsText" class="form-control" rows="3" dir="ltr" aria-describedby="sample-help"
                  placeholder="@Localizer["Creator.Application.UrlsPlaceholder"]"></textarea>
        <div id="sample-help" class="form-text">@Localizer["Creator.Application.UrlsHelp"]</div>
        <span asp-validation-for="SampleWorkUrlsText" class="text-danger small" role="alert"></span>
    </div>

    <div>
        <label asp-for="FreeTagsText" class="form-label">@Localizer["Creator.Application.TagsLabel"]</label>
        <input asp-for="FreeTagsText" class="form-control" aria-describedby="tags-help"
               placeholder="@Localizer["Creator.Application.TagsPlaceholder"]" />
        <div id="tags-help" class="form-text">@Localizer["Creator.Application.TagsHelp"]</div>
        <span asp-validation-for="FreeTagsText" class="text-danger small" role="alert"></span>
    </div>

    <div>
        <label class="form-label">
            @Localizer["Creator.Application.NichesLabel"]
            <span class="text-body-secondary small">@Localizer["Creator.Application.NichesHint"]</span>
        </label>
        @if (Model.NicheOptions.Count == 0)
        {
            <p class="text-body-secondary small mb-0">@Localizer["Creator.Application.NoNiches"]</p>
        }
        else
        {
            <div class="row g-2">
                @foreach (var niche in Model.NicheOptions)
                {
                    var isChecked = Model.SelectedNicheIds.Contains(niche.Id);
                    <div class="col-sm-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="SelectedNicheIds"
                                   value="@niche.Id" id="niche_@niche.Id" @(isChecked ? "checked" : "") />
                            <label class="form-check-label" for="niche_@niche.Id">
                                @niche.Name
                                @if (!string.IsNullOrWhiteSpace(niche.Description))
                                {
                                    <span class="d-block small text-body-secondary">@niche.Description</span>
                                }
                            </label>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
