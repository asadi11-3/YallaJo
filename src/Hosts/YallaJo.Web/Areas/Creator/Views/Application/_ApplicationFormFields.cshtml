@model YallaJo.Web.Areas.Creator.Models.Application.CreatorApplicationFormVm

<div class="card-body vstack gap-3">
    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

    <div>
        <label asp-for="Bio" class="form-label">Bio</label>
        <textarea asp-for="Bio" class="form-control" rows="4"
                  placeholder="Tell us about yourself and the content you create."></textarea>
        <span asp-validation-for="Bio" class="text-danger small"></span>
    </div>

    <div>
        <label asp-for="PortfolioUrlsText" class="form-label">Portfolio URLs</label>
        <textarea asp-for="PortfolioUrlsText" class="form-control" rows="3"
                  placeholder="One URL per line (max 10)."></textarea>
        <span asp-validation-for="PortfolioUrlsText" class="text-danger small"></span>
    </div>

    <div>
        <label asp-for="SampleWorkUrlsText" class="form-label">Sample work URLs</label>
        <textarea asp-for="SampleWorkUrlsText" class="form-control" rows="3"
                  placeholder="One URL per line (max 10)."></textarea>
        <span asp-validation-for="SampleWorkUrlsText" class="text-danger small"></span>
    </div>

    <div>
        <label asp-for="FreeTagsText" class="form-label">Tags</label>
        <input asp-for="FreeTagsText" class="form-control"
               placeholder="Comma-separated (max 20, each up to 50 characters)." />
        <span asp-validation-for="FreeTagsText" class="text-danger small"></span>
    </div>

    <div>
        <label class="form-label">Niches <span class="text-body-secondary small">(choose up to 5)</span></label>
        @if (Model.NicheOptions.Count == 0)
        {
            <p class="text-body-secondary small mb-0">No niches are available right now.</p>
        }
        else
        {
            <div class="row g-2">
                @foreach (var niche in Model.NicheOptions)
                {
                    var isChecked = Model.SelectedNicheIds.Contains(niche.Id);
                    <div class="col-sm-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="SelectedNicheIds"
                                   value="@niche.Id" id="niche_@niche.Id" @(isChecked ? "checked" : "") />
                            <label class="form-check-label" for="niche_@niche.Id">
                                @niche.Name
                                @if (!string.IsNullOrWhiteSpace(niche.Description))
                                {
                                    <span class="d-block small text-body-secondary">@niche.Description</span>
                                }
                            </label>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
