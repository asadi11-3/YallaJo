@model YallaJo.Web.Areas.Creator.Models.Application.RedeemInvitationVm
@{
    ViewData["Title"] = "Redeem Invitation";
    var sidebar = ViewBag.Sidebar as YallaJo.Web.Areas.Creator.Shared.CreatorSidebarVm
                  ?? new YallaJo.Web.Areas.Creator.Shared.CreatorSidebarVm();
}

<partial name="_CreatorSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h1 class="fs-4 mb-0"><i class="bi bi-envelope-open me-2"></i>Redeem Invitation</h1>
                    <a asp-area="Creator" asp-controller="Application" asp-action="Index" class="btn btn-sm btn-secondary-soft">
                        Back to application
                    </a>
                </div>

                <form asp-area="Creator" asp-controller="Application" asp-action="Invite" method="post" class="card border">
                    <div class="card-body vstack gap-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                        <div>
                            <label asp-for="Token" class="form-label"></label>
                            <input asp-for="Token" class="form-control" placeholder="Paste your invitation token" />
                            <span asp-validation-for="Token" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check2-circle me-1"></i>Redeem
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
