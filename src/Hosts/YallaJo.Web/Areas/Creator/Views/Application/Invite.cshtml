@model YallaJo.Web.Areas.Creator.Models.Application.RedeemInvitationVm
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Creator.Invite.Title"].Value;
    var sidebar = ViewBag.Sidebar as YallaJo.Web.Areas.Creator.Shared.CreatorSidebarVm
                  ?? new YallaJo.Web.Areas.Creator.Shared.CreatorSidebarVm();
}

<partial name="_CreatorSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h1 class="fs-4 mb-0">
                        <i class="fa-solid fa-envelope-open-text me-2 text-primary" aria-hidden="true"></i>
                        @Localizer["Creator.Invite.Heading"]
                    </h1>
                    <a asp-area="Creator" asp-controller="Application" asp-action="Index" class="btn btn-sm btn-secondary-soft">
                        @Localizer["Creator.Invite.Back"]
                    </a>
                </div>

                <form asp-area="Creator" asp-controller="Application" asp-action="Invite" method="post" class="card border">
                    <div class="card-body vstack gap-3">
                        <div asp-validation-summary="ModelOnly" class="text-danger small" role="alert"></div>
                        <div>
                            <label asp-for="Token" class="form-label">@Localizer["Creator.Invite.TokenLabel"]</label>
                            <input asp-for="Token" class="form-control" dir="ltr" aria-describedby="token-help"
                                   placeholder="@Localizer["Creator.Invite.TokenPlaceholder"]" />
                            <div id="token-help" class="form-text">@Localizer["Creator.Invite.TokenHelp"]</div>
                            <span asp-validation-for="Token" class="text-danger small" role="alert"></span>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>
                            @Localizer["Creator.Invite.Redeem"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
