@model YallaJo.Web.Areas.Creator.Models.Dashboard.CreatorDashboardVm
@using YallaJo.Web.Areas.Creator.Models.Dashboard
@{
    ViewData["Title"] = "Creator Dashboard";
    var sidebar = ViewBag.Sidebar as YallaJo.Web.Areas.Creator.Shared.CreatorSidebarVm
                  ?? new YallaJo.Web.Areas.Creator.Shared.CreatorSidebarVm();
}

<partial name="_CreatorSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-sm-flex justify-content-between align-items-center">
            <h1 class="fs-4 mb-0"><i class="bi bi-house-door me-2"></i>Creator Dashboard</h1>
        </div>

        @switch (Model.State)
        {
            case CreatorDashboardState.Approved:
                @* ── Approved creator: real stats + recent articles ──────────── *@
                <div class="card border">
                    <div class="card-body d-sm-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-1">@Model.DisplayName</h5>
                            <span class="badge text-bg-success">Active creator</span>
                            @if (!string.IsNullOrWhiteSpace(Model.TrustTier))
                            {
                                <span class="badge text-bg-light ms-1">@Model.TrustTier tier</span>
                            }
                        </div>
                        <div class="mt-2 mt-sm-0">
                            <permission require="@WebPermission.Blog.Create">
                                <a asp-area="Creator" asp-controller="Articles" asp-action="New" class="btn btn-sm btn-primary">
                                    <i class="bi bi-plus-lg me-1"></i>New Article
                                </a>
                            </permission>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-sm-6 col-xl-3">
                        <div class="card card-body border h-100">
                            <div class="d-flex align-items-center">
                                <div class="icon-xl bg-success bg-opacity-10 rounded-3 text-success">
                                    <i class="bi bi-journals fs-5"></i>
                                </div>
                                <div class="ms-3">
                                    <h4 class="mb-0">@Model.ArticleCount</h4>
                                    <span class="small text-body-secondary">Articles</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-3">
                        <div class="card card-body border h-100">
                            <div class="d-flex align-items-center">
                                <div class="icon-xl bg-info bg-opacity-10 rounded-3 text-info">
                                    <i class="bi bi-eye fs-5"></i>
                                </div>
                                <div class="ms-3">
                                    <h4 class="mb-0">@Model.TotalViewCount</h4>
                                    <span class="small text-body-secondary">Total Views</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-3">
                        <div class="card card-body border h-100">
                            <div class="d-flex align-items-center">
                                <div class="icon-xl bg-warning bg-opacity-10 rounded-3 text-warning">
                                    <i class="bi bi-hand-thumbs-up fs-5"></i>
                                </div>
                                <div class="ms-3">
                                    <h4 class="mb-0">@Model.TotalReactionCount</h4>
                                    <span class="small text-body-secondary">Reactions</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-3">
                        <div class="card card-body border h-100">
                            <div class="d-flex align-items-center">
                                <div class="icon-xl bg-primary bg-opacity-10 rounded-3 text-primary">
                                    <i class="bi bi-people fs-5"></i>
                                </div>
                                <div class="ms-3">
                                    <h4 class="mb-0">@Model.FollowerCount</h4>
                                    <span class="small text-body-secondary">Followers</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border">
                    <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                        <h5 class="card-header-title mb-0">Recent Articles</h5>
                        <permission require="@WebPermission.Blog.ReadOwn">
                            <a asp-area="Creator" asp-controller="Articles" asp-action="Index" class="btn btn-sm btn-primary-soft">
                                View all
                            </a>
                        </permission>
                    </div>
                    <div class="card-body">
                        @if (Model.RecentArticles.Count == 0)
                        {
                            <p class="text-body-secondary small mb-0">No articles yet.</p>
                        }
                        else
                        {
                            <ul class="list-group list-group-borderless">
                                @foreach (var article in Model.RecentArticles)
                                {
                                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-0">@article.Title</h6>
                                            <span class="small text-body-secondary">
                                                @article.ViewCount view(s)@(article.PublishedAt is { } p ? " · " + p.ToString("d MMM yyyy") : "")
                                            </span>
                                        </div>
                                        <span class="badge text-bg-light">@(article.Status ?? "Draft")</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
                break;

            case CreatorDashboardState.ApplicationPending:
                <div class="card border">
                    <div class="card-body text-center py-5">
                        <h5>Your creator application is under review</h5>
                        <p class="text-body-secondary mb-0">
                            We'll let you know once an admin has reviewed your application@(Model.ApplicationSubmittedAt is { } s ? $" (submitted {s:d MMM yyyy})" : "").
                        </p>
                    </div>
                </div>
                break;

            case CreatorDashboardState.ApplicationRejected:
                <div class="card border">
                    <div class="card-body text-center py-5">
                        <h5>Your creator application was not approved</h5>
                        @if (!string.IsNullOrWhiteSpace(Model.AdminNote))
                        {
                            <p class="text-body-secondary">Reviewer note: @Model.AdminNote</p>
                        }
                        <a asp-area="Creator" asp-controller="Application" asp-action="Index" class="btn btn-primary">
                            Reapply
                        </a>
                    </div>
                </div>
                break;

            case CreatorDashboardState.ApplicationNeedsInfo:
                <div class="card border">
                    <div class="card-body text-center py-5">
                        <h5>We need a bit more information</h5>
                        @if (!string.IsNullOrWhiteSpace(Model.AdminNote))
                        {
                            <p class="text-body-secondary">Reviewer note: @Model.AdminNote</p>
                        }
                        <a asp-area="Creator" asp-controller="Application" asp-action="Index" class="btn btn-primary">
                            Update application
                        </a>
                    </div>
                </div>
                break;

            case CreatorDashboardState.ApplicationDraft:
                <div class="card border">
                    <div class="card-body text-center py-5">
                        <h5>Finish your creator application</h5>
                        <p class="text-body-secondary">You started an application but haven't submitted it yet.</p>
                        <a asp-area="Creator" asp-controller="Application" asp-action="Index" class="btn btn-primary">
                            Continue application
                        </a>
                    </div>
                </div>
                break;

            case CreatorDashboardState.Suspended:
                <div class="card border">
                    <div class="card-body text-center py-5">
                        <h5>Your creator profile is suspended</h5>
                        <p class="text-body-secondary mb-0">
                            Creator tools are unavailable while your profile is suspended. Please contact support if you believe this is a mistake.
                        </p>
                    </div>
                </div>
                break;

            case CreatorDashboardState.Deactivated:
                <div class="card border">
                    <div class="card-body text-center py-5">
                        <h5>Your creator profile is deactivated</h5>
                        <p class="text-body-secondary mb-0">
                            Your creator profile has been deactivated. Reactivation will be available from your profile settings.
                        </p>
                    </div>
                </div>
                break;

            default:
                @* NotApplied — become a creator CTA. *@
                <div class="card border">
                    <div class="card-body text-center py-5">
                        <h5>Become a content creator</h5>
                        <p class="text-body-secondary">
                            Share articles with the YallaJo community. Apply to become a creator to get started.
                        </p>
                        <a asp-area="Creator" asp-controller="Application" asp-action="Index" class="btn btn-primary">
                            Become a creator
                        </a>
                    </div>
                </div>
                break;
        }
    </div>
</section>
