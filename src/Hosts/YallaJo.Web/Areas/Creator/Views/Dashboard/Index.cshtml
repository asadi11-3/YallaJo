@model YallaJo.Web.Areas.Creator.Models.Dashboard.CreatorDashboardVm
@using System.Globalization
@using Microsoft.Extensions.Localization
@using YallaJo.Web.Areas.Creator.Models.Dashboard
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Creator.Dashboard.Title"].Value;
    var sidebar = ViewBag.Sidebar as CreatorSidebarVm ?? new CreatorSidebarVm();
    var culture = CultureInfo.CurrentUICulture;
    string Date(DateTime d) => d.ToString("d MMM yyyy", culture);
    string Count(long n) => n.ToString("N0", culture);
    string StatusLabel(string? s) => Localizer["Creator.Status." + (string.IsNullOrEmpty(s) ? "Draft" : s)].Value;
}

<partial name="_CreatorSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-sm-flex justify-content-between align-items-center">
            <h1 class="fs-4 mb-0">
                <i class="fa-solid fa-house me-2 text-primary" aria-hidden="true"></i>
                @Localizer["Creator.Dashboard.Heading"]
            </h1>
        </div>

        @switch (Model.State)
        {
            case CreatorDashboardState.Approved:
                <div class="card border">
                    <div class="card-body d-sm-flex justify-content-between align-items-center gap-3">
                        <div>
                            <h2 class="h5 mb-2">@Model.DisplayName</h2>
                            <span class="badge bg-success bg-opacity-10 text-success">
                                <i class="fa-solid fa-circle-check fa-fw" aria-hidden="true"></i>
                                @Localizer["Creator.Dashboard.ActiveCreator"]
                            </span>
                            @if (!string.IsNullOrWhiteSpace(Model.TrustTier))
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary ms-1">
                                    @Localizer["Creator.Dashboard.TrustTier", Model.TrustTier]
                                </span>
                            }
                        </div>
                        <div class="hstack gap-2 mt-3 mt-sm-0">
                            <permission require="@WebPermission.Creator.Read">
                                <a class="btn btn-sm btn-secondary-soft" asp-area="Creator" asp-controller="Preview" asp-action="Index">
                                    <i class="fa-solid fa-eye fa-fw" aria-hidden="true"></i>
                                    @Localizer["Creator.Dashboard.PreviewProfile"]
                                </a>
                            </permission>
                            <permission require="@WebPermission.Creator.Read">
                                <a class="btn btn-sm btn-secondary-soft" asp-area="Creator" asp-controller="Audience" asp-action="Index">
                                    <i class="fa-solid fa-users fa-fw" aria-hidden="true"></i>
                                    @Localizer["Creator.Dashboard.Audience"]
                                </a>
                            </permission>
                            <permission require="@WebPermission.Blog.Create">
                                <a class="btn btn-sm btn-primary" asp-area="Creator" asp-controller="Articles" asp-action="New">
                                    <i class="fa-solid fa-plus fa-fw" aria-hidden="true"></i>
                                    @Localizer["Creator.Dashboard.NewArticle"]
                                </a>
                            </permission>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-sm-6 col-xl-3">
                        <partial name="_StatCard" model="@(new YallaJo.Web.Areas.Creator.Shared.StatCardVm(Count(Model.ArticleCount), Localizer["Creator.Dashboard.Articles"].Value, "fa-book-open", "success"))" />
                    </div>
                    <div class="col-sm-6 col-xl-3">
                        <partial name="_StatCard" model="@(new YallaJo.Web.Areas.Creator.Shared.StatCardVm(Count(Model.TotalViewCount), Localizer["Creator.Dashboard.TotalViews"].Value, "fa-eye", "info"))" />
                    </div>
                    <div class="col-sm-6 col-xl-3">
                        <partial name="_StatCard" model="@(new YallaJo.Web.Areas.Creator.Shared.StatCardVm(Count(Model.TotalReactionCount), Localizer["Creator.Dashboard.Reactions"].Value, "fa-thumbs-up", "warning"))" />
                    </div>
                    <div class="col-sm-6 col-xl-3">
                        <partial name="_StatCard" model="@(new YallaJo.Web.Areas.Creator.Shared.StatCardVm(Count(Model.FollowerCount), Localizer["Creator.Dashboard.Followers"].Value, "fa-users", "primary"))" />
                    </div>
                </div>

                <div class="card border">
                    <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                        <h2 class="card-header-title h5 mb-0">@Localizer["Creator.Dashboard.RecentArticles"]</h2>
                        <permission require="@WebPermission.Blog.ReadOwn">
                            <a class="btn btn-sm btn-primary-soft" asp-area="Creator" asp-controller="Articles" asp-action="Index">
                                @Localizer["Creator.Dashboard.ViewAll"]
                            </a>
                        </permission>
                    </div>
                    <div class="card-body">
                        @if (Model.RecentArticles.Count == 0)
                        {
                            <p class="mb-0 text-body-secondary">@Localizer["Creator.Dashboard.NoArticles"]</p>
                        }
                        else
                        {
                            <ul class="list-group list-group-borderless">
                                @foreach (var article in Model.RecentArticles)
                                {
                                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                        <div>
                                            <p class="fw-semibold mb-1">@article.Title</p>
                                            <span class="small text-body-secondary">
                                                @Localizer["Creator.Dashboard.ViewsCount", article.ViewCount]
                                                @if (article.PublishedAt.HasValue)
                                                {
                                                    <span> · <bdi dir="ltr">@Date(article.PublishedAt.Value)</bdi></span>
                                                }
                                            </span>
                                        </div>
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary">@StatusLabel(article.Status)</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
                break;

            case CreatorDashboardState.ApplicationPending:
                <div class="card border">
                    <div class="card-body text-center py-5">
                        <h2 class="h5 mb-2">@Localizer["Creator.Dashboard.PendingTitle"]</h2>
                        <p class="text-body-secondary mb-0">
                            @if (Model.ApplicationSubmittedAt.HasValue)
                            {
                                <span>@Localizer["Creator.Dashboard.PendingMsgDated", Date(Model.ApplicationSubmittedAt.Value)] </span>
                            }
                            @Localizer["Creator.Dashboard.PendingMsg"]
                        </p>
                    </div>
                </div>
                break;

            case CreatorDashboardState.ApplicationRejected:
                <div class="card border">
                    <div class="card-body text-center py-5">
                        <h2 class="h5 mb-2">@Localizer["Creator.Dashboard.RejectedTitle"]</h2>
                        @if (!string.IsNullOrWhiteSpace(Model.AdminNote))
                        {
                            <p class="text-body-secondary mb-3">@Localizer["Creator.Dashboard.ReviewerNote", Model.AdminNote]</p>
                        }
                        <a class="btn btn-primary" asp-area="Creator" asp-controller="Application" asp-action="Index">
                            @Localizer["Creator.Dashboard.Reapply"]
                        </a>
                    </div>
                </div>
                break;

            case CreatorDashboardState.ApplicationNeedsInfo:
                <div class="card border">
                    <div class="card-body text-center py-5">
                        <h2 class="h5 mb-2">@Localizer["Creator.Dashboard.NeedsInfoTitle"]</h2>
                        @if (!string.IsNullOrWhiteSpace(Model.AdminNote))
                        {
                            <p class="text-body-secondary mb-3">@Localizer["Creator.Dashboard.ReviewerNote", Model.AdminNote]</p>
                        }
                        <a class="btn btn-primary" asp-area="Creator" asp-controller="Application" asp-action="Index">
                            @Localizer["Creator.Dashboard.UpdateApplication"]
                        </a>
                    </div>
                </div>
                break;

            case CreatorDashboardState.ApplicationDraft:
                <div class="card border">
                    <div class="card-body text-center py-5">
                        <h2 class="h5 mb-2">@Localizer["Creator.Dashboard.DraftTitle"]</h2>
                        <p class="text-body-secondary mb-3">@Localizer["Creator.Dashboard.DraftMsg"]</p>
                        <a class="btn btn-primary" asp-area="Creator" asp-controller="Application" asp-action="Index">
                            @Localizer["Creator.Dashboard.ContinueApplication"]
                        </a>
                    </div>
                </div>
                break;

            case CreatorDashboardState.Suspended:
                <div class="card border">
                    <div class="card-body text-center py-5">
                        <h2 class="h5 mb-2">@Localizer["Creator.Dashboard.SuspendedTitle"]</h2>
                        <p class="text-body-secondary mb-0">@Localizer["Creator.Dashboard.SuspendedMsg"]</p>
                    </div>
                </div>
                break;

            case CreatorDashboardState.Deactivated:
                <div class="card border">
                    <div class="card-body text-center py-5">
                        <h2 class="h5 mb-2">@Localizer["Creator.Dashboard.DeactivatedTitle"]</h2>
                        <p class="text-body-secondary mb-0">@Localizer["Creator.Dashboard.DeactivatedMsg"]</p>
                    </div>
                </div>
                break;

            default:
                <div class="card border">
                    <div class="card-body text-center py-5">
                        <h2 class="h5 mb-2">@Localizer["Creator.Dashboard.NotAppliedTitle"]</h2>
                        <p class="text-body-secondary mb-3">@Localizer["Creator.Dashboard.NotAppliedMsg"]</p>
                        <a class="btn btn-primary" asp-area="Creator" asp-controller="Application" asp-action="Index">
                            @Localizer["Creator.Dashboard.BecomeCreator"]
                        </a>
                    </div>
                </div>
                break;
        }
    </div>
</section>
