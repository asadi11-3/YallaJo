@model YallaJo.Web.Areas.Creator.Models.Profile.CreatorProfileVm
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Creator.Profile.Title"].Value;
    var sidebar = ViewBag.Sidebar as YallaJo.Web.Areas.Creator.Shared.CreatorSidebarVm
                  ?? new YallaJo.Web.Areas.Creator.Shared.CreatorSidebarVm();
}

<partial name="_CreatorSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-sm-flex justify-content-between align-items-center">
            <h1 class="fs-4 mb-0"><i class="fa-solid fa-id-badge me-2" aria-hidden="true"></i>@Localizer["Creator.Profile.Heading"]</h1>
            @if (Model.IsActive)
            {
                <span class="badge bg-success bg-opacity-10 text-success mt-2 mt-sm-0">
                    <i class="fa-solid fa-circle-check fa-fw" aria-hidden="true"></i>
                    @if (string.IsNullOrWhiteSpace(Model.TrustTier))
                    {
                        @Localizer["Creator.Profile.Active"]
                    }
                    else
                    {
                        @Localizer["Creator.Profile.ActiveTier", Model.TrustTier]
                    }
                </span>
            }
        </div>

        @if (!Model.HasProfile)
        {
            <div class="card border">
                <div class="card-body text-center py-5">
                    <img src="~/assets/images/element/17.svg" width="80" height="80" aria-hidden="true" alt="" class="h-80px mb-3" />
                    <h2 class="h5">@Localizer["Creator.Profile.NoProfileTitle"]</h2>
                    <p class="text-body-secondary mb-0">@Localizer["Creator.Profile.NoProfileMsg"]</p>
                </div>
            </div>
        }
        else if (!Model.IsActive)
        {
            <div class="card border">
                <div class="card-body text-center py-5">
                    <h2 class="h5">@Localizer["Creator.Profile.InactiveTitle", Localizer["Creator.Status." + (Model.Status ?? "Deactivated")].Value]</h2>
                    <p class="text-body-secondary mb-0">@Localizer["Creator.Profile.InactiveMsg"]</p>
                </div>
            </div>
        }
        else
        {
            @* Profile details (PUT /profile/mine). *@
            <form asp-area="Creator" asp-controller="Profile" asp-action="Update" method="post" class="card border" data-loading>
                <div class="card-header border-bottom"><h2 class="card-header-title h5 mb-0">@Localizer["Creator.Profile.DetailsHeading"]</h2></div>
                <div class="card-body vstack gap-3">
                    <div asp-validation-summary="ModelOnly" class="text-danger small" role="alert"></div>

                    <div>
                        <label asp-for="DisplayName" class="form-label"></label>
                        <input asp-for="DisplayName" class="form-control" aria-describedby="display-name-help" />
                        <span asp-validation-for="DisplayName" class="text-danger small" role="alert"></span>
                    </div>

                    <div>
                        <label asp-for="Bio" class="form-label">@Localizer["Creator.Profile.BioLabel"]</label>
                        <textarea asp-for="Bio" class="form-control" rows="4" aria-describedby="bio-help"></textarea>
                        <small id="bio-help" class="form-text">@Localizer["Creator.Profile.BioHelp"]</small>
                        <span asp-validation-for="Bio" class="text-danger small d-block" role="alert"></span>
                    </div>

                    @* Avatar is managed via the upload/remove forms below; the backend preserves
                       the current avatar on profile save and ignores any client-supplied value (CA-3). *@

                    <div>
                        <label asp-for="NewSlug" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text" dir="ltr">/creators/</span>
                            <input asp-for="NewSlug" class="form-control" dir="ltr" placeholder="@Model.CurrentSlug" aria-describedby="slug-help" />
                        </div>
                        <small id="slug-help" class="form-text">@Localizer["Creator.Profile.SlugHelp"] <bdi dir="ltr">/creators/@Model.CurrentSlug</bdi></small>
                        <span asp-validation-for="NewSlug" class="text-danger small d-block" role="alert"></span>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>@Localizer["Creator.Profile.SaveProfile"]</button>
                </div>
            </form>

            @* Avatar managed upload (file). The backend validates, stores, persists, and cleans up the old file. *@
            <form asp-area="Creator" asp-controller="Profile" asp-action="AvatarUpload" method="post"
                  enctype="multipart/form-data" data-loading data-yj-component="avatar-upload"
                  data-msg-type="@Localizer["Creator.Profile.AvatarInvalidType"]"
                  data-msg-size="@Localizer["Creator.Profile.AvatarTooLarge"]" class="card border">
                <div class="card-header border-bottom"><h2 class="card-header-title h5 mb-0">@Localizer["Creator.Profile.AvatarHeading"]</h2></div>
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3">
                        <img id="avatarPreview" width="96" height="96" class="rounded-circle object-fit-cover flex-shrink-0"
                             src="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? Url.Content("~/assets/images/avatar/01.jpg") : Model.AvatarUrl)"
                             alt="@Localizer["Creator.Profile.AvatarPreviewAlt"]" />
                        <div class="flex-grow-1">
                            <label class="form-label" for="avatarFile">@Localizer["Creator.Profile.AvatarUploadLabel"]</label>
                            <input type="file" id="avatarFile" name="avatarFile" accept="image/jpeg,image/png,image/webp" class="form-control" aria-describedby="avatar-upload-hint" />
                            <span id="avatar-upload-hint" class="form-text">@Localizer["Creator.Profile.AvatarUploadHint"]</span>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-cloud-arrow-up me-1" aria-hidden="true"></i>@Localizer["Creator.Profile.UpdateAvatar"]</button>
                </div>
            </form>

            @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
            {
                <form asp-area="Creator" asp-controller="Profile" asp-action="RemoveAvatar" method="post" class="mt-n2" data-loading>
                    <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fa-solid fa-trash-can me-1" aria-hidden="true"></i>@Localizer["Creator.Profile.RemoveAvatar"]</button>
                </form>
            }

            @* Danger zone: self-deactivate (modal-confirmed). *@
            <div class="card border border-danger">
                <div class="card-header border-bottom"><h2 class="card-header-title h5 mb-0 text-danger">@Localizer["Creator.Profile.DangerHeading"]</h2></div>
                <div class="card-body d-sm-flex justify-content-between align-items-center">
                    <p class="text-body-secondary mb-2 mb-sm-0">@Localizer["Creator.Profile.DangerMsg"]</p>
                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deactivateModal">
                        <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>@Localizer["Creator.Profile.Deactivate"]
                    </button>
                </div>
            </div>

            <div class="modal fade" id="deactivateModal" tabindex="-1" aria-labelledby="deactivateModalLabel" aria-describedby="deactivateModalBody" aria-hidden="true"
                 data-bs-backdrop="static" data-bs-keyboard="false">
                <div class="modal-dialog modal-dialog-centered">
                    @* MOD3/MOD5: kept as a bespoke modal (not generic data-confirm) because it hosts a
                       REQUIRED confirmation checkbox; static backdrop + Cancel safe-default focus. *@
                    <form asp-area="Creator" asp-controller="Profile" asp-action="Deactivate" method="post" class="modal-content" role="dialog" aria-modal="true" aria-labelledby="deactivateModalLabel" data-loading>
                        <div class="modal-header">
                            <h2 class="modal-title h5" id="deactivateModalLabel">@Localizer["Creator.Profile.ModalTitle"]</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Creator.Profile.Cancel"]"></button>
                        </div>
                        <div class="modal-body vstack gap-3" id="deactivateModalBody">
                            <p class="mb-0">@Localizer["Creator.Profile.ModalBody"]</p>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="confirm" value="true" id="confirmDeactivate" required>
                                <label class="form-check-label" for="confirmDeactivate">@Localizer["Creator.Profile.ConfirmCheck"]</label>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Creator.Profile.Cancel"]</button>
                            <button type="submit" class="btn btn-danger">@Localizer["Creator.Profile.ConfirmDeactivate"]</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script src="~/assets/js/creator-profile-avatar.js" asp-append-version="true" defer></script>
}
