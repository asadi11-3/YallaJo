@model YallaJo.Web.Areas.Creator.Models.Articles.ArticleEditorVm
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = (Model.IsNew ? Localizer["Creator.Editor.NewTitle"] : Localizer["Creator.Editor.EditTitle"]).Value;
    var sidebar = ViewBag.Sidebar as YallaJo.Web.Areas.Creator.Shared.CreatorSidebarVm
                  ?? new YallaJo.Web.Areas.Creator.Shared.CreatorSidebarVm();
    var postAction = Model.IsNew ? "New" : "Edit";
}

<partial name="_CreatorSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-sm-flex justify-content-between align-items-center">
            <h1 class="fs-4 mb-0"><i class="fa-solid fa-pen-to-square me-2" aria-hidden="true"></i>@ViewData["Title"]</h1>
            <div class="mt-2 mt-sm-0 d-flex gap-2 align-items-center">
                @if (!Model.IsNew && !string.IsNullOrWhiteSpace(Model.Status))
                {
                    <partial name="_StatusBadge" model="@Model.Status" />
                }
                <a asp-area="Creator" asp-controller="Articles" asp-action="Index" class="btn btn-sm btn-secondary-soft">
                    @Localizer["Creator.Editor.BackToList"]
                </a>
            </div>
        </div>

        <form asp-area="Creator" asp-controller="Articles" asp-action="@postAction"
              asp-route-id="@(Model.IsNew ? null : Model.Id?.ToString())" method="post" class="card border"
              id="articleEditorForm" data-loading data-article-id="@(Model.IsNew ? "new" : Model.Id?.ToString())"
              data-recovery-prompt="@Localizer["Creator.Editor.DraftRecoveryPrompt"]"
              data-recovery-prompt-unknown="@Localizer["Creator.Editor.DraftRecoveryUnknown"]"
              data-recovery-restore="@Localizer["Creator.Editor.DraftRestore"]"
              data-recovery-discard="@Localizer["Creator.Editor.DraftDiscard"]">
            <div class="card-body vstack gap-3">
                <div asp-validation-summary="ModelOnly" class="text-danger small" role="alert"></div>

                @if (!Model.IsNew)
                {
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="RowVersion" />
                    <input type="hidden" asp-for="Status" />
                }

                <div>
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small" role="alert"></span>
                </div>

                <div>
                    <label asp-for="Slug" class="form-label"></label>
                    <input asp-for="Slug" class="form-control" dir="ltr" aria-describedby="slug-help"
                           placeholder="@Localizer["Creator.Editor.SlugPlaceholder"]" />
                    <div id="slug-help" class="form-text">@Localizer["Creator.Editor.SlugHelp"]</div>
                    <span asp-validation-for="Slug" class="text-danger small" role="alert"></span>
                </div>

                <div>
                    <label asp-for="SourceLanguageCode" class="form-label"></label>
                    <input asp-for="SourceLanguageCode" class="form-control" dir="ltr" aria-describedby="lang-help" />
                    <div id="lang-help" class="form-text">@Localizer["Creator.Editor.LanguageHelp"]</div>
                    <span asp-validation-for="SourceLanguageCode" class="text-danger small" role="alert"></span>
                </div>

                <div>
                    <label asp-for="Summary" class="form-label">@Localizer["Creator.Editor.SummaryLabel"]</label>
                    <textarea asp-for="Summary" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Summary" class="text-danger small" role="alert"></span>
                </div>

                <div>
                    <label asp-for="Content" class="form-label">@Localizer["Creator.Editor.ContentLabel"]</label>
                    @* J1: Quill rich-text host. The textarea is the hidden backing field that is
                       posted; creator-article-editor.js syncs Quill HTML into it. Falls back to a
                       visible textarea if Quill fails to load. *@
                    <div id="contentEditor" class="border rounded quill-editor-host"></div>
                    <textarea asp-for="Content" class="form-control" rows="12" data-quill-backing></textarea>
                    <span asp-validation-for="Content" class="text-danger small" role="alert"></span>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="MetaTitle" class="form-label"></label>
                        <input asp-for="MetaTitle" class="form-control" />
                        <span asp-validation-for="MetaTitle" class="text-danger small" role="alert"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MetaDescription" class="form-label"></label>
                        <input asp-for="MetaDescription" class="form-control" />
                        <span asp-validation-for="MetaDescription" class="text-danger small" role="alert"></span>
                    </div>
                </div>
            </div>
            <div class="card-footer d-flex gap-2 align-items-center">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-floppy-disk me-1" aria-hidden="true"></i>@(Model.IsNew ? Localizer["Creator.Editor.SaveDraft"] : Localizer["Creator.Editor.SaveChanges"])
                </button>
                @* F5 autosave status. Populated by creator-article-editor.js; the {0} placeholder
                   receives the local save time. Local-only (no server autosync). A11Y9 aria-live. *@
                <span id="draftSavedIndicator" class="small text-body-secondary ms-auto" aria-live="polite"
                      data-draft-saved-template="@Localizer["Creator.Editor.DraftSavedLocally"]" hidden>
                    <i class="fa-solid fa-cloud-arrow-up me-1" aria-hidden="true"></i><span data-draft-saved-text></span>
                </span>
            </div>
        </form>

        @* ── Article images — separate from the text-save form above ── *@
        <div class="card border">
            <div class="card-header border-bottom">
                <h2 class="card-header-title h5 mb-0"><i class="fa-solid fa-images me-2" aria-hidden="true"></i>@Localizer["Creator.Editor.ImagesHeading"]</h2>
            </div>
            <div class="card-body">
                @if (Model.IsNew || Model.Images is null)
                {
                    <p class="text-body-secondary mb-0">
                        <i class="fa-solid fa-circle-info me-1" aria-hidden="true"></i>@Localizer["Creator.Editor.ImagesAfterSave"]
                    </p>
                }
                else
                {
                    <div id="articleImagesHost"
                         data-yj-component="article-images"
                         data-msg-uploaded="@Localizer["Creator.Images.Toast.Uploaded"]"
                         data-msg-deleted="@Localizer["Creator.Images.Toast.Deleted"]"
                         data-msg-primary="@Localizer["Creator.Images.Toast.PrimarySet"]"
                         data-msg-reordered="@Localizer["Creator.Images.Toast.Reordered"]"
                         data-msg-error="@Localizer["Creator.Images.Toast.Failed"]"
                         aria-live="polite"
                         aria-busy="false">
                        <partial name="_ArticleImages" model="Model.Images" />
                    </div>
                }
            </div>
        </div>

        @* ── Related tours — separate from the text-save form above ── *@
        @if (!Model.IsNew)
        {
            <div class="card border">
                <div class="card-header border-bottom">
                    <h2 class="card-header-title h5 mb-0"><i class="fa-solid fa-link me-2" aria-hidden="true"></i>@Localizer["Creator.Editor.ToursHeading"]</h2>
                    <small class="text-body-secondary">@Localizer["Creator.Editor.ToursSubtitle"]</small>
                </div>
                <div class="card-body vstack gap-3" data-yj-component="tour-combobox"
                     data-lookup-url="@Url.Action("TourLookup", "Articles", new { area = "Creator" })">
                    @* Currently linked tours: chips with inline unlink (F8 confirm). *@
                    <partial name="_LinkedTourChips" model="Model" />

                    <permission require="@WebPermission.BlogTourLink.Create">
                        @* F10: no raw entity-ID input. Async combobox resolves a tour by name to a
                           hidden GUID; with JS off the typed name posts as tourQuery and the server
                           resolves it (PE1). *@
                        <form asp-area="Creator" asp-controller="Articles" asp-action="LinkTour"
                              asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end" data-loading>
                            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                            <input type="hidden" id="tourId" name="tourId" />
                            <div class="col-sm-8 position-relative">
                                <label for="tourSearch" class="form-label">@Localizer["Creator.Editor.TourSearchLabel"]</label>
                                <input type="text" id="tourSearch" name="tourQuery" class="form-control"
                                       role="combobox" aria-expanded="false" aria-controls="tourSearchList"
                                       aria-autocomplete="list" aria-describedby="tour-search-help"
                                       autocomplete="off" placeholder="@Localizer["Creator.Editor.TourSearchPlaceholder"]" />
                                 <ul id="tourSearchList" class="list-group position-absolute w-100 shadow-sm mt-1 tour-suggest-list"
                                     role="listbox" aria-label="@Localizer["Creator.Editor.TourSearchLabel"]" hidden></ul>
                                <div id="tour-search-help" class="form-text">@Localizer["Creator.Editor.TourSearchHelp"]</div>
                                <div class="form-text text-body-secondary" data-tour-empty hidden>@Localizer["Creator.Editor.TourNoResults"]</div>
                            </div>
                            <div class="col-sm-4 d-grid">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>@Localizer["Creator.Editor.LinkTour"]
                                </button>
                            </div>
                        </form>
                    </permission>
                    <p class="text-body-secondary small mb-0">
                        <i class="fa-solid fa-circle-info me-1" aria-hidden="true"></i>@Localizer["Creator.Editor.ToursVersionNote"]
                    </p>
                </div>
            </div>
        }

        @if (!Model.IsNew)
        {
            <div class="d-flex gap-2">
                @if (Model.CanSubmit)
                {
                    <permission require="@WebPermission.Blog.Submit">
                        <form asp-area="Creator" asp-controller="Articles" asp-action="Submit"
                              asp-route-id="@Model.Id" method="post" data-loading>
                            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                            <button type="submit" class="btn btn-success">
                                <i class="fa-solid fa-paper-plane me-1" aria-hidden="true"></i>@Localizer["Creator.Editor.SubmitForReview"]
                            </button>
                        </form>
                    </permission>
                }
                @* F8: destructive confirm via shared form-ux modal (data-confirm), safe-default
                   Cancel autofocus; no bespoke per-page modal needed. *@
                <permission require="@WebPermission.Blog.DeleteOwn">
                    <form asp-area="Creator" asp-controller="Articles" asp-action="Delete"
                          asp-route-id="@Model.Id" method="post" class="ms-auto" data-loading
                          data-confirm="@Localizer["Creator.Editor.DeleteBody", Model.Title]"
                          data-confirm-title="@Localizer["Creator.Editor.DeleteTitle"]"
                          data-confirm-action="@Localizer["Creator.Editor.DeleteConfirm"]"
                          data-confirm-cancel="@Localizer["Creator.Editor.Cancel"]">
                        <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                        <button type="submit" class="btn btn-danger">
                            <i class="fa-solid fa-trash me-1" aria-hidden="true"></i>@Localizer["Creator.Editor.Delete"]
                        </button>
                    </form>
                </permission>
            </div>
        }
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/assets/vendor/quill/css/quill.snow.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/assets/vendor/quill/js/quill.min.js" asp-append-version="true"></script>
    <script src="~/assets/js/creator-article-editor.js" asp-append-version="true" defer></script>
    <script src="~/assets/js/creator-article-images.js" asp-append-version="true" defer></script>
    <script src="~/assets/js/creator-tour-combobox.js" asp-append-version="true" defer></script>
}
