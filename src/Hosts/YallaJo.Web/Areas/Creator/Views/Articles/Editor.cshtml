@model YallaJo.Web.Areas.Creator.Models.Articles.ArticleEditorVm
@{
    ViewData["Title"] = Model.IsNew ? "New Article" : "Edit Article";
    var sidebar = ViewBag.Sidebar as YallaJo.Web.Areas.Creator.Shared.CreatorSidebarVm
                  ?? new YallaJo.Web.Areas.Creator.Shared.CreatorSidebarVm();
    var postAction = Model.IsNew ? "New" : "Edit";
}

<partial name="_CreatorSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-sm-flex justify-content-between align-items-center">
            <h1 class="fs-4 mb-0"><i class="bi bi-pencil-square me-2"></i>@ViewData["Title"]</h1>
            <div class="mt-2 mt-sm-0 d-flex gap-2 align-items-center">
                @* True status from admin-get — only available when editing. *@
                @if (!Model.IsNew && !string.IsNullOrWhiteSpace(Model.Status))
                {
                    <span class="badge text-bg-light">@Model.Status</span>
                }
                <a asp-area="Creator" asp-controller="Articles" asp-action="Index" class="btn btn-sm btn-secondary-soft">
                    Back to list
                </a>
            </div>
        </div>

        <form asp-area="Creator" asp-controller="Articles" asp-action="@postAction"
              asp-route-id="@(Model.IsNew ? null : Model.Id?.ToString())" method="post" class="card border"
              id="articleEditorForm" data-article-id="@(Model.IsNew ? "new" : Model.Id?.ToString())">
            <div class="card-body vstack gap-3">
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                @if (!Model.IsNew)
                {
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="RowVersion" />
                    <input type="hidden" asp-for="Status" />
                }

                <div>
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="Slug" class="form-label"></label>
                    <input asp-for="Slug" class="form-control" placeholder="auto-generated from title if blank" />
                    <span asp-validation-for="Slug" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="SourceLanguageCode" class="form-label"></label>
                    <input asp-for="SourceLanguageCode" class="form-control" />
                    <span asp-validation-for="SourceLanguageCode" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="Summary" class="form-label">Summary</label>
                    <textarea asp-for="Summary" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Summary" class="text-danger small"></span>
                </div>

                <div>
                    <label asp-for="Content" class="form-label">Content</label>
                    @* J1: Quill rich-text host. The textarea is the hidden backing field that is
                       posted; creator-article-editor.js syncs Quill HTML into it. Falls back to a
                       visible textarea if Quill fails to load. *@
                    <div id="contentEditor" class="border rounded" style="min-height: 16rem;"></div>
                    <textarea asp-for="Content" class="form-control" rows="12" data-quill-backing></textarea>
                    <span asp-validation-for="Content" class="text-danger small"></span>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="MetaTitle" class="form-label"></label>
                        <input asp-for="MetaTitle" class="form-control" />
                        <span asp-validation-for="MetaTitle" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MetaDescription" class="form-label"></label>
                        <input asp-for="MetaDescription" class="form-control" />
                        <span asp-validation-for="MetaDescription" class="text-danger small"></span>
                    </div>
                </div>
            </div>
            <div class="card-footer d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i>@(Model.IsNew ? "Save draft" : "Save changes")
                </button>
            </div>
        </form>

        @* ── Article images (CCD-5) — separate from the text-save form above ── *@
        <div class="card border">
            <div class="card-header border-bottom">
                <h5 class="card-header-title mb-0"><i class="bi bi-images me-2"></i>Images</h5>
            </div>
            <div class="card-body">
                @if (Model.IsNew || Model.Images is null)
                {
                    <p class="text-body-secondary mb-0">
                        <i class="bi bi-info-circle me-1"></i>Save the draft first, then you can add images.
                    </p>
                }
                else
                {
                    <partial name="_ArticleImages" model="Model.Images" />
                }
            </div>
        </div>

        @* ── Related tours (§7.2) — separate from the text-save form above ── *@
        @if (!Model.IsNew)
        {
            <div class="card border">
                <div class="card-header border-bottom">
                    <h5 class="card-header-title mb-0"><i class="bi bi-link-45deg me-2"></i>Related tours</h5>
                    <small class="text-body-secondary">Associate tours with this article (by tour ID).</small>
                </div>
                <div class="card-body vstack gap-3">
                    <permission require="@WebPermission.BlogTourLink.Create">
                        <form asp-area="Creator" asp-controller="Articles" asp-action="LinkTour"
                              asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end">
                            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                            <div class="col-sm-8">
                                <label for="linkTourId" class="form-label">Tour ID</label>
                                <input type="text" id="linkTourId" name="tourId" class="form-control"
                                       placeholder="00000000-0000-0000-0000-000000000000" />
                            </div>
                            <div class="col-sm-4 d-grid">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-plus-lg me-1"></i>Link tour
                                </button>
                            </div>
                        </form>
                    </permission>
                    <permission require="@WebPermission.BlogTourLink.Delete">
                        <form asp-area="Creator" asp-controller="Articles" asp-action="UnlinkTour"
                              asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end"
                              onsubmit="return confirm('Unlink this tour from the article?');">
                            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                            <div class="col-sm-8">
                                <label for="unlinkTourId" class="form-label">Tour ID to unlink</label>
                                <input type="text" id="unlinkTourId" name="tourId" class="form-control"
                                       placeholder="00000000-0000-0000-0000-000000000000" />
                            </div>
                            <div class="col-sm-4 d-grid">
                                <button type="submit" class="btn btn-outline-danger">
                                    <i class="bi bi-x-lg me-1"></i>Unlink tour
                                </button>
                            </div>
                        </form>
                    </permission>
                    <p class="text-body-secondary small mb-0">
                        <i class="bi bi-info-circle me-1"></i>Linking uses the article's current version; if it was
                        changed elsewhere, refresh the editor first.
                    </p>
                </div>
            </div>
        }

        @if (!Model.IsNew)
        {
            <div class="d-flex gap-2">
                @if (Model.CanSubmit)
                {
                    <permission require="@WebPermission.Blog.Submit">
                        <form asp-area="Creator" asp-controller="Articles" asp-action="Submit"
                              asp-route-id="@Model.Id" method="post">
                            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-send me-1"></i>Submit for review
                            </button>
                        </form>
                    </permission>
                }
                <permission require="@WebPermission.Blog.DeleteOwn">
                    <button type="button" class="btn btn-danger ms-auto" data-bs-toggle="modal" data-bs-target="#deleteArticleModal">
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                </permission>
            </div>

            <div class="modal fade" id="deleteArticleModal" tabindex="-1" aria-labelledby="deleteArticleModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <form asp-area="Creator" asp-controller="Articles" asp-action="Delete"
                          asp-route-id="@Model.Id" method="post" class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="deleteArticleModalLabel">Delete this article?</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
                            <p class="mb-0">
                                "<strong>@Model.Title</strong>" will be deleted. You'll be able to undo this
                                immediately afterwards from the articles list.
                            </p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger">Delete article</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/assets/vendor/quill/css/quill.snow.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/assets/vendor/quill/js/quill.min.js" asp-append-version="true"></script>
    <script src="~/assets/js/creator-article-editor.js" asp-append-version="true" defer></script>
}
