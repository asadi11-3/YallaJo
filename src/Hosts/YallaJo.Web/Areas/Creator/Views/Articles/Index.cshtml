@model YallaJo.Web.Areas.Creator.Models.Articles.MyArticlesVm
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Creator.Articles.Title"].Value;
    var sidebar = ViewBag.Sidebar as YallaJo.Web.Areas.Creator.Shared.CreatorSidebarVm
                  ?? new YallaJo.Web.Areas.Creator.Shared.CreatorSidebarVm();
    string StatusLabel(string? s) => Localizer["Creator.Status." + (string.IsNullOrWhiteSpace(s) ? "Draft" : s)].Value;
}

<partial name="_CreatorSidebar" model="sidebar" />

<section class="pt-0">
    <div class="container vstack gap-4">
        <div class="d-sm-flex justify-content-between align-items-center">
            <h1 class="fs-4 mb-0"><i class="fa-solid fa-book-open me-2" aria-hidden="true"></i>@Localizer["Creator.Articles.Heading"]</h1>
            <permission require="@WebPermission.Blog.Create">
                <a asp-area="Creator" asp-controller="Articles" asp-action="New" class="btn btn-sm btn-primary mt-2 mt-sm-0">
                    <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>@Localizer["Creator.Articles.NewArticle"]
                </a>
            </permission>
        </div>

        @* Status filter — counted tabs. Plain GET links (asp-route-status) so they work
           without JS (S1/PE1); listing.js intercepts same-pathname clicks for AJAX
           refinement. Count badges come from the status-counts aggregate (B3); when
           counts are unavailable the pills simply render without a badge (ERR3). *@
        @{
            var allActive = string.IsNullOrEmpty(Model.StatusFilter);

            string PillClass(bool active) =>
                "btn btn-sm " + (active ? "btn-primary" : "btn-secondary-soft") +
                " d-inline-flex align-items-center gap-2";
        }
        <nav class="d-flex flex-wrap gap-2" aria-label="@Localizer["Creator.Articles.StatusLabel"]">
            <a asp-area="Creator" asp-controller="Articles" asp-action="Index"
               class="@PillClass(allActive)" aria-current="@(allActive ? "page" : null)">
                <span>@Localizer["Creator.Articles.AllStatuses"]</span>
                @{ var allCount = Model.CountFor(null); }
                @if (allCount is not null)
                {
                    <span class="badge text-bg-light font-data"><bdi dir="ltr">@allCount.Value.ToString("N0")</bdi></span>
                }
            </a>
            @foreach (var opt in Model.StatusOptions)
            {
                var active = string.Equals(opt, Model.StatusFilter, StringComparison.OrdinalIgnoreCase);
                var count = Model.CountFor(opt);
                <a asp-area="Creator" asp-controller="Articles" asp-action="Index" asp-route-status="@opt"
                   class="@PillClass(active)" aria-current="@(active ? "page" : null)">
                    <span>@StatusLabel(opt)</span>
                    @if (count is not null)
                    {
                        <span class="badge text-bg-light font-data"><bdi dir="ltr">@count.Value.ToString("N0")</bdi></span>
                    }
                </a>
            }
        </nav>

        @* S1/L1/A11Y9: AJAX-refined results region; server renders the same fragment without JS (PE1). *@
        <div id="listingResults" data-yj-component="listing" aria-live="polite" aria-busy="false"
             data-error-text="@Localizer["Public.Results.Error"]" data-retry-text="@Localizer["Public.Retry"]"
             data-loading-text="@Localizer["Public.Loading"]">
            <partial name="_ArticlesResults" model="Model" />
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/assets/js/listing.js" asp-append-version="true"></script>
}
