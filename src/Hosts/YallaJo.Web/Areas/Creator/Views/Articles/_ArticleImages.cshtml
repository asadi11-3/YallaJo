@model YallaJo.Web.Areas.Creator.Models.Articles.Images.ArticleImagesVm
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<YallaJo.Web.Resources.SharedResource> Localizer
@{
    var ids = Model.Images.Select(i => i.Id).ToList();
}

@* Upload (separate multipart form — NOT the article text-save form) *@
@if (Model.CanAddMore)
{
    <permission require="@WebPermission.Attachment.Create">
        <form asp-area="Creator" asp-controller="Articles" asp-action="UploadImages"
              asp-route-id="@Model.BlogId" method="post" enctype="multipart/form-data" class="mb-3">
            <input type="hidden" name="existingCount" value="@Model.Images.Count" />
            <label class="form-label" for="imageFiles">
                @Localizer["Creator.Images.AddLabel"] <span class="text-body-secondary">@Localizer["Creator.Images.AddHint", Model.RemainingSlots]</span>
            </label>
            <div class="input-group">
                <input id="imageFiles" type="file" name="files" class="form-control"
                       accept="image/jpeg,image/png,image/gif,image/webp" multiple />
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-upload me-1" aria-hidden="true"></i>@Localizer["Creator.Images.Upload"]</button>
            </div>
        </form>
    </permission>
}
else
{
    <div class="alert alert-info mb-3 small" role="status">
        <i class="fa-solid fa-circle-info me-1" aria-hidden="true"></i>@Localizer["Creator.Images.MaxReached", Model.MaxImages]
    </div>
}

@if (!Model.HasImages)
{
    <p class="text-body-secondary mb-0">@Localizer["Creator.Images.None"]</p>
}
else
{
    <div class="row g-3">
        @for (var idx = 0; idx < Model.Images.Count; idx++)
        {
            var img = Model.Images[idx];
            <div class="col-6 col-md-3">
                <div class="card border h-100">
                    <img src="@img.DisplayUrl" class="card-img-top" alt="@img.OriginalFileName" loading="lazy"
                         style="aspect-ratio:4/3;object-fit:cover;" />
                    <div class="card-body p-2 d-flex flex-wrap gap-1 justify-content-between align-items-center">
                        <div class="btn-group btn-group-sm">
                            @* Reorder up/down — post the full order with this item swapped. *@
                            <permission require="@WebPermission.Attachment.Update">
                                @if (idx > 0)
                                {
                                    var up = new List<Guid>(ids);
                                    (up[idx - 1], up[idx]) = (up[idx], up[idx - 1]);
                                    <form asp-area="Creator" asp-controller="Articles" asp-action="ReorderImages"
                                          asp-route-id="@Model.BlogId" method="post" class="d-inline">
                                        @foreach (var oid in up)
                                        {
                                            <input type="hidden" name="orderedAttachmentIds" value="@oid" />
                                        }
                                        <button type="submit" class="btn btn-outline-secondary" title="@Localizer["Creator.Images.MoveUp"]" aria-label="@Localizer["Creator.Images.MoveUp"]">
                                            <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                }
                                @if (idx < Model.Images.Count - 1)
                                {
                                    var down = new List<Guid>(ids);
                                    (down[idx + 1], down[idx]) = (down[idx], down[idx + 1]);
                                    <form asp-area="Creator" asp-controller="Articles" asp-action="ReorderImages"
                                          asp-route-id="@Model.BlogId" method="post" class="d-inline">
                                        @foreach (var oid in down)
                                        {
                                            <input type="hidden" name="orderedAttachmentIds" value="@oid" />
                                        }
                                        <button type="submit" class="btn btn-outline-secondary" title="@Localizer["Creator.Images.MoveDown"]" aria-label="@Localizer["Creator.Images.MoveDown"]">
                                            <i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                }
                            </permission>
                        </div>
                        <div class="btn-group btn-group-sm">
                            <permission require="@WebPermission.EntityImage.Update">
                                @if (img.IsPrimary)
                                {
                                    <button type="button" class="btn btn-primary" title="@Localizer["Creator.Images.Primary"]" aria-label="@Localizer["Creator.Images.Primary"]" disabled>
                                        <i class="fa-solid fa-star" aria-hidden="true"></i>
                                    </button>
                                }
                                else
                                {
                                    <form asp-area="Creator" asp-controller="Articles" asp-action="SetPrimaryImage"
                                          asp-route-id="@Model.BlogId" asp-route-attachmentId="@img.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-outline-primary" title="@Localizer["Creator.Images.SetPrimary"]" aria-label="@Localizer["Creator.Images.SetPrimary"]">
                                            <i class="fa-regular fa-star" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                }
                            </permission>
                            <permission require="@WebPermission.Attachment.Delete">
                                <button type="button" class="btn btn-outline-danger" title="@Localizer["Creator.Images.Delete"]" aria-label="@Localizer["Creator.Images.Delete"]"
                                        data-bs-toggle="modal" data-bs-target="#deleteImageModal_@img.Id">
                                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                </button>
                            </permission>
                        </div>
                    </div>
                </div>
            </div>

            @* Per-image delete confirmation modal *@
            <permission require="@WebPermission.Attachment.Delete">
                <div class="modal fade" id="deleteImageModal_@img.Id" tabindex="-1" aria-labelledby="deleteImageModalLabel_@img.Id"
                     aria-describedby="deleteImageModalBody_@img.Id" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                    <div class="modal-dialog modal-dialog-centered">
                        <form asp-area="Creator" asp-controller="Articles" asp-action="DeleteImage"
                              asp-route-id="@Model.BlogId" asp-route-attachmentId="@img.Id" method="post" class="modal-content" role="dialog" aria-modal="true">
                            <div class="modal-header">
                                <h2 class="modal-title h5" id="deleteImageModalLabel_@img.Id">@Localizer["Creator.Images.DeleteTitle"]</h2>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["Creator.Images.Cancel"]"></button>
                            </div>
                            <div class="modal-body" id="deleteImageModalBody_@img.Id">
                                <p class="mb-0">@Localizer["Creator.Images.DeleteBody"]</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Creator.Images.Cancel"]</button>
                                <button type="submit" class="btn btn-danger">@Localizer["Creator.Images.DeleteConfirm"]</button>
                            </div>
                        </form>
                    </div>
                </div>
            </permission>
        }
    </div>
}
