@model YallaJo.Web.Areas.Content.Models.Blogs.CreatorProfileVm
@{
    ViewData["Title"] = Model.DisplayName;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isAuthed = User.Identity?.IsAuthenticated == true;
    var returnUrl = Url.Action(nameof(YallaJo.Web.Areas.Content.Controllers.CreatorsController.Profile), "Creators", new { area = "Content", slug = Model.Slug });
}

<section class="pt-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="card card-body border text-center">
                    <div class="avatar avatar-xxl mx-auto mb-3">
                        <img class="avatar-img rounded-circle border border-2 border-white" src="@Model.AvatarUrl" alt="@Model.DisplayName">
                    </div>
                    <h4 class="mb-1">@Model.DisplayName</h4>
                    @if (!string.IsNullOrWhiteSpace(Model.Bio))
                    {
                        <p class="text-muted small">@Model.Bio</p>
                    }

                    <div class="d-flex justify-content-center gap-4 my-3">
                        <div>
                            <h6 class="mb-0">@Model.ArticleCount</h6>
                            <small class="text-muted">Articles</small>
                        </div>
                        <div>
                            <h6 class="mb-0">@Model.FollowerCount</h6>
                            <small class="text-muted">Followers</small>
                        </div>
                        <div>
                            <h6 class="mb-0">@Model.TotalViewCount.ToString("N0")</h6>
                            <small class="text-muted">Views</small>
                        </div>
                    </div>

                    @if (isAuthed)
                    {
                        <div class="d-grid gap-2">
                            <form asp-area="Content" asp-controller="Creators" asp-action="Follow" asp-route-slug="@Model.Slug" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="profileId" value="@Model.FollowTargetId" />
                                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-person-plus-fill me-1"></i>Follow</button>
                            </form>
                            <form asp-area="Content" asp-controller="Creators" asp-action="Unfollow" asp-route-slug="@Model.Slug" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="profileId" value="@Model.FollowTargetId" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm w-100"><i class="bi bi-person-dash me-1"></i>Unfollow</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-primary-soft w-100" asp-area="Auth" asp-controller="Auth" asp-action="SignIn" asp-route-returnUrl="@returnUrl">
                            <i class="bi bi-person-plus-fill me-1"></i>Sign in to follow
                        </a>
                    }
                </div>
            </div>

            <div class="col-lg-8">
                <h5 class="mb-3">Articles by @Model.DisplayName</h5>
                @if (!Model.HasBlogs)
                {
                    <div class="card card-body border text-center py-5">
                        <img src="~/assets/images/element/17.svg" class="h-100px mb-3 mx-auto" alt="">
                        <h6 class="mb-0">No published articles yet</h6>
                    </div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var blog in Model.Blogs)
                        {
                            <div class="col-sm-6">
                                <div class="card border h-100">
                                    <img src="@blog.ImageUrl" class="card-img-top" alt="@blog.Title" style="height:160px;object-fit:cover;">
                                    <div class="card-body">
                                        <h6 class="card-title">
                                            <a class="stretched-link" asp-area="Content" asp-controller="Blogs" asp-action="Details" asp-route-slug="@blog.Slug">@blog.Title</a>
                                        </h6>
                                        @if (!string.IsNullOrWhiteSpace(blog.Summary))
                                        {
                                            <p class="small text-muted mb-0">@blog.Summary</p>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>
