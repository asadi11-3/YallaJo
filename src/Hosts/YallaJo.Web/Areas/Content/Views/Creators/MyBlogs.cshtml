@model YallaJo.Web.Areas.Content.Models.Blogs.MyBlogsVm
@{
    ViewData["Title"] = "My articles";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string StatusBadge(string? status) => (status ?? string.Empty).ToLowerInvariant() switch
    {
        "published" => "text-bg-success",
        "pendingreview" or "pending" or "inreview" => "text-bg-warning",
        "rejected" => "text-bg-danger",
        "archived" => "text-bg-secondary",
        _ => "text-bg-light"
    };
}

<section class="pt-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">My articles</h3>
            <a class="btn btn-primary btn-sm" asp-area="Content" asp-controller="Creators" asp-action="Write">
                <i class="bi bi-plus-lg me-1"></i>Write new article
            </a>
        </div>

        @if (!Model.HasBlogs)
        {
            <div class="card card-body border text-center py-5">
                <img src="~/assets/images/element/17.svg" class="h-100px mb-3 mx-auto" alt="">
                <h6 class="mb-2">You haven't written any articles yet</h6>
                <div>
                    <a class="btn btn-primary-soft btn-sm" asp-area="Content" asp-controller="Creators" asp-action="Write">Start writing</a>
                </div>
            </div>
        }
        else
        {
            <div class="card border">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Title</th>
                                <th>Status</th>
                                <th>Published</th>
                                <th class="text-end">Views</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var blog in Model.Blogs)
                            {
                                <tr>
                                    <td>@blog.Title</td>
                                    <td><span class="badge @StatusBadge(blog.Status)">@(blog.Status ?? "Draft")</span></td>
                                    <td>@(blog.PublishedAt?.ToString("d MMM yyyy") ?? "—")</td>
                                    <td class="text-end">@blog.ViewCount.ToString("N0")</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-light" asp-area="Content" asp-controller="Creators" asp-action="Edit" asp-route-id="@blog.Id">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        @if (blog.CanSubmit)
                                        {
                                            <form class="d-inline" asp-area="Content" asp-controller="Creators" asp-action="Submit" asp-route-id="@blog.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-primary-soft"><i class="bi bi-send"></i> Submit</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</section>
