@using YallaJo.Web.Areas.Content.Models.CreatorApplication
@model CreatorApplyVm
@{
    ViewData["Title"] = "Apply to become a creator";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="pt-0">
    <div class="container vstack gap-4" style="max-width: 820px;">
        <div>
            <h1 class="h3 mb-1">Apply to become a creator</h1>
            <p class="text-body-secondary mb-0">Tell us about your work. You can save and refine your application before it is reviewed.</p>
        </div>

        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success" role="alert">@ok</div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger" role="alert">@err</div>
        }

        <div class="card border">
            <div class="card-body">
                <form asp-area="Content" asp-controller="CreatorApplication" asp-action="Apply" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Form.Bio" class="form-label"></label>
                        <textarea asp-for="Form.Bio" class="form-control" rows="4" placeholder="A short introduction about you and your work."></textarea>
                        <span asp-validation-for="Form.Bio" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Form.PortfolioUrls" class="form-label"></label>
                        <textarea asp-for="Form.PortfolioUrls" class="form-control" rows="3"></textarea>
                        <div class="form-text">One link per line.</div>
                        <span asp-validation-for="Form.PortfolioUrls" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Form.SampleWorkUrls" class="form-label"></label>
                        <textarea asp-for="Form.SampleWorkUrls" class="form-control" rows="3"></textarea>
                        <div class="form-text">One link per line.</div>
                        <span asp-validation-for="Form.SampleWorkUrls" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <span class="form-label d-block">Niches</span>
                        @if (!Model.HasNiches)
                        {
                            <p class="text-body-secondary small mb-0">No niches are available right now. You can still submit and add niches later.</p>
                        }
                        else
                        {
                            <div class="row g-2">
                                @foreach (var niche in Model.Niches)
                                {
                                    <div class="col-md-6">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="Form.NicheIds" value="@niche.Id" id="niche-@niche.Id" @(niche.Selected ? "checked" : null) />
                                            <label class="form-check-label" for="niche-@niche.Id">
                                                @niche.Name
                                                @if (!string.IsNullOrWhiteSpace(niche.Description))
                                                {
                                                    <span class="form-text d-block">@niche.Description</span>
                                                }
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label asp-for="Form.FreeTags" class="form-label"></label>
                        <input asp-for="Form.FreeTags" class="form-control" placeholder="travel, food, history" />
                        <div class="form-text">Separate tags with commas.</div>
                        <span asp-validation-for="Form.FreeTags" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Form.SocialHandles" class="form-label"></label>
                        <textarea asp-for="Form.SocialHandles" class="form-control" rows="3" placeholder="instagram: https://instagram.com/you"></textarea>
                        <div class="form-text">One per line, in the form handle: link.</div>
                        <span asp-validation-for="Form.SocialHandles" class="text-danger small"></span>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send me-1"></i>Submit application
                        </button>
                        <a asp-area="Content" asp-controller="CreatorApplication" asp-action="Application" class="btn btn-primary-soft">
                            <i class="bi bi-arrow-left me-1"></i>Back to my application
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
