$root='C:\Users\admin1\source\repos\YallaJo\yallajo-plan'; $tests=@('POST /booking/provider/documents'); $buttonLines = Get-ChildItem -LiteralPath $root -Filter *.md | Where-Object { $_.Name -notin @('README.md','0-architecture-and-rules.md') } | ForEach-Object { Get-Content -LiteralPath $_.FullName } | Where-Object { $_ -match 'Buttons:' }; foreach($pat in $tests){ $regex = [regex]::Escape($pat) + '(?![\w/])'; $found = $buttonLines | Where-Object { $_ -match $regex }; if($found){ "$pat = BUTTON" } }