<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="14.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ContentCore.Contracts\ContentCore.Contracts.csproj" />
    <ProjectReference Include="..\ContentBlogs.Application\ContentBlogs.Application.csproj" />
    <ProjectReference Include="..\ContentBlogs.Contracts\ContentBlogs.Contracts.csproj" />
    <ProjectReference Include="..\ContentBlogs.Domain\ContentBlogs.Domain.csproj" />
    <!-- ContentPlaces.Contracts: consume PlaceDeletedIntegrationEvent so the
         PlaceDeletedIntegrationEventHandler can clear dead cross-module Place
         references on Blog.  Same scoped pattern ContentSeo.Infrastructure
         uses; Contracts assemblies are designed for cross-module consumption. -->
    <ProjectReference Include="..\ContentPlaces.Contracts\ContentPlaces.Contracts.csproj" />
    <!-- Security.Contracts only: provides Security.Contracts.Authorization
         (RolePrivilegeLevel, AppRoles, IUserPrivilegeLevelReader, etc.).
         The IUserPrivilegeLevelReader implementation is registered by
         Security.Application's AddSecurityApplication() at the host level
         so this module never needs to reference Security.Application. -->
    <ProjectReference Include="..\Security.Contracts\Security.Contracts.csproj" />
    <ProjectReference Include="..\YallaJo.SharedKernel.Infrastructure\YallaJo.SharedKernel.Infrastructure.csproj" />
  </ItemGroup>

</Project>
