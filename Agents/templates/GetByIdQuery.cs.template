using {Module}.Domain.Repositories;
using YallaJo.SharedKernel.Application.Abstractions.Messaging;
using YallaJo.SharedKernel.Domain.Abstractions.Results;
// using Microsoft.Extensions.Caching.Memory; // Uncomment when caching

namespace {Module}.Application.Queries.{Entity}.Get{Entity}ById;

public sealed class Get{Entity}ByIdQueryHandler(
    I{Entity}Repository {entity}Repository
    // , IMemoryCache cache  // Uncomment when ready
    )
    : IQueryHandler<Get{Entity}ByIdQuery, {Entity}DetailDto>
{
    public async Task<Result<{Entity}DetailDto>> Handle(
        Get{Entity}ByIdQuery request,
        CancellationToken ct)
    {
        // ── Cache check (uncomment when ready) ──
        // var cacheKey = $"{entities}:{request.Id}";
        // if (cache.TryGetValue(cacheKey, out {Entity}DetailDto? cached))
        //     return Result<{Entity}DetailDto>.Success(cached!);

        // Simple lookup:
        var {entity} = await {entity}Repository.GetByIdAsync(request.Id, ct);

        // With relationships (use AsSplitQuery for 2+ Includes — P4):
        // var {entity} = await {entity}Repository.FirstOrDefaultAsync(
        //     filter: e => e.Id == request.Id,
        //     include: q => q.Include(e => e.Category).Include(e => e.Images).AsSplitQuery(),
        //     ct: ct);

        if ({entity} is null)
            return Result<{Entity}DetailDto>.NotFound(
                "{Entity}.NotFound", $"{Entity} '{request.Id}' not found.");

        var dto = new {Entity}DetailDto(
            {entity}.Id, {entity}.Name, {entity}.Slug,
            {entity}.Description, {entity}.IsActive,
            {entity}.CreatedAt, {entity}.UpdatedAt);

        // ── Cache set (uncomment when ready) ──
        // cache.Set(cacheKey, dto, TimeSpan.FromMinutes(10));

        return Result<{Entity}DetailDto>.Success(dto);
    }
}
