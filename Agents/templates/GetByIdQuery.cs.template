/// <summary>Full detail DTO — all relevant fields for single-entity view.</summary>
public sealed record {Entity}DetailDto(
    Guid Id,
    string Name,
    string Slug,
    string? Description,
    bool IsActive,
    DateTime CreatedAt,
    DateTime? UpdatedAt);
    // TODO: Add all entity-specific fields
    // Example: decimal Price, string? ThumbnailUrl
