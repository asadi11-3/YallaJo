// ============================================================================
// TEMPLATE: EF Core Entity Configuration (Aggregate Root / AuditableEntity)
// USAGE: Copy → Replace {Module}, {Entity}, {Entities}, {schema} → Adjust properties
// FILE: {Module}.Infrastructure/Persistence/Configurations/{Entity}Configuration.cs
//
// RULES APPLIED:
//   - ValueGeneratedNever() on Id — we use Guid.CreateVersion7()
//   - IsRowVersion() on RowVersion — optimistic concurrency
//   - HasQueryFilter(!IsDeleted) — auto-excludes soft-deleted records
//   - IsUnicode(false) on slugs/codes — always ASCII (String Column Rules)
//   - Unicode (default) on names/descriptions — supports Arabic
//   - HasMaxLength() on EVERY string column — no unbounded nvarchar(max)
//   - HasPrecision(18, 2) on decimal/money fields (never float/double)
//   - HasConversion<int>() on enums — store as int, not string
//   - Filtered unique index on Slug (allows slug reuse after soft-delete)
//   - Indexes on FK columns and frequently-filtered columns
//   - HasDefaultValue on booleans and status columns
// ============================================================================
using {Module}.Domain.Entities;
using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Metadata.Builders;

namespace {Module}.Infrastructure.Persistence.Configurations;

public class {Entity}Configuration : IEntityTypeConfiguration<{Entity}>
{
    public void Configure(EntityTypeBuilder<{Entity}> builder)
    {
        // ── Table & Schema ──
        builder.ToTable("{Entities}", "{schema}");

        // ── Primary Key ──
        builder.HasKey(x => x.Id);
        builder.Property(x => x.Id).ValueGeneratedNever();

        // ── Required String Properties ──
        builder.Property(x => x.Name)
            .IsRequired()
            .HasMaxLength(200);                // Unicode default — supports Arabic

        builder.Property(x => x.Slug)
            .IsRequired()
            .IsUnicode(false)                  // ASCII only — slugs never Arabic
            .HasMaxLength(200);

        // ── Optional String Properties ──
        builder.Property(x => x.Description)
            .IsRequired(false)
            .HasMaxLength(2000);

        // ── Boolean/Status ──
        builder.Property(x => x.IsActive)
            .IsRequired()
            .HasDefaultValue(true);

        // ── TODO: Entity-Specific Properties ──
        // Money:  builder.Property(x => x.Price).IsRequired().HasPrecision(18, 2);
        // Enum:   builder.Property(x => x.Status).IsRequired().HasConversion<int>();
        // Code:   builder.Property(x => x.Code).IsRequired().IsUnicode(false).HasMaxLength(50);
        // Body:   builder.Property(x => x.Body).IsRequired(false).HasColumnType("nvarchar(max)");

        // ── Audit Columns (AuditableEntity) ──
        builder.Property(x => x.CreatedAt).IsRequired();
        builder.Property(x => x.UpdatedAt).IsRequired(false);
        builder.Property(x => x.IsDeleted).IsRequired().HasDefaultValue(false);
        builder.Property(x => x.DeletedAt).IsRequired(false);
        builder.Property(x => x.RowVersion).IsRowVersion();

        // ── Relationships ──
        // One-to-Many:
        // builder.HasMany(x => x.Images)
        //     .WithOne(x => x.{Entity}).HasForeignKey(x => x.{Entity}Id)
        //     .OnDelete(DeleteBehavior.Cascade);
        // Many-to-One (FK):
        // builder.HasOne(x => x.Category)
        //     .WithMany().HasForeignKey(x => x.CategoryId)
        //     .IsRequired().OnDelete(DeleteBehavior.Restrict);

        // ── Global Query Filter (soft-delete) ──
        builder.HasQueryFilter(x => !x.IsDeleted);

        // ── Indexes ──
        builder.HasIndex(x => x.Slug)
            .IsUnique()
            .HasFilter("IsDeleted = 0");       // Filtered — allows slug reuse after soft-delete

        // FK indexes:   builder.HasIndex(x => x.CategoryId);
        // Composite:    builder.HasIndex(x => new { x.IsActive, x.CreatedAt });
    }
}
